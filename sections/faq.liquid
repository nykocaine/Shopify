{%- if section.blocks.size > 0 -%}
    {%- liquid
      assign has_categories = false

      for category_block in section.blocks
        if category_block.type == 'category' and category_block.settings.title != blank
          assign has_categories = true
          break
        endif
      endfor
    -%}

    {%- comment -%}
    Interactive categories: questions before the first titled category (if any) are always shown,
    so nothing a merchant already wrote gets hidden by adding categories later. Each category
    becomes a tab button (x-tabs, theme.js) and its questions become an external panel matched
    purely by aria-controls/id - same technique main-search.liquid uses for its resource-type tabs.
    The tab buttons live inside the section header itself (as a ".section-header__controls" sibling
    of the title block - the same slot other sections use for carousel prev/next controls), so on
    desktop the title and the categories share one row for free via .section-header's own existing
    responsive grid (theme.css), and on mobile they stack like any other section header control.
    {%- endcomment -%}
    {%- if has_categories -%}
      {%- capture faq_leading_content -%}
        {%- liquid
          assign reached_first_category = false

          for block in section.blocks
            if block.type == 'category' and block.settings.title != blank
              assign reached_first_category = true
            endif

            if reached_first_category == false
              if block.type == 'question'
                assign use_secondary_background = false

                if section.settings.accordion_style == 'background' and section.settings.color_scheme.settings.background_gradient != blank or section.settings.color_scheme.settings.background != section.settings.color_scheme.settings.secondary_background
                  assign use_secondary_background = true
                endif

                if block.settings.question != blank and block.settings.answer != blank
                  if section.settings.question_style == 'subheading'
                    render 'accordion', title: block.settings.question, content: block.settings.answer, prose_content: true, subheading_title: true, icon: block.settings.icon, custom_icon: block.settings.custom_icon, icon_width: block.settings.icon_width, mobile_icon_width: block.settings.mobile_icon_width, use_secondary_background: use_secondary_background, toggle_icon: 'accordion-plus', block: block
                  else
                    render 'accordion', title: block.settings.question, content: block.settings.answer, prose_content: true, icon: block.settings.icon, custom_icon: block.settings.custom_icon, icon_width: block.settings.icon_width, mobile_icon_width: block.settings.mobile_icon_width, use_secondary_background: use_secondary_background, toggle_icon: 'accordion-plus', block: block
                  endif
                endif
              elsif block.type == 'text_image'
                render 'faq-text-image', block: block, faq_border_radius: section.settings.faq_border_radius
              endif
            endif
          endfor
        -%}
      {%- endcapture -%}

      {%- capture faq_category_tabs -%}
        {%- assign panel_index = -1 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'category' and block.settings.title != blank -%}
            {%- assign panel_index = panel_index | plus: 1 -%}
            <button
              type="button"
              slot="tab"
              class="faq__category-tab {% if block.settings.category_tab_style == 'filled' %}faq__category-tab--filled{% endif %}"
              aria-controls="faq-panel-{{ section.id }}-{{ panel_index }}"
              aria-selected="{% if panel_index == 0 %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.custom_icon != blank -%}
                {%- render 'icon', image: block.settings.custom_icon, width: block.settings.icon_width, mobile_width: block.settings.mobile_icon_width, class: 'faq__category-tab-icon' -%}
              {%- elsif block.settings.icon != 'none' -%}
                {%- render 'icon' with block.settings.icon, width: block.settings.icon_width, mobile_width: block.settings.mobile_icon_width, class: 'faq__category-tab-icon' -%}
              {%- endif -%}
              <span class="h6">{{ block.settings.title }}</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}

      {%- comment -%}
      The questions of a tab are not output one after the other: they are dealt into two columns as they come (1st, 3rd, 5th... into the first one,
      2nd, 4th, 6th... into the second one), each wrapped in an item that carries its position as a flex "order". On phones the two columns dissolve
      and the order puts the questions back in a single list; on desktop they are two real, independent columns, so opening a question only makes
      its own column longer. A text + image block closes the columns that came before it, so it keeps its place between questions.
      {%- endcomment -%}
      {%- capture faq_category_panels -%}
        {%- assign panel_index = -1 -%}
        {%- assign panel_open = false -%}
        {%- assign questions_in_panel = 0 -%}
        {%- assign faq_column_a = '' -%}
        {%- assign faq_column_b = '' -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'category' -%}
              {%- if block.settings.title != blank -%}
                {%- if faq_column_a != blank -%}
                  <div class="faq__columns"><div class="faq__column">{{ faq_column_a }}</div><div class="faq__column">{{ faq_column_b }}</div></div>
                  {%- assign faq_column_a = '' -%}
                  {%- assign faq_column_b = '' -%}
                {%- endif -%}
                {%- if panel_open -%}</div>{%- endif -%}
                {%- assign panel_index = panel_index | plus: 1 -%}
                {%- assign panel_open = true -%}
                {%- assign questions_in_panel = 0 -%}
                <div id="faq-panel-{{ section.id }}-{{ panel_index }}" class="faq__panel faq-block__list" {% if panel_index > 0 %}hidden{% endif %}>
              {%- endif -%}

            {%- when 'question' -%}
              {%- if panel_open -%}
                {%- liquid
                  assign use_secondary_background = false

                  if section.settings.accordion_style == 'background' and section.settings.color_scheme.settings.background_gradient != blank or section.settings.color_scheme.settings.background != section.settings.color_scheme.settings.secondary_background
                    assign use_secondary_background = true
                  endif

                  # "First question open" (section setting): the first question shown in each tab starts expanded
                  assign open_first_question = false

                  if section.settings.first_question_open and questions_in_panel == 0
                    assign open_first_question = true
                  endif

                  if block.settings.question != blank and block.settings.answer != blank
                    capture faq_item_html
                      if section.settings.question_style == 'subheading'
                        render 'accordion', title: block.settings.question, content: block.settings.answer, prose_content: true, subheading_title: true, open: open_first_question, icon: block.settings.icon, custom_icon: block.settings.custom_icon, icon_width: block.settings.icon_width, mobile_icon_width: block.settings.mobile_icon_width, use_secondary_background: use_secondary_background, toggle_icon: 'accordion-plus', block: block
                      else
                        render 'accordion', title: block.settings.question, content: block.settings.answer, prose_content: true, open: open_first_question, icon: block.settings.icon, custom_icon: block.settings.custom_icon, icon_width: block.settings.icon_width, mobile_icon_width: block.settings.mobile_icon_width, use_secondary_background: use_secondary_background, toggle_icon: 'accordion-plus', block: block
                      endif
                    endcapture

                    assign faq_item_class = 'faq__item'

                    if questions_in_panel == 0
                      assign faq_item_class = faq_item_class | append: ' faq__item--first'
                    endif

                    if section.settings.accordion_style == 'border'
                      assign faq_item_class = faq_item_class | append: ' faq__item--line'
                    endif

                    capture faq_item_wrapped
                      echo '<div class="' | append: faq_item_class | append: '" style="order: ' | append: questions_in_panel | append: '">' | append: faq_item_html | append: '</div>'
                    endcapture

                    assign faq_item_remainder = questions_in_panel | modulo: 2

                    if faq_item_remainder == 0
                      assign faq_column_a = faq_column_a | append: faq_item_wrapped
                    else
                      assign faq_column_b = faq_column_b | append: faq_item_wrapped
                    endif

                    assign questions_in_panel = questions_in_panel | plus: 1
                  endif
                -%}
              {%- endif -%}

            {%- when 'text_image' -%}
              {%- if panel_open -%}
                {%- if faq_column_a != blank -%}
                  <div class="faq__columns"><div class="faq__column">{{ faq_column_a }}</div><div class="faq__column">{{ faq_column_b }}</div></div>
                  {%- assign faq_column_a = '' -%}
                  {%- assign faq_column_b = '' -%}
                {%- endif -%}
                {%- render 'faq-text-image', block: block, faq_border_radius: section.settings.faq_border_radius -%}
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
        {%- if faq_column_a != blank -%}
                  <div class="faq__columns"><div class="faq__column">{{ faq_column_a }}</div><div class="faq__column">{{ faq_column_b }}</div></div>
                  {%- assign faq_column_a = '' -%}
                  {%- assign faq_column_b = '' -%}
                {%- endif -%}
        {%- if panel_open -%}</div>{%- endif -%}
      {%- endcapture -%}
    {%- endif -%}

    {%- capture section_header -%}
      {%- if section.settings.subheading != blank or section.settings.title != blank or section.settings.content != blank or section.settings.button_text != blank or has_categories -%}
        <div class="section-header">
          {%- comment -%}
          With categories, the title/subheading/content/button row is skipped entirely - the tab row
          becomes .section-header's only child, so it stretches across the full width of the row for
          free (CSS Grid's own default justify-items: stretch) instead of sharing it with a title
          column. The tabs themselves are then pushed to the end of that full-width row via
          ::part(tablist)'s own justify-content below, on both mobile and desktop. Only relevant
          without categories, where there's nothing else in .section-header to share the row with.
          {%- endcomment -%}
          {%- unless has_categories -%}
            {%- if section.settings.subheading != blank or section.settings.title != blank or section.settings.content != blank or section.settings.button_text != blank -%}
              <div class="prose">
                {%- render 'subheading', content: section.settings.subheading -%}
                {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.title_tag, html_tag: 'h2' -%}

                <div class="max-w-sm">
                  {{- section.settings.content -}}
                </div>

                {%- render 'button', content: section.settings.button_text, href: section.settings.button_url, style: section.settings.button_style -%}
              </div>
            {%- endif -%}
          {%- endunless -%}

          {%- if has_categories -%}
            <x-tabs class="section-header__controls faq__categories" transition="unfold">
              <template shadowrootmode="open">
                <slot part="tablist" role="tablist" name="tab"></slot>
              </template>
              {{- faq_category_tabs -}}
            </x-tabs>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endcapture -%}

    {%- comment -%}faq--full-width adds the gap below the header: only when stacked and there is a header to separate from.{%- endcomment -%}
    {%- assign section_header_markup = section_header | strip -%}

    {%- capture section_content -%}
      <div class="faq{% if section.settings.layout != 'split' and section_header_markup != blank %} faq--full-width{% endif %}">
        <div class="faq__content faq-block__list">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'category' -%}
                {%- if block.settings.title != blank -%}
                  <div class="faq__category">
                    {%- if block.settings.custom_icon != blank -%}
                      {%- render 'icon', image: block.settings.custom_icon, width: block.settings.icon_width, mobile_width: block.settings.mobile_icon_width -%}
                    {%- elsif block.settings.icon != 'none' -%}
                      {%- render 'icon' with block.settings.icon, width: block.settings.icon_width, mobile_width: block.settings.mobile_icon_width -%}
                    {%- endif -%}

                    <p class="h6 text-start" {{ block.shopify_attributes }}>{{ block.settings.title }}</p>
                  </div>
                {%- endif -%}

              {%- when 'question' -%}
                {%- liquid
                  assign use_secondary_background = false

                  if section.settings.accordion_style == 'background' and section.settings.color_scheme.settings.background_gradient != blank or section.settings.color_scheme.settings.background != section.settings.color_scheme.settings.secondary_background
                    assign use_secondary_background = true
                  endif

                  if block.settings.question != blank and block.settings.answer != blank
                    if section.settings.question_style == 'subheading'
                      render 'accordion', title: block.settings.question, content: block.settings.answer, prose_content: true, subheading_title: true, icon: block.settings.icon, custom_icon: block.settings.custom_icon, icon_width: block.settings.icon_width, mobile_icon_width: block.settings.mobile_icon_width, use_secondary_background: use_secondary_background, toggle_icon: 'accordion-plus', block: block
                    else
                      render 'accordion', title: block.settings.question, content: block.settings.answer, prose_content: true, icon: block.settings.icon, custom_icon: block.settings.custom_icon, icon_width: block.settings.icon_width, mobile_icon_width: block.settings.mobile_icon_width, use_secondary_background: use_secondary_background, toggle_icon: 'accordion-plus', block: block
                    endif
                  endif
                -%}

              {%- when 'text_image' -%}
                {%- render 'faq-text-image', block: block, faq_border_radius: section.settings.faq_border_radius -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>

        {%- render 'faq-accordion-group' -%}
      </div>
    {%- endcapture -%}

    <style>
      {%- comment -%}
      ============================================================
      LAYOUT & SPACING (padding, container, first-section treatment)
      ============================================================
      {%- endcomment -%}

      {%- comment -%}
      All four sides equal, and the same formula at every breakpoint (this used to be
      padding-block: var(--container-gutter) on desktop with a bigger mobile-only override on all
      four sides - so the sides always matched each other, but desktop and mobile didn't match one
      another). On mobile --container-gutter is small (~10px), so gutter + 0.5rem everywhere keeps
      the floating card's content (both the title/subtitle/paragraph column and the questions
      column) comfortably off the card edges on every screen size, not just below 700px.
      Split layout: .section-split__column owns every side. Stacked layout and categories layout:
      .faq__container (below) owns every side.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .section-split__column {
        padding: calc(var(--container-gutter) + 0.5rem);
      }

      {%- comment -%}
      The container of the categories layout and of the stacked layout (.faq__container, below) gets
      equal padding on all four sides - calc(var(--container-gutter) + 0.5rem).

      .container's own global rule (theme.css) also sets margin-inline-start/end to center itself
      once its parent is wider than --container-max-width - real margin, invisible on narrow
      viewports but very much there on wide desktop screens. That fights the "full section width"
      requirement, so it's zeroed out here: padding is the only inset now, margin stays 0 on every
      breakpoint.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .faq__container {
        margin-inline: 0;
        padding: calc(var(--container-gutter) + 0.5rem);
      }

      {%- comment -%}
      Same gap .section-header already uses between the title and the categories row (row-gap:
      1.8rem, theme.css) - repeated here between the header (title+categories) and the questions
      below it, on mobile and desktop alike.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .faq--full-width {
        margin-block-start: 1.8rem;
      }

      {%- comment -%}
      Anywhere else on the page the floating card has all four corners rounded (Corner radius setting). When this section
      is the very first one on the page - right under the header bar, with no gap - the top corners of the card
      clash with the header above it, and the standard top padding reads too tight against it. Top corners flatten to
      square (bottom corners keep the Corner radius setting - overflow: hidden on the same element clips to whatever
      the resulting mixed radius ends up being, no extra work needed there) and the top padding triples, same technique
      contact.liquid/libro-reclamaciones.liquid use elsewhere - applied only in this position here.
      :first-of-type, not :first-child: theme.liquid may put a visually hidden <h1> before the first section inside
      <main>, which made :first-child fail on pages without a heading of their own.
      !important is needed because Corner radius is set as an inline style (higher specificity than
      any external rule regardless of selector).
      {%- endcomment -%}
      #shopify-section-{{ section.id }}:first-of-type .section-floating {
        border-start-start-radius: 0 !important;
        border-start-end-radius: 0 !important;
      }

      #shopify-section-{{ section.id }}:first-of-type .faq__container {
        padding-block-start: calc((var(--container-gutter) + 0.5rem) * 3);
      }

      #shopify-section-{{ section.id }}:first-of-type .section-split__column:not(.section-split__column--image) {
        padding-block-start: calc((var(--container-gutter) + 0.5rem) * 3);
      }

      {%- comment -%}
      ============================================================
      TYPOGRAPHY OVERRIDES (title, subheading-style question,
      accordion question weight)
      ============================================================
      {%- endcomment -%}

      {%- comment -%}
      Same override product-card.liquid already applies to itself (theme.css, ".product-card .subheading,
      .product-card .heading"): forces the typeface itself (family/weight/style/letter-spacing/casing)
      back to Body Text, without touching font-size. Covers the accordion question when "Question style"
      is set to "Subheading" (.subheading, accordion.liquid's subheading_title) - but NOT the section's
      own main title above (section.settings.title) nor the "Text with image or video" block's own title
      (faq-text-image.liquid), both rendered with balance_text: true, the only two places in this section
      that add "text-balance" - excluded here so they keep the real Heading typeface instead, matching
      the "big rating number" in reviews.liquid, which has no such override. The answer
      (accordion__content, rendered with prose_content: true) already renders as plain prose/body text
      and needs no override.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .heading:not(.text-balance),
      #shopify-section-{{ section.id }} .display-xl:not(.text-balance),
      #shopify-section-{{ section.id }} .display-l:not(.text-balance),
      #shopify-section-{{ section.id }} .display-m:not(.text-balance),
      #shopify-section-{{ section.id }} .h1:not(.text-balance),
      #shopify-section-{{ section.id }} .h2:not(.text-balance),
      #shopify-section-{{ section.id }} .h3:not(.text-balance),
      #shopify-section-{{ section.id }} .h4:not(.text-balance),
      #shopify-section-{{ section.id }} .h5:not(.text-balance),
      #shopify-section-{{ section.id }} .h6:not(.text-balance),
      #shopify-section-{{ section.id }} .subheading {
        font-family: var(--text-font-family);
        font-weight: var(--text-font-weight);
        font-style: var(--text-font-style);
        letter-spacing: var(--text-letter-spacing);
        text-transform: var(--text-transform);
      }

      {%- comment -%}
      .faq-block__list .accordion__summary (theme.css) hardcodes font-weight: 600 on the question
      directly, regardless of "Question style" - forced back to the Body Text weight here so the
      question doesn't read heavier/bolder than the answer text below it.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .faq-block__list .accordion__summary {
        font-weight: var(--text-font-weight);
      }

      {%- if section.settings.two_columns -%}
        {%- comment -%}
        White containers, no border, rounded with the section's corner radius. Phones: one container around the whole list (the two columns
        dissolve, the items go back to their order). Desktop (1000px and up): two real columns side by side, each on its own white container, read from
        left to right (1st on the left, 2nd on the right...; with an odd number the extra one ends up at the bottom of the left one). The columns are
        independent: opening a question only makes its own column longer, the other one does not move. The lines between questions are drawn on top of
        each item (none on the first of a column / of the list). Blocks that are not a question (text + image) keep the full width.
        {%- endcomment -%}
        #shopify-section-{{ section.id }} .faq__columns {
          display: flex;
          flex-direction: column;
          padding: 0.5rem 1.25rem;
          background: #ffffff;
          border-radius: {{ section.settings.faq_border_radius }}px;
        }

        #shopify-section-{{ section.id }} .faq__column {
          display: contents;
        }

        #shopify-section-{{ section.id }} .faq__item .accordion {
          box-shadow: none;
        }

        #shopify-section-{{ section.id }} .faq__item--line:not(.faq__item--first) {
          box-shadow: 0 -1px 0 rgb(var(--border-color));
        }

        @media screen and (min-width: 1000px) {
          #shopify-section-{{ section.id }} .faq__columns {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            align-items: start;
            column-gap: 1rem;
            padding: 0;
            background: none;
            border-radius: 0;
          }

          #shopify-section-{{ section.id }} .faq__column {
            display: block;
            padding: 0.5rem 1.5rem;
            background: #ffffff;
            border-radius: {{ section.settings.faq_border_radius }}px;
          }

          #shopify-section-{{ section.id }} .faq__column > .faq__item:first-child {
            box-shadow: none;
          }
        }

        {%- comment -%}
        Phones only (test): the category tabs become a menu glued on top of the white questions container, as one single block.
        The tab row takes the container's own white and its top rounded corners (the corner radius setting); the container
        loses its top rounded corners and the gap that separated it from the tabs, so the two read as one container with the
        menu inside. The tabs turn into plain links: no pill, no background, the active one underlined. The edge fade of the
        scrolling row is switched off here, since it would fade the white of the bar itself.
        {%- endcomment -%}
        @media screen and (max-width: 699px) {
          #shopify-section-{{ section.id }} .faq--full-width {
            margin-block-start: 0;
          }

          {%- comment -%}
          The white bar and its top rounded corners live on the tabs element itself (.faq__categories), not on the scrolling row inside
          it: the row keeps the edge fade (a mask) it always had, which now fades the tabs out into the bar's white. The row is
          border-box so its side padding no longer adds to its 100% width (that made the bar run past the section's right padding).
          {%- endcomment -%}
          #shopify-section-{{ section.id }} .faq__categories {
            margin-block-end: -1px;
            background: #ffffff;
            border-start-start-radius: {{ section.settings.faq_border_radius }}px;
            border-start-end-radius: {{ section.settings.faq_border_radius }}px;
          }

          #shopify-section-{{ section.id }} .faq__categories::part(tablist) {
            box-sizing: border-box;
            gap: 2.25rem;
            padding: .5rem 0 0 1.25rem;
          }

          {%- comment -%}
          The end padding of a scrolling flex row is dropped by some browsers, so the right inset is a real spacer after the last
          tab (its negative start margin cancels the row's gap): the tabs keep the same side padding on both ends of the bar.
          {%- endcomment -%}
          #shopify-section-{{ section.id }} .faq__categories::part(tablist)::after {
            content: "";
            flex: none;
            width: 1.25rem;
            margin-inline-start: -2.25rem;
          }

          #shopify-section-{{ section.id }} .faq__category-tab,
          #shopify-section-{{ section.id }} .faq__category-tab.faq__category-tab--filled,
          #shopify-section-{{ section.id }} .faq__category-tab.faq__category-tab--filled[aria-selected="true"],
          #shopify-section-{{ section.id }} .faq__category-tab.faq__category-tab--filled:hover {
            position: relative;
            padding: .75rem 0;
            color: rgb(var(--text-color));
            background: none;
            border-radius: 0;
          }

          {%- comment -%}The underline of the active tab is a line that grows in and out (not a text-decoration), so changing tab is gradual.{%- endcomment -%}
          #shopify-section-{{ section.id }} .faq__category-tab::after {
            content: "";
            position: absolute;
            inset-inline: 0;
            inset-block-end: .5rem;
            height: 1px;
            background: currentColor;
            transform: scaleX(0);
            transform-origin: left center;
            transition: transform .35s cubic-bezier(.4, 0, .2, 1);
          }

          #shopify-section-{{ section.id }} .faq__category-tab[aria-selected="true"]::after {
            transform: scaleX(1);
          }

          {%- comment -%}
          The first block of every tab's content has no top rounded corners, so the menu and the content read as one box. The
          questions container and the first text card of a text + image block are covered; !important because the text card's
          corner radius is an inline style.
          {%- endcomment -%}
          #shopify-section-{{ section.id }} .faq__panel > .faq__columns:first-child,
          #shopify-section-{{ section.id }} .faq__panel > .faq__text-image:first-child .faq__text-image-text {
            border-start-start-radius: 0 !important;
            border-start-end-radius: 0 !important;
          }
        }
      {%- else -%}
        {%- comment -%}
        Single list ("Two columns" off): the tab panels are always built as two columns (1st, 3rd, 5th... in the first one,
        2nd, 4th, 6th... in the second one), and each item carries its position as a flex "order". Without any style for those
        wrappers the first column was shown whole and then the second one, so the questions came out as 1, 3, 5... then
        2, 4, 6.... Here the two columns dissolve (display: contents) inside a flex column, so the order puts the questions
        back in their real sequence, same as phones do with "Two columns" on. Everything else keeps the accordion's own look.
        {%- endcomment -%}
        #shopify-section-{{ section.id }} .faq__columns {
          display: flex;
          flex-direction: column;
        }

        #shopify-section-{{ section.id }} .faq__column {
          display: contents;
        }
      {%- endif -%}

      {%- comment -%}
      Toggle icon ("+"/toggle_icon: 'accordion-plus', snippets/icon.liquid): the icon is two bars, a
      fixed horizontal one and a vertical one carrying the .accordion-plus-bar class. theme.css's own
      default open effect shrinks that vertical bar to nothing (transform: scaleY(0)), fading the whole
      icon to 40% opacity at the same time, so the "+" simply thins down into a "-". This overrides the
      vertical bar's transform so it rotates 90° on its own center instead of shrinking, swinging flat
      to lie exactly on top of the fixed horizontal bar - same end result (a "-"), reached by spinning
      instead of disappearing.

      The duration is slowed down from theme.css's default transition: transform .3s ease-in-out (kept
      as-is for that icon everywhere else in the theme) to .6s here, applied to the bar unconditionally
      (not only while .is-open) so opening and closing spin at the same, slower speed symmetrically -
      scoping it only to .is-open would leave closing animating at the faster default instead. Scoped to
      this section only - theme.css's own behavior (and every other place this icon is used) is
      untouched.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .icon-accordion-plus .accordion-plus-bar {
        transition-duration: .6s;
      }

      #shopify-section-{{ section.id }} .accordion.is-open .accordion__summary .icon-accordion-plus .accordion-plus-bar {
        transform: rotate(90deg);
      }

      {%- comment -%}
      ============================================================
      CATEGORIES (tabs row + tab buttons)
      ============================================================
      {%- endcomment -%}

      {%- comment -%}
      Categories menu: lives inside .section-header as a ".section-header__controls" sibling of the
      title block, so .section-header's own existing responsive grid (theme.css) puts the title and
      the categories side by side from 700px on and stacks them on mobile - no layout CSS of our own
      needed for that part (the "only on desktop" requirement comes for free from that shared rule).
      Questions render in their own block below the header (.faq, unchanged from the rest of the
      file), without .section-stack's own "max-width: 50rem" cap, since these need to span the
      section's full width instead.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .faq__categories {
        width: 100%;
        min-width: 0;
        display: block;
      }

      {%- comment -%}
      part="tablist" is the <slot> inside x-tabs' own shadow root (see the <template> below) -
      styling it from here is the same technique .collection__resource-tab-list::part(tablist)
      already uses in theme.css for the search page's resource tabs. width: 100% makes it span the
      row's full width (the title/subheading/content/button row is never rendered alongside
      categories - see section_header above), with the tabs themselves starting from the left edge of
      it (flex's own default justify-content: flex-start) on both mobile and desktop.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .faq__categories::part(tablist) {
        width: 100%;
        scrollbar-width: none;
        gap: .5rem;
        padding-block: .25rem;
        display: flex;
        overflow-x: auto;
      }

      {%- comment -%}
      Edge fade instead of a hard-clipped cut when the tab row overflows and scrolls (script further
      down toggles is-overflowing/at-start/at-end on .faq__categories itself, based on the tablist's
      own scroll position). Starts right-only (there's nothing to scroll back to yet); once the
      visitor scrolls away from the start, the left edge fades in too; the right edge only stops
      fading once they've reached the actual end - never both at once unless the row doesn't need to
      scroll in the first place (is-overflowing absent, no mask at all).
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .faq__categories.is-overflowing::part(tablist) {
        -webkit-mask-image: linear-gradient(to right, transparent, black .5rem, black calc(100% - 2rem), transparent);
        mask-image: linear-gradient(to right, transparent, black .5rem, black calc(100% - 2rem), transparent);
      }

      #shopify-section-{{ section.id }} .faq__categories.is-overflowing.at-start::part(tablist) {
        -webkit-mask-image: linear-gradient(to right, black, black calc(100% - 2rem), transparent);
        mask-image: linear-gradient(to right, black, black calc(100% - 2rem), transparent);
      }

      #shopify-section-{{ section.id }} .faq__categories.is-overflowing.at-end::part(tablist) {
        -webkit-mask-image: linear-gradient(to right, transparent, black .5rem, black);
        mask-image: linear-gradient(to right, transparent, black .5rem, black);
      }

      #shopify-section-{{ section.id }} .faq__categories.is-overflowing.at-start.at-end::part(tablist) {
        -webkit-mask-image: none;
        mask-image: none;
      }

      #shopify-section-{{ section.id }} .faq__categories::part(tablist)::-webkit-scrollbar {
        display: none;
      }

      #shopify-section-{{ section.id }} .faq__category-tab {
        white-space: nowrap;
        color: rgb(var(--text-color));
        background: none;
        border: 0;
        border-radius: 999px;
        align-items: center;
        gap: .5rem;
        padding: .625rem 1.125rem;
        transition: color .2s ease;
        display: inline-flex;
        flex: none;
      }

      {%- comment -%}
      Bug fix: wrapped in (pointer: fine) so tapping a tab on touch devices doesn't leave it stuck in
      this "hover" look until the visitor taps elsewhere (touch has no real hover state, but mobile
      browsers commonly latch :hover on tap) - matches how every other interactive hover in the theme
      (eg. .button:hover, theme.css) is already scoped.
      {%- endcomment -%}
      @media screen and (pointer: fine) {
        #shopify-section-{{ section.id }} .faq__category-tab:hover {
          color: rgb(var(--text-color));
        }
      }

      #shopify-section-{{ section.id }} .faq__category-tab:focus-visible {
        outline-offset: 2px;
      }

      {%- comment -%}
      Default "Outline" style (block.settings.category_tab_style, "Tab" header below) - font color and
      border both come from the body text color, never a filled background, even when active (only the
      opacity step changes: muted when inactive, full strength when selected).
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .faq__category-tab[aria-selected="true"] {
        color: rgb(var(--text-color));
        background: none;
      }

      {%- comment -%}
      The tab label is a .h6, and .h6 (heading styles in theme.css) renders with -webkit-font-smoothing: antialiased, which draws
      the glyphs thinner and so looks lighter than the same color elsewhere (the color itself carries no opacity). Back to the
      normal smoothing, and the label takes the tab's color explicitly.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .faq__category-tab .h6 {
        color: inherit;
        -webkit-font-smoothing: auto;
      }

      #shopify-section-{{ section.id }} .faq__category-tab-icon {
        flex: none;
      }

      {%- comment -%}
      "Filled" style (block.settings.category_tab_style, set per category block - "Tab" header below):
      reuses the theme's own Buttons color scheme tokens -
      --button-background-primary/--button-text-primary/--button-hover-background, the exact variables
      snippets/button.liquid and theme.css's own .button rule already use for every solid button
      sitewide - instead of introducing new colors. Same muted-when-inactive / full-strength-when-
      selected pattern the Outline style above already uses, just applied to the fill instead of the
      border/text. Hover reuses --button-hover-background as-is, the same variable (and the same
      (pointer: fine) guard) .button:hover already uses in theme.css - no new transition is introduced,
      color/border-color/background-color simply piggyback on this rule's own existing transition
      declaration.

      .faq__category-tab--filled is combined with .faq__category-tab (not nested under a wrapper class
      like .faq__categories--filled) so the style is picked per-tab, matching how it's now a per-
      category setting rather than a single section-wide one - each category can be Outline or Filled
      independently.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .faq__category-tab.faq__category-tab--filled {
        color: rgb(var(--button-text-primary));
        background: rgb(var(--button-background-primary));
        transition: color .2s ease, background-color .2s ease;
      }

      #shopify-section-{{ section.id }} .faq__category-tab.faq__category-tab--filled[aria-selected="true"] {
        color: rgb(var(--button-text-primary));
        background: rgb(var(--button-background-primary));
      }

      @media screen and (pointer: fine) {
        #shopify-section-{{ section.id }} .faq__category-tab.faq__category-tab--filled:hover {
          background: rgb(var(--button-hover-background));
        }
      }

      {%- comment -%}
      ============================================================
      "TEXT WITH IMAGE OR VIDEO" BLOCK (faq-text-image.liquid)
      ============================================================
      {%- endcomment -%}

      {%- comment -%}
      "Text with image or video" block (faq-text-image.liquid): plain editorial content, not an
      accordion - lives alongside questions inside the same category panel/list. Single column
      (title, then text, then media stacked in that order) until 700px; from there, when there is at
      least one media item, whichever of title/text/media are actually present share the row as
      equal-width columns - EXCEPT the title column, capped at 30% max so a short title never grows
      past that even with extra room to spare. The actual grid-template-columns value is computed and
      set per block, not here - see faq-text-image.liquid's own scoped style block (id
      faq-text-image-<block.id>), since which of the three columns exist (title/icon, text, media)
      varies block by block and a single section-wide rule can't account for that: with no title, for
      example, the row should split 50/50 between text and media instead of leaving the title's column
      empty and media stuck in a narrower share. Text-only blocks (no media) stay single column, full
      width, at every size. Every media item (image or video, single or carousel) renders through
      snippets/media-zoom-slide.liquid, the same markup Media Blocks' Carousel uses, so it already
      carries its own sizing (block_size/mobile_block_size) and corner radius (faq_border_radius) -
      nothing here needs to size or round it.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .faq__text-image {
        gap: 1.5rem;
        display: grid;
      }

      {%- comment -%}
      flex column + gap: with a carousel (more than one media item), this stacks the scrolling
      product-list above its progress bar with some breathing room between them. With a single media
      item it has no visible effect (one child, the <figure> - the lightbox element next to it stays
      hidden until opened).
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .faq__text-image-media {
        gap: .75rem;
        display: flex;
        flex-direction: column;
      }

      {%- comment -%}
      theme.css's own bare figcaption rule sets font-size: var(--text-sm) (a deliberately smaller,
      caption-sized token) - overridden back to var(--text-base) here so each photo/video's caption
      reads at the same size as the theme's own Body text setting instead, on both mobile and desktop
      (--text-base already resolves to whichever of the two the current breakpoint calls for - see
      snippets/css-variables.liquid). Scoped to this block's own media captions only, not theme.css's
      figcaption rule itself, which other features (eg. blocks/image-with-caption.liquid) still rely on.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .faq__text-image-media figcaption {
        font-size: var(--text-base);
      }

      {%- comment -%}Captions are rich text (so multi-line metafields can be connected): the paragraph wrappers it adds must not add spacing of their own{%- endcomment -%}
      #shopify-section-{{ section.id }} .faq__text-image-media figcaption p {
        margin: 0;
      }

      #shopify-section-{{ section.id }} .faq__text-image-media figcaption p + p {
        margin-block-start: .5em;
      }

      {%- comment -%}
      align-items: start (not grid's own default, stretch/center): title, text and media all pin to
      the top of the row instead of centering around whichever column is tallest - title/text already
      read top-down naturally, and a centered media column would float with uneven gaps above/below it
      whenever it's shorter than the text next to it.
      {%- endcomment -%}
      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .faq__text-image--with-image {
          align-items: start;
        }
      }

      {%- comment -%}
      "Content box style" (show_text_card) when there's media next to it (faq-text-image.liquid's
      <read-more-match-height>): same "collapse + Show more/less" pattern as the main product page's
      own description (snippets/product-info.liquid, search that file for "Show more/less" for the
      full rationale behind each rule below) - written once here instead of per block, since the
      behavior is identical for every instance regardless of its own colors/size/content.
      {%- endcomment -%}
      read-more-match-height {
        display: block;
      }

      {%- comment -%}
      overflow-y (not the overflow: hidden shorthand, which clips both axes) - only the vertical
      axis needs clipping here, to hide whatever sits below the collapsed max-height. Clipping the
      horizontal axis too was an unintended side effect of the shorthand: list markers
      (list-style-position: outside, assets/theme.css) render slightly left of the text's own
      content box, inside the <ul>/<ol>'s margin-inline-start gutter - overflow-x: hidden could
      clip part of that marker (a bullet, or a two-digit "10."/"11." number) instead of just
      leaving the collapsed/expanding height clip in place.
      {%- endcomment -%}
      {%- comment -%}
      overflow-y: clip, not hidden: with overflow-x: visible, "hidden" on the other axis makes the browser
      compute overflow-x as auto, so the box could clip or scroll the text sideways (cut letters on the
      left/right edge). "clip" really leaves x visible. The "hidden" line stays as a fallback for
      browsers that don't know "clip" yet.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .faq__text-image-text-content {
        overflow-x: visible;
        overflow-y: hidden;
        overflow-y: clip;
        transition: max-height .3s ease-in-out;
      }

      #shopify-section-{{ section.id }} .faq__text-image-text-toggle {
        color: rgb(var(--text-color) / .5);
        text-align: start;
        margin-block-start: .5rem;
        display: none;
      }

      #shopify-section-{{ section.id }} read-more-match-height[data-overflowing] .faq__text-image-text-toggle {
        display: block;
      }

      #shopify-section-{{ section.id }} .faq__text-image-text-toggle__label-less {
        display: none;
      }

      #shopify-section-{{ section.id }} read-more-match-height[data-expanded] .faq__text-image-text-toggle__label-more {
        display: none;
      }

      #shopify-section-{{ section.id }} read-more-match-height[data-expanded] .faq__text-image-text-toggle__label-less {
        display: inline;
      }
    </style>

    {%- if has_categories -%}
      {%- comment -%}
      Categories replace the split/stacked "Layout" setting entirely: the title+categories row and
      the full-width questions block below it are the same shape either way, so there is no
      meaningful "split" (title in one column, content in another) left once content must span the
      full width. Uses .container (own padding/margin overrides above) directly, without
      .section-split's narrower max-width.
      {%- endcomment -%}
      <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_faq %} section-floating section-floating--block-end{% endif %}"{% if section.settings.floating_faq %} style="border-radius: {{ section.settings.faq_border_radius }}px; overflow: hidden;"{% endif %}>
        <div class="container faq__container">
          {{- section_header -}}

          <div class="faq faq--full-width">
            {%- if faq_leading_content != blank -%}
              <div class="faq-block__list">
                {{- faq_leading_content -}}
              </div>
            {%- endif -%}

            <div class="faq__panels">
              {{- faq_category_panels -}}
            </div>
          </div>
        </div>

        <script>
          (function () {
            if (!window.Shopify || !Shopify.designMode) return;

            var root = document.getElementById('shopify-section-{{ section.id }}');
            if (!root) return;

            var tabs = root.querySelector('.faq__categories');
            if (!tabs) return;

            {%- comment -%}
            Selecting a question block that lives inside a currently-hidden category panel only
            opens its accordion (accordion-disclosure's own shopify:block:select handler) - it
            never reaches x-tabs, since the panel is a sibling of x-tabs, not a slotted child.
            Without this, the merchant would see nothing change in the editor preview.
            {%- endcomment -%}
            root.addEventListener('shopify:block:select', function (event) {
              var panel = event.target.closest('.faq__panel');
              if (!panel || !panel.id) return;

              var button = tabs.querySelector('[aria-controls="' + panel.id + '"]');
              if (!button) return;

              var buttons = Array.prototype.slice.call(tabs.querySelectorAll('[slot="tab"]'));
              var index = buttons.indexOf(button);
              if (index > -1) tabs.selectedIndex = index;
            });
          })();
        </script>

        {%- comment -%}
        Edge fade (is-overflowing/at-start/at-end classes, see ::part(tablist) above): unlike the
        script above, this one isn't design-mode-only - it has to run for every visitor, not just in
        the editor.

        Two things make this trickier than it looks:

        1. part="tablist" is a <slot> inside x-tabs' declarative shadow root - that only attaches
        itself automatically when the browser parses it directly off the page. The editor's own
        section reloads insert the section's HTML via innerHTML instead (whenever ANY setting
        changes, not just this one), which does NOT trigger that - Tabs' own constructor
        (assets/theme.js) falls back to attaching the shadow root itself in that case, but only once
        the element has actually been upgraded, which happens a tick after the HTML lands. Reading
        tabs.shadowRoot synchronously, right as this script runs, could still catch it empty -
        wrapped in requestAnimationFrame so that upgrade has already happened by the time this looks
        for it.

        2. This script tag itself only runs once (whether on first load, or - assuming the editor
        re-executes inline scripts the same way it does for the design-mode one above - again after
        a reload). Either way, the listeners it attaches are tied to that specific, now-replaced
        tablist element once a reload swaps in a new one. shopify:section:load (dispatched on the
        reloaded section itself, listened for here on document since the section's own node is what
        gets replaced) re-runs the whole setup against whatever's actually in the DOM now.
        {%- endcomment -%}
        <script>
          (function () {
            function setup() {
              var root = document.getElementById('shopify-section-{{ section.id }}');
              if (!root) return;

              var tabs = root.querySelector('.faq__categories');
              if (!tabs) return;

              requestAnimationFrame(function () {
                if (!tabs.shadowRoot) return;

                var tablist = tabs.shadowRoot.querySelector('[part="tablist"]');
                if (!tablist) return;

                function updateEdgeFade() {
                  tabs.classList.toggle('is-overflowing', tablist.scrollWidth > tablist.clientWidth + 1);
                  tabs.classList.toggle('at-start', tablist.scrollLeft <= 0);
                  tabs.classList.toggle('at-end', tablist.scrollLeft + tablist.clientWidth >= tablist.scrollWidth - 1);
                }

                {%- comment -%}
                Tapping a tab slides the row so that tab sits at the left edge (the browser clamps the
                scroll at the end of the row, so the last tabs simply go as far left as they can). The
                .5rem inset matches the left edge fade width, so the tab isn't faded out.
                {%- endcomment -%}
                tabs.addEventListener('click', function (event) {
                  var tab = event.target.closest('[slot="tab"]');
                  if (!tab || tablist.scrollWidth <= tablist.clientWidth + 1) return;

                  var left = tab.getBoundingClientRect().left - tablist.getBoundingClientRect().left + tablist.scrollLeft;
                  var padding = parseFloat(getComputedStyle(tablist).paddingLeft);
                  var inset = padding > 0 ? padding : parseFloat(getComputedStyle(document.documentElement).fontSize) * 0.5;
                  var target = Math.max(0, left - inset);
                  var start = tablist.scrollLeft;

                  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    tablist.scrollLeft = target;
                    return;
                  }

                  {%- comment -%}Eased slide (slow start, slow end) instead of the browser's own quick smooth scroll, so the move is gentle.{%- endcomment -%}
                  var duration = 500;
                  var startTime = null;
                  function step(now) {
                    if (startTime === null) startTime = now;
                    var t = Math.min(1, (now - startTime) / duration);
                    var eased = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
                    tablist.scrollLeft = start + (target - start) * eased;
                    if (t < 1) requestAnimationFrame(step);
                  }
                  requestAnimationFrame(step);
                });

                updateEdgeFade();
                tablist.addEventListener('scroll', updateEdgeFade, { passive: true });
                window.addEventListener('resize', updateEdgeFade);
              });
            }

            setup();

            document.addEventListener('shopify:section:load', function (event) {
              if (event.target && event.target.id === 'shopify-section-{{ section.id }}') setup();
            });
          })();
        </script>

        {%- render 'faq-accordion-group' -%}
      </div>
    {%- elsif section.settings.layout == 'split' -%}
      <div class="section-split color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_faq %} section-floating section-floating--block-end{% endif %}"{% if section.settings.floating_faq %} style="border-radius: {{ section.settings.faq_border_radius }}px; overflow: hidden;"{% endif %}>
        <div class="section-split__column">
          {{- section_header -}}
        </div>

        <div class="section-split__column">
          {{- section_content -}}
        </div>
      </div>
    {%- else -%}
      {%- comment -%}
      Stacked without categories: the same left-aligned, full-width container the categories layout uses
      (title on top, questions below, equal padding on all four sides) - not a narrow centered column.
      {%- endcomment -%}
      <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_faq %} section-floating section-floating--block-end{% endif %}"{% if section.settings.floating_faq %} style="border-radius: {{ section.settings.faq_border_radius }}px; overflow: hidden;"{% endif %}>
        <div class="container faq__container">
          {{- section_header -}}
          {{- section_content -}}
        </div>
      </div>
    {%- endif -%}

  {%- comment -%}We also output the content with JSON microdata for SEO{%- endcomment -%}

  <script type="application/ld+json">
    {%- assign question_blocks = section.blocks | where: 'type', 'question' -%}

    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in question_blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.faq.name",
  "class": "shopify-section--faq",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:global.layout.layout",
      "options": [
        {
          "value": "split",
          "label": "t:global.layout.layout_options.split"
        },
        {
          "value": "stacked",
          "label": "t:global.layout.layout_options.stacked"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "checkbox",
      "id": "floating_faq",
      "label": "Floating FAQ",
      "info": "Adds margins around the section (bottom and sides), using the store's global side margin.",
      "default": false
    },
    {
      "type": "range",
      "id": "faq_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0,
      "visible_if": "{{ section.settings.floating_faq }}"
    },
    {
      "type": "select",
      "id": "accordion_style",
      "label": "t:sections.faq.accordion_style",
      "options": [
        {
          "value": "background",
