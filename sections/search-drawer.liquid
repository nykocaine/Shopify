<style>
  {%- comment -%}The drawer is moved to the end of <body> by the theme; its styles are scoped by id, so they apply wherever it ends up{%- endcomment -%}
  #search-drawer .search-drawer__form {
    margin-block-end: 1.5rem;
  }

  {%- comment -%}
  Phones: the drawer behaves like the menu drawer (assets/theme.css, ".menu-drawer" mobile block) - it unfolds from
  right below the header, so the header and anything above it stay visible and un-blurred, with the side gutters,
  the gap at the bottom and the rounded corners (--drawer-border-radius) of the menu. --menu-offset-top (the header's
  current bottom edge) is written by the script below, same measurement HeaderMenuDrawer does in theme.js.
  Written with the #search-drawer id so it wins over the generic ".drawer-mobile-centered" floating-card rules.
  Its height is exactly that of its content (the field, then the suggestions or the results shown): it grows with the results and
  never fills the screen on its own. Only if the content were taller than the space below the header does the body scroll inside,
  as a safety so nothing is left out of reach.
  {%- endcomment -%}
  @media screen and (max-width: 699px) {
    #search-drawer::part(overlay) {
      inset-block-start: calc(var(--menu-offset-top, 0px) - 1px); /* tucks 1px under the header's bottom edge: its measured bottom is rounded, which could leave a hairline showing the page */
    }

    #search-drawer::part(content) {
      position: fixed;
      inset-block-start: calc(var(--menu-offset-top, 0px) + .5rem);
      inset-block-end: auto;
      inset-inline: var(--container-gutter);
      width: auto;
      max-width: none;
      height: auto;
      max-height: calc(100dvh - var(--menu-offset-top, 0px) - .5rem - var(--drawer-block-gap));
      border-block-start: none;
      border-radius: var(--drawer-border-radius);
    }
  }

  {%- comment -%}
  The radius is defined on the drawer itself (not only on .product-card) so every card inside it - the featured
  carousel and the live search results, which are fetched and inserted later - always resolves it. It is then
  applied straight to each card's image box and to the image, so the corners are rounded and clipped even when the
  card markup doesn't pick up the inline radius (and the hover zoom can't spill past the rounded corners).
  {%- endcomment -%}
  #search-drawer {
    --product-card-border-radius: {{ section.settings.product_card_border_radius }}px;
  }

  #search-drawer .product-card {
    --product-card-border-radius: {{ section.settings.product_card_border_radius }}px;
  }

  #search-drawer .product-card__media,
  #search-drawer .product-card__media img {
    border-radius: var(--product-card-border-radius, 0);
  }
</style>

{%- if section.settings.mobile_only -%}
  {%- comment -%}
  "Show only on mobile": on screens wider than 699px the header search link no longer opens this drawer - its click is
  stopped in the capture phase, before the theme's own listener (which opens whatever its aria-controls points to), so
  the link just goes to the search page. Same technique as sections/cart-drawer.liquid's "Show only on mobile".
  {%- endcomment -%}
  <script>
    (function () {
      var mobileQuery = window.matchMedia('(max-width: 699px)');

      document.addEventListener('click', function (event) {
        if (mobileQuery.matches || !event.target.closest) return;

        if (event.target.closest('[aria-controls="search-drawer"]')) {
          event.stopPropagation();
        }
      }, true);
    })();
  </script>
{%- endif -%}

<script>
  (function () {
    // Same behavior as the menu drawer: measure the header's bottom edge when the drawer opens (and on scroll / resize
    // while it is open), and, on phones, let a transparent header turn solid while it is open.
    function drawer() {
      return document.getElementById('search-drawer');
    }

    function calculateOffsets() {
      var el = drawer();
      var header = document.querySelector('x-header');
      if (!el || !el.hasAttribute('open')) return;

      var dpr = window.devicePixelRatio || 1;
      var offset = header ? Math.max(Math.round(header.getBoundingClientRect().bottom * dpr) / dpr, 0) : 0;
      el.style.setProperty('--menu-offset-top', offset + 'px');
    }

    var wasSolid = false;
    var phone = window.matchMedia('(max-width: 699px)');

    // The dialog events don't bubble, so the listeners go on the drawer element itself (looked up once the page has
    // been parsed - this script sits before the element in the markup).
    function init() {
      var el = drawer();
      if (!el || el.dataset.offsetInit) return;
      el.dataset.offsetInit = 'true';

      el.addEventListener('dialog:before-show', function () {
        calculateOffsets();
        requestAnimationFrame(calculateOffsets);

        if (phone.matches) {
          var header = document.querySelector('x-header');
          wasSolid = header ? header.classList.contains('is-solid') : false;
          el.dispatchEvent(new CustomEvent('header:disable-transparent-header', { bubbles: true }));
        }
      });

      el.addEventListener('dialog:after-show', calculateOffsets);

      el.addEventListener('dialog:after-hide', function () {
        if (phone.matches && !wasSolid) {
          el.dispatchEvent(new CustomEvent('header:allow-transparent-header', { bubbles: true }));
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', init);
    window.addEventListener(window.onscrollend !== undefined ? 'scrollend' : 'scroll', calculateOffsets);
    window.addEventListener('resize', calculateOffsets);
  })();
</script>

<x-drawer id="search-drawer" unfold class="drawer drawer--search drawer--no-bordered-header color-scheme color-scheme--{{ section.settings.color_scheme.id }}" handle-editor-events>
  {%- comment -%}No visible title (just the close button); kept for screen readers only{%- endcomment -%}
  <h2 class="sr-only" slot="header">{{ 'search.general.title' | t }}</h2>

  <form action="{{ routes.search_url }}" id="predictive-search-form" method="GET" aria-owns="predictive-search" class="search-drawer__form" role="search">
    <label for="search-drawer-input" class="sr-only">{{ 'search.general.drawer_placeholder' | t }}</label>
    <div class="search-field">
      <input id="search-drawer-input" type="search" class="search-drawer__input input" name="q" placeholder="{{ 'search.general.drawer_placeholder' | t }}" autocomplete="off" autocapitalize="off" enterkeyhint="search">
      <button type="submit" class="search-field__button">
        <span class="sr-only">{{ 'header.general.search' | t }}</span>
        {%- render 'icon' with 'search', width: 16 -%}
      </button>
    </div>
  </form>

  <predictive-search id="predictive-search">
    <div slot="placeholder">
      <div class="v-stack gap-8 sm:gap-12">
        {%- assign popular_searches = section.settings.popular_searches_menu -%}

        {%- if popular_searches.links.size > 0 -%}
          <div class="v-stack gap-4.5">
            {%- if section.settings.popular_searches_title != blank -%}
              <p class="subheading text-subdued">{{ section.settings.popular_searches_title }}</p>
            {%- endif -%}

            <div class="v-stack justify-items-start gap-3.5">
              {%- for link in popular_searches.links -%}
                <a href="{{ link.url }}" class="h7 link-reversed">{{ link.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- assign featured_products = section.settings.featured_products -%}

        {%- if featured_products.count > 0 -%}
          <div class="v-stack gap-4.5">
            {%- if section.settings.featured_products_title != blank -%}
              <p class="subheading text-subdued">{{ section.settings.featured_products_title }}</p>
            {%- endif -%}

            <div class="floating-controls-container">
              {%- assign featured_products_carousel = section.id | append: '-featured-products-carousel' -%}

              {%- if section.settings.show_carousel_arrows -%}
                <carousel-prev-button class="floating-controls__control floating-controls__control--offset" aria-controls="{{ featured_products_carousel }}">
                  <button disabled class="circle-button circle-button--xl">
                    <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
                    {%- render 'icon' with 'big-arrow-left', direction_aware: true -%}
                  </button>
                </carousel-prev-button>
              {%- endif -%}

              <scroll-carousel id="{{ featured_products_carousel }}" class="search-drawer__product-carousel scroll-area bleed">
                {%- for product in featured_products -%}
                  {%- render 'product-card', product: product, show_badges: false, show_quick_buy: false -%}
                {%- endfor -%}
              </scroll-carousel>

              {%- if section.settings.show_carousel_arrows -%}
                <carousel-next-button class="floating-controls__control floating-controls__control--offset" aria-controls="{{ featured_products_carousel }}">
                  <button class="circle-button circle-button--xl">
                    <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
                    {%- render 'icon' with 'big-arrow-right', direction_aware: true -%}
                  </button>
                </carousel-next-button>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div slot="results" class="contents"></div>
  </predictive-search>

</x-drawer>

{% schema %}
{
  "name": "t:sections.search_drawer.name",
  "class": "shopify-section--search-drawer",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "mobile_only",
      "label": "Show only on mobile",
      "info": "On larger screens the search icon opens the search page instead of this drawer.",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.search_drawer.empty_search_category",
      "info": "t:sections.search_drawer.empty_search_category_info"
    },
    {
      "type": "inline_richtext",
      "id": "popular_searches_title",
      "label": "t:sections.search_drawer.popular_searches_title",
      "default": "Popular searches"
    },
    {
      "type": "link_list",
      "id": "popular_searches_menu",
      "label": "t:sections.search_drawer.popular_searches_menu",
      "info": "t:sections.search_drawer.popular_searches_menu_info"
    },
    {
      "type": "inline_richtext",
      "id": "featured_products_title",
      "label": "t:sections.search_drawer.featured_products_title",
      "default": "Featured products"
    },
    {
      "type": "product_list",
      "id": "featured_products",
      "label": "t:sections.search_drawer.featured_products"
    },
    {
      "type": "checkbox",
      "id": "show_carousel_arrows",
      "label": "t:sections.search_drawer.show_carousel_arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "product_card_border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "t:sections.search_drawer.product_card_border_radius",
      "default": 0
    }
  ]
}
{% endschema %}