{%- if section.blocks.size > 0 -%}
  <style>
    #shopify-section-{{ section.id }} {
      {%- unless section.settings.allow_transparent_header -%}
        padding-block-start: var(--container-gutter);
      {%- endunless -%}
      padding-block-end: var(--section-vertical-spacing);
      {%- if section.settings.transition_type != 'fade' -%}
        --slideshow-background: {{ section.settings.background.rgb }};
      {%- endif -%}
    }

    {%- comment -%}
    Matches the existing .min-h-fill convention (assets/theme.css): subtract the sticky header/
    announcement bar area from the svh height, since that's real occupied space above the fold on
    every page except when this section is both first AND allows a transparent header - there, the
    header floats over the slideshow instead of pushing it down, so only the (non-transparent)
    announcement bar/countdown still needs subtracting.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .slideshow__slide .content-box {
      min-height: calc({{ section.settings.mobile_height }}svh - var(--sticky-area-height, 0px));
    }

    #shopify-section-{{ section.id }}:first-child [allow-transparent-header] .slideshow__slide .content-box {
      min-height: calc({{ section.settings.mobile_height }}svh - var(--announcement-bar-height, 0px) - var(--countdown-condensed-height, 0px));
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .slideshow__slide .content-box {
        min-height: calc({{ section.settings.desktop_height }}svh - var(--sticky-area-height, 0px));
      }

      #shopify-section-{{ section.id }}:first-child [allow-transparent-header] .slideshow__slide .content-box {
        min-height: calc({{ section.settings.desktop_height }}svh - var(--announcement-bar-height, 0px) - var(--countdown-condensed-height, 0px));
      }
    }
  </style>

  <div class="slideshow-wrapper {% unless section.settings.full_width %}container{% endunless %}">
    <slideshow-carousel id="slideshow-{{ section.id }}" allow-swipe cell-selector=".slideshow__slide" {% if section.settings.allow_transparent_header %}allow-transparent-header{% endif %} class="slideshow" transition="{{ section.settings.transition_type }}" {% if section.settings.autoplay %}autoplay="{{ section.settings.cycle_speed }}" {% if section.settings.pause_auto_rotate_on_hover %}pause-on-hover{% endif %}{% endif %} style="border-radius: {{ section.settings.border_radius }}px;" role="region">
      {%- content_for 'blocks' -%}

      {%- if section.blocks.size > 1 -%}
        {%- content_for 'block', type: '_slideshow-controls', id: 'slideshow-controls' -%}
      {%- endif -%}
    </slideshow-carousel>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.slideshow.name",
  "class": "shopify-section--slideshow",
  "tag": "section",
  "max_blocks": 5,
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "allow_transparent_header",
      "label": "t:global.section.allow_transparent_header",
      "info": "t:global.section.allow_transparent_header_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "info": "When disabled, the slideshow uses the same side margins as the rest of the store.",
      "default": false
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height (% of window)",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height (% of window)",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "transition_type",
      "label": "t:sections.slideshow.transition_type",
      "options": [
        {
          "value": "fade",
          "label": "t:sections.slideshow.transition_type_options.fade"
        },
        {
          "value": "vertical_reveal",
          "label": "t:sections.slideshow.transition_type_options.vertical_reveal"
        },
        {
          "value": "curtain",
          "label": "t:sections.slideshow.transition_type_options.curtain"
        },
        {
          "value": "distortion",
          "label": "t:sections.slideshow.transition_type_options.distortion"
        },
        {
          "value": "perspective",
          "label": "t:sections.slideshow.transition_type_options.perspective"
        },
        {
          "value": "scale_down",
          "label": "t:sections.slideshow.transition_type_options.scale_down"
        }
      ],
      "default": "curtain"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.slideshow.auto_rotate_between_slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_auto_rotate_on_hover",
      "label": "t:sections.slideshow.pause_auto_rotate_on_hover",
      "default": false,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "sec",
      "label": "t:sections.slideshow.cycle_speed",
      "default": 6,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:global.colors.background",
      "info": "t:sections.slideshow.background_info",
      "default": "#000000"
    },
  ],
  "blocks": [
    { "type": "_slideshow-image-slide" },
    { "type": "_slideshow-video-slide" }
  ],
  "presets": [
    {
      "name": "t:sections.slideshow.name",
      "category": "t:global.categories.banners",
      "blocks": [
        {
          "type": "_slideshow-controls",
          "id": "slideshow-controls",
          "static": true
        },
        {
          "type": "_slideshow-image-slide",
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "text": "Slide 1",
                "heading_size": "h1"
              }
            }
          ]
        },
        {
          "type": "_slideshow-image-slide",
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "text": "Slide 2",
                "heading_size": "h1"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
