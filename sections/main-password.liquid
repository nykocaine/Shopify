{%- capture section_main_content -%}
  <div class="password-password-main w-full">
    <div class="password-password-main__inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'logo' -%}
            {%- capture logo_content -%}
              {%- if block.settings.image != blank -%}
                {%- capture sizes -%}{{ block.settings.max_width }}px{%- endcapture -%}
                {%- capture widths -%}{{ block.settings.max_width | times: 2 | at_most: block.settings.image.width }}, {{ block.settings.max_width | times: 3 | at_most: block.settings.image.width }}{%- endcapture -%}
                {%- capture style -%}--image-mobile-max-width: {{ block.settings.mobile_max_width }}px; --image-max-width: {{ block.settings.max_width }}px{%- endcapture -%}

                <span class="sr-only">{{ shop.name }}</span>
                {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: style: style, sizes: sizes, widths: widths, class: 'constrained-image' -}}
              {%- else -%}
                <span class="h4">{{ shop.name }}</span>
              {%- endif -%}
            {%- endcapture -%}

            <h1 class="password-password-main__logo" {{ block.shopify_attributes }}>{{- logo_content -}}</h1>

          {%- when 'content' -%}
            <div class="password-password-main__content w-full max-w-xs mx-auto">
              <div class="v-stack gap-8 sm:gap-10">
                <div class="v-stack gap-4 sm:gap-6">
                  {%- if shop.password_message != blank -%}
                    <div class="prose prose-justify-center text-center">
                      <p>{{ shop.password_message }}</p>
                    </div>
                  {%- endif -%}

                  <div class="v-stack gap-4">
                    {%- liquid
                      assign has_password_form_errors = false

                      capture password_form_content
                        form 'storefront_password', class: 'form-row'
                          if form.errors
                            assign has_password_form_errors = true
                            render 'banner', status: 'error', content: form.errors.messages['form'], text_alignment: 'center'
                          endif

                          echo '<div class="newsletter-input-group vertically-separated-list">'

                          assign password_label = 'password.storefront_access.password' | t
                          render 'input', name: 'password', label: password_label, type: 'password', required: true, autocomplete: 'current-password', enterkeyhint: 'go'

                          echo '<hr>'

                          assign enter_label = 'password.storefront_access.enter_store' | t
                          render 'button', type: 'submit', content: enter_label, style: 'link'

                          echo '</div>'
                        endform
                      endcapture
                    -%}

                    {%- comment -%}
                    The newsletter form and the storefront password form live inside the same x-tabs component, so
                    they cross-fade in place as a single component with two states (see .newsletter-input-group and
                    .password-access-tabs in assets/theme.css) instead of opening a separate modal. Only the tab
                    button that switches to the OTHER state is ever visible (see .password-access-tabs [role="tab"]
                    [aria-selected="true"] in theme.css).
                    {%- endcomment -%}

                    <x-tabs class="password-access-tabs" {% if has_password_form_errors %}selected-index="1"{% endif %}>
                      <button type="button" slot="tab" class="link text-center">
                        {{- 'password.storefront_access.back_to_newsletter' | t -}}
                      </button>

                      <div slot="tabpanel">
                        {%- render 'newsletter-form', id: section.id -%}
                      </div>

                      <button type="button" slot="tab" class="link text-center">
                        {{- 'password.storefront_access.enter_password' | t -}}
                      </button>

                      <div slot="tabpanel">
                        {{- password_form_content -}}
                      </div>
                    </x-tabs>
                  </div>
                </div>

                {%- capture social_media -%}{%- render 'social-media' -%}{%- endcapture -%}

                {%- if block.settings.show_social_media and social_media != blank -%}
                  <hr>

                  <div class="v-stack justify-items-center gap-5 text-center">
                    <p>{{ 'password.general.follow_us' | t }}</p>
                    {{- social_media -}}
                  </div>
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
{%- endcapture -%}

{%- liquid
  assign has_image_content = false
  if section.settings.background_image != blank or section.settings.image_rotating_text != blank
    assign has_image_content = true
  endif
-%}

{%- style -%}
  .password-section-shell {
    min-height: 100vh;
    min-height: 100svh;
  }

  .password-section-shell--single {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .password-section-shell--split {
    min-height: 100vh;
    min-height: 100svh;
  }

  .password-password-main {
    width: 100%;
    padding-inline: 1rem;
  }

  .password-password-main__inner {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .password-password-main__logo {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .password-password-main__content {
    width: 100%;
  }

  @media screen and (min-width: 700px) {
    .password-section-shell--single {
      padding: 2.5rem;
    }

    .password-password-main {
      padding-inline: 1.5rem;
    }
  }

  @media screen and (min-width: 1000px) {
    .password-section-shell--single {
      padding: 3rem;
    }

    .password-password-main {
      padding-inline: 2rem;
    }

    /* On the split layout the grid column and .password-password-main already
       provide the inline padding, so drop the shell's own to avoid triple gutters. */
    .section-split__column.password-section-shell--single {
      padding-inline: 0;
    }
  }

  @supports (min-height: 100dvh) {
    .password-section-shell,
    .password-section-shell--split {
      min-height: 100dvh;
    }
  }

  {%- if section.settings.floating_password -%}
    #shopify-section-{{ section.id }} .password-section-shell,
    #shopify-section-{{ section.id }} .password-section-shell--split {
      min-height: calc(100vh - (var(--container-gutter) * 2));
      min-height: calc(100svh - (var(--container-gutter) * 2));
    }

    @supports (min-height: 100dvh) {
      #shopify-section-{{ section.id }} .password-section-shell,
      #shopify-section-{{ section.id }} .password-section-shell--split {
        min-height: calc(100dvh - (var(--container-gutter) * 2));
      }
    }
  {%- endif -%}

  {%- comment -%} ------- Glossier-inspired skin (scoped to this section only) ------- {%- endcomment -%}
  {%- if section.settings.glossier_style -%}
    {%- assign gl_bg = section.settings.glossier_background | default: '#FBEDE7' -%}

    #shopify-section-{{ section.id }} {
      --gl-ink: 28 26 25;
      --gl-paper: 255 255 255;
    }

    /* Soft blush canvas behind the form */
    #shopify-section-{{ section.id }} .password-section-shell--single {
      background-color: {{ gl_bg }};
      background-image: radial-gradient(
        140% 92% at 50% -12%,
        color-mix(in srgb, {{ gl_bg }} 100%, #fff 24%) 0%,
        {{ gl_bg }} 46%,
        color-mix(in srgb, {{ gl_bg }} 100%, #000 7%) 100%
      );
    }

    /* Re-map the theme's component tokens for the form area */
    #shopify-section-{{ section.id }} .password-password-main,
    #shopify-section-{{ section.id }} .password-password-main .color-scheme {
      --text-color: var(--gl-ink);
      --input-background: var(--gl-paper);
      --input-text-color: var(--gl-ink);
      --input-border-color: rgb(var(--gl-ink) / 0.14);
      --input-border-radius: 999px;
      --button-background-primary: var(--gl-ink);
      --button-text-primary: var(--gl-paper);
      color: rgb(var(--gl-ink));
    }

    /* Logo / wordmark */
    #shopify-section-{{ section.id }} .password-password-main__logo {
      margin-bottom: 2.25rem;
    }

    #shopify-section-{{ section.id }} .password-password-main__logo .h4 {
      font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2rem);
      font-weight: 500;
      letter-spacing: -0.01em;
    }

    /* Password message */
    #shopify-section-{{ section.id }} .password-password-main .prose p {
      font-size: 1.0625rem;
      line-height: 1.65;
      color: rgb(var(--gl-ink) / 0.72);
    }

    /* Merged pill: email/password input + inset send button */
    #shopify-section-{{ section.id }} .newsletter-input-group {
      padding: 5px;
      overflow: visible;
      background: rgb(var(--gl-paper));
      border-color: rgb(var(--gl-ink) / 0.12);
      box-shadow: 0 1px 2px rgb(var(--gl-ink) / 0.04), 0 18px 40px -22px rgb(var(--gl-ink) / 0.45);
      transition: box-shadow 0.25s ease, border-color 0.25s ease;
    }

    #shopify-section-{{ section.id }} .newsletter-input-group:focus-within {
      border-color: rgb(var(--gl-ink) / 0.34);
      box-shadow: 0 1px 2px rgb(var(--gl-ink) / 0.05), 0 22px 48px -20px rgb(var(--gl-ink) / 0.5);
    }

    #shopify-section-{{ section.id }} .newsletter-input-group hr {
      display: none;
    }

    #shopify-section-{{ section.id }} .newsletter-input-group .link {
      margin-inline-start: 5px;
      padding-inline: 1.4rem;
      background: rgb(var(--gl-ink));
      color: rgb(var(--gl-paper));
      border-radius: 999px;
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
    }

    #shopify-section-{{ section.id }} .newsletter-input-group .link:hover {
      transform: translateY(-1px);
      opacity: 0.92;
    }

    #shopify-section-{{ section.id }} .newsletter-input-group .link:active {
      transform: translateY(0);
    }

    /* Tab switch ("enter password" / "back to newsletter") as a quiet underlined link */
    #shopify-section-{{ section.id }} .password-access-tabs {
      row-gap: 1.5rem;
    }

    #shopify-section-{{ section.id }} .password-access-tabs [slot="tab"] {
      font-size: 0.82rem;
      letter-spacing: 0.02em;
      color: rgb(var(--gl-ink) / 0.6);
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-thickness: 1px;
      transition: color 0.2s ease;
    }

    #shopify-section-{{ section.id }} .password-access-tabs [slot="tab"]:hover {
      color: rgb(var(--gl-ink));
    }

    /* Dividers (social row) */
    #shopify-section-{{ section.id }} .password-password-main hr {
      border-color: rgb(var(--gl-ink) / 0.12);
      background: rgb(var(--gl-ink) / 0.12);
    }

    {%- if section.settings.floating_password -%}
      #shopify-section-{{ section.id }} > .color-scheme {
        box-shadow: 0 40px 90px -60px rgb(var(--gl-ink) / 0.55);
      }
    {%- endif -%}

    /* Gentle entrance */
    @media (prefers-reduced-motion: no-preference) {
      #shopify-section-{{ section.id }} .password-password-main__inner > * {
        animation: gl-rise-{{ section.id }} 0.75s cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      #shopify-section-{{ section.id }} .password-password-main__inner > *:nth-child(2) {
        animation-delay: 0.09s;
      }
    }

    @keyframes gl-rise-{{ section.id }} {
      from {
        opacity: 0;
        transform: translateY(14px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }
  {%- endif -%}
{%- endstyle -%}

<div class="color-scheme color-scheme--{{ section.settings.content_color_scheme.id }}{% if section.settings.floating_password %} section-floating section-floating--block{% endif %}"{% if section.settings.floating_password %} style="border-radius: {{ section.settings.password_border_radius }}px; overflow: hidden;"{% endif %}>
  {%- if section.settings.show_image_panel and has_image_content -%}
    <div class="section-split password-section-shell password-section-shell--split md:min-h-fill">
      <div class="section-split__column section-split__column--image section-split__column--flushed hidden md:block">
        <div class="content-box h-full min-h-sm color-scheme color-scheme--{{ section.settings.image_color_scheme.id }}">
          {%- if section.settings.background_image != blank -%}
            <div class="content-box__background-media">
              {{- section.settings.background_image | image_url: width: section.settings.background_image.width | image_tag: sizes: '(max-width: 699px) 100vw, 50vw', widths: '200,300,400,600,800,1000,1200,1400,1600,1800,2000' -}}
            </div>
          {%- endif -%}

          {%- if section.settings.image_rotating_text != blank -%}
            <div class="column-span-full align-self-center">
              <marquee-text speed="0.1" direction="start-to-end" class="scrolling-content">
                <div class="scrolling-content__item" style="font-size: var(--text-h1)">
                  <p class="h1">{{ section.settings.image_rotating_text }}</p>
                </div>
              </marquee-text>

              <marquee-text speed="0.1" direction="end-to-start" class="scrolling-content">
                <div class="scrolling-content__item" style="font-size: var(--text-h1)">
                  <p class="h1">{{ section.settings.image_rotating_text }}</p>
                </div>
              </marquee-text>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="section-split__column password-section-shell password-section-shell--single align-self-center">
        {{- section_main_content -}}
      </div>
    </div>
  {%- else -%}
    <div class="password-section-shell password-section-shell--single">
      {{- section_main_content -}}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Password",
  "class": "shopify-section--main-password",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Estilo Glossier"
    },
    {
      "type": "checkbox",
      "id": "glossier_style",
      "label": "Activar estética Glossier",
      "info": "Look minimalista tipo Glossier: fondo rosa empolvado, tipografía depurada, input tipo píldora con botón integrado y una entrada animada suave. Solo afecta a esta sección.",
      "default": true
    },
    {
      "type": "color",
      "id": "glossier_background",
      "label": "Color de fondo (blush)",
      "default": "#FBEDE7",
      "visible_if": "{{ section.settings.glossier_style }}"
    },
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "checkbox",
      "id": "show_image_panel",
      "label": "Mostrar panel de imagen",
      "info": "Activa o desactiva la columna izquierda de imagen.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "floating_password",
      "label": "Floating Password",
      "info": "Adds margins around the password page (top, bottom and sides), using the store's global side margin.",
      "default": false
    },
    {
      "type": "range",
      "id": "password_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0,
      "visible_if": "{{ section.settings.floating_password }}"
    },
    {
      "type": "color_scheme",
      "id": "image_color_scheme",
      "label": "Image color scheme",
      "default": "scheme-2"
    },
    {
      "type": "color_scheme",
      "id": "content_color_scheme",
      "label": "Content color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Recommended size for the password page background image"
    },
    {
      "type": "inline_richtext",
      "id": "image_rotating_text",
      "label": "Image rotating text",
      "default": "Opening Soon"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image",
          "info": "Recommended size for the password page logo"
        },
        {
          "type": "range",
          "id": "max_width",
          "min": 50,
          "max": 300,
          "step": 5,
          "unit": "px",
          "label": "Desktop width",
          "default": 140
        },
        {
          "type": "range",
          "id": "mobile_max_width",
          "min": 50,
          "max": 170,
          "step": 5,
          "unit": "px",
          "label": "Mobile width",
          "default": 100
        }
      ]
    },
    {
      "type": "content",
      "name": "Content",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Newsletter form and password access."
        },
        {
          "type": "checkbox",
          "id": "show_social_media",
          "label": "Show social media",
          "info": "Display social media links if available.",
          "default": true
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "logo"
      },
      {
        "type": "content"
      }
    ]
  }
}
{% endschema %}