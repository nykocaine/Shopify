{%- doc -%}
A reviews section modeled visually on the Okendo reviews widget (rating summary, a sort control, review
cards with reviewer/product/attribute info, an attribute bar, and helpful voting), but built natively
with theme blocks instead of depending on the Okendo app.

Reviews are not stored anywhere outside the theme: each review shown on the storefront is a "Review"
block that the merchant adds/edits/reorders from the theme editor, exactly like the FAQ block. The "Write
a Review" button opens a native Shopify contact form (same mechanism as the Contact section) which emails
the submission to the shop's customer email - nothing is published automatically. To "approve" a review,
the merchant reads the email and adds a matching Review block here.
{%- enddoc -%}

{%- liquid
  assign review_blocks = section.blocks | where: 'type', 'review'

  # Same metafields snippets/product-rating.liquid already reads (product.metafields.custom.reviews_rating
  # / reviews_count) - when this section sits on a product page and they're set, the summary badge shown
  # here matches whatever the product card/product page already shows, instead of only reflecting however
  # many "Review" blocks happen to be added below. Falls back to counting/averaging the blocks themselves
  # when the metafields aren't set (eg. a non-product page, or a product without them yet).
  if product and product.metafields.custom.reviews_rating.value != blank
    assign average_rating = product.metafields.custom.reviews_rating.value.rating | plus: 0 | round: 1
    assign review_count = product.metafields.custom.reviews_count.value | default: 0
  else
    assign review_count = review_blocks.size
    assign rating_sum = 0

    for review_block in review_blocks
      assign rating_sum = rating_sum | plus: review_block.settings.rating
    endfor

    if review_count > 0
      assign average_rating = rating_sum | times: 1.0 | divided_by: review_count | round: 1
    else
      assign average_rating = 0
    endif
  endif

  assign write_review_modal_id = 'write-review-' | append: section.id
-%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_reviews %} section-floating section-floating--block{% endif %}"{% if section.settings.floating_reviews %} style="border-radius: {{ section.settings.reviews_border_radius }}px; overflow: hidden;"{% endif %}>
  <div class="section-spacing">
    <div id="reviews-{{ section.id }}" class="reviews section-stack">
      {%- if section.settings.title != blank -%}
        <div class="prose">
            {%- render 'heading', content: section.settings.title, style: 'h3', html_tag: 'h2' -%}
          </div>
        {%- endif -%}

        <div class="reviews__summary">
          <div class="reviews__summary-rating">
            <span class="reviews__summary-average">{{ average_rating }}</span>

            <span class="reviews__stars" role="img" aria-label="{{ 'general.rating.info' | t: rating_value: average_rating, rating_max: 5 }}">
              {%- for i in (1..5) -%}
                {%- liquid
                  assign half_threshold = i | minus: 0.5

                  if review_count == 0
                    render 'icon' with 'star-rating-empty'
                  elsif average_rating >= i
                    render 'icon' with 'star-rating'
                  elsif average_rating >= half_threshold
                    render 'icon' with 'star-rating-half'
                  else
                    render 'icon' with 'star-rating-empty'
                  endif
                -%}
              {%- endfor -%}
            </span>
          </div>

          <p class="reviews__summary-label subheading">Calificación promedio</p>
          <p class="reviews__summary-count">Basado en {{ review_count }} reseña{% if review_count != 1 %}s{% endif %}</p>
        </div>

        {%- if review_blocks.size > 0 -%}
          <div class="reviews__controls">
            <div class="reviews__sort button">
              <label class="sr-only" for="reviews-sort-{{ section.id }}">Ordenar reseñas</label>
              <div class="button__content">
                <select id="reviews-sort-{{ section.id }}" class="select" data-reviews-sort>
                  <option value="recent">Más recientes</option>
                  <option value="rating_desc">Mejor calificación</option>
                  <option value="rating_asc">Peor calificación</option>
                </select>
                {%- render 'icon' with 'chevron-down' -%}
              </div>
            </div>
          </div>

          <p class="reviews__count">{{ review_blocks.size }} reseña{% if review_blocks.size != 1 %}s{% endif %}</p>

          <div class="reviews__list" data-reviews-list>
            {%- for block in review_blocks -%}
              <div class="review-card" data-rating="{{ block.settings.rating }}" data-index="{{ forloop.index }}" {{ block.shopify_attributes }}>
                <div class="review-card__side">
                  <div class="review-card__reviewer">
                    <strong class="review-card__name">{{ block.settings.reviewer_name }}</strong>

                    {%- if block.settings.verified_buyer -%}
                      <span class="review-card__verified">
                        {%- render 'icon' with 'picto-checked', width: 13, stroke_width: 1.5 -%}
                        Comprador verificado
                      </span>
                    {%- endif -%}
                  </div>

                  {%- if block.settings.product_name != blank -%}
                    <div class="review-card__product">
                      <p class="review-card__product-label subheading">Producto</p>
                      {%- if block.settings.product_url != blank -%}
                        <a href="{{ block.settings.product_url }}" class="link">{{ block.settings.product_name }}</a>
                      {%- else -%}
                        <span>{{ block.settings.product_name }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  {%- liquid
                    assign has_attributes = false

                    for i in (1..3)
                      capture attr_label_key
                        echo 'attribute_'
                        echo i
                        echo '_label'
                      endcapture

                      if block.settings[attr_label_key] != blank
                        assign has_attributes = true
                      endif
                    endfor
                  -%}

                  {%- if has_attributes -%}
                    <div class="review-card__attributes">
                      {%- for i in (1..3) -%}
                        {%- liquid
                          capture attr_label_key
                            echo 'attribute_'
                            echo i
                            echo '_label'
                          endcapture

                          capture attr_value_key
                            echo 'attribute_'
                            echo i
                            echo '_value'
                          endcapture

                          assign attr_label = block.settings[attr_label_key]
                          assign attr_value = block.settings[attr_value_key]
                        -%}

                        {%- if attr_label != blank -%}
                          <div class="review-card__attribute">
                            <strong>{{ attr_label }}</strong>
                            <span>{{ attr_value }}</span>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>

                <div class="review-card__main">
                  <div class="review-card__top">
                    <span class="review-card__stars" role="img" aria-label="{{ 'general.rating.info' | t: rating_value: block.settings.rating, rating_max: 5 }}">
                      {%- for i in (1..5) -%}
                        {%- if block.settings.rating >= i -%}
                          {%- render 'icon' with 'star-rating' -%}
                        {%- else -%}
                          {%- render 'icon' with 'star-rating-empty' -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </span>

                    {%- if block.settings.date_label != blank -%}
                      <span class="review-card__date">{{ block.settings.date_label }}</span>
                    {%- endif -%}
                  </div>

                  {%- if block.settings.title != blank -%}
                    <p class="review-card__title">{{ block.settings.title }}</p>
                  {%- endif -%}

                  {%- if block.settings.body != blank -%}
                    <div class="review-card__body">
                      {{- block.settings.body -}}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.bar_question != blank -%}
                    <div class="review-card__bar">
                      <p class="review-card__bar-question">{{ block.settings.bar_question }}</p>

                      <div class="review-card__bar-track">
                        <div class="review-card__bar-fill" style="width: {{ block.settings.bar_value | times: 1.0 | divided_by: 5 | times: 100 }}%;"></div>
                      </div>

                      <div class="review-card__bar-labels">
                        <span>{{ block.settings.bar_min_label }}</span>
                        <span>{{ block.settings.bar_max_label }}</span>
                      </div>
                    </div>
                  {%- endif -%}

                  <div class="review-card__helpful" data-reviews-helpful>
                    <span data-reviews-helpful-label>¿Te resultó útil?</span>
                    <button type="button" data-reviews-helpful-button="yes">Sí</button>
                    <button type="button" data-reviews-helpful-button="no">No</button>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="reviews__write">
          {%- render 'button', content: section.settings.write_review_button_text, aria_controls: write_review_modal_id -%}
        </div>
      </div>
  </div>
</div>

{%- comment -%}
The form block has to run (and "form" become available) before the has_form_feedback check below, so
its output is captured here and echoed inside the modal afterwards - not evaluated directly inside the
<x-modal> tag, whose opening tag (with the "open" attribute) needs that same check to happen first.
{%- endcomment -%}
{%- capture review_form_content -%}
  {%- form 'contact', class: 'form' -%}
    {%- if form.posted_successfully? -%}
      {%- render 'banner', status: 'success', content: '¡Gracias! Tu reseña fue enviada y aparecerá aquí una vez aprobada.' -%}
    {%- endif -%}

    {%- if form.errors -%}
      {%- capture error_content -%}{{ form.errors.translated_fields[form.errors.first] | capitalize }} {{ form.errors.messages[form.errors.first] }}{%- endcapture -%}
      {%- render 'banner', status: 'error', content: error_content -%}
    {%- endif -%}

    <input type="hidden" name="contact[Submission type]" value="Review">

    <div class="fieldset">
      <div class="fieldset-row">
        {%- render 'input', type: 'text', name: 'contact[name]', label: 'Nombre', required: true, autocomplete: 'name' -%}
        {%- render 'input', type: 'email', name: 'contact[email]', label: 'Correo electrónico', required: true, autocomplete: 'email' -%}
      </div>

      <div class="review-form__rating">
        <span class="review-form__rating-label">Calificación</span>
        <div class="review-form__rating-options">
          {%- for i in (5..1) -%}
            {%- capture rating_option_label -%}{{ i }} estrella{% if i != 1 %}s{% endif %}{%- endcapture -%}
            {%- render 'checkbox', type: 'radio', name: 'contact[Rating]', value: i, label: rating_option_label, required: true, id_prefix: section.id -%}
          {%- endfor -%}
        </div>
      </div>

      {%- render 'input', type: 'text', name: 'contact[Review title]', label: 'Título de la reseña', required: true -%}
      {%- render 'input', name: 'contact[body]', label: 'Reseña', multiline: 5, required: true -%}
    </div>

    <div>
      {%- render 'button', content: 'Enviar reseña', type: 'submit' -%}
    </div>

    <p class="review-form__disclaimer">Las reseñas son moderadas y pueden tardar unos días en aparecer.</p>
  {%- endform -%}
{%- endcapture -%}

{%- liquid
  assign has_form_feedback = false

  if form.posted_successfully? or form.errors
    assign has_form_feedback = true
  endif
-%}

<x-modal id="{{ write_review_modal_id }}" append-to-body {% if has_form_feedback %}open{% endif %} class="modal color-scheme color-scheme--{{ settings.default_color_scheme.id }}">
  <div class="prose">
    <p class="h5">{{ section.settings.write_review_button_text }}</p>
  </div>

  {{- review_form_content -}}
</x-modal>

<style>
  {%- if section.settings.floating_reviews -%}
    {%- comment -%}
    Floating mode: this section behaves as its own padded card (like the floating info_panel it typically
    sits next to) instead of a plain page section, so .section-spacing's generic page-to-page rhythm is
    zeroed out and replaced with info_panel's own exact card padding formula - same
    min(2.5rem, var(--container-gutter)), same --container-gutter source, so the two line up when stacked.
    Left as the normal .section-spacing rhythm when not floating, since then this is just a regular
    full-width page section like any other.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .section-spacing {
      padding-block: 0;
    }

    #shopify-section-{{ section.id }} .reviews {
      padding: min(2.5rem, var(--container-gutter));
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .reviews__summary {
    text-align: start;
  }

  #shopify-section-{{ section.id }} .reviews__summary-rating {
    align-items: center;
    justify-content: start;
    column-gap: .75rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .reviews__summary-average {
    font-size: var(--text-h2);
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .reviews__stars,
  #shopify-section-{{ section.id }} .review-card__stars {
    gap: .125rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .reviews__summary-label {
    text-transform: uppercase;
    font-weight: 600;
    margin-block-start: .5rem;
  }

  #shopify-section-{{ section.id }} .reviews__summary-count {
    color: rgb(var(--text-color) / .6);
  }

  #shopify-section-{{ section.id }} .reviews__controls {
    justify-content: start;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    display: flex;
  }

  {%- comment -%}
  .reviews__sort only resets the .select/.icon's own boxed-input styling (border/background/color/height,
  and the icon's absolute positioning, both meant for a standalone input field) - the actual background,
  border, text color and height all come from the plain .button/.button__content classes on the element
  itself (no --outline modifier), so it inherits the same solid background/border/text color the schema's
  other buttons (eg. "Write a Review") already use, instead of custom values.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .reviews__sort .button__content {
    column-gap: .5rem;
  }

  #shopify-section-{{ section.id }} .reviews__sort .select {
    width: auto;
    height: auto;
    border: none;
    padding: 0;
    background: none;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .reviews__sort .select ~ svg {
    position: static;
    inset: auto;
  }

  #shopify-section-{{ section.id }} .reviews__count {
    color: rgb(var(--text-color) / .6);
    border-block-end: 1px solid rgb(var(--border-color));
    padding-block-end: 1.5rem;
  }

  #shopify-section-{{ section.id }} .reviews__list {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .review-card {
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 2rem;
    padding-block: 2rem;
    border-block-end: 1px solid rgb(var(--border-color));
    display: grid;
  }

  #shopify-section-{{ section.id }} .review-card:last-child {
    border-block-end: none;
  }

  #shopify-section-{{ section.id }} .review-card__side {
    flex-direction: column;
    gap: 1.25rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__reviewer {
    flex-direction: column;
    gap: .375rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__verified {
    color: rgb(var(--text-color) / .6);
    font-size: .875em;
    align-items: center;
    column-gap: .3em;
    display: inline-flex;
  }

  #shopify-section-{{ section.id }} .review-card__verified svg {
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .review-card__product-label {
    text-transform: uppercase;
    font-weight: 600;
    margin-block-end: .25rem;
  }

  #shopify-section-{{ section.id }} .review-card__attributes {
    flex-direction: column;
    gap: .75rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__attribute {
    flex-direction: column;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__attribute span {
    color: rgb(var(--text-color) / .8);
  }

  #shopify-section-{{ section.id }} .review-card__main {
    flex-direction: column;
    gap: 1rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__top {
    justify-content: space-between;
    align-items: center;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__date {
    color: rgb(var(--text-color) / .6);
    font-size: .875em;
  }

  #shopify-section-{{ section.id }} .review-card__title {
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .review-card__bar {
    max-width: 22rem;
  }

  #shopify-section-{{ section.id }} .review-card__bar-question {
    font-weight: 600;
    margin-block-end: .75rem;
  }

  #shopify-section-{{ section.id }} .review-card__bar-track {
    height: 4px;
    border-radius: var(--rounded-full);
    background: rgb(var(--border-color));
    position: relative;
  }

  #shopify-section-{{ section.id }} .review-card__bar-fill {
    height: 100%;
    border-radius: var(--rounded-full);
    background: rgb(var(--text-color));
  }

  #shopify-section-{{ section.id }} .review-card__bar-fill::after {
    content: "";
    width: 12px;
    height: 12px;
    border-radius: var(--rounded-full);
    background: rgb(var(--text-color));
    position: absolute;
    inset-inline-end: -6px;
    inset-block-start: -4px;
  }

  #shopify-section-{{ section.id }} .review-card__bar-labels {
    justify-content: space-between;
    color: rgb(var(--text-color) / .6);
    font-size: .875em;
    margin-block-start: .5rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__helpful {
    align-items: center;
    gap: .75rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__helpful button {
    padding: .25rem .75rem;
    border: 1px solid rgb(var(--border-color));
    border-radius: var(--rounded-full);
    background: none;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .review-card__helpful button[aria-pressed="true"] {
    background: rgb(var(--text-color) / .08);
  }

  #shopify-section-{{ section.id }} .reviews__write {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .review-form__rating-options {
    flex-wrap: wrap;
    gap: 1rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-form__rating-label {
    font-weight: 600;
    display: block;
    margin-block-end: .5rem;
  }

  #shopify-section-{{ section.id }} .review-form__disclaimer {
    color: rgb(var(--text-color) / .6);
    font-size: .875em;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .review-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    #shopify-section-{{ section.id }} .review-card__main {
      order: 1;
    }

    #shopify-section-{{ section.id }} .review-card__side {
      order: 2;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('reviews-{{ section.id }}');
    if (!root) return;

    var list = root.querySelector('[data-reviews-list]');
    var cards = list ? Array.prototype.slice.call(list.querySelectorAll('.review-card')) : [];
    var sortSelect = root.querySelector('[data-reviews-sort]');

    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        var sortedCards = cards.slice();

        if (sortSelect.value === 'rating_desc') {
          sortedCards.sort(function (a, b) { return b.getAttribute('data-rating') - a.getAttribute('data-rating'); });
        } else if (sortSelect.value === 'rating_asc') {
          sortedCards.sort(function (a, b) { return a.getAttribute('data-rating') - b.getAttribute('data-rating'); });
        } else {
          sortedCards.sort(function (a, b) { return a.getAttribute('data-index') - b.getAttribute('data-index'); });
        }

        sortedCards.forEach(function (card) { list.appendChild(card); });
      });
    }

    root.querySelectorAll('[data-reviews-helpful]').forEach(function (group) {
      var label = group.querySelector('[data-reviews-helpful-label]');
      var buttons = Array.prototype.slice.call(group.querySelectorAll('[data-reviews-helpful-button]'));

      buttons.forEach(function (button) {
        button.addEventListener('click', function () {
          buttons.forEach(function (otherButton) { otherButton.setAttribute('aria-pressed', 'false'); });
          button.setAttribute('aria-pressed', 'true');
          if (label) label.textContent = '¡Gracias por tu opinión!';
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Reviews",
  "class": "shopify-section--reviews",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "floating_reviews",
      "label": "Floating Reviews",
      "info": "Adds margins around the section (bottom and sides), using the store's global side margin.",
      "default": false
    },
    {
      "type": "range",
      "id": "reviews_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0,
      "visible_if": "{{ section.settings.floating_reviews }}"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Reviews"
    },
    {
      "type": "paragraph",
      "content": "Reviews shown below are \"Review\" blocks you add/edit/reorder here - nothing is pulled from an external app. \"Write a Review\" opens a form that emails the submission to the shop's customer email (same as the Contact form); add a matching block once you decide to approve it."
    },
    {
      "type": "text",
      "id": "write_review_button_text",
      "label": "Write a review button text",
      "default": "Escribir una reseña"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer name",
          "default": "Customer"
        },
        {
          "type": "checkbox",
          "id": "verified_buyer",
          "label": "Verified buyer",
          "default": true
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "date_label",
          "label": "Date",
          "info": "Shown as entered, eg. \"3 days ago\" or \"August 2026\".",
          "default": "3 days ago"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Great product!"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Review",
          "default": "<p>Share what the customer wrote.</p>"
        },
        {
          "type": "header",
          "content": "Product (optional)"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product name"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Product link"
        },
        {
          "type": "header",
          "content": "Attributes (optional)"
        },
        {
          "type": "paragraph",
          "content": "Extra label/value pairs shown next to the reviewer, eg. \"Age Range: 45-54\". Leave a label blank to skip it."
        },
        {
          "type": "text",
          "id": "attribute_1_label",
          "label": "Attribute 1 label"
        },
        {
