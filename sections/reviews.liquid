{%- doc -%}
A reviews section modeled visually on the Okendo reviews widget (rating summary, a sort control, review
cards with reviewer/product/attribute info, an attribute bar, and helpful voting), but built natively
with theme blocks instead of depending on the Okendo app.

Reviews are not stored anywhere outside the theme: each review shown on the storefront is a "Review"
block that the merchant adds/edits/reorders from the theme editor, exactly like the FAQ block. Only the
first 5 review cards show initially; a "Ver más" button reveals 5 more at a time, and disappears once
every review is visible. Sorting always re-applies before the reveal count, so changing sort resets back
to the first 5 of the newly sorted order.
{%- enddoc -%}

{%- liquid
  assign review_blocks = section.blocks | where: 'type', 'review'

  # Same metafields snippets/product-rating.liquid already reads (product.metafields.custom.reviews_rating
  # / reviews_count) - when this section sits on a product page and they're set, the summary badge shown
  # here matches whatever the product card/product page already shows, instead of only reflecting however
  # many "Review" blocks happen to be added below. Falls back to counting/averaging the blocks themselves
  # when the metafields aren't set (eg. a non-product page, or a product without them yet).
  if product and product.metafields.custom.reviews_rating.value != blank
    assign average_rating = product.metafields.custom.reviews_rating.value.rating | plus: 0 | round: 1
    assign review_count = product.metafields.custom.reviews_count.value | default: 0
  else
    assign review_count = review_blocks.size
    assign rating_sum = 0

    for review_block in review_blocks
      assign rating_sum = rating_sum | plus: review_block.settings.rating
    endfor

    if review_count > 0
      assign average_rating = rating_sum | times: 1.0 | divided_by: review_count | round: 1
    else
      assign average_rating = 0
    endif
  endif

  assign write_review_modal_id = 'write-review-' | append: section.id
-%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_reviews %} section-floating section-floating--block{% endif %}"{% if section.settings.floating_reviews %} style="border-radius: {{ section.settings.reviews_border_radius }}px; overflow: hidden;"{% endif %}>
  <div class="section-spacing">
    <div id="reviews-{{ section.id }}" class="reviews section-stack">
        <div class="reviews__summary-row">
          <div class="reviews__summary">
            <div class="reviews__summary-rating">
              <span class="reviews__summary-average">{{ average_rating }}</span>

              <span class="reviews__stars" role="img" aria-label="{{ 'general.rating.info' | t: rating_value: average_rating, rating_max: 5 }}">
                {%- for i in (1..5) -%}
                  {%- liquid
                    assign half_threshold = i | minus: 0.5

                    if review_count == 0
                      render 'icon' with 'star-rating-empty'
                    elsif average_rating >= i
                      render 'icon' with 'star-rating'
                    elsif average_rating >= half_threshold
                      render 'icon' with 'star-rating-half'
                    else
                      render 'icon' with 'star-rating-empty'
                    endif
                  -%}
                {%- endfor -%}
              </span>
            </div>

            <p class="reviews__summary-label subheading">Calificación promedio</p>
            <p class="reviews__summary-count">Basado en {{ review_count }} reseña{% if review_count != 1 %}s{% endif %}</p>
          </div>

          <div class="reviews__summary-write">
            {%- render 'button', content: 'Escribir una reseña', style: 'outline', aria_controls: write_review_modal_id -%}
          </div>
        </div>

        {%- if review_blocks.size > 0 -%}
          <div class="reviews__controls">
            <div class="reviews__sort button">
              <label class="sr-only" for="reviews-sort-{{ section.id }}">Ordenar reseñas</label>
              <div class="button__content">
                <select id="reviews-sort-{{ section.id }}" class="select" data-reviews-sort>
                  <option value="rating_desc" selected>Mejor calificación</option>
                  <option value="recent">Más recientes</option>
                  <option value="rating_asc">Peor calificación</option>
                </select>
                {%- render 'icon' with 'chevron-down' -%}
              </div>
            </div>
          </div>

          <p class="reviews__count">{{ review_blocks.size }} reseña{% if review_blocks.size != 1 %}s{% endif %}</p>

          <div class="reviews__list" data-reviews-list>
            {%- for block in review_blocks -%}
              <div class="review-card" data-rating="{{ block.settings.rating }}" data-index="{{ forloop.index }}" {{ block.shopify_attributes }}>
                <div class="review-card__side">
                  <div class="review-card__reviewer">
                    <strong class="review-card__name">{{ block.settings.reviewer_name }}</strong>

                    {%- if block.settings.verified_buyer -%}
                      <span class="review-card__verified">
                        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false" class="review-card__verified-badge">
                          <circle cx="8" cy="8" r="8" fill="#3897F0"/>
                          <path d="M4.5 8.3 6.8 10.6 11.5 5.5" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        Comprador verificado
                      </span>
                    {%- endif -%}
                  </div>

                  {%- if block.settings.product_name != blank -%}
                    <div class="review-card__product">
                      <p class="review-card__product-label subheading">Producto</p>
                      {%- if block.settings.product_url != blank -%}
                        <a href="{{ block.settings.product_url }}" class="link">{{ block.settings.product_name }}</a>
                      {%- else -%}
                        <span>{{ block.settings.product_name }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  {%- liquid
                    assign has_attributes = false

                    for i in (1..3)
                      capture attr_label_key
                        echo 'attribute_'
                        echo i
                        echo '_label'
                      endcapture

                      if block.settings[attr_label_key] != blank
                        assign has_attributes = true
                      endif
                    endfor
                  -%}

                  {%- if has_attributes -%}
                    <div class="review-card__attributes">
                      {%- for i in (1..3) -%}
                        {%- liquid
                          capture attr_label_key
                            echo 'attribute_'
                            echo i
                            echo '_label'
                          endcapture

                          capture attr_value_key
                            echo 'attribute_'
                            echo i
                            echo '_value'
                          endcapture

                          assign attr_label = block.settings[attr_label_key]
                          assign attr_value = block.settings[attr_value_key]
                        -%}

                        {%- if attr_label != blank -%}
                          <div class="review-card__attribute">
                            <strong>{{ attr_label }}</strong>
                            <span>{{ attr_value }}</span>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>

                <div class="review-card__main">
                  <div class="review-card__top">
                    <span class="review-card__stars" role="img" aria-label="{{ 'general.rating.info' | t: rating_value: block.settings.rating, rating_max: 5 }}">
                      {%- for i in (1..5) -%}
                        {%- liquid
                          assign half_threshold = i | minus: 0.5

                          if block.settings.rating >= i
                            render 'icon' with 'star-rating'
                          elsif block.settings.rating >= half_threshold
                            render 'icon' with 'star-rating-half'
                          else
                            render 'icon' with 'star-rating-empty'
                          endif
                        -%}
                      {%- endfor -%}
                    </span>

                    {%- if block.settings.date_label != blank -%}
                      <span class="review-card__date">{{ block.settings.date_label }}</span>
                    {%- endif -%}
                  </div>

                  {%- if block.settings.title != blank -%}
                    <p class="review-card__title">{{ block.settings.title }}</p>
                  {%- endif -%}

                  {%- if block.settings.body != blank -%}
                    <div class="review-card__body">
                      {{- block.settings.body -}}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.bar_question != blank -%}
                    <div class="review-card__bar">
                      <p class="review-card__bar-question">{{ block.settings.bar_question }}</p>

                      <div class="review-card__bar-track">
                        <div class="review-card__bar-fill" style="width: {{ block.settings.bar_value | times: 1.0 | divided_by: 5 | times: 100 }}%;"></div>
                      </div>

                      <div class="review-card__bar-labels">
                        <span>{{ block.settings.bar_min_label }}</span>
                        <span>{{ block.settings.bar_max_label }}</span>
                      </div>
                    </div>
                  {%- endif -%}

                  <div class="review-card__helpful" data-reviews-helpful>
                    <span data-reviews-helpful-label>¿Te resultó útil?</span>
                    <button type="button" data-reviews-helpful-button="yes">Sí</button>
                    <button type="button" data-reviews-helpful-button="no">No</button>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if review_blocks.size > 3 -%}
          <div class="reviews__load-more">
            {%- render 'button', content: 'Ver más', type: 'button', style: 'outline', class: 'reviews__load-more-button' -%}
          </div>
        {%- endif -%}
      </div>
  </div>
</div>

{%- comment -%}
The form block has to run (and "form" become available) before the has_form_feedback check below, so its
output is captured here and echoed inside the modal afterwards - not evaluated directly inside the
<x-modal> tag, whose opening tag (with the "open" attribute) needs that same check to happen first.
{%- endcomment -%}
{%- capture review_form_content -%}
  {%- form 'contact', class: 'form' -%}
    {%- if form.posted_successfully? -%}
      {%- render 'banner', status: 'success', content: '¡Gracias! Tu reseña fue enviada y aparecerá aquí una vez aprobada.' -%}
    {%- endif -%}

    {%- if form.errors -%}
      {%- capture error_content -%}{{ form.errors.translated_fields[form.errors.first] | capitalize }} {{ form.errors.messages[form.errors.first] }}{%- endcapture -%}
      {%- render 'banner', status: 'error', content: error_content -%}
    {%- endif -%}

    <input type="hidden" name="contact[Submission type]" value="Review">

    <p class="review-form__required-note">* campos obligatorios</p>

    <fieldset class="review-form__rating">
      <legend class="review-form__rating-label">Valora tu experiencia <span aria-hidden="true">*</span></legend>
      <div class="review-form__star-picker">
        {%- for i in (5..1) -%}
          {%- capture rating_id -%}review-rating-{{ i }}-{{ section.id }}{%- endcapture -%}
          <input type="radio" name="contact[Rating]" id="{{ rating_id }}" value="{{ i }}" required>
          <label for="{{ rating_id }}">
            <span class="sr-only">{{ i }} estrella{% if i != 1 %}s{% endif %}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="26" height="26">
              <path d="M12 3.3l2.7 5.6 6.1.6-4.6 4.1 1.4 6-5.6-3.3-5.6 3.3 1.4-6-4.6-4.1 6.1-.6L12 3.3Z" stroke-width="1.4" stroke-linejoin="round"/>
            </svg>
          </label>
        {%- endfor -%}
      </div>
    </fieldset>

    <div class="fieldset">
      {%- render 'input', type: 'text', name: 'contact[Review title]', label: 'Agregar un título', show_label_as_block: true, placeholder: 'Resume tu experiencia', required: true -%}
      {%- render 'input', name: 'contact[body]', label: 'Escribe una reseña', show_label_as_block: true, placeholder: 'Cuéntanos qué te gusta o qué no te gusta.', multiline: 5, required: true -%}

      <div class="fieldset-row">
        {%- render 'input', type: 'text', name: 'contact[name]', label: 'Nombre', required: true, autocomplete: 'name' -%}
        {%- render 'input', type: 'email', name: 'contact[email]', label: 'Correo electrónico', required: true, autocomplete: 'email' -%}
      </div>
    </div>

    <div class="review-form__submit">
      {%- render 'button', content: 'Enviar', type: 'submit' -%}
    </div>
  {%- endform -%}
{%- endcapture -%}

{%- liquid
  assign has_form_feedback = false

  if form.posted_successfully? or form.errors
    assign has_form_feedback = true
  endif
-%}

<x-modal id="{{ write_review_modal_id }}" append-to-body {% if has_form_feedback %}open{% endif %} class="modal color-scheme color-scheme--{{ settings.default_color_scheme.id }}">
  <div class="prose">
    <p class="h5">comparte tus ideas</p>
  </div>

  {{- review_form_content -}}
</x-modal>

<style>
  {%- if section.settings.floating_reviews -%}
    {%- comment -%}
    Floating mode: this section behaves as its own padded card (like the floating info_panel it typically
    sits next to) instead of a plain page section, so .section-spacing's generic page-to-page rhythm is
    zeroed out and replaced with info_panel's own exact card padding formula - same
    min(2.5rem, var(--container-gutter)), same --container-gutter source, so the two line up when stacked.
    Left as the normal .section-spacing rhythm when not floating, since then this is just a regular
    full-width page section like any other.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .section-spacing {
      padding-block: 0;
    }

    #shopify-section-{{ section.id }} .reviews {
      padding: min(2.5rem, var(--container-gutter));
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .reviews__summary-row {
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .reviews__summary-write {
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .reviews__summary {
    text-align: start;
  }

  #shopify-section-{{ section.id }} .reviews__summary-rating {
    align-items: center;
    justify-content: start;
    column-gap: .75rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .reviews__summary-average {
    font-size: var(--text-h2);
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .reviews__stars,
  #shopify-section-{{ section.id }} .review-card__stars {
    gap: .125rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .reviews__summary-label {
    text-transform: uppercase;
    font-weight: 600;
    margin-block-start: .5rem;
  }

  #shopify-section-{{ section.id }} .reviews__summary-count {
    color: rgb(var(--text-color) / .6);
  }

  #shopify-section-{{ section.id }} .reviews__controls {
    justify-content: start;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    display: flex;
  }

  {%- comment -%}
  .reviews__sort keeps .button's height/padding/border-radius (still sized like every other button in the
  theme), but overrides color/background/border to read from the color scheme's own body text and border
  variables instead of the Buttons global style - transparent background, border and text following
  --border-color/--text-color, the same variables already used everywhere else in this section (eg. the
  divider lines, the muted counts), so it reacts correctly if the merchant changes the section's color
  scheme. The explicit :hover override below keeps .button's own hover background (a Buttons-scheme color)
  from re-applying a solid fill on top of this.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .reviews__sort {
    background: transparent;
    border-color: rgb(var(--border-color));
    color: rgb(var(--text-color));
  }

  #shopify-section-{{ section.id }} .reviews__sort:hover {
    background: transparent;
  }

  {%- comment -%}
  position: relative here (not on .select) is the actual fix: .select ~ svg's own position: absolute
  (theme.css) was resolving against .reviews__sort - the outer button, which has position: relative from
  the base .button class - using theme.css's default inset-inline-end formula (meant for a plain input).
  But .select only fills .button__content's own content box (100% width, inset from .reviews__sort's edge
  by .button__content's own horizontal padding), so the icon landed outside .select's actual clickable
  box: visually near the button, but a click there missed the select entirely. Making .button__content the
  positioned ancestor and pinning the icon's inset-inline-end to 0 (its own padding edge) aligns the icon
  exactly with .select's real right edge instead.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .reviews__sort .button__content {
    position: relative;
    column-gap: .5rem;
  }

  #shopify-section-{{ section.id }} .reviews__sort .select ~ svg {
    inset-inline-end: 0;
  }

  {%- comment -%}
  The .select itself stays the real clickable/focusable control (native <select>, full width of
  .button__content) with its own text hidden behind transparent styling - the chevron icon is layered on
  top of it via .select ~ svg's own existing position: absolute + pointer-events: none (theme.css), which
  is what lets a click anywhere on the icon fall through to the select underneath.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .reviews__sort .select {
    width: 100%;
    height: auto;
    border: none;
    padding: 0;
    padding-inline-end: 1.25rem;
    background: none;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .reviews__count {
    color: rgb(var(--text-color) / .6);
    border-block-end: 1px solid rgb(var(--border-color));
    padding-block-end: 1.5rem;
  }

  #shopify-section-{{ section.id }} .reviews__list {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .review-card {
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 2rem;
    padding-block: 2rem;
    border-block-end: 1px solid rgb(var(--border-color));
    transition: opacity .35s ease, transform .35s ease;
    display: grid;
  }

  #shopify-section-{{ section.id }} .review-card:last-child {
    border-block-end: none;
  }

  #shopify-section-{{ section.id }} .review-card--revealing {
    opacity: 0;
    transform: translateY(16px);
  }

  #shopify-section-{{ section.id }} .review-card__side {
    flex-direction: column;
    gap: 1.25rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__reviewer {
    flex-direction: column;
    gap: .375rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__verified {
    color: rgb(var(--text-color) / .6);
    font-size: .875em;
    align-items: center;
    column-gap: .3em;
    display: inline-flex;
  }

  #shopify-section-{{ section.id }} .review-card__verified svg {
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .review-card__product-label {
    text-transform: uppercase;
    font-weight: 600;
    margin-block-end: .25rem;
  }

  #shopify-section-{{ section.id }} .review-card__attributes {
    flex-direction: column;
    gap: .75rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__attribute {
    flex-direction: column;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__attribute span {
    color: rgb(var(--text-color) / .8);
  }

  #shopify-section-{{ section.id }} .review-card__main {
    flex-direction: column;
    gap: 1rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__top {
    justify-content: space-between;
    align-items: center;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__date {
    color: rgb(var(--text-color) / .6);
    font-size: .875em;
  }

  #shopify-section-{{ section.id }} .review-card__title {
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .review-card__bar {
    max-width: 22rem;
  }

  #shopify-section-{{ section.id }} .review-card__bar-question {
    font-weight: 600;
    margin-block-end: .75rem;
  }

  {%- comment -%}
  Own style, controlled entirely by this section's "Rating bar" settings above - not the theme's global
  "Progress bar" design (that one stays reserved for the free shipping bar/inventory bar/etc.). Border is
  fixed at 1px regardless of the configured height; only --bar-height and --bar-indicator-size come from
  settings, so the outline and the marker both read from the merchant's own review-bar config.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .review-card__bar-track {
    --bar-height: {{ section.settings.review_bar_height }}px;
    --bar-indicator-size: {{ section.settings.review_bar_indicator_size }}px;
    height: var(--bar-height);
    border: 1px solid {% if section.settings.review_bar_border_color != blank %}rgb({{ section.settings.review_bar_border_color.rgb }}){% else %}rgb(var(--border-color)){% endif %};
    border-radius: var(--rounded-full);
    background: {% if section.settings.review_bar_background_color != blank %}rgb({{ section.settings.review_bar_background_color.rgb }}){% else %}transparent{% endif %};
    position: relative;
  }

  #shopify-section-{{ section.id }} .review-card__bar-fill {
    height: 100%;
    background: none;
    position: relative;
  }

  {%- comment -%}
  Positioned against .review-card__bar-fill (not .review-card__bar-track), so the marker sits at the fill's
  own right edge - which is where the width: {percent}% inline style above already places it - instead of
  always sitting at the track's fixed right edge regardless of rating.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .review-card__bar-fill::after {
    content: "";
    width: var(--bar-indicator-size);
    height: var(--bar-indicator-size);
    border-radius: 50%;
    background: {% if section.settings.review_bar_border_color != blank %}rgb({{ section.settings.review_bar_border_color.rgb }}){% else %}rgb(var(--text-color)){% endif %};
    position: absolute;
    inset-inline-end: calc(var(--bar-indicator-size) / -2);
    inset-block-start: 50%;
    transform: translateY(-50%);
  }

  #shopify-section-{{ section.id }} .review-card__bar-labels {
    justify-content: space-between;
    color: rgb(var(--text-color) / .6);
    font-size: .875em;
    margin-block-start: .5rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__helpful {
    align-items: center;
    gap: .75rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .review-card__helpful button {
    padding: .25rem .75rem;
    border: 1px solid rgb(var(--border-color));
    border-radius: var(--rounded-full);
    background: none;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .review-card__helpful button[aria-pressed="true"] {
    background: rgb(var(--text-color) / .08);
  }

  #shopify-section-{{ section.id }} .reviews__load-more {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .review-card[hidden] {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .review-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    #shopify-section-{{ section.id }} .review-card__main {
      order: 1;
    }

    #shopify-section-{{ section.id }} .review-card__side {
      order: 2;
    }
  }

  #shopify-section-{{ section.id }} .review-form__required-note {
    color: rgb(var(--text-color) / .6);
    font-size: .875em;
    margin-block-end: 1.5rem;
  }

  #shopify-section-{{ section.id }} .review-form__rating {
    border: 0;
    padding: 0;
    margin: 0 0 1.5rem;
  }

  #shopify-section-{{ section.id }} .review-form__rating-label {
    font-weight: 600;
    display: block;
    margin-block-end: .75rem;
  }

  {%- comment -%}
  Standard CSS-only star picker: radio+label pairs in descending (5..1) DOM order inside a dir: rtl
  container, so they still display ascending left-to-right while ~ (general sibling, "comes after in the
  DOM") ends up matching the hovered/checked star and every star visually to its left. Each radio is
  visually hidden (not display: none, so it stays focusable) and its own label carries the visible star.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .review-form__star-picker {
    direction: rtl;
    display: inline-flex;
  }

  #shopify-section-{{ section.id }} .review-form__star-picker input {
    width: 1px;
    height: 1px;
    opacity: 0;
    position: absolute;
  }

  #shopify-section-{{ section.id }} .review-form__star-picker label {
    padding: 0 .15rem;
    cursor: pointer;
    display: inline-flex;
  }

  #shopify-section-{{ section.id }} .review-form__star-picker label svg {
    fill: none;
    stroke: rgb(var(--text-color) / .4);
    transition: fill .15s ease, stroke .15s ease;
  }

  #shopify-section-{{ section.id }} .review-form__star-picker input:checked ~ label svg,
  #shopify-section-{{ section.id }} .review-form__star-picker label:hover svg,
  #shopify-section-{{ section.id }} .review-form__star-picker label:hover ~ label svg {
    fill: rgb(var(--text-color));
    stroke: rgb(var(--text-color));
  }

  #shopify-section-{{ section.id }} .review-form__star-picker input:focus-visible + label svg {
    outline: 2px solid rgb(var(--text-color));
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .review-form__submit {
    text-align: end;
  }
</style>

<script>
  (function () {
    var root = document.getElementById('reviews-{{ section.id }}');
    if (!root) return;

    var list = root.querySelector('[data-reviews-list]');
    var cards = list ? Array.prototype.slice.call(list.querySelectorAll('.review-card')) : [];
    var sortSelect = root.querySelector('[data-reviews-sort]');
    var loadMoreButton = root.querySelector('.reviews__load-more-button');
    var initialCount = 3;
    var pageSize = 5;
    var visibleCount = initialCount;

    {%- comment -%}
    Fades + slides in only the cards a "Ver más" click actually newly reveals (not the initial batch, not a
    sort change - those would look odd re-animating on every interaction). The card is unhidden first, then
    the "revealing" class (opacity/translateY starting state) is added and forced to reflow before removing
    it next frame, so the browser has a real starting frame to transition away from instead of jumping.
    {%- endcomment -%}
    function revealCard(card) {
      card.hidden = false;
      card.classList.add('review-card--revealing');
      void card.offsetWidth;
      requestAnimationFrame(function () {
        card.classList.remove('review-card--revealing');
      });
    }

    {%- comment -%}
    Re-queries the list on every call instead of reusing the "cards" array above, so it always reflects
    whatever order sorting last put the cards in - "cards" itself is never reassigned, only the live DOM
    order is (via appendChild in applySort below).
    {%- endcomment -%}
    function updateVisibility(animateReveal) {
      var currentCards = list ? Array.prototype.slice.call(list.querySelectorAll('.review-card')) : [];

      currentCards.forEach(function (card, index) {
        var shouldBeVisible = index < visibleCount;

        if (shouldBeVisible && card.hidden) {
          if (animateReveal) {
            revealCard(card);
          } else {
            card.hidden = false;
          }
        } else if (!shouldBeVisible) {
          card.hidden = true;
          card.classList.remove('review-card--revealing');
        }
      });

      if (loadMoreButton) {
        loadMoreButton.hidden = visibleCount >= currentCards.length;
      }
    }

    {%- comment -%}
    Shared by the "change" listener below and the initial call further down, so the page-load order (best
    rating first, by default) is produced by the exact same logic a manual sort change uses - not a
    separate one-off sort.
    {%- endcomment -%}
    function applySort(value, resetVisibleCount) {
      var sortedCards = cards.slice();

      if (value === 'rating_desc') {
        sortedCards.sort(function (a, b) { return b.getAttribute('data-rating') - a.getAttribute('data-rating'); });
      } else if (value === 'rating_asc') {
        sortedCards.sort(function (a, b) { return a.getAttribute('data-rating') - b.getAttribute('data-rating'); });
      } else {
        sortedCards.sort(function (a, b) { return a.getAttribute('data-index') - b.getAttribute('data-index'); });
      }

      sortedCards.forEach(function (card) { list.appendChild(card); });

      if (resetVisibleCount) {
        // Sorting re-applies before the reveal count, same as a fresh page load: back to the first 3 of
        // the newly sorted order, not whatever count "Ver más" had already reached.
        visibleCount = initialCount;
      }

      updateVisibility();
    }

    if (loadMoreButton) {
      loadMoreButton.addEventListener('click', function () {
        var totalCards = list ? list.querySelectorAll('.review-card').length : 0;
        visibleCount = Math.min(visibleCount + pageSize, totalCards);
        updateVisibility(true);
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        applySort(sortSelect.value, true);
      });
    }

    // Best-rated first on load, same as selecting "Mejor calificación" manually - reuses applySort instead
    // of relying on the cards' own render order matching the select's default value.
    applySort(sortSelect ? sortSelect.value : 'rating_desc', false);

    root.querySelectorAll('[data-reviews-helpful]').forEach(function (group) {
      var label = group.querySelector('[data-reviews-helpful-label]');
      var buttons = Array.prototype.slice.call(group.querySelectorAll('[data-reviews-helpful-button]'));

      buttons.forEach(function (button) {
        button.addEventListener('click', function () {
          buttons.forEach(function (otherButton) { otherButton.setAttribute('aria-pressed', 'false'); });
          button.setAttribute('aria-pressed', 'true');
          if (label) label.textContent = '¡Gracias por tu opinión!';
        });
      });
    });
  })();
</script>

