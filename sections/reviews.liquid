{%- render 'review-avatar-script' -%}

<script>
  (function () {
    {%- comment -%}Each reviewer gets their round picture and their @handle (shared with the Instagram Feed's zoom view, so it is the same one in both){%- endcomment -%}
    Array.prototype.forEach.call(document.querySelectorAll('#shopify-section-{{ section.id }} [data-review-avatar]'), function (placeholder) {
      placeholder.appendChild(window.buildReviewAvatar(placeholder.getAttribute('data-review-avatar') || ''));
    });

    Array.prototype.forEach.call(document.querySelectorAll('#shopify-section-{{ section.id }} [data-review-handle]'), function (placeholder) {
      placeholder.textContent = window.buildReviewHandle(placeholder.getAttribute('data-review-handle') || '');
    });

    var compose = document.querySelector('#shopify-section-{{ section.id }} [data-reviews-compose]');

    if (compose) {
      var composeInput = compose.querySelector('.reviews__compose-input');
      var composeSend = compose.querySelector('.reviews__compose-send');

      composeInput.addEventListener('input', function () {
        composeSend.hidden = !composeInput.value.trim();
      });

      compose.addEventListener('submit', function (event) {
        event.preventDefault();

        var text = composeInput.value.trim();
        var writeButton = document.querySelector('#shopify-section-{{ section.id }} .reviews__write-button');

        if (!text || !writeButton) {
          return;
        }

        composeInput.blur();
        writeButton.click();

        setTimeout(function () {
          var body = document.querySelector('x-modal.modal--write-review textarea[name="contact[body]"]');

          if (body) {
            body.value = text;
            body.dispatchEvent(new Event('input', { bubbles: true }));
          }
        }, 120);

        composeInput.value = '';
        composeSend.hidden = true;
      });
    }

    {%- comment -%}
    Heart under each review: it starts with a number of its own - picked from the review's id, so every review (any new one too) gets one
    without anybody typing it, mostly small and sometimes bigger, and always the same for the same review - and the visitor's own heart adds one.
    What the visitor liked is remembered in this browser only.
    {%- endcomment -%}
    function startingLikes(id) {
      var seed = 5;

      for (var index = 0; index < id.length; index += 1) {
        seed = (seed * 31 + id.charCodeAt(index)) % 100003;
      }

      var unit = (seed % 1000) / 1000;

      return 2 + Math.floor(unit * unit * 58);
    }

    var likedReviews = {};

    try {
      likedReviews = JSON.parse(window.localStorage.getItem('reviews-liked') || '{}') || {};
    } catch (error) {
      likedReviews = {};
    }

    Array.prototype.forEach.call(document.querySelectorAll('#shopify-section-{{ section.id }} .review-card'), function (card) {
      var button = card.querySelector('[data-review-like]');
      var count = card.querySelector('.review-card__like-count');
      var id = card.getAttribute('data-review-id');

      if (!button || !id) {
        return;
      }

      var base = startingLikes(id);

      function paint(liked) {
        button.setAttribute('aria-pressed', liked ? 'true' : 'false');
        count.textContent = String(base + (liked ? 1 : 0));
      }

      paint(!!likedReviews[id]);

      button.addEventListener('click', function () {
        var liked = button.getAttribute('aria-pressed') !== 'true';

        paint(liked);

        if (liked) {
          likedReviews[id] = 1;
        } else {
          delete likedReviews[id];
        }

        try {
          window.localStorage.setItem('reviews-liked', JSON.stringify(likedReviews));
        } catch (error) {}
      });
    });
  })();
</script>

<script>
  (function () {
    var root = document.getElementById('reviews-{{ section.id }}');
    if (!root) return;

    var list = root.querySelector('[data-reviews-list]');
    var cards = list ? Array.prototype.slice.call(list.querySelectorAll('.review-card')) : [];
    var sortSelect = root.querySelector('[data-reviews-sort]');
    var loadMoreButton = root.querySelector('.reviews__load-more-button');
    var loadLessButton = root.querySelector('.reviews__load-less-button');
    var initialCount = 1;
    var pageSize = 1;
    var visibleCount = initialCount;
    var previousVisibleCount = initialCount;

    {%- comment -%}
    "Ver más" / "Ver menos" unfold the list instead of popping the cards in or out (same top-to-bottom reveal as
    the menu drawer): the list's height is animated between its old and new size while it clips its content, so
    the new cards are uncovered from top to bottom. Opening applies the change first and animates up to the new
    height; closing keeps the cards visible while the height shrinks and only then applies the change (otherwise
    they would vanish before the list started folding). Sorting does not animate. Reduced motion skips it.
    {%- endcomment -%}
    var isAnimating = false;
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    {%- comment -%}
    Same feel as the reviews panel in the zoom view of the Instagram Feed: the box opens and closes quickly with a soft curve that slows down at
    the end, and the reviews that appear come in one after the other, rising a little while they fade in.
    {%- endcomment -%}
    function revealCards(fromIndex) {
      if (reduceMotion.matches) {
        return;
      }

      var shown = Array.prototype.slice.call(list.querySelectorAll('.review-card:not([hidden])')).slice(fromIndex);

      shown.forEach(function (card, position) {
        card.animate(
          [{ opacity: 0, transform: 'translateY(0.75rem)' }, { opacity: 1, transform: 'none' }],
          { duration: 450, delay: 120 + position * 60, easing: 'cubic-bezier(0.32, 0.72, 0, 1)', fill: 'backwards' }
        );
      });
    }

    function animateList(applyChange, opening) {
      var fromHeight = list.offsetHeight;
      var duration = opening ? 420 : 340;
      var easing = 'cubic-bezier(0.32, 0.72, 0, 1)';

      applyChange();
      var toHeight = list.offsetHeight;

      if (reduceMotion.matches || fromHeight === toHeight) {
        return;
      }

      if (!opening) {
        // Put the cards back for the duration of the fold; the change is re-applied when it finishes.
        visibleCount = previousVisibleCount;
        updateVisibility();
      }

      isAnimating = true;
      list.style.overflow = 'hidden';
      // Scroll anchoring would otherwise keep nudging the scroll position while the list's height changes
      // (the content below, footer included, would appear to drift out of sync with the fold).
      document.documentElement.style.overflowAnchor = 'none';

      list.animate({ height: [fromHeight + 'px', toHeight + 'px'] }, { duration: duration, easing: easing }).finished.then(function () {
        list.style.overflow = '';
        document.documentElement.style.overflowAnchor = '';
        isAnimating = false;

        if (!opening) {
          applyChange();
        }
      });
    }

    {%- comment -%}
    Re-queries the list on every call instead of reusing the "cards" array above, so it always reflects
    whatever order sorting last put the cards in - "cards" itself is never reassigned, only the live DOM
    order is (via appendChild in applySort below).
    {%- endcomment -%}
    function updateVisibility() {
      var currentCards = list ? Array.prototype.slice.call(list.querySelectorAll('.review-card')) : [];

      currentCards.forEach(function (card, index) {
        var shouldBeVisible = index < visibleCount;

        card.hidden = !shouldBeVisible;
      });

      if (loadMoreButton) {
        loadMoreButton.hidden = visibleCount >= currentCards.length;
      }

      {%- comment -%}
      "Ver menos" only makes sense once "Ver más" has actually expanded past the initial batch -
      hidden otherwise (including right after a sort reset, which also sets visibleCount back to
      initialCount).
      {%- endcomment -%}
      if (loadLessButton) {
        loadLessButton.hidden = visibleCount <= initialCount;
      }
    }

    {%- comment -%}
    Shared by the "change" listener below and the initial call further down, so the page-load order (best
    rating first, by default) is produced by the exact same logic a manual sort change uses - not a
    separate one-off sort.
    {%- endcomment -%}
    function applySort(value, resetVisibleCount) {
      var sortedCards = cards.slice();

      if (value === 'rating_desc') {
        sortedCards.sort(function (a, b) { return b.getAttribute('data-rating') - a.getAttribute('data-rating'); });
      } else if (value === 'rating_asc') {
        sortedCards.sort(function (a, b) { return a.getAttribute('data-rating') - b.getAttribute('data-rating'); });
      } else {
        // "Most recent": fewest days-ago first. data-days-ago comes from each card's computed,
        // auto-rotating review date (reviews.liquid) - sorting by the block's own position instead
        // would no longer match what each card's date actually says, since that date is no longer
        // tied to the merchant's block order the way a fixed, hand-entered date used to be.
        sortedCards.sort(function (a, b) { return a.getAttribute('data-days-ago') - b.getAttribute('data-days-ago'); });
      }

      sortedCards.forEach(function (card) { list.appendChild(card); });

      if (resetVisibleCount) {
        // Sorting re-applies before the reveal count, same as a fresh page load: back to the first
        // initialCount of the newly sorted order, not whatever count "Ver más" had already reached.
        visibleCount = initialCount;
      }

      updateVisibility();
    }

    if (loadMoreButton) {
      loadMoreButton.addEventListener('click', function () {
        if (isAnimating) return;

        var totalCards = list ? list.querySelectorAll('.review-card').length : 0;
        var alreadyShown = visibleCount;

        animateList(function () {
          visibleCount = Math.min(visibleCount + pageSize, totalCards);
          updateVisibility();
        }, true);

        revealCards(alreadyShown);
      });
    }

    if (loadLessButton) {
      loadLessButton.addEventListener('click', function () {
        if (isAnimating) return;

        previousVisibleCount = visibleCount;

        animateList(function () {
          visibleCount = initialCount;
          updateVisibility();
        }, false);
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        applySort(sortSelect.value, true);
      });
    }

    // Best-rated first on load, same as selecting "Mejor calificación" manually - reuses applySort instead
    // of relying on the cards' own render order matching the select's default value.
    applySort(sortSelect ? sortSelect.value : 'rating_desc', false);
  })();
</script>

