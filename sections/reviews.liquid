{%- doc -%}
Native reviews section with a minimalist / editorial layout.

Each review is a "Review" block the merchant adds, edits and reorders from the theme editor - nothing
is pulled from an external app, and the block schema (and therefore any existing review data) is left
untouched by the redesign; only the presentation changed.

Layout: a compact header (optional eyebrow + heading + intro), a small rating summary, then the
reviews. The first N reviews are visible ("Reseñas visibles al inicio", default 3) and a minimal
"Ver más reseñas" toggle softly reveals the rest (and turns into "Ver menos"). It is a progressive
enhancement: with JavaScript disabled every review is rendered and visible.

Stars are coloured only through the `--reviews-star-color` variable (from the "Star color" setting),
independently of the colour scheme's text colour. All motion is gated behind
`prefers-reduced-motion: no-preference`.
{%- enddoc -%}

{%- liquid
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign initial_count = section.settings.initial_count | default: 3
  assign header_align = section.settings.text_alignment | default: 'center'
  assign show_date = section.settings.show_date
  assign show_author = section.settings.show_author
  assign show_details = section.settings.show_extra_details

  # Rating summary: prefer the same product metafields the product card / product page already use
  # (product.metafields.custom.reviews_rating / reviews_count) so the number shown here matches the
  # rest of the store. Fall back to averaging the review blocks themselves when they are not set
  # (eg. a non-product page, or a product without them yet).
  if product and product.metafields.custom.reviews_rating.value != blank
    assign average_rating = product.metafields.custom.reviews_rating.value.rating | plus: 0 | round: 1
    assign review_count = product.metafields.custom.reviews_count.value | default: 0 | plus: 0
  else
    assign review_count = review_blocks.size
    assign rating_sum = 0

    for review_block in review_blocks
      assign rating_sum = rating_sum | plus: review_block.settings.rating
    endfor

    if review_count > 0
      assign average_rating = rating_sum | times: 1.0 | divided_by: review_count | round: 1
    else
      assign average_rating = 0
    endif
  endif

  assign star_color = section.settings.star_color
  if star_color == blank or star_color == 'rgba(0,0,0,0)'
    assign star_color = '#404040'
  endif

  assign write_review_modal_id = 'write-review-' | append: section.id
  assign summary_label = 'general.rating.info' | t: rating_value: average_rating, rating_max: 5
-%}

{%- capture reviews_content -%}
  <div id="reviews-{{ section.id }}" class="reviews section-stack max-w-md mx-auto" style="--reviews-star-color: {{ star_color }};">
    <div class="reviews__header{% if header_align == 'center' %} reviews__header--center{% endif %}">
      {%- if section.settings.subheading != blank -%}
        {%- render 'subheading', content: section.settings.subheading -%}
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        {%- render 'heading', content: section.settings.title, style: section.settings.title_tag, html_tag: 'h2', instant: true -%}
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <div class="reviews__intro">{{ section.settings.intro }}</div>
      {%- endif -%}

      {%- if review_count > 0 -%}
        <div class="reviews__summary">
          {%- render 'reviews-stars', rating: average_rating, label: summary_label -%}

          <p class="reviews__summary-meta">
            <span class="reviews__summary-score">{{ average_rating }}</span>
            <span aria-hidden="true">·</span>
            {{ review_count }} {% if review_count == 1 %}reseña{% else %}reseñas{% endif %}
          </p>
        </div>
      {%- endif -%}

      <div class="reviews__actions">
        <button type="button" class="reviews__write" aria-controls="{{ write_review_modal_id }}">Escribir una reseña</button>
      </div>
    </div>

    {%- if review_blocks.size > 0 -%}
      {%- if section.settings.show_sort and review_blocks.size > 1 -%}
        <div class="reviews__toolbar">
          <div class="reviews__sort">
            <label class="sr-only" for="reviews-sort-{{ section.id }}">Ordenar reseñas</label>
            <select id="reviews-sort-{{ section.id }}" data-reviews-sort>
              <option value="featured">Destacadas</option>
              <option value="rating_desc">Mejor calificación</option>
              <option value="rating_asc">Menor calificación</option>
            </select>
            <svg class="reviews__sort-caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true" focusable="false">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      {%- endif -%}

      <ol class="reviews__list" id="reviews-list-{{ section.id }}" data-reviews-list>
        {%- for block in review_blocks -%}
          {%- liquid
            assign is_extra = false
            if forloop.index > initial_count
              assign is_extra = true
            endif

            assign attr_line = ''
            for i in (1..3)
              assign attr_label_key = 'attribute_' | append: i | append: '_label'
              assign attr_value_key = 'attribute_' | append: i | append: '_value'
              assign attr_label = block.settings[attr_label_key]
              assign attr_value = block.settings[attr_value_key]

              if attr_label != blank
                if attr_value != blank
                  assign attr_pair = attr_label | append: ': ' | append: attr_value
                else
                  assign attr_pair = attr_label
                endif

                if attr_line == blank
                  assign attr_line = attr_pair
                else
                  assign attr_line = attr_line | append: '  ·  ' | append: attr_pair
                endif
              endif
            endfor

            assign review_label = 'general.rating.info' | t: rating_value: block.settings.rating, rating_max: 5

            assign has_product = false
            if show_details and block.settings.product_name != blank
              assign has_product = true
            endif

            assign show_footer = false
            if show_author and block.settings.reviewer_name != blank
              assign show_footer = true
            elsif block.settings.verified_buyer
              assign show_footer = true
            elsif has_product
              assign show_footer = true
            endif
          -%}

          <li class="review{% if is_extra %} review--extra{% endif %}" data-rating="{{ block.settings.rating }}" data-index="{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="review__inner">
              <div class="review__head">
                {%- render 'reviews-stars', rating: block.settings.rating, label: review_label -%}

                {%- if show_date and block.settings.date_label != blank -%}
                  <span class="review__date">{{ block.settings.date_label }}</span>
                {%- endif -%}
              </div>

              {%- if block.settings.title != blank -%}
                <p class="review__title">{{ block.settings.title }}</p>
              {%- endif -%}

              {%- if block.settings.body != blank -%}
                <div class="review__body">{{ block.settings.body }}</div>
              {%- endif -%}

              {%- if show_details -%}
                {%- if attr_line != blank -%}
                  <p class="review__attrs">{{ attr_line }}</p>
                {%- endif -%}

                {%- if block.settings.bar_question != blank -%}
                  <div class="review__bar">
                    <p class="review__bar-question">{{ block.settings.bar_question }}</p>

                    <div class="review__bar-track">
                      <div class="review__bar-fill" style="inline-size: {{ block.settings.bar_value | times: 1.0 | divided_by: 5 | times: 100 }}%;"></div>
                    </div>

                    {%- if block.settings.bar_min_label != blank or block.settings.bar_max_label != blank -%}
                      <div class="review__bar-labels">
                        <span>{{ block.settings.bar_min_label }}</span>
                        <span>{{ block.settings.bar_max_label }}</span>
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}

              {%- if show_footer -%}
                <p class="review__footer">
                  {%- if show_author and block.settings.reviewer_name != blank -%}
                    <span class="review__author">{{ block.settings.reviewer_name }}</span>
                  {%- endif -%}

                  {%- if block.settings.verified_buyer -%}
                    <span class="review__verified">{%- render 'icon' with 'success-checkmark' -%}Compra verificada</span>
                  {%- endif -%}

                  {%- if has_product -%}
                    {%- if block.settings.product_url != blank -%}
                      <a class="review__product link" href="{{ block.settings.product_url }}">{{ block.settings.product_name }}</a>
                    {%- else -%}
                      <span class="review__product">{{ block.settings.product_name }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>

      {%- if review_blocks.size > initial_count -%}
        <div class="reviews__more">
          <button type="button" class="reviews__more-toggle" data-reviews-toggle aria-expanded="false" aria-controls="reviews-list-{{ section.id }}" hidden>
            <span class="reviews__more-label">
              <span class="reviews__more-text reviews__more-text--more">Ver más reseñas</span>
              <span class="reviews__more-text reviews__more-text--less">Ver menos</span>
            </span>
            <span class="reviews__more-arrow reviews__more-arrow--more" aria-hidden="true">&rarr;</span>
            <span class="reviews__more-arrow reviews__more-arrow--less" aria-hidden="true">&uarr;</span>
          </button>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endcapture -%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_reviews %} section-floating section-floating--block{% endif %}"{% if section.settings.floating_reviews %} style="border-radius: {{ section.settings.reviews_border_radius }}px; overflow: hidden;"{% endif %}>
  <div class="section-spacing">
    {%- if section.settings.floating_reviews -%}
      {{ reviews_content }}
    {%- else -%}
      <div class="container">
        {{ reviews_content }}
      </div>
    {%- endif -%}
  </div>
</div>

{%- comment -%}
The form block has to run (and "form" become available) before the has_form_feedback check below, so its
output is captured here and echoed inside the modal afterwards - not evaluated directly inside the
<x-modal> tag, whose opening tag (with the "open" attribute) needs that same check to happen first.
{%- endcomment -%}
{%- capture review_form_content -%}
  {%- form 'contact', class: 'form' -%}
    {%- if form.posted_successfully? -%}
      {%- render 'banner', status: 'success', content: '¡Gracias! Tu reseña fue enviada y aparecerá aquí una vez aprobada.' -%}
    {%- endif -%}

    {%- if form.errors -%}
      {%- capture error_content -%}{{ form.errors.translated_fields[form.errors.first] | capitalize }} {{ form.errors.messages[form.errors.first] }}{%- endcapture -%}
      {%- render 'banner', status: 'error', content: error_content -%}
    {%- endif -%}

    <input type="hidden" name="contact[Submission type]" value="Review">

    <p class="review-form__required-note">* campos obligatorios</p>

    <fieldset class="review-form__rating">
      <legend class="review-form__rating-label">Valora tu experiencia <span aria-hidden="true">*</span></legend>
      <div class="review-form__star-picker">
        {%- for i in (5..1) -%}
          {%- capture rating_id -%}review-rating-{{ i }}-{{ section.id }}{%- endcapture -%}
          <input type="radio" name="contact[Rating]" id="{{ rating_id }}" value="{{ i }}" required>
          <label for="{{ rating_id }}">
            <span class="sr-only">{{ i }} estrella{% if i != 1 %}s{% endif %}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="26" height="26">
              <path d="M12 3.3l2.7 5.6 6.1.6-4.6 4.1 1.4 6-5.6-3.3-5.6 3.3 1.4-6-4.6-4.1 6.1-.6L12 3.3Z" stroke-width="1.4" stroke-linejoin="round"/>
            </svg>
          </label>
        {%- endfor -%}
      </div>
    </fieldset>

    <div class="fieldset">
      {%- render 'input', type: 'text', name: 'contact[Review title]', label: 'Agregar un título', show_label_as_block: true, placeholder: 'Resume tu experiencia', required: true -%}
      {%- render 'input', name: 'contact[body]', label: 'Escribe una reseña', show_label_as_block: true, placeholder: 'Cuéntanos qué te gusta o qué no te gusta.', multiline: 5, required: true -%}

      <div class="fieldset-row">
        {%- render 'input', type: 'text', name: 'contact[name]', label: 'Nombre', required: true, autocomplete: 'name' -%}
        {%- render 'input', type: 'email', name: 'contact[email]', label: 'Correo electrónico', required: true, autocomplete: 'email' -%}
      </div>
    </div>

    <div class="review-form__submit">
      {%- render 'button', content: 'Enviar', type: 'submit' -%}
    </div>
  {%- endform -%}
{%- endcapture -%}

{%- liquid
  assign has_form_feedback = false

  if form.posted_successfully? or form.errors
    assign has_form_feedback = true
  endif
-%}

<x-modal id="{{ write_review_modal_id }}" append-to-body {% if has_form_feedback %}open{% endif %} class="modal color-scheme color-scheme--{{ settings.default_color_scheme.id }}" style="--reviews-star-color: {{ star_color }};">
  <div class="prose">
    <p class="h5">comparte tus ideas</p>
  </div>

  {{- review_form_content -}}
</x-modal>

<style>
  {%- comment -%} Merchant-controlled values become CSS variables; everything else reads from the colour scheme. {%- endcomment -%}
  #shopify-section-{{ section.id }} .reviews {
    --reviews-divider: rgb(var(--text-color) / 0.14);
    --reviews-muted: rgb(var(--text-color) / 0.6);
    color: rgb(var(--text-color));
  }

  {%- if section.settings.floating_reviews -%}
    {%- comment -%}
    Floating mode: the section is its own padded card (like the floating panels it sits next to), so
    .section-spacing's page-to-page rhythm is removed and replaced with the card's own inner padding.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .section-spacing {
      padding-block: 0;
    }

    #shopify-section-{{ section.id }} .reviews {
      padding: min(2.5rem, var(--container-gutter));
    }

    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .reviews {
        padding: calc(var(--container-gutter) + 0.5rem);
      }
    }
  {%- endif -%}

  {%- comment -%} ---------- Section reveal on scroll (added by JS, motion-safe only) ---------- {%- endcomment -%}
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .reviews--reveal {
      opacity: 0;
      transform: translateY(14px);
    }

    #shopify-section-{{ section.id }} .reviews--reveal.is-visible {
      opacity: 1;
      transform: none;
      transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  {%- comment -%} ---------- Header ---------- {%- endcomment -%}
  #shopify-section-{{ section.id }} .reviews__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .reviews__header--center {
    align-items: center;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .reviews__intro {
    max-width: 34rem;
    color: var(--reviews-muted);
  }

  #shopify-section-{{ section.id }} .reviews__intro > :first-child { margin-block-start: 0; }
  #shopify-section-{{ section.id }} .reviews__intro > :last-child { margin-block-end: 0; }

  #shopify-section-{{ section.id }} .reviews__summary {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block-start: 0.25rem;
  }

  #shopify-section-{{ section.id }} .reviews__header--center .reviews__summary {
    align-items: center;
  }

  #shopify-section-{{ section.id }} .reviews__summary-meta {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.9375rem;
    color: var(--reviews-muted);
  }

  #shopify-section-{{ section.id }} .reviews__summary-score {
    font-weight: 600;
    color: rgb(var(--text-color));
  }

  #shopify-section-{{ section.id }} .reviews__actions {
    margin-block-start: 0.5rem;
  }

  #shopify-section-{{ section.id }} .reviews__write {
    margin: 0;
    padding: 0;
    border: 0;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .reviews__write:hover {
    opacity: 0.6;
  }

  #shopify-section-{{ section.id }} .reviews__write:focus-visible {
    outline: 2px solid var(--reviews-star-color);
    outline-offset: 4px;
  }

  {%- comment -%} ---------- Stars (colour comes only from --reviews-star-color) ---------- {%- endcomment -%}
  #shopify-section-{{ section.id }} .reviews-stars {
    display: inline-flex;
    gap: 2px;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .reviews-stars .icon {
    width: 13px;
    height: auto;
  }

  #shopify-section-{{ section.id }} .reviews__summary .reviews-stars .icon {
    width: 16px;
  }

  #shopify-section-{{ section.id }} .reviews-stars .icon-star-rating-empty {
    opacity: 0.32;
  }

  {%- comment -%} ---------- Toolbar / sort ---------- {%- endcomment -%}
  #shopify-section-{{ section.id }} .reviews__toolbar {
    display: flex;
    justify-content: flex-end;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--reviews-divider);
  }

  #shopify-section-{{ section.id }} .reviews__sort {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .reviews__sort select {
    appearance: none;
    -webkit-appearance: none;
    margin: 0;
    padding: 0.5rem 1.35rem 0.5rem 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    font: inherit;
    font-size: 0.875rem;
    color: inherit;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .reviews__sort select:focus-visible {
    outline: 2px solid var(--reviews-star-color);
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .reviews__sort-caret {
    position: absolute;
    inset-inline-end: 0;
    pointer-events: none;
    color: var(--reviews-muted);
  }

  {%- comment -%} ---------- Review ---------- {%- endcomment -%}
  #shopify-section-{{ section.id }} .reviews__list {
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: start;
  }

  #shopify-section-{{ section.id }} .review__inner {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-block: 2.25rem;
    border-block-start: 1px solid var(--reviews-divider);
  }

  #shopify-section-{{ section.id }} .reviews__list > .review:first-child .review__inner {
    border-block-start: 0;
    padding-block-start: 0.75rem;
  }

  #shopify-section-{{ section.id }} .review__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .review__date {
    flex-shrink: 0;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--reviews-muted);
  }

  #shopify-section-{{ section.id }} .review__title {
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .review__body {
    color: rgb(var(--text-color) / 0.82);
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .review__body > :first-child { margin-block-start: 0; }
  #shopify-section-{{ section.id }} .review__body > :last-child { margin-block-end: 0; }
  #shopify-section-{{ section.id }} .review__body > * + * { margin-block-start: 0.75rem; }

  #shopify-section-{{ section.id }} .review__attrs {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--reviews-muted);
  }

  #shopify-section-{{ section.id }} .review__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin-block-start: 0.25rem;
    font-size: 0.875rem;
  }

  #shopify-section-{{ section.id }} .review__author {
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .review__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--reviews-muted);
  }

  #shopify-section-{{ section.id }} .review__verified .icon {
    width: 12px;
    color: var(--reviews-star-color);
  }

  #shopify-section-{{ section.id }} .review__product {
    color: var(--reviews-muted);
  }

  {%- comment -%} ---------- Optional rating bar ---------- {%- endcomment -%}
  #shopify-section-{{ section.id }} .review__bar {
    max-width: 22rem;
    margin-block: 0.25rem;
  }

  #shopify-section-{{ section.id }} .review__bar-question {
    font-size: 0.9375rem;
    margin-block-end: 0.6rem;
    color: rgb(var(--text-color) / 0.75);
  }

  #shopify-section-{{ section.id }} .review__bar-track {
    --bar-height: {{ section.settings.review_bar_height }}px;
    --bar-indicator: {{ section.settings.review_bar_indicator_size }}px;
    --bar-color: {% if section.settings.review_bar_border_color != blank %}rgb({{ section.settings.review_bar_border_color.rgb }}){% else %}rgb(var(--text-color)){% endif %};
    position: relative;
    height: var(--bar-height);
    border-radius: var(--rounded-full);
    background: {% if section.settings.review_bar_background_color != blank %}rgb({{ section.settings.review_bar_background_color.rgb }}){% else %}rgb(var(--text-color) / 0.12){% endif %};
  }

  #shopify-section-{{ section.id }} .review__bar-fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    border-radius: inherit;
    background: var(--bar-color);
  }

  #shopify-section-{{ section.id }} .review__bar-fill::after {
    content: "";
    position: absolute;
    inset-inline-end: calc(var(--bar-indicator) / -2);
    inset-block-start: 50%;
    width: var(--bar-indicator);
    height: var(--bar-indicator);
    border-radius: 50%;
    background: var(--bar-color);
    transform: translateY(-50%);
  }

  #shopify-section-{{ section.id }} .review__bar-labels {
    display: flex;
    justify-content: space-between;
    margin-block-start: 0.5rem;
    font-size: 0.8125rem;
    color: var(--reviews-muted);
  }

  {%- comment -%} ---------- Collapsible extra reviews (progressive enhancement: styling only takes effect once JS sets data-collapsible) ---------- {%- endcomment -%}
  #shopify-section-{{ section.id }} .reviews[data-collapsible="true"] .review--extra {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
  }

  #shopify-section-{{ section.id }} .reviews[data-collapsible="true"] .review--extra > .review__inner {
    min-height: 0;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .reviews[data-collapsible="true"][data-expanded="true"] .review--extra {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .reviews[data-collapsible="true"] .review--extra {
      transform: translateY(-4px);
      transition: grid-template-rows 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease, transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), visibility 0s linear 0.5s;
    }

    #shopify-section-{{ section.id }} .reviews[data-collapsible="true"][data-expanded="true"] .review--extra {
      transform: none;
      transition: grid-template-rows 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.45s ease 0.05s, transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), visibility 0s;
    }
  }

  {%- comment -%} ---------- "Ver más" toggle ---------- {%- endcomment -%}
  #shopify-section-{{ section.id }} .reviews__more {
    display: flex;
    justify-content: center;
    padding-block-start: 0.5rem;
  }

  #shopify-section-{{ section.id }} .reviews__more-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .reviews__more-label {
    padding-block-end: 2px;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.3s ease;
  }

  #shopify-section-{{ section.id }} .reviews__more-arrow {
    display: none;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .reviews__more-toggle[aria-expanded="false"] .reviews__more-arrow--more,
  #shopify-section-{{ section.id }} .reviews__more-toggle[aria-expanded="true"] .reviews__more-arrow--less {
    display: inline-block;
  }

  #shopify-section-{{ section.id }} .reviews__more-text--less {
    display: none;
  }

  #shopify-section-{{ section.id }} .reviews__more-toggle[aria-expanded="true"] .reviews__more-text--more {
    display: none;
  }

  #shopify-section-{{ section.id }} .reviews__more-toggle[aria-expanded="true"] .reviews__more-text--less {
    display: inline;
  }

  #shopify-section-{{ section.id }} .reviews__more-toggle:focus-visible {
    outline: 2px solid var(--reviews-star-color);
    outline-offset: 4px;
    border-radius: 2px;
  }

  #shopify-section-{{ section.id }} .reviews__more-toggle:active {
    opacity: 0.7;
  }

  @media (pointer: fine) {
    #shopify-section-{{ section.id }} .reviews__more-toggle:hover .reviews__more-label {
      background-size: 100% 1px;
    }

    #shopify-section-{{ section.id }} .reviews__more-toggle:hover .reviews__more-arrow--more {
      transform: translateX(3px);
    }

    #shopify-section-{{ section.id }} .reviews__more-toggle:hover .reviews__more-arrow--less {
      transform: translateY(-3px);
    }
  }

  {%- comment -%}
  Write-a-review form. Scoped to the modal's own id, not #shopify-section-… : <x-modal append-to-body>
  moves the dialog to <body> while open, so a section-scoped selector would stop matching exactly when
  the form is visible. --reviews-star-color is re-declared on the modal element for the same reason.
  {%- endcomment -%}
  #{{ write_review_modal_id }} .review-form__required-note {
    color: rgb(var(--text-color) / 0.6);
    font-size: 0.875em;
    margin-block-end: 1.5rem;
  }

  #{{ write_review_modal_id }} .review-form__rating {
    border: 0;
    padding: 0;
    margin: 0 0 1.5rem;
  }

  #{{ write_review_modal_id }} .review-form__rating-label {
    font-weight: 600;
    display: block;
    margin-block-end: 0.75rem;
  }

  {%- comment -%}
  CSS-only star picker: radio+label pairs in descending (5..1) DOM order inside a dir: rtl container, so
  they display ascending left-to-right while ~ still matches the hovered/checked star and every star to
  its left. Each radio is visually hidden (not display:none) so it stays focusable.
  {%- endcomment -%}
  #{{ write_review_modal_id }} .review-form__star-picker {
    direction: rtl;
    display: inline-flex;
  }

  #{{ write_review_modal_id }} .review-form__star-picker input {
    width: 1px;
    height: 1px;
    opacity: 0;
    position: absolute;
  }

  #{{ write_review_modal_id }} .review-form__star-picker label {
    padding: 0 0.15rem;
    cursor: pointer;
    display: inline-flex;
  }

  #{{ write_review_modal_id }} .review-form__star-picker label svg {
    fill: none;
    stroke: rgb(var(--text-color) / 0.35);
    transition: fill 0.15s ease, stroke 0.15s ease;
  }

  #{{ write_review_modal_id }} .review-form__star-picker input:checked ~ label svg,
  #{{ write_review_modal_id }} .review-form__star-picker label:hover svg,
  #{{ write_review_modal_id }} .review-form__star-picker label:hover ~ label svg {
    fill: var(--reviews-star-color);
    stroke: var(--reviews-star-color);
  }

  #{{ write_review_modal_id }} .review-form__star-picker input:focus-visible + label svg {
    outline: 2px solid var(--reviews-star-color);
    outline-offset: 2px;
  }

  #{{ write_review_modal_id }} .review-form__submit {
    text-align: end;
  }
</style>

<script>
  (function () {
    var root = document.getElementById('reviews-{{ section.id }}');
    if (!root) return;

    var list = root.querySelector('[data-reviews-list]');
    var toggle = root.querySelector('[data-reviews-toggle]');
    var sortSelect = root.querySelector('[data-reviews-sort]');
    var initialCount = {{ initial_count }};
    var motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

    function cards() {
      return list ? Array.prototype.slice.call(list.querySelectorAll('.review')) : [];
    }

    var originalOrder = cards();
    var collapsible = !!list && originalOrder.length > initialCount;

    {%- comment -%} Re-flags which cards are "extra" from the live DOM order, so it stays correct after sorting. {%- endcomment -%}
    function markExtra() {
      cards().forEach(function (card, index) {
        card.classList.toggle('review--extra', index >= initialCount);
      });
    }

    function setExpanded(expanded) {
      root.setAttribute('data-expanded', expanded ? 'true' : 'false');
      if (toggle) toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    }

    function applySort(value) {
      if (!list) return;

      var sorted = originalOrder.slice();

      if (value === 'rating_desc') {
        sorted.sort(function (a, b) {
          return (b.dataset.rating - a.dataset.rating) || (a.dataset.index - b.dataset.index);
        });
      } else if (value === 'rating_asc') {
        sorted.sort(function (a, b) {
          return (a.dataset.rating - b.dataset.rating) || (a.dataset.index - b.dataset.index);
        });
      }
      // 'featured' keeps the merchant's block order (originalOrder).

      sorted.forEach(function (card) { list.appendChild(card); });

      if (collapsible) {
        markExtra();
        setExpanded(false);
      }
    }

    if (collapsible) {
      root.setAttribute('data-collapsible', 'true');
      markExtra();
      setExpanded(false);

      if (toggle) {
        toggle.hidden = false;
        toggle.addEventListener('click', function () {
          var willExpand = root.getAttribute('data-expanded') !== 'true';
          setExpanded(willExpand);

          if (!willExpand && list.getBoundingClientRect().top < 0) {
            list.scrollIntoView({ behavior: motionOK ? 'smooth' : 'auto', block: 'start' });
          }
        });
      }
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', function () { applySort(sortSelect.value); });
    }

    {%- comment -%} Theme editor: reveal a collapsed review when the merchant selects its block. {%- endcomment -%}
    document.addEventListener('shopify:block:select', function (event) {
      if (collapsible && root.contains(event.target)) setExpanded(true);
    });

    {%- comment -%} Soft one-time reveal of the whole section as it enters the viewport. {%- endcomment -%}
    if (motionOK && 'IntersectionObserver' in window) {
      root.classList.add('reviews--reveal');

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            root.classList.add('is-visible');
            observer.disconnect();
          }
        });
      }, { rootMargin: '0px 0px -10% 0px' });

      observer.observe(root);

      // Safety net: if the observer never fires (edge layouts), show the section anyway.
      setTimeout(function () { root.classList.add('is-visible'); }, 1200);
    }
  })();
</script>

