{%- if section.blocks.size > 0 -%}
  {%- comment -%}
  "Tabs with media" takes the full width of the section: when the section has one, only that block is shown (the others are skipped and
  the theme editor shows a notice) and the section uses its own two-column grid instead of the "Items per row" one.
  {%- endcomment -%}
  {%- liquid
    assign tabs_block = section.blocks | where: 'type', 'tabs_with_media' | first
    assign media_blocks_cells = section.blocks.size
    if tabs_block
      assign media_blocks_cells = 2
    endif
  -%}

  <style>
    #shopify-section-{{ section.id }} {
      --media-blocks-grid: {% if section.settings.stack_on_mobile %}auto-flow / minmax(0, 1fr){% else %}auto / auto-flow 78vw{% endif %};
      {%- comment -%}
        When column_spacing is 'none' the gap is forced to 0px even if add_border is enabled.
        The original 1px gap for add_border was meant to reveal a hairline between cards, but it
        breaks the "single continuous piece" look required when there is no spacing between cards
        (it also creates a 1px seam that clashes with the shared outer corner radius). The bordered
        look (.media-blocks__item--bordered) still renders its own border on top of each card, so
        visually nothing is lost by removing the extra 1px gap.
      {%- endcomment -%}
      --media-blocks-gap: {% if section.settings.column_spacing == 'none' %}0px{% elsif section.settings.column_spacing == 'sm' %}calc(var(--container-gutter) / 2){% elsif section.settings.column_spacing == 'md' %}var(--container-gutter){% elsif section.settings.column_spacing == 'lg' %}calc(var(--container-gutter) * 1.5){% endif %};
    }

    {%- comment -%}
    Gap between the blocks, horizontal and vertical (stacked rows) alike: the shared --horizontal-gap (css-variables.liquid), whatever
    Small / Medium / Large is picked - only "none" (blocks touching) keeps 0.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .media-blocks {
      column-gap: {% if section.settings.column_spacing == 'none' %}0px{% else %}var(--horizontal-gap){% endif %};
      row-gap: {% if section.settings.column_spacing == 'none' %}0px{% else %}var(--horizontal-gap){% endif %};
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --media-blocks-grid: {% if section.settings.stack_on_mobile or media_blocks_cells <= 2 %}auto / repeat(2, minmax(0, 1fr)){% else %}auto / auto-flow 45vw{% endif %};
      }
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} {
        --media-blocks-grid: auto-flow / repeat({{ section.settings.items_per_row }}, minmax(0, 1fr));
      }
    }

    @media screen and (pointer: fine) {
      {%- for block in section.blocks -%}
        {%- if block.settings.change_color_scheme_on_hover -%}
          {%- comment -%}
          Some colors are not used in this context, so we only output the necessary variables
          {%- endcomment -%}

          {%- assign color_scheme = block.settings.color_scheme -%}

          #block-{{ block.id }} {
            transition: all 0.2s ease-in-out;
          }

          #block-{{ block.id }} .content-box__background-media {
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
          }

          #block-{{ block.id }} .link {
            transition: color 0s ease-in-out,  background-size 0.3s ease-in-out;
          }

          {%- if block.settings.image != blank -%}
            #block-{{ block.id }}:hover {
              {%- comment -%}
              On hover, this forces to re-use the same background as the initial color scheme, which avoids a flash of the destination background
              {%- endcomment -%}
              --background: {% if color_scheme.settings.background == 'rgba(0,0,0,0)' %}0 0 0 / 0{% else %}{{ color_scheme.settings.background.rgb }}{% endif %};
            }
          {%- endif -%}

          #block-{{ block.id }}:not(:hover) {
            --accent: {{ color_scheme.settings.primary_button_background.rgb }};
            --background: {% if color_scheme.settings.background == 'rgba(0,0,0,0)' %}0 0 0 / 0{% else %}{{ color_scheme.settings.background.rgb }}{% endif %};
            --background-gradient: {{ color_scheme.settings.background_gradient }};
            --text-color: {{ color_scheme.settings.text_color.rgb }};
            --border-color: {{ color_scheme.settings.text_color.rgb }} / 0.1;
            --heading-highlight-accent-color: {{ color_scheme.settings.heading_highlight_accent_color.rgb }};
            --heading-highlight-text-color: {{ color_scheme.settings.heading_highlight_text_color.rgb }};
            --button-background-primary: {{ color_scheme.settings.primary_button_background.rgb }};
            --button-text-primary: {{ color_scheme.settings.primary_button_text_color.rgb }};

            {%- liquid
              assign subheading_has_border = true
              assign subheading_has_background = true
      
              if color_scheme.settings.subheading_background == blank or color_scheme.settings.subheading_background == 'rgba(0,0,0,0)' or color_scheme.settings.subheading_background == color_scheme.settings.background
                assign subheading_has_background = false
              endif
      
              if color_scheme.settings.subheading_border_color == blank or color_scheme.settings.subheading_border_color == 'rgba(0,0,0,0)'
                assign subheading_has_border = false
              endif
            -%}
      
            --subheading-background: {% if subheading_has_background %}{{ color_scheme.settings.subheading_background.rgb }}{% else %}0 0 0 / 0.0{% endif %};
            --subheading-border: {% if subheading_has_border %}1px solid rgb({{ color_scheme.settings.subheading_border_color.rgb }}){% else %}none{% endif %};
            --subheading-text-color: {{ color_scheme.settings.subheading_text_color.rgb }};
            --subheading-has-padding: {% if subheading_has_border or subheading_has_background %}1{% else %}0{% endif %};
          }

          #block-{{ block.id }}:hover .content-box__background-media {
            opacity: 1;
          }
        {%- endif -%}
      {%- endfor -%}
    }

    /* ---------------------------------------------------------------------
       Corner radius (outer corners only)
       ------------------------------------------------------------------- */
    #shopify-section-{{ section.id }} {
      {%- comment -%}
        Auto mode scales the radius with the viewport but the floor is relative to the merchant's
        chosen corner_radius (50% of it) instead of a fixed px value. A fixed low floor (e.g. 4px)
        made the radius collapse hard on mobile viewports (1.2vw is only ~4-5px around 375-430px)
        while desktop viewports almost always hit the max, making the two look inconsistent.
      {%- endcomment -%}
      --media-blocks-corner-radius: {% if section.settings.auto_corner_radius %}clamp({{ section.settings.corner_radius | times: 0.5 | round }}px, 3vw, {{ section.settings.corner_radius }}px){% else %}{{ section.settings.corner_radius }}px{% endif %};
    }

    #shopify-section-{{ section.id }} .media-blocks__item {
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .media-blocks__item .content-box,
    #shopify-section-{{ section.id }} .media-blocks__item .content-box__background-media {
      border-radius: inherit;
      overflow: hidden;
    }

    {%- comment -%}
    .content-box (theme.css) is the shared "media card" padding system - its --content-box-spacing
    normally shrinks at narrow container widths (own @container rules) instead of staying fixed. The
    "Image/video with text" blocks render their heading/text inside one of these (content-box.liquid
    class="content-box h-full min-h-* md:min-h-*"), so without this override their text padding would
    follow that shrinking system instead of the same faq.liquid-style formula used everywhere else in
    this section. Scoped to this section only - .content-box itself is shared with many other
    sections (hero banners, testimonials, etc.) that must keep the original system untouched. Specificity
    (id + class) beats the unscoped @container overrides regardless of container width, matching the
    "same value at every breakpoint" criterion the rest of this section's padding already follows.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .content-box {
      --content-box-spacing: calc(var(--container-gutter) + 0.5rem);
    }

    {%- comment -%}
    Desktop size "Auto" fix: theme.css has no md:min-h-auto class, so with Desktop "Auto" and a Mobile size other than "Auto" the card kept the
    mobile height on desktop, and the image was taken out of the flow (absolute) as if a fixed height was set. On desktop, "Auto" now means
    the same as on mobile: no minimum height, the image keeps its own proportions and gives the card its height.
    {%- endcomment -%}
    {%- if section.settings.block_size == 'auto' -%}
      @media screen and (min-width: 1000px) {
        #shopify-section-{{ section.id }} .media-blocks__item .content-box.content-box {
          min-height: auto;
        }

        #shopify-section-{{ section.id }} .media-blocks__item .content-box.content-box .content-box__background-media {
          position: static;
          inset: auto;
        }
      }
    {%- endif -%}

    {%- comment -%}
    Cards that do not stack on mobile scroll sideways: snap each card to the start so a swipe never stops half way between two cards.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .media-blocks.scroll-area {
      scroll-snap-type: x mandatory;
    }

    #shopify-section-{{ section.id }} .media-blocks.scroll-area > * {
      scroll-snap-align: start;
    }

    {%- if tabs_block and section.settings.column_spacing == 'none' -%}
      {%- comment -%}Tabs with media, no spacing: the two cards read as one piece, so only the outer corners are rounded{%- endcomment -%}
      @media screen and (max-width: 699px) {
        #shopify-section-{{ section.id }} .media-tabs-media {
          {%- if tabs_block.settings.mobile_image_position == 'top' -%}
            border-radius: var(--media-blocks-corner-radius) var(--media-blocks-corner-radius) 0 0;
          {%- else -%}
            border-radius: 0 0 var(--media-blocks-corner-radius) var(--media-blocks-corner-radius);
          {%- endif -%}
        }

        #shopify-section-{{ section.id }} .media-tabs {
          {%- if tabs_block.settings.mobile_image_position == 'top' -%}
            border-radius: 0 0 var(--media-blocks-corner-radius) var(--media-blocks-corner-radius);
          {%- else -%}
            border-radius: var(--media-blocks-corner-radius) var(--media-blocks-corner-radius) 0 0;
          {%- endif -%}
        }
      }

      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .media-blocks > :first-child {
          border-radius: var(--media-blocks-corner-radius) 0 0 var(--media-blocks-corner-radius);
        }

        #shopify-section-{{ section.id }} .media-blocks > :last-child {
          border-radius: 0 var(--media-blocks-corner-radius) var(--media-blocks-corner-radius) 0;
        }
      }
    {%- elsif section.settings.column_spacing == 'none' -%}
      {%- comment -%}
        No spacing between cards: they form a single continuous piece, so the radius only applies to the outer corners of the whole set,
        never on the touching inner edges between cards. How the cards are laid out depends on the breakpoint (see --media-blocks-grid
        above), so the corners are worked out for each one: snippets/media-blocks-outer-corners.liquid knows the row and column of
        every card, so it also works with several rows.
      {%- endcomment -%}
      {%- assign section_selector = '#shopify-section-' | append: section.id -%}
      {%- assign blocks_count = media_blocks_cells -%}

      {%- comment -%}Tablet (700-999px): two columns when the cards stack on mobile or there are two or fewer, otherwise one horizontal scroller (one row){%- endcomment -%}
      {%- assign tablet_cols = blocks_count -%}
      {%- if section.settings.stack_on_mobile or blocks_count <= 2 -%}
        {%- assign tablet_cols = 2 -%}
      {%- endif -%}

      {%- comment -%}Mobile: one column when stacked, otherwise a horizontal scroller (one row){%- endcomment -%}
      {%- assign mobile_cols = blocks_count -%}
      {%- if section.settings.stack_on_mobile -%}
        {%- assign mobile_cols = 1 -%}
      {%- endif -%}

      @media screen and (max-width: 699px) {
        {%- render 'media-blocks-outer-corners', selector: section_selector, count: blocks_count, cols: mobile_cols -%}
      }

      @media screen and (min-width: 700px) and (max-width: 999px) {
        {%- render 'media-blocks-outer-corners', selector: section_selector, count: blocks_count, cols: tablet_cols -%}
      }

      @media screen and (min-width: 1000px) {
        {%- render 'media-blocks-outer-corners', selector: section_selector, count: blocks_count, cols: section.settings.items_per_row -%}
      }
    {%- else -%}
      {%- comment -%}
        Any spacing (sm/md/lg) leaves a visible gap between cards, so each card reads as its
        own independent piece and gets the radius on all four of its corners.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .media-blocks__item {
        border-radius: var(--media-blocks-corner-radius);
      }
    {%- endif -%}

    {%- comment -%}
      "Two images with text" block: two cards one over the other, the section's spacing between them (--media-blocks-gap, from "Column spacing"; with
      "no spacing" the theme's usual gap between columns is used so the two always stay apart), every corner rounded. They share the height of the
      block (the usual block size, or the block beside it if that one is taller) in halves, so neither asks for a block height of its own.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .media-blocks__split {
      --media-blocks-split-gap: {% if section.settings.column_spacing == 'none' %}var(--horizontal-gap){% else %}var(--media-blocks-gap){% endif %};
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: minmax(0, 1fr);
      gap: var(--media-blocks-split-gap);
    }

    #shopify-section-{{ section.id }} .media-blocks__split .content-box {
      min-height: 0 !important;
    }

    #shopify-section-{{ section.id }} .media-blocks__split > .media-blocks__item {
      border-radius: var(--media-blocks-corner-radius) !important;
      overflow: hidden;
    }

    {%- if section.settings.stack_on_mobile -%}
      {%- comment -%}
        Phones (blocks stacked): a "Two images with text" block followed by a text-only block is one piece. The lower image touches the text block
        (the gap between blocks is taken away) and neither has a rounded corner where they meet. Nothing else of the text block changes.
      {%- endcomment -%}
      @media screen and (max-width: 699px) {
        #shopify-section-{{ section.id }} .media-blocks__split--glue-next {
          margin-block-end: calc(-1 * {% if section.settings.column_spacing == 'none' %}0px{% else %}var(--horizontal-gap){% endif %});
        }

        #shopify-section-{{ section.id }} .media-blocks__split--glue-next > :last-child {
          border-end-start-radius: 0 !important;
          border-end-end-radius: 0 !important;
        }

        #shopify-section-{{ section.id }} .media-blocks__item--glued,
        #shopify-section-{{ section.id }} .media-blocks__item--glued > .content-box {
          border-start-start-radius: 0 !important;
          border-start-end-radius: 0 !important;
        }

        {%- comment -%}
          Phone order. If the Info panel comes right BEFORE an "Image with text" block (the order picked for desktop), on phones the two swap:
          the image goes on top and the panel under it, so they can be glued (below). Every block gets an explicit order (its position, with
          the two swapped) so nothing else moves. Desktop and tablets keep the order of the editor.
        {%- endcomment -%}
        {%- liquid
          assign mobile_swap_index = -1

          for swap_block in section.blocks
            if swap_block.type == 'info_panel' or swap_block.type == 'faq_card'
              assign swap_next_block = section.blocks[forloop.index]

              if swap_next_block.type == 'image_with_text'
                assign mobile_swap_index = forloop.index0
                break
              endif
            endif
          endfor

          assign mobile_swap_next = mobile_swap_index | plus: 1
        -%}
        {%- if mobile_swap_index >= 0 -%}
          {%- for order_block in section.blocks -%}
            {%- if order_block.type == 'image_with_text' or order_block.type == 'video_with_text' or order_block.type == 'two_images_with_text' or order_block.type == 'stats' or order_block.type == 'words' or order_block.type == 'faq_card' or order_block.type == 'info_panel' -%}
              {%- liquid
                assign phone_order = forloop.index0

                if forloop.index0 == mobile_swap_index
                  assign phone_order = mobile_swap_next
                elsif forloop.index0 == mobile_swap_next
                  assign phone_order = mobile_swap_index
                endif
              -%}
              #shopify-section-{{ section.id }} .media-blocks > :is(#block-{{ order_block.id }}, media-block:has(> #block-{{ order_block.id }})) {
                order: {{ phone_order }};
              }
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%}
          An "Image with text" block with an "Info panel" or a "FAQ" card right below it: on phones they are one piece. The gap between them is taken away, the
          image block (.media-blocks__item--glue-next) has square bottom corners and the panel (.media-blocks__item--glued) square top corners.
          Phones only: on larger screens nothing changes.
          Only the space BETWEEN the two blocks is taken away; nothing inside either block changes (their inner padding and heights stay as they are).
          It is done with a negative margin on top of the panel, and the panel stretches over that extra distance (align-self: stretch, height: auto)
          instead of keeping the theme's height: 100%. The theme centers the blocks in their row and gives each one height: 100%, and with that
          a plain negative margin only squashed the block (it ate the panel's bottom padding and left part of the gap).
        {%- endcomment -%}
        #shopify-section-{{ section.id }} .media-blocks > .media-blocks__item--pull-up {
          margin-block-start: calc(-1 * {% if section.settings.column_spacing == 'none' %}0px{% else %}var(--horizontal-gap){% endif %});
          align-self: stretch;
          height: auto;
        }

        #shopify-section-{{ section.id }} .media-blocks__item--glue-next,
        #shopify-section-{{ section.id }} .media-blocks__item--glue-next > .content-box {
          border-end-start-radius: 0 !important;
          border-end-end-radius: 0 !important;
        }
      }
    {%- endif -%}

    {%- comment -%}
      "Statistics" block: the figures one under the other with space between them, the big number tight over its description, and the small note
      at the end: 1.5px smaller than the body text. The description under the number is plain body text: the body's size, no capitals.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .media-stats {
      display: grid;
      row-gap: 1.75rem;
    }

    #shopify-section-{{ section.id }} .media-stats__item {
      display: grid;
      row-gap: .25rem;
    }

    {%- comment -%}Desktop: half of the space between the big number and its description{%- endcomment -%}
    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .media-stats__item {
        row-gap: .125rem;
      }
    }

    #shopify-section-{{ section.id }} .media-stats__number,
    #shopify-section-{{ section.id }} .media-stats__label,
    #shopify-section-{{ section.id }} .media-stats__note {
      margin: 0;
    }

    #shopify-section-{{ section.id }} .media-stats__number {
      color: var(--media-stats-number-color, inherit);
      line-height: 1.05;
      /* Heavier than the heaviest weight: CSS stops at 1000, so the last bit up to "1100" is a thin outline of the same color around the letters */
      font-weight: 1000;
      -webkit-text-stroke: .02em currentColor;
    }

    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .media-stats__number {
        font-size: var(--media-stats-number-size-mobile);
      }
    }

    #shopify-section-{{ section.id }} .media-stats__note {
      font-size: calc(var(--text-base) - 1.5px);
      line-height: 1.5;
      opacity: .8;
    }

    {%- comment -%}
    "Palabras" block: a few big words (ingredients, what it is for...). They have one base color; a word turns into the chosen color only while
    the mouse pointer is over it. There is no click or tap action. The font is one of the store's own
    fonts (Rektorat, Swiss 721, Satoshi, Apercu), never one from the Shopify library. Each font file is declared here, with its own family name,
    only when a block of this section uses it, so nothing is downloaded for nothing.
    {%- endcomment -%}
    {%- assign words_fonts_used = '' -%}
    {%- for words_block in section.blocks -%}
      {%- if words_block.type == 'words' -%}
        {%- assign words_font_key = words_block.settings.font | default: 'rektorat' -%}
        {%- unless words_fonts_used contains words_font_key -%}
          {%- assign words_fonts_used = words_fonts_used | append: ',' | append: words_font_key -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if words_fonts_used contains 'rektorat' -%}
      @font-face { font-family: 'Words Rektorat'; src: url('{{ 'rektorat-bold.woff2' | asset_url }}') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Words Rektorat'; src: url('{{ 'rektorat-heavy.woff2' | asset_url }}') format('woff2'); font-weight: 800; font-style: normal; font-display: swap; }
    {%- endif -%}

    {%- if words_fonts_used contains 'swiss' -%}
      @font-face { font-family: 'Words Swiss'; src: url('{{ 'swiss-721-light.woff2' | asset_url }}') format('woff2'); font-weight: 300; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Words Swiss'; src: url('{{ 'swiss-721-regular.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Words Swiss'; src: url('{{ 'swiss-721-medium.woff2' | asset_url }}') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }
    {%- endif -%}

    {%- if words_fonts_used contains 'satoshi' -%}
      @font-face { font-family: 'Words Satoshi'; src: url('{{ 'satoshi-variable.woff2' | asset_url }}') format('woff2'); font-weight: 300 900; font-style: normal; font-display: swap; }
    {%- endif -%}

    {%- if words_fonts_used contains 'apercu' -%}
      @font-face { font-family: 'Words Apercu'; src: url('{{ 'apercu-light.woff2' | asset_url }}') format('woff2'); font-weight: 300; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Words Apercu'; src: url('{{ 'apercu-regular.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Words Apercu'; src: url('{{ 'apercu-medium.woff2' | asset_url }}') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Words Apercu'; src: url('{{ 'apercu-bold.woff2' | asset_url }}') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Words Apercu'; src: url('{{ 'apercu-extrabold.woff2' | asset_url }}') format('woff2'); font-weight: 800; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Words Apercu'; src: url('{{ 'apercu-black.woff2' | asset_url }}') format('woff2'); font-weight: 900; font-style: normal; font-display: swap; }
    {%- endif -%}

    #shopify-section-{{ section.id }} .media-words__list {
      display: grid;
      align-content: center;
      justify-items: var(--media-words-justify, center);
      text-align: var(--media-words-text-align, center);
      {%- comment -%}Space between the words: a share of the size of a word (not "em" of this box, which is the small body size)
      so it grows with the words; phones use their own size, see the phone rule below{%- endcomment -%}
      row-gap: calc(var(--media-words-size) * var(--media-words-scale, 1.5) * var(--media-words-gap-ratio, .35));
      height: 100%;
    }

    {%- comment -%}
    The words are bigger than the size picked in the block: that size (XX-Large to XX-Small, the same scale as the headings) times
    --media-words-scale, so even XX-Large reads as a big word. Phones use their own size, with the same increase.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .media-words__word {
      margin: 0;
      padding: 0;
      max-width: 100%;
      text-transform: none;
      line-height: 1.05;
      overflow-wrap: anywhere;
      color: var(--media-words-base, inherit);
      font-family: var(--media-words-font-family, inherit);
      font-weight: var(--media-words-weight, 800);
      font-size: calc(var(--media-words-size) * var(--media-words-scale, 1.5));
      transition: color .25s ease;
    }

    {%- comment -%}Only the mouse pointer paints a word (no click, no tap): the rule is limited to devices that really hover{%- endcomment -%}
    @media (hover: hover) and (pointer: fine) {
      #shopify-section-{{ section.id }} .media-words__word:hover {
        color: var(--media-words-active, currentColor);
      }
    }

    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .media-words__list {
        row-gap: calc(var(--media-words-size-mobile) * var(--media-words-scale, 1.5) * var(--media-words-gap-ratio, .35));
      }

      #shopify-section-{{ section.id }} .media-words__word {
        font-size: calc(var(--media-words-size-mobile) * var(--media-words-scale, 1.5));
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .media-words__word {
        transition: none;
      }
    }

    {%- comment -%}
    "FAQ" block: a card with a title, a short subtitle and a list of questions, each one an accordion like the ones of the FAQ section (the "+"
    icon takes its colors from Step Controls of the color scheme; a hairline between one question and the next, none above the first or below the
    last). The questions are plain text: no capitals, and the weight and size of the theme's body text. The content sits at the top, in the middle
    or at the bottom of the card (the card can be taller than its content when the block beside it is taller).
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .media-faq {
      display: flex;
      flex-direction: column;
      justify-content: var(--media-faq-position, flex-end);
      height: 100%;
    }

    {%- comment -%}A FAQ card that is alone in its section takes the whole width (Media Blocks always has at least 2 columns on desktop){%- endcomment -%}
    #shopify-section-{{ section.id }} .media-blocks > .media-blocks__item:has(.media-faq):only-child {
      grid-column: 1 / -1;
    }

    #shopify-section-{{ section.id }} .media-faq__title,
    #shopify-section-{{ section.id }} .media-faq__subtitle {
      margin: 0;
    }

    {%- comment -%}
    The title is the same as the Info panel's and the big numbers of the Statistics block: color picked in the block (empty = the color of the
    scheme's text) and the heaviest weight (1000 + a thin outline of the same color, see .media-stats__number).
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .media-faq__title > :is(h1, h2, h3, h4, h5, h6) {
      color: var(--media-faq-title-color, inherit);
      font-weight: 1000;
      -webkit-text-stroke: .02em currentColor;
    }

    #shopify-section-{{ section.id }} .media-faq__list {
      margin-block-start: 1.75rem;
    }

    #shopify-section-{{ section.id }} .media-faq__title + .media-faq__list,
    #shopify-section-{{ section.id }} .media-faq__subtitle + .media-faq__list {
      margin-block-start: 1.75rem;
    }

    #shopify-section-{{ section.id }} .media-faq:not(:has(.media-faq__title, .media-faq__subtitle)) .media-faq__list {
      margin-block-start: 0;
    }

    #shopify-section-{{ section.id }} .media-faq__subtitle {
      margin-block-start: .25rem;
    }

    #shopify-section-{{ section.id }} .media-faq .accordion {
      box-shadow: none;
    }

    #shopify-section-{{ section.id }} .media-faq__item + .media-faq__item {
      box-shadow: 0 -1px 0 rgb(var(--border-color));
    }

    #shopify-section-{{ section.id }} .media-faq .accordion__summary {
      text-transform: none;
      font-weight: var(--text-font-weight);
    }

    {%- comment -%}
      Top section spacing as margin instead of padding, so it reads the same way as the other
      converted sections. display: flow-root on the outer wrapper contains that margin (stops it
      collapsing through the wrapper's own top edge), so the color-scheme background still starts
      at exactly the same point as before - same value (including the padding-collapsing formula,
      still driven by --section-disable-padding-collapsing), just as margin.
    {%- endcomment -%}
    {%- if section.settings.floating_media_blocks -%}
      {%- comment -%}
      Floating: the cards carry the visual weight and the wrapper is only a frame, so the top spacing is left to
      collapse out of the section (no flow-root) and becomes real outer margin - the theme editor doesn't select
      it and no section-colored band sits above the cards. The bottom spacing is already outer margin
      (.section-floating--block-end).
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .section-spacing {
        padding-block: 0;
        margin-block-start: calc(var(--section-disable-padding-collapsing) * var(--section-vertical-spacing-block-start, var(--section-vertical-spacing)));
      }
    {%- else -%}
      #shopify-section-{{ section.id }} > div {
        display: flow-root;
      }

      #shopify-section-{{ section.id }} .section-spacing {
        padding-block-start: 0;
        margin-block-start: calc(var(--section-disable-padding-collapsing) * var(--section-vertical-spacing-block-start, var(--section-vertical-spacing)));
      }
    {%- endif -%}

    {%- comment -%}
    Info panel: heading on top, then a list of label/content rows below it, each row edited as its
    own pair of fields (label + content) so the merchant can change one row without touching the
    others - a divider is added between rows automatically, not on the first or last one.
    Padding follows the same formula faq.liquid uses for its own interior padding (--container-gutter
    plus a flat 0.5rem, uncapped), instead of the old min(2.5rem, var(--container-gutter)) ceiling -
    unified so every "card" interior padding in the theme matches.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .info-panel {
      padding: calc(var(--container-gutter) + 0.5rem);
      gap: 2rem;
      display: grid;
    }

    {%- comment -%}
    The panel keeps its size (and so the free room it may have above its content, e.g. when the block beside it is taller), but the title and
    the rows are packed together at the bottom of the card: align-content: end. Without it the grid stretched its rows and spread that free
    room between the title and the list. The title sits 2rem above the first row (it was 1rem for a moment, and 2rem before that: the same distance as the theme's original).
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .info-panel {
      align-content: end;
    }

    {%- comment -%}
    Each row has the label on the left and its content on the right (the content's lines are aligned to the right edge, also when it wraps onto
    several lines), with a hairline between one row and the next. The title stays on the left. The label and the content are plain text: they
    inherit the size, style and case of the theme's body text (no capitals, no smaller size); only the row labels are bold.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .info-panel,
    #shopify-section-{{ section.id }} .info-panel > :is(h1, h2, h3, h4, h5, h6) {
      text-align: start;
      justify-items: start;
    }

    #shopify-section-{{ section.id }} .info-panel__list {
      width: 100%;
      justify-self: stretch;
    }

    #shopify-section-{{ section.id }} .info-panel__list-item {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
      column-gap: var(--horizontal-gap);
      row-gap: .25rem;
      text-align: start;
      padding-block: 1.25rem;
      border-block-end: 1px solid rgb(var(--border-color));
      display: grid;
    }

    #shopify-section-{{ section.id }} .info-panel__list-item:first-child {
      padding-block-start: 0;
    }

    #shopify-section-{{ section.id }} .info-panel__list-item:last-child {
      padding-block-end: 0;
      border-block-end: none;
    }

    {%- comment -%}
    The panel's title has the same weight as the big numbers of the Statistics block (1000 + thin outline, see .media-stats__number).
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .info-panel > :is(h1, h2, h3, h4, h5, h6) {
      color: var(--info-panel-title-color, inherit);
      font-weight: 1000;
      -webkit-text-stroke: .02em currentColor;
    }

    {%- comment -%}
    Row labels in bold ("bold" takes the heaviest weight the theme's font has: Swiss 721, medium, only slightly heavier than regular) and with the
    same color as the panel's title: they use the "Title color" of the block (--info-panel-title-color), or the scheme's text color when that is empty.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .info-panel__list-item-label {
      color: var(--info-panel-title-color, inherit);
      font-weight: bold;
    }

    #shopify-section-{{ section.id }} .info-panel__list-item-content {
      text-align: end;
    }

    #shopify-section-{{ section.id }} .info-panel__list-item-content > :first-child {
      margin-block-start: 0;
    }

    #shopify-section-{{ section.id }} .info-panel__list-item-content > :last-child {
      margin-block-end: 0;
    }

    {%- comment -%}
    Tabs with media: two cards side by side. The text card shows the active tab (heading, text, button) on top and the list of tab titles at
    the bottom, each one above a divider; the media card holds one image per tab, stacked vertically, and slides up or down to the active one.
    All tab panels share one grid cell, so the card always takes the height of the tallest one and nothing jumps when switching tabs.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .media-tabs {
      padding: calc(var(--container-gutter) + 0.5rem);
      gap: 2.5rem;
      display: flex;
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .media-tabs__panels {
      display: grid;
    }

    #shopify-section-{{ section.id }} .media-tabs__panel {
      grid-area: 1 / 1;
      align-content: start;
      opacity: 0;
      visibility: hidden;
      transform: translateY(0.5rem);
      transition: opacity 0.35s ease, transform 0.35s ease, visibility 0s linear 0.35s;
    }

    #shopify-section-{{ section.id }} .media-tabs__panel.is-active {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity 0.5s ease 0.15s, transform 0.5s ease 0.15s, visibility 0s;
    }

    #shopify-section-{{ section.id }} .media-tabs__list {
      margin-block-start: auto;
      display: grid;
    }

    #shopify-section-{{ section.id }} .media-tabs__tab {
      text-align: start;
      padding-block: 1.25rem;
      border-block-start: 1px solid rgb(var(--text-color) / 0.2);
      cursor: pointer;
      display: block;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .media-tabs__tab > span {
      opacity: 0.5;
      transition: opacity 0.25s ease;
    }

    #shopify-section-{{ section.id }} .media-tabs__tab:last-child {
      padding-block-end: 0;
    }

    #shopify-section-{{ section.id }} .media-tabs__tab:hover > span {
      opacity: 0.8;
    }

    #shopify-section-{{ section.id }} .media-tabs__tab[aria-selected="true"] > span {
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .media-tabs-media {
      position: relative;
      overflow: hidden;
    }

    {%- if section.settings.mobile_block_size == 'auto' -%}
      @media screen and (max-width: 699px) {
        #shopify-section-{{ section.id }} .media-tabs-media {
          aspect-ratio: 4 / 5;
        }
      }
    {%- endif -%}

    #shopify-section-{{ section.id }} .media-tabs-media__track {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      transform: translateY(calc(-100% * var(--media-tabs-index, 0)));
      transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1);
    }

    #shopify-section-{{ section.id }} .media-tabs-media__slide {
      flex: 0 0 100%;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .media-tabs-media__slide > img,
    #shopify-section-{{ section.id }} .media-tabs-media__slide > svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1.12);
      transition: transform 1.4s cubic-bezier(0.25, 1, 0.5, 1);
    }

    #shopify-section-{{ section.id }} .media-tabs-media__slide.is-active > img,
    #shopify-section-{{ section.id }} .media-tabs-media__slide.is-active > svg {
      transform: none;
    }

    {%- if tabs_block -%}
      #shopify-section-{{ section.id }} .media-blocks--tabs {
        --media-blocks-grid: auto-flow / minmax(0, 1fr);
      }

      @media screen and (max-width: 699px) {
        #shopify-section-{{ section.id }} .media-tabs-media {
          order: {% if tabs_block.settings.mobile_image_position == 'top' %}-1{% else %}1{% endif %};
        }
      }

      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .media-blocks--tabs {
          --media-blocks-grid: auto / repeat(2, minmax(0, 1fr));
        }
      }
    {%- endif -%}

    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .media-tabs__panel,
      #shopify-section-{{ section.id }} .media-tabs__panel.is-active,
      #shopify-section-{{ section.id }} .media-tabs-media__track,
      #shopify-section-{{ section.id }} .media-tabs-media__slide > img {
        transform: none;
        transition: none;
      }
    }
  </style>

  {%- assign allow_transparent_header = false -%}

  {%- if section.settings.allow_transparent_header and section.settings.subheading == blank and section.settings.title == blank and section.settings.content == blank and section.settings.floating_media_blocks == false and section.settings.column_spacing == 'none' -%}
    {%- assign allow_transparent_header = true -%}
  {%- endif -%}

  {%- comment -%}
  Carousel (cards do not stack): the section's container rounds its four corners and clips what scrolls inside it, like the container of the
  featured product list does. The cards keep their own corner radius, so neither loses its rounded corners while scrolling. Side margins and
  spacing are not touched here.
  {%- endcomment -%}
  <div {% if allow_transparent_header %}allow-transparent-header{% endif %} class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_media_blocks %} section-floating section-floating--block-end{% endif %}"{% unless section.settings.stack_on_mobile %} style="border-radius: {{ section.settings.container_corner_radius }}px; overflow: hidden;"{% endunless %}>
    <div class="{% unless allow_transparent_header %}section-spacing{% endunless %}">
      <div class="section-stack">
        {%- if section.settings.subheading != blank or section.settings.title != blank or section.settings.content != blank -%}
          <div class="{% unless section.settings.floating_media_blocks %}container{% endunless %}">
            <div class="prose prose-justify-{{ section.settings.text_alignment }}">
              {%- if section.settings.subheading != blank -%}
                {%- render 'subheading', content: section.settings.subheading -%}
              {%- endif -%}

              {%- if section.settings.title != blank -%}
                {%- if section.settings.scrolling_title -%}
                  <h2 class="{{ section.settings.heading_tag }}">
                    <marquee-text speed="0.3" direction="start-to-end" class="scrolling-content bleed">
                      <span class="scrolling-content__item" style="font-size: var(--text-{{ section.settings.heading_tag }})">
                        <span class="scrolling-content__text">
                          {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_tag, html_tag: 'span', instant: true -%}
                        </span>

                        {%- if section.settings.scrolling_title_separator != 'none' -%}
                          <span class="shape shape--{{ section.settings.scrolling_title_separator }}" style="font-size: var(--text-{{ section.settings.heading_tag }})" aria-hidden="true"></span>
                        {%- endif -%}
                      </span>
                    </marquee-text>
                  </h2>
                {%- else -%}
                  {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_tag, html_tag: 'h2' -%}
                {%- endif -%}
              {%- endif -%}

              {%- if section.settings.content != blank -%}
                <div class="max-w-xs">
                  {{- section.settings.content -}}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if tabs_block and media_blocks_cells != section.blocks.size and request.design_mode -%}
          {%- comment -%}Only visible in the theme editor: tells the merchant why the other blocks are not shown{%- endcomment -%}
          <div class="{% unless section.settings.floating_media_blocks %}container{% endunless %}">
            <p class="text-sm" style="padding: 0.75rem 1rem; border: 1px dashed rgb(var(--text-color) / 0.4); border-radius: 0.5rem;">
              Esta sección tiene un bloque "Tabs with media", que ocupa todo el ancho: los demás bloques de la sección están ocultos. Quítalos o muévelos a otra sección Media Blocks.
            </p>
          </div>
        {%- endif -%}

        <div class="media-blocks {% if tabs_block %}media-blocks--tabs{% elsif section.settings.stack_on_mobile == false %}scroll-area bleed{% endif %}">
          {%- for block in section.blocks -%}
            {%- if tabs_block and block.type != 'tabs_with_media' -%}
              {%- continue -%}
            {%- endif -%}

            {%- case block.type -%}
              {%- when 'image_with_text' or 'video_with_text' -%}
                {%- liquid
                  # If the merchant choose to show a color scheme on hover, we force it on mobile, so we apply the hover one by default so that
                  # it is the default one on touch devices
                  if block.settings.change_color_scheme_on_hover
                    assign color_scheme = block.settings.color_scheme_hover
                  else
                    assign color_scheme = block.settings.color_scheme
                  endif

                  assign can_make_block_clickable = true

                  # A text-only block that comes right after a "Two images with text" block: on phones (blocks stacked) it is glued to it
                  assign glued_class = ''

                  if section.settings.stack_on_mobile and block.type == 'image_with_text' and forloop.index0 > 0
                    assign prev_index = forloop.index0 | minus: 1
                    assign prev_block = section.blocks[prev_index]

                    if prev_block.type == 'two_images_with_text' and block.settings.image == blank
                      assign glued_class = 'media-blocks__item--glued'
                    endif
                  endif

                  # An "Info panel" or "FAQ" block right before or after this block: on phones the image goes on top and that block is glued under it
                  # (see .media-blocks__item--glue-next and the phone order further down)
                  if section.settings.stack_on_mobile and block.type == 'image_with_text'
                    assign iw_glue_panel = false
                    assign iw_next_block = section.blocks[forloop.index]

                    if iw_next_block.type == 'info_panel' or iw_next_block.type == 'faq_card'
                      assign iw_glue_panel = true
                    endif

                    if forloop.index0 > 0
                      assign iw_prev_index = forloop.index0 | minus: 1
                      assign iw_prev_block = section.blocks[iw_prev_index]

                      if iw_prev_block.type == 'info_panel' or iw_prev_block.type == 'faq_card'
                        assign iw_glue_panel = true
                      endif
                    endif

                    if iw_glue_panel
                      assign glued_class = glued_class | append: ' media-blocks__item--glue-next'
                    endif
                  endif

                  if block.settings.subheading contains '</a>' or block.settings.text contains '</a>' or block.settings.title contains '</a>'
                    assign can_make_block_clickable = false
                  endif
                -%}

                {%- capture block_content -%}
                  <div class="content-box h-full min-h-{{ section.settings.mobile_block_size }} md:min-h-{{ section.settings.block_size }}">
                    {%- capture sizes_attribute -%}(max-width: 699px) 100vw, (max-width: 999px) 50vw, {{ 100.0 | divided_by: section.settings.items_per_row | round }}vw{%- endcapture -%}

                    {%- if block.settings.image != blank or block.settings.video != blank -%}
                      <div class="content-box__background-media">
                        {%- liquid
                          assign loading_attribute = nil

                          if section.index > 1 or forloop.index > 3
                            assign loading_attribute = 'lazy'
                          endif

                          if block.type == 'image_with_text' and block.settings.image != blank
                            echo block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: loading_attribute, sizes: sizes_attribute, widths: '300,400,500,600,800,1000,1200,1400,1600,1800', class: 'size-full'
                          elsif block.type == 'video_with_text' and block.settings.video != blank
                            render 'media', media: block.settings.video, autoplay: true, loop: true, controls: false, sizes: sizes_attribute
                          endif
                        -%}
                      </div>
                    {%- elsif block.settings.color_scheme.settings.background == 'rgba(0,0,0,0)' and request.design_mode or request.visual_preview_mode -%}
                      <div class="content-box__background-media">
                        {{- 'collection-apparel-1' | placeholder_svg_tag: 'block' -}}
                      </div>
                    {%- endif -%}

                    {%- liquid
                      assign top_left_content = ''
                      assign top_center_content = ''
                      assign top_right_content = ''
                      assign middle_left_content = ''
                      assign middle_center_content = ''
                      assign middle_right_content = ''
                      assign bottom_left_content = ''
                      assign bottom_center_content = ''
                      assign bottom_right_content = ''
                    -%}

                    {%- assign content_array = 'icon,subheading,heading,text,link' | split: ',' -%}

                    {%- for content_type in content_array -%}
                      {%- capture content -%}
                        {%- case content_type -%}
                          {%- when 'icon' -%}
                            {%- if block.settings.custom_icon != blank -%}
                              {%- render 'icon', image: block.settings.custom_icon, width: block.settings.icon_width, mobile_width: block.settings.mobile_icon_width -%}
                            {%- else -%}
                              {%- render 'icon' with block.settings.icon, width: block.settings.icon_width, mobile_width: block.settings.mobile_icon_width -%}
                            {%- endif -%}

                          {%- when 'subheading' -%}
                            {%- if block.settings.subheading != blank -%}
                              {%- render 'subheading', content: block.settings.subheading -%}
                            {%- endif -%}

                          {%- when 'heading' -%}
                            {%- if block.settings.title != blank -%}
                              {%- if block.settings.scrolling_title -%}
                                <p class="{{ block.settings.heading_tag }} {% if block.settings.show_text_vertically %}h-full{% else %}column-bleed{% endif %}">
                                  <marquee-text speed="0.3" direction="start-to-end" {% if block.settings.show_text_vertically %}vertical{% endif %} class="scrolling-content {% if block.settings.show_text_vertically %}scrolling-content--vertical h-full{% endif %}">
                                    <span class="scrolling-content__item" style="font-size: var(--text-{{ block.settings.heading_tag }})">
                                      <span class="scrolling-content__text">
                                        {%- render 'heading', content: block.settings.title, style: block.settings.heading_tag, html_tag: 'span', instant: true, show_vertically: block.settings.show_text_vertically -%}
                                      </span>

                                      {%- if block.settings.scrolling_title_separator != 'none' -%}
                                        <span class="shape shape--{{ block.settings.scrolling_title_separator }}" style="font-size: var(--text-{{ block.settings.heading_tag }})" aria-hidden="true"></span>
                                      {%- endif -%}
                                    </span>
                                  </marquee-text>
                                </p>
                              {%- else -%}
                                {%- render 'heading', content: block.settings.title, style: block.settings.heading_tag, show_vertically: block.settings.show_text_vertically -%}
                              {%- endif -%}
                            {%- endif -%}

                          {%- when 'text' -%}
                            {% if block.settings.text != blank %}
                              <div class="max-w-sm">
                                {{- block.settings.text -}}
                              </div>
                            {%- endif -%}

                          {%- when 'link' -%}
                            {%- liquid
                              if block.settings.link_text != blank
                                if can_make_block_clickable
                                  render 'button', content: block.settings.link_text, type: 'button', style: block.settings.button_style
                                else
                                  render 'button', content: block.settings.link_text, href: block.settings.link_url, style: block.settings.button_style
                                endif
                              endif
                            -%}
                        {%- endcase -%}
                      {%- endcapture -%}

                      {%- capture content_position_key -%}{{ content_type }}_position{%- endcapture -%}

                      {%- if content_type == 'heading' and block.settings.scrolling_title and block.settings.show_text_vertically -%}
                        <div class="row-span-full justify-self-{% if block.settings[content_position_key] contains 'left' %}start{% elsif block.settings[content_position_key] contains 'right' %}end{% else %}center{% endif %}">
                          {{ content }}
                        </div>
                      {%- else -%}
                        {%- liquid
                          case block.settings[content_position_key]
                            when 'top_left'
                              assign top_left_content = top_left_content | append: content
                            when 'top_center'
                              assign top_center_content = top_center_content | append: content
                            when 'top_right'
                              assign top_right_content = top_right_content | append: content
                            when 'middle_left'
                              assign middle_left_content = middle_left_content | append: content
                            when 'middle_center'
                              assign middle_center_content = middle_center_content | append: content
                            when 'middle_right'
                              assign middle_right_content = middle_right_content | append: content
                            when 'bottom_left'
                              assign bottom_left_content = bottom_left_content | append: content
                            when 'bottom_center'
                              assign bottom_center_content = bottom_center_content | append: content
                            when 'bottom_right'
                              assign bottom_right_content = bottom_right_content | append: content
                          endcase
                        -%}
                      {%- endif -%}
                    {%- endfor -%}

                    <div class="placement-grid">
                      {% if top_left_content != blank %}
                        <div class="align-self-start">
                          <div class="prose prose-justify-start">
                            {{- top_left_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if top_center_content != blank %}
                        <div class="align-self-start">
                          <div class="prose prose-justify-center">
                            {{- top_center_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if top_right_content != blank %}
                        <div class="align-self-start">
                          <div class="prose prose-justify-end">
                            {{- top_right_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if middle_left_content != blank %}
                        <div class="align-self-center">
                          <div class="prose prose-justify-start">
                            {{- middle_left_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if middle_center_content != blank %}
                        <div class="align-self-center">
                          <div class="prose prose-justify-center">
                            {{- middle_center_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if middle_right_content != blank %}
                        <div class="align-self-center">
                          <div class="prose prose-justify-end">
                            {{- middle_right_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if bottom_left_content != blank %}
                        <div class="align-self-end">
                          <div class="prose prose-justify-start">
                            {{- bottom_left_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if bottom_center_content != blank %}
                        <div class="align-self-end">
                          <div class="prose prose-justify-center">
                            {{- bottom_center_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if bottom_right_content != blank %}
                        <div class="align-self-end">
                          <div class="prose prose-justify-end">
                            {{- bottom_right_content -}}
                          </div>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endcapture -%}

                <media-block class="h-full">
                  {%- if can_make_block_clickable and block.settings.link_url != blank -%}
                    <a href="{{ block.settings.link_url }}" id="block-{{ block.id }}" class="media-blocks__item {{ glued_class }} {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} @container/content-box color-scheme color-scheme--{{ color_scheme.id }}" {{ block.shopify_attributes }}>
                      {{- block_content -}}
                    </a>
                  {%- else -%}
                    <div id="block-{{ block.id }}" class="media-blocks__item {{ glued_class }} {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} @container/content-box color-scheme color-scheme--{{ color_scheme.id }}" {{ block.shopify_attributes }}>
                      {{- block_content -}}
                    </div>
                  {%- endif -%}
                </media-block>

              {%- when 'two_images_with_text' -%}
                {%- comment -%}
                Two cards one over the other, each one an image with its own optional text. Every corner of each card is rounded (the section's corner
                radius) and the section's spacing sits between them (see .media-blocks__split in the CSS above). The block is as tall as a single block, or
                as the block beside it in the row if that one is taller; the two cards share that height in halves. On phones, a block that is only text
                right after it is glued to the lower card.
                {%- endcomment -%}
                {%- liquid
                  assign glue_next = false
                  assign next_block = section.blocks[forloop.index]

                  if section.settings.stack_on_mobile and next_block.type == 'image_with_text' and next_block.settings.image == blank
                    assign glue_next = true
                  elsif section.settings.stack_on_mobile and next_block.type == 'stats'
                    assign glue_next = true
                  endif

                  assign two_cards = 'first,second' | split: ','
                -%}

                {%- capture two_sizes -%}(max-width: 699px) 100vw, (max-width: 999px) 50vw, {{ 100.0 | divided_by: section.settings.items_per_row | round }}vw{%- endcapture -%}

                <div id="block-{{ block.id }}" class="media-blocks__split h-full min-h-{{ section.settings.mobile_block_size }} md:min-h-{{ section.settings.block_size }}{% if glue_next %} media-blocks__split--glue-next{% endif %}" {{ block.shopify_attributes }}>
                  {%- for card in two_cards -%}
                    {%- liquid
                      assign image_key = card | append: '_image'
                      assign subheading_key = card | append: '_subheading'
                      assign title_key = card | append: '_title'
                      assign tag_key = card | append: '_heading_tag'
                      assign text_key = card | append: '_text'
                      assign link_text_key = card | append: '_link_text'
                      assign link_url_key = card | append: '_link_url'
                      assign style_key = card | append: '_button_style'
                      assign position_key = card | append: '_content_position'

                      assign card_image = block.settings[image_key]
                      assign card_position = block.settings[position_key] | default: 'bottom_left'
                      assign card_vertical = card_position | split: '_' | first
                      assign card_horizontal = card_position | split: '_' | last

                      assign card_align_self = 'end'
                      if card_vertical == 'top'
                        assign card_align_self = 'start'
                      elsif card_vertical == 'middle'
                        assign card_align_self = 'center'
                      endif

                      assign card_justify = 'start'
                      if card_horizontal == 'center'
                        assign card_justify = 'center'
                      elsif card_horizontal == 'right'
                        assign card_justify = 'end'
                      endif
                    -%}

                    {%- capture card_content -%}
                      {%- if block.settings[subheading_key] != blank -%}
                        {%- render 'subheading', content: block.settings[subheading_key] -%}
                      {%- endif -%}

                      {%- if block.settings[title_key] != blank -%}
                        {%- render 'heading', content: block.settings[title_key], style: block.settings[tag_key] -%}
                      {%- endif -%}

                      {%- if block.settings[text_key] != blank -%}
                        <div class="max-w-sm">
                          {{- block.settings[text_key] -}}
                        </div>
                      {%- endif -%}

                      {%- if block.settings[link_text_key] != blank -%}
                        {%- render 'button', content: block.settings[link_text_key], href: block.settings[link_url_key], style: block.settings[style_key] -%}
                      {%- endif -%}
                    {%- endcapture -%}

                    <div class="media-blocks__item {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} @container/content-box color-scheme color-scheme--{{ block.settings.color_scheme.id }}">
                      <div class="content-box h-full min-h-{{ section.settings.mobile_block_size }} md:min-h-{{ section.settings.block_size }}">
                        {%- if card_image != blank -%}
                          <div class="content-box__background-media">
                            {{- card_image | image_url: width: card_image.width | image_tag: loading: 'lazy', sizes: two_sizes, widths: '300,400,500,600,800,1000,1200,1400,1600,1800', class: 'size-full' -}}
                          </div>
                        {%- endif -%}

                        {%- if card_content != blank -%}
                          <div class="placement-grid">
                            <div class="align-self-{{ card_align_self }}">
                              <div class="prose prose-justify-{{ card_justify }}">
                                {{- card_content -}}
                              </div>
                            </div>
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>

              {%- when 'stats' -%}
                {%- liquid
                  # Right after a "Two images with text" block, on phones (blocks stacked), the card is glued to it (see .media-blocks__item--glued)
                  assign glued_class = ''

                  if section.settings.stack_on_mobile and forloop.index0 > 0
                    assign prev_index = forloop.index0 | minus: 1
                    assign prev_block = section.blocks[prev_index]

                    if prev_block.type == 'two_images_with_text'
                      assign glued_class = 'media-blocks__item--glued'
                    endif
                  endif
                -%}

                {%- comment -%}
                Statistics card: each figure is a big number (or percentage) with its description under it, each in its own field, and a small note at
                the bottom. The big number is a paragraph styled like a heading (the size is picked in the block: XX-Large to XX-Small), not a real heading
                tag, so the page's heading structure (SEO) is untouched.
                {%- endcomment -%}
                <div id="block-{{ block.id }}" class="media-blocks__item {{ glued_class }} {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }}" {{ block.shopify_attributes }}>
                  <div class="content-box h-full">
                    <div class="media-stats" {% if block.settings.number_color != blank and block.settings.number_color != 'rgba(0,0,0,0)' %}style="--media-stats-number-color: {{ block.settings.number_color }};"{% endif %}>
                      {%- for i in (1..4) -%}
                        {%- liquid
                          assign number_key = 'stat_' | append: i | append: '_number'
                          assign label_key = 'stat_' | append: i | append: '_label'
                          assign stat_number = block.settings[number_key]
                          assign stat_label = block.settings[label_key]
                        -%}

                        {%- if stat_number != blank or stat_label != blank -%}
                          <div class="media-stats__item">
                            {%- if stat_number != blank -%}
                              <p class="media-stats__number {{ block.settings.number_size }}" style="--media-stats-number-size-mobile: var(--text-{{ block.settings.number_size_mobile | default: block.settings.number_size }});">{{ stat_number }}</p>
                            {%- endif -%}

                            {%- if stat_label != blank -%}
                              <p class="media-stats__label">{{ stat_label }}</p>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}

                      {%- if block.settings.note != blank -%}
                        <p class="media-stats__note">{{ block.settings.note }}</p>
                      {%- endif -%}
                    </div>
                  </div>
                </div>

              {%- when 'words' -%}
                {%- liquid
                  assign words_font = block.settings.font | default: 'rektorat'
                  assign words_family = ''

                  case words_font
                    when 'rektorat'
                      assign words_family = "'Words Rektorat'"
                    when 'swiss'
                      assign words_family = "'Words Swiss'"
                    when 'satoshi'
                      assign words_family = "'Words Satoshi'"
                    when 'apercu'
                      assign words_family = "'Words Apercu'"
                  endcase

                  assign words_size_desktop = block.settings.word_size | default: 'h2'
                  assign words_size_mobile = block.settings.word_size_mobile | default: words_size_desktop

                  assign words_justify = 'center'
                  if block.settings.alignment == 'left'
                    assign words_justify = 'start'
                  elsif block.settings.alignment == 'right'
                    assign words_justify = 'end'
                  endif

                  capture words_style
                    echo '--media-words-justify: ' | append: words_justify | append: ';'
                    echo '--media-words-text-align: ' | append: block.settings.alignment | append: ';'
                    echo '--media-words-font-family: ' | append: words_family | append: ', var(--heading-font-family);'
                    echo '--media-words-weight: ' | append: block.settings.font_weight | append: ';'
                    echo '--media-words-size: var(--text-' | append: words_size_desktop | append: ');'
                    echo '--media-words-size-mobile: var(--text-' | append: words_size_mobile | append: ');'

                    if block.settings.base_color != blank and block.settings.base_color != 'rgba(0,0,0,0)'
                      echo '--media-words-base: ' | append: block.settings.base_color | append: ';'
                    endif

                    if block.settings.active_color != blank and block.settings.active_color != 'rgba(0,0,0,0)'
                      echo '--media-words-active: ' | append: block.settings.active_color | append: ';'
                    endif
                  endcapture
                -%}

                {%- comment -%}
                Words card: up to 4 words, each a paragraph styled like a heading (the size is picked in the block, XX-Large to XX-Small; not a real
                heading tag, so the page's heading structure is untouched). The mouse pointer over a word paints it with the chosen color (no click
                action); see .media-words__word in the CSS above.
                {%- endcomment -%}
                <div id="block-{{ block.id }}" class="media-blocks__item {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }}" style="{{ words_style | strip_newlines }}" {{ block.shopify_attributes }}>
                  <div class="content-box h-full">
                    <div class="media-words__list">
                      {%- for i in (1..4) -%}
                        {%- liquid
                          assign word_key = 'word_' | append: i
                          assign word_text = block.settings[word_key]
                        -%}

                        {%- if word_text != blank -%}
                          <p class="media-words__word {{ words_size_desktop }}">{{ word_text }}</p>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                </div>

              {%- when 'faq_card' -%}
                {%- liquid
                  assign faq_position = 'flex-end'
                  if block.settings.content_position == 'top'
                    assign faq_position = 'flex-start'
                  elsif block.settings.content_position == 'middle'
                    assign faq_position = 'center'
                  endif

                  # On phones (blocks stacked) an "Image with text" block right before or after the card is glued to it: the image on top, the card
                  # under it (same system as the Info panel, see .media-blocks__item--pull-up and the phone order further up)
                  assign faq_glue_class = ''

                  if section.settings.stack_on_mobile
                    assign faq_image_next = false
                    assign faq_next_block = section.blocks[forloop.index]

                    if faq_next_block.type == 'image_with_text'
                      assign faq_image_next = true
                    endif

                    if forloop.index0 > 0
                      assign faq_prev_index = forloop.index0 | minus: 1
                      assign faq_prev_block = section.blocks[faq_prev_index]

                      if faq_prev_block.type == 'image_with_text'
                        assign faq_image_next = true
                      endif
                    endif

                    if faq_image_next
                      assign faq_glue_class = 'media-blocks__item--glued media-blocks__item--pull-up'
                    endif
                  endif
                -%}

                {%- comment -%}
                FAQ card: title + subtitle + up to 12 questions, each an accordion (snippets/accordion.liquid, the same component the FAQ section uses,
                with the "+" icon). Questions and answers are each in their own field; a question left empty is skipped. See .media-faq in the CSS above.
                {%- endcomment -%}
                <div id="block-{{ block.id }}" class="media-blocks__item {{ faq_glue_class }} {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }}" style="--media-faq-position: {{ faq_position }};{% if block.settings.title_color != blank and block.settings.title_color != 'rgba(0,0,0,0)' %} --media-faq-title-color: {{ block.settings.title_color }};{% endif %}" {{ block.shopify_attributes }}>
                  <div class="content-box h-full">
                    <div class="media-faq">
                      {%- if block.settings.title != blank -%}
                        <div class="media-faq__title">
                          {%- render 'heading', content: block.settings.title, style: block.settings.heading_tag, html_tag: 'h3', balance_text: true -%}
                        </div>
                      {%- endif -%}

                      {%- if block.settings.subtitle != blank -%}
                        <p class="media-faq__subtitle">{{ block.settings.subtitle }}</p>
                      {%- endif -%}

                      <div class="media-faq__list">
                        {%- for i in (1..12) -%}
                          {%- liquid
                            assign question_key = 'question_' | append: i
                            assign answer_key = 'answer_' | append: i
                            assign faq_question = block.settings[question_key]
                            assign faq_answer = block.settings[answer_key]
                          -%}

                          {%- if faq_question != blank and faq_answer != blank -%}
                            <div class="media-faq__item">
                              {%- render 'accordion', title: faq_question, content: faq_answer, prose_content: true, toggle_icon: 'accordion-plus' -%}
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                </div>

              {%- when 'info_panel' -%}
                {%- liquid
                  # On phones (blocks stacked) an "Image with text" block right before or after the panel is glued to it: the image on top, the panel
                  # under it (see .media-blocks__item--pull-up and the phone order further up)
                  assign info_panel_glue_class = ''

                  if section.settings.stack_on_mobile
                    assign info_panel_image_next = false
                    assign info_panel_next_block = section.blocks[forloop.index]

                    if info_panel_next_block.type == 'image_with_text'
                      assign info_panel_image_next = true
                    endif

                    if forloop.index0 > 0
                      assign info_panel_prev_index = forloop.index0 | minus: 1
                      assign info_panel_prev_block = section.blocks[info_panel_prev_index]

                      if info_panel_prev_block.type == 'image_with_text'
                        assign info_panel_image_next = true
                      endif
                    endif

                    if info_panel_image_next
                      assign info_panel_glue_class = 'media-blocks__item--glued media-blocks__item--pull-up'
                    endif
                  endif
                -%}
                <div id="block-{{ block.id }}" class="media-blocks__item {{ info_panel_glue_class }} {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }} info-panel" {% if block.settings.title_color != blank and block.settings.title_color != 'rgba(0,0,0,0)' %}style="--info-panel-title-color: {{ block.settings.title_color }};"{% endif %} {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    {%- render 'heading', content: block.settings.title, style: block.settings.heading_tag, html_tag: 'h3', balance_text: true -%}
                  {%- endif -%}

                  {%- liquid
                    assign info_panel_has_items = false

                    for i in (1..6)
                      capture item_label_key
                        echo 'item_'
                        echo i
                        echo '_label'
                      endcapture

                      capture item_content_key
                        echo 'item_'
                        echo i
                        echo '_content'
                      endcapture

                      if block.settings[item_label_key] != blank or block.settings[item_content_key] != blank
                        assign info_panel_has_items = true
                      endif
                    endfor
                  -%}

                  {%- if info_panel_has_items -%}
                    <div class="info-panel__list">
                      {%- for i in (1..6) -%}
                        {%- liquid
                          capture item_label_key
                            echo 'item_'
                            echo i
                            echo '_label'
                          endcapture

                          capture item_content_key
                            echo 'item_'
                            echo i
                            echo '_content'
                          endcapture

                          assign item_label = block.settings[item_label_key]
                          assign item_content = block.settings[item_content_key]
                        -%}

                        {%- if item_label != blank or item_content != blank -%}
                          <div class="info-panel__list-item">
                            {%- if item_label != blank -%}
                              <div class="info-panel__list-item-label">{{ item_label }}</div>
                            {%- endif -%}

                            {%- if item_content != blank -%}
                              <div class="info-panel__list-item-content">{{ item_content }}</div>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'tabs_with_media' -%}
                {%- comment -%}
                Two sibling cards (text + images) so both are real grid cells of .media-blocks: the outer-corner and grid rules above see them
                as two cards. The <media-tabs> element finds its image card through the "media" attribute. Tabs with an empty title are skipped.
                {%- endcomment -%}
                {%- liquid
                  assign tabs_media_id = 'media-tabs-media-' | append: block.id
                  assign tabs_count = 0
                  for i in (1..6)
                    capture tab_title_key
                      echo 'tab_'
                      echo i
                      echo '_title'
                    endcapture
                    if block.settings[tab_title_key] != blank
                      assign tabs_count = tabs_count | plus: 1
                    endif
                  endfor
                -%}

                {%- capture tabs_text_card -%}
                  <media-tabs
                    id="block-{{ block.id }}"
                    media="{{ tabs_media_id }}"
                    {% if block.settings.autoplay %}autoplay="{{ block.settings.autoplay_speed | times: 1000 }}"{% endif %}
                    class="media-blocks__item {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }} media-tabs min-h-{{ section.settings.mobile_block_size }} md:min-h-{{ section.settings.block_size }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="media-tabs__panels">
                      {%- assign tab_position = 0 -%}
                      {%- for i in (1..6) -%}
                        {%- liquid
                          capture tab_title_key
                            echo 'tab_'
                            echo i
                            echo '_title'
                          endcapture
                          capture tab_text_key
                            echo 'tab_'
                            echo i
                            echo '_text'
                          endcapture
                          capture tab_link_text_key
                            echo 'tab_'
                            echo i
                            echo '_link_text'
                          endcapture
                          capture tab_link_url_key
                            echo 'tab_'
                            echo i
                            echo '_link_url'
                          endcapture
                        -%}

                        {%- if block.settings[tab_title_key] != blank -%}
                          {%- assign tab_position = tab_position | plus: 1 -%}
                          <div
                            id="block-{{ block.id }}-panel-{{ tab_position }}"
                            class="media-tabs__panel prose {% if tab_position == 1 %}is-active{% endif %}"
                            role="tabpanel"
                            aria-labelledby="block-{{ block.id }}-tab-{{ tab_position }}"
                            {% if tab_position != 1 %}inert{% endif %}
                          >
                            {%- render 'heading', content: block.settings[tab_title_key], style: block.settings.heading_tag, html_tag: 'p', instant: true -%}

                            {%- if block.settings[tab_text_key] != blank -%}
                              <div class="max-w-sm">{{ block.settings[tab_text_key] }}</div>
                            {%- endif -%}

                            {%- if block.settings[tab_link_text_key] != blank -%}
                              {%- render 'button', content: block.settings[tab_link_text_key], href: block.settings[tab_link_url_key], style: block.settings.button_style -%}
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                    {%- if tabs_count > 1 -%}
                      <div class="media-tabs__list" role="tablist" aria-orientation="vertical">
                        {%- assign tab_position = 0 -%}
                        {%- for i in (1..6) -%}
                          {%- capture tab_title_key -%}tab_{{ i }}_title{%- endcapture -%}

                          {%- if block.settings[tab_title_key] != blank -%}
                            {%- assign tab_position = tab_position | plus: 1 -%}
                            <button
                              type="button"
                              id="block-{{ block.id }}-tab-{{ tab_position }}"
                              class="media-tabs__tab"
                              role="tab"
                              aria-controls="block-{{ block.id }}-panel-{{ tab_position }}"
                              aria-selected="{% if tab_position == 1 %}true{% else %}false{% endif %}"
                              {% if tab_position != 1 %}tabindex="-1"{% endif %}
                            >
                              <span class="{{ block.settings.tab_title_tag }}">{{ block.settings[tab_title_key] | strip_html }}</span>
                            </button>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </media-tabs>
                {%- endcapture -%}

                {%- capture tabs_media_card -%}
                  <div id="{{ tabs_media_id }}" class="media-blocks__item {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }} media-tabs-media min-h-{{ section.settings.mobile_block_size }} md:min-h-{% if section.settings.block_size == 'auto' %}md{% else %}{{ section.settings.block_size }}{% endif %}" aria-hidden="true">
                    <div class="media-tabs-media__track">
                      {%- assign tab_position = 0 -%}
                      {%- for i in (1..6) -%}
                        {%- liquid
                          capture tab_title_key
                            echo 'tab_'
                            echo i
                            echo '_title'
                          endcapture
                          capture tab_image_key
                            echo 'tab_'
                            echo i
                            echo '_image'
                          endcapture
                        -%}

                        {%- if block.settings[tab_title_key] != blank -%}
                          {%- assign tab_position = tab_position | plus: 1 -%}
                          <div class="media-tabs-media__slide {% if tab_position == 1 %}is-active{% endif %}">
                            {%- liquid
                              assign tab_image = block.settings[tab_image_key]
                              assign loading_attribute = 'lazy'
                              if section.index <= 1 and tab_position == 1
                                assign loading_attribute = nil
                              endif

                              if tab_image != blank
                                echo tab_image | image_url: width: tab_image.width | image_tag: loading: loading_attribute, sizes: '(max-width: 699px) 100vw, 50vw', widths: '400,600,800,1000,1200,1400,1600,1800', alt: tab_image.alt
                              else
                                echo 'lifestyle-1' | placeholder_svg_tag
                              endif
                            -%}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endcapture -%}

                {%- if block.settings.image_position == 'left' -%}
                  {{- tabs_media_card -}}
                  {{- tabs_text_card -}}
                {%- else -%}
                  {{- tabs_text_card -}}
                  {{- tabs_media_card -}}
                {%- endif -%}

                <script>
                  if (!window.customElements.get('media-tabs')) {
                    window.customElements.define('media-tabs', class extends HTMLElement {
                      connectedCallback() {
                        this.tabs = Array.from(this.querySelectorAll('[role="tab"]'));
                        this.panels = Array.from(this.querySelectorAll('[role="tabpanel"]'));
                        this.media = document.getElementById(this.getAttribute('media'));
                        this.slides = this.media ? Array.from(this.media.querySelectorAll('.media-tabs-media__slide')) : [];
                        this.index = 0;

                        this.tabs.forEach((tab, index) => {
                          tab.addEventListener('click', () => this.select(index, true));
                          tab.addEventListener('keydown', (event) => this.onKeydown(event, index));
                        });

                        this.startAutoplay();
                        this.addEventListener('pointerenter', () => this.stopAutoplay());
                        this.addEventListener('pointerleave', () => this.startAutoplay());
                        this.addEventListener('focusin', () => this.stopAutoplay());

                        this.onBlockSelect = (event) => {
                          if (event.target === this) this.stopAutoplay(true);
                        };
                        document.addEventListener('shopify:block:select', this.onBlockSelect);
                      }

                      disconnectedCallback() {
                        this.stopAutoplay(true);
                        document.removeEventListener('shopify:block:select', this.onBlockSelect);
                      }

                      select(index, fromUser = false) {
                        if (index === this.index && !fromUser) return;
                        this.index = index;

                        this.tabs.forEach((tab, i) => {
                          tab.setAttribute('aria-selected', i === index ? 'true' : 'false');
                          tab.tabIndex = i === index ? 0 : -1;
                        });

                        this.panels.forEach((panel, i) => {
                          panel.classList.toggle('is-active', i === index);
                          panel.inert = i !== index;
                        });

                        this.slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
                        this.media?.style.setProperty('--media-tabs-index', index);

                        if (fromUser) this.stopAutoplay(true);
                      }

                      onKeydown(event, index) {
                        const keys = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
                        let next = null;

                        if (event.key in keys) next = (index + keys[event.key] + this.tabs.length) % this.tabs.length;
                        if (event.key === 'Home') next = 0;
                        if (event.key === 'End') next = this.tabs.length - 1;
                        if (next === null) return;

                        event.preventDefault();
                        this.select(next, true);
                        this.tabs[next].focus();
                      }

                      startAutoplay() {
                        const delay = parseInt(this.getAttribute('autoplay'), 10);
                        if (!delay || this.autoplayStopped || this.tabs.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

                        clearInterval(this.timer);
                        this.timer = setInterval(() => this.select((this.index + 1) % this.tabs.length), delay);
                      }

                      stopAutoplay(forever = false) {
                        clearInterval(this.timer);
                        if (forever) this.autoplayStopped = true;
                      }
                    });
                  }
                </script>

              {%- when 'empty_item' -%}
                <div class="media-blocks__item color-scheme color-scheme--{{ block.settings.color_scheme.id }} md-max:hidden" {{ block.shopify_attributes }}>
                </div>

            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

