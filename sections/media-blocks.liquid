{%- if section.blocks.size > 0 -%}
  {%- liquid
    # When the section is just a carousel block + one other block, the carousel should take 60%
    # of the row and the other block the remaining 40% (whichever column each one lands in).
    assign carousel_count = 0
    assign carousel_block_index = 0

    for block in section.blocks
      if block.type == 'carousel'
        assign carousel_count = carousel_count | plus: 1

        if carousel_block_index == 0
          assign carousel_block_index = forloop.index
        endif
      endif
    endfor

    assign use_carousel_split = false

    if carousel_count == 1 and section.blocks.size == 2
      assign use_carousel_split = true
    endif
  -%}

  <style>
    #shopify-section-{{ section.id }} {
      --media-blocks-grid: {% if section.settings.stack_on_mobile %}auto-flow / minmax(0, 1fr){% else %}auto / auto-flow 78vw{% endif %};
      {%- comment -%}
        When column_spacing is 'none' the gap is forced to 0px even if add_border is enabled.
        The original 1px gap for add_border was meant to reveal a hairline between cards, but it
        breaks the "single continuous piece" look required when there is no spacing between cards
        (it also creates a 1px seam that clashes with the shared outer corner radius). The bordered
        look (.media-blocks__item--bordered) still renders its own border on top of each card, so
        visually nothing is lost by removing the extra 1px gap.
      {%- endcomment -%}
      --media-blocks-gap: {% if section.settings.column_spacing == 'none' %}0px{% elsif section.settings.column_spacing == 'sm' %}calc(var(--container-gutter) / 2){% elsif section.settings.column_spacing == 'md' %}var(--container-gutter){% elsif section.settings.column_spacing == 'lg' %}calc(var(--container-gutter) * 1.5){% endif %};
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --media-blocks-grid: {% if section.settings.stack_on_mobile or section.blocks.size <= 2 %}auto / repeat(2, minmax(0, 1fr)){% else %}auto / auto-flow 45vw{% endif %};
      }
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} {
        --media-blocks-grid: auto-flow / {% if use_carousel_split %}{% if carousel_block_index == 1 %}3fr 2fr{% else %}2fr 3fr{% endif %}{% else %}repeat({{ section.settings.items_per_row }}, minmax(0, 1fr)){% endif %};
      }
    }

    @media screen and (pointer: fine) {
      {%- for block in section.blocks -%}
        {%- if block.settings.change_color_scheme_on_hover -%}
          {%- comment -%}
          Some colors are not used in this context, so we only output the necessary variables
          {%- endcomment -%}

          {%- assign color_scheme = block.settings.color_scheme -%}

          #block-{{ block.id }} {
            transition: all 0.2s ease-in-out;
          }

          #block-{{ block.id }} .content-box__background-media {
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
          }

          #block-{{ block.id }} .link {
            transition: color 0s ease-in-out,  background-size 0.3s ease-in-out;
          }

          {%- if block.settings.image != blank -%}
            #block-{{ block.id }}:hover {
              {%- comment -%}
              On hover, this forces to re-use the same background as the initial color scheme, which avoids a flash of the destination background
              {%- endcomment -%}
              --background: {% if color_scheme.settings.background == 'rgba(0,0,0,0)' %}0 0 0 / 0{% else %}{{ color_scheme.settings.background.rgb }}{% endif %};
            }
          {%- endif -%}

          #block-{{ block.id }}:not(:hover) {
            --accent: {{ color_scheme.settings.primary_button_background.rgb }};
            --background: {% if color_scheme.settings.background == 'rgba(0,0,0,0)' %}0 0 0 / 0{% else %}{{ color_scheme.settings.background.rgb }}{% endif %};
            --background-gradient: {{ color_scheme.settings.background_gradient }};
            --text-color: {{ color_scheme.settings.text_color.rgb }};
            --border-color: {{ color_scheme.settings.text_color.rgb }} / 0.1;
            --heading-highlight-accent-color: {{ color_scheme.settings.heading_highlight_accent_color.rgb }};
            --heading-highlight-text-color: {{ color_scheme.settings.heading_highlight_text_color.rgb }};
            --button-background-primary: {{ color_scheme.settings.primary_button_background.rgb }};
            --button-text-primary: {{ color_scheme.settings.primary_button_text_color.rgb }};

            {%- liquid
              assign subheading_has_border = true
              assign subheading_has_background = true
      
              if color_scheme.settings.subheading_background == blank or color_scheme.settings.subheading_background == 'rgba(0,0,0,0)' or color_scheme.settings.subheading_background == color_scheme.settings.background
                assign subheading_has_background = false
              endif
      
              if color_scheme.settings.subheading_border_color == blank or color_scheme.settings.subheading_border_color == 'rgba(0,0,0,0)'
                assign subheading_has_border = false
              endif
            -%}
      
            --subheading-background: {% if subheading_has_background %}{{ color_scheme.settings.subheading_background.rgb }}{% else %}0 0 0 / 0.0{% endif %};
            --subheading-border: {% if subheading_has_border %}1px solid rgb({{ color_scheme.settings.subheading_border_color.rgb }}){% else %}none{% endif %};
            --subheading-text-color: {{ color_scheme.settings.subheading_text_color.rgb }};
            --subheading-has-padding: {% if subheading_has_border or subheading_has_background %}1{% else %}0{% endif %};
          }

          #block-{{ block.id }}:hover .content-box__background-media {
            opacity: 1;
          }
        {%- endif -%}
      {%- endfor -%}
    }

    /* ---------------------------------------------------------------------
       Corner radius (outer corners only)
       ------------------------------------------------------------------- */
    #shopify-section-{{ section.id }} {
      {%- comment -%}
        Auto mode scales the radius with the viewport but the floor is relative to the merchant's
        chosen corner_radius (50% of it) instead of a fixed px value. A fixed low floor (e.g. 4px)
        made the radius collapse hard on mobile viewports (1.2vw is only ~4-5px around 375-430px)
        while desktop viewports almost always hit the max, making the two look inconsistent.
      {%- endcomment -%}
      --media-blocks-corner-radius: {% if section.settings.auto_corner_radius %}clamp({{ section.settings.corner_radius | times: 0.5 | round }}px, 3vw, {{ section.settings.corner_radius }}px){% else %}{{ section.settings.corner_radius }}px{% endif %};
    }

    #shopify-section-{{ section.id }} .media-blocks__item {
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .media-blocks__item .content-box,
    #shopify-section-{{ section.id }} .media-blocks__item .content-box__background-media {
      border-radius: inherit;
      overflow: hidden;
    }

    {%- if section.settings.column_spacing == 'none' -%}
      {%- comment -%}
        No spacing between cards: they form a single continuous piece, so the radius only
        applies to the outer corners of the whole set (first item on one end, last item on
        the other), never on the touching inner edges between cards.
      {%- endcomment -%}

      /* Desktop / tablet: items laid out horizontally -> radius on the left of the first item and the right of the last item */
      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .media-blocks > *:first-child .media-blocks__item,
        #shopify-section-{{ section.id }} .media-blocks > *:first-child.media-blocks__item {
          border-top-left-radius: var(--media-blocks-corner-radius);
          border-bottom-left-radius: var(--media-blocks-corner-radius);
        }

        #shopify-section-{{ section.id }} .media-blocks > *:last-child .media-blocks__item,
        #shopify-section-{{ section.id }} .media-blocks > *:last-child.media-blocks__item {
          border-top-right-radius: var(--media-blocks-corner-radius);
          border-bottom-right-radius: var(--media-blocks-corner-radius);
        }
      }

      /* Mobile */
      @media screen and (max-width: 699px) {
        {%- if section.settings.stack_on_mobile -%}
          /* Items are stacked vertically -> radius on the top of the first item and the bottom of the last item */
          #shopify-section-{{ section.id }} .media-blocks > *:first-child .media-blocks__item,
          #shopify-section-{{ section.id }} .media-blocks > *:first-child.media-blocks__item {
            border-top-left-radius: var(--media-blocks-corner-radius);
            border-top-right-radius: var(--media-blocks-corner-radius);
          }

          #shopify-section-{{ section.id }} .media-blocks > *:last-child .media-blocks__item,
          #shopify-section-{{ section.id }} .media-blocks > *:last-child.media-blocks__item {
            border-bottom-left-radius: var(--media-blocks-corner-radius);
            border-bottom-right-radius: var(--media-blocks-corner-radius);
          }
        {%- else -%}
          /* Items still scroll horizontally on mobile -> same behavior as desktop/tablet */
          #shopify-section-{{ section.id }} .media-blocks > *:first-child .media-blocks__item,
          #shopify-section-{{ section.id }} .media-blocks > *:first-child.media-blocks__item {
            border-top-left-radius: var(--media-blocks-corner-radius);
            border-bottom-left-radius: var(--media-blocks-corner-radius);
          }

          #shopify-section-{{ section.id }} .media-blocks > *:last-child .media-blocks__item,
          #shopify-section-{{ section.id }} .media-blocks > *:last-child.media-blocks__item {
            border-top-right-radius: var(--media-blocks-corner-radius);
            border-bottom-right-radius: var(--media-blocks-corner-radius);
          }
        {%- endif -%}
      }
    {%- else -%}
      {%- comment -%}
        Any spacing (sm/md/lg) leaves a visible gap between cards, so each card reads as its
        own independent piece and gets the radius on all four of its corners.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .media-blocks__item {
        border-radius: var(--media-blocks-corner-radius);
      }
    {%- endif -%}
  </style>

  {%- assign allow_transparent_header = false -%}

  {%- if section.settings.allow_transparent_header and section.settings.subheading == blank and section.settings.title == blank and section.settings.content == blank and section.settings.add_horizontal_spacing == false and section.settings.column_spacing == 'none' -%}
    {%- assign allow_transparent_header = true -%}
  {%- endif -%}

  <div {% if allow_transparent_header %}allow-transparent-header{% endif %} class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <div class="{% if section.settings.add_horizontal_spacing %}container{% endif %} {% unless allow_transparent_header %}section-spacing{% endunless %}">
      <div class="section-stack">
        {%- if section.settings.subheading != blank or section.settings.title != blank or section.settings.content != blank -%}
          <div class="{% unless section.settings.add_horizontal_spacing %}container{% endunless %}">
            <div class="prose prose-justify-{{ section.settings.text_alignment }}">
              {%- if section.settings.subheading != blank -%}
                {%- render 'subheading', content: section.settings.subheading -%}
              {%- endif -%}

              {%- if section.settings.title != blank -%}
                {%- if section.settings.scrolling_title -%}
                  <h2 class="{{ section.settings.heading_tag }}">
                    <marquee-text speed="0.3" direction="start-to-end" class="scrolling-content bleed">
                      <span class="scrolling-content__item" style="font-size: var(--text-{{ section.settings.heading_tag }})">
                        <span class="scrolling-content__text">
                          {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_tag, html_tag: 'span', instant: true -%}
                        </span>

                        {%- if section.settings.scrolling_title_separator != 'none' -%}
                          <span class="shape shape--{{ section.settings.scrolling_title_separator }}" style="font-size: var(--text-{{ section.settings.heading_tag }})" aria-hidden="true"></span>
                        {%- endif -%}
                      </span>
                    </marquee-text>
                  </h2>
                {%- else -%}
                  {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_tag, html_tag: 'h2' -%}
                {%- endif -%}
              {%- endif -%}

              {%- if section.settings.content != blank -%}
                <div class="max-w-xs">
                  {{- section.settings.content -}}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="media-blocks {% unless section.settings.stack_on_mobile %}scroll-area bleed{% endunless %}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'image_with_text' or 'video_with_text' -%}
                {%- liquid
                  # If the merchant choose to show a color scheme on hover, we force it on mobile, so we apply the hover one by default so that
                  # it is the default one on touch devices
                  if block.settings.change_color_scheme_on_hover
                    assign color_scheme = block.settings.color_scheme_hover
                  else
                    assign color_scheme = block.settings.color_scheme
                  endif

                  assign can_make_block_clickable = true

                  if block.settings.subheading contains '</a>' or block.settings.text contains '</a>' or block.settings.title contains '</a>'
                    assign can_make_block_clickable = false
                  endif
                -%}

                {%- capture block_content -%}
                  <div class="content-box h-full min-h-{{ section.settings.mobile_block_size }} md:min-h-{{ section.settings.block_size }}">
                    {%- capture sizes_attribute -%}(max-width: 699px) 100vw, (max-width: 999px) 50vw, {{ 100.0 | divided_by: section.settings.items_per_row | round }}vw{%- endcapture -%}

                    {%- if block.settings.image != blank or block.settings.video != blank -%}
                      <div class="content-box__background-media">
                        {%- liquid
                          assign loading_attribute = nil

                          if section.index > 1 or forloop.index > 3
                            assign loading_attribute = 'lazy'
                          endif

                          if block.type == 'image_with_text' and block.settings.image != blank
                            echo block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: loading_attribute, sizes: sizes_attribute, widths: '300,400,500,600,800,1000,1200,1400,1600,1800', class: 'size-full'
                          elsif block.type == 'video_with_text' and block.settings.video != blank
                            render 'media', media: block.settings.video, autoplay: true, loop: true, controls: false, sizes: sizes_attribute
                          endif
                        -%}
                      </div>
                    {%- elsif block.settings.color_scheme.settings.background == 'rgba(0,0,0,0)' and request.design_mode or request.visual_preview_mode -%}
                      <div class="content-box__background-media">
                        {{- 'collection-apparel-1' | placeholder_svg_tag: 'block' -}}
                      </div>
                    {%- endif -%}

                    {%- liquid
                      assign top_left_content = ''
                      assign top_center_content = ''
                      assign top_right_content = ''
                      assign middle_left_content = ''
                      assign middle_center_content = ''
                      assign middle_right_content = ''
                      assign bottom_left_content = ''
                      assign bottom_center_content = ''
                      assign bottom_right_content = ''
                    -%}

                    {%- assign content_array = 'icon,subheading,heading,text,link' | split: ',' -%}

                    {%- for content_type in content_array -%}
                      {%- capture content -%}
                        {%- case content_type -%}
                          {%- when 'icon' -%}
                            {%- if block.settings.custom_icon != blank -%}
                              {%- render 'icon', image: block.settings.custom_icon, width: block.settings.icon_width, mobile_width: block.settings.mobile_icon_width -%}
                            {%- else -%}
                              {%- render 'icon' with block.settings.icon, width: block.settings.icon_width, mobile_width: block.settings.mobile_icon_width -%}
                            {%- endif -%}

                          {%- when 'subheading' -%}
                            {%- if block.settings.subheading != blank -%}
                              {%- render 'subheading', content: block.settings.subheading -%}
                            {%- endif -%}

                          {%- when 'heading' -%}
                            {%- if block.settings.title != blank -%}
                              {%- if block.settings.scrolling_title -%}
                                <p class="{{ block.settings.heading_tag }} {% if block.settings.show_text_vertically %}h-full{% else %}column-bleed{% endif %}">
                                  <marquee-text speed="0.3" direction="start-to-end" {% if block.settings.show_text_vertically %}vertical{% endif %} class="scrolling-content {% if block.settings.show_text_vertically %}scrolling-content--vertical h-full{% endif %}">
                                    <span class="scrolling-content__item" style="font-size: var(--text-{{ block.settings.heading_tag }})">
                                      <span class="scrolling-content__text">
                                        {%- render 'heading', content: block.settings.title, style: block.settings.heading_tag, html_tag: 'span', instant: true, show_vertically: block.settings.show_text_vertically -%}
                                      </span>

                                      {%- if block.settings.scrolling_title_separator != 'none' -%}
                                        <span class="shape shape--{{ block.settings.scrolling_title_separator }}" style="font-size: var(--text-{{ block.settings.heading_tag }})" aria-hidden="true"></span>
                                      {%- endif -%}
                                    </span>
                                  </marquee-text>
                                </p>
                              {%- else -%}
                                {%- render 'heading', content: block.settings.title, style: block.settings.heading_tag, show_vertically: block.settings.show_text_vertically -%}
                              {%- endif -%}
                            {%- endif -%}

                          {%- when 'text' -%}
                            {% if block.settings.text != blank %}
                              <div class="max-w-sm">
                                {{- block.settings.text -}}
                              </div>
                            {%- endif -%}

                          {%- when 'link' -%}
                            {%- liquid
                              if block.settings.link_text != blank
                                if can_make_block_clickable
                                  render 'button', content: block.settings.link_text, type: 'button', style: block.settings.button_style
                                else
                                  render 'button', content: block.settings.link_text, href: block.settings.link_url, style: block.settings.button_style
                                endif
                              endif
                            -%}
                        {%- endcase -%}
                      {%- endcapture -%}

                      {%- capture content_position_key -%}{{ content_type }}_position{%- endcapture -%}

                      {%- if content_type == 'heading' and block.settings.scrolling_title and block.settings.show_text_vertically -%}
                        <div class="row-span-full justify-self-{% if block.settings[content_position_key] contains 'left' %}start{% elsif block.settings[content_position_key] contains 'right' %}end{% else %}center{% endif %}">
                          {{ content }}
                        </div>
                      {%- else -%}
                        {%- liquid
                          case block.settings[content_position_key]
                            when 'top_left'
                              assign top_left_content = top_left_content | append: content
                            when 'top_center'
                              assign top_center_content = top_center_content | append: content
                            when 'top_right'
                              assign top_right_content = top_right_content | append: content
                            when 'middle_left'
                              assign middle_left_content = middle_left_content | append: content
                            when 'middle_center'
                              assign middle_center_content = middle_center_content | append: content
                            when 'middle_right'
                              assign middle_right_content = middle_right_content | append: content
                            when 'bottom_left'
                              assign bottom_left_content = bottom_left_content | append: content
                            when 'bottom_center'
                              assign bottom_center_content = bottom_center_content | append: content
                            when 'bottom_right'
                              assign bottom_right_content = bottom_right_content | append: content
                          endcase
                        -%}
                      {%- endif -%}
                    {%- endfor -%}

                    <div class="placement-grid">
                      {% if top_left_content != blank %}
                        <div class="align-self-start">
                          <div class="prose prose-justify-start">
                            {{- top_left_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if top_center_content != blank %}
                        <div class="align-self-start">
                          <div class="prose prose-justify-center">
                            {{- top_center_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if top_right_content != blank %}
                        <div class="align-self-start">
                          <div class="prose prose-justify-end">
                            {{- top_right_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if middle_left_content != blank %}
                        <div class="align-self-center">
                          <div class="prose prose-justify-start">
                            {{- middle_left_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if middle_center_content != blank %}
                        <div class="align-self-center">
                          <div class="prose prose-justify-center">
                            {{- middle_center_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if middle_right_content != blank %}
                        <div class="align-self-center">
                          <div class="prose prose-justify-end">
                            {{- middle_right_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if bottom_left_content != blank %}
                        <div class="align-self-end">
                          <div class="prose prose-justify-start">
                            {{- bottom_left_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if bottom_center_content != blank %}
                        <div class="align-self-end">
                          <div class="prose prose-justify-center">
                            {{- bottom_center_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if bottom_right_content != blank %}
                        <div class="align-self-end">
                          <div class="prose prose-justify-end">
                            {{- bottom_right_content -}}
                          </div>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endcapture -%}

                <media-block class="h-full">
                  {%- if can_make_block_clickable and block.settings.link_url != blank -%}
                    <a href="{{ block.settings.link_url }}" id="block-{{ block.id }}" class="media-blocks__item {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} @container/content-box color-scheme color-scheme--{{ color_scheme.id }}" {{ block.shopify_attributes }}>
                      {{- block_content -}}
                    </a>
                  {%- else -%}
                    <div id="block-{{ block.id }}" class="media-blocks__item {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} @container/content-box color-scheme color-scheme--{{ color_scheme.id }}" {{ block.shopify_attributes }}>
                      {{- block_content -}}
                    </div>
                  {%- endif -%}
                </media-block>

              {%- when 'empty_item' -%}
                <div class="media-blocks__item color-scheme color-scheme--{{ block.settings.color_scheme.id }} md-max:hidden" {{ block.shopify_attributes }}>
                  <!-- Empty item -->
                </div>

              {%- when 'carousel' -%}
                {%- liquid
                  assign carousel_slide_count = 0

                  for i in (1..8)
                    capture image_key
                      echo 'image_'
                      echo i
                    endcapture

                    capture video_key
                      echo 'video_'
                      echo i
                    endcapture

                    capture heading_key
                      echo 'heading_'
                      echo i
                    endcapture

                    capture text_key
                      echo 'text_'
                      echo i
                    endcapture

                    assign slide_image = block.settings[image_key]
                    assign slide_video = block.settings[video_key]
                    assign slide_heading = block.settings[heading_key]
                    assign slide_text = block.settings[text_key]

                    if slide_image != blank or slide_video != blank or slide_heading != blank or slide_text != blank
                      assign carousel_slide_count = carousel_slide_count | plus: 1
                    endif
                  endfor

                  # Video width (mobile + desktop): only meaningful when the relevant block size setting
                  # is fixed (mobile_block_size / block_size 'auto' sizes itself off the video/image's own
                  # ratio already, and 'none' means the feature is off entirely). Both the aspect-ratio and
                  # the target height are resolved to explicit, deterministic CSS values (not intrinsic
                  # sizing like max-content or a bare min-height) precisely so the derived width is exact,
                  # instead of relying on any browser auto-sizing edge case. Mobile and desktop are resolved
                  # independently since they read from mobile_block_size/block_size respectively, and one
                  # can be 'auto' while the other isn't.
                  #
                  # The clamp() values below are copied from the theme's own min-h-* utility classes
                  # (assets/theme.css) that mobile_block_size/block_size already render as: the unprefixed
                  # ones (35/45/55vmax) for mobile_block_size, the md: breakpoint ones (40/50/60vmax, used
                  # from 700px up, which is also where this carousel's own grid switches) for block_size.
                  assign carousel_video_aspect_ratio = nil
                  assign carousel_video_mobile_box_height = nil
                  assign carousel_video_box_height = nil

                  if section.settings.carousel_video_width != 'none'
                    case section.settings.carousel_video_width
                      when '4-5'
                        assign carousel_video_aspect_ratio = '4 / 5'
                        assign carousel_video_width_ratio = 0.8
                      when '3-4'
                        assign carousel_video_aspect_ratio = '3 / 4'
                        assign carousel_video_width_ratio = 0.75
                      when '9-16'
                        assign carousel_video_aspect_ratio = '9 / 16'
                        assign carousel_video_width_ratio = 0.5625
                    endcase

                    # The carousel block's own slides read block.settings.mobile_block_size ("Mobile
                    # image height") for their mobile height, NOT section.settings.mobile_block_size
                    # (a separate, section-wide setting only used by the image_with_text/video_with_text
                    # blocks) - so that's the one to match here too.
                    if block.settings.mobile_block_size != 'auto'
                      case block.settings.mobile_block_size
                        when 'sm'
                          assign carousel_video_mobile_box_height = 'clamp(15rem, 35vmax, 25rem)'
                        when 'md'
                          assign carousel_video_mobile_box_height = 'clamp(20rem, 45vmax, 35rem)'
                        when 'lg'
                          assign carousel_video_mobile_box_height = 'clamp(25rem, 55vmax, 45rem)'
                        when 'fill'
                          assign carousel_video_mobile_box_height = 'calc(100svh - var(--sticky-area-height, 0px))'
                      endcase
                    endif

                    if section.settings.block_size != 'auto'
                      case section.settings.block_size
                        when 'sm'
                          assign carousel_video_box_height = 'clamp(15rem, 40vmax, 25rem)'
                        when 'md'
                          assign carousel_video_box_height = 'clamp(20rem, 50vmax, 35rem)'
                        when 'lg'
                          assign carousel_video_box_height = 'clamp(25rem, 60vmax, 45rem)'
                        when 'fill'
                          assign carousel_video_box_height = 'calc(100svh - var(--sticky-area-height, 0px))'
                      endcase
                    endif
                  endif
                -%}

                <style>
                  #carousel-{{ block.id }} {
                    grid: auto / auto-flow {% if carousel_video_mobile_box_height %}calc({{ carousel_video_mobile_box_height }} * {{ carousel_video_width_ratio }}){% else %}85%{% endif %};
                    gap: .75rem;
                    display: grid;
                  }

                  {%- comment -%}
                    The column width above is the same calc() as this height * ratio, computed explicitly
                    instead of relying on intrinsic/max-content sizing - so image-only slides in the same
                    carousel (which don't match :has(video-media) below and so keep their existing
                    min-height) still land in a column of the correct, exact width, rather than risking
                    collapsing to zero under max-content sizing.
                  {%- endcomment -%}
                  {%- if carousel_video_mobile_box_height -%}
                    #carousel-{{ block.id }} .content-box:has(video-media) {
                      height: {{ carousel_video_mobile_box_height }};
                      aspect-ratio: {{ carousel_video_aspect_ratio }};
                      width: auto;
                    }
                  {%- endif -%}

                  @media screen and (min-width: 700px) {
                    #carousel-{{ block.id }} {
                      grid: auto / auto-flow {% if carousel_video_box_height %}calc({{ carousel_video_box_height }} * {{ carousel_video_width_ratio }}){% else %}45%{% endif %};
                    }

                    {%- if carousel_video_box_height -%}
                      #carousel-{{ block.id }} .content-box:has(video-media) {
                        height: {{ carousel_video_box_height }};
                        aspect-ratio: {{ carousel_video_aspect_ratio }};
                        width: auto;
                      }
                    {%- endif -%}
                  }

                  #carousel-{{ block.id }} video-media > img,
                  #carousel-{{ block.id }} video-media > video {
                    opacity: 1 !important;
                  }

                  #carousel-{{ block.id }} video-media > img {
                    z-index: 1;
                    transition: opacity .3s ease;
                  }

                  #carousel-{{ block.id }} video-media > img.carousel-video-poster-hidden {
                    opacity: 0 !important;
                    pointer-events: none;
                  }

                  /* If autoplay is blocked by the browser, the shared video-media component falls back to
                     the native play button (sets [suspended] + controls) so playback can still be started
                     manually. Our poster image would otherwise sit on top of it and hide/block taps. */
                  #carousel-{{ block.id }} video-media[suspended] > img {
                    opacity: 0 !important;
                    pointer-events: none;
                  }

                  #carousel-{{ block.id }} .carousel-video-tap-to-play {
                    cursor: pointer;
                  }

                  /* Root cause of controls inheriting Color Scheme colors: .circle-button (theme-wide,
                     assets/theme.css) paints a scheme-derived tint via its own ::before pseudo-element on
                     top of whatever background we set, and shifts icon `color` on hover via a separate
                     scheme-derived color-mix(). Both are killed below for our 3 buttons specifically, the
                     same way the theme already opts individual variants out via ".circle-button--outline:
                     before { content: none; }" - reusing that existing pattern rather than patching around
                     it with extra specificity. From here on, background/border/icon color come exclusively
                     from the --control-button-* variables (Global > Controls). */
                  {%- comment -%}
                    Scoped to #carousel-wrapper-{{ block.id }} (the shared ancestor of both the slide
                    track and the progress bar row), NOT #carousel-{{ block.id }} (the <product-list>
                    itself): in "next to the progress bar" mode the controls group is moved outside the
                    <product-list> entirely (see the script below), so scoping to the narrower ID would
                    silently stop matching the moment it's relocated.
                  {%- endcomment -%}
                  #carousel-wrapper-{{ block.id }} .carousel-video-sound-toggle:before,
                  #carousel-wrapper-{{ block.id }} .carousel-video-pause-toggle:before,
                  #carousel-wrapper-{{ block.id }} .carousel-video-product-link:before {
                    content: none;
                  }

                  #carousel-wrapper-{{ block.id }} .carousel-video-sound-toggle,
                  #carousel-wrapper-{{ block.id }} .carousel-video-pause-toggle,
                  #carousel-wrapper-{{ block.id }} .carousel-video-product-link {
                    transition: opacity 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
                  }

                  {%- comment -%}
                    Base position (top-right, matches "top" layout exactly). Declared before the
                    device/layout rules below on purpose: the "center" override further down has the same
                    specificity (#id .class), so it only wins because it comes later in the cascade.
                  {%- endcomment -%}
                  #carousel-wrapper-{{ block.id }} .carousel-video-controls {
                    width: auto;
                    height: auto;
                    position: absolute;
                    inset-block-start: 1rem;
                    inset-inline-end: 1rem;
                    z-index: 1;
                  }

                  {%- comment -%}
                  Always visible, no hover/tap-to-reveal, no auto-hide: nothing autoplays anymore, so there's
                  no playing video to hide these behind - the visitor needs to see the play button right away
                  to know how to start it.
                  {%- endcomment -%}
                  #carousel-wrapper-{{ block.id }} .carousel-video-sound-toggle,
                  #carousel-wrapper-{{ block.id }} .carousel-video-pause-toggle,
                  #carousel-wrapper-{{ block.id }} .carousel-video-product-link {
                    opacity: 1;
                    pointer-events: auto;
                  }

                  {%- if section.settings.controls_position == 'progress_bar' -%}
                    {%- assign desktop_controls_position = section.settings.desktop_controls_position | default: 'top_right' -%}

                    {%- if desktop_controls_position == 'center' -%}
                      @media screen and (pointer: fine) {
                        #carousel-wrapper-{{ block.id }} .carousel-video-controls {
                          inset-block-start: 50%;
                          inset-inline-end: auto;
                          inset-inline-start: 50%;
                          transform: translate(-50%, -50%);
                        }
                      }
                    {%- endif -%}

                    {%- comment -%}
                    Desktop never moves controls into the slot (see script below), so the slot is always
                    empty here - hide it outright so it stops taking up gap/space and the progress bar's own
                    flex-grow fills 100% of the row, exactly like before this layout existed.
                    {%- endcomment -%}
                    @media screen and (pointer: fine) {
                      #carousel-controls-slot-{{ block.id }} {
                        display: none;
                      }
                    }

                    {%- comment -%}
                    Mobile is the only device that relocates the controls group into the slot (see script
                    below), so it is the only one that needs to hide it at its original, overlaid-on-video
                    position and only show it once it is an actual descendant of the slot.
                    {%- endcomment -%}
                    @media screen and (pointer: coarse) {
                      #carousel-wrapper-{{ block.id }} .carousel-video-controls {
                        display: none;
                      }

                      #carousel-controls-slot-{{ block.id }} .carousel-video-controls {
                        display: flex;
                        position: static;
                        inset: auto;
                      }
                    }
                  {%- endif -%}

                  @media screen and (pointer: fine) {
                    #carousel-wrapper-{{ block.id }} .carousel-video-pause-toggle:not([disabled]):hover,
                    #carousel-wrapper-{{ block.id }} .carousel-video-sound-toggle:not([disabled]):hover,
                    #carousel-wrapper-{{ block.id }} .carousel-video-product-link:not([disabled]):hover {
                      background: var(--control-button-hover-background-color, var(--control-button-background-color, #333333));
                      color: var(--control-button-icon-color, #ffffff);
                    }
                  }

                  /* Text mode reuses the theme's body text styling as-is (no independent typography). */
                  #carousel-wrapper-{{ block.id }} .carousel-video-product-link__text {
                    font: var(--text-font-style) var(--text-font-weight) var(--text-base) / var(--text-line-height) var(--text-font-family);
                    text-transform: var(--text-transform);
                    letter-spacing: var(--text-letter-spacing);
                    white-space: nowrap;
                  }

                  {%- if section.settings.controls_position == 'progress_bar' and carousel_slide_count > 1 -%}
                    {%- comment -%}
                      Comprar stays hidden in this layout on both devices (same element, same JS, just not
                      rendered visually). Controls sit on the left, progress bar fills the rest on the
                      right, on mobile - same two flex children as always, just reordered visually via the
                      standard flexbox `order` property, not duplicated markup.
                    {%- endcomment -%}
                    #carousel-wrapper-{{ block.id }} .carousel-video-product-link {
                      display: none;
                    }

                    #carousel-wrapper-{{ block.id }} .progress-bar.grow {
                      order: 2;
                    }

                    #carousel-controls-slot-{{ block.id }} {
                      order: 1;
                    }
                  {%- endif -%}

                  {%- comment -%}
                  This lightbox never moves the video/photo element into itself - it only toggles a class on
                  the SAME element already sitting in its slide (see the script below). Moving a live,
                  playing <video> across parents kept surfacing new problems: the browser re-buffering it (so
                  it looked stuck on a solid color or took a long time to resume), video-media's own [loaded]/
                  [playing] attributes going stale, and its built-in one-time "click to play" listener firing
                  a second time and colliding with the move. None of that exists if the element never changes
                  parent - only its own position/size, via CSS, when .is-lightbox-expanded is toggled.

                  #media-lightbox-{{ block.id }} itself is only used to hide/show the backdrop and the
                  close/prev/next buttons together via one [hidden] toggle - it carries no styling of its own
                  beyond the theme's own .contents utility (class="contents" below), which is exactly what
                  keeps it that way: "zero-height grid item" only holds because every current child
                  (backdrop, close, prev, next) is position: fixed and so never becomes a real grid item once
                  hoisted - a future normally-flowing child added here (eg. a slide counter) would become one,
                  inline underneath the carousel, and reintroduce the same row-gap bug this fixes. Without
                  .contents at all, showing the wrapper turns IT into that zero-height grid item of
                  #carousel-wrapper-{{ block.id }} (.v-stack.gap-4), picking up a full row-gap around it that
                  grows the carousel's height on every open and shrinks it back on close.
                  display: contents also means it can never gain a stacking context of its own the way
                  position: fixed would - if it did, the close/prev/next buttons' z-index would only be
                  compared against their siblings INSIDE that context, never able to outrank
                  .is-lightbox-expanded media, which lives outside it entirely, no matter how high a z-index
                  the buttons themselves declare. [hidden] doesn't need its own rule here: theme.css already
                  sets it to `display: none !important`, which overrides .contents regardless of specificity.
                  {%- endcomment -%}
                  #media-lightbox-{{ block.id }} .media-lightbox__backdrop {
                    background: rgb(var(--background));
                    z-index: 998;
                    position: fixed;
                    inset: 0;
                  }

                  {%- comment -%}
                  .content-box > * (theme.css) sets isolation: isolate on .content-box__background-media,
                  which traps any z-index/position: fixed inside it to compete only within that local
                  stacking context - it would never be able to render above anything outside .content-box no
                  matter how high its own z-index is. This is the one ancestor between the video and the top
                  of the page with that trap (checked .content-box, .snap-start, product-list,
                  .media-blocks__item and .shopify-section - none of them isolate), so cancelling it here,
                  only while something inside is expanded, is enough to let the fixed media escape correctly.
                  {%- endcomment -%}
                  #shopify-section-{{ section.id }} .content-box__background-media:has(.is-lightbox-expanded) {
                    isolation: auto;
                  }

                  {%- comment -%}
                  Drawer-style framing: the expanded media is centered with padding on every side (same
                  tokens .drawer::part(body) uses) instead of filling the screen edge to edge, sized to fit
                  within that padded area without cropping, and rounded to match the carousel's own corners.
                  {%- endcomment -%}
                  #shopify-section-{{ section.id }} video-media.is-lightbox-expanded,
                  #shopify-section-{{ section.id }} img.is-lightbox-expanded {
                    position: fixed;
                    z-index: 999;
                    inset-block-start: 50%;
                    inset-inline-start: 50%;
                    translate: -50% -50%;
                    width: auto;
                    height: auto;
                    max-width: 96vw;
                    max-height: 96vh;
                    border-radius: var(--media-blocks-corner-radius);
                  }

                  #shopify-section-{{ section.id }} video-media.is-lightbox-expanded video {
                    border-radius: inherit;
                  }

                  #shopify-section-{{ section.id }} img.is-lightbox-expanded {
                    object-fit: contain;
                  }

                  @media screen and (max-width: 999px) {
                    #shopify-section-{{ section.id }} video-media.is-lightbox-expanded,
                    #shopify-section-{{ section.id }} img.is-lightbox-expanded {
                      max-width: calc(100vw - 2 * var(--drawer-body-padding-inline, min(2rem, var(--container-gutter))));
                      max-height: calc(100vh - 2 * var(--drawer-body-padding-block, min(2rem, var(--container-gutter))));
                    }
                  }

                  #media-lightbox-{{ block.id }} .media-lightbox__close {
                    background: var(--close-control-background-color, rgb(var(--button-background-primary)));
                    border: 1px solid var(--close-control-border-color, rgb(var(--border-color)));
                    color: var(--close-control-icon-color, rgb(var(--button-text-primary)));
                    width: var(--control-button-size, 1.75rem);
                    height: var(--control-button-size, 1.75rem);
                    border-radius: 100%;
                    z-index: 1000;
                    place-content: center;
                    display: grid;
                    position: fixed;
                    inset-block-start: 1rem;
                    inset-inline-end: 1rem;
                  }

                  {%- comment -%}
                  Overrides circle-button--xl's own --button-size (2.5rem/3rem) so close/prev/next all match
                  the same --control-button-size (Theme settings > Global > Controls) the play/pause/sound
                  buttons already use, instead of each button picking its size from a different scale.
                  {%- endcomment -%}
                  #media-lightbox-{{ block.id }} .media-lightbox__prev,
                  #media-lightbox-{{ block.id }} .media-lightbox__next {
                    width: var(--control-button-size, 1.75rem);
                    height: var(--control-button-size, 1.75rem);
                    z-index: 1000;
                    position: fixed;
                    inset-block-start: 50%;
                    translate: 0 -50%;
                  }

                  #media-lightbox-{{ block.id }} .media-lightbox__prev {
                    inset-inline-start: 1rem;
                  }

                  #media-lightbox-{{ block.id }} .media-lightbox__next {
                    inset-inline-end: 1rem;
                  }

                  {%- comment -%}
                  product-zoom-button (theme.css) inherits currentColor and has a negative inset-inline-end
                  meant to slightly overhang a card's edge - here it sits inside .content-box's own
                  overflow: hidden, so that negative offset clips it off-center instead. Pinning both fixes
                  it for this carousel without touching the shared rule product-gallery still uses as-is.
                  {%- endcomment -%}
                  #carousel-wrapper-{{ block.id }} .product-zoom-button {
                    color: #fff;
                    inset-inline-end: 1rem;
                  }

                  {%- comment -%}
                  The video's own sound/pause toggles stay exactly where they are in the DOM (same as the
                  video itself) - this just switches them from "absolute, relative to their own .content-box"
                  to "fixed, relative to the viewport" so they land near the bottom-right of the expanded
                  video instead of the small carousel thumbnail. display: flex overrides the touch +
                  progress_bar layout's display: none (that rule expects this group to only ever be visible
                  once relocated into #carousel-controls-slot-{{ block.id }}, which doesn't apply here).
                  {%- endcomment -%}
                  #shopify-section-{{ section.id }} .carousel-video-controls.is-lightbox-expanded {
                    opacity: 1 !important;
                    pointer-events: auto !important;
                    display: flex !important;
                    position: fixed !important;
                    z-index: 999;
                    inset-block-end: var(--drawer-body-padding-block, min(2rem, var(--container-gutter)));
                    inset-inline-end: var(--drawer-body-padding-inline, min(2rem, var(--container-gutter)));
                    inset-block-start: auto;
                  }
                </style>

                <div class="media-blocks__item {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }}" style="padding: min(1.25rem, var(--container-gutter));" {{ block.shopify_attributes }}>
                  <div class="v-stack gap-4" id="carousel-wrapper-{{ block.id }}">
                    <div style="border-radius: var(--media-blocks-corner-radius); overflow: hidden;">
                    <product-list id="carousel-{{ block.id }}" cell-selector=".snap-start" class="scroll-area snap-x">
                      {%- liquid
                        # Matches the order cells actually render in below (only slides with content get one),
                        # so it lines up with the dataSource array the lightbox script builds from
                        # carousel.cells further down - both walk the same cells in the same order.
                        assign lightbox_slide_index = 0
                      -%}
                      {%- for i in (1..8) -%}
                        {%- capture image_key -%}image_{{ i }}{%- endcapture -%}
                        {%- capture video_key -%}video_{{ i }}{%- endcapture -%}
                        {%- capture product_key -%}product_{{ i }}{%- endcapture -%}
                        {%- capture heading_key -%}heading_{{ i }}{%- endcapture -%}
                        {%- capture text_key -%}text_{{ i }}{%- endcapture -%}

                        {%- assign slide_image = block.settings[image_key] -%}
                        {%- assign slide_video = block.settings[video_key] -%}
                        {%- assign slide_product = block.settings[product_key] -%}
                        {%- assign slide_heading = block.settings[heading_key] -%}
                        {%- assign slide_text = block.settings[text_key] -%}

                        {%- if slide_image != blank or slide_video != blank or slide_heading != blank or slide_text != blank -%}
                          <div class="snap-start">
                            <div class="content-box h-full min-h-{{ block.settings.mobile_block_size }} md:min-h-{{ section.settings.block_size }}" style="border-radius: var(--media-blocks-corner-radius); overflow: hidden;">
                              <div class="content-box__background-media {% if slide_video != blank %}carousel-video-tap-to-play{% endif %}">
                                {%- if slide_video != blank -%}
                                  {%- render 'media', media: slide_video, autoplay: false, muted: true, controls: false, show_play_button: false, playsinline: true, sizes: '85vw' -%}

                                  {%- capture control_button_style -%}
                                    width: var(--control-button-size, 1.75rem); height: var(--control-button-size, 1.75rem); background: var(--control-button-background-color, #000000); border: var(--control-button-border-width, 1px) solid var(--control-button-border-color, #000000); border-radius: var(--control-button-border-radius, 100%); color: var(--control-button-icon-color, #ffffff);
                                  {%- endcapture -%}

                                  {%- assign show_product_button = false -%}

                                  {%- if block.settings.show_product_button and slide_product != blank -%}
                                    {%- assign show_product_button = true -%}

                                    {%- capture product_button_style -%}
                                      height: var(--control-button-size, 1.75rem); background: var(--control-button-background-color, #000000); border: var(--control-button-border-width, 1px) solid var(--control-button-border-color, #000000); border-radius: var(--control-button-border-radius, 100%); color: var(--control-button-icon-color, #ffffff); {% if block.settings.product_button_type == 'text' %}width: auto; padding-inline: 0.75rem;{% else %}width: var(--control-button-size, 1.75rem);{% endif %}
                                    {%- endcapture -%}
                                  {%- endif -%}

                                  <div class="h-stack gap-2 carousel-video-controls">
                                    {%- if show_product_button -%}
                                      <a href="{{ slide_product.url }}" class="carousel-video-product-link circle-button" style="{{ product_button_style }}">
                                        {%- if block.settings.product_button_type == 'text' -%}
                                          <span class="carousel-video-product-link__text">{{ block.settings.product_button_text | default: slide_product.title }}</span>
                                        {%- else -%}
                                          <span class="sr-only">{{ block.settings.product_button_text | default: slide_product.title }}</span>
                                          {%- render 'icon' with 'cart', width: 14 -%}
                                        {%- endif -%}
                                      </a>
                                    {%- endif -%}

                                    <button type="button" class="carousel-video-sound-toggle circle-button" style="{{ control_button_style }}">
                                      <span class="sr-only">{{ 'general.accessibility.toggle_autoplay' | t }}</span>
                                      {%- render 'icon' with 'volume-off', width: 14, class: 'carousel-video-sound-off-icon' -%}
                                      {%- render 'icon' with 'volume', width: 14, class: 'carousel-video-sound-icon hidden' -%}
                                    </button>

                                    <button type="button" class="carousel-video-pause-toggle circle-button" style="{{ control_button_style }}">
                                      <span class="sr-only">{{ 'general.accessibility.toggle_autoplay' | t }}</span>
                                      {%- render 'icon' with 'slideshow-pause', width: 14, class: 'carousel-video-pause-icon hidden' -%}
                                      {%- render 'icon' with 'slideshow-play', width: 14, class: 'carousel-video-play-icon' -%}
                                    </button>
                                  </div>
                                {%- elsif slide_image != blank -%}
                                  {%- render 'media' with slide_image, sizes: '85vw', class: 'image-cover' -%}
                                {%- else -%}
                                  {{- 'hero-apparel-1' | placeholder_svg_tag: 'size-full' -}}
                                {%- endif -%}

                                {%- if slide_video != blank or slide_image != blank -%}
                                  <open-lightbox-button class="block" aria-controls="carousel-{{ block.id }}" image-index="{{ lightbox_slide_index }}">
                                    <button type="button" class="product-zoom-button">
                                      {%- render 'icon' with 'zoom-plus', width: 16 -%}
                                      <span class="product-zoom-button__label">{{ 'product.gallery.zoom' | t }}</span>
                                    </button>
                                  </open-lightbox-button>
                                {%- endif -%}
                              </div>

                              {%- if slide_heading != blank or slide_text != blank -%}
                                <div class="place-self-center" style="max-width: 30rem">
                                  <div class="prose prose-justify-center">
                                    {%- if slide_heading != blank -%}
                                      {%- render 'heading', content: slide_heading, style: 'h3', html_tag: 'h3' -%}
                                    {%- endif -%}

                                    {%- if slide_text != blank -%}
                                      <div>{{ slide_text }}</div>
                                    {%- endif -%}
                                  </div>
                                </div>
                              {%- endif -%}
                            </div>
                          </div>
                          {%- assign lightbox_slide_index = lightbox_slide_index | plus: 1 -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </product-list>
                    </div>

                    <div id="media-lightbox-{{ block.id }}" class="contents" hidden>
                      <div class="media-lightbox__backdrop"></div>

                      <button type="button" class="media-lightbox__close" aria-label="{{ 'general.accessibility.close' | t }}">
                        {%- render 'icon' with 'close', width: 10 -%}
                      </button>

                      {%- if carousel_slide_count > 1 -%}
                        <button type="button" class="media-lightbox__prev circle-button" aria-label="{{ 'general.accessibility.previous' | t }}">
                          {%- render 'icon' with 'arrow-left', width: 9, direction_aware: true -%}
                        </button>

                        <button type="button" class="media-lightbox__next circle-button" aria-label="{{ 'general.accessibility.next' | t }}">
                          {%- render 'icon' with 'arrow-right', width: 9, direction_aware: true -%}
                        </button>
                      {%- endif -%}
                    </div>

                    {%- if carousel_slide_count > 1 -%}
                      {%- if section.settings.controls_position == 'progress_bar' -%}
                        <div class="h-stack gap-4">
                          <progress-bar track-scroll-target="carousel-{{ block.id }}" class="progress-bar grow"></progress-bar>
                          <div class="h-stack gap-2" id="carousel-controls-slot-{{ block.id }}"></div>
                        </div>
                      {%- else -%}
                        <progress-bar track-scroll-target="carousel-{{ block.id }}" class="progress-bar w-full"></progress-bar>
                      {%- endif -%}
                    {%- endif -%}

                    {%- if carousel_slide_count >= 1 -%}
                      <script>
                        (function() {
                          var carousel = document.getElementById('carousel-{{ block.id }}');

                          if (!carousel) {
                            return;
                          }

                          customElements.whenDefined('product-list').then(function() {
                          var isTouchDevice = window.matchMedia('(pointer: coarse)').matches;
                          var controlsAtProgressBar = {% if section.settings.controls_position == 'progress_bar' %}true{% else %}false{% endif %};

                          // Only mobile relocates the selected slide's controls group into the slot next to
                          // the progress bar (the exact same DOM node, never cloned; every other slide's
                          // group is moved back to its own slide - see scheduleAdvance below). Desktop never
                          // does this: its controls stay overlaid on their own video at all times.
                          var controlsSlot = (controlsAtProgressBar && isTouchDevice) ? document.getElementById('carousel-controls-slot-{{ block.id }}') : null;

                          // Captured once, up front, while every controls group is still in its original
                          // slide - NOT re-queried via cell.querySelector() on every scheduleAdvance() call,
                          // since once a group has been moved into the slot it is no longer a descendant of
                          // its cell and would silently fail to be found again (leaving stale duplicates
                          // behind instead of being moved back home).
                          var controlsEntries = controlsSlot ? carousel.cells.map(function(cell) {
                            return {
                              cell: cell,
                              group: cell.querySelector('.carousel-video-controls'),
                              home: cell.querySelector('.content-box__background-media')
                            };
                          }) : [];

                          // Nothing autoplays anymore, so this only has two jobs left: pause whatever video
                          // the visitor is swiping away from, and (on mobile, progress-bar layout) relocate
                          // the newly selected slide's controls group into the slot next to the progress bar.
                          function scheduleAdvance() {
                            carousel.cells.forEach(function(cell) {
                              if (cell !== carousel.selectedCell) {
                                // Go through the <video-media> wrapper's own pause(), not the raw <video>
                                // tag directly: the wrapper tracks its own "playing" state and only the
                                // wrapper's play()/pause() keep that state (and the "loaded" attribute
                                // driving its CSS) in sync.
                                var otherVideoMedia = cell.querySelector('video-media');
                                if (otherVideoMedia) {
                                  otherVideoMedia.pause();
                                }
                              }
                            });

                            controlsEntries.forEach(function(entry) {
                              if (!entry.group) {
                                return;
                              }

                              if (entry.cell === carousel.selectedCell) {
                                controlsSlot.appendChild(entry.group);
                              } else if (entry.home) {
                                entry.home.appendChild(entry.group);
                              }
                            });
                          }

                          // Tracks the mute-setter of every video in this carousel, so that unmuting one can
                          // mute every other one (only one video can have sound at a time).
                          var muteSetters = [];

                          Array.prototype.forEach.call(carousel.querySelectorAll('.content-box__background-media'), function(mediaBox) {
                            var video = mediaBox.querySelector('video');

                            if (!video) {
                              return;
                            }

                            var videoMedia = mediaBox.querySelector('video-media');
                            var pauseButton = mediaBox.querySelector('.carousel-video-pause-toggle');
                            var pauseIcon = pauseButton.querySelector('.carousel-video-pause-icon');
                            var playIcon = pauseButton.querySelector('.carousel-video-play-icon');
                            var soundButton = mediaBox.querySelector('.carousel-video-sound-toggle');
                            var poster = mediaBox.querySelector('video-media > img');

                            // pause() goes through video-media's own wrapper (not the native <video>
                            // directly): it only sets up its internal "playing" tracking (theme.js,
                            // BaseMedia/_playerTarget) the first time ITS OWN play()/pause() is called, and
                            // scheduleAdvance()/collapseCell() both call video-media.pause() elsewhere,
                            // relying on that tracking to know whether there's anything to actually pause -
                            // bypassing the wrapper here would leave them silently unable to stop a video
                            // that was only ever started from this button.
                            //
                            // Resuming goes one layer deeper, to .player.play() instead of .play(): the
                            // public play() additionally requires this.offsetParent to be non-null, which is
                            // always null while is-lightbox-expanded has this at position: fixed - the
                            // player proxy underneath runs the exact same one-time setup and playback call
                            // without that extra guard.
                            function togglePlay() {
                              if (videoMedia.playing) {
                                videoMedia.pause();
                              } else {
                                videoMedia.player.play();
                              }
                            }

                            video.addEventListener('playing', function() {
                              if (poster) {
                                poster.classList.add('carousel-video-poster-hidden');
                              }

                              pauseIcon.classList.remove('hidden');
                              playIcon.classList.add('hidden');
                            });

                            video.addEventListener('pause', function() {
                              pauseIcon.classList.add('hidden');
                              playIcon.classList.remove('hidden');
                            });

                            pauseButton.addEventListener('click', function(event) {
                              event.stopPropagation();
                              togglePlay();
                            });

                            var soundOffIcon = soundButton.querySelector('.carousel-video-sound-off-icon');
                            var soundOnIcon = soundButton.querySelector('.carousel-video-sound-icon');

                            function setMuted(muted) {
                              video.muted = muted;
                              soundOffIcon.classList.toggle('hidden', !muted);
                              soundOnIcon.classList.toggle('hidden', muted);
                            }

                            function toggleSound() {
                              var wasMuted = video.muted;

                              if (wasMuted) {
                                muteSetters.forEach(function(otherSetMuted) {
                                  if (otherSetMuted !== setMuted) {
                                    otherSetMuted(true);
                                  }
                                });
                              }

                              setMuted(!wasMuted);
                            }

                            muteSetters.push(setMuted);

                            soundButton.addEventListener('click', toggleSound);

                            // No tap-anywhere-on-the-video handler here on purpose: video-media itself
                            // (theme.js, VideoMedia#connectedCallback) already attaches its own one-time
                            // "click starts playback" listener whenever it has no autoplay attribute, which
                            // is exactly this carousel's case. Adding a second click-to-play listener here
                            // fired both on the very first tap - two near-simultaneous play() calls on the
                            // same <video>, which some browsers resolve by aborting the first one, so
                            // playback never actually started. The dedicated pause/play button below is
                            // unaffected (it's a sibling of video-media, not a descendant, so it's outside
                            // that built-in listener's reach) and already covers pause/resume on repeat taps.
                          });

                          // Only now, after every mediaBox above has its buttons queried and listeners
                          // attached, is it safe to run scheduleAdvance() for the first time: on mobile with
                          // "next to the progress bar" active, it moves the initially-selected slide's
                          // controls group into controlsSlot (desktop never does this - see controlsSlot
                          // above). Running it any earlier relocated that group out of its mediaBox before
                          // the loop above reached it, so mediaBox.querySelector('.carousel-video-pause-toggle')
                          // came back null there, threw on the next line, and aborted the whole forEach -
                          // leaving every slide after the selected one (and the selected one itself) without
                          // listeners at all.
                          carousel.addEventListener('carousel:change', scheduleAdvance);
                          scheduleAdvance();

                          // Each open-lightbox-button (rendered per slide, image-index matching this exact
                          // build order) dispatches a bubbling 'lightbox:open', caught here directly (there's
                          // no <product-gallery> wrapping this carousel to catch it instead). Opening only
                          // toggles a class on the slide's own real <video-media>/<img> (see
                          // is-lightbox-expanded in the CSS above) - it's never moved to a different parent,
                          // which is what previously caused the browser to re-buffer playing videos (showing
                          // as stuck on a solid color, or slow to resume), video-media's [loaded]/[playing]
                          // attributes going stale, and its own built-in one-time click-to-play listener
                          // colliding with the move.
                          var lightbox = document.getElementById('media-lightbox-{{ block.id }}');
                          var lightboxCloseButton = lightbox.querySelector('.media-lightbox__close');
                          var lightboxPrevButton = lightbox.querySelector('.media-lightbox__prev');
                          var lightboxNextButton = lightbox.querySelector('.media-lightbox__next');
                          var activeCell = null;
                          // Whether the video that was just expanded had sound on - carried over to whichever
                          // video next/prev bring in next, since a freshly encountered slide otherwise always
                          // starts muted (see the render 'media' call above).
                          var lightboxSoundOn = false;

                          function getCellMedia(cell) {
                            var home = cell.querySelector('.content-box__background-media');

                            return {
                              home: home,
                              videoMedia: home.querySelector('video-media'),
                              controlsGroup: home.querySelector('.carousel-video-controls'),
                              image: home.querySelector('img.image-cover')
                            };
                          }

                          // continuePlayingWithSound is only passed by next/prev, never the initial open:
                          // undefined means "leave it exactly as it already is" - nothing autoplays, so a
                          // never-played video expands paused, matching how it already looked in the
                          // carousel.
                          function expandCell(cell, continuePlayingWithSound) {
                            var media = getCellMedia(cell);

                            if (media.videoMedia) {
                              var video = media.videoMedia.querySelector('video');
                              var wasPlaying = video && !video.paused;
                              var soundButton = media.controlsGroup ? media.controlsGroup.querySelector('.carousel-video-sound-toggle') : null;

                              // Going through the real button (instead of setting video.muted directly) is
                              // what keeps its sound-on/sound-off icon and the "mute every other video"
                              // behavior in sync - both live inside that button's own click handler.
                              if (video && soundButton && continuePlayingWithSound !== undefined && !video.muted !== continuePlayingWithSound) {
                                soundButton.click();
                              }

                              // .player.play() rather than .play() - see togglePlay() above for why (same
                              // "playing" tracking needed elsewhere, same this.offsetParent guard to skip
                              // around once is-lightbox-expanded is added below).
                              if (video && (wasPlaying || continuePlayingWithSound !== undefined)) {
                                media.videoMedia.player.play();
                              }

                              media.videoMedia.classList.add('is-lightbox-expanded');

                              if (media.controlsGroup) {
                                media.controlsGroup.classList.add('is-lightbox-expanded');
                              }
                            } else if (media.image) {
                              media.image.classList.add('is-lightbox-expanded');
                            }

                            activeCell = cell;
                          }

                          // Returns whether the collapsed slide was an actually-playing video - the caller
                          // (showRelativeSlide) uses this to decide whether the next slide should resume
                          // playing too, so navigating away from a photo (or a video nobody pressed play on)
                          // never starts the next video on its own.
                          function collapseCell() {
                            if (!activeCell) {
                              return false;
                            }

                            var media = getCellMedia(activeCell);
                            var wasPlaying = false;

                            if (media.videoMedia) {
                              var video = media.videoMedia.querySelector('video');

                              if (video) {
                                wasPlaying = !video.paused;
                                lightboxSoundOn = !video.muted;
                              }

                              media.videoMedia.pause();
                              media.videoMedia.classList.remove('is-lightbox-expanded');

                              if (media.controlsGroup) {
                                media.controlsGroup.classList.remove('is-lightbox-expanded');
                              }
                            } else if (media.image) {
                              media.image.classList.remove('is-lightbox-expanded');
                            }

                            activeCell = null;

                            return wasPlaying;
                          }

                          function openLightbox(index) {
                            var cell = carousel.cells[index];

                            if (!cell) {
                              return;
                            }

                            // scheduleAdvance() runs on every carousel:change and pauses every non-selected
                            // cell's video - detaching it for as long as the lightbox is open keeps it from
                            // pausing the expanded video out from under the visitor if a carousel:change ever
                            // fired while it's up (nothing should trigger one while the lightbox blocks
                            // access to the carousel behind it, but this costs nothing to keep as a
                            // safeguard).
                            carousel.removeEventListener('carousel:change', scheduleAdvance);

                            document.documentElement.style.overflow = 'hidden';
                            lightbox.hidden = false;
                            expandCell(cell);
                          }

                          function closeLightbox() {
                            var finalCell = activeCell;

                            collapseCell();
                            lightbox.hidden = true;
                            document.documentElement.style.overflow = '';
                            carousel.addEventListener('carousel:change', scheduleAdvance);

                            // Catches up the carousel to wherever the visitor ended up navigating inside the
                            // lightbox (next/prev never move the carousel's own scroll position while it's
                            // open, see showRelativeSlide).
                            if (finalCell && finalCell !== carousel.selectedCell) {
                              carousel.select(carousel.cells.indexOf(finalCell), { instant: true });
                            }

                            scheduleAdvance();
                          }

                          function showRelativeSlide(offset) {
                            if (!activeCell) {
                              return;
                            }

                            var currentIndex = carousel.cells.indexOf(activeCell);
                            var nextCell = carousel.cells[currentIndex + offset];

                            if (!nextCell) {
                              return;
                            }

                            var wasPlaying = collapseCell();
                            expandCell(nextCell, wasPlaying ? lightboxSoundOn : undefined);
                          }

                          lightboxCloseButton.addEventListener('click', closeLightbox);

                          if (lightboxPrevButton) {
                            lightboxPrevButton.addEventListener('click', function() {
                              showRelativeSlide(-1);
                            });
                          }

                          if (lightboxNextButton) {
                            lightboxNextButton.addEventListener('click', function() {
                              showRelativeSlide(1);
                            });
                          }

                          document.addEventListener('keydown', function(event) {
                            if (event.key === 'Escape' && !lightbox.hidden) {
                              closeLightbox();
                            }
                          });

                          carousel.addEventListener('lightbox:open', function(event) {
                            openLightbox(event.detail.index || 0);
                          });
                          });
                        })();
                      </script>
                    {%- endif -%}
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

