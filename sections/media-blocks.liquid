{%- if section.blocks.size > 0 -%}
  {%- liquid
    # When the section is just a carousel block + one other block, the carousel should take 60%
    # of the row and the other block the remaining 40% (whichever column each one lands in).
    assign carousel_count = 0
    assign carousel_block_index = 0

    for block in section.blocks
      if block.type == 'carousel'
        assign carousel_count = carousel_count | plus: 1

        if carousel_block_index == 0
          assign carousel_block_index = forloop.index
        endif
      endif
    endfor

    assign use_carousel_split = false

    if carousel_count == 1 and section.blocks.size == 2
      assign use_carousel_split = true
    endif
  -%}

  <style>
    #shopify-section-{{ section.id }} {
      --media-blocks-grid: {% if section.settings.stack_on_mobile %}auto-flow / minmax(0, 1fr){% else %}auto / auto-flow 78vw{% endif %};
      {%- comment -%}
        When column_spacing is 'none' the gap is forced to 0px even if add_border is enabled.
        The original 1px gap for add_border was meant to reveal a hairline between cards, but it
        breaks the "single continuous piece" look required when there is no spacing between cards
        (it also creates a 1px seam that clashes with the shared outer corner radius). The bordered
        look (.media-blocks__item--bordered) still renders its own border on top of each card, so
        visually nothing is lost by removing the extra 1px gap.
      {%- endcomment -%}
      --media-blocks-gap: {% if section.settings.column_spacing == 'none' %}0px{% elsif section.settings.column_spacing == 'sm' %}calc(var(--container-gutter) / 2){% elsif section.settings.column_spacing == 'md' %}var(--container-gutter){% elsif section.settings.column_spacing == 'lg' %}calc(var(--container-gutter) * 1.5){% endif %};
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --media-blocks-grid: {% if section.settings.stack_on_mobile or section.blocks.size <= 2 %}auto / repeat(2, minmax(0, 1fr)){% else %}auto / auto-flow 45vw{% endif %};
      }
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} {
        --media-blocks-grid: auto-flow / {% if use_carousel_split %}{% if carousel_block_index == 1 %}3fr 2fr{% else %}2fr 3fr{% endif %}{% else %}repeat({{ section.settings.items_per_row }}, minmax(0, 1fr)){% endif %};
      }
    }

    @media screen and (pointer: fine) {
      {%- for block in section.blocks -%}
        {%- if block.settings.change_color_scheme_on_hover -%}
          {%- comment -%}
          Some colors are not used in this context, so we only output the necessary variables
          {%- endcomment -%}

          {%- assign color_scheme = block.settings.color_scheme -%}

          #block-{{ block.id }} {
            transition: all 0.2s ease-in-out;
          }

          #block-{{ block.id }} .content-box__background-media {
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
          }

          #block-{{ block.id }} .link {
            transition: color 0s ease-in-out,  background-size 0.3s ease-in-out;
          }

          {%- if block.settings.image != blank -%}
            #block-{{ block.id }}:hover {
              {%- comment -%}
              On hover, this forces to re-use the same background as the initial color scheme, which avoids a flash of the destination background
              {%- endcomment -%}
              --background: {% if color_scheme.settings.background == 'rgba(0,0,0,0)' %}0 0 0 / 0{% else %}{{ color_scheme.settings.background.rgb }}{% endif %};
            }
          {%- endif -%}

          #block-{{ block.id }}:not(:hover) {
            --accent: {{ color_scheme.settings.primary_button_background.rgb }};
            --background: {% if color_scheme.settings.background == 'rgba(0,0,0,0)' %}0 0 0 / 0{% else %}{{ color_scheme.settings.background.rgb }}{% endif %};
            --background-gradient: {{ color_scheme.settings.background_gradient }};
            --text-color: {{ color_scheme.settings.text_color.rgb }};
            --border-color: {{ color_scheme.settings.text_color.rgb }} / 0.1;
            --heading-highlight-accent-color: {{ color_scheme.settings.heading_highlight_accent_color.rgb }};
            --heading-highlight-text-color: {{ color_scheme.settings.heading_highlight_text_color.rgb }};
            --button-background-primary: {{ color_scheme.settings.primary_button_background.rgb }};
            --button-text-primary: {{ color_scheme.settings.primary_button_text_color.rgb }};

            {%- liquid
              assign subheading_has_border = true
              assign subheading_has_background = true
      
              if color_scheme.settings.subheading_background == blank or color_scheme.settings.subheading_background == 'rgba(0,0,0,0)' or color_scheme.settings.subheading_background == color_scheme.settings.background
                assign subheading_has_background = false
              endif
      
              if color_scheme.settings.subheading_border_color == blank or color_scheme.settings.subheading_border_color == 'rgba(0,0,0,0)'
                assign subheading_has_border = false
              endif
            -%}
      
            --subheading-background: {% if subheading_has_background %}{{ color_scheme.settings.subheading_background.rgb }}{% else %}0 0 0 / 0.0{% endif %};
            --subheading-border: {% if subheading_has_border %}1px solid rgb({{ color_scheme.settings.subheading_border_color.rgb }}){% else %}none{% endif %};
            --subheading-text-color: {{ color_scheme.settings.subheading_text_color.rgb }};
            --subheading-has-padding: {% if subheading_has_border or subheading_has_background %}1{% else %}0{% endif %};
          }

          #block-{{ block.id }}:hover .content-box__background-media {
            opacity: 1;
          }
        {%- endif -%}
      {%- endfor -%}
    }

    /* ---------------------------------------------------------------------
       Corner radius (outer corners only)
       ------------------------------------------------------------------- */
    #shopify-section-{{ section.id }} {
      {%- comment -%}
        Auto mode scales the radius with the viewport but the floor is relative to the merchant's
        chosen corner_radius (50% of it) instead of a fixed px value. A fixed low floor (e.g. 4px)
        made the radius collapse hard on mobile viewports (1.2vw is only ~4-5px around 375-430px)
        while desktop viewports almost always hit the max, making the two look inconsistent.
      {%- endcomment -%}
      --media-blocks-corner-radius: {% if section.settings.auto_corner_radius %}clamp({{ section.settings.corner_radius | times: 0.5 | round }}px, 3vw, {{ section.settings.corner_radius }}px){% else %}{{ section.settings.corner_radius }}px{% endif %};
    }

    #shopify-section-{{ section.id }} .media-blocks__item {
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .media-blocks__item .content-box,
    #shopify-section-{{ section.id }} .media-blocks__item .content-box__background-media {
      border-radius: inherit;
      overflow: hidden;
    }

    {%- if section.settings.column_spacing == 'none' -%}
      {%- comment -%}
        No spacing between cards: they form a single continuous piece, so the radius only
        applies to the outer corners of the whole set (first item on one end, last item on
        the other), never on the touching inner edges between cards.
      {%- endcomment -%}

      /* Desktop / tablet: items laid out horizontally -> radius on the left of the first item and the right of the last item */
      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .media-blocks > *:first-child .media-blocks__item,
        #shopify-section-{{ section.id }} .media-blocks > *:first-child.media-blocks__item {
          border-top-left-radius: var(--media-blocks-corner-radius);
          border-bottom-left-radius: var(--media-blocks-corner-radius);
        }

        #shopify-section-{{ section.id }} .media-blocks > *:last-child .media-blocks__item,
        #shopify-section-{{ section.id }} .media-blocks > *:last-child.media-blocks__item {
          border-top-right-radius: var(--media-blocks-corner-radius);
          border-bottom-right-radius: var(--media-blocks-corner-radius);
        }
      }

      /* Mobile */
      @media screen and (max-width: 699px) {
        {%- if section.settings.stack_on_mobile -%}
          /* Items are stacked vertically -> radius on the top of the first item and the bottom of the last item */
          #shopify-section-{{ section.id }} .media-blocks > *:first-child .media-blocks__item,
          #shopify-section-{{ section.id }} .media-blocks > *:first-child.media-blocks__item {
            border-top-left-radius: var(--media-blocks-corner-radius);
            border-top-right-radius: var(--media-blocks-corner-radius);
          }

          #shopify-section-{{ section.id }} .media-blocks > *:last-child .media-blocks__item,
          #shopify-section-{{ section.id }} .media-blocks > *:last-child.media-blocks__item {
            border-bottom-left-radius: var(--media-blocks-corner-radius);
            border-bottom-right-radius: var(--media-blocks-corner-radius);
          }
        {%- else -%}
          /* Items still scroll horizontally on mobile -> same behavior as desktop/tablet */
          #shopify-section-{{ section.id }} .media-blocks > *:first-child .media-blocks__item,
          #shopify-section-{{ section.id }} .media-blocks > *:first-child.media-blocks__item {
            border-top-left-radius: var(--media-blocks-corner-radius);
            border-bottom-left-radius: var(--media-blocks-corner-radius);
          }

          #shopify-section-{{ section.id }} .media-blocks > *:last-child .media-blocks__item,
          #shopify-section-{{ section.id }} .media-blocks > *:last-child.media-blocks__item {
            border-top-right-radius: var(--media-blocks-corner-radius);
            border-bottom-right-radius: var(--media-blocks-corner-radius);
          }
        {%- endif -%}
      }
    {%- else -%}
      {%- comment -%}
        Any spacing (sm/md/lg) leaves a visible gap between cards, so each card reads as its
        own independent piece and gets the radius on all four of its corners.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .media-blocks__item {
        border-radius: var(--media-blocks-corner-radius);
      }
    {%- endif -%}

    {%- comment -%}
      Top section spacing as margin instead of padding, so it reads the same way as the other
      converted sections. display: flow-root on the outer wrapper contains that margin (stops it
      collapsing through the wrapper's own top edge), so the color-scheme background still starts
      at exactly the same point as before - same value (including the padding-collapsing formula,
      still driven by --section-disable-padding-collapsing), just as margin.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} > div {
      display: flow-root;
    }

    #shopify-section-{{ section.id }} .section-spacing {
      padding-block-start: 0;
      padding-block-end: 0;
      margin-block-start: calc(var(--section-disable-padding-collapsing) * var(--section-vertical-spacing-block-start, var(--section-vertical-spacing)));
    }

    {%- comment -%}
    Info panel: heading on top, then a list of label/content rows below it, each row edited as its
    own pair of fields (label + content) so the merchant can change one row without touching the
    others - a divider is added between rows automatically, not on the first or last one.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .info-panel {
      padding: min(2.5rem, var(--container-gutter));
      gap: 2rem;
      display: grid;
    }

    #shopify-section-{{ section.id }} .info-panel__list-item {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
      gap: 1.5rem;
      padding-block: 1.25rem;
      border-block-end: 1px solid rgb(var(--border-color));
      display: grid;
    }

    #shopify-section-{{ section.id }} .info-panel__list-item:first-child {
      padding-block-start: 0;
    }

    #shopify-section-{{ section.id }} .info-panel__list-item:last-child {
      padding-block-end: 0;
      border-block-end: none;
    }

    #shopify-section-{{ section.id }} .info-panel__list-item-label {
      font-weight: 600;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .info-panel__list-item-content {
      text-align: end;
    }
  </style>

  {%- assign allow_transparent_header = false -%}

  {%- if section.settings.allow_transparent_header and section.settings.subheading == blank and section.settings.title == blank and section.settings.content == blank and section.settings.floating_media_blocks == false and section.settings.column_spacing == 'none' -%}
    {%- assign allow_transparent_header = true -%}
  {%- endif -%}

  <div {% if allow_transparent_header %}allow-transparent-header{% endif %} class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_media_blocks %} section-floating section-floating--block-end{% endif %}">
    <div class="{% unless allow_transparent_header %}section-spacing{% endunless %}">
      <div class="section-stack">
        {%- if section.settings.subheading != blank or section.settings.title != blank or section.settings.content != blank -%}
          <div class="{% unless section.settings.floating_media_blocks %}container{% endunless %}">
            <div class="prose prose-justify-{{ section.settings.text_alignment }}">
              {%- if section.settings.subheading != blank -%}
                {%- render 'subheading', content: section.settings.subheading -%}
              {%- endif -%}

              {%- if section.settings.title != blank -%}
                {%- if section.settings.scrolling_title -%}
                  <h2 class="{{ section.settings.heading_tag }}">
                    <marquee-text speed="0.3" direction="start-to-end" class="scrolling-content bleed">
                      <span class="scrolling-content__item" style="font-size: var(--text-{{ section.settings.heading_tag }})">
                        <span class="scrolling-content__text">
                          {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_tag, html_tag: 'span', instant: true -%}
                        </span>

                        {%- if section.settings.scrolling_title_separator != 'none' -%}
                          <span class="shape shape--{{ section.settings.scrolling_title_separator }}" style="font-size: var(--text-{{ section.settings.heading_tag }})" aria-hidden="true"></span>
                        {%- endif -%}
                      </span>
                    </marquee-text>
                  </h2>
                {%- else -%}
                  {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_tag, html_tag: 'h2' -%}
                {%- endif -%}
              {%- endif -%}

              {%- if section.settings.content != blank -%}
                <div class="max-w-xs">
                  {{- section.settings.content -}}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="media-blocks {% unless section.settings.stack_on_mobile %}scroll-area bleed{% endunless %}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'image_with_text' or 'video_with_text' -%}
                {%- liquid
                  # If the merchant choose to show a color scheme on hover, we force it on mobile, so we apply the hover one by default so that
                  # it is the default one on touch devices
                  if block.settings.change_color_scheme_on_hover
                    assign color_scheme = block.settings.color_scheme_hover
                  else
                    assign color_scheme = block.settings.color_scheme
                  endif

                  assign can_make_block_clickable = true

                  if block.settings.subheading contains '</a>' or block.settings.text contains '</a>' or block.settings.title contains '</a>'
                    assign can_make_block_clickable = false
                  endif
                -%}

                {%- capture block_content -%}
                  <div class="content-box h-full min-h-{{ section.settings.mobile_block_size }} md:min-h-{{ section.settings.block_size }}">
                    {%- capture sizes_attribute -%}(max-width: 699px) 100vw, (max-width: 999px) 50vw, {{ 100.0 | divided_by: section.settings.items_per_row | round }}vw{%- endcapture -%}

                    {%- if block.settings.image != blank or block.settings.video != blank -%}
                      <div class="content-box__background-media">
                        {%- liquid
                          assign loading_attribute = nil

                          if section.index > 1 or forloop.index > 3
                            assign loading_attribute = 'lazy'
                          endif

                          if block.type == 'image_with_text' and block.settings.image != blank
                            echo block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: loading_attribute, sizes: sizes_attribute, widths: '300,400,500,600,800,1000,1200,1400,1600,1800', class: 'size-full'
                          elsif block.type == 'video_with_text' and block.settings.video != blank
                            render 'media', media: block.settings.video, autoplay: true, loop: true, controls: false, sizes: sizes_attribute
                          endif
                        -%}
                      </div>
                    {%- elsif block.settings.color_scheme.settings.background == 'rgba(0,0,0,0)' and request.design_mode or request.visual_preview_mode -%}
                      <div class="content-box__background-media">
                        {{- 'collection-apparel-1' | placeholder_svg_tag: 'block' -}}
                      </div>
                    {%- endif -%}

                    {%- liquid
                      assign top_left_content = ''
                      assign top_center_content = ''
                      assign top_right_content = ''
                      assign middle_left_content = ''
                      assign middle_center_content = ''
                      assign middle_right_content = ''
                      assign bottom_left_content = ''
                      assign bottom_center_content = ''
                      assign bottom_right_content = ''
                    -%}

                    {%- assign content_array = 'icon,subheading,heading,text,link' | split: ',' -%}

                    {%- for content_type in content_array -%}
                      {%- capture content -%}
                        {%- case content_type -%}
                          {%- when 'icon' -%}
                            {%- if block.settings.custom_icon != blank -%}
                              {%- render 'icon', image: block.settings.custom_icon, width: block.settings.icon_width, mobile_width: block.settings.mobile_icon_width -%}
                            {%- else -%}
                              {%- render 'icon' with block.settings.icon, width: block.settings.icon_width, mobile_width: block.settings.mobile_icon_width -%}
                            {%- endif -%}

                          {%- when 'subheading' -%}
                            {%- if block.settings.subheading != blank -%}
                              {%- render 'subheading', content: block.settings.subheading -%}
                            {%- endif -%}

                          {%- when 'heading' -%}
                            {%- if block.settings.title != blank -%}
                              {%- if block.settings.scrolling_title -%}
                                <p class="{{ block.settings.heading_tag }} {% if block.settings.show_text_vertically %}h-full{% else %}column-bleed{% endif %}">
                                  <marquee-text speed="0.3" direction="start-to-end" {% if block.settings.show_text_vertically %}vertical{% endif %} class="scrolling-content {% if block.settings.show_text_vertically %}scrolling-content--vertical h-full{% endif %}">
                                    <span class="scrolling-content__item" style="font-size: var(--text-{{ block.settings.heading_tag }})">
                                      <span class="scrolling-content__text">
                                        {%- render 'heading', content: block.settings.title, style: block.settings.heading_tag, html_tag: 'span', instant: true, show_vertically: block.settings.show_text_vertically -%}
                                      </span>

                                      {%- if block.settings.scrolling_title_separator != 'none' -%}
                                        <span class="shape shape--{{ block.settings.scrolling_title_separator }}" style="font-size: var(--text-{{ block.settings.heading_tag }})" aria-hidden="true"></span>
                                      {%- endif -%}
                                    </span>
                                  </marquee-text>
                                </p>
                              {%- else -%}
                                {%- render 'heading', content: block.settings.title, style: block.settings.heading_tag, show_vertically: block.settings.show_text_vertically -%}
                              {%- endif -%}
                            {%- endif -%}

                          {%- when 'text' -%}
                            {% if block.settings.text != blank %}
                              <div class="max-w-sm">
                                {{- block.settings.text -}}
                              </div>
                            {%- endif -%}

                          {%- when 'link' -%}
                            {%- liquid
                              if block.settings.link_text != blank
                                if can_make_block_clickable
                                  render 'button', content: block.settings.link_text, type: 'button', style: block.settings.button_style
                                else
                                  render 'button', content: block.settings.link_text, href: block.settings.link_url, style: block.settings.button_style
                                endif
                              endif
                            -%}
                        {%- endcase -%}
                      {%- endcapture -%}

                      {%- capture content_position_key -%}{{ content_type }}_position{%- endcapture -%}

                      {%- if content_type == 'heading' and block.settings.scrolling_title and block.settings.show_text_vertically -%}
                        <div class="row-span-full justify-self-{% if block.settings[content_position_key] contains 'left' %}start{% elsif block.settings[content_position_key] contains 'right' %}end{% else %}center{% endif %}">
                          {{ content }}
                        </div>
                      {%- else -%}
                        {%- liquid
                          case block.settings[content_position_key]
                            when 'top_left'
                              assign top_left_content = top_left_content | append: content
                            when 'top_center'
                              assign top_center_content = top_center_content | append: content
                            when 'top_right'
                              assign top_right_content = top_right_content | append: content
                            when 'middle_left'
                              assign middle_left_content = middle_left_content | append: content
                            when 'middle_center'
                              assign middle_center_content = middle_center_content | append: content
                            when 'middle_right'
                              assign middle_right_content = middle_right_content | append: content
                            when 'bottom_left'
                              assign bottom_left_content = bottom_left_content | append: content
                            when 'bottom_center'
                              assign bottom_center_content = bottom_center_content | append: content
                            when 'bottom_right'
                              assign bottom_right_content = bottom_right_content | append: content
                          endcase
                        -%}
                      {%- endif -%}
                    {%- endfor -%}

                    <div class="placement-grid">
                      {% if top_left_content != blank %}
                        <div class="align-self-start">
                          <div class="prose prose-justify-start">
                            {{- top_left_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if top_center_content != blank %}
                        <div class="align-self-start">
                          <div class="prose prose-justify-center">
                            {{- top_center_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if top_right_content != blank %}
                        <div class="align-self-start">
                          <div class="prose prose-justify-end">
                            {{- top_right_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if middle_left_content != blank %}
                        <div class="align-self-center">
                          <div class="prose prose-justify-start">
                            {{- middle_left_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if middle_center_content != blank %}
                        <div class="align-self-center">
                          <div class="prose prose-justify-center">
                            {{- middle_center_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if middle_right_content != blank %}
                        <div class="align-self-center">
                          <div class="prose prose-justify-end">
                            {{- middle_right_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if bottom_left_content != blank %}
                        <div class="align-self-end">
                          <div class="prose prose-justify-start">
                            {{- bottom_left_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if bottom_center_content != blank %}
                        <div class="align-self-end">
                          <div class="prose prose-justify-center">
                            {{- bottom_center_content -}}
                          </div>
                        </div>
                      {%- endif -%}

                      {% if bottom_right_content != blank %}
                        <div class="align-self-end">
                          <div class="prose prose-justify-end">
                            {{- bottom_right_content -}}
                          </div>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endcapture -%}

                <media-block class="h-full">
                  {%- if can_make_block_clickable and block.settings.link_url != blank -%}
                    <a href="{{ block.settings.link_url }}" id="block-{{ block.id }}" class="media-blocks__item {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} @container/content-box color-scheme color-scheme--{{ color_scheme.id }}" {{ block.shopify_attributes }}>
                      {{- block_content -}}
                    </a>
                  {%- else -%}
                    <div id="block-{{ block.id }}" class="media-blocks__item {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} @container/content-box color-scheme color-scheme--{{ color_scheme.id }}" {{ block.shopify_attributes }}>
                      {{- block_content -}}
                    </div>
                  {%- endif -%}
                </media-block>

              {%- when 'info_panel' -%}
                <div class="media-blocks__item {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }} info-panel" {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    {%- render 'heading', content: block.settings.title, style: block.settings.heading_tag, html_tag: 'h3', balance_text: true -%}
                  {%- endif -%}

                  {%- liquid
                    assign info_panel_has_items = false

                    for i in (1..6)
                      capture item_label_key
                        echo 'item_'
                        echo i
                        echo '_label'
                      endcapture

                      capture item_content_key
                        echo 'item_'
                        echo i
                        echo '_content'
                      endcapture

                      if block.settings[item_label_key] != blank or block.settings[item_content_key] != blank
                        assign info_panel_has_items = true
                      endif
                    endfor
                  -%}

                  {%- if info_panel_has_items -%}
                    <div class="info-panel__list">
                      {%- for i in (1..6) -%}
                        {%- liquid
                          capture item_label_key
                            echo 'item_'
                            echo i
                            echo '_label'
                          endcapture

                          capture item_content_key
                            echo 'item_'
                            echo i
                            echo '_content'
                          endcapture

                          assign item_label = block.settings[item_label_key]
                          assign item_content = block.settings[item_content_key]
                        -%}

                        {%- if item_label != blank or item_content != blank -%}
                          <div class="info-panel__list-item">
                            {%- if item_label != blank -%}
                              <div class="info-panel__list-item-label">{{ item_label }}</div>
                            {%- endif -%}

                            {%- if item_content != blank -%}
                              <div class="info-panel__list-item-content">{{ item_content }}</div>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'results_tabs' -%}
                {%- liquid
                  assign results_tabs_period_count = 0
                  assign results_tabs_first_period = 0

                  for i in (1..3)
                    capture period_label_key
                      echo 'period_'
                      echo i
                      echo '_label'
                    endcapture

                    if block.settings[period_label_key] != blank
                      assign results_tabs_period_count = results_tabs_period_count | plus: 1

                      if results_tabs_first_period == 0
                        assign results_tabs_first_period = i
                      endif
                    endif
                  endfor

                  assign results_tabs_has_clinical = false

                  for m in (1..5)
                    capture clinical_percentage_key
                      echo 'clinical_stat_'
                      echo m
                      echo '_percentage'
                    endcapture

                    capture clinical_claim_key
                      echo 'clinical_stat_'
                      echo m
                      echo '_claim'
                    endcapture

                    if block.settings[clinical_percentage_key] != blank or block.settings[clinical_claim_key] != blank
                      assign results_tabs_has_clinical = true
                    endif
                  endfor

                  if block.settings.clinical_disclaimer != blank
                    assign results_tabs_has_clinical = true
                  endif
                -%}

                {%- if results_tabs_period_count > 0 -%}
                  <style>
                    {%- comment -%}
                    Two independent toggle levels: an outer "period" tab row (own sliding underline
                    indicator, positioned in JS via offsetLeft/offsetWidth like feature-tabs.liquid's
                    own translateX track) and, inside whichever period panel is active, an inner
                    consumer/clinical toggle. Clinical results content is the SAME regardless of which
                    period is active, so it is rendered once and simply shown/hidden - not duplicated
                    per period.
                    {%- endcomment -%}
                    #results-tabs-{{ block.id }} .results-tabs__toggles {
                      position: relative;
                      flex-wrap: wrap;
                      align-items: center;
                      gap: 1.5rem;
                      margin-block-end: 2rem;
                      display: flex;
                    }

                    #results-tabs-{{ block.id }} .results-tabs__toggle {
                      color: rgb(var(--text-color) / 0.4);
                      font-weight: 600;
                      text-transform: uppercase;
                      padding-block-end: .5rem;
                      background: none;
                      cursor: pointer;
                    }

                    #results-tabs-{{ block.id }} .results-tabs__toggle.is-active {
                      color: rgb(var(--text-color));
                    }

                    #results-tabs-{{ block.id }} .results-tabs__indicator {
                      position: absolute;
                      inset-inline-start: 0;
                      inset-block-end: 0;
                      width: 0;
                      height: 2px;
                      background: rgb(var(--text-color));
                      transition: left .3s ease, width .3s ease;
                    }

                    #results-tabs-{{ block.id }} .results-tabs__stat {
                      margin-block-end: 1.5rem;
                    }

                    #results-tabs-{{ block.id }} .results-tabs__stat-percentage {
                      color: rgb(var(--accent));
                      font-size: 2.5rem;
                      font-weight: 700;
                      line-height: 1.1;
                    }

                    #results-tabs-{{ block.id }} .results-tabs__stat-claim {
                      font-weight: 600;
                      text-transform: uppercase;
                    }

                    #results-tabs-{{ block.id }} .results-tabs__disclaimer {
                      color: rgb(var(--text-color) / 0.6);
                      margin-block-start: 1.5rem;
                    }

                    #results-tabs-{{ block.id }} .results-tabs__inner-toggles {
                      border-block-start: 1px solid rgb(var(--border-color));
                      margin-block-start: 2rem;
                    }

                    #results-tabs-{{ block.id }} .results-tabs__inner-toggle {
                      width: 100%;
                      font-size: var(--text-h5);
                      font-weight: 600;
                      text-align: start;
                      padding-block: 1.25rem;
                      border-block-end: 1px solid rgb(var(--border-color));
                      background: none;
                      cursor: pointer;
                      display: block;
                    }

                    #results-tabs-{{ block.id }} .results-tabs__inner-toggle:last-child {
                      border-block-end: none;
                    }

                    #results-tabs-{{ block.id }} .results-tabs__inner-toggle:not(.is-active) {
                      color: rgb(var(--text-color) / 0.4);
                    }
                  </style>

                  <div id="results-tabs-{{ block.id }}" class="media-blocks__item {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }}" {{ block.shopify_attributes }}>
                    <div style="padding: min(2.5rem, var(--container-gutter));">
                      <div class="results-tabs__toggles" role="tablist">
                        {%- for i in (1..3) -%}
                          {%- capture period_label_key -%}period_{{ i }}_label{%- endcapture -%}
                          {%- assign period_label = block.settings[period_label_key] -%}

                          {%- if period_label != blank -%}
                            <button type="button" class="results-tabs__toggle {% if i == results_tabs_first_period %}is-active{% endif %}" data-period-toggle="{{ i }}" role="tab" aria-selected="{% if i == results_tabs_first_period %}true{% else %}false{% endif %}">{{ period_label }}</button>
                          {%- endif -%}
                        {%- endfor -%}

                        <span class="results-tabs__indicator" data-results-tabs-indicator></span>
                      </div>

                      {%- for i in (1..3) -%}
                        {%- capture period_label_key -%}period_{{ i }}_label{%- endcapture -%}
                        {%- capture period_disclaimer_key -%}period_{{ i }}_disclaimer{%- endcapture -%}

                        {%- assign period_label = block.settings[period_label_key] -%}
                        {%- assign period_disclaimer = block.settings[period_disclaimer_key] -%}

                        {%- if period_label != blank -%}
                          <div data-period-panel="{{ i }}" {% unless i == results_tabs_first_period %}hidden{% endunless %}>
                            <div data-consumer-panel>
                              <ul class="unstyled-list">
                                {%- for m in (1..5) -%}
                                  {%- capture stat_percentage_key -%}period_{{ i }}_stat_{{ m }}_percentage{%- endcapture -%}
                                  {%- capture stat_claim_key -%}period_{{ i }}_stat_{{ m }}_claim{%- endcapture -%}

                                  {%- assign stat_percentage = block.settings[stat_percentage_key] -%}
                                  {%- assign stat_claim = block.settings[stat_claim_key] -%}

                                  {%- if stat_percentage != blank or stat_claim != blank -%}
                                    <li class="results-tabs__stat">
                                      {%- if stat_percentage != blank -%}
                                        <div class="results-tabs__stat-percentage">{{ stat_percentage }}</div>
                                      {%- endif -%}

                                      {%- if stat_claim != blank -%}
                                        <div class="results-tabs__stat-claim">{{ stat_claim }}</div>
                                      {%- endif -%}
                                    </li>
                                  {%- endif -%}
                                {%- endfor -%}
                              </ul>

                              {%- if period_disclaimer != blank -%}
                                <div class="results-tabs__disclaimer">{{ period_disclaimer }}</div>
                              {%- endif -%}
                            </div>

                            {%- if results_tabs_has_clinical -%}
                              <div class="results-tabs__inner-toggles" role="tablist">
                                <button type="button" class="results-tabs__inner-toggle is-active" data-inner-toggle="consumer" role="tab" aria-selected="true">{{ block.settings.consumer_tab_label | default: "Consumer study results" }}</button>
                                <button type="button" class="results-tabs__inner-toggle" data-inner-toggle="clinical" role="tab" aria-selected="false">{{ block.settings.clinical_tab_label | default: "Clinical results" }}</button>
                              </div>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}

                      {%- if results_tabs_has_clinical -%}
                        <div data-clinical-panel hidden>
                          <ul class="unstyled-list">
                            {%- for m in (1..5) -%}
                              {%- capture clinical_percentage_key -%}clinical_stat_{{ m }}_percentage{%- endcapture -%}
                              {%- capture clinical_claim_key -%}clinical_stat_{{ m }}_claim{%- endcapture -%}

                              {%- assign clinical_percentage = block.settings[clinical_percentage_key] -%}
                              {%- assign clinical_claim = block.settings[clinical_claim_key] -%}

                              {%- if clinical_percentage != blank or clinical_claim != blank -%}
                                <li class="results-tabs__stat">
                                  {%- if clinical_percentage != blank -%}
                                    <div class="results-tabs__stat-percentage">{{ clinical_percentage }}</div>
                                  {%- endif -%}

                                  {%- if clinical_claim != blank -%}
                                    <div class="results-tabs__stat-claim">{{ clinical_claim }}</div>
                                  {%- endif -%}
                                </li>
                              {%- endif -%}
                            {%- endfor -%}
                          </ul>

                          {%- if block.settings.clinical_disclaimer != blank -%}
                            <div class="results-tabs__disclaimer">{{ block.settings.clinical_disclaimer }}</div>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>

                  <script>
                    (function() {
                      var root = document.getElementById('results-tabs-{{ block.id }}');
                      if (!root) return;

                      var periodToggles = root.querySelectorAll('[data-period-toggle]');
                      var periodPanels = root.querySelectorAll('[data-period-panel]');
                      var indicator = root.querySelector('[data-results-tabs-indicator]');
                      var clinicalPanel = root.querySelector('[data-clinical-panel]');

                      function moveIndicator(button) {
                        if (!indicator || !button) return;
                        indicator.style.left = button.offsetLeft + 'px';
                        indicator.style.width = button.offsetWidth + 'px';
                      }

                      function setInnerActive(panel, type) {
                        var consumer = panel.querySelector('[data-consumer-panel]');
                        if (consumer) consumer.hidden = type === 'clinical';
                        if (clinicalPanel) clinicalPanel.hidden = type !== 'clinical';

                        panel.querySelectorAll('[data-inner-toggle]').forEach(function(toggle) {
                          var isActive = toggle.getAttribute('data-inner-toggle') === type;
                          toggle.classList.toggle('is-active', isActive);
                          toggle.setAttribute('aria-selected', isActive ? 'true' : 'false');
                        });
                      }

                      function activatePeriod(index) {
                        periodToggles.forEach(function(toggle) {
                          var isActive = toggle.getAttribute('data-period-toggle') === index;
                          toggle.classList.toggle('is-active', isActive);
                          toggle.setAttribute('aria-selected', isActive ? 'true' : 'false');
                          if (isActive) moveIndicator(toggle);
                        });

                        periodPanels.forEach(function(panel) {
                          var isActive = panel.getAttribute('data-period-panel') === index;
                          panel.hidden = !isActive;
                          if (isActive) setInnerActive(panel, 'consumer');
                        });
                      }

                      periodToggles.forEach(function(toggle) {
                        toggle.addEventListener('click', function() {
                          activatePeriod(toggle.getAttribute('data-period-toggle'));
                        });
                      });

                      root.querySelectorAll('[data-inner-toggle]').forEach(function(toggle) {
                        toggle.addEventListener('click', function() {
                          var panel = toggle.closest('[data-period-panel]');
                          if (panel) setInnerActive(panel, toggle.getAttribute('data-inner-toggle'));
                        });
                      });

                      var activeToggle = root.querySelector('.results-tabs__toggle.is-active');
                      if (activeToggle) moveIndicator(activeToggle);

                      window.addEventListener('resize', function() {
                        var current = root.querySelector('.results-tabs__toggle.is-active');
                        if (current) moveIndicator(current);
                      });
                    })();
                  </script>
                {%- endif -%}

              {%- when 'empty_item' -%}
                <div class="media-blocks__item color-scheme color-scheme--{{ block.settings.color_scheme.id }} md-max:hidden" {{ block.shopify_attributes }}>
                  <!-- Empty item -->
                </div>

              {%- when 'faq' -%}
                {%- liquid
                  assign faq_item_count = 0

                  for i in (1..8)
                    capture faq_question_key
                      echo 'question_'
                      echo i
                    endcapture

                    capture faq_answer_key
                      echo 'answer_'
                      echo i
                    endcapture

                    if block.settings[faq_question_key] != blank or block.settings[faq_answer_key] != blank
                      assign faq_item_count = faq_item_count | plus: 1
                    endif
                  endfor

                  # Same top_left..bottom_right -> align-self-*/prose-justify-* mapping the
                  # image_with_text/video_with_text blocks above use for their placement-grid content,
                  # reused as-is so FAQ shares the exact same alignment system (id: content_position).
                  case block.settings.content_position
                    when 'top_left'
                      assign faq_vertical_class = 'align-self-start'
                      assign faq_horizontal_class = 'prose-justify-start'
                    when 'top_center'
                      assign faq_vertical_class = 'align-self-start'
                      assign faq_horizontal_class = 'prose-justify-center'
                    when 'top_right'
                      assign faq_vertical_class = 'align-self-start'
                      assign faq_horizontal_class = 'prose-justify-end'
                    when 'middle_left'
                      assign faq_vertical_class = 'align-self-center'
                      assign faq_horizontal_class = 'prose-justify-start'
                    when 'middle_center'
                      assign faq_vertical_class = 'align-self-center'
                      assign faq_horizontal_class = 'prose-justify-center'
                    when 'middle_right'
                      assign faq_vertical_class = 'align-self-center'
                      assign faq_horizontal_class = 'prose-justify-end'
                    when 'bottom_left'
                      assign faq_vertical_class = 'align-self-end'
                      assign faq_horizontal_class = 'prose-justify-start'
                    when 'bottom_center'
                      assign faq_vertical_class = 'align-self-end'
                      assign faq_horizontal_class = 'prose-justify-center'
                    when 'bottom_right'
                      assign faq_vertical_class = 'align-self-end'
                      assign faq_horizontal_class = 'prose-justify-end'
                    else
                      assign faq_vertical_class = 'align-self-center'
                      assign faq_horizontal_class = 'prose-justify-center'
                  endcase
                -%}

                <div id="block-{{ block.id }}" class="media-blocks__item {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} @container/content-box color-scheme color-scheme--{{ block.settings.color_scheme.id }}" {{ block.shopify_attributes }}>
                  <div class="faq-content-box h-full">
                    <div class="placement-grid">
                      <div class="{{ faq_vertical_class }}">
                        <div class="prose {{ faq_horizontal_class }}">
                          {%- if block.settings.title != blank -%}
                            {%- render 'heading', content: block.settings.title, style: 'h3', html_tag: 'h2', balance_text: true -%}
                          {%- endif -%}

                          {%- if block.settings.content != blank -%}
                            {{- block.settings.content -}}
                          {%- endif -%}

                          {%- if faq_item_count > 0 -%}
                            <div class="faq-block__list">
                              {%- for i in (1..8) -%}
                                {%- liquid
                                  capture faq_question_key
                                    echo 'question_'
                                    echo i
                                  endcapture

                                  capture faq_answer_key
                                    echo 'answer_'
                                    echo i
                                  endcapture

                                  capture faq_open_key
                                    echo 'open_'
                                    echo i
                                  endcapture

                                  assign faq_question = block.settings[faq_question_key]
                                  assign faq_answer = block.settings[faq_answer_key]
                                  assign faq_open = block.settings[faq_open_key]
                                -%}

                                {%- if faq_question != blank or faq_answer != blank -%}
                                  {%- render 'accordion', title: faq_question, content: faq_answer, open: faq_open, uppercase_title: true, prose_content: true, toggle_icon: 'accordion-plus' -%}
                                {%- endif -%}
                              {%- endfor -%}
                            </div>

                            {%- render 'faq-accordion-group' -%}
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

              {%- when 'carousel' -%}
                {%- liquid
                  assign carousel_slide_count = 0

                  for i in (1..8)
                    capture image_key
                      echo 'image_'
                      echo i
                    endcapture

                    capture video_key
                      echo 'video_'
                      echo i
                    endcapture

                    capture heading_key
                      echo 'heading_'
                      echo i
                    endcapture

                    capture text_key
                      echo 'text_'
                      echo i
                    endcapture

                    assign slide_image = block.settings[image_key]
                    assign slide_video = block.settings[video_key]
                    assign slide_heading = block.settings[heading_key]
                    assign slide_text = block.settings[text_key]

                    if slide_image != blank or slide_video != blank or slide_heading != blank or slide_text != blank
                      assign carousel_slide_count = carousel_slide_count | plus: 1
                    endif
                  endfor

                  # Video width (mobile + desktop): only meaningful when the relevant block size setting
                  # is fixed (mobile_block_size / block_size 'auto' sizes itself off the video/image's own
                  # ratio already, and 'none' means the feature is off entirely). Both the aspect-ratio and
                  # the target height are resolved to explicit, deterministic CSS values (not intrinsic
                  # sizing like max-content or a bare min-height) precisely so the derived width is exact,
                  # instead of relying on any browser auto-sizing edge case. Mobile and desktop are resolved
                  # independently since they read from mobile_block_size/block_size respectively, and one
                  # can be 'auto' while the other isn't.
                  #
                  # The clamp() values below are copied from the theme's own min-h-* utility classes
                  # (assets/theme.css) that mobile_block_size/block_size already render as: the unprefixed
                  # ones (35/45/55vmax) for mobile_block_size, the md: breakpoint ones (40/50/60vmax, used
                  # from 700px up, which is also where this carousel's own grid switches) for block_size.
                  assign carousel_video_aspect_ratio = nil
                  assign carousel_video_mobile_box_height = nil
                  assign carousel_video_box_height = nil

                  if section.settings.carousel_video_width != 'none'
                    case section.settings.carousel_video_width
                      when '4-5'
                        assign carousel_video_aspect_ratio = '4 / 5'
                        assign carousel_video_width_ratio = 0.8
                      when '3-4'
                        assign carousel_video_aspect_ratio = '3 / 4'
                        assign carousel_video_width_ratio = 0.75
                      when '9-16'
                        assign carousel_video_aspect_ratio = '9 / 16'
                        assign carousel_video_width_ratio = 0.5625
                    endcase

                    # The carousel block's own slides read block.settings.mobile_block_size ("Mobile
                    # image height") for their mobile height, NOT section.settings.mobile_block_size
                    # (a separate, section-wide setting only used by the image_with_text/video_with_text
                    # blocks) - so that's the one to match here too.
                    if block.settings.mobile_block_size != 'auto'
                      case block.settings.mobile_block_size
                        when 'sm'
                          assign carousel_video_mobile_box_height = 'clamp(15rem, 35vmax, 25rem)'
                        when 'md'
                          assign carousel_video_mobile_box_height = 'clamp(20rem, 45vmax, 35rem)'
                        when 'lg'
                          assign carousel_video_mobile_box_height = 'clamp(25rem, 55vmax, 45rem)'
                        when 'fill'
                          assign carousel_video_mobile_box_height = 'calc(100svh - var(--sticky-area-height, 0px))'
                      endcase
                    endif

                    if section.settings.block_size != 'auto'
                      case section.settings.block_size
                        when 'sm'
                          assign carousel_video_box_height = 'clamp(15rem, 40vmax, 25rem)'
                        when 'md'
                          assign carousel_video_box_height = 'clamp(20rem, 50vmax, 35rem)'
                        when 'lg'
                          assign carousel_video_box_height = 'clamp(25rem, 60vmax, 45rem)'
                        when 'fill'
                          assign carousel_video_box_height = 'calc(100svh - var(--sticky-area-height, 0px))'
                      endcase
                    endif
                  endif

                  # Shared ids for the media-zoom-* snippets (snippets/media-zoom-slide.liquid,
                  # media-lightbox.liquid, media-zoom-script.liquid, media-zoom-style.liquid) - the
                  # same ids this carousel has always used, just captured once so both the markup and
                  # the snippet calls below stay in sync.
                  assign carousel_wrapper_id = 'carousel-wrapper-' | append: block.id
                  assign carousel_dom_id = 'carousel-' | append: block.id
                  assign carousel_lightbox_id = 'media-lightbox-' | append: block.id
                  assign carousel_controls_slot_id = 'carousel-controls-slot-' | append: block.id
                  assign carousel_has_multiple_slides = false
                  assign carousel_relocate_controls = false

                  if carousel_slide_count > 1
                    assign carousel_has_multiple_slides = true
                  endif

                  if section.settings.controls_position == 'progress_bar'
                    assign carousel_relocate_controls = true
                  endif
                -%}

                <style>
                  {%- comment -%}
                  Overrides the .gap-4 utility's fixed 1rem row-gap (which is a generic spacing-scale
                  value shared by every .gap-4 usage in the theme, not section spacing) so the gap above
                  the progress bar/controls row follows the same global "Section spacing" setting as the
                  rest of the theme's section rhythm, instead of a value independent from it.
                  {%- endcomment -%}
                  #carousel-wrapper-{{ block.id }} {
                    row-gap: var(--section-vertical-spacing);
                  }

                  #carousel-{{ block.id }} {
                    grid: auto / auto-flow {% if carousel_video_mobile_box_height %}calc({{ carousel_video_mobile_box_height }} * {{ carousel_video_width_ratio }}){% else %}85%{% endif %};
                    gap: .75rem;
                    display: grid;
                  }

                  {%- comment -%}
                    The column width above is the same calc() as this height * ratio, computed explicitly
                    instead of relying on intrinsic/max-content sizing - so image-only slides in the same
                    carousel (which don't match :has(video-media) below and so keep their existing
                    min-height) still land in a column of the correct, exact width, rather than risking
                    collapsing to zero under max-content sizing.
                  {%- endcomment -%}
                  {%- if carousel_video_mobile_box_height -%}
                    #carousel-{{ block.id }} .content-box:has(video-media) {
                      height: {{ carousel_video_mobile_box_height }};
                      aspect-ratio: {{ carousel_video_aspect_ratio }};
                      width: auto;
                    }
                  {%- endif -%}

                  @media screen and (min-width: 700px) {
                    #carousel-{{ block.id }} {
                      grid: auto / auto-flow {% if carousel_video_box_height %}calc({{ carousel_video_box_height }} * {{ carousel_video_width_ratio }}){% else %}45%{% endif %};
                      gap: .75rem;
                    }

                    {%- if carousel_video_box_height -%}
                      #carousel-{{ block.id }} .content-box:has(video-media) {
                        height: {{ carousel_video_box_height }};
                        aspect-ratio: {{ carousel_video_aspect_ratio }};
                        width: auto;
                      }
                    {%- endif -%}
                  }

                  {%- render 'media-zoom-style',
                    wrapper_id: carousel_wrapper_id,
                    lightbox_id: carousel_lightbox_id,
                    corner_radius: 'var(--media-blocks-corner-radius)',
                    controls_position: section.settings.controls_position,
                    desktop_controls_position: section.settings.desktop_controls_position,
                    controls_slot_id: carousel_controls_slot_id,
                    has_multiple_slides: carousel_has_multiple_slides
                  -%}
                </style>

                <div class="media-blocks__item {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }}" style="padding: min(1.25rem, var(--container-gutter));" {{ block.shopify_attributes }}>
                  <div class="v-stack gap-4" id="{{ carousel_wrapper_id }}">
                    <div style="border-radius: var(--media-blocks-corner-radius); overflow: hidden;">
                    <product-list id="{{ carousel_dom_id }}" cell-selector=".snap-start" class="scroll-area snap-x">
                      {%- liquid
                        # Matches the order cells actually render in below (only slides with content get one),
                        # so it lines up with the dataSource array the lightbox script builds from
                        # carousel.cells further down - both walk the same cells in the same order.
                        assign lightbox_slide_index = 0
                      -%}
                      {%- for i in (1..8) -%}
                        {%- capture image_key -%}image_{{ i }}{%- endcapture -%}
                        {%- capture video_key -%}video_{{ i }}{%- endcapture -%}
                        {%- capture product_key -%}product_{{ i }}{%- endcapture -%}
                        {%- capture heading_key -%}heading_{{ i }}{%- endcapture -%}
                        {%- capture text_key -%}text_{{ i }}{%- endcapture -%}

                        {%- assign slide_image = block.settings[image_key] -%}
                        {%- assign slide_video = block.settings[video_key] -%}
                        {%- assign slide_product = block.settings[product_key] -%}
                        {%- assign slide_heading = block.settings[heading_key] -%}
                        {%- assign slide_text = block.settings[text_key] -%}

                        {%- if slide_image != blank or slide_video != blank or slide_heading != blank or slide_text != blank -%}
                          <div class="snap-start">
                            {%- render 'media-zoom-slide',
                              video: slide_video,
                              image: slide_image,
                              block_size: section.settings.block_size,
                              mobile_block_size: block.settings.mobile_block_size,
                              corner_radius: 'var(--media-blocks-corner-radius)',
                              heading: slide_heading,
                              text: slide_text,
                              show_product_button: block.settings.show_product_button,
                              product: slide_product,
                              product_button_type: block.settings.product_button_type,
                              product_button_text: block.settings.product_button_text,
                              lightbox_id: carousel_lightbox_id,
                              aria_controls_id: carousel_dom_id,
                              lightbox_index: lightbox_slide_index,
                              sizes: '85vw'
                            -%}
                          </div>
                          {%- assign lightbox_slide_index = lightbox_slide_index | plus: 1 -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </product-list>
                    </div>

                    {%- render 'media-lightbox', id: carousel_lightbox_id, show_nav: carousel_has_multiple_slides -%}

                    {%- if carousel_slide_count > 1 -%}
                      {%- if section.settings.controls_position == 'progress_bar' -%}
                        <div class="h-stack gap-4">
                          <progress-bar track-scroll-target="{{ carousel_dom_id }}" class="progress-bar grow"></progress-bar>
                          <div class="h-stack gap-2" id="{{ carousel_controls_slot_id }}"></div>
                        </div>
                      {%- else -%}
                        <progress-bar track-scroll-target="{{ carousel_dom_id }}" class="progress-bar w-full"></progress-bar>
                      {%- endif -%}
                    {%- endif -%}

                    {%- if carousel_slide_count >= 1 -%}
                      {%- render 'media-zoom-script',
                        wrapper_id: carousel_wrapper_id,
                        lightbox_id: carousel_lightbox_id,
                        carousel_id: carousel_dom_id,
                        controls_slot_id: carousel_controls_slot_id,
                        relocate_controls: carousel_relocate_controls
                      -%}
                    {%- endif -%}
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

