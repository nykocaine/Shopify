{% comment %}
  Libro de Reclamaciones Virtual (Perú) — Ley N.° 29571, D.S. N.° 011-2011-PCM,
  Ley N.° 32495. Envía vía el formulario nativo `{% form 'contact' %}` de
  Shopify (sin backend propio); los reclamos llegan al correo configurado en
  Settings → Notifications.

  Limitaciones de cumplimiento conocidas de este enfoque (documentadas para el
  comerciante, no ocultas):
  - No existe un archivo/registro consultable más allá de esa bandeja de
    correo: debe revisarse a diario y archivarse por 2 años.
  - El formulario nativo no reenvía copia automática al consumidor; si la
    solicita, debe reenviarse manualmente.
  - El "Código de Reclamación" se genera en el navegador (fecha + aleatorio),
    no es un contador correlativo centralizado.
  - El texto de plazo de respuesta es editable desde el schema porque, a la
    fecha, el reglamento adaptado a comercio electrónico sigue en consulta
    pública (no hay texto final que hardcodear con certeza).
{% endcomment %}

{%- capture provider_summary -%}
  {%- if section.settings.provider_business_name != blank -%}
    <p>{{ 'libro_reclamaciones.aviso.provider_label' | t }}: {{ section.settings.provider_business_name }}</p>
  {%- endif -%}
  {%- if section.settings.provider_ruc != blank -%}
    <p>RUC: {{ section.settings.provider_ruc }}</p>
  {%- endif -%}
  {%- if section.settings.provider_address != blank -%}
    <p>{{ 'libro_reclamaciones.aviso.address_label' | t }}: {{ section.settings.provider_address }}</p>
  {%- endif -%}
  {%- if section.settings.provider_email != blank -%}
    <p>{{ 'libro_reclamaciones.aviso.email_label' | t }}: {{ section.settings.provider_email }}</p>
  {%- endif -%}
{%- endcapture -%}

{%- capture section_header -%}
  <div class="v-stack justify-items-start gap-6 sm:gap-8">
    <div class="prose prose-justify-start">
      {%- render 'subheading', content: section.settings.subheading -%}
      {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_size, html_tag: 'h2' -%}
    </div>
  </div>
{%- endcapture -%}

{%- capture section_main_content -%}
  <div class="rc-aviso v-stack gap-4">
    <div class="rc-aviso__columns grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
      <div class="rc-aviso__left v-stack gap-4">
        {%- if section.settings.content != blank -%}
          <div class="prose">
            {{- section.settings.content -}}
          </div>
        {%- endif -%}

        <p class="subheading">{{ 'libro_reclamaciones.aviso.title' | t }}</p>

        <div class="rc-aviso__provider prose">
          {{- provider_summary -}}
        </div>
      </div>

      <div class="rc-aviso__notes v-stack gap-4 text-subdued">
        {%- if section.settings.response_deadline_text != blank -%}
          <div class="prose">
            {{- section.settings.response_deadline_text -}}
          </div>
        {%- endif -%}

        {%- if section.settings.retention_notice != blank -%}
          <div class="prose">
            {{- section.settings.retention_notice -}}
          </div>
        {%- endif -%}

        <p>{{ 'libro_reclamaciones.aviso.reclamo_vs_queja' | t }}</p>
      </div>
    </div>
  </div>

  {%- assign posted_successfully = false -%}

  {%- comment -%} render tags cannot apply filters inline, so every translated label is pre-computed here (same pattern as sections/contact.liquid). {%- endcomment -%}
  {%- assign request_type_legend_label = 'libro_reclamaciones.form.request_type_legend' | t -%}
  {%- assign request_type_reclamo_label = 'libro_reclamaciones.form.request_type_reclamo' | t -%}
  {%- assign request_type_queja_label = 'libro_reclamaciones.form.request_type_queja' | t -%}
  {%- assign name_label = 'libro_reclamaciones.form.name' | t -%}
  {%- assign email_label = 'libro_reclamaciones.form.email' | t -%}
  {%- assign document_type_label = 'libro_reclamaciones.form.document_type' | t -%}
  {%- assign document_number_label = 'libro_reclamaciones.form.document_number' | t -%}
  {%- assign address_label = 'libro_reclamaciones.form.address' | t -%}
  {%- assign phone_label = 'libro_reclamaciones.form.phone' | t -%}
  {%- assign product_service_label = 'libro_reclamaciones.form.product_service' | t -%}
  {%- assign amount_label = 'libro_reclamaciones.form.amount' | t -%}
  {%- assign detail_label = 'libro_reclamaciones.form.detail' | t -%}
  {%- assign consumer_request_label = 'libro_reclamaciones.form.consumer_request' | t -%}
  {%- assign is_minor_label = 'libro_reclamaciones.form.is_minor' | t -%}
  {%- assign guardian_name_label = 'libro_reclamaciones.form.guardian_name' | t -%}
  {%- assign guardian_document_label = 'libro_reclamaciones.form.guardian_document' | t -%}
  {%- assign submit_label = 'libro_reclamaciones.form.submit' | t -%}

  {%- if shop.privacy_policy != blank -%}
    {%- assign consent_label = 'libro_reclamaciones.form.consent_html' | t: link: shop.privacy_policy.url -%}
  {%- else -%}
    {%- assign consent_label = 'libro_reclamaciones.form.consent' | t -%}
  {%- endif -%}

  {%- form 'contact', class: 'form', id: 'libro-reclamaciones-form' -%}
    {%- if form.posted_successfully? -%}
      {%- assign posted_successfully = true -%}
    {%- endif -%}

    {%- if form.errors -%}
      {%- capture error_content -%}{{ form.errors.translated_fields[form.errors.first] | capitalize }} {{ form.errors.messages[form.errors.first] }}{%- endcapture -%}
      {%- render 'banner', status: 'error', content: error_content -%}
    {%- endif -%}

    {%- unless posted_successfully -%}
      <input type="hidden" name="contact[Formulario]" value="Libro de Reclamaciones">
      <input type="hidden" id="rc-code" name="contact[Código de Reclamación]" value="">
      <input type="hidden" id="rc-datetime" name="contact[Fecha y hora de registro]" value="">

      <div class="v-stack gap-3">
        {%- assign request_type_options = request_type_reclamo_label | append: ',' | append: request_type_queja_label | split: ',' -%}
        {%- render 'select', option_values: request_type_options, show_empty_value: true, name: 'contact[Tipo de solicitud]', label: request_type_legend_label, required: true -%}

        <p class="text-subdued">
          <strong>{{ request_type_reclamo_label }}:</strong> {{ 'libro_reclamaciones.form.request_type_reclamo_info' | t }}<br>
          <strong>{{ request_type_queja_label }}:</strong> {{ 'libro_reclamaciones.form.request_type_queja_info' | t }}
        </p>
      </div>

      <div class="fieldset">
        <div class="fieldset-row">
          {%- render 'input', type: 'text', name: 'contact[name]', label: name_label, value: customer.name, required: true, autocomplete: 'name' -%}
          {%- render 'input', type: 'email', name: 'contact[email]', label: email_label, value: customer.email, required: true, autocomplete: 'email' -%}
        </div>

        <div class="fieldset-row">
          {%- capture document_type_values -%}{{ 'libro_reclamaciones.form.document_type_dni' | t }},{{ 'libro_reclamaciones.form.document_type_ce' | t }},{{ 'libro_reclamaciones.form.document_type_passport' | t }}{%- endcapture -%}
          {%- assign document_type_options = document_type_values | split: ',' -%}
          {%- render 'select', option_values: document_type_options, show_empty_value: true, name: 'contact[Tipo de documento]', label: document_type_label, required: true -%}

          {%- render 'input', type: 'text', name: 'contact[Número de documento]', label: document_number_label, required: true, pattern: '[A-Za-z0-9]{6,12}', minlength: 6, maxlength: 12 -%}
        </div>

        <div class="fieldset-row">
          {%- render 'input', type: 'text', name: 'contact[Domicilio]', label: address_label, required: true, maxlength: 200 -%}
          {%- render 'input', type: 'tel', name: 'contact[Teléfono]', label: phone_label, required: true, pattern: '[0-9+\(\)\-\s]{6,20}', autocomplete: 'tel' -%}
        </div>

        <div class="fieldset-row">
          {%- render 'input', type: 'text', name: 'contact[Descripción del bien o servicio]', label: product_service_label, required: true, maxlength: 200 -%}
          {%- render 'input', type: 'text', name: 'contact[Monto reclamado]', label: amount_label, pattern: '\d+([.,]\d{1,2})?', maxlength: 12, autocomplete: 'off' -%}
        </div>

        {%- render 'input', name: 'contact[Detalle del reclamo o queja]', label: detail_label, multiline: 6, required: true, minlength: 20, maxlength: 2000, show_max_characters_count: true -%}

        {%- render 'input', name: 'contact[Pedido concreto del consumidor]', label: consumer_request_label, multiline: 4, required: true, minlength: 10, maxlength: 500, show_max_characters_count: true -%}

        <div class="v-stack gap-3">
          {%- render 'checkbox', name: 'contact[Es menor de edad]', value: 'Sí', label: is_minor_label, id_prefix: 'is-minor' -%}
          <div id="rc-minor-fields" class="fieldset-row" hidden>
            {%- render 'input', type: 'text', name: 'contact[Nombre del padre, madre o representante legal]', label: guardian_name_label, disabled: true -%}
            {%- render 'input', type: 'text', name: 'contact[Documento del representante legal]', label: guardian_document_label, disabled: true -%}
          </div>
        </div>

        {%- render 'checkbox', name: 'contact[Declaración de conformidad y consentimiento]', value: 'Acepto', label: consent_label, required: true, id_prefix: 'consent' -%}
      </div>

      <div class="v-stack gap-3">
        {%- render 'button', content: submit_label, type: 'submit', class: 'rc-submit sm:justify-self-start' -%}
        <p class="rc-submit-hint text-subdued text-sm" hidden>{{ 'libro_reclamaciones.form.incomplete_hint' | t }}</p>
      </div>
    {%- endunless -%}
  {%- endform -%}

  {%- if posted_successfully -%}
    {%- assign success_message = 'libro_reclamaciones.form.success_message' | t -%}

    <div id="rc-confirmation" class="rc-print-area v-stack gap-4">
      {%- render 'banner', status: 'success', content: success_message -%}

      <p data-rc-fallback hidden>{{ 'libro_reclamaciones.confirmation.fallback' | t }}</p>

      <div class="prose">
        <p>{{ 'libro_reclamaciones.confirmation.code_label' | t }}: <strong data-rc-code></strong></p>
        <p>{{ 'libro_reclamaciones.confirmation.type_label' | t }}: <strong data-rc-type></strong></p>
        <p>{{ 'libro_reclamaciones.confirmation.date_label' | t }}: <strong data-rc-date></strong></p>
      </div>

      <div class="rc-aviso v-stack gap-2">
        <p class="subheading">{{ 'libro_reclamaciones.aviso.title' | t }}</p>

        <div class="rc-aviso__provider prose">
          {{- provider_summary -}}
        </div>
      </div>

      <div class="print:hidden">
        <button type="button" class="button button--outline" data-rc-print>{{ 'libro_reclamaciones.confirmation.print' | t }}</button>
      </div>
    </div>
  {%- endif -%}
{%- endcapture -%}

<style>
  {%- comment -%}
  Same padding as sections/reviews.liquid - container-gutter + 0.5rem on all four sides, same on
  mobile and desktop - instead of the global "Section spacing" setting this section normally uses.
  Put directly on .section-spacing itself (not on the nested .container) so it's one plain
  padding: on one element, on top of whatever .container's own margin already does - same as
  every other floating section in the theme. Top padding is tripled vs. the other three sides.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .section-spacing {
    padding: calc(var(--container-gutter) + 0.5rem);
    padding-block-start: calc((var(--container-gutter) + 0.5rem) * 3);
  }

  {%- comment -%}
  .container (nested inside .section-spacing) still carries its own margin-inline
  (--container-gutter-context) for the site-wide gutter - stacked on top of the padding above,
  that doubles up the left/right inset. Zeroing just the gutter part of that margin formula
  leaves .section-spacing's own padding as the only source of side space.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .section-spacing .container {
    --container-gutter-context: 0px;
  }

  {%- comment -%}
  Legal notice block (previously a white boxed card - see assets/libro-reclamaciones.css): now
  plain text, so it needs its own rhythm instead of the flat p { margin: 0 } that worked for a
  tightly packed card. The business-details lines (name/RUC/address/email) stay tight as one
  group, each getting a little breathing room instead of a hard 0; everything else (title,
  deadline text, retention notice, reclamo-vs-queja line) gets proper spacing from .rc-aviso's
  own v-stack gap in the markup. Business details and the deadline/retention/reclamo-vs-queja
  copy sit side by side in two columns on desktop (single column on mobile) via
  .rc-aviso__columns, with a rule between them - horizontal above the notes on mobile (they're
  stacked), vertical to their left on desktop (they're side by side) - so the two groups always
  read as distinct blocks instead of a single run of text.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .rc-aviso__provider p {
    margin: 0 0 .375rem;
  }

  #shopify-section-{{ section.id }} .rc-aviso__provider p:last-child {
    margin-block-end: 0;
  }

  #shopify-section-{{ section.id }} .rc-aviso__notes {
    border-block-start: 1px solid rgb(var(--border-color));
    padding-block-start: 1.5rem;
  }

  {%- comment -%} Extra breathing room below the "Aviso del Libro de Reclamaciones" title, on top of the .rc-aviso__left v-stack's own gap. {%- endcomment -%}
  #shopify-section-{{ section.id }} .rc-aviso__left .subheading {
    margin-block-end: 1.5rem;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .rc-aviso__notes {
      border-block-start: none;
      padding-block-start: 0;
      border-inline-start: 1px solid rgb(var(--border-color));
      padding-inline-start: 2rem;
    }
  }
</style>

{%- if section.settings.floating_libro_reclamaciones -%}
  <style>
    {%- comment -%}
    The side gutter of the floating card sits on the section wrapper itself, outside the section, instead of on the card inside it:
    the editor's outline then spans only the card, which still respects the page's side padding.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} {
      margin-inline: var(--container-gutter);
    }

    #shopify-section-{{ section.id }} .section-floating {
      margin-inline: 0;
    }
  </style>
{%- endif -%}

{%- if section.settings.show_loader and request.design_mode == false -%}
  <style>
    {%- comment -%}
    A short loading screen over the section only (about a second, pure CSS - it hides itself, no script): a thin-line book whose page
    turns, and a line of text. Flat colors only: no shadows, no gradients. Not shown inside the theme editor.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} > div {
      position: relative;
    }

    .rc-loader {
      position: absolute;
      inset: 0;
      z-index: 5;
      display: grid;
      align-content: start;
      justify-items: center;
      gap: 1rem;
      padding-block-start: min(10rem, 25vh);
      animation: rc-loader-out 0.45s ease 1.3s forwards;
    }

    .rc-loader__book {
      width: 2.5rem;
      height: 2.5rem;
      color: rgb(var(--text-color) / 0.85);
    }

    .rc-loader__book path {
      fill: none;
      stroke: currentColor;
      stroke-width: 1px;
      stroke-linecap: round;
      stroke-linejoin: round;
      vector-effect: non-scaling-stroke;
    }

    .rc-loader__turning {
      transform-box: view-box;
      transform-origin: 32px 32px;
      animation: rc-loader-turn 1s ease-in-out 0.1s infinite;
    }

    .rc-loader__text {
      margin: 0;
      color: rgb(var(--text-color) / 0.6);
    }

    @keyframes rc-loader-turn {
      0% { transform: scaleX(1); }
      100% { transform: scaleX(-1); }
    }

    @keyframes rc-loader-out {
      to { opacity: 0; visibility: hidden; }
    }

    @media (prefers-reduced-motion: reduce) {
      .rc-loader__turning { animation: none; }
    }
  </style>

{%- endif -%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_libro_reclamaciones %} section-floating section-floating--block-end{% endif %}"{% if section.settings.floating_libro_reclamaciones %} style="border-end-start-radius: {{ section.settings.libro_reclamaciones_border_radius }}px; border-end-end-radius: {{ section.settings.libro_reclamaciones_border_radius }}px; overflow: hidden;"{% endif %}>
  {%- if section.settings.show_loader and request.design_mode == false -%}
    <div class="rc-loader color-scheme color-scheme--{{ section.settings.color_scheme.id }}" role="status" aria-live="polite">
      <svg class="rc-loader__book" viewBox="0 0 64 64" aria-hidden="true">
        <path d="M32 14 C26 11 16 11 8 13 V48 C16 46 26 46 32 49 C38 46 48 46 56 48 V13 C48 11 38 11 32 14 Z"/>
        <path d="M32 14 V49"/>
        <path class="rc-loader__turning" d="M32 14 C38 11 48 11 56 13 V48 C48 46 38 46 32 49 Z"/>
      </svg>
      <p class="rc-loader__text">{{ section.settings.loader_text }}</p>
    </div>
  {%- endif -%}
  <div class="section-spacing">
    <div class="container">
      <div class="section-stack">
        {{- section_header -}}
        {{- section_main_content -}}
      </div>
    </div>
  </div>
</div>

{{ 'libro-reclamaciones.css' | asset_url | stylesheet_tag }}
<script src="{{ 'libro-reclamaciones.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.libro_reclamaciones.name",
  "class": "shopify-section--libro-reclamaciones",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.libro_reclamaciones.editor_notice"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_loader",
      "label": "Mostrar pantalla de carga al abrir la página",
      "info": "Un libro de línea fina que pasa la página durante aproximadamente un segundo, solo sobre esta sección. No se muestra dentro del editor.",
      "default": true
    },
    {
      "type": "text",
      "id": "loader_text",
      "label": "Texto de la pantalla de carga",
      "default": "Cargando el libro de reclamaciones",
      "visible_if": "{{ section.settings.show_loader }}"
    },
    {
      "type": "checkbox",
      "id": "floating_libro_reclamaciones",
      "label": "Floating Libro de Reclamaciones",
      "info": "Adds margins around the section (bottom and sides), using the store's global side margin.",
      "default": false
    },
    {
      "type": "range",
      "id": "libro_reclamaciones_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0,
      "visible_if": "{{ section.settings.floating_libro_reclamaciones }}"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading",
      "default": "Atención al consumidor"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Libro de Reclamaciones"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:global.text.heading_size",
      "options": [
        { "value": "display-xl", "label": "Display XL" },
        { "value": "display-l", "label": "Display L" },
        { "value": "display-m", "label": "Display M" },
        { "value": "h1", "label": "XX-Large" },
        { "value": "h2", "label": "X-Large" },
        { "value": "h3", "label": "Large" },
        { "value": "h4", "label": "Medium" },
        { "value": "h5", "label": "Small" },
        { "value": "h6", "label": "X-Small" },
        { "value": "h7", "label": "XX-Small" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content",
      "default": "<p>Este canal te permite presentar un reclamo o una queja respecto de productos o servicios adquiridos, conforme a la Ley N.° 29571.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.libro_reclamaciones.provider_header"
    },
    {
      "type": "text",
      "id": "provider_business_name",
      "label": "t:sections.libro_reclamaciones.provider_business_name",
      "default": "[REQUIERE DATO DEL PROVEEDOR]"
    },
    {
      "type": "text",
      "id": "provider_ruc",
      "label": "t:sections.libro_reclamaciones.provider_ruc",
      "default": "[REQUIERE DATO DEL PROVEEDOR]"
    },
    {
      "type": "text",
      "id": "provider_address",
      "label": "t:sections.libro_reclamaciones.provider_address",
      "default": "[REQUIERE DATO DEL PROVEEDOR]"
    },
    {
      "type": "text",
      "id": "provider_email",
      "label": "t:sections.libro_reclamaciones.provider_email",
      "default": "[REQUIERE DATO DEL PROVEEDOR]"
    },
    {
      "type": "richtext",
      "id": "response_deadline_text",
      "label": "t:sections.libro_reclamaciones.response_deadline_text",
      "default": "<p>Atenderemos su reclamo o queja dentro del plazo establecido por la normativa vigente (Decreto Supremo N.° 011-2011-PCM y disposiciones de INDECOPI).</p>"
    },
    {
      "type": "richtext",
      "id": "retention_notice",
      "label": "t:sections.libro_reclamaciones.retention_notice",
      "default": "<p>Sus datos personales se conservarán durante 2 años y se utilizarán únicamente para atender este reclamo o queja, conforme a nuestra Política de Privacidad.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:sections.libro_reclamaciones.name",
      "category": "t:global.categories.call_to_action",
      "settings": {}
    }
  ]
}
{% endschema %}
