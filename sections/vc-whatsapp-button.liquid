{%- liquid
  # Visibilidad
  assign show_on_mobile = section.settings.show_on_mobile
  assign show_on_desktop = section.settings.show_on_desktop
  assign show_button = true
  if show_on_mobile == false and show_on_desktop == false
    assign show_button = false
  endif

  # Agentes / departamentos
  assign agents = section.blocks
  assign has_agents = agents.size > 0

  # Estilo de visualización
  assign display_style = section.settings.display_style
  assign is_docked = display_style == 'docked_tab'

  # Lado (izquierda/derecha): ambos modos siempre quedan pegados al borde lateral elegido
  assign side = 'right'
  if is_docked
    if section.settings.dock_position == 'left'
      assign side = 'left'
    endif
  else
    if section.settings.position == 'bottom-left'
      assign side = 'left'
    endif
  endif

  # Docked Tab: el radio solo va en las esquinas que miran hacia el contenido, nunca hacia el borde de pantalla
  assign dock_radius_tl = 0
  assign dock_radius_tr = 0
  assign dock_radius_bl = 0
  assign dock_radius_br = 0
  if side == 'left'
    assign dock_radius_tr = section.settings.dock_border_radius
    assign dock_radius_br = section.settings.dock_border_radius
  else
    assign dock_radius_tl = section.settings.dock_border_radius
    assign dock_radius_bl = section.settings.dock_border_radius
  endif

  # Textos accesibles
  assign dock_label = section.settings.dock_tab_label | default: 'WhatsApp'
  assign wa_aria_label = 'Chat on WhatsApp'
  if is_docked
    assign wa_aria_label = dock_label
  endif
-%}

{% if show_button %}
  {% comment %}
    Vive fuera de vc-whatsapp-button-wrapper: en modo Docked Tab el wrapper usa transform,
    lo que crearía un containing block nuevo y rompería el position: fixed de este overlay.
  {% endcomment %}
  <div
    class="vc-whatsapp-overlay"
    data-section-id="{{ section.id }}"
    hidden
  ></div>

  <div
    data-section-id="{{ section.id }}"
    class="vc-whatsapp-button-wrapper
      {% if is_docked %}vc-whatsapp-button-wrapper--dock vc-whatsapp-button-wrapper--dock-{{ side }}{% endif %}
      {% unless show_on_mobile %}hide-on-mobile{% endunless %}
      {% unless show_on_desktop %}hide-on-desktop{% endunless %}"
    style="
      --wa-button-size: {{ section.settings.button_size }}px;
      --wa-icon-size: {{ section.settings.icon_size }}px;
      --wa-bg-color: {{ section.settings.background_color }};
      --wa-icon-color: {{ section.settings.icon_color }};
      --wa-agents-radius: {{ section.settings.agents_box_radius }}px;
      --wa-left: {% if is_docked %}{% if side == 'right' %}auto{% else %}0{% endif %}{% else %}{% if side == 'right' %}auto{% else %}var(--container-gutter){% endif %}{% endif %};
      --wa-right: {% if is_docked %}{% if side == 'right' %}0{% else %}auto{% endif %}{% else %}{% if side == 'right' %}var(--container-gutter){% else %}auto{% endif %}{% endif %};
      --wa-anchor-left: {% if side == 'right' %}auto{% else %}0{% endif %};
      --wa-anchor-right: {% if side == 'right' %}0{% else %}auto{% endif %};
      --wa-dock-width: {{ section.settings.dock_width }}px;
      --wa-dock-height: {{ section.settings.dock_height }}px;
      --wa-dock-padding: {{ section.settings.dock_padding }}px;
      --wa-dock-bg: {{ section.settings.dock_background_color }};
      --wa-dock-text: {{ section.settings.dock_text_color }};
      --wa-dock-radius-tl: {{ dock_radius_tl }}px;
      --wa-dock-radius-tr: {{ dock_radius_tr }}px;
      --wa-dock-radius-bl: {{ dock_radius_bl }}px;
      --wa-dock-radius-br: {{ dock_radius_br }}px;
      --wa-dock-text-size-mobile: {{ section.settings.dock_text_size_mobile }}px;
      --wa-dock-text-size-desktop: {{ section.settings.dock_text_size_desktop }}px;
      --wa-dock-vertical-position: {{ section.settings.dock_vertical_position }}%;
    "
  >
    <div class="vc-whatsapp-main-container">
      {% if has_agents %}
        <div class="vc-whatsapp-agents-list color-scheme color-scheme--{{ section.settings.popup_color_scheme.id }}" hidden>
          <div class="vc-whatsapp-agents-list-header">Elige un contacto</div>
          {% for block in agents %}
            {% liquid
              assign agent_message = block.settings.message
              if agent_message == blank
                assign agent_message = section.settings.default_message
              endif
            %}
            <a
              href="#"
              class="vc-whatsapp-agent-item"
              data-phone-number="{{ block.settings.phone_number }}"
              data-message="{{ agent_message | escape }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.name }}
            </a>
          {% endfor %}
        </div>
      {% endif %}

      <a
        href="#"
        class="vc-whatsapp-button"
        aria-label="{{ wa_aria_label }}"
        data-phone-number="{{ section.settings.phone_number }}"
        data-default-message="{{ section.settings.default_message | escape }}"
        data-has-agents="{{ has_agents }}"
        {% if has_agents %}aria-haspopup="true" aria-expanded="false"{% endif %}
      >
        {% if is_docked %}
          <span class="vc-whatsapp-tab-label">{{ dock_label }}</span>
        {% else %}
          {% if section.settings.show_badge %}
            <span class="vc-whatsapp-badge" aria-hidden="true"></span>
          {% endif %}
          <svg class="vc-whatsapp-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
            <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27.1 106.1 27.1h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.5-7.1c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.4-2.5-5.1-4.2-10.6-6.9z"/>
          </svg>
          {%- if section.settings.button_text != blank -%}
            <span class="vc-whatsapp-button-text">{{ section.settings.button_text }}</span>
          {%- endif -%}
        {% endif %}
      </a>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .vc-whatsapp-button-wrapper {
    position: fixed;
    z-index: 100;
    bottom: var(--container-gutter);
    left: var(--wa-left);
    right: var(--wa-right);
    width: fit-content;
    max-width: calc(100vw - (var(--container-gutter) * 2));
  }

  .vc-whatsapp-main-container {
    position: relative;
    display: flex;
  }

  .vc-whatsapp-button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: var(--wa-button-size);
    height: var(--wa-button-size);
    background-color: var(--wa-bg-color);
    border-radius: 50%;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    flex-shrink: 0;
  }

  .vc-whatsapp-button:hover {
    transform: scale(1.1);
  }

  .vc-whatsapp-button:active {
    transform: scale(0.95);
  }

  .vc-whatsapp-icon {
    width: var(--wa-icon-size);
    height: var(--wa-icon-size);
    fill: var(--wa-icon-color);
    flex-shrink: 0;
  }

  .vc-whatsapp-button-text {
    color: var(--wa-icon-color);
    font-size: calc(var(--wa-icon-size) * 0.8);
    font-weight: bold;
    padding-right: 10px;
    white-space: nowrap;
  }

  .vc-whatsapp-button-wrapper:has(.vc-whatsapp-button-text) .vc-whatsapp-button,
  .vc-whatsapp-button-wrapper.has-text .vc-whatsapp-button {
    width: auto;
    padding-left: calc((var(--wa-button-size) - var(--wa-icon-size)) / 2);
  }

  .vc-whatsapp-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 12px;
    height: 12px;
    background-color: #ff3b30;
    border: 2px solid #ffffff;
    border-radius: 50%;
  }

  /* Caja de agentes: sin sombra, radio en px, tipografía heredada del body del tema */
  .vc-whatsapp-agents-list {
    position: absolute;
    bottom: calc(100% + 12px);
    left: var(--wa-anchor-left);
    right: var(--wa-anchor-right);
    min-width: 220px;
    max-width: min(280px, 90vw);
    background-color: rgb(var(--background));
    border-radius: var(--wa-agents-radius);
    border: 1px solid rgb(var(--border-color));
    overflow: hidden;
    font-family: inherit;
  }

  .vc-whatsapp-agents-list[hidden] {
    display: none;
  }

  .vc-whatsapp-agents-list-header {
    padding: 12px 16px;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
    border-bottom: 1px solid rgb(var(--border-color));
  }

  .vc-whatsapp-agent-item {
    display: block;
    padding: 12px 16px;
    color: inherit;
    text-decoration: none;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    border-bottom: 1px solid rgb(var(--border-color));
  }

  .vc-whatsapp-agent-item:last-child {
    border-bottom: none;
  }

  .vc-whatsapp-agent-item:hover {
    background-color: rgb(var(--text-color) / .04);
  }

  .hide-on-mobile {
    @media (max-width: 749px) {
      display: none !important;
    }
  }

  .hide-on-desktop {
    @media (min-width: 750px) {
      display: none !important;
    }
  }

  @media (max-width: 749px) {
    .vc-whatsapp-agents-list {
      min-width: 200px;
    }
  }

  /* Docked Tab: pestaña vertical pegada al borde de la pantalla */
  .vc-whatsapp-button-wrapper--dock {
    top: var(--wa-dock-vertical-position);
    bottom: auto;
    transform: translateY(calc(var(--wa-dock-vertical-position) * -1));
    max-width: none;
  }

  .vc-whatsapp-button-wrapper--dock .vc-whatsapp-button {
    width: var(--wa-dock-width);
    height: var(--wa-dock-height);
    padding: var(--wa-dock-padding);
    background-color: var(--wa-dock-bg);
    border-radius: var(--wa-dock-radius-tl) var(--wa-dock-radius-tr) var(--wa-dock-radius-br) var(--wa-dock-radius-bl);
    overflow: hidden;
  }

  .vc-whatsapp-button-wrapper--dock .vc-whatsapp-button:hover {
    transform: none;
  }

  .vc-whatsapp-tab-label {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    color: var(--wa-dock-text);
    white-space: nowrap;
    font-weight: var(--heading-font-weight, bold);
    font-family: var(--text-font-family);
    font-size: var(--wa-dock-text-size-mobile);
  }

  @media (min-width: 750px) {
    .vc-whatsapp-tab-label {
      font-size: var(--wa-dock-text-size-desktop);
    }
  }

  /* Docked Tab: el panel de agentes nace desde la pestaña en vez de abrirse hacia arriba */
  .vc-whatsapp-button-wrapper--dock .vc-whatsapp-agents-list {
    top: 50%;
    bottom: auto;
    transform: translateY(-50%);
  }

  .vc-whatsapp-button-wrapper--dock-right .vc-whatsapp-agents-list {
    left: auto;
    right: calc(100% + var(--section-stack-row-gap));
  }

  .vc-whatsapp-button-wrapper--dock-left .vc-whatsapp-agents-list {
    left: calc(100% + var(--section-stack-row-gap));
    right: auto;
  }

  /* Blur overlay del tema, reutilizado detrás del popup de agentes solo en móvil */
  .vc-whatsapp-overlay {
    display: none;
  }

  @media (max-width: 749px) {
    .vc-whatsapp-overlay:not([hidden]) {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 99;
      background: rgb(var(--page-overlay));
      -webkit-backdrop-filter: blur(var(--dialog-backdrop-blur));
      backdrop-filter: blur(var(--dialog-backdrop-blur));
    }
  }
{% endstylesheet %}

{% javascript %}
(function() {
  function initWhatsappButtons() {
    document.querySelectorAll('.vc-whatsapp-button-wrapper').forEach(function(wrapper) {
      if (wrapper.dataset.waInitialized === 'true') return;
      wrapper.dataset.waInitialized = 'true';

      var sectionId = wrapper.dataset.sectionId;

      if (wrapper.querySelector('.vc-whatsapp-button-text')) {
        wrapper.classList.add('has-text');
      }

      var button = wrapper.querySelector('.vc-whatsapp-button');
      if (!button) return;

      var hasAgents = button.dataset.hasAgents === 'true';
      var agentsList = wrapper.querySelector('.vc-whatsapp-agents-list');
      var overlay = wrapper.parentElement
        ? wrapper.parentElement.querySelector('.vc-whatsapp-overlay[data-section-id="' + sectionId + '"]')
        : null;

      function openWhatsapp(phoneNumber, message) {
        if (!phoneNumber) {
          console.error('WhatsApp button: Phone number is not set.');
          return;
        }
        var encodedMessage = encodeURIComponent(message || '');
        var whatsappUrl = 'https://wa.me/' + phoneNumber + '?text=' + encodedMessage;
        window.open(whatsappUrl, '_blank', 'noopener');
      }

      button.addEventListener('click', function(event) {
        event.preventDefault();
        if (hasAgents && agentsList) {
          agentsList.hidden = !agentsList.hidden;
          button.setAttribute('aria-expanded', String(!agentsList.hidden));
          if (overlay) overlay.hidden = agentsList.hidden;
          return;
        }
        openWhatsapp(button.dataset.phoneNumber, button.dataset.defaultMessage);
      });

      if (agentsList) {
        agentsList.querySelectorAll('.vc-whatsapp-agent-item').forEach(function(item) {
          item.addEventListener('click', function(event) {
            event.preventDefault();
            openWhatsapp(item.dataset.phoneNumber, item.dataset.message);
            agentsList.hidden = true;
            button.setAttribute('aria-expanded', 'false');
            if (overlay) overlay.hidden = true;
          });
        });

        document.addEventListener('click', function(event) {
          if (!wrapper.contains(event.target)) {
            agentsList.hidden = true;
            button.setAttribute('aria-expanded', 'false');
            if (overlay) overlay.hidden = true;
          }
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWhatsappButtons);
  } else {
    initWhatsappButtons();
  }

  document.addEventListener('shopify:section:load', initWhatsappButtons);
})();
{% endjavascript %}

{% schema %}
{
  "name": "VC WhatsApp Button",
  "class": "vc-whatsapp-button-section",
  "settings": [
    { "type": "header", "content": "Estilo de visualización" },
    { "type": "select", "id": "display_style", "label": "Display Style", "options": [{ "value": "floating", "label": "Floating" }, { "value": "docked_tab", "label": "Docked Tab" }], "default": "floating" },
    { "type": "header", "content": "Contenido" },
    { "type": "text", "id": "phone_number", "label": "Número de teléfono principal", "info": "Incluye el código de país (ej. 51987654321 para Perú). Se usa si no agregas agentes." },
    { "type": "textarea", "id": "default_message", "label": "Mensaje predeterminado", "default": "Hola, estoy interesado en tus productos." },

    { "type": "header", "content": "Floating: texto y posición", "visible_if": "{{ section.settings.display_style == 'floating' }}" },
    { "type": "text", "id": "button_text", "label": "Texto del botón (opcional)", "info": "Si se deja en blanco, solo se mostrará el ícono.", "visible_if": "{{ section.settings.display_style == 'floating' }}" },
    { "type": "select", "id": "position", "label": "Posición", "options": [{ "value": "bottom-right", "label": "Abajo a la derecha" }, { "value": "bottom-left", "label": "Abajo a la izquierda" }], "default": "bottom-right", "visible_if": "{{ section.settings.display_style == 'floating' }}" },
    { "type": "paragraph", "content": "El espacio respecto a los bordes de la pantalla se ajusta automáticamente al margen lateral del tema, tanto en escritorio como en móvil.", "visible_if": "{{ section.settings.display_style == 'floating' }}" },

    { "type": "header", "content": "Floating: diseño", "visible_if": "{{ section.settings.display_style == 'floating' }}" },
    { "type": "range", "id": "button_size", "label": "Tamaño del botón", "min": 40, "max": 100, "step": 2, "unit": "px", "default": 60, "visible_if": "{{ section.settings.display_style == 'floating' }}" },
    { "type": "range", "id": "icon_size", "label": "Tamaño del ícono", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 30, "visible_if": "{{ section.settings.display_style == 'floating' }}" },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#25D366", "visible_if": "{{ section.settings.display_style == 'floating' }}" },
    { "type": "color", "id": "icon_color", "label": "Color del ícono y texto", "default": "#FFFFFF", "visible_if": "{{ section.settings.display_style == 'floating' }}" },

    { "type": "header", "content": "Docked Tab: posición y tamaño", "visible_if": "{{ section.settings.display_style == 'docked_tab' }}" },
    { "type": "select", "id": "dock_position", "label": "Position", "options": [{ "value": "right", "label": "Right" }, { "value": "left", "label": "Left" }], "default": "right", "visible_if": "{{ section.settings.display_style == 'docked_tab' }}" },
    { "type": "range", "id": "dock_vertical_position", "label": "Posición vertical", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50, "info": "0% = arriba, 50% = centrado, 100% = abajo", "visible_if": "{{ section.settings.display_style == 'docked_tab' }}" },
    { "type": "range", "id": "dock_width", "label": "Width", "min": 30, "max": 120, "step": 2, "unit": "px", "default": 44, "visible_if": "{{ section.settings.display_style == 'docked_tab' }}" },
    { "type": "range", "id": "dock_height", "label": "Height", "min": 60, "max": 300, "step": 5, "unit": "px", "default": 140, "visible_if": "{{ section.settings.display_style == 'docked_tab' }}" },
    { "type": "range", "id": "dock_padding", "label": "Padding", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 10, "visible_if": "{{ section.settings.display_style == 'docked_tab' }}" },
    { "type": "range", "id": "dock_border_radius", "label": "Border Radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 8, "visible_if": "{{ section.settings.display_style == 'docked_tab' }}" },

    { "type": "header", "content": "Docked Tab: colores", "visible_if": "{{ section.settings.display_style == 'docked_tab' }}" },
    { "type": "color", "id": "dock_background_color", "label": "Background Color", "default": "#25D366", "visible_if": "{{ section.settings.display_style == 'docked_tab' }}" },
    { "type": "color", "id": "dock_text_color", "label": "Text Color", "default": "#FFFFFF", "visible_if": "{{ section.settings.display_style == 'docked_tab' }}" },

    { "type": "header", "content": "Docked Tab: texto", "visible_if": "{{ section.settings.display_style == 'docked_tab' }}" },
    { "type": "text", "id": "dock_tab_label", "label": "Tab Label", "default": "WhatsApp", "visible_if": "{{ section.settings.display_style == 'docked_tab' }}" },
    { "type": "range", "id": "dock_text_size_desktop", "label": "Tamaño de texto (Desktop)", "min": 10, "max": 28, "step": 1, "unit": "px", "default": 14, "visible_if": "{{ section.settings.display_style == 'docked_tab' }}" },
    { "type": "range", "id": "dock_text_size_mobile", "label": "Tamaño de texto (Mobile)", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 12, "visible_if": "{{ section.settings.display_style == 'docked_tab' }}" },

    { "type": "header", "content": "Colores del popup" },
    { "type": "color_scheme", "id": "popup_color_scheme", "label": "Esquema de color (caja de agentes)", "default": "scheme-1" },
    { "type": "header", "content": "Notificación", "visible_if": "{{ section.settings.display_style == 'floating' }}" },
    { "type": "checkbox", "id": "show_badge", "label": "Mostrar punto de notificación", "default": false, "visible_if": "{{ section.settings.display_style == 'floating' }}" },
    { "type": "header", "content": "Caja de agentes" },
    { "type": "range", "id": "agents_box_radius", "label": "Radio de la caja de agentes", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 12 },
    { "type": "header", "content": "Comportamiento" },
    { "type": "checkbox", "id": "show_on_mobile", "label": "Mostrar en móvil", "default": true },
    { "type": "checkbox", "id": "show_on_desktop", "label": "Mostrar en escritorio", "default": true }
  ],
  "blocks": [
    {
      "type": "agent",
      "name": "Agente / Departamento",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre", "default": "Ventas" },
        { "type": "text", "id": "phone_number", "label": "Número de teléfono", "info": "Incluye el código de país (ej. 51987654321)" },
        { "type": "textarea", "id": "message", "label": "Mensaje (opcional)", "info": "Si se deja en blanco, usa el mensaje predeterminado general." }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    { "name": "VC WhatsApp Button" }
  ]
}
{% endschema %}