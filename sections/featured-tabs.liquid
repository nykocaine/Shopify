        },
        {
          "type": "image_picker",
          "id": "tab_4_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tab_4_label",
          "label": "Label"
        },
        {
          "type": "image_picker",
          "id": "tab_4_icon",
          "label": "Decorative icon"
        },
        {
          "type": "text",
          "id": "tab_4_text",
