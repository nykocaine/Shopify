{%- liquid
  assign feature_tab_count = 0
  assign feature_tab_first_index = 0

  for i in (1..5)
    capture tab_image_key
      echo 'tab_'
      echo i
      echo '_image'
    endcapture

    assign tab_image = section.settings[tab_image_key]

    if tab_image != blank
      assign feature_tab_count = feature_tab_count | plus: 1

      if feature_tab_first_index == 0
        assign feature_tab_first_index = i
      endif
    endif
  endfor
-%}

{%- if feature_tab_count > 0 -%}
  <style>
    {%- comment -%}
    Top section spacing as margin instead of padding, so it reads the same way as the other
    converted sections. display: flow-root on the outer wrapper contains that margin (stops it
    collapsing through the wrapper's own top edge).
    {%- endcomment -%}
    #shopify-section-{{ section.id }} > div {
      display: flow-root;
    }

    #shopify-section-{{ section.id }} .section-spacing {
      padding-block-start: 0;
      padding-block-end: 0;
      margin-block-start: calc(var(--section-disable-padding-collapsing) * var(--section-vertical-spacing-block-start, var(--section-vertical-spacing)));
    }

    #shopify-section-{{ section.id }} .featured-tabs {
      grid-template-columns: minmax(0, 1fr);
      gap: {% if section.settings.column_spacing == 'none' %}0px{% elsif section.settings.column_spacing == 'sm' %}calc(var(--container-gutter) / 2){% elsif section.settings.column_spacing == 'md' %}var(--container-gutter){% else %}calc(var(--container-gutter) * 1.5){% endif %};
      display: grid;
    }

    {%- comment -%}
    No gap between the two halves: they form a single continuous card, radius on the outer
    wrapper only (matches media-blocks' own column_spacing == 'none' behavior). Any gap: each half
    reads as its own independent card and gets the radius itself instead.
    {%- endcomment -%}
    {%- if section.settings.column_spacing == 'none' -%}
      #shopify-section-{{ section.id }} .featured-tabs {
        border-radius: {{ section.settings.corner_radius }}px;
        overflow: hidden;
      }
    {%- else -%}
      #shopify-section-{{ section.id }} .feature-tabs__media,
      #shopify-section-{{ section.id }} .feature-tabs__content {
        border-radius: {{ section.settings.corner_radius }}px;
        overflow: hidden;
      }
    {%- endif -%}

    {%- comment -%}
    Real horizontal track (like a physical filmstrip), not overlapping items each animating on
    their own: every slide sits side by side in one wide track, and switching tabs only ever moves
    that track's own translateX - the same technique the reference site's Swiper carousel uses.
    Both the media track and the content track move together, using the exact same offset.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .feature-tabs__media {
      position: relative;
      overflow: hidden;
    }

    {%- comment -%}
    position: absolute + inset (not height: 100%) to fill .feature-tabs__media: that parent only
    has a min-height (from the block-size utility class below), and percentage heights don't
    reliably resolve against an ancestor whose height comes from min-height rather than an explicit
    height - inset resolves against the actual laid-out box either way, so the track (and the
    images inside it) correctly fill/crop to whatever height min-height ends up producing.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .feature-tabs__media-track {
      position: absolute;
      inset-block: 0;
      display: flex;
      transition: transform .5s ease;
    }

    #shopify-section-{{ section.id }} .feature-tabs__media-item {
      height: 100%;
      flex: none;
      position: relative;
    }

    #shopify-section-{{ section.id }} .feature-tabs__content {
      padding: min(2.5rem, var(--container-gutter));
      display: grid;
      align-content: space-between;
      gap: 2rem;
    }

    #shopify-section-{{ section.id }} .feature-tabs__panels {
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .feature-tabs__panels-track {
      align-items: start;
      display: flex;
      transition: transform .5s ease;
    }

    #shopify-section-{{ section.id }} .feature-tabs__panel {
      flex: none;
    }

    #shopify-section-{{ section.id }} .feature-tabs__panel-heading {
      align-items: center;
      gap: 1rem;
      display: flex;
    }

    #shopify-section-{{ section.id }} .feature-tabs__panel-heading hr {
      flex: 1;
    }

    #shopify-section-{{ section.id }} .feature-tabs__panel-icon {
      flex: none;
      width: 3rem;
    }

    {%- comment -%}
    Buttons and their label sit in the same grid, matched up by grid-column (set inline per item,
    same index counter in both loops) - the label always lands centered under its own button,
    without needing JS to measure/position it. Carries its own color-scheme (for --accent/
    --border-color, used below) but with no background of its own - only the tab circles
    themselves should read as colored, not a panel behind them.

    justify-content: space-between (instead of a fixed column-gap + center) spreads the tabs across
    the box's full available width - stretches automatically to fill .feature-tabs__content's own
    width (its own padding never changes, this just fills what's inside it) so there's no leftover
    space at the sides and the row never overflows on narrow screens. column-gap stays only as a
    safety minimum, in case space-between alone would ever push tabs closer than that.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .feature-tabs__tabs {
      background: none;
      width: 100%;
      column-gap: .75rem;
      row-gap: .75rem;
      justify-content: space-between;
      display: grid;
    }

    #shopify-section-{{ section.id }} .feature-tabs__tab {
      grid-row: 1;
      width: {{ section.settings.tabs_size_mobile }}px;
      aspect-ratio: 1;
      border: 1px solid rgb({{ section.settings.content_color_scheme.settings.border_color.rgb }});
      border-radius: 100%;
      place-items: center;
      display: grid;
      cursor: pointer;
      transition: background-color .3s ease, border-color .3s ease, color .3s ease;
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .feature-tabs__tab {
        width: {{ section.settings.tabs_size_desktop }}px;
      }
    }

    #shopify-section-{{ section.id }} .feature-tabs__tab.is-active {
      background: {% if section.settings.tabs_active_color != blank %}{{ section.settings.tabs_active_color }}{% else %}rgb(var(--accent)){% endif %};
      color: rgb(var(--background));
    }

    #shopify-section-{{ section.id }} .feature-tabs__tab-label {
      grid-row: 2;
      justify-self: center;
      opacity: 0;
      transition: opacity .3s ease;
    }

    #shopify-section-{{ section.id }} .feature-tabs__tab-label.is-active {
      opacity: 1;
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .featured-tabs {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      }
    }
  </style>

  <div class="{% if section.settings.floating_featured_tabs %}section-floating section-floating--block-end{% endif %}">
    <div class="{% unless section.settings.floating_featured_tabs %}section-spacing{% endunless %}">
      <div class="{% unless section.settings.floating_featured_tabs %}container{% endunless %}">
        <div id="feature-tabs-{{ section.id }}" class="featured-tabs">
          <div class="feature-tabs__media min-h-{{ section.settings.mobile_block_size }} md:min-h-{{ section.settings.block_size }}">
            <div id="feature-tabs-media-track-{{ section.id }}" class="feature-tabs__media-track" style="width: {{ feature_tab_count | times: 100 }}%;">
              {%- for i in (1..5) -%}
                {%- capture tab_image_key -%}tab_{{ i }}_image{%- endcapture -%}
                {%- assign tab_image = section.settings[tab_image_key] -%}

                {%- if tab_image != blank -%}
                  <div class="feature-tabs__media-item" style="width: {{ 100.0 | divided_by: feature_tab_count }}%;">
                    {{- tab_image | image_url: width: tab_image.width | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 100vw, 50vw', widths: '400,600,800,1000,1200,1400,1600,1800', class: 'image-cover' -}}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          <div class="feature-tabs__content color-scheme color-scheme--{{ section.settings.content_color_scheme.id }}">
            {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
              <div class="prose">
                {%- if section.settings.title != blank -%}
                  {%- render 'heading', content: section.settings.title, style: 'h3', html_tag: 'h2' -%}
                {%- endif -%}

                {%- if section.settings.subtitle != blank -%}
                  <p class="text-subdued">{{ section.settings.subtitle }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="feature-tabs__panels">
              <div id="feature-tabs-panels-track-{{ section.id }}" class="feature-tabs__panels-track" style="width: {{ feature_tab_count | times: 100 }}%;">
                {%- for i in (1..5) -%}
                  {%- capture tab_image_key -%}tab_{{ i }}_image{%- endcapture -%}
                  {%- capture tab_label_key -%}tab_{{ i }}_label{%- endcapture -%}
                  {%- capture tab_icon_key -%}tab_{{ i }}_icon{%- endcapture -%}
                  {%- capture tab_text_key -%}tab_{{ i }}_text{%- endcapture -%}

                  {%- assign tab_image = section.settings[tab_image_key] -%}
                  {%- assign tab_label = section.settings[tab_label_key] -%}
                  {%- assign tab_icon = section.settings[tab_icon_key] -%}
                  {%- assign tab_text = section.settings[tab_text_key] -%}

                  {%- if tab_image != blank -%}
                    <div class="feature-tabs__panel v-stack gap-4" style="width: {{ 100.0 | divided_by: feature_tab_count }}%;">
                      {%- if tab_label != blank or tab_icon != blank -%}
                        <div class="feature-tabs__panel-heading">
                          {%- if tab_label != blank -%}
                            <span class="medium">{{ tab_label }}</span>
                          {%- endif -%}

                          <hr>

                          {%- if tab_icon != blank -%}
                            {{- tab_icon | image_url: width: tab_icon.width | image_tag: loading: 'lazy', sizes: '48px', class: 'feature-tabs__panel-icon' -}}
                          {%- endif -%}
                        </div>
                      {%- endif -%}

                      {%- if tab_text != blank -%}
                        <p>{{ tab_text }}</p>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

            <div class="feature-tabs__tabs" role="tablist">
              {%- assign feature_tab_column = 0 -%}
              {%- for i in (1..5) -%}
                {%- capture tab_image_key -%}tab_{{ i }}_image{%- endcapture -%}
                {%- assign tab_image = section.settings[tab_image_key] -%}

                {%- if tab_image != blank -%}
                  {%- assign feature_tab_column = feature_tab_column | plus: 1 -%}
                  <button type="button" class="feature-tabs__tab {% if i == feature_tab_first_index %}is-active{% endif %}" data-tab-index="{{ i }}" data-tab-position="{{ feature_tab_column }}" style="grid-column: {{ feature_tab_column }};" role="tab" aria-selected="{% if i == feature_tab_first_index %}true{% else %}false{% endif %}">
                    <span class="subheading">0{{ i }}</span>
                  </button>
                {%- endif -%}
              {%- endfor -%}

              {%- assign feature_tab_column = 0 -%}
              {%- for i in (1..5) -%}
                {%- capture tab_image_key -%}tab_{{ i }}_image{%- endcapture -%}
                {%- capture tab_number_label_key -%}tab_{{ i }}_number_label{%- endcapture -%}

                {%- assign tab_image = section.settings[tab_image_key] -%}
                {%- assign tab_number_label = section.settings[tab_number_label_key] -%}

                {%- if tab_image != blank -%}
                  {%- assign feature_tab_column = feature_tab_column | plus: 1 -%}

                  {%- if tab_number_label != blank -%}
                    <span class="feature-tabs__tab-label subheading text-subdued {% if i == feature_tab_first_index %}is-active{% endif %}" data-tab-panel="{{ i }}" style="grid-column: {{ feature_tab_column }};">{{ tab_number_label }}</span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function() {
      var root = document.getElementById('feature-tabs-{{ section.id }}');
      if (!root) return;

      var tabs = root.querySelectorAll('[data-tab-index]');
      var tabLabels = root.querySelectorAll('.feature-tabs__tab-label[data-tab-panel]');
      var mediaTrack = document.getElementById('feature-tabs-media-track-{{ section.id }}');
      var panelsTrack = document.getElementById('feature-tabs-panels-track-{{ section.id }}');
      var slideCount = {{ feature_tab_count }};

      {%- comment -%}
      Real track, like a physical filmstrip: both tracks are slideCount * 100% wide, each slide is
      1/slideCount of that. Moving to slide N only ever sets one translateX on the track itself
      (position-1 slide-widths to the left) - the same technique the reference site's carousel uses,
      instead of animating every individual slide's own position/opacity.
      {%- endcomment -%}
      function activate(index, position) {
        tabs.forEach(function(tab) {
          var isActive = tab.getAttribute('data-tab-index') === index;
          tab.classList.toggle('is-active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        var offset = 'translateX(calc(-1 * ' + (position - 1) + ' * ' + (100 / slideCount) + '%))';
        if (mediaTrack) mediaTrack.style.transform = offset;
        if (panelsTrack) panelsTrack.style.transform = offset;

        tabLabels.forEach(function(label) {
          label.classList.toggle('is-active', label.getAttribute('data-tab-panel') === index);
        });
      }

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          activate(tab.getAttribute('data-tab-index'), Number(tab.getAttribute('data-tab-position')));
        });
      });

      if (window.matchMedia('(pointer: fine)').matches) {
        tabs.forEach(function(tab) {
          tab.addEventListener('mouseenter', function() {
            activate(tab.getAttribute('data-tab-index'), Number(tab.getAttribute('data-tab-position')));
          });
        });
      }
    })();
  </script>
{%- endif -%}

