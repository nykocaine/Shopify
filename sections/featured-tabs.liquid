{%- if section.blocks.size > 0 -%}
  <style>
    #shopify-section-{{ section.id }} {
      --media-blocks-grid: {% if section.settings.stack_on_mobile %}auto-flow / minmax(0, 1fr){% else %}auto / auto-flow 78vw{% endif %};
      --media-blocks-gap: {% if section.settings.column_spacing == 'none' %}0px{% elsif section.settings.column_spacing == 'sm' %}calc(var(--container-gutter) / 2){% elsif section.settings.column_spacing == 'md' %}var(--container-gutter){% elsif section.settings.column_spacing == 'lg' %}calc(var(--container-gutter) * 1.5){% endif %};
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --media-blocks-grid: {% if section.settings.stack_on_mobile or section.blocks.size <= 2 %}auto / repeat(2, minmax(0, 1fr)){% else %}auto / auto-flow 45vw{% endif %};
      }
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} {
        --media-blocks-grid: auto-flow / repeat({{ section.settings.items_per_row }}, minmax(0, 1fr));
      }
    }

    {%- comment -%}
    Corner radius (outer corners only) - same mechanism as media-blocks.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} {
      --media-blocks-corner-radius: {% if section.settings.auto_corner_radius %}clamp({{ section.settings.corner_radius | times: 0.5 | round }}px, 3vw, {{ section.settings.corner_radius }}px){% else %}{{ section.settings.corner_radius }}px{% endif %};
    }

    #shopify-section-{{ section.id }} .media-blocks__item {
      overflow: hidden;
    }

    {%- if section.settings.column_spacing == 'none' -%}
      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .media-blocks > *:first-child .media-blocks__item,
        #shopify-section-{{ section.id }} .media-blocks > *:first-child.media-blocks__item {
          border-top-left-radius: var(--media-blocks-corner-radius);
          border-bottom-left-radius: var(--media-blocks-corner-radius);
        }

        #shopify-section-{{ section.id }} .media-blocks > *:last-child .media-blocks__item,
        #shopify-section-{{ section.id }} .media-blocks > *:last-child.media-blocks__item {
          border-top-right-radius: var(--media-blocks-corner-radius);
          border-bottom-right-radius: var(--media-blocks-corner-radius);
        }
      }

      @media screen and (max-width: 699px) {
        {%- if section.settings.stack_on_mobile -%}
          #shopify-section-{{ section.id }} .media-blocks > *:first-child .media-blocks__item,
          #shopify-section-{{ section.id }} .media-blocks > *:first-child.media-blocks__item {
            border-top-left-radius: var(--media-blocks-corner-radius);
            border-top-right-radius: var(--media-blocks-corner-radius);
          }

          #shopify-section-{{ section.id }} .media-blocks > *:last-child .media-blocks__item,
          #shopify-section-{{ section.id }} .media-blocks > *:last-child.media-blocks__item {
            border-bottom-left-radius: var(--media-blocks-corner-radius);
            border-bottom-right-radius: var(--media-blocks-corner-radius);
          }
        {%- else -%}
          #shopify-section-{{ section.id }} .media-blocks > *:first-child .media-blocks__item,
          #shopify-section-{{ section.id }} .media-blocks > *:first-child.media-blocks__item {
            border-top-left-radius: var(--media-blocks-corner-radius);
            border-bottom-left-radius: var(--media-blocks-corner-radius);
          }

          #shopify-section-{{ section.id }} .media-blocks > *:last-child .media-blocks__item,
          #shopify-section-{{ section.id }} .media-blocks > *:last-child.media-blocks__item {
            border-top-right-radius: var(--media-blocks-corner-radius);
            border-bottom-right-radius: var(--media-blocks-corner-radius);
          }
        {%- endif -%}
      }
    {%- else -%}
      #shopify-section-{{ section.id }} .media-blocks__item {
        border-radius: var(--media-blocks-corner-radius);
      }
    {%- endif -%}

    {%- comment -%}
    Top section spacing as margin instead of padding (matches media-blocks and the other converted
    sections). display: flow-root on the outer wrapper contains that margin so it doesn't collapse
    through the wrapper's own top edge.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} > div {
      display: flow-root;
    }

    #shopify-section-{{ section.id }} .section-spacing {
      padding-block-start: 0;
      padding-block-end: 0;
      margin-block-start: calc(var(--section-disable-padding-collapsing) * var(--section-vertical-spacing-block-start, var(--section-vertical-spacing)));
    }
  </style>

  <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_featured_tabs %} section-floating section-floating--block-end{% endif %}">
    <div class="section-spacing">
      <div class="section-stack">
        {%- if section.settings.subheading != blank or section.settings.title != blank or section.settings.content != blank -%}
          <div class="{% unless section.settings.floating_featured_tabs %}container{% endunless %}">
            <div class="prose prose-justify-{{ section.settings.text_alignment }}">
              {%- if section.settings.subheading != blank -%}
                {%- render 'subheading', content: section.settings.subheading -%}
              {%- endif -%}

              {%- if section.settings.title != blank -%}
                {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_tag, html_tag: 'h2' -%}
              {%- endif -%}

              {%- if section.settings.content != blank -%}
                <div class="max-w-xs">
                  {{- section.settings.content -}}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="media-blocks {% unless section.settings.stack_on_mobile %}scroll-area bleed{% endunless %}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'feature_tabs' -%}
                {%- liquid
                  assign feature_tab_count = 0
                  assign feature_tab_first_index = 0

                  for i in (1..5)
                    capture tab_image_key
                      echo 'tab_'
                      echo i
                      echo '_image'
                    endcapture

                    assign tab_image = block.settings[tab_image_key]

                    if tab_image != blank
                      assign feature_tab_count = feature_tab_count | plus: 1

                      if feature_tab_first_index == 0
                        assign feature_tab_first_index = i
                      endif
                    endif
                  endfor
                -%}

                {%- if feature_tab_count > 0 -%}
                  <style>
                    #feature-tabs-{{ block.id }} {
                      grid-template-columns: minmax(0, 1fr);
                      display: grid;
                    }

                    #feature-tabs-{{ block.id }} .feature-tabs__media {
                      aspect-ratio: 4 / 5;
                      position: relative;
                    }

                    #feature-tabs-{{ block.id }} .feature-tabs__media-item {
                      inset: 0;
                      position: absolute;
                    }

                    #feature-tabs-{{ block.id }} .feature-tabs__media-item[hidden] {
                      display: none;
                    }

                    #feature-tabs-{{ block.id }} .feature-tabs__content {
                      padding: min(2.5rem, var(--container-gutter));
                      display: grid;
                      align-content: space-between;
                      gap: 2rem;
                    }

                    #feature-tabs-{{ block.id }} .feature-tabs__panel[hidden] {
                      display: none;
                    }

                    #feature-tabs-{{ block.id }} .feature-tabs__panel-heading {
                      align-items: center;
                      gap: 1rem;
                      display: flex;
                    }

                    #feature-tabs-{{ block.id }} .feature-tabs__panel-heading hr {
                      flex: 1;
                    }

                    #feature-tabs-{{ block.id }} .feature-tabs__panel-icon {
                      flex: none;
                      width: 3rem;
                    }

                    #feature-tabs-{{ block.id }} .feature-tabs__tablist {
                      align-items: start;
                      gap: 1.25rem;
                      display: flex;
                    }

                    #feature-tabs-{{ block.id }} .feature-tabs__tab {
                      flex: none;
                      width: 3.5rem;
                      aspect-ratio: 1;
                      border: 1px solid rgb(var(--border-color));
                      border-radius: 100%;
                      place-items: center;
                      display: grid;
                      cursor: pointer;
                    }

                    #feature-tabs-{{ block.id }} .feature-tabs__tab.is-active {
                      background: rgb(var(--accent));
                      border-color: rgb(var(--accent));
                      color: rgb(var(--background));
                    }

                    @media screen and (min-width: 700px) {
                      #feature-tabs-{{ block.id }} {
                        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
                      }

                      #feature-tabs-{{ block.id }} .feature-tabs__media {
                        aspect-ratio: auto;
                      }
                    }
                  </style>

                  <div id="feature-tabs-{{ block.id }}" class="media-blocks__item {% if section.settings.add_border %}media-blocks__item--bordered{% endif %} feature-tabs" {{ block.shopify_attributes }}>
                    <div class="feature-tabs__media">
                      {%- for i in (1..5) -%}
                        {%- capture tab_image_key -%}tab_{{ i }}_image{%- endcapture -%}
                        {%- assign tab_image = block.settings[tab_image_key] -%}

                        {%- if tab_image != blank -%}
                          <div class="feature-tabs__media-item" data-tab-panel="{{ i }}" {% unless i == feature_tab_first_index %}hidden{% endunless %}>
                            {{- tab_image | image_url: width: tab_image.width | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 100vw, 50vw', widths: '400,600,800,1000,1200,1400,1600,1800', class: 'image-cover' -}}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                    <div class="feature-tabs__content color-scheme color-scheme--{{ block.settings.color_scheme.id }}">
                      {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
                        <div class="prose">
                          {%- if block.settings.title != blank -%}
                            {%- render 'heading', content: block.settings.title, style: 'h3', html_tag: 'h2' -%}
                          {%- endif -%}

                          {%- if block.settings.subtitle != blank -%}
                            <p class="text-subdued">{{ block.settings.subtitle }}</p>
                          {%- endif -%}
                        </div>
                      {%- endif -%}

                      <div class="feature-tabs__panels">
                        {%- for i in (1..5) -%}
                          {%- capture tab_image_key -%}tab_{{ i }}_image{%- endcapture -%}
                          {%- capture tab_label_key -%}tab_{{ i }}_label{%- endcapture -%}
                          {%- capture tab_icon_key -%}tab_{{ i }}_icon{%- endcapture -%}
                          {%- capture tab_text_key -%}tab_{{ i }}_text{%- endcapture -%}

                          {%- assign tab_image = block.settings[tab_image_key] -%}
                          {%- assign tab_label = block.settings[tab_label_key] -%}
                          {%- assign tab_icon = block.settings[tab_icon_key] -%}
                          {%- assign tab_text = block.settings[tab_text_key] -%}

                          {%- if tab_image != blank -%}
                            <div class="feature-tabs__panel v-stack gap-4" data-tab-panel="{{ i }}" {% unless i == feature_tab_first_index %}hidden{% endunless %}>
                              {%- if tab_label != blank or tab_icon != blank -%}
                                <div class="feature-tabs__panel-heading">
                                  {%- if tab_label != blank -%}
                                    <span class="medium">{{ tab_label }}</span>
                                  {%- endif -%}

                                  <hr>

                                  {%- if tab_icon != blank -%}
                                    {{- tab_icon | image_url: width: tab_icon.width | image_tag: loading: 'lazy', sizes: '48px', class: 'feature-tabs__panel-icon' -}}
                                  {%- endif -%}
                                </div>
                              {%- endif -%}

                              {%- if tab_text != blank -%}
                                <p>{{ tab_text }}</p>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>

                      <div class="feature-tabs__tabs v-stack gap-3 justify-items-start">
                        <div class="feature-tabs__tablist" role="tablist">
                          {%- for i in (1..5) -%}
                            {%- capture tab_image_key -%}tab_{{ i }}_image{%- endcapture -%}
                            {%- assign tab_image = block.settings[tab_image_key] -%}

                            {%- if tab_image != blank -%}
                              <button type="button" class="feature-tabs__tab {% if i == feature_tab_first_index %}is-active{% endif %}" data-tab-index="{{ i }}" role="tab" aria-selected="{% if i == feature_tab_first_index %}true{% else %}false{% endif %}">
                                <span class="subheading">0{{ i }}</span>
                              </button>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>

                        <div class="feature-tabs__tab-label">
                          {%- for i in (1..5) -%}
                            {%- capture tab_image_key -%}tab_{{ i }}_image{%- endcapture -%}
                            {%- capture tab_number_label_key -%}tab_{{ i }}_number_label{%- endcapture -%}

                            {%- assign tab_image = block.settings[tab_image_key] -%}
                            {%- assign tab_number_label = block.settings[tab_number_label_key] -%}

                            {%- if tab_image != blank and tab_number_label != blank -%}
                              <span class="subheading text-subdued" data-tab-panel="{{ i }}" {% unless i == feature_tab_first_index %}hidden{% endunless %}>{{ tab_number_label }}</span>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </div>
                    </div>
                  </div>

                  <script>
                    (function() {
                      var root = document.getElementById('feature-tabs-{{ block.id }}');
                      if (!root) return;

                      var tabs = root.querySelectorAll('[data-tab-index]');
                      var panels = root.querySelectorAll('.feature-tabs__media-item[data-tab-panel], .feature-tabs__panel[data-tab-panel], .feature-tabs__tab-label [data-tab-panel]');

                      function activate(index) {
                        tabs.forEach(function(tab) {
                          var isActive = tab.getAttribute('data-tab-index') === index;
                          tab.classList.toggle('is-active', isActive);
                          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
                        });

                        panels.forEach(function(panel) {
                          panel.hidden = panel.getAttribute('data-tab-panel') !== index;
                        });
                      }

                      tabs.forEach(function(tab) {
                        tab.addEventListener('click', function() {
                          activate(tab.getAttribute('data-tab-index'));
                        });
                      });

                      if (window.matchMedia('(pointer: fine)').matches) {
                        tabs.forEach(function(tab) {
                          tab.addEventListener('mouseenter', function() {
                            activate(tab.getAttribute('data-tab-index'));
                          });
                        });
                      }
                    })();
                  </script>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Featured tabs",
  "class": "shopify-section--featured-tabs",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:global.text.title"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:global.text.heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Large"
        },
        {
          "value": "h3",
          "label": "Medium"
        },
        {
          "value": "h4",
          "label": "Small"
        }
      ],
      "default": "h3"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.text"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "t:global.text.alignment"
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "t:sections.multi_column.stack_on_mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "floating_featured_tabs",
      "label": "Floating",
      "info": "Adds margins around the section (bottom and sides), using the store's global side margin.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "add_border",
      "label": "Add border",
      "default": false
    },
    {
      "type": "select",
      "id": "column_spacing",
      "label": "t:global.spacing.spacing",
      "options": [
        {
          "value": "none",
          "label": "t:global.spacing.spacing_options.none"
        },
        {
          "value": "sm",
          "label": "t:global.spacing.spacing_options.small"
        },
        {
          "value": "md",
          "label": "t:global.spacing.spacing_options.medium"
        },
        {
          "value": "lg",
          "label": "t:global.spacing.spacing_options.large"
        }
      ],
      "default": "sm"
    },
    {
      "type": "checkbox",
      "id": "auto_corner_radius",
      "label": "Automatic corner radius",
      "info": "Scales the corner radius responsively based on screen size, up to the value set below.",
      "default": false
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "items_per_row",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "t:global.sizes.items_per_row_desktop",
      "default": 1
    }
  ],
  "blocks": [
    {
      "type": "feature_tabs",
      "name": "Feature tabs",
      "settings": [
        {
          "type": "paragraph",
          "content": "An interactive block: image on one side, numbered tabs on the other. Hovering or clicking a tab number swaps the image, the label/description, and the highlighted tab. Only tabs with an image assigned are shown - leave any of the 5 slots blank to use fewer."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Take your rhode ON THE GO."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Essentials to throw in your purse or pocket."
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:global.colors.scheme",
          "default": "scheme-2"
        },
        {
          "type": "header",
          "content": "Tab 1"
        },
        {
          "type": "image_picker",
          "id": "tab_1_image",
          "label": "Image"
        },
        {
          "type": "text",
