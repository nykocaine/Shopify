        },
        {
          "type": "text",
          "id": "tab_2_number_label",
          "label": "Tab label"
        },
        {
          "type": "header",
          "content": "Tab 3"
        },
        {
          "type": "image_picker",
          "id": "tab_3_image",
          "label": "Image"
        },
        {
          "type": "text",
