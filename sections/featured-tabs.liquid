{%- liquid
  assign feature_tab_count = 0
  assign feature_tab_first_index = 0

  for i in (1..5)
    capture tab_image_key
      echo 'tab_'
      echo i
      echo '_image'
    endcapture

    assign tab_image = section.settings[tab_image_key]

    if tab_image != blank
      assign feature_tab_count = feature_tab_count | plus: 1

      if feature_tab_first_index == 0
        assign feature_tab_first_index = i
      endif
    endif
  endfor
-%}

{%- if feature_tab_count > 0 -%}
  <style>
    {%- comment -%}
    Top section spacing as margin instead of padding, so it reads the same way as the other
    converted sections. display: flow-root on the outer wrapper contains that margin (stops it
    collapsing through the wrapper's own top edge).
    {%- endcomment -%}
    #shopify-section-{{ section.id }} > div {
      display: flow-root;
    }

    #shopify-section-{{ section.id }} .section-spacing {
      padding-block-start: 0;
      padding-block-end: 0;
      margin-block-start: calc(var(--section-disable-padding-collapsing) * var(--section-vertical-spacing-block-start, var(--section-vertical-spacing)));
    }

    #shopify-section-{{ section.id }} .featured-tabs {
      grid-template-columns: minmax(0, 1fr);
      gap: {% if section.settings.column_spacing == 'none' %}0px{% elsif section.settings.column_spacing == 'sm' %}calc(var(--container-gutter) / 2){% elsif section.settings.column_spacing == 'md' %}var(--container-gutter){% else %}calc(var(--container-gutter) * 1.5){% endif %};
      display: grid;
    }

    {%- comment -%}
    No gap between the two halves: they form a single continuous card, radius on the outer
    wrapper only (matches media-blocks' own column_spacing == 'none' behavior). Any gap: each half
    reads as its own independent card and gets the radius itself instead.
    {%- endcomment -%}
    {%- if section.settings.column_spacing == 'none' -%}
      #shopify-section-{{ section.id }} .featured-tabs {
        border-radius: {{ section.settings.corner_radius }}px;
        overflow: hidden;
      }
    {%- else -%}
      #shopify-section-{{ section.id }} .feature-tabs__media,
      #shopify-section-{{ section.id }} .feature-tabs__content {
        border-radius: {{ section.settings.corner_radius }}px;
        overflow: hidden;
      }
    {%- endif -%}

    #shopify-section-{{ section.id }} .feature-tabs__media {
      aspect-ratio: 4 / 5;
      position: relative;
    }

    #shopify-section-{{ section.id }} .feature-tabs__media-item {
      inset: 0;
      position: absolute;
    }

    #shopify-section-{{ section.id }} .feature-tabs__media-item[hidden] {
      display: none;
    }

    #shopify-section-{{ section.id }} .feature-tabs__content {
      padding: min(2.5rem, var(--container-gutter));
      display: grid;
      align-content: space-between;
      gap: 2rem;
    }

    #shopify-section-{{ section.id }} .feature-tabs__panel[hidden] {
      display: none;
    }

    #shopify-section-{{ section.id }} .feature-tabs__panel-heading {
      align-items: center;
      gap: 1rem;
      display: flex;
    }

    #shopify-section-{{ section.id }} .feature-tabs__panel-heading hr {
      flex: 1;
    }

    #shopify-section-{{ section.id }} .feature-tabs__panel-icon {
      flex: none;
      width: 3rem;
    }

    #shopify-section-{{ section.id }} .feature-tabs__tablist {
      align-items: start;
      gap: 1.25rem;
      display: flex;
    }

    #shopify-section-{{ section.id }} .feature-tabs__tab {
      flex: none;
      width: 3.5rem;
      aspect-ratio: 1;
      border: 1px solid rgb(var(--border-color));
      border-radius: 100%;
      place-items: center;
      display: grid;
      cursor: pointer;
    }

    #shopify-section-{{ section.id }} .feature-tabs__tab.is-active {
      background: rgb(var(--accent));
      border-color: rgb(var(--accent));
      color: rgb(var(--background));
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .featured-tabs {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      }

      #shopify-section-{{ section.id }} .feature-tabs__media {
        aspect-ratio: auto;
      }
    }
  </style>

  <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_featured_tabs %} section-floating section-floating--block-end{% endif %}">
    <div class="{% unless section.settings.floating_featured_tabs %}section-spacing{% endunless %}">
      <div class="{% unless section.settings.floating_featured_tabs %}container{% endunless %}">
        <div id="feature-tabs-{{ section.id }}" class="featured-tabs">
          <div class="feature-tabs__media">
            {%- for i in (1..5) -%}
              {%- capture tab_image_key -%}tab_{{ i }}_image{%- endcapture -%}
              {%- assign tab_image = section.settings[tab_image_key] -%}

              {%- if tab_image != blank -%}
                <div class="feature-tabs__media-item" data-tab-panel="{{ i }}" {% unless i == feature_tab_first_index %}hidden{% endunless %}>
                  {{- tab_image | image_url: width: tab_image.width | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 100vw, 50vw', widths: '400,600,800,1000,1200,1400,1600,1800', class: 'image-cover' -}}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="feature-tabs__content color-scheme color-scheme--{{ section.settings.content_color_scheme.id }}">
            {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
              <div class="prose">
                {%- if section.settings.title != blank -%}
                  {%- render 'heading', content: section.settings.title, style: 'h3', html_tag: 'h2' -%}
                {%- endif -%}

                {%- if section.settings.subtitle != blank -%}
                  <p class="text-subdued">{{ section.settings.subtitle }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="feature-tabs__panels">
              {%- for i in (1..5) -%}
                {%- capture tab_image_key -%}tab_{{ i }}_image{%- endcapture -%}
                {%- capture tab_label_key -%}tab_{{ i }}_label{%- endcapture -%}
                {%- capture tab_icon_key -%}tab_{{ i }}_icon{%- endcapture -%}
                {%- capture tab_text_key -%}tab_{{ i }}_text{%- endcapture -%}

                {%- assign tab_image = section.settings[tab_image_key] -%}
                {%- assign tab_label = section.settings[tab_label_key] -%}
                {%- assign tab_icon = section.settings[tab_icon_key] -%}
                {%- assign tab_text = section.settings[tab_text_key] -%}

                {%- if tab_image != blank -%}
                  <div class="feature-tabs__panel v-stack gap-4" data-tab-panel="{{ i }}" {% unless i == feature_tab_first_index %}hidden{% endunless %}>
                    {%- if tab_label != blank or tab_icon != blank -%}
                      <div class="feature-tabs__panel-heading">
                        {%- if tab_label != blank -%}
                          <span class="medium">{{ tab_label }}</span>
                        {%- endif -%}

                        <hr>

                        {%- if tab_icon != blank -%}
                          {{- tab_icon | image_url: width: tab_icon.width | image_tag: loading: 'lazy', sizes: '48px', class: 'feature-tabs__panel-icon' -}}
                        {%- endif -%}
                      </div>
                    {%- endif -%}

                    {%- if tab_text != blank -%}
                      <p>{{ tab_text }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <div class="feature-tabs__tabs v-stack gap-3 justify-items-start">
              <div class="feature-tabs__tablist" role="tablist">
                {%- for i in (1..5) -%}
                  {%- capture tab_image_key -%}tab_{{ i }}_image{%- endcapture -%}
                  {%- assign tab_image = section.settings[tab_image_key] -%}

                  {%- if tab_image != blank -%}
                    <button type="button" class="feature-tabs__tab {% if i == feature_tab_first_index %}is-active{% endif %}" data-tab-index="{{ i }}" role="tab" aria-selected="{% if i == feature_tab_first_index %}true{% else %}false{% endif %}">
                      <span class="subheading">0{{ i }}</span>
                    </button>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <div class="feature-tabs__tab-label">
                {%- for i in (1..5) -%}
                  {%- capture tab_image_key -%}tab_{{ i }}_image{%- endcapture -%}
                  {%- capture tab_number_label_key -%}tab_{{ i }}_number_label{%- endcapture -%}

                  {%- assign tab_image = section.settings[tab_image_key] -%}
                  {%- assign tab_number_label = section.settings[tab_number_label_key] -%}

                  {%- if tab_image != blank and tab_number_label != blank -%}
                    <span class="subheading text-subdued" data-tab-panel="{{ i }}" {% unless i == feature_tab_first_index %}hidden{% endunless %}>{{ tab_number_label }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function() {
      var root = document.getElementById('feature-tabs-{{ section.id }}');
      if (!root) return;

      var tabs = root.querySelectorAll('[data-tab-index]');
      var panels = root.querySelectorAll('.feature-tabs__media-item[data-tab-panel], .feature-tabs__panel[data-tab-panel], .feature-tabs__tab-label [data-tab-panel]');

      function activate(index) {
        tabs.forEach(function(tab) {
          var isActive = tab.getAttribute('data-tab-index') === index;
          tab.classList.toggle('is-active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        panels.forEach(function(panel) {
          panel.hidden = panel.getAttribute('data-tab-panel') !== index;
        });
      }

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          activate(tab.getAttribute('data-tab-index'));
        });
      });

      if (window.matchMedia('(pointer: fine)').matches) {
        tabs.forEach(function(tab) {
          tab.addEventListener('mouseenter', function() {
            activate(tab.getAttribute('data-tab-index'));
          });
        });
      }
    })();
  </script>
{%- endif -%}

{% schema %}
