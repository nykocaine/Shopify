{%- doc -%}
"Stories" layout of the Instagram feed: one big photo or video card with the panel of that story next to it (desktop) or under it (phones).

- The card shows the selected "Media" block (a video or a photo). A round play button on a video opens the zoom view (snippets/media-zoom-slide.liquid,
  snippets/media-zoom-script.liquid, snippets/media-lightbox.liquid: the same zoom view as Media Blocks and FAQ). Next / previous in the zoom view
  also moves the selection of the card and of the panel.
- The panel (its own color scheme) has, from top to bottom: one small thumbnail per block (tap one to change the story), the block's phrase, and two
  rows: the creator ("Creator" + its @user) and the picks (a title + links to the picked products). Everything in the panel changes with the story.
- The card and the panel are two blocks of their own, with no container or background behind them. Phones: the card on top and the panel joined
  under it (one card: only the outer corners are rounded). From 700px: side by side, joined by default; the "Separate" checkbox pulls them apart (a gap
  between two fully rounded blocks). The video can be on the left or on the right.
- The section's header (title, subtitle and button) is optional and sits above.

Colors and the shape of the round controls come from Theme settings > Controls.
{%- enddoc -%}

{%- liquid
  case section.settings.aspect_ratio_mobile
    when 'portrait'
      assign story_ratio_mobile = '4 / 5'
    when 'tall'
      assign story_ratio_mobile = '3 / 5'
    else
      assign story_ratio_mobile = '1 / 1'
  endcase

  case section.settings.aspect_ratio_desktop
    when 'portrait'
      assign story_ratio_desktop = '4 / 5'
    when 'tall'
      assign story_ratio_desktop = '3 / 5'
    else
      assign story_ratio_desktop = '1 / 1'
  endcase

  assign story_blocks = section.blocks | where: 'type', 'item'
  assign story_count = 0

  for block in story_blocks
    if block.settings.media_type == 'video' and block.settings.video != blank
      assign story_count = story_count | plus: 1
    elsif block.settings.media_type != 'video' and block.settings.image != blank
      assign story_count = story_count | plus: 1
    endif
  endfor

  assign story_has_multiple = false

  if story_count > 1
    assign story_has_multiple = true
  endif

  assign feed_id = 'instagram-feed-' | append: section.id
  assign lightbox_id = 'instagram-feed-lightbox-' | append: section.id
  assign corner_radius_px = section.settings.instagram_feed_border_radius | append: 'px'

  # Desktop: joined (one card) or two separate blocks; the video on the start (left) or the end (right) side. Phones are always joined.
  assign separate_desktop = section.settings.separate_desktop
  assign video_end = false

  if section.settings.video_position == 'end'
    assign video_end = true
  endif


  assign panel_scheme = section.settings.panel_color_scheme
-%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_instagram_feed %} section-floating section-floating--block{% endif %} instagram-feed-wrapper">
  <div class="section-spacing">
    <div id="{{ feed_id }}" class="instagram-feed section-stack" {% if section.settings.title_color != blank and section.settings.title_color != 'rgba(0,0,0,0)' %}style="--instagram-title-color: {{ section.settings.title_color }};"{% endif %}>
      {%- if section.settings.title != blank or section.settings.subtitle != blank or section.settings.button_text != blank -%}
        <div class="instagram-feed__header">
          <div class="instagram-feed__content{% if section.settings.title == blank and section.settings.subtitle == blank %} instagram-feed__content--no-text{% endif %}">
            {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
              <div class="prose prose--compact">
                {%- if section.settings.title != blank -%}
                  {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.title_tag, html_tag: 'h2' -%}
                {%- endif -%}

                {%- if section.settings.subtitle != blank -%}
                  <div class="max-w-sm">
                    {{- section.settings.subtitle -}}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.button_text != blank -%}
              {%- render 'button', content: section.settings.button_text, href: section.settings.button_url, style: section.settings.button_style, class: 'instagram-feed__button' -%}
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if story_count > 0 -%}
        <div class="ig-story{% if separate_desktop %} ig-story--separate{% endif %}{% if video_end %} ig-story--video-end{% endif %}">
          {%- comment -%}
          The card: every story's media stacked in the same spot, only the selected one is visible (see the style below). They are all in the
          page so the zoom view can go from one to the next with its own arrows.
          {%- endcomment -%}
          <div class="ig-story__stage">
            {%- assign story_index = 0 -%}

            {%- for block in story_blocks -%}
              {%- liquid
                assign story_valid = false
                if block.settings.media_type == 'video' and block.settings.video != blank
                  assign story_valid = true
                elsif block.settings.media_type != 'video' and block.settings.image != blank
                  assign story_valid = true
                endif
              -%}

              {%- if story_valid -%}
                <div class="ig-story__cell{% if story_index == 0 %} is-active{% endif %}" data-index="{{ story_index }}" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.media_type == 'video' -%}
                    {%- render 'media-zoom-slide',
                      video: block.settings.video,
                      loop_video: true,
                      corner_radius: corner_radius_px,
                      lightbox_id: lightbox_id,
                      lightbox_index: story_index,
                      as_lightbox_cell: true,
                      sizes: '90vw'
                    -%}
                  {%- else -%}
                    {%- render 'media-zoom-slide',
                      image: block.settings.image,
                      corner_radius: corner_radius_px,
                      lightbox_id: lightbox_id,
                      lightbox_index: story_index,
                      as_lightbox_cell: true,
                      sizes: '90vw'
                    -%}
                  {%- endif -%}
                </div>

                {%- assign story_index = story_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="ig-story__panel{% if panel_scheme != blank %} color-scheme color-scheme--{{ panel_scheme.id }}{% endif %}">
            {%- if story_has_multiple -%}
              <div class="ig-story__thumbs" role="group" aria-label="{{ section.settings.title | strip_html | escape | default: 'Stories' }}">
                {%- assign story_index = 0 -%}

                {%- for block in story_blocks -%}
                  {%- liquid
                    assign story_valid = false
                    if block.settings.media_type == 'video' and block.settings.video != blank
                      assign story_valid = true
                    elsif block.settings.media_type != 'video' and block.settings.image != blank
                      assign story_valid = true
                    endif

                    assign thumb = block.settings.thumbnail
                    if thumb == blank
                      if block.settings.media_type == 'video'
                        assign thumb = block.settings.video.preview_image
                      else
                        assign thumb = block.settings.image
                      endif
                    endif
                  -%}

                  {%- if story_valid -%}
                    <button type="button" class="ig-story__thumb{% if story_index == 0 %} is-active{% endif %}" data-index="{{ story_index }}" aria-pressed="{% if story_index == 0 %}true{% else %}false{% endif %}" aria-label="{{ block.settings.creator | default: block.settings.tagline | default: forloop.index | escape }}">
                      {%- if thumb != blank -%}
                        {{- thumb | image_url: width: 240 | image_tag: loading: 'lazy', widths: '96,144,192,240', sizes: '72px', alt: '' -}}
                      {%- endif -%}
                    </button>

                    {%- assign story_index = story_index | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            <div class="ig-story__infos">
              {%- assign story_index = 0 -%}

              {%- for block in story_blocks -%}
                {%- liquid
                  assign story_valid = false
                  if block.settings.media_type == 'video' and block.settings.video != blank
                    assign story_valid = true
                  elsif block.settings.media_type != 'video' and block.settings.image != blank
                    assign story_valid = true
                  endif
                -%}

                {%- if story_valid -%}
                  <div class="ig-story__info{% if story_index == 0 %} is-active{% endif %}" data-index="{{ story_index }}">
                    {%- if block.settings.tagline != blank -%}
                      <p class="ig-story__tagline h3">{{ block.settings.tagline | escape }}</p>
                    {%- endif -%}

                    {%- if block.settings.creator != blank or block.settings.picks.size > 0 -%}
                      <div class="ig-story__rows">
                        {%- if block.settings.creator != blank -%}
                          <div class="ig-story__row">
                            <p class="ig-story__row-label subheading">{{ section.settings.creator_label | escape }}</p>
                            <p class="ig-story__row-value">{{ block.settings.creator | escape }}</p>
                          </div>
                        {%- endif -%}

                        {%- if block.settings.picks.size > 0 -%}
                          <div class="ig-story__row">
                            <p class="ig-story__row-label subheading">{{ block.settings.picks_title | escape }}</p>
                            <ul class="ig-story__row-value ig-story__picks unstyled-list">
                              {%- for pick in block.settings.picks -%}
                                <li><a href="{{ pick.url }}">{{ pick.title | escape }}</a></li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>

                  {%- assign story_index = story_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>

        {%- render 'media-lightbox', id: lightbox_id, show_nav: story_has_multiple -%}

        <style>
          {%- render 'media-zoom-style', wrapper_id: feed_id, lightbox_id: lightbox_id, corner_radius: corner_radius_px -%}
        </style>

        {%- render 'media-zoom-script', wrapper_id: feed_id, lightbox_id: lightbox_id, sound_on_open: true, framed_icons: true -%}

        <script>
          (() => {
            const feed = document.getElementById('{{ feed_id }}');

            if (!feed) {
              return;
            }

            const cells = [...feed.querySelectorAll('.ig-story__cell')];
            const infos = [...feed.querySelectorAll('.ig-story__info')];
            const thumbs = [...feed.querySelectorAll('.ig-story__thumb')];

            {%- comment -%}Selects a story: the card, the panel's text and the thumbnail follow. The video that was showing is paused.{%- endcomment -%}
            const select = (index) => {
              if (index < 0 || index >= cells.length || cells[index].classList.contains('is-active')) {
                return;
              }

              cells.forEach((cell, i) => {
                const active = i === index;

                if (!active && cell.classList.contains('is-active')) {
                  const video = cell.querySelector('video-media');

                  if (video && typeof video.pause === 'function') {
                    video.pause();
                  }
                }

                cell.classList.toggle('is-active', active);
              });

              infos.forEach((info, i) => info.classList.toggle('is-active', i === index));
              thumbs.forEach((thumb, i) => {
                thumb.classList.toggle('is-active', i === index);
                thumb.setAttribute('aria-pressed', String(i === index));
              });
            };

            thumbs.forEach((thumb) => {
              thumb.addEventListener('click', () => select(Number(thumb.dataset.index)));
            });

            {%- comment -%}
            Desktop (700px and up): no pop-up. The play button of the card does not open the zoom view: the video plays right there, with sound (the
            click is the visitor's tap, so the browser allows it), through the video's own sound button so its icon stays right. In the capture phase,
            before the zoom script sees the event. On phones nothing changes: the zoom view opens as usual.
            {%- endcomment -%}
            const desktopQuery = window.matchMedia('(min-width: 700px)');

            feed.addEventListener('lightbox:open', (event) => {
              if (!desktopQuery.matches) {
                return;
              }

              event.stopPropagation();

              const cell = cells.find((item) => item.classList.contains('is-active')) ?? cells[0];
              const media = cell?.querySelector('video-media');
              const video = media?.querySelector('video');

              if (!media || !video) {
                return;
              }

              if (video.muted) {
                cell.querySelector('.carousel-video-sound-toggle')?.click();
              }

              if (typeof media.play === 'function') {
                media.play();
              }
            }, true);

            {%- comment -%}Next / previous in the zoom view: the card and the panel go to the same story{%- endcomment -%}
            feed.addEventListener('lightbox:item-active', (event) => {
              const cell = event.detail?.cell;

              if (!cell) {
                return;
              }

              select(cells.findIndex((item) => item === cell || item.contains(cell)));
            });
          })();
        </script>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  {%- comment -%}
  ============================================================
  HEADER (title, subtitle and button)
  ============================================================
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .prose {
    --prose-default-spacing: 1rem;
  }

  #shopify-section-{{ section.id }} .instagram-feed__header {
    align-items: start;
    margin-block-end: var(--section-stack-row-gap);
    display: flex;
  }

  #shopify-section-{{ section.id }} .instagram-feed__content {
    min-width: 0;
    flex: 1;
    gap: 1rem;
    align-items: start;
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .instagram-feed__content > .prose {
    min-width: 0;
  }

  {%- comment -%}From 700px the button sits on the title's row, at the right edge; without title and subtitle it goes to the left{%- endcomment -%}
  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .instagram-feed__content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 2rem;
      row-gap: 0;
      align-items: start;
    }

    #shopify-section-{{ section.id }} .instagram-feed__content > .prose {
      display: contents;
    }

    #shopify-section-{{ section.id }} .instagram-feed__content > .prose > * {
      grid-column: 1;
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .instagram-feed__content > .instagram-feed__button {
      grid-column: 2;
      grid-row: 1 / span 2;
      justify-self: end;
      align-self: start;
    }

    #shopify-section-{{ section.id }} .instagram-feed__content--no-text > .instagram-feed__button {
      grid-column: 1;
      justify-self: start;
    }
  }

  #shopify-section-{{ section.id }} .instagram-feed__content > .prose > h2 {
    text-box: trim-start cap alphabetic;
    color: var(--instagram-title-color, inherit);
    font-weight: 500;
  }

  {%- if section.settings.button_border_color != blank -%}
    #shopify-section-{{ section.id }} .instagram-feed__button {
      border: 1px solid rgb({{ section.settings.button_border_color.rgb }});
    }
  {%- endif -%}

  {%- comment -%}
  ============================================================
  NO CONTAINER
  ============================================================
  The video card and the panel are the blocks themselves: nothing wraps them. The section's own wrapper has no background (its color scheme only
  gives the header its text color), and no padding around the story: the card fills its whole block. Floating: the side margins of the page and
  the usual space above and below (no inner padding). Not floating: the story keeps the page's side margin as padding.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .instagram-feed-wrapper {
    background: none;
  }

  {%- if section.settings.floating_instagram_feed -%}
    #shopify-section-{{ section.id }} .section-spacing {
      padding-block: 0;
    }
  {%- else -%}
    #shopify-section-{{ section.id }} .instagram-feed {
      padding-inline: var(--container-gutter);
    }
  {%- endif -%}

  {%- if section.settings.attach_to_footer -%}
    {%- comment -%}
    "Attach to footer": only when this section is the last one of the page content, so the footer comes right after it
    (the footer lives in its own section group, right below <main>). The two join with no gap: this section loses its bottom margin and the bottom
    corners of its blocks (the panel on phones; the card and the panel from 700px), and the footer loses only its top corners (its bottom corners
    stay rounded); a divider line like the footer's own separates them. Side margins stay. The footer's own rules are scoped through :root:has(),
    because it is a different section.
    {%- endcomment -%}
    main > #shopify-section-{{ section.id }}:last-child > .section-floating {
      margin-block-end: 0 !important;
    }

    main > #shopify-section-{{ section.id }}:last-child .ig-story__panel {
      border-end-start-radius: 0 !important;
      border-end-end-radius: 0 !important;
    }

    @media screen and (min-width: 700px) {
      main > #shopify-section-{{ section.id }}:last-child .ig-story__stage {
        border-end-start-radius: 0 !important;
        border-end-end-radius: 0 !important;
      }
    }

    :root:has(main > #shopify-section-{{ section.id }}:last-child) .shopify-section--footer {
      margin-block-start: 0;
    }

    :root:has(main > #shopify-section-{{ section.id }}:last-child) .shopify-section--footer .footer {
      border-start-start-radius: 0 !important;
      border-start-end-radius: 0 !important;
      border-block-start: 1px solid rgb(var(--border-color));
    }
  {%- endif -%}

  {%- comment -%}
  ============================================================
  THE STORY: CARD + PANEL
  ============================================================
  Phones: one column, the card on top and the panel joined under it (no gap): one card, rounded only on its outer corners.
  From 700px: two equal columns side by side. Joined by default; with "Separate" they are two blocks with a gap between them and every corner of both
  rounded. The video is on the start side (left) or, with "Video on the right", on the end side. The card's height comes from its shape (the
  "shape" settings) and the panel takes the same height. Where the two parts touch (joined) the corners facing each other are square.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .ig-story {
    --ig-radius: {{ corner_radius_px }};
    --ig-ratio: {{ story_ratio_mobile }};
    gap: 0;
    grid-template-columns: minmax(0, 1fr);
    display: grid;
  }

  {%- comment -%}
  No stacking context on the stage (no isolation, z-index, transform...): the zoom view's media and its backdrop are position: fixed with their own z-index
  (snippets/media-zoom-style.liquid) and must compete with the rest of the page, not only inside the card, or the backdrop's blur ends up over the video.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .ig-story__stage {
    aspect-ratio: var(--ig-ratio);
    border-radius: var(--ig-radius) var(--ig-radius) 0 0;
    min-width: 0;
    overflow: hidden;
    display: grid;
    position: relative;
  }

  #shopify-section-{{ section.id }} .ig-story__panel {
    border-radius: 0 0 var(--ig-radius) var(--ig-radius);
    min-width: 0;
    padding: calc(var(--container-gutter) + 0.5rem);
    gap: 2rem;
    flex-direction: column;
    justify-content: space-between;
    display: flex;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .ig-story {
      gap: {% if separate_desktop %}var(--horizontal-gap){% else %}0{% endif %};
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }

    {%- comment -%}Joined, video on the start side: the card is rounded at the start, the panel at the end{%- endcomment -%}
    #shopify-section-{{ section.id }} .ig-story .ig-story__stage {
      border-radius: var(--ig-radius) 0 0 var(--ig-radius);
    }

    #shopify-section-{{ section.id }} .ig-story .ig-story__panel {
      border-radius: 0 var(--ig-radius) var(--ig-radius) 0;
    }

    {%- comment -%}Video on the end side{%- endcomment -%}
    #shopify-section-{{ section.id }} .ig-story--video-end .ig-story__stage {
      order: 2;
      border-radius: 0 var(--ig-radius) var(--ig-radius) 0;
    }

    #shopify-section-{{ section.id }} .ig-story--video-end .ig-story__panel {
      order: 1;
      border-radius: var(--ig-radius) 0 0 var(--ig-radius);
    }

    {%- comment -%}Separate: two blocks of their own, every corner rounded{%- endcomment -%}
    #shopify-section-{{ section.id }} .ig-story--separate .ig-story__stage,
    #shopify-section-{{ section.id }} .ig-story--separate .ig-story__panel {
      border-radius: var(--ig-radius);
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .ig-story {
      --ig-ratio: {{ story_ratio_desktop }};
    }
  }

  @media screen and (min-width: 700px) and (max-width: 999px) {
    #shopify-section-{{ section.id }} .ig-story {
      --ig-ratio: 1 / 1;
    }
  }

  {%- comment -%}
  The card's stories: all stacked in the same cell of the stage, the selected one fades in (the same soft fade as the rest of the page). The one that is
  open in the zoom view stays visible whatever the selection says.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .ig-story__cell {
    grid-area: 1 / 1;
    min-width: 0;
    min-height: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    border-radius: inherit;
    transition: opacity .4s ease, visibility 0s linear .4s;
  }

  #shopify-section-{{ section.id }} .ig-story__cell.is-active,
  #shopify-section-{{ section.id }} .ig-story__cell:has(.is-lightbox-expanded) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity .4s ease, visibility 0s;
  }

  {%- comment -%}
  The media fills its whole block with the block's own corners, at rest: every layer between the block and the picture (the card, the video, its poster)
  takes the radius of the block (inherit), so the corners are rounded even where a browser doesn't clip a video to the rounded block (Safari). The zoom view
  keeps its own radius (the section's corner radius).
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .ig-story__cell .content-box,
  #shopify-section-{{ section.id }} .ig-story__cell .content-box__background-media,
  #shopify-section-{{ section.id }} .ig-story__cell video-media:not(.is-lightbox-expanded),
  #shopify-section-{{ section.id }} .ig-story__cell video-media:not(.is-lightbox-expanded) > video,
  #shopify-section-{{ section.id }} .ig-story__cell video-media:not(.is-lightbox-expanded) > img,
  #shopify-section-{{ section.id }} .ig-story__cell .content-box__background-media > img:not(.is-lightbox-expanded) {
    border-radius: inherit !important;
  }

  #shopify-section-{{ section.id }} .ig-story__cell .content-box {
    height: 100%;
    aspect-ratio: auto;
  }

  #shopify-section-{{ section.id }} .ig-story__cell video-media > video,
  #shopify-section-{{ section.id }} .ig-story__cell .content-box__background-media img {
    object-fit: cover;
  }

  {%- comment -%}
  Phones: the play / pause / sound buttons exist only inside the zoom view (the pop-up): on the card the round play button is the only control.
  From 700px (desktop) there is no pop-up: the video plays in its own place. While it plays, the round play button goes away and the video's own
  sound and pause buttons show at its corner; paused, the round play button is back. A photo has no zoom button there either.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .carousel-video-controls:not(.is-lightbox-expanded) {
    display: none;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .ig-story__cell:has(video-media[playing]:not(.is-lightbox-expanded)) .carousel-video-controls {
      display: flex;
    }

    #{{ feed_id }} .ig-story__cell:has(video-media[playing]:not(.is-lightbox-expanded)) .video-open-button .overlay-control {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .ig-story__cell .product-zoom-button {
      display: none;
    }
  }

  {%- comment -%}
  The round play button of the card: 1.747 times the global control button (the shared rule in snippets/media-zoom-style.liquid is 1.3), always a
  perfect circle whatever "Controls > Border radius" says. Only this section: Media Blocks and FAQ keep the shared size.
  {%- endcomment -%}
  #{{ feed_id }} .ig-story__cell .video-open-button {
    --play-button-scale: 1.747;
  }

  #{{ feed_id }} .ig-story__cell .video-open-button .overlay-control {
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
  }

  {%- comment -%}No logo on the card's video (snippets/media-zoom-style.liquid draws it on every video of the sections that use it); the zoom view keeps it{%- endcomment -%}
  #{{ feed_id }} .has-video-logo video-media:not(.is-lightbox-expanded)::after {
    display: none;
  }

  {%- comment -%}
  Logo of the expanded video (zoom view): in the middle of the video, centered both ways, bigger and more transparent than the shared one.
  {%- endcomment -%}
  #{{ feed_id }}[data-lightbox-layout] .has-video-logo video-media.is-lightbox-expanded::after {
    inset-inline-start: 50%;
    inset-block-start: 50%;
    inset-block-end: auto;
    width: min(8.125rem, 40.625%);
    height: 4.46875rem;
    transform: translate(-50%, -50%);
    background-position: center;
    opacity: .476;
  }

  {%- comment -%}
  Zoom view: a photo opens in the same box as the videos (9:16 shape, the biggest that fits the screen), cropped evenly around its middle instead of
  letterboxed.
  {%- endcomment -%}
  #{{ feed_id }} {
    --instagram-zoom-ratio: .5625;
  }

  #shopify-section-{{ section.id }} #{{ feed_id }} img.is-lightbox-expanded {
    width: min(var(--lightbox-media-w), calc(var(--lightbox-media-h) * var(--instagram-zoom-ratio)));
    height: auto;
    aspect-ratio: var(--instagram-zoom-ratio);
    object-fit: cover;
    object-position: center;
    border-radius: {{ corner_radius_px }};
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} #{{ feed_id }} img.is-lightbox-expanded {
      width: var(--lightbox-media-w);
      height: var(--lightbox-media-h);
      aspect-ratio: auto;
    }
  }

  {%- comment -%}
  The panel: thumbnails at the top, the story's text at the bottom (space-between), same type as the rest of the page. The text of every story
  is stacked in the same cell and the selected one fades in, like the card.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .ig-story__thumbs {
    flex-wrap: wrap;
    gap: .75rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .ig-story__thumb {
    width: 3.5rem;
    aspect-ratio: 1 / 1;
    border-radius: .75rem;
    overflow: hidden;
    opacity: .5;
    cursor: pointer;
    transition: opacity .3s ease;
    flex: none;
    padding: 0;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .ig-story__thumb {
      width: 4.5rem;
    }
  }

  #shopify-section-{{ section.id }} .ig-story__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .ig-story__thumb:hover,
  #shopify-section-{{ section.id }} .ig-story__thumb.is-active {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .ig-story__thumb:focus-visible {
    outline: 2px solid rgb(var(--text-color));
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .ig-story__infos {
    margin-block-start: auto;
    display: grid;
  }

  #shopify-section-{{ section.id }} .ig-story__info {
    grid-area: 1 / 1;
    min-width: 0;
    gap: 2rem;
    align-content: end;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .4s ease, visibility 0s linear .4s;
    display: grid;
  }

  #shopify-section-{{ section.id }} .ig-story__info.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity .4s ease, visibility 0s;
  }

  #shopify-section-{{ section.id }} .ig-story__tagline {
    margin: 0;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .ig-story__rows {
    display: grid;
  }

  #shopify-section-{{ section.id }} .ig-story__row {
    padding-block: 1rem;
    gap: 1rem;
    align-items: center;
    grid-template-columns: auto minmax(0, 1fr);
    display: grid;
  }

  #shopify-section-{{ section.id }} .ig-story__row + .ig-story__row {
    border-block-start: 1px solid rgb(var(--border-color));
  }

  #shopify-section-{{ section.id }} .ig-story__row-label {
    margin: 0;
    font-weight: bold;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ig-story__row-value {
    margin: 0;
    text-align: end;
    color: rgb(var(--text-color) / .75);
  }

  #shopify-section-{{ section.id }} .ig-story__picks {
    gap: .25rem;
    padding: 0;
    list-style: none;
    display: grid;
  }

  #shopify-section-{{ section.id }} .ig-story__picks a {
    color: inherit;
    text-decoration: none;
    transition: opacity .2s ease;
  }

  #shopify-section-{{ section.id }} .ig-story__picks a:hover {
    opacity: .6;
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .ig-story__cell,
    #shopify-section-{{ section.id }} .ig-story__info,
    #shopify-section-{{ section.id }} .ig-story__thumb {
      transition: none;
    }
  }
</style>

