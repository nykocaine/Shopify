{%- doc -%}
A carousel of square (or portrait) photos and videos in an Instagram-feed style: each "Media" block is either an image or a video (the merchant
swaps the type per block from the editor). Extracted from sections/reviews.liquid, where this started as a block, so it isn't tied to Reviews.

- The row is reshuffled on every page load; the videos are spread evenly among the photos.
- Photos open the zoom view by tapping the photo itself (no visible button). Videos use snippets/media-zoom-slide.liquid, the same as FAQ's
  "Text + image/video" block and Media Blocks' Carousel: a round play button in the middle of the video opens the zoom view.
- Nothing autoplays by itself: on mobile only the first video at the left edge plays (a muted preview), on desktop a video plays while the
  cursor is over it (script "Video previews" below).
- Navigation: dots under the row on every screen size (snippets/carousel-dots.liquid).
- The zoom view (snippets/media-zoom-script.liquid) keeps its icons inside the open photo or video (framed_icons).

Colors and the shape of the round controls come from Theme settings > Controls; the color of a liked heart from this section's settings.
{%- enddoc -%}

{%- liquid
  case section.settings.aspect_ratio_mobile
    when 'square'
      assign instagram_ratio_mobile = '1 / 1'
    when 'portrait'
      assign instagram_ratio_mobile = '4 / 5'
    else
      assign instagram_ratio_mobile = '3 / 5'
  endcase

  case section.settings.aspect_ratio_desktop
    when 'portrait'
      assign instagram_ratio_desktop = '4 / 5'
    when 'tall'
      assign instagram_ratio_desktop = '3 / 5'
    else
      assign instagram_ratio_desktop = '1 / 1'
  endcase

  assign instagram_media_blocks = section.blocks | where: 'type', 'item'
  assign instagram_media_count = 0

  for block in instagram_media_blocks
    if block.settings.media_type == 'video' and block.settings.video != blank
      assign instagram_media_count = instagram_media_count | plus: 1
    elsif block.settings.image != blank
      assign instagram_media_count = instagram_media_count | plus: 1
    endif
  endfor

  assign instagram_has_multiple = false

  if instagram_media_count > 1
    assign instagram_has_multiple = true
  endif

  assign instagram_feed_id = 'instagram-feed-' | append: section.id
  assign instagram_carousel_id = 'instagram-feed-carousel-' | append: section.id
  assign instagram_lightbox_id = 'instagram-feed-lightbox-' | append: section.id

  # Computed once here (same pattern as snippets/faq-text-image.liquid's border_radius_px) instead
  # of repeating "section.settings.instagram_feed_border_radius | append: 'px'" inline at each call
  # site - every image, video and the carousel frame itself then shares this exact same string.
  assign instagram_corner_radius_px = section.settings.instagram_feed_border_radius | append: 'px'

  # Every photo and video is shown at about 90% of the screen width in the zoom view (the thumbnails are smaller, but it is the same element)
  assign instagram_media_sizes = '90vw'

  # Auto-scroll needs more than one card; the speed setting maps to pixels per second
  assign instagram_autoscroll = false

  if section.settings.autoscroll and instagram_has_multiple
    assign instagram_autoscroll = true
  endif

  case section.settings.autoscroll_speed
    when 'slow'
      assign instagram_autoscroll_speed = 30
    when 'fast'
      assign instagram_autoscroll_speed = 70
    else
      assign instagram_autoscroll_speed = 45
  endcase
-%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_instagram_feed %} section-floating section-floating--block{% endif %}"{% if section.settings.floating_instagram_feed %} style="border-radius: {{ instagram_corner_radius_px }}; overflow: hidden;"{% endif %}>
  <div class="section-spacing">
    <div id="{{ instagram_feed_id }}" class="instagram-feed section-stack{% if section.settings.bw_intro %} is-bw{% endif %}">
      {%- if section.settings.title != blank or section.settings.subtitle != blank or section.settings.button_text != blank or section.settings.show_icon -%}
        <div class="instagram-feed__header">
          <div class="instagram-feed__content">
            {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
              <div class="prose prose--compact">
                {%- if section.settings.title != blank -%}
                  {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.title_tag, html_tag: 'h2' -%}
                {%- endif -%}

                {%- if section.settings.subtitle != blank -%}
                  <div class="max-w-sm">
                    {{- section.settings.subtitle -}}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.button_text != blank -%}
              {%- render 'button', content: section.settings.button_text, href: section.settings.button_url, style: section.settings.button_style, class: 'instagram-feed__button' -%}
            {%- endif -%}
          </div>

          {%- if section.settings.show_icon -%}
            {%- render 'decorative-icon',
              icon_type: section.settings.icon_type,
              icon_size: section.settings.icon_size,
              icon_spin: section.settings.icon_spin,
              icon_primary_color: section.settings.icon_primary_color,
              icon_secondary_color: section.settings.icon_secondary_color,
              icon_border_color: section.settings.icon_border_color,
              class: 'instagram-feed__icon'
            -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if instagram_media_count > 0 -%}
        <scroll-carousel id="{{ instagram_carousel_id }}" class="instagram-feed__carousel snap-x scroll-area">
        {%- assign instagram_slide_index = 0 -%}

        {%- for block in instagram_media_blocks -%}
          {%- if block.settings.media_type == 'video' and block.settings.video != blank -%}
            {%- comment -%}
            The videos are a muted, looped preview that THIS section starts and stops (script "Video previews" below), not
            autoplay: on mobile only the first video at the left edge plays, and it changes as the row is scrolled; on desktop
            none plays by itself, each one plays while the cursor is over it. The round play button on top opens the zoom view.
            {%- endcomment -%}
            <div class="snap-start instagram-feed__video-cell" data-block-id="{{ block.id }}" data-caption="{{ block.settings.caption | escape }}" {{ block.shopify_attributes }}>
              {%- render 'media-zoom-slide',
                video: block.settings.video,
                loop_video: true,
                show_like: section.settings.show_likes,
                like_id: block.id,
                like_count: block.settings.likes_count,
                corner_radius: instagram_corner_radius_px,
                lightbox_id: instagram_lightbox_id,
                lightbox_index: instagram_slide_index,
                sizes: instagram_media_sizes
              -%}
            </div>

            {%- assign instagram_slide_index = instagram_slide_index | plus: 1 -%}
          {%- elsif block.settings.image != blank -%}
            {%- comment -%}
            No separate "zoom" button shown - the button wraps the image itself, so the whole
            square opens the lightbox on tap. It stays invisible with zero extra CSS: the theme's
            global reset already strips any button border/background/padding, and
            .content-box__background-media's width/height: 100% (theme.css) sizes it to fill the
            square since it's the only direct child, same as a plain img would be.

            The direct flex item is a plain div (like the video branch above, and like
            trust-icons.liquid's own carousel items) - open-lightbox-button sits one level inside
            it instead of being the flex item itself, same as it already is inside
            media-zoom-slide.liquid's own output for the video branch.
            {%- endcomment -%}
            <div class="snap-start" data-caption="{{ block.settings.caption | escape }}" {{ block.shopify_attributes }}>
              <open-lightbox-button class="block" aria-controls="{{ instagram_lightbox_id }}" image-index="{{ instagram_slide_index }}">
                <div class="content-box__background-media">
                  <button type="button">
                    {%- comment -%}
                    sizes/widths are sized for the lightbox's expanded view (up to 96vw, see
                    media-zoom-style.liquid), not the small grid thumbnail - it's the same img
                    element in both states (the lightbox only repositions/rescales it via CSS, never
                    swaps in a different image), so a thumbnail-sized sizes hint here would have the
                    browser fetch a small srcset candidate that then looks soft/blurry once expanded
                    full-screen.
                    {%- endcomment -%}
                    {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: instagram_media_sizes, widths: '150,300,450,600,900,1200,1500', class: 'instagram-feed__image aspect-square image-cover' -}}
                    <span class="sr-only">{{ 'product.gallery.zoom' | t }}</span>
                  </button>
                </div>
              </open-lightbox-button>
            </div>

            {%- assign instagram_slide_index = instagram_slide_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        </scroll-carousel>

        {%- comment -%}Dots centered under the row (snippets/carousel-dots.liquid), the navigation on every screen size. Not with auto-scroll, which moves the row by itself{%- endcomment -%}
        {%- if section.settings.show_dots and instagram_autoscroll == false -%}
          {%- render 'carousel-dots', target_id: instagram_carousel_id -%}
        {%- endif -%}

        {%- render 'media-lightbox', id: instagram_lightbox_id, show_nav: instagram_has_multiple -%}

        {%- comment -%}
        Caption shown only in the zoomed-in lightbox, never in the feed grid itself - each "Media"
        block's own caption setting, read from its cell's data-caption attribute by the script below.
        A plain sibling of the shared lightbox snippet rather than something added inside it (shared
        with FAQ/Media Blocks too) - kept entirely local to this section instead. The CSS fade uses
        #{{ instagram_lightbox_id }}.is-lightbox-visible's own existing toggle (a sibling selector,
        no extra JS needed just to fade it in/out in sync with the lightbox itself); the script below
        only has to keep its TEXT in sync with whichever item is currently expanded.
        {%- endcomment -%}
        <p id="{{ instagram_lightbox_id }}-caption" class="instagram-feed__lightbox-caption empty:hidden" aria-live="polite"></p>

        <style>
          {%- render 'media-zoom-style', wrapper_id: instagram_feed_id, lightbox_id: instagram_lightbox_id, corner_radius: instagram_corner_radius_px -%}

          {%- comment -%}
          empty:hidden (theme.css utility) keeps this out of the way entirely when the active item has
          no caption set, instead of reserving space for/fading in an empty bar. top/left/width are all
          left unset here on purpose - desktop's expanded media has no fixed box of its own in pure CSS
          (it's sized by its own content, up to 96vw/96vh), so the script below sets all three itself,
          measured from the actual expanded media's own box (left-aligned to its left edge, same width
          as it, starting just under its bottom edge), every time the active item (or the viewport)
          changes.
          {%- endcomment -%}
          #shopify-section-{{ section.id }} .instagram-feed__lightbox-caption {
            color: rgb(var(--text-color));
            background: rgb(var(--background) / .9);
            text-align: start;
            padding: .5rem 1rem;
            border-radius: {{ instagram_corner_radius_px }};
            z-index: 1000;
            position: fixed;
            opacity: 0;
            scale: .95;
            pointer-events: none;
            transition: opacity .2s ease, scale .2s ease;
          }

          #{{ instagram_lightbox_id }}.is-lightbox-visible ~ .instagram-feed__lightbox-caption {
            opacity: 1;
            scale: 1;
          }
        </style>

        {%- comment -%}
        Feed behavior, in order: the random order of the row, lazy loading and loading cue of the videos, the "#video-<block id>" deep link and
        the like buttons.

        The row is reshuffled into a random order on every page load (not persisted: a fresh shuffle each visit). This runs as a plain
        synchronous script, BEFORE media-zoom-script below: that one captures its own "cells" snapshot inside an async
        customElements.whenDefined() callback, so this reorder - and the image-index rewrite that keeps each slide's lightbox index matching
        its new position - has to land first, or the lightbox would open the wrong item for whatever position was clicked. Every cell is a
        plain div (see above) with its open-lightbox-button nested one level inside.
        {%- endcomment -%}
        <script>
          (() => {
            const feed = document.getElementById('{{ instagram_feed_id }}');
            const carousel = document.getElementById('{{ instagram_carousel_id }}');

            if (!feed || !carousel) {
              return;
            }

            const DEEP_LINK_PREFIX = '#video-';
            const DEEP_LINK_DELAY = 600;
            const LIKE_KEY_PREFIX = 'instagram-feed-like-';
            const LIKE_COUNT_UP_DURATION = 1400;
            const LIKE_COUNT_UP_DELAY = 300;
            const VIDEO_STATE_EVENTS = ['play', 'playing', 'waiting', 'stalled', 'seeking', 'seeked', 'loadeddata', 'canplay', 'canplaythrough', 'timeupdate', 'pause', 'ended', 'emptied', 'abort', 'error'];
            const HAVE_FUTURE_DATA = 3;

            {%- comment -%}
            Videos and images are shuffled independently within each group (still a fresh order every page load) and then interleaved: the
            videos are spread evenly through the row, starting with one (video, image, video, image... when there are as many of each; with
            fewer videos they are evenly spaced between the images), instead of one shuffle across everything, which could clump them.
            {%- endcomment -%}
            const shuffle = (items) => {
              for (let i = items.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));

                [items[i], items[j]] = [items[j], items[i]];
              }

              return items;
            };

            const cells = [...carousel.children];
            const videoCells = shuffle(cells.filter((cell) => cell.querySelector('video-media')));
            const otherCells = shuffle(cells.filter((cell) => !cell.querySelector('video-media')));
            const ordered = new Array(cells.length);

            videoCells.forEach((cell, index) => {
              ordered[Math.floor((index * ordered.length) / videoCells.length)] = cell;
            });

            let nextOther = 0;

            for (let slot = 0; slot < ordered.length; slot++) {
              ordered[slot] ??= otherCells[nextOther++];
            }

            ordered.forEach((cell, index) => {
              cell.querySelector('open-lightbox-button')?.setAttribute('image-index', index);
              carousel.append(cell);
            });

            {%- comment -%}
            Lazy video loading: nothing is fetched for a video until the visitor gets near the section. Every <video> starts with preload="none"
            (instead of the "metadata" the media snippet sets), and <video-media> (theme.js, VideoMedia) switches it to "auto" and picks the
            right source once the video is within 800px of the screen, so it is ready when it comes into view.
            {%- endcomment -%}
            carousel.querySelectorAll('video').forEach((video) => video.setAttribute('preload', 'none'));

            {%- comment -%}
            Loading cue: while a video has been asked to play but has no frames yet, its cell gets .is-video-loading, which shows a small
            spinner (after a short delay, so a fast start never flashes it). It follows the video's real state instead of a pair of "start" and
            "end" events (which could leave it stuck: "stalled" and "waiting" also fire while the video is already playing or only preloading):
            on only while the video is trying to play (not paused, not ended) without enough data to keep going, re-evaluated on every event
            that can change that, including timeupdate while it plays.
            {%- endcomment -%}
            carousel.querySelectorAll('.instagram-feed__video-cell video').forEach((video) => {
              const cell = video.closest('.instagram-feed__video-cell');
              const update = () => cell.classList.toggle('is-video-loading', !video.paused && !video.ended && video.readyState < HAVE_FUTURE_DATA);

              VIDEO_STATE_EVENTS.forEach((type) => video.addEventListener(type, update));
            });

            {%- comment -%}A page opened with a "#video-<block id>" mark opens that video's zoom view by itself{%- endcomment -%}
            if (window.location.hash.startsWith(DEEP_LINK_PREFIX)) {
              const blockId = window.location.hash.slice(DEEP_LINK_PREFIX.length);
              const sharedCell = carousel.querySelector(`.instagram-feed__video-cell[data-block-id="${CSS.escape(blockId)}"]`);

              if (sharedCell) {
                customElements.whenDefined('video-media').then(() => {
                  setTimeout(() => {
                    const index = parseInt(sharedCell.querySelector('open-lightbox-button')?.getAttribute('image-index'), 10);

                    if (!Number.isNaN(index)) {
                      feed.dispatchEvent(new CustomEvent('lightbox:open', { bubbles: true, detail: { index } }));
                    }
                  }, DEEP_LINK_DELAY);
                });
              }
            }

            {%- comment -%}
            Like button (the heart at the top of a video's controls in the lightbox). The number is the one entered in the Media block (the post's
            real likes) plus the visitor's own like, which is remembered in this browser. There is no server behind it: nothing here invents or
            sums likes from other visitors.
            {%- endcomment -%}
            const countUps = new WeakMap();
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

            carousel.querySelectorAll('.carousel-video-like').forEach((likeBox) => {
              const storageKey = LIKE_KEY_PREFIX + likeBox.dataset.likeId;
              const baseLikes = parseInt(likeBox.dataset.likeBase, 10);
              const toggle = likeBox.querySelector('.carousel-video-like-toggle');
              const countElement = likeBox.querySelector('.carousel-video-like__count');
              let liked = false;
              let countFrame = null;

              try {
                liked = window.localStorage.getItem(storageKey) === '1';
              } catch {
                liked = false;
              }

              const currentTotal = () => baseLikes + Number(liked);

              {%- comment -%}Shows the final number at once (and stops a count-up that is still running){%- endcomment -%}
              const render = () => {
                cancelAnimationFrame(countFrame);
                toggle.setAttribute('aria-pressed', String(liked));
                countElement.textContent = Number.isNaN(baseLikes) ? '' : currentTotal().toLocaleString();
              };

              {%- comment -%}
              Each time the video comes up in the zoom view the number counts up from 0 to its real total (the "Likes" of the block plus the
              visitor's own like): fast at first, slowing down as it gets there, once the zoom has settled. Without motion it just shows the total.
              {%- endcomment -%}
              countUps.set(likeBox, () => {
                if (Number.isNaN(baseLikes) || reducedMotion.matches) {
                  return;
                }

                cancelAnimationFrame(countFrame);
                countElement.textContent = '0';

                const startAt = performance.now() + LIKE_COUNT_UP_DELAY;

                const tick = (now) => {
                  const progress = Math.min(1, Math.max(0, (now - startAt) / LIKE_COUNT_UP_DURATION));

                  countElement.textContent = Math.round(currentTotal() * (1 - (1 - progress) ** 3)).toLocaleString();

                  if (progress < 1) {
                    countFrame = requestAnimationFrame(tick);
                  }
                };

                countFrame = requestAnimationFrame(tick);
              });

              toggle.addEventListener('click', (event) => {
                event.stopPropagation();
                liked = !liked;

                try {
                  window.localStorage.setItem(storageKey, liked ? '1' : '0');
                } catch {
                  {%- comment -%}Storage can be blocked (private mode): the like then only lasts for this page view{%- endcomment -%}
                }

                render();
              });

              render();
            });

            feed.addEventListener('lightbox:item-active', (event) => {
              const likeBox = event.detail.cell?.querySelector('.carousel-video-like');

              countUps.get(likeBox)?.();
            });
          })();
        </script>

        {%- if instagram_autoscroll -%}
          {%- comment -%}
          Auto-scroll as a conveyor belt: the row moves left at a constant, slow speed, forever, with no stops between cards. Each frame advances
          a float position by speed * elapsed time (so the speed is the same on any refresh rate); when the first card has completely left the
          visible area it is moved to the end of the row and the position is shifted back by exactly its width, which the eye can't notice, so
          the row never ends. Cards are moved, not cloned, so there are no duplicated videos or lightbox items. It needs enough cards to be
          wider than the viewport plus one card; otherwise it does nothing.

          It stops only when the visitor takes over: while a pointer or finger is pressed on the row (which includes tapping a photo or a
          video), while they scroll it themselves (plus a short moment after), while something inside has focus and while the lightbox is
          open. It also rests while the section is off-screen or the tab is hidden, and is disabled for prefers-reduced-motion and
          right-to-left pages. Snapping is off (see the style below) so it can move continuously. The videos' preview does not stop it.
          {%- endcomment -%}
          <script>
            (() => {
              const carousel = document.getElementById('{{ instagram_carousel_id }}');
              const lightbox = document.getElementById('{{ instagram_lightbox_id }}');

              if (!carousel || !lightbox) {
                return;
              }

              if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.getComputedStyle(carousel).direction === 'rtl') {
                return;
              }

              const SPEED = {{ instagram_autoscroll_speed }};
              const RESUME_DELAY = 1200;
              const MAX_FRAME = 64;
              const STEP_MARGIN = 4;

              let position = carousel.scrollLeft;
              let assigned = position;
              let shifted = false;
              let previousTimestamp = null;
              let pressing = false;
              let focused = false;
              let visible = true;
              let lastInteraction = 0;

              const shift = (fraction) => {
                [...carousel.children].forEach((cell) => {
                  cell.style.transform = fraction ? `translate3d(${-fraction}px, 0, 0)` : '';
                });

                shifted = fraction !== 0;
              };

              const release = () => {
                if (shifted) {
                  shift(0);
                }

                position = carousel.scrollLeft;
                assigned = position;
              };

              const markInteraction = () => {
                lastInteraction = Date.now();
              };

              const canRun = () => {
                if (!visible || document.hidden || pressing || focused) {
                  return false;
                }

                if (lightbox.classList.contains('is-lightbox-visible')) {
                  markInteraction();
                  return false;
                }

                return Date.now() - lastInteraction > RESUME_DELAY;
              };

              const frame = (timestamp) => {
                requestAnimationFrame(frame);

                const elapsed = previousTimestamp === null ? 0 : Math.min(timestamp - previousTimestamp, MAX_FRAME);

                previousTimestamp = timestamp;

                if (!canRun()) {
                  release();
                  return;
                }

                const first = carousel.firstElementChild;
                const step = first.getBoundingClientRect().width + (parseFloat(window.getComputedStyle(carousel).columnGap) || 0);

                if (carousel.scrollWidth - carousel.clientWidth <= step + STEP_MARGIN) {
                  return;
                }

                position += (SPEED * elapsed) / 1000;

                if (position >= step) {
                  carousel.append(first);
                  position -= step;
                }

                {%- comment -%}
                scrollLeft only takes whole pixels on standard-density screens, which made the row advance in visible 1px hops; the whole part
                goes to scrollLeft and the remainder is applied as a translate on the cells (composited, so sub-pixel smooth). The translate is
                removed whenever the row stops, because a transformed ancestor would break the lightbox's fixed positioning.
                {%- endcomment -%}
                const whole = Math.floor(position);

                carousel.scrollLeft = whole;
                assigned = whole;
                shift(position - whole);
              };

              carousel.addEventListener('pointerdown', () => {
                pressing = true;
                release();
              });

              ['pointerup', 'pointercancel'].forEach((name) => {
                window.addEventListener(name, () => {
                  if (pressing) {
                    pressing = false;
                    markInteraction();
                  }
                });
              });

              carousel.addEventListener('scroll', () => {
                if (Math.abs(carousel.scrollLeft - assigned) > 1.5) {
                  markInteraction();
                }
              }, { passive: true });

              carousel.addEventListener('focusin', () => {
                focused = true;
                release();
              });

              carousel.addEventListener('focusout', () => {
                focused = false;
                markInteraction();
              });

              new IntersectionObserver((entries) => {
                visible = entries[0].isIntersecting;
              }, { threshold: 0.1 }).observe(carousel);

              requestAnimationFrame(frame);
            })();
          </script>
        {%- endif -%}

        {%- if section.settings.bw_intro -%}
          <noscript>
            <style>
              #{{ instagram_feed_id }}.is-bw .instagram-feed__carousel img,
              #{{ instagram_feed_id }}.is-bw .instagram-feed__carousel video-media {
                filter: none;
              }
            </style>
          </noscript>

          {%- comment -%}
          Black and white intro: the countdown starts when the visitor actually reaches the section (a quarter of it on screen), not at page load,
          so the seconds are spent looking at it. It runs once per page view.
          {%- endcomment -%}
          <script>
            (() => {
              const feed = document.getElementById('{{ instagram_feed_id }}');

              if (!feed?.classList.contains('is-bw')) {
                return;
              }

              const SECONDS_IN_BLACK_AND_WHITE = {{ section.settings.bw_intro_seconds | default: 0 }};
              const FADE_SECONDS = {{ section.settings.bw_intro_fade | default: 0 }};
              const FADE_CLEANUP_MARGIN = 100;

              const startCountdown = () => {
                setTimeout(() => {
                  feed.classList.remove('is-bw');
                  feed.classList.add('is-bw-fading');

                  setTimeout(() => feed.classList.remove('is-bw-fading'), FADE_SECONDS * 1000 + FADE_CLEANUP_MARGIN);
                }, SECONDS_IN_BLACK_AND_WHITE * 1000);
              };

              const observer = new IntersectionObserver((entries) => {
                if (entries.some((entry) => entry.isIntersecting)) {
                  observer.disconnect();
                  startCountdown();
                }
              }, { threshold: 0.25 });

              observer.observe(feed);
            })();
          </script>
        {%- endif -%}

        {%- render 'media-zoom-script', wrapper_id: instagram_feed_id, lightbox_id: instagram_lightbox_id, carousel_id: instagram_carousel_id, sound_on_open: true, preview_playback: true, framed_icons: true -%}

        <style>
          {%- comment -%}
          Mobile / touch only: the round play button shows only on the video at the left edge (the one that is playing, marked data-at-left by
          the script below). The others get theirs when the row is scrolled and they reach that position. Desktop keeps it on every video.
          {%- endcomment -%}
          @media not ((hover: hover) and (pointer: fine)) {
            #{{ instagram_feed_id }} .instagram-feed__video-cell:not([data-at-left]) .video-open-button {
              opacity: 0;
              visibility: hidden;
            }

            #{{ instagram_feed_id }} .instagram-feed__video-cell .video-open-button {
              transition: opacity .25s ease, visibility .25s;
            }
          }
        </style>

        {%- comment -%}
        Video previews. Nothing autoplays by itself; this script decides what plays:

        - Mobile / touch (no hover): only ONE video plays, the first one at the left edge of the row (the leftmost video that is at least half
          visible). Scrolling the row moves it to the next video: the previous one pauses and the new one starts. Nothing plays when the
          section is out of the screen. The round play button follows the same video (data-at-left): only that one shows it.
        - Desktop (mouse): none plays by itself. The video under the cursor plays and pauses when the cursor leaves. The round play button stays
          on top the whole time; only pressing it opens the zoom view (snippets/media-zoom-slide.liquid, media-zoom-script.liquid).

        A video opened in the zoom view is never touched here. When it is closed (event "thumbnail:collapsed") the right state is recomputed.
        {%- endcomment -%}
        <script>
          (() => {
            const carousel = document.getElementById('{{ instagram_carousel_id }}');

            if (!carousel) {
              return;
            }

            const MIN_VISIBLE_SHARE = 0.5;
            const SECTION_VISIBLE_RATIO = 0.4;
            const COLLAPSE_DELAY = 80;
            const VIDEO_CELL = '.instagram-feed__video-cell';

            const hoverQuery = window.matchMedia('(hover: hover) and (pointer: fine)');
            let sectionVisible = false;
            let queued = false;

            const videoCells = () => [...carousel.querySelectorAll(`:scope > ${VIDEO_CELL}`)];
            const mediaOf = (cell) => cell.querySelector('video-media');
            const isExpanded = (media) => media.classList.contains('is-lightbox-expanded');

            const start = (media) => {
              if (media && !isExpanded(media) && typeof media.play === 'function' && !media.playing) {
                media.play();
              }
            };

            const stop = (media) => {
              if (media && !isExpanded(media) && typeof media.pause === 'function' && media.playing) {
                media.pause({ manual: false });
              }
            };

            {%- comment -%}The leftmost video that is at least half visible inside the row{%- endcomment -%}
            const firstVideoAtTheLeft = () => {
              const row = carousel.getBoundingClientRect();
              let best = null;
              let bestLeft = Infinity;

              videoCells().forEach((cell) => {
                const media = mediaOf(cell);
                const rect = cell.getBoundingClientRect();

                if (!media || !rect.width) {
                  return;
                }

                const visibleWidth = Math.min(rect.right, row.right) - Math.max(rect.left, row.left);

                if (visibleWidth / rect.width >= MIN_VISIBLE_SHARE && rect.left < bestLeft) {
                  best = media;
                  bestLeft = rect.left;
                }
              });

              return best;
            };

            const apply = () => {
              queued = false;

              const chosen = !hoverQuery.matches && sectionVisible && !document.hidden ? firstVideoAtTheLeft() : null;

              videoCells().forEach((cell) => {
                const media = mediaOf(cell);
                const isChosen = Boolean(chosen && media === chosen);

                {%- comment -%}Marks the video at the left edge: on mobile only this one shows its round play button (style below){%- endcomment -%}
                cell.toggleAttribute('data-at-left', isChosen);

                if (isChosen) {
                  start(media);
                } else {
                  stop(media);
                }
              });
            };

            const queueApply = () => {
              if (!queued) {
                queued = true;
                requestAnimationFrame(apply);
              }
            };

            {%- comment -%}Desktop: hover plays, leaving pauses (mouse only, never touch){%- endcomment -%}
            const hoveredCell = (event) => (hoverQuery.matches && event.pointerType === 'mouse' ? event.target.closest?.(VIDEO_CELL) : null);

            carousel.addEventListener('pointerover', (event) => {
              const cell = hoveredCell(event);

              if (cell) {
                start(mediaOf(cell));
              }
            });

            carousel.addEventListener('pointerout', (event) => {
              const cell = hoveredCell(event);

              if (cell && !cell.contains(event.relatedTarget)) {
                stop(mediaOf(cell));
              }
            });

            carousel.addEventListener('scroll', queueApply, { passive: true });
            window.addEventListener('resize', queueApply);
            document.addEventListener('visibilitychange', queueApply);
            hoverQuery.addEventListener('change', queueApply);

            {%- comment -%}The zoom view was closed: its video goes back to its thumbnail paused, then the right state is recomputed{%- endcomment -%}
            carousel.addEventListener('thumbnail:collapsed', () => setTimeout(queueApply, COLLAPSE_DELAY));

            new IntersectionObserver((entries) => {
              sectionVisible = entries[entries.length - 1].intersectionRatio >= SECTION_VISIBLE_RATIO;
              queueApply();
            }, { threshold: [0, SECTION_VISIBLE_RATIO, 1] }).observe(carousel);

            customElements.whenDefined('video-media').then(queueApply);
          })();
        </script>

        {%- comment -%}
        Caption of the open photo or video, shown only in the zoom view (the text of the block's caption setting, read from its cell's data-caption
        attribute): under the media, or inside its top-left corner when the media fills the whole height of the screen.
        {%- endcomment -%}
        <script>
          (() => {
            const carousel = document.getElementById('{{ instagram_carousel_id }}');
            const lightbox = document.getElementById('{{ instagram_lightbox_id }}');
            const caption = document.getElementById('{{ instagram_lightbox_id }}-caption');

            if (!carousel || !lightbox || !caption) {
              return;
            }

            const GAP = 12;
            const SETTLE_DELAY = 460;

            const syncCaption = () => {
              const expanded = carousel.querySelector('.is-lightbox-expanded');

              caption.textContent = expanded?.closest('.snap-start')?.dataset.caption ?? '';

              if (!expanded) {
                return;
              }

              const rect = expanded.getBoundingClientRect();

              caption.style.left = `${rect.left}px`;
              caption.style.width = `${rect.width}px`;
              caption.style.top = `${rect.bottom + GAP}px`;

              {%- comment -%}
              The media can fill the whole height of the screen (mobile, tall videos), leaving no room under it: the caption then sits inside
              the video, at its top-left corner, with room left for the close button.
              {%- endcomment -%}
              if (rect.bottom + GAP + caption.offsetHeight > window.innerHeight - GAP) {
                const closeButtonWidth = lightbox.querySelector('.media-lightbox__close')?.offsetWidth ?? 0;

                caption.style.left = `${rect.left + GAP}px`;
                caption.style.width = `${Math.max(0, rect.width - GAP * 3 - closeButtonWidth)}px`;
                caption.style.top = `${rect.top + GAP}px`;
              }
            };

            {%- comment -%}Measured again once the open animation has settled: during it the media is still slightly scaled down{%- endcomment -%}
            new MutationObserver(() => {
              syncCaption();
              setTimeout(syncCaption, SETTLE_DELAY);
            }).observe(carousel, { attributes: true, attributeFilter: ['class'], subtree: true });

            window.addEventListener('resize', syncCaption);
          })();
        </script>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  {%- comment -%}
  ============================================================
  TITLE/SUBTITLE SPACING
  ============================================================
  Overrides --prose-default-spacing (set by .prose--compact in the markup above, 1/1.25rem) to match
  .instagram-feed__content's own gap below (1rem) - keeps the title-to-subtitle gap the same size as
  the subtitle-to-button gap, instead of introducing a parallel spacing scheme.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .prose {
    --prose-default-spacing: 1rem;
  }

  {%- comment -%}
  ============================================================
  HEADER (content column + icon column)
  ============================================================
  Two real columns, same on mobile and desktop - no breakpoint-specific swap. .instagram-feed__content
  (title, subtitle and button stacked) takes the start side, the icon (when shown) sits in its own
  column flush to the end. A plain flex row instead of pulling the icon out with position: absolute:
  that let the icon overlap the subtitle on narrow screens once the column grew tall enough to reach
  it, since an out-of-flow element doesn't share space with in-flow content. flex: 1 + min-width: 0
  on the content column let it take the remaining width and wrap/shrink its own text inside that,
  while flex-shrink: 0 on the icon keeps it at its own natural size instead of being squeezed.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .instagram-feed__header {
    align-items: start;
    gap: 1rem;
    margin-block-end: var(--section-stack-row-gap);
    display: flex;
  }

  #shopify-section-{{ section.id }} .instagram-feed__content {
    min-width: 0;
    flex: 1;
    gap: 1rem;
    align-items: start;
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .instagram-feed__content > .prose {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .instagram-feed__icon {
    flex-shrink: 0;
  }

  {%- comment -%}
  Same title alignment system as sections/contact.liquid's .contact-heading-row__title: without it,
  align-items: start above lines the icon up with the top of the title's full line-height box, not
  its visible glyphs - text-box trims that invisible leading off so the icon's top edge is flush with
  the visible top of the title text instead of sitting visibly lower than it.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .instagram-feed__content > .prose > h2 {
    text-box: trim-both cap alphabetic;
  }

  {%- comment -%}
  Independent of button_style (outline already has its own border, solid/link normally don't) -
  left blank by default (the color picker's own "no color" state), so nothing renders unless the
  merchant explicitly picks one.
  {%- endcomment -%}
  {%- if section.settings.button_border_color != blank -%}
    #shopify-section-{{ section.id }} .instagram-feed__button {
      border: 1px solid rgb({{ section.settings.button_border_color.rgb }});
    }
  {%- endif -%}

  {%- comment -%}
  ============================================================
  FLOATING MODE / SECTION PADDING
  ============================================================
  Same formula as sections/reviews.liquid and sections/faq.liquid: gutter + 0.5rem on every side,
  at every breakpoint, instead of .section-spacing's generic page-to-page rhythm.
  {%- endcomment -%}
  {%- if section.settings.floating_instagram_feed -%}
    #shopify-section-{{ section.id }} .section-spacing {
      padding-block: 0;
    }

    #shopify-section-{{ section.id }} .instagram-feed {
      padding: calc(var(--container-gutter) + 0.5rem);
    }

    {%- comment -%}
    Same corner radius as the outer floating wrapper (which only clips the section's own edges,
    far from the carousel once the padding above is in between). Without this, scrolling the
    carousel reveals a plain square-cornered viewport in the middle of a rounded section - adding
    the radius directly to .instagram-feed__carousel (with overflow-x: auto / overflow-y: hidden
    already set below) clips every slide to that same rounded shape at rest, so the corners stay
    rounded through the whole scroll range instead of only at the section's own edge.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .instagram-feed__carousel {
      border-radius: {{ instagram_corner_radius_px }};
    }

    {%- if section.settings.attach_to_footer -%}
      {%- comment -%}
      "Attach to footer": only when this section is the last one of the page content, so the footer comes right after it
      (the footer lives in its own section group, right below <main>). The two join with no gap: this section loses its
      bottom margin and its bottom corners, keeping only the top ones, and the footer loses all its rounded corners.
      Side margins stay (both are floating). The footer's own rules are scoped through :root:has(), because it is a
      different section.
      {%- endcomment -%}
      main > #shopify-section-{{ section.id }}:last-child > .section-floating {
        margin-block-end: 0 !important;
        border-radius: {{ instagram_corner_radius_px }} {{ instagram_corner_radius_px }} 0 0 !important;
      }

      :root:has(main > #shopify-section-{{ section.id }}:last-child) .shopify-section--footer {
        margin-block-start: 0;
      }

      :root:has(main > #shopify-section-{{ section.id }}:last-child) .shopify-section--footer .footer {
        border-radius: 0 !important;
      }
    {%- endif -%}
  {%- endif -%}

  {%- comment -%}
  ============================================================
  CAROUSEL LAYOUT
  ============================================================
  Flexbox instead of CSS grid on purpose: a grid's auto-generated columns (grid-auto-columns) were
  reporting the row's full, un-clipped content width - the sum of every column, intentionally wider
  than the visible area once there are more items than fit - as this element's own size to the
  outer .instagram-feed.section-stack grid it sits in, pushing the whole page wider once enough
  images/videos were added to actually exceed the visible column count. Flex items aren't measured
  that way: flex: 0 0 <basis> fixes each item's width without ever letting the row's intrinsic
  content size feed back into the container's own sizing, so .scroll-area's overflow: auto hidden
  reliably clips the rest instead.

  Mobile: a single row of 2 items that tiles the full width - any extra items beyond those 2
  overflow and scroll horizontally. Desktop: 4 items, same idea. Width stays an even split on
  purpose - only the height changes (.instagram-feed__image/.content-box aspect-ratio override
  further down), not how many items fit per row.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .instagram-feed__carousel {
    gap: var(--item-gap-inline);
    width: 100%;
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    display: flex;
  }

  {%- if instagram_autoscroll -%}
    #shopify-section-{{ section.id }} .instagram-feed__carousel {
      scroll-snap-type: none;
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .instagram-feed__carousel > .snap-start {
    flex: 0 0 calc((100% - var(--item-gap-inline)) / 2);
    min-width: 0;
  }

  {%- comment -%}
  Mobile (below 700px): same idea as desktop below - double gap, and the row shows one full item plus half of the next one at the right edge
  (1 item + half an item + 1 gap = 100%). Tablets (700-999px) keep the plain 4 per row and the normal gap.
  {%- endcomment -%}
  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .instagram-feed__carousel {
      --instagram-feed-gap: var(--horizontal-gap);
      gap: var(--instagram-feed-gap);
    }

    #shopify-section-{{ section.id }} .instagram-feed__carousel > .snap-start {
      flex: 0 0 calc((100% - var(--instagram-feed-gap)) / 1.5);
    }
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .instagram-feed__carousel > .snap-start {
      flex: 0 0 calc((100% - 3 * var(--item-gap-inline)) / 4);
    }
  }

  {%- comment -%}
  Desktop (1000px and up): the squares are as wide as the row divided by "Items per row (desktop)" - more items
  per row means smaller squares (height follows, they stay square). Tablets keep 4 per row.
  {%- endcomment -%}
  {%- comment -%}
  Desktop only: the gap between photos/videos is the theme's shared carousel gap (--horizontal-gap, css-variables.liquid), and the
  items are square again (the aspect-ratio rules below, at the same breakpoint). The row shows "Items per row (desktop)" slots, the last of them cut in half at the right edge (so the others are a little wider than a plain
  split): (N - 1) full items + half an item + (N - 1) gaps = 100%. The doubled gap goes in its own variable: a custom
  property can't be redefined from itself, and the item width has to subtract the same gap the flex row uses.
  {%- endcomment -%}
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .instagram-feed__carousel {
      --instagram-feed-gap: var(--horizontal-gap);
      gap: var(--instagram-feed-gap);
    }

    #shopify-section-{{ section.id }} .instagram-feed__carousel > .snap-start {
      flex: 0 0 calc((100% - {{ section.settings.items_per_row_desktop | minus: 1 }} * var(--instagram-feed-gap)) / {{ section.settings.items_per_row_desktop | minus: 0.5 }});
    }
  }

  {%- comment -%}
  The play / pause / sound buttons exist only inside the zoom view: on the thumbnails the round play button (media-zoom-slide.liquid) is the
  only control, so the video's own controls group stays hidden there.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .carousel-video-controls:not(.is-lightbox-expanded) {
    display: none;
  }

  {%- if section.settings.bw_intro -%}
    {%- comment -%}
    Black and white intro (setting "Black and white intro"): photos and videos start in grayscale - from the first paint, so the
    color never shows before the effect - and, once the visitor reaches the feed, fade back to color after the configured number
    of seconds (script below). Only the photos and videos are filtered, not the buttons.
    {%- endcomment -%}
    #{{ instagram_feed_id }}.is-bw .instagram-feed__carousel img,
    #{{ instagram_feed_id }}.is-bw .instagram-feed__carousel video-media {
      filter: grayscale(1);
    }

    {%- comment -%}
    The fade back to color is an animation, not a transition: the photos and videos already have transitions of their own (the zoom
    in the lightbox, the poster fade) that a "transition: filter" would replace. The filter goes on the media elements themselves,
    never on an ancestor, which would trap the expanded (position: fixed) photo or video of the lightbox inside it.
    {%- endcomment -%}
    #{{ instagram_feed_id }}.is-bw-fading .instagram-feed__carousel img,
    #{{ instagram_feed_id }}.is-bw-fading .instagram-feed__carousel video-media {
      animation: instagram-feed-bw-fade {{ section.settings.bw_intro_fade }}s ease-in-out forwards;
    }

    @keyframes instagram-feed-bw-fade {
      from {
        filter: grayscale(1);
      }

      to {
        filter: grayscale(0);
      }
    }
  {%- endif -%}

  {%- comment -%}What was over the video fades out (and back) instead of vanishing: the logo, the progress line and the buttons{%- endcomment -%}
  #shopify-section-{{ section.id }} video-media.is-lightbox-expanded::after,
  #shopify-section-{{ section.id }} video-media.is-lightbox-expanded > .lightbox-scrubber {
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  {%- comment -%}
