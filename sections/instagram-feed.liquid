{%- doc -%}
A square-media carousel in an Instagram-feed style: each "Media" block is either an image or a
video (the merchant swaps the type per block from the editor, no code change needed). Extracted
from sections/reviews.liquid, where this started as a block - the design/behavior (square grid,
tap-to-open lightbox, random shuffle per page load) is unchanged, just moved into its own section
so it isn't tied to Reviews.

Image blocks open the lightbox by tapping the photo itself (no visible zoom button - see the
"no separate zoom button" comment below). Video blocks use snippets/media-zoom-slide.liquid as-is,
same as FAQ's "Text + image/video" block and Media Blocks' Carousel: tap the video to play it
inline, or its own small zoom button to open the lightbox - video needs that shared play/pause/
sound control logic, so it isn't worth re-implementing just to also hide that one button.
{%- enddoc -%}

{%- liquid
  assign instagram_media_blocks = section.blocks | where: 'type', 'item'
  assign instagram_media_count = 0

  for block in instagram_media_blocks
    assign instagram_block_has_video = false

    if block.settings.media_type == 'video' and block.settings.video != blank
      assign instagram_block_has_video = true
    endif

    if instagram_block_has_video or block.settings.image != blank
      assign instagram_media_count = instagram_media_count | plus: 1
    endif
  endfor

  assign instagram_has_multiple = false

  if instagram_media_count > 1
    assign instagram_has_multiple = true
  endif

  assign instagram_feed_id = 'instagram-feed-' | append: section.id
  assign instagram_carousel_id = 'instagram-feed-carousel-' | append: section.id
  assign instagram_lightbox_id = 'instagram-feed-lightbox-' | append: section.id

  # Computed once here (same pattern as snippets/faq-text-image.liquid's border_radius_px) instead
  # of repeating "section.settings.instagram_feed_border_radius | append: 'px'" inline at each call
  # site - every image, video and the carousel frame itself then shares this exact same string.
  assign instagram_corner_radius_px = section.settings.instagram_feed_border_radius | append: 'px'

  # Auto-scroll needs more than one card; the speed setting maps to pixels per second
  assign instagram_autoscroll = false

  if section.settings.autoscroll and instagram_has_multiple
    assign instagram_autoscroll = true
  endif

  case section.settings.autoscroll_speed
    when 'slow'
      assign instagram_autoscroll_speed = 30
    when 'fast'
      assign instagram_autoscroll_speed = 70
    else
      assign instagram_autoscroll_speed = 45
  endcase
-%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_instagram_feed %} section-floating section-floating--block{% endif %}"{% if section.settings.floating_instagram_feed %} style="border-radius: {{ instagram_corner_radius_px }}; overflow: hidden;"{% endif %}>
  <div class="section-spacing">
    <div id="{{ instagram_feed_id }}" class="instagram-feed section-stack">
      {%- if section.settings.title != blank or section.settings.subtitle != blank or section.settings.button_text != blank or section.settings.show_icon -%}
        <div class="instagram-feed__header">
          <div class="instagram-feed__content">
            {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
              <div class="prose prose--compact">
                {%- if section.settings.title != blank -%}
                  {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.title_tag, html_tag: 'h2' -%}
                {%- endif -%}

                {%- if section.settings.subtitle != blank -%}
                  <div class="max-w-sm">
                    {{- section.settings.subtitle -}}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.button_text != blank -%}
              {%- render 'button', content: section.settings.button_text, href: section.settings.button_url, style: section.settings.button_style, class: 'instagram-feed__button' -%}
            {%- endif -%}
          </div>

          {%- if section.settings.show_icon -%}
            {%- render 'decorative-icon',
              icon_type: section.settings.icon_type,
              icon_size: section.settings.icon_size,
              icon_spin: section.settings.icon_spin,
              icon_primary_color: section.settings.icon_primary_color,
              icon_secondary_color: section.settings.icon_secondary_color,
              icon_border_color: section.settings.icon_border_color,
              class: 'instagram-feed__icon'
            -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if instagram_media_count > 0 -%}
        <scroll-carousel id="{{ instagram_carousel_id }}" class="instagram-feed__carousel snap-x scroll-area">
          {%- assign instagram_slide_index = 0 -%}

          {%- for block in instagram_media_blocks -%}
            {%- liquid
              assign instagram_block_has_video = false

              if block.settings.media_type == 'video' and block.settings.video != blank
                assign instagram_block_has_video = true
              endif
            -%}

            {%- if instagram_block_has_video -%}
              {%- comment -%}
              autoplay: true (muted, looped) instead of the default tap-to-play, matching an
              Instagram-style feed, on every screen size. The play / pause / sound buttons are hidden by CSS below: the
              videos just play while they are on screen.
              {%- endcomment -%}
              <div class="snap-start" data-caption="{{ block.settings.caption | escape }}" style="--instagram-video-poster: url('{{ block.settings.video.preview_image | image_url: width: 600 }}');" {{ block.shopify_attributes }}>
                {%- render 'media-zoom-slide',
                  video: block.settings.video,
                  autoplay: true,
                  reveal_controls_on_tap: true,
                  corner_radius: instagram_corner_radius_px,
                  lightbox_id: instagram_lightbox_id,
                  lightbox_index: instagram_slide_index,
                  sizes: '90vw'
                -%}
              </div>

              {%- assign instagram_slide_index = instagram_slide_index | plus: 1 -%}
            {%- elsif block.settings.image != blank -%}
              {%- comment -%}
              No separate "zoom" button shown - the button wraps the image itself, so the whole
              square opens the lightbox on tap. It stays invisible with zero extra CSS: the theme's
              global reset already strips any button border/background/padding, and
              .content-box__background-media's width/height: 100% (theme.css) sizes it to fill the
              square since it's the only direct child, same as a plain img would be.

              The direct flex item is a plain div (like the video branch above, and like
              trust-icons.liquid's own carousel items) - open-lightbox-button sits one level inside
              it instead of being the flex item itself, same as it already is inside
              media-zoom-slide.liquid's own output for the video branch.
              {%- endcomment -%}
              <div class="snap-start" data-caption="{{ block.settings.caption | escape }}" {{ block.shopify_attributes }}>
                <open-lightbox-button class="block" aria-controls="{{ instagram_lightbox_id }}" image-index="{{ instagram_slide_index }}">
                  <div class="content-box__background-media">
                    <button type="button">
                      {%- comment -%}
                      sizes/widths are sized for the lightbox's expanded view (up to 96vw, see
                      media-zoom-style.liquid), not the small grid thumbnail - it's the same img
                      element in both states (the lightbox only repositions/rescales it via CSS, never
                      swaps in a different image), so a thumbnail-sized sizes hint here would have the
                      browser fetch a small srcset candidate that then looks soft/blurry once expanded
                      full-screen.
                      {%- endcomment -%}
                      {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: '90vw', widths: '150,300,450,600,900,1200,1500', class: 'instagram-feed__image aspect-square image-cover' -}}
                      <span class="sr-only">{{ 'product.gallery.zoom' | t }}</span>
                    </button>
                  </div>
                </open-lightbox-button>
              </div>

              {%- assign instagram_slide_index = instagram_slide_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </scroll-carousel>

        {%- comment -%}The progress bar and arrows make no sense on an endless, self-moving row, so they only show when auto-scroll is off{%- endcomment -%}
        {%- unless instagram_autoscroll -%}
  {%- render 'scroll-controls', target_id: instagram_carousel_id, show_mobile: section.settings.show_progress_bar_mobile, show_desktop: section.settings.show_progress_bar_desktop, class: 'instagram-feed__scroll-controls' -%}
        {%- endunless -%}

        {%- render 'media-lightbox', id: instagram_lightbox_id, show_nav: instagram_has_multiple -%}

        {%- comment -%}
        Caption shown only in the zoomed-in lightbox, never in the feed grid itself - each "Media"
        block's own caption setting, read from its cell's data-caption attribute by the script below.
        A plain sibling of the shared lightbox snippet rather than something added inside it (shared
        with FAQ/Media Blocks too) - kept entirely local to this section instead. The CSS fade uses
        #{{ instagram_lightbox_id }}.is-lightbox-visible's own existing toggle (a sibling selector,
        no extra JS needed just to fade it in/out in sync with the lightbox itself); the script below
        only has to keep its TEXT in sync with whichever item is currently expanded.
        {%- endcomment -%}
        <p id="{{ instagram_lightbox_id }}-caption" class="instagram-feed__lightbox-caption empty:hidden" aria-live="polite"></p>

        <style>
          {%- render 'media-zoom-style', wrapper_id: instagram_feed_id, lightbox_id: instagram_lightbox_id, corner_radius: instagram_corner_radius_px -%}

          {%- comment -%}
          empty:hidden (theme.css utility) keeps this out of the way entirely when the active item has
          no caption set, instead of reserving space for/fading in an empty bar. top/left/width are all
          left unset here on purpose - desktop's expanded media has no fixed box of its own in pure CSS
          (it's sized by its own content, up to 96vw/96vh), so the script below sets all three itself,
          measured from the actual expanded media's own box (left-aligned to its left edge, same width
          as it, starting just under its bottom edge), every time the active item (or the viewport)
          changes.
          {%- endcomment -%}
          #shopify-section-{{ section.id }} .instagram-feed__lightbox-caption {
            color: rgb(var(--text-color));
            background: rgb(var(--background) / .9);
            text-align: start;
            padding: .5rem 1rem;
            border-radius: {{ instagram_corner_radius_px }};
            z-index: 1000;
            position: fixed;
            opacity: 0;
            scale: .95;
            pointer-events: none;
            transition: opacity .2s ease, scale .2s ease;
          }

          #{{ instagram_lightbox_id }}.is-lightbox-visible ~ .instagram-feed__lightbox-caption {
            opacity: 1;
            scale: 1;
          }
        </style>

        {%- comment -%}
        Reshuffles the media into a random order on every page load (not persisted - a fresh
        shuffle each visit). Runs as a plain synchronous script, BEFORE media-zoom-script below: that
        one captures its own "cells" snapshot inside an async customElements.whenDefined() callback,
        so this reorder - and the image-index rewrite that keeps each slide's lightbox index
        matching its new position - has to land first, or the lightbox would open the wrong item for
        whatever position was clicked. Every cell is a plain div (see above) with its
        open-lightbox-button nested one level inside.
        {%- endcomment -%}
        <script>
          (function () {
            var carousel = document.getElementById('{{ instagram_carousel_id }}');
            if (!carousel) return;

            function shuffle(array) {
              for (var i = array.length - 1; i > 0; i--) {
                var j = Math.floor(Math.random() * (i + 1));
                var swap = array[i];
                array[i] = array[j];
                array[j] = swap;
              }
            }

            {%- comment -%}
            Videos and images are shuffled independently within each group (still a fresh order every page
            load) and then interleaved: the videos are spread evenly through the row, starting with one
            (video, image, video, image... when there are as many of each; with fewer videos they are evenly
            spaced between the images), instead of one shuffle across everything, which could clump them.
            {%- endcomment -%}
            var videoCells = [];
            var otherCells = [];

            Array.prototype.forEach.call(carousel.children, function (cell) {
              if (cell.querySelector('video-media')) {
                videoCells.push(cell);
              } else {
                otherCells.push(cell);
              }
            });

            shuffle(videoCells);
            shuffle(otherCells);

            var cells = new Array(videoCells.length + otherCells.length);
            var nextImage = 0;

            videoCells.forEach(function (cell, index) {
              cells[Math.floor(index * cells.length / videoCells.length)] = cell;
            });

            for (var slot = 0; slot < cells.length; slot++) {
              if (!cells[slot]) cells[slot] = otherCells[nextImage++];
            }

            cells.forEach(function (cell, index) {
              var openButton = cell.querySelector('open-lightbox-button');

              if (openButton) {
                openButton.setAttribute('image-index', index);
              }

              carousel.appendChild(cell);
            });

            {%- comment -%}
            Lazy video loading: nothing is fetched for a video until the visitor gets near the section. Every <video> starts
            with preload="none" (instead of the "metadata" the media snippet sets), and <video-media> (theme.js, VideoMedia)
            switches it to "auto" and picks the right source once the video is within 800px of the screen, so it is ready
            when it comes into view. The autoplay below is also limited to videos actually on screen, vertically as well.
            {%- endcomment -%}
            Array.prototype.forEach.call(carousel.querySelectorAll('video'), function (video) {
              video.setAttribute('preload', 'none');
            });

            {%- comment -%}
            Every video of the feed autoplays (muted, looped) while it is on screen, on every screen size, and none shows play /
            pause or sound buttons (CSS below hides them). Pausing a video when it leaves the screen and starting it again every
            time it comes back is a rule for every autoplaying video of the theme (BaseMedia in assets/theme.js); a video only
            fetches data once the visitor is near it (preload none, see above), so only what is on screen costs anything.
            On mobile the zoom button is always visible instead of revealed on tap: the tap-to-reveal class is dropped from
            it here, while this script still runs before media-zoom-script.liquid reads that class.
            {%- endcomment -%}
            if (window.matchMedia('(max-width: 699px)').matches) {
              Array.prototype.forEach.call(carousel.querySelectorAll('open-lightbox-button.carousel-video-controls--tap-to-reveal'), function (element) {
                element.classList.remove('carousel-video-controls--tap-to-reveal');
              });
            }

            {%- comment -%}
            <video-media autoplay> (assets/theme.js, BaseMedia#connectedCallback) only calls
            .play() once an IntersectionObserver first reports it as visible - that observer is set
            up when each element connects, which (since theme.js is deferred) happens AFTER this
            same script has already reordered them above. It should already re-fire from that
            reorder alone, but requestAnimationFrame + an explicit .play() call here is a cheap
            safety net for whichever shuffled-in item ends up visible first on mobile.

            Scoped to cells actually inside the carousel's own visible (horizontally un-clipped)
            width on purpose - calling .play() unconditionally on every cell, including the ones
            scrolled off-screen, was making every autoplaying video in the whole carousel start
            fetching/buffering at once on page load (a real page-load slowdown with more than a
            couple of video items), not just the one or two actually on screen. media-blocks.liquid's
            own carousel never hits this at all: it never passes autoplay: true to media-zoom-slide
            in the first place, so nothing there ever force-plays off-screen video - autoplay here is
            the one deliberate difference from that section (per an earlier request), so unlike
            media-blocks this needs this extra visibility check to stay just as lazy for everything
            that isn't actually on screen yet.
            {%- endcomment -%}
            requestAnimationFrame(function () {
              var carouselRect = carousel.getBoundingClientRect();

              cells.forEach(function (cell) {
                var videoMedia = cell.querySelector('video-media[autoplay]');

                if (!videoMedia || typeof videoMedia.play !== 'function') {
                  return;
                }

                var cellRect = cell.getBoundingClientRect();
                var isWithinCarousel = cellRect.right > carouselRect.left && cellRect.left < carouselRect.right && cellRect.bottom > 0 && cellRect.top < window.innerHeight;

                if (isWithinCarousel) {
                  videoMedia.play();
                }
              });
            });
          })();
        </script>

        {%- if instagram_autoscroll -%}
          {%- comment -%}
          Auto-scroll as a conveyor belt: the row moves left at a constant, slow speed, forever, with no
          stops between cards. Each frame advances a float position by speed * elapsed time (so the speed
          is the same on any refresh rate); when the first card has completely left the visible area it is
          moved to the end of the row and the position is shifted back by exactly its width, which the eye
          can't notice, so the row never ends. Cards are moved, not cloned, so there are no duplicated
          videos or lightbox items. It needs enough cards to be wider than the viewport plus one card;
          otherwise it does nothing.

          It stops only when the visitor takes over: while a pointer or finger is pressed on the row (which
          includes tapping a photo or a video), while they scroll it themselves (plus a short moment
          after), while something inside has focus, while the lightbox is open, and on mobile while a
          video they started is playing. It also rests while the section is off-screen or the tab is hidden,
          and is disabled for prefers-reduced-motion and right-to-left pages. Snapping is off (see the
          style above) so it can move continuously.
          {%- endcomment -%}
          <script>
            (function () {
              var carousel = document.getElementById('{{ instagram_carousel_id }}');
              var lightbox = document.getElementById('{{ instagram_lightbox_id }}');

              if (!carousel || !lightbox) return;
              if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
              if (window.getComputedStyle(carousel).direction === 'rtl') return;

              var speed = {{ instagram_autoscroll_speed }};
              var mobileQuery = window.matchMedia('(max-width: 699px)');
              var position = carousel.scrollLeft;
              var assigned = position;
              var shifted = false;
              var previousTimestamp = null;
              var pressing = false;
              var focused = false;
              var visible = true;
              var lastInteraction = 0;

              function shift(fraction) {
                Array.prototype.forEach.call(carousel.children, function (cell) {
                  cell.style.transform = fraction ? 'translate3d(' + (-fraction) + 'px, 0, 0)' : '';
                });

                shifted = fraction !== 0;
              }

              function release() {
                if (shifted) shift(0);

                position = carousel.scrollLeft;
                assigned = position;
              }

              function canRun() {
                var now = Date.now();

                if (!visible || document.hidden || pressing || focused) return false;

                if (lightbox.classList.contains('is-lightbox-visible') || (mobileQuery.matches && carousel.querySelector('video-media[playing]'))) {
                  lastInteraction = now;
                  return false;
                }

                return now - lastInteraction > 1200;
              }

              function frame(timestamp) {
                requestAnimationFrame(frame);

                var elapsed = previousTimestamp === null ? 0 : Math.min(timestamp - previousTimestamp, 64);

                previousTimestamp = timestamp;

                if (!canRun()) {
                  release();
                  return;
                }

                var first = carousel.firstElementChild;
                var step = first.getBoundingClientRect().width + (parseFloat(window.getComputedStyle(carousel).columnGap) || 0);

                if (carousel.scrollWidth - carousel.clientWidth <= step + 4) return;

                position += speed * elapsed / 1000;

                if (position >= step) {
                  carousel.appendChild(first);
                  position -= step;
                }

                {%- comment -%}
                scrollLeft only takes whole pixels on standard-density screens, which made the row advance in
                visible 1px hops; the whole part goes to scrollLeft and the remainder is applied as a
                translate on the cells (composited, so sub-pixel smooth). The translate is removed whenever
                the row stops, because a transformed ancestor would break the lightbox's fixed positioning.
                {%- endcomment -%}
                var whole = Math.floor(position);

                carousel.scrollLeft = whole;
                assigned = whole;
                shift(position - whole);
              }

              carousel.addEventListener('pointerdown', function () {
                pressing = true;
                release();
              });

              ['pointerup', 'pointercancel'].forEach(function (name) {
                window.addEventListener(name, function () {
                  if (!pressing) return;

                  pressing = false;
                  lastInteraction = Date.now();
                });
              });

              carousel.addEventListener('scroll', function () {
                if (Math.abs(carousel.scrollLeft - assigned) > 1.5) lastInteraction = Date.now();
              }, { passive: true });

              carousel.addEventListener('focusin', function () {
                focused = true;
                release();
              });

              carousel.addEventListener('focusout', function () {
                focused = false;
                lastInteraction = Date.now();
              });

              if ('IntersectionObserver' in window) {
                new IntersectionObserver(function (entries) {
                  visible = entries[0].isIntersecting;
                }, { threshold: 0.1 }).observe(carousel);
              }

              requestAnimationFrame(frame);
            })();
          </script>
        {%- endif -%}

        {%- render 'media-zoom-script', wrapper_id: instagram_feed_id, lightbox_id: instagram_lightbox_id, carousel_id: instagram_carousel_id -%}

        {%- comment -%}
        Keeps the lightbox caption's TEXT and POSITION in sync with whichever item is currently
        expanded - open, close, and next/prev inside the lightbox (snippets/media-zoom-script.liquid)
        all end up toggling the "is-lightbox-expanded" class onto that item's own <img>/<video-media>,
        so watching for that one class, scoped to this carousel, covers every way the active item can
        change without needing its own copy of (or any changes to) that shared open/close/navigate
        logic. The caption's own fade in/out is handled in CSS alone (see the sibling selector above).

        Position: the expanded media has no fixed box of its own in CSS (sized by its own content, up
        to 96vw/96vh - see media-zoom-style.liquid), so there's no pure-CSS anchor to left-align a
        caption under it. getBoundingClientRect() reads wherever it actually ended up rendering (left
        edge, width, bottom edge) and places the caption flush with its left edge, the same width as
        it, a small fixed gap below - re-measured on resize too (the media's own rendered size/
        position changes then, eg. rotating a phone), not just when the active item changes.
        {%- endcomment -%}
        <script>
          (function () {
            var carousel = document.getElementById('{{ instagram_carousel_id }}');
            var caption = document.getElementById('{{ instagram_lightbox_id }}-caption');

            if (!carousel || !caption) return;

            var captionGap = 12;

            function syncCaption() {
              var expanded = carousel.querySelector('.is-lightbox-expanded');
              var cell = expanded ? expanded.closest('.snap-start') : null;

              caption.textContent = cell ? cell.dataset.caption || '' : '';

              if (expanded) {
                var rect = expanded.getBoundingClientRect();
                caption.style.top = (rect.bottom + captionGap) + 'px';
                caption.style.left = rect.left + 'px';
                caption.style.width = rect.width + 'px';
              }
            }

            new MutationObserver(syncCaption).observe(carousel, {
              attributes: true,
              attributeFilter: ['class'],
              subtree: true
            });

            window.addEventListener('resize', syncCaption);
          })();
        </script>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  {%- comment -%}
  ============================================================
  TITLE/SUBTITLE SPACING
  ============================================================
  Overrides --prose-default-spacing (set by .prose--compact in the markup above, 1/1.25rem) to match
  .instagram-feed__content's own gap below (1rem) - keeps the title-to-subtitle gap the same size as
  the subtitle-to-button gap, instead of introducing a parallel spacing scheme.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .prose {
    --prose-default-spacing: 1rem;
  }

  {%- comment -%}
  ============================================================
  HEADER (content column + icon column)
  ============================================================
  Two real columns, same on mobile and desktop - no breakpoint-specific swap. .instagram-feed__content
  (title, subtitle and button stacked) takes the start side, the icon (when shown) sits in its own
  column flush to the end. A plain flex row instead of pulling the icon out with position: absolute:
  that let the icon overlap the subtitle on narrow screens once the column grew tall enough to reach
  it, since an out-of-flow element doesn't share space with in-flow content. flex: 1 + min-width: 0
  on the content column let it take the remaining width and wrap/shrink its own text inside that,
  while flex-shrink: 0 on the icon keeps it at its own natural size instead of being squeezed.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .instagram-feed__header {
    align-items: start;
    gap: 1rem;
    display: flex;
  }

  #shopify-section-{{ section.id }} .instagram-feed__content {
    min-width: 0;
    flex: 1;
    gap: 1rem;
    align-items: start;
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .instagram-feed__content > .prose {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .instagram-feed__icon {
    flex-shrink: 0;
  }

  {%- comment -%}
  Same title alignment system as sections/contact.liquid's .contact-heading-row__title: without it,
  align-items: start above lines the icon up with the top of the title's full line-height box, not
  its visible glyphs - text-box trims that invisible leading off so the icon's top edge is flush with
  the visible top of the title text instead of sitting visibly lower than it.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .instagram-feed__content > .prose > h2 {
    text-box: trim-both cap alphabetic;
  }

  {%- comment -%}
  Independent of button_style (outline already has its own border, solid/link normally don't) -
  left blank by default (the color picker's own "no color" state), so nothing renders unless the
  merchant explicitly picks one.
  {%- endcomment -%}
  {%- if section.settings.button_border_color != blank -%}
    #shopify-section-{{ section.id }} .instagram-feed__button {
      border: 1px solid rgb({{ section.settings.button_border_color.rgb }});
    }
  {%- endif -%}

  {%- comment -%}
  ============================================================
  FLOATING MODE / SECTION PADDING
  ============================================================
  Same formula as sections/reviews.liquid and sections/faq.liquid: gutter + 0.5rem on every side,
  at every breakpoint, instead of .section-spacing's generic page-to-page rhythm.
  {%- endcomment -%}
  {%- if section.settings.floating_instagram_feed -%}
    #shopify-section-{{ section.id }} .section-spacing {
      padding-block: 0;
    }

    #shopify-section-{{ section.id }} .instagram-feed {
      padding: calc(var(--container-gutter) + 0.5rem);
    }

    {%- comment -%}
    Same corner radius as the outer floating wrapper (which only clips the section's own edges,
    far from the carousel once the padding above is in between). Without this, scrolling the
    carousel reveals a plain square-cornered viewport in the middle of a rounded section - adding
    the radius directly to .instagram-feed__carousel (with overflow-x: auto / overflow-y: hidden
    already set below) clips every slide to that same rounded shape at rest, so the corners stay
    rounded through the whole scroll range instead of only at the section's own edge.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .instagram-feed__carousel {
      border-radius: {{ instagram_corner_radius_px }};
    }

    {%- if section.settings.attach_to_footer -%}
      {%- comment -%}
      "Attach to footer": only when this section is the last one of the page content, so the footer comes right after it
      (the footer lives in its own section group, right below <main>). The two join with no gap: this section loses its
      bottom margin and its bottom corners, keeping only the top ones, and the footer loses all its rounded corners.
      Side margins stay (both are floating). The footer's own rules are scoped through :root:has(), because it is a
      different section.
      {%- endcomment -%}
      main > #shopify-section-{{ section.id }}:last-child > .section-floating {
        margin-block-end: 0 !important;
        border-radius: {{ instagram_corner_radius_px }} {{ instagram_corner_radius_px }} 0 0 !important;
      }

      :root:has(main > #shopify-section-{{ section.id }}:last-child) .shopify-section--footer {
        margin-block-start: 0;
      }

      :root:has(main > #shopify-section-{{ section.id }}:last-child) .shopify-section--footer .footer {
        border-radius: 0 !important;
      }
    {%- endif -%}
  {%- endif -%}

  {%- comment -%}
  ============================================================
  CAROUSEL LAYOUT
  ============================================================
  Flexbox instead of CSS grid on purpose: a grid's auto-generated columns (grid-auto-columns) were
  reporting the row's full, un-clipped content width - the sum of every column, intentionally wider
  than the visible area once there are more items than fit - as this element's own size to the
  outer .instagram-feed.section-stack grid it sits in, pushing the whole page wider once enough
  images/videos were added to actually exceed the visible column count. Flex items aren't measured
  that way: flex: 0 0 <basis> fixes each item's width without ever letting the row's intrinsic
  content size feed back into the container's own sizing, so .scroll-area's overflow: auto hidden
  reliably clips the rest instead.

  Mobile: a single row of 2 items that tiles the full width - any extra items beyond those 2
  overflow and scroll horizontally. Desktop: 4 items, same idea. Width stays an even split on
  purpose - only the height changes (.instagram-feed__image/.content-box aspect-ratio override
  further down), not how many items fit per row.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .instagram-feed__carousel {
    gap: var(--item-gap-inline);
    width: 100%;
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    display: flex;
  }

  {%- if instagram_autoscroll -%}
    #shopify-section-{{ section.id }} .instagram-feed__carousel {
      scroll-snap-type: none;
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .instagram-feed__carousel > .snap-start {
    flex: 0 0 calc((100% - var(--item-gap-inline)) / 2);
    min-width: 0;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .instagram-feed__carousel > .snap-start {
      flex: 0 0 calc((100% - 3 * var(--item-gap-inline)) / 4);
    }
  }

  {%- comment -%}
  Desktop (1000px and up): the squares are as wide as the row divided by "Items per row (desktop)" - more items
  per row means smaller squares (height follows, they stay square). Tablets keep 4 per row.
  {%- endcomment -%}
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .instagram-feed__carousel > .snap-start {
      flex: 0 0 calc((100% - {{ section.settings.items_per_row_desktop | minus: 1 }} * var(--item-gap-inline)) / {{ section.settings.items_per_row_desktop }});
    }
  }

  {%- comment -%}
  Every video plays by itself, so there are no play/pause or sound buttons at any screen size, only the zoom button
  (always visible on mobile, revealed on hover/tap on desktop).
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .carousel-video-controls {
    display: none;
  }

  {%- comment -%}
  The video's poster is also painted as the box's own background, behind the <video>: some browsers (iOS Safari) drop the
  <video> poster the moment play() is called and show an empty box until the first frame is decoded, which read as a blank
  square while scrolling into the feed. The video draws over this image as soon as it has a frame.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .snap-start > .content-box {
    background: var(--instagram-video-poster, none) center / cover no-repeat;
  }

  {%- comment -%}
  Flush controls: when the merchant's control button background (Color scheme > Controls) is fully
  transparent, the play/pause, sound and zoom icons have nothing to sit on, so the button's own square and
  the zoom icon's .75rem padding are just invisible dead space. In the thumbnail only, drop them and
  offset the icons .75rem from the video's edges - the same inset the header logo overlay uses
  (media-zoom-style.liquid), so icons and logo share one margin. The expanded lightbox state (.is-lightbox-expanded) is left untouched.
  {%- endcomment -%}
  {%- assign instagram_control_bg = section.settings.color_scheme.settings.control_button_background_color -%}
  {%- if instagram_control_bg == blank -%}
    {%- assign instagram_control_bg = settings.control_button_background_color -%}
  {%- endif -%}
  {%- if instagram_control_bg != blank and instagram_control_bg.alpha == 0 -%}
    #shopify-section-{{ section.id }} .carousel-video-controls:not(.is-lightbox-expanded) {
      inset-block-start: 0.75rem;
      inset-inline-end: 0.75rem;
      gap: 0.5rem;
    }

    #shopify-section-{{ section.id }} .carousel-video-controls:not(.is-lightbox-expanded) > * {
      width: auto !important;
      height: auto !important;
      padding: 0;
    }

    #shopify-section-{{ section.id }} .content-box:not(:has(.is-lightbox-expanded)) .product-zoom-button {
      inset-block-end: 0.75rem;
      inset-inline-end: 0.75rem;
    }

    #shopify-section-{{ section.id }} .content-box:not(:has(.is-lightbox-expanded)) .product-zoom-button .icon {
      padding: 0;
    }
  {%- endif -%}

  {%- comment -%}
  object-fit: cover/display: block for the image case come from the theme's global img rule, and
  the square shape from the existing .aspect-square utility (both in assets/theme.css) - only the
  width (to fill its grid column) and the corner radius are added here.

  The video case renders through media-zoom-slide.liquid's own .content-box, which isn't square by
  default (it's built for FAQ/Media Blocks' own configurable-ratio hero blocks) - aspect-ratio: 1
  here forces it to match the image thumbnails instead of adding a parallel sizing mechanism.

  border-radius here reuses instagram_corner_radius_px (same value as the carousel's own frame
  above and the video thumbnail's corner_radius param below) instead of a fixed px value with no
  real source - so every corner in this section (carousel frame, image thumbnails, video
  thumbnails) always matches whatever the merchant sets, instead of the images being stuck at an
  arbitrary radius the rest of the section doesn't share.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .instagram-feed__image {
    width: 100%;
    border-radius: {{ instagram_corner_radius_px }};
  }

  {%- comment -%}
  Taller than square on every breakpoint now (overrides .aspect-square's aspect-ratio: 1,
  assets/theme.css, and the aspect-ratio: 1 rule right above for video) - width keeps coming from
  .instagram-feed__carousel > .snap-start above (unchanged on both mobile and desktop), only the
  height grows. Mobile is taller still (3:5) than desktop (4:5, a more modest bump) - two separate
  values instead of one shared ratio since they were asked for separately.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .instagram-feed__image,
  #shopify-section-{{ section.id }} .content-box {
    aspect-ratio: 4 / 5;
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .instagram-feed__image,
    #shopify-section-{{ section.id }} .content-box {
      aspect-ratio: 3 / 5;
    }
  }

  {%- comment -%}
  The video case never has this problem: its forced aspect-ratio lives on .content-box, an ANCESTOR
  of the element that actually gets .is-lightbox-expanded (video-media) - once that's position: fixed,
  it's sized purely by its own width/height/max-width/max-height (media-zoom-style.liquid), completely
  independent of its parent's box. The image case is different: .is-lightbox-expanded (and
  position: fixed) lands directly ON the <img> that ALSO carries .instagram-feed__image's own forced
  aspect-ratio above - that's a property of the element itself, not something position: fixed exempts
  it from, so without this it stayed locked to the grid's cropped 4/5 (or 2/3) shape even full-screen,
  instead of showing the photo's real proportions like every other expanded image in the theme does.

  border-radius is re-asserted here too (same instagram_corner_radius_px value media-zoom-style.liquid
  already sets on img.is-lightbox-expanded) at higher specificity (two ids instead of one) so it wins
  regardless of source order - belt-and-suspenders against whatever was making the expanded video
  round but the expanded image not, since nothing else here explains that difference once
  aspect-ratio is accounted for.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} #{{ instagram_feed_id }} img.is-lightbox-expanded {
    aspect-ratio: auto;
    border-radius: {{ instagram_corner_radius_px }};
  }
</style>

