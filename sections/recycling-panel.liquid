{%- liquid
  assign text_alignment_class = section.settings.text_alignment | replace: 'left', 'start' | replace: 'right', 'end'
  assign image = section.settings.image
  assign has_left = false
  for block in section.blocks
    if block.settings.side == 'left'
      assign has_left = true
    endif
  endfor
  assign built_in = false
  if section.settings.illustration == 'built_in'
    assign built_in = true
  endif

  # Built-in drawing: the bottle (144 x 347 units) and the box are drawn twice - side by side (desktop) and stacked (phones) -
  # so the figure's ratio and the center of every part (as % of the drawing) are different at each breakpoint.
  assign box_scale = section.settings.box_scale | divided_by: 100.0
  assign bw = 150 | times: box_scale | round: 1
  assign bh = 300 | times: box_scale | round: 1
  assign gap = 40

  assign vbw_d = 184 | plus: bw
  # The box is taller than the bottle with its cap (347): when it is, the drawing grows to the box and the bottle sits on the same baseline.
  assign vbh_d = 347.0
  if bh > 347
    assign vbh_d = bh | times: 1.0
  endif
  assign bottle_dy = vbh_d | minus: 347
  assign box_y_d = vbh_d | minus: bh

  assign vbw_m = bw
  if bw < 144
    assign vbw_m = 144
  endif
  assign vbw_m = vbw_m | times: 1.0
  assign bx_m = vbw_m | minus: 144 | divided_by: 2.0
  assign box_x_m = vbw_m | minus: bw | divided_by: 2.0
  assign box_y_m = 347 | plus: gap
  assign vbh_m = box_y_m | plus: bh

  assign ratio_mobile = 1
  assign ratio_desktop = 1
  if built_in
    assign ratio_mobile = vbw_m | divided_by: vbh_m
    assign ratio_desktop = vbw_d | divided_by: vbh_d
  elsif image != blank
    assign ratio_mobile = image.aspect_ratio
    assign ratio_desktop = image.aspect_ratio
  endif

  # Centers of cap / bottle body / box as % of the drawing: phones (am_) and desktop (ad_).
  assign am_cap_x = bx_m | plus: 72 | divided_by: vbw_m | times: 100 | round: 2
  assign am_cap_y = 40 | divided_by: vbh_m | times: 100 | round: 2
  assign am_body_y = 215 | divided_by: vbh_m | times: 100 | round: 2
  assign am_box_y = bh | divided_by: 2.0 | plus: box_y_m | divided_by: vbh_m | times: 100 | round: 2
  assign ad_cap_x = 72 | divided_by: vbw_d | times: 100 | round: 2
  assign ad_cap_y = 40 | plus: bottle_dy | divided_by: vbh_d | times: 100 | round: 2
  assign ad_body_y = 215 | plus: bottle_dy | divided_by: vbh_d | times: 100 | round: 2
  assign ad_box_x = bw | divided_by: 2.0 | plus: 184 | divided_by: vbw_d | times: 100 | round: 2
  assign ad_box_y = bh | divided_by: 2.0 | plus: box_y_d | divided_by: vbh_d | times: 100 | round: 2
-%}
{%- capture anchors -%}{{ am_cap_x }},{{ am_cap_y }},{{ am_body_y }},{{ am_box_y }},{{ ad_cap_x }},{{ ad_cap_y }},{{ ad_body_y }},{{ ad_box_x }},{{ ad_box_y }}{%- endcapture -%}

<style>
  {%- comment -%}
  Scoped with #shopify-section-{{ section.id }} (plain <style>, not {% stylesheet %}, which is deduplicated per section TYPE
  and would leak the shared .container/.section-spacing selectors into every other section). The card gets the store's
  side gutter as padding on the outer wrapper, so the rounded card never touches the screen edge.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .container.section-spacing {
    margin-inline: 0;
    padding-inline: var(--container-gutter);
    padding-block-end: 0;
  }

  #shopify-section-{{ section.id }} {
    --recycling-dot: {{ section.settings.dot_color.rgb }};
    --recycling-line: {{ section.settings.line_color.rgb }};
    --recycling-tab-bg: {{ section.settings.tab_background.rgb }};
    --recycling-tab-text: {{ section.settings.tab_text_color.rgb }};
    --recycling-tab-weight: {{ section.settings.tab_font_weight }};
    --recycling-radius: {{ section.settings.corner_radius }}px;
    --recycling-ratio: {{ ratio_mobile }};
    --recycling-bottle: {{ section.settings.bottle_color.rgb }};
    --recycling-cap: {{ section.settings.cap_color.rgb }};
    --recycling-box: {{ section.settings.box_color.rgb }};
    --recycling-outline: {{ section.settings.outline_color.rgb }};
    --recycling-outline-width: {{ section.settings.outline_width }}px;
    --recycling-image-width: {{ section.settings.mobile_image_width }}cqw;
    --recycling-max-height: {{ section.settings.mobile_image_max_height }}px;
    --recycling-room-l: 0px;
    --recycling-room-r: min(10rem, 48cqw);
  }

  {%- comment -%}
  Two independent boxes: __content (left / top, holds all the information) and __tab (right / bottom). __content carries the
  theme's normal inner padding (same value .content-box uses) on all four sides and clips whatever is inside it.
  {%- endcomment -%}
  {%- comment -%}
  The panel is the dark box (the tab's color) and the content card sits on top of it with its own rounded corners, so the tab
  shows through behind them: the tab slides under the card by one corner radius (negative margin + extra padding).
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .recycling-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-radius: var(--recycling-radius);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .recycling-panel--has-tab {
    background: rgb(var(--recycling-tab-bg));
  }

  #shopify-section-{{ section.id }} .recycling-panel__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    {%- comment -%}Phones: the text takes its own height and the illustration row takes all the rest, so it is centered vertically in it.{%- endcomment -%}
    grid-template-rows: auto 1fr;
    gap: 2rem;
    padding: max(1.5rem, var(--container-gutter));
    min-width: 0;
    overflow: clip;
    position: relative;
    z-index: 1;
    border-radius: var(--recycling-radius);
  }

  #shopify-section-{{ section.id }} .recycling-panel__text {
    align-self: end;
  }

  #shopify-section-{{ section.id }} .recycling-panel__text > * + * {
    margin-block-start: 1rem;
  }

  {%- comment -%}
  The stage is a size container: image width / offset are in cqw (1% of the stage width), so they are measured against the same
  box wherever they are used. Inside it, a 3-column grid [left room | illustration | right room]. The label texts are normal
  grid items of the side columns (not absolutely positioned), so they wrap inside their column and the stage grows to fit them:
  they can never cross the content box's padding. Each text is dropped down by the same fraction of the illustration height
  the dot sits at (--y), minus half a line so the line meets the middle of the title.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .recycling-panel__stage {
    container-type: inline-size;
    align-self: center;
    min-width: 0;
    padding-block-start: 1.25rem;
  }

  #shopify-section-{{ section.id }} .recycling-panel__grid {
    {%- comment -%}
    Automatic fit: the label texts get a fixed room on their side (left only when some label sits on the left; phones never),
    the illustration is as wide as the width setting allows within what is left, and it is centered in that remaining space.
    {%- endcomment -%}
    --recycling-avail: calc(100cqw - var(--recycling-room-l) - var(--recycling-room-r));
    --recycling-fw: max(3rem, min(var(--recycling-image-width), calc(var(--recycling-max-height) * var(--recycling-ratio)), var(--recycling-avail)));
    --recycling-io: max(var(--recycling-room-l), calc(var(--recycling-room-l) + (var(--recycling-avail) - var(--recycling-fw)) / 2));
    --recycling-fh: calc(var(--recycling-fw) / var(--recycling-ratio));
    display: grid;
    grid-template-columns: var(--recycling-io) var(--recycling-fw) minmax(0, 1fr);
    align-items: start;
  }

  #shopify-section-{{ section.id }} .recycling-panel__figure {
    grid-area: 1 / 2;
    position: relative;
    aspect-ratio: var(--recycling-ratio);
  }

  #shopify-section-{{ section.id }} .recycling-panel__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  {%- comment -%}Built-in drawing: one SVG per layout, only the one for the current breakpoint is shown. Colors come from the settings.{%- endcomment -%}
  #shopify-section-{{ section.id }} .recycling-panel__image--desktop {
    display: none;
  }

  {%- comment -%}The outline is centered on the edge of each shape, so half of it falls outside the drawing's box: let it show instead of being clipped.{%- endcomment -%}
  #shopify-section-{{ section.id }} svg.recycling-panel__image {
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .recycling-art__bottle { fill: rgb(var(--recycling-bottle)); }
  #shopify-section-{{ section.id }} .recycling-art__cap { fill: rgb(var(--recycling-cap)); }
  #shopify-section-{{ section.id }} .recycling-art__box { fill: rgb(var(--recycling-box)); }

  #shopify-section-{{ section.id }} .recycling-art__bottle,
  #shopify-section-{{ section.id }} .recycling-art__cap,
  #shopify-section-{{ section.id }} .recycling-art__box {
    stroke: rgb(var(--recycling-outline));
    stroke-width: var(--recycling-outline-width);
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  {%- comment -%}Dot position / text height are set per layout (--*-m phones, --*-d desktop): a built-in part sits in a different place in each drawing.{%- endcomment -%}
  #shopify-section-{{ section.id }} .recycling-label,
  #shopify-section-{{ section.id }} .recycling-label__text {
    --y: var(--y-m);
    --dot-x: var(--dot-x-m);
    --y-pct: calc(var(--y) * 100%);
  }

  #shopify-section-{{ section.id }} .recycling-label__dot {
    position: absolute;
    top: var(--y-pct);
    left: var(--dot-x);
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: rgb(var(--recycling-dot));
    transform: translate(-50%, -50%);
  }

  #shopify-section-{{ section.id }} .recycling-label__line {
    position: absolute;
    top: var(--y-pct);
    left: var(--dot-x);
    width: calc(100% - var(--dot-x) + 2.25rem);
    height: 1px;
    background: rgb(var(--recycling-line));
  }

  #shopify-section-{{ section.id }} .recycling-label__text {
    grid-row: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    {%- comment -%}Inherits the body font size; the first line (the title) is centered on the line, the rest hangs below it.{%- endcomment -%}
    line-height: var(--text-line-height, 1.5);
    margin-block-start: calc(var(--recycling-fh) * var(--y) - 0.5lh);
  }

  #shopify-section-{{ section.id }} .recycling-label__text--right {
    grid-column: 3;
    margin-inline-start: 2.5rem;
  }

  {%- comment -%}Left-side texts exist only on desktop; on phones every label is shown in the right column.{%- endcomment -%}
  #shopify-section-{{ section.id }} .recycling-label__text--left {
    display: none;
  }

  #shopify-section-{{ section.id }} .recycling-label__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .recycling-label__title {
    display: block;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .recycling-panel__tab {
    display: flex;
    align-items: center;
    margin-block-start: calc(-1 * var(--recycling-radius));
    padding: calc(1rem + var(--recycling-radius)) max(1.5rem, var(--container-gutter)) 1rem;
    color: rgb(var(--recycling-tab-text));
  }

  {%- comment -%}The size comes from the theme's heading classes (display-xl ... h7, same list as the Heading block); only the weight is its own.{%- endcomment -%}
  #shopify-section-{{ section.id }} .recycling-panel__tab-text {
    font-weight: var(--recycling-tab-weight);
    margin: 0;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      --recycling-image-width: {{ section.settings.image_width }}cqw;
      --recycling-max-height: {{ section.settings.image_max_height }}px;
      --recycling-room-l: {% if has_left %}min(12rem, 30cqw){% else %}0px{% endif %};
      --recycling-room-r: min(12rem, 30cqw);
      --recycling-ratio: {{ ratio_desktop }};
    }

    #shopify-section-{{ section.id }} .recycling-panel {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    #shopify-section-{{ section.id }} .recycling-panel__stage {
      align-self: end;
    }

    #shopify-section-{{ section.id }} .recycling-panel__image--mobile {
      display: none;
    }

    #shopify-section-{{ section.id }} .recycling-panel__image--desktop {
      display: block;
    }

    #shopify-section-{{ section.id }} .recycling-label,
    #shopify-section-{{ section.id }} .recycling-label__text {
      --y: var(--y-d);
      --dot-x: var(--dot-x-d);
    }

    #shopify-section-{{ section.id }} .recycling-panel__content {
      grid-template-rows: auto;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 3rem;
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .recycling-panel__tab {
      align-items: flex-end;
      margin-block-start: 0;
      margin-inline-start: calc(-1 * var(--recycling-radius));
      padding: max(1.5rem, var(--container-gutter)) 0.75rem max(1.5rem, var(--container-gutter)) calc(0.75rem + var(--recycling-radius));
    }

    #shopify-section-{{ section.id }} .recycling-panel__tab-text {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }

    #shopify-section-{{ section.id }} .recycling-label__text--right.recycling-label__text--of-left {
      display: none;
    }

    #shopify-section-{{ section.id }} .recycling-label__text--left {
      display: block;
      grid-column: 1;
      margin-inline-end: 2.5rem;
      text-align: end;
    }

    #shopify-section-{{ section.id }} .recycling-label--left .recycling-label__line {
      left: auto;
      right: calc(100% - var(--dot-x));
      width: calc(var(--dot-x) + 2.25rem);
    }
  }
</style>

<div class="container section-spacing">
  <div class="recycling-panel{% if section.settings.tab_text != blank %} recycling-panel--has-tab{% endif %}">
    <div class="recycling-panel__content color-scheme color-scheme--{{ section.settings.color_scheme.id }} min-h-{{ section.settings.mobile_block_size }} md:min-h-{{ section.settings.block_size }}">
      <div class="recycling-panel__text prose text-{{ text_alignment_class }}">
        {%- if section.settings.title != blank -%}
          <{{ section.settings.heading_tag }} class="h2">{{ section.settings.title }}</{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.content != blank -%}
          <div class="rte">{{ section.settings.content }}</div>
        {%- endif -%}
      </div>

      <div class="recycling-panel__stage">
        <div class="recycling-panel__grid">
          <div class="recycling-panel__figure">
            {%- if built_in -%}
              <svg class="recycling-panel__image recycling-panel__image--mobile" viewBox="0 0 {{ vbw_m }} {{ vbh_m }}" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <g transform="translate({{ bx_m }} 0)">{% render 'recycling-bottle' %}</g>
                <rect class="recycling-art__box" x="{{ box_x_m }}" y="{{ box_y_m }}" width="{{ bw }}" height="{{ bh }}" rx="12"/>
              </svg>
              <svg class="recycling-panel__image recycling-panel__image--desktop" viewBox="0 0 {{ vbw_d }} {{ vbh_d }}" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <g transform="translate(0 {{ bottle_dy }})">{% render 'recycling-bottle' %}</g>
                <rect class="recycling-art__box" x="184" y="{{ box_y_d }}" width="{{ bw }}" height="{{ bh }}" rx="12"/>
              </svg>
            {%- elsif image != blank -%}
              {{ image | image_url: width: 1200 | image_tag: class: 'recycling-panel__image', widths: '300, 500, 800, 1200', sizes: '(min-width: 700px) 30vw, 60vw', loading: 'lazy' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'recycling-panel__image' }}
            {%- endif -%}

            {%- for block in section.blocks -%}
              {%- capture anchor_style -%}{%- render 'recycling-anchor', block: block, built_in: built_in, anchors: anchors -%}{%- endcapture -%}
              <div
                class="recycling-label recycling-label--{{ block.settings.side }}"
                style="{{ anchor_style }}"
                {{ block.shopify_attributes }}
              >
                <span class="recycling-label__dot"></span>
                <span class="recycling-label__line"></span>
              </div>
            {%- endfor -%}
          </div>

          {%- for block in section.blocks -%}
            {%- capture anchor_style -%}{%- render 'recycling-anchor', block: block, built_in: built_in, anchors: anchors -%}{%- endcapture -%}
            {%- capture label_text -%}
              {%- if block.settings.title != blank -%}
                <strong class="recycling-label__title">{{ block.settings.title }}</strong>
              {%- endif -%}
              {{ block.settings.text }}
            {%- endcapture -%}
            <div
              class="recycling-label__text recycling-label__text--right{% if block.settings.side == 'left' %} recycling-label__text--of-left{% endif %}"
              style="{{ anchor_style }}"
            >
              {{ label_text }}
            </div>
            {%- if block.settings.side == 'left' -%}
              <div class="recycling-label__text recycling-label__text--left" style="{{ anchor_style }}">
                {{ label_text }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- if section.settings.tab_text != blank -%}
      <div class="recycling-panel__tab"><span class="recycling-panel__tab-text {{ section.settings.tab_size }}">{{ section.settings.tab_text }}</span></div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Recycling panel",
  "class": "shopify-section--recycling-panel",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 16
    },
    {
      "type": "select",
      "id": "block_size",
      "label": "t:sections.media_blocks.block_size",
      "options": [
        { "value": "auto", "label": "t:global.sizes.original_image_ratio" },
        { "value": "sm", "label": "t:global.sizes.small" },
        { "value": "md", "label": "t:global.sizes.medium" },
        { "value": "lg", "label": "t:global.sizes.large" },
        { "value": "fill", "label": "t:global.sizes.fit_screen" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "mobile_block_size",
      "label": "Mobile block size",
      "options": [
        { "value": "auto", "label": "t:global.sizes.original_image_ratio" },
        { "value": "sm", "label": "t:global.sizes.small" },
        { "value": "md", "label": "t:global.sizes.medium" },
        { "value": "lg", "label": "t:global.sizes.large" },
        { "value": "fill", "label": "t:global.sizes.fit_screen" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "less harm, more tint."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text",
      "default": "<p>Peptide Lip Tint packaging is made with post-consumer recycled (PCR) materials.</p>"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Illustration"
    },
    {
      "type": "select",
      "id": "illustration",
      "label": "Illustration type",
      "options": [
        { "value": "built_in", "label": "Built-in (bottle and box)" },
        { "value": "image", "label": "Uploaded SVG / image" }
      ],
      "info": "The built-in drawing has editable colors. On desktop the bottle and the box sit side by side, on phones the bottle is on top and the box below.",
      "default": "built_in"
    },
    {
      "type": "color",
      "id": "bottle_color",
      "label": "Bottle color",
      "default": "#e5be6c",
      "visible_if": "{{ section.settings.illustration == 'built_in' }}"
    },
    {
      "type": "color",
      "id": "cap_color",
      "label": "Cap color",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.illustration == 'built_in' }}"
    },
    {
      "type": "color",
      "id": "box_color",
      "label": "Box color",
      "default": "#e5be6c",
      "visible_if": "{{ section.settings.illustration == 'built_in' }}"
    },
    {
      "type": "range",
      "id": "box_scale",
      "min": 60,
      "max": 130,
      "step": 5,
      "unit": "%",
      "label": "Box size",
      "info": "Scales the box next to the bottle. At 100% the box is taller than the bottle with its cap, and narrower.",
      "default": 100,
      "visible_if": "{{ section.settings.illustration == 'built_in' }}"
    },
    {
      "type": "color",
      "id": "outline_color",
      "label": "Outline color",
      "default": "#8f5459",
      "visible_if": "{{ section.settings.illustration == 'built_in' }}"
    },
    {
      "type": "range",
      "id": "outline_width",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "label": "Outline width",
      "info": "0 removes the outline.",
      "default": 0,
      "visible_if": "{{ section.settings.illustration == 'built_in' }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Illustration (SVG or image)",
      "visible_if": "{{ section.settings.illustration == 'image' }}"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "%",
      "label": "Illustration width (desktop)",
