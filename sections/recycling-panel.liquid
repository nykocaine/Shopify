{%- liquid
  assign text_alignment_class = section.settings.text_alignment | replace: 'left', 'start' | replace: 'right', 'end'
  assign image = section.settings.image
  assign image_ratio = 1
  if image != blank
    assign image_ratio = image.aspect_ratio
  endif
-%}

<style>
  {%- comment -%}
  Scoped with #shopify-section-{{ section.id }} (plain <style>, not {% stylesheet %}, which is deduplicated per section TYPE
  and would leak the shared .container/.section-spacing selectors into every other section). The card gets the store's
  side gutter as padding on the outer wrapper, so the rounded card never touches the screen edge.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .container.section-spacing {
    margin-inline: 0;
    padding-inline: var(--container-gutter);
  }

  #shopify-section-{{ section.id }} {
    --recycling-dot: {{ section.settings.dot_color.rgb }};
    --recycling-line: {{ section.settings.line_color.rgb }};
    --recycling-tab-bg: {{ section.settings.tab_background.rgb }};
    --recycling-tab-text: {{ section.settings.tab_text_color.rgb }};
    --recycling-tab-weight: {{ section.settings.tab_font_weight }};
    --recycling-ratio: {{ image_ratio }};
    --recycling-image-width: {{ section.settings.mobile_image_width }}cqw;
    --recycling-image-offset: {{ section.settings.mobile_image_offset }}cqw;
    --recycling-max-height: {{ section.settings.mobile_image_max_height }}px;
    --recycling-room: 10rem;
  }

  {%- comment -%}
  Two independent boxes: __content (left / top, holds all the information) and __tab (right / bottom). __content carries the
  theme's normal inner padding (same value .content-box uses) on all four sides and clips whatever is inside it.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .recycling-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-radius: {{ section.settings.corner_radius }}px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .recycling-panel__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding: max(1.5rem, var(--container-gutter));
    min-width: 0;
    overflow: clip;
  }

  #shopify-section-{{ section.id }} .recycling-panel__text {
    align-self: end;
  }

  #shopify-section-{{ section.id }} .recycling-panel__text > * + * {
    margin-block-start: 1rem;
  }

  {%- comment -%}
  The stage is a size container: image width / offset are in cqw (1% of the stage width), so they are measured against the same
  box wherever they are used. Inside it, a 3-column grid [left room | illustration | right room]. The label texts are normal
  grid items of the side columns (not absolutely positioned), so they wrap inside their column and the stage grows to fit them:
  they can never cross the content box's padding. Each text is dropped down by the same fraction of the illustration height
  the dot sits at (--y), minus half a line so the line meets the middle of the title.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .recycling-panel__stage {
    container-type: inline-size;
    align-self: center;
    min-width: 0;
    padding-block-start: 1.25rem;
  }

  #shopify-section-{{ section.id }} .recycling-panel__grid {
    {%- comment -%}
    Whatever width / offset are set, the right column keeps at least --recycling-room for the label texts: the offset and the
    illustration width are clamped to what is left, so the texts always have room to wrap inside the card instead of being squeezed.
    {%- endcomment -%}
    --recycling-io: min(var(--recycling-image-offset), calc(100cqw - var(--recycling-room) - 3rem));
    --recycling-fw: max(3rem, min(var(--recycling-image-width), calc(var(--recycling-max-height) * var(--recycling-ratio)), calc(100cqw - var(--recycling-io) - var(--recycling-room))));
    --recycling-fh: calc(var(--recycling-fw) / var(--recycling-ratio));
    display: grid;
    grid-template-columns: var(--recycling-io) var(--recycling-fw) minmax(0, 1fr);
    align-items: start;
  }

  #shopify-section-{{ section.id }} .recycling-panel__figure {
    grid-area: 1 / 2;
    position: relative;
    aspect-ratio: var(--recycling-ratio);
  }

  #shopify-section-{{ section.id }} .recycling-panel__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .recycling-label__dot {
    position: absolute;
    top: var(--y-pct);
    left: var(--dot-x);
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: rgb(var(--recycling-dot));
    transform: translate(-50%, -50%);
  }

  #shopify-section-{{ section.id }} .recycling-label__line {
    position: absolute;
    top: var(--y-pct);
    left: var(--dot-x);
    width: calc(100% - var(--dot-x) + 2.25rem);
    height: 1px;
    background: rgb(var(--recycling-line));
  }

  #shopify-section-{{ section.id }} .recycling-label__text {
    grid-row: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    {%- comment -%}Inherits the body font size; the first line (the title) is centered on the line, the rest hangs below it.{%- endcomment -%}
    line-height: var(--text-line-height, 1.5);
    margin-block-start: calc(var(--recycling-fh) * var(--y) - 0.5lh);
  }

  #shopify-section-{{ section.id }} .recycling-label__text--right {
    grid-column: 3;
    margin-inline-start: 2.5rem;
  }

  {%- comment -%}Left-side texts exist only on desktop; on phones every label is shown in the right column.{%- endcomment -%}
  #shopify-section-{{ section.id }} .recycling-label__text--left {
    display: none;
  }

  #shopify-section-{{ section.id }} .recycling-label__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .recycling-label__title {
    display: block;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .recycling-panel__tab {
    display: flex;
    align-items: center;
    padding: 1.25rem max(1.5rem, var(--container-gutter));
    background: rgb(var(--recycling-tab-bg));
    color: rgb(var(--recycling-tab-text));
    font-family: var(--heading-font-family);
    font-weight: var(--recycling-tab-weight);
    font-size: 1.75rem;
    line-height: 1;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      --recycling-image-width: {{ section.settings.image_width }}cqw;
      --recycling-image-offset: {{ section.settings.image_offset }}cqw;
      --recycling-max-height: {{ section.settings.image_max_height }}px;
      --recycling-room: 12rem;
    }

    #shopify-section-{{ section.id }} .recycling-panel {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    #shopify-section-{{ section.id }} .recycling-panel__content {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 3rem;
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .recycling-panel__tab {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      justify-content: flex-start;
      padding: max(1.5rem, var(--container-gutter)) 1.25rem;
      font-size: 2.5rem;
    }

    #shopify-section-{{ section.id }} .recycling-label__text--right.recycling-label__text--of-left {
      display: none;
    }

    #shopify-section-{{ section.id }} .recycling-label__text--left {
      display: block;
      grid-column: 1;
      margin-inline-end: 2.5rem;
      text-align: end;
    }

    #shopify-section-{{ section.id }} .recycling-label--left .recycling-label__line {
      left: auto;
      right: calc(100% - var(--dot-x));
      width: calc(var(--dot-x) + 2.25rem);
    }
  }
</style>

<div class="container section-spacing">
  <div class="recycling-panel color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <div class="recycling-panel__content min-h-{{ section.settings.mobile_block_size }} md:min-h-{{ section.settings.block_size }}">
      <div class="recycling-panel__text prose text-{{ text_alignment_class }}">
        {%- if section.settings.title != blank -%}
          <{{ section.settings.heading_tag }} class="h2">{{ section.settings.title }}</{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.content != blank -%}
          <div class="rte">{{ section.settings.content }}</div>
        {%- endif -%}
      </div>

      <div class="recycling-panel__stage">
        <div class="recycling-panel__grid">
          <div class="recycling-panel__figure">
            {%- if image != blank -%}
              {{ image | image_url: width: 1200 | image_tag: class: 'recycling-panel__image', widths: '300, 500, 800, 1200', sizes: '(min-width: 700px) 30vw, 60vw', loading: 'lazy' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'recycling-panel__image' }}
            {%- endif -%}

            {%- for block in section.blocks -%}
              {%- assign y = block.settings.position_y | divided_by: 100.0 -%}
              <div
                class="recycling-label recycling-label--{{ block.settings.side }}"
                style="--y-pct: {{ block.settings.position_y }}%; --dot-x: {{ block.settings.dot_x }}%;"
                {{ block.shopify_attributes }}
              >
                <span class="recycling-label__dot"></span>
                <span class="recycling-label__line"></span>
              </div>
            {%- endfor -%}
          </div>

          {%- for block in section.blocks -%}
            {%- assign y = block.settings.position_y | divided_by: 100.0 -%}
            {%- capture label_text -%}
              {%- if block.settings.title != blank -%}
                <strong class="recycling-label__title">{{ block.settings.title }}</strong>
              {%- endif -%}
              {{ block.settings.text }}
            {%- endcapture -%}
            <div
              class="recycling-label__text recycling-label__text--right{% if block.settings.side == 'left' %} recycling-label__text--of-left{% endif %}"
              style="--y: {{ y }};"
            >
              {{ label_text }}
            </div>
            {%- if block.settings.side == 'left' -%}
              <div class="recycling-label__text recycling-label__text--left" style="--y: {{ y }};">
                {{ label_text }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- if section.settings.tab_text != blank -%}
      <div class="recycling-panel__tab">{{ section.settings.tab_text }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Recycling panel",
  "class": "shopify-section--recycling-panel",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 16
    },
    {
      "type": "select",
      "id": "block_size",
      "label": "t:sections.media_blocks.block_size",
      "options": [
        { "value": "auto", "label": "t:global.sizes.original_image_ratio" },
        { "value": "sm", "label": "t:global.sizes.small" },
        { "value": "md", "label": "t:global.sizes.medium" },
        { "value": "lg", "label": "t:global.sizes.large" },
        { "value": "fill", "label": "t:global.sizes.fit_screen" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "mobile_block_size",
      "label": "Mobile block size",
      "options": [
        { "value": "auto", "label": "t:global.sizes.original_image_ratio" },
        { "value": "sm", "label": "t:global.sizes.small" },
        { "value": "md", "label": "t:global.sizes.medium" },
        { "value": "lg", "label": "t:global.sizes.large" },
        { "value": "fill", "label": "t:global.sizes.fit_screen" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "less harm, more tint."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text",
      "default": "<p>Peptide Lip Tint packaging is made with post-consumer recycled (PCR) materials.</p>"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Illustration"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Illustration (SVG or image)"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "%",
      "label": "Illustration width (desktop)",
      "info": "Share of the illustration area. What is left on each side is the room for the labels.",
      "default": 12
    },
    {
      "type": "range",
      "id": "image_offset",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "%",
      "label": "Space to the left (desktop)",
      "info": "Room for left-side labels. The remainder on the right is for right-side labels.",
      "default": 40
    },
    {
      "type": "range",
      "id": "image_max_height",
      "min": 150,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Maximum illustration height (desktop)",
      "info": "The illustration never gets taller than this, whatever image is uploaded.",
      "default": 480
    },
    {
      "type": "range",
      "id": "mobile_image_width",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "%",
      "label": "Illustration width (mobile)",
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_image_offset",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "%",
      "label": "Space to the left (mobile)",
      "info": "On phones every label goes to the right of the illustration, in the room left after width and left space.",
      "default": 8
    },
    {
      "type": "range",
      "id": "mobile_image_max_height",
      "min": 150,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Maximum illustration height (mobile)",
      "default": 400
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#7d7c78"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#7d7c78"
    },
    {
      "type": "header",
      "content": "Vertical tab"
    },
    {
      "type": "text",
      "id": "tab_text",
      "label": "Text",
      "default": "how to recycle"
    },
    {
      "type": "color",
      "id": "tab_background",
      "label": "Background color",
      "default": "#7d7c78"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "tab_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "800", "label": "Extra bold (800)" },
        { "value": "900", "label": "Black (900)" }
      ],
      "default": "700"
    }
  ],
  "blocks": [
    {
      "type": "label",
      "name": "Label",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cap"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>30% PCR PP #5</p>"
        },
        {
          "type": "select",
          "id": "side",
          "label": "Side (desktop)",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "right"
        },
        {
          "type": "range",
          "id": "position_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "info": "Height of the dot over the illustration, from top (0) to bottom (100).",
          "default": 20
        },
        {
          "type": "range",
          "id": "dot_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Dot horizontal position",
          "info": "Position of the dot across the illustration, from left (0) to right (100).",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recycling panel",
      "blocks": [
        { "type": "label" },
        {
          "type": "label",
          "settings": {
            "title": "Tube",
            "text": "<p>30% PCR HDPE #2 and 70% LDPE #4</p>",
            "position_y": 70
          }
        }
      ]
    }
  ]
}
{% endschema %}
