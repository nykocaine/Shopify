{%- liquid
  assign text_alignment = section.settings.text_alignment | default: 'center'
  assign text_alignment_class = text_alignment | replace: 'left', 'start' | replace: 'right', 'end'

  # Las preguntas (cards/compact/tono/formato/seguridad) son bloques: el total de pasos
  # y su orden salen de section.blocks, no de un número fijo. Esto permite agregar, quitar
  # o reordenar preguntas desde el editor sin tocar este archivo.
  assign flow_block_types = 'question_cards,question_compact,question_tone,question_format,screening_question' | split: ','
  assign total_steps = 0
  for block in section.blocks
    if flow_block_types contains block.type
      assign total_steps = total_steps | plus: 1
    endif
  endfor

  assign result_blocks = section.blocks | where: 'type', 'result'
  assign routine_blocks = section.blocks | where: 'type', 'routine_step'

  assign require_email_to_start = section.settings.require_email_to_start
  assign newsletter_form_id = 'the-method-newsletter-' | append: section.id
-%}

<style>
  {%- comment -%}
  Same mechanism as sections/faq.liquid's .faq__container / .faq-content-box pair: the outer
  container's own side margin and section-to-section padding (.container/.section-spacing, theme-wide
  classes) are zeroed out and replaced with a single gutter-driven padding here, always on - not just
  when floating_the_method is on, since the two inner cards below (content + image) now rely on it
  unconditionally. Scoped with #shopify-section-{{ section.id }} (a plain <style> tag, not
  {% stylesheet %} - the latter is deduplicated per section TYPE, not scoped per instance, so bare
  .container/.section-spacing selectors there would leak into every other section using those same
  theme-wide classes, like a plain rich-text section).
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .container.section-spacing {
    margin-inline: 0;
    padding: calc(var(--container-gutter) + 0.5rem);
  }
</style>

{%- comment -%}
  Todo el widget vive dentro de un único {% form 'customer' %} cuando se pide correo para
  empezar: así el botón "Comenzar" puede ser el submit real de una suscripción de newsletter
  (misma mecánica que snippets/newsletter-form.liquid), y form.posted_successfully? decide,
  ya en el primer render tras la recarga, que el panel inicial visible sea el paso 1 en vez
  de la intro. Los demás controles (opciones, atrás, reiniciar) ya declaran type="button"
  explícito, así que no hay riesgo de que disparen un submit por accidente.
{%- endcomment -%}
{%- form 'customer', id: newsletter_form_id -%}
  {%- comment -%}Always sent: the same form also carries the e-mail asked at the end of the test (see the result panel){%- endcomment -%}
  <input type="hidden" name="contact[tags]" value="newsletter">

  {%- assign just_subscribed = false -%}
  {%- if require_email_to_start and form.posted_successfully? -%}
    {%- assign just_subscribed = true -%}
  {%- endif -%}

  <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_the_method %} section-floating section-floating--block-end{% endif %}"{% if section.settings.floating_the_method %} style="border-end-start-radius: {{ section.settings.the_method_border_radius }}px; border-end-end-radius: {{ section.settings.the_method_border_radius }}px; overflow: hidden;"{% endif %}>
  <div class="container section-spacing">
    {%- comment -%}
      Dos tarjetas lado a lado (contenido + imagen), cada una con su propio radio — mismo patrón que
      .faq-content-box en sections/faq.liquid. Al comenzar el test (data-the-method-layout gana
      --quiz-active, en JS o ya en el primer render si el correo obligatorio hizo recargar la página
      directo al paso 1) la grilla colapsa a una sola columna y la imagen se oculta.
    {%- endcomment -%}
    <div class="the-method-layout{% if section.settings.image != blank %} the-method-layout--has-image{% endif %}{% if just_subscribed %} the-method-layout--quiz-active{% endif %}" data-the-method-layout>
      <div class="the-method-layout__content color-scheme color-scheme--{{ section.settings.content_card_color_scheme.id }}" style="border-radius: {{ section.settings.the_method_border_radius }}px;">
      <div class="the-method" data-the-method data-section-id="{{ section.id }}" data-require-email="{{ require_email_to_start }}">

      <div class="the-method__meta">
        <button type="button" class="circle-button the-method__back" data-the-method-back {% unless just_subscribed %}hidden{% endunless %}>
          <span class="sr-only">{{ section.settings.back_button_text }}</span>
          {%- render 'icon' with 'back-arrow', direction_aware: true -%}
        </button>

        <div class="the-method__progress" data-the-method-progress {% unless just_subscribed %}hidden{% endunless %} aria-hidden="true">
          <p class="the-method__progress-text">
            <span data-the-method-progress-current>01</span> / <span data-the-method-progress-total>0{{ total_steps }}</span>
          </p>
          <span class="the-method__progress-track">
            <span class="the-method__progress-fill" data-the-method-progress-fill {% if just_subscribed and total_steps > 0 %}style="width: {{ 1.0 | times: 100 | divided_by: total_steps }}%;"{% endif %}></span>
          </span>
        </div>

        <button type="button" class="circle-button the-method__restart" data-the-method-restart {% unless just_subscribed %}hidden{% endunless %}>
          <span class="sr-only">{{ section.settings.restart_button_text }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12a7 7 0 1 0 2.1-5"/>
            <path d="M4.5 4.5v3h3"/>
          </svg>
        </button>
      </div>

      {%- comment -%}
        Banner de advertencia del test de seguridad: vive fuera de .the-method__panels para
        mantenerse visible a través de los cambios de panel una vez que se activa (ver
        screening_question más abajo). No bloquea el avance del test, solo informa.
      {%- endcomment -%}
      <p class="the-method__warning color-scheme color-scheme--{{ section.settings.warning_color_scheme.id }}" data-the-method-warning hidden role="status"></p>

      <div class="the-method__panels" data-the-method-panels>

        <div class="the-method__panel the-method__panel--intro justify-items-{{ text_alignment_class }}" style="text-align: {{ text_alignment }};" data-the-method-panel="intro" tabindex="-1" {% if just_subscribed %}hidden{% endif %}>
          {%- if section.settings.heading != blank or section.settings.show_icon -%}
            {%- capture method_title -%}
              {%- if section.settings.heading != blank -%}
                {%- render 'heading', content: section.settings.heading, style: section.settings.heading_size, html_tag: 'h2', balance_text: true, instant: true -%}
              {%- endif -%}
            {%- endcapture -%}

            {%- render 'heading-with-icon',
              title_content: method_title,
              show_icon: section.settings.show_icon,
              plain: true,
              icon_position: section.settings.icon_position,
              icon_alignment: section.settings.icon_alignment,
              icon_type: section.settings.icon_type,
              icon_size: section.settings.icon_size,
              icon_spin: section.settings.icon_spin,
              icon_primary_color: section.settings.icon_primary_color,
              icon_secondary_color: section.settings.icon_secondary_color,
              icon_border_color: section.settings.icon_border_color
            -%}
          {%- endif -%}

          {%- if section.settings.tagline != blank -%}
            <p class="the-method__tagline">{{ section.settings.tagline }}</p>
          {%- endif -%}

          {%- if require_email_to_start -%}
            {%- if form.errors -%}
              {%- capture email_error_message -%}{{ form.errors.translated_fields['email'] }} {{ form.errors.messages['email'] }}{%- endcapture -%}
              {%- render 'banner', content: email_error_message, status: 'error', text_alignment: 'center' -%}
            {%- endif -%}

            <div class="the-method__email-field">
              {%- render 'input', name: 'contact[email]', label: section.settings.email_input_label, type: 'email', required: true, autocomplete: 'email', enterkeyhint: 'send' -%}
            </div>
          {%- endif -%}

          {%- if section.settings.start_button_text != blank -%}
            {%- comment -%}
              --button-scheme-border-color is read by .button (theme.css) with a transparent
              fallback - solid buttons are borderless by default theme-wide. Setting it only
              when a color is actually picked keeps that default when left blank.
            {%- endcomment -%}
            {%- capture cta_style -%}
              {%- if section.settings.start_button_border_color != blank -%}
                --button-scheme-border-color: {{ section.settings.start_button_border_color.rgb }};
              {%- endif -%}
            {%- endcapture -%}
            {%- if require_email_to_start -%}
              <button type="submit" class="button the-method__cta" {% if cta_style != blank %}style="{{ cta_style | strip }}"{% endif %}>
                <button-content class="button__content">{{ section.settings.start_button_text }}</button-content>
              </button>
            {%- else -%}
              <button type="button" class="button the-method__cta" data-the-method-start {% if cta_style != blank %}style="{{ cta_style | strip }}"{% endif %}>
                <button-content class="button__content">{{ section.settings.start_button_text }}</button-content>
              </button>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- assign step_index = 0 -%}
        {%- for block in section.blocks -%}

          {%- case block.type -%}

            {%- comment -%} Pregunta con tarjetas + ícono (ej. "¿qué quieres mejorar?") {%- endcomment -%}
            {%- when 'question_cards' -%}
              {%- assign step_index = step_index | plus: 1 -%}
              <div class="the-method__panel the-method__panel--question justify-items-{{ text_alignment_class }}" {% if block.settings.allow_multiple %}data-multiple="true"{% endif %} style="text-align: {{ text_alignment }};" data-the-method-panel="step-{{ step_index }}" tabindex="-1" role="group" aria-labelledby="the-method-q-{{ section.id }}-{{ step_index }}" {% unless step_index == 1 and just_subscribed %}hidden{% endunless %} {{ block.shopify_attributes }}>
                <h3 id="the-method-q-{{ section.id }}-{{ step_index }}" class="the-method__question">{{ block.settings.question }}</h3>

                <div class="the-method__options the-method__options--cards" role="radiogroup" aria-labelledby="the-method-q-{{ section.id }}-{{ step_index }}">
                  {%- for i in (1..5) -%}
                    {%- liquid
                      assign label_key = 'option_' | append: i | append: '_label'
                      assign icon_key = 'option_' | append: i | append: '_icon'
                      assign wsal_key = 'option_' | append: i | append: '_weight_salicylic'
                      assign wtca_key = 'option_' | append: i | append: '_weight_tca'
                      assign opt_label = block.settings[label_key]
                      assign desc_key = 'option_' | append: i | append: '_description'
                      assign opt_desc = block.settings[desc_key]
                      assign opt_icon = block.settings[icon_key]
                      assign opt_weight_salicylic = block.settings[wsal_key]
                      assign opt_weight_tca = block.settings[wtca_key]
                    -%}
                    {%- if opt_label != blank -%}
                      <button type="button" class="the-method__option color-scheme color-scheme--{{ section.settings.options_color_scheme.id }}" role="radio" aria-checked="false" data-the-method-option data-step="{{ step_index }}" data-key="{{ block.id }}-{{ i }}" data-weight-salicylic="{{ opt_weight_salicylic }}" data-weight-tca="{{ opt_weight_tca }}">
                        <span class="the-method__option-main">
                          {%- unless opt_icon == 'none' -%}
                            <span class="the-method__option-icon">
                              {%- render 'the-method-icon', icon: opt_icon -%}
                            </span>
                          {%- endunless -%}
                          <span class="the-method__option-text">
                            <span class="the-method__option-label">{{ opt_label }}</span>
                            {%- if opt_desc != blank -%}
                              <span class="the-method__option-description">{{ opt_desc }}</span>
                            {%- endif -%}
                          </span>
                        </span>
                        <span class="the-method__option-check">{%- render 'icon' with 'success-checkmark', width: 16 -%}</span>
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                {%- if block.settings.allow_multiple -%}
                  <div class="the-method__continue" data-the-method-continue>
                    {%- render 'button', type: 'button', content: section.settings.continue_button_text, style: 'solid' -%}
                  </div>
                {%- endif -%}
              </div>

            {%- comment -%} Pregunta en lista compacta, sin íconos (ej. tipo de piel, sensibilidad) {%- endcomment -%}
            {%- when 'question_compact' -%}
              {%- assign step_index = step_index | plus: 1 -%}
              <div class="the-method__panel the-method__panel--question justify-items-{{ text_alignment_class }}" style="text-align: {{ text_alignment }};" data-the-method-panel="step-{{ step_index }}" tabindex="-1" role="group" aria-labelledby="the-method-q-{{ section.id }}-{{ step_index }}" {% unless step_index == 1 and just_subscribed %}hidden{% endunless %} {{ block.shopify_attributes }}>
                <h3 id="the-method-q-{{ section.id }}-{{ step_index }}" class="the-method__question">{{ block.settings.question }}</h3>

                <div class="the-method__options the-method__options--compact" role="radiogroup" aria-labelledby="the-method-q-{{ section.id }}-{{ step_index }}">
                  {%- for i in (1..5) -%}
                    {%- liquid
                      assign label_key = 'option_' | append: i | append: '_label'
                      assign wsal_key = 'option_' | append: i | append: '_weight_salicylic'
                      assign wtca_key = 'option_' | append: i | append: '_weight_tca'
                      assign note_key = 'option_' | append: i | append: '_note'
                      assign opt_label = block.settings[label_key]
                      assign desc_key = 'option_' | append: i | append: '_description'
                      assign opt_desc = block.settings[desc_key]
                      assign opt_weight_salicylic = block.settings[wsal_key]
                      assign opt_weight_tca = block.settings[wtca_key]
                      assign opt_note = block.settings[note_key]
                    -%}
                    {%- if opt_label != blank -%}
                      <button type="button" class="the-method__option color-scheme color-scheme--{{ section.settings.options_color_scheme.id }}" role="radio" aria-checked="false" data-the-method-option data-step="{{ step_index }}" data-key="{{ block.id }}-{{ i }}" data-weight-salicylic="{{ opt_weight_salicylic }}" data-weight-tca="{{ opt_weight_tca }}" data-note="{{ opt_note | escape }}">
                        <span class="the-method__option-text">
                            <span class="the-method__option-label">{{ opt_label }}</span>
                            {%- if opt_desc != blank -%}
                              <span class="the-method__option-description">{{ opt_desc }}</span>
                            {%- endif -%}
                          </span>
                        <span class="the-method__option-check">{%- render 'icon' with 'success-checkmark', width: 14 -%}</span>
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>

            {%- comment -%} Pregunta de escala visual (tono de piel): sin pesos, solo selección {%- endcomment -%}
            {%- when 'question_tone' -%}
              {%- assign step_index = step_index | plus: 1 -%}
              <div class="the-method__panel the-method__panel--question justify-items-{{ text_alignment_class }}" style="text-align: {{ text_alignment }};" data-the-method-panel="step-{{ step_index }}" tabindex="-1" role="group" aria-labelledby="the-method-q-{{ section.id }}-{{ step_index }}" {% unless step_index == 1 and just_subscribed %}hidden{% endunless %} {{ block.shopify_attributes }}>
                <h3 id="the-method-q-{{ section.id }}-{{ step_index }}" class="the-method__question">{{ block.settings.question }}</h3>

                {%- liquid
                  assign tone_colors = ''
                  for i in (1..6)
                    assign color_key = 'swatch_' | append: i | append: '_color'
                    assign tone_colors = tone_colors | append: block.settings[color_key]
                    unless forloop.last
                      assign tone_colors = tone_colors | append: ','
                    endunless
                  endfor
                  assign tone_start_color = block.settings.swatch_3_color
                -%}
                <div class="the-method__tone-slider" style="--tone-gradient: linear-gradient(to right, {{ tone_colors }}); --tone-color: {{ tone_start_color }};" data-tone-colors="{{ tone_colors }}">
                  <input type="range" min="1" max="6" step="1" value="3" class="the-method__tone-range" data-the-method-tone data-step="{{ step_index }}" data-key-prefix="{{ block.id }}" aria-label="{{ block.settings.question | escape }}">
                  <div class="the-method__tone-labels" aria-hidden="true">
                    <span>{{ section.settings.tone_light_label }}</span>
                    <span>{{ section.settings.tone_dark_label }}</span>
                  </div>
                </div>

                <div class="the-method__continue" data-the-method-continue>
                  {%- render 'button', type: 'button', content: section.settings.continue_button_text, style: 'solid' -%}
                </div>
              </div>

            {%- comment -%} Pregunta de formato: cada opción puede fijar directamente single/duo/combo {%- endcomment -%}
            {%- when 'question_format' -%}
              {%- assign step_index = step_index | plus: 1 -%}
              <div class="the-method__panel the-method__panel--question justify-items-{{ text_alignment_class }}" style="text-align: {{ text_alignment }};" data-the-method-panel="step-{{ step_index }}" tabindex="-1" role="group" aria-labelledby="the-method-q-{{ section.id }}-{{ step_index }}" {% unless step_index == 1 and just_subscribed %}hidden{% endunless %} {{ block.shopify_attributes }}>
                <h3 id="the-method-q-{{ section.id }}-{{ step_index }}" class="the-method__question">{{ block.settings.question }}</h3>

                <div class="the-method__options the-method__options--editorial" role="radiogroup" aria-labelledby="the-method-q-{{ section.id }}-{{ step_index }}">
                  {%- for i in (1..4) -%}
                    {%- liquid
                      assign label_key = 'option_' | append: i | append: '_label'
                      assign icon_key = 'option_' | append: i | append: '_icon'
                      assign format_key = 'option_' | append: i | append: '_format'
                      assign opt_label = block.settings[label_key]
                      assign desc_key = 'option_' | append: i | append: '_description'
                      assign opt_desc = block.settings[desc_key]
                      assign opt_icon = block.settings[icon_key]
                      assign opt_format = block.settings[format_key]
                    -%}
                    {%- if opt_label != blank -%}
                      <button type="button" class="the-method__option color-scheme color-scheme--{{ section.settings.options_color_scheme.id }}" role="radio" aria-checked="false" data-the-method-option data-step="{{ step_index }}" data-key="{{ block.id }}-{{ i }}" data-format="{{ opt_format }}">
                        <span class="the-method__option-main">
                          {%- unless opt_icon == 'none' -%}
                            <span class="the-method__option-icon">
                              {%- render 'the-method-icon', icon: opt_icon -%}
                            </span>
                          {%- endunless -%}
                          <span class="the-method__option-text">
                            <span class="the-method__option-label">{{ opt_label }}</span>
                            {%- if opt_desc != blank -%}
                              <span class="the-method__option-description">{{ opt_desc }}</span>
                            {%- endif -%}
                          </span>
                        </span>
                        <span class="the-method__option-check">{%- render 'icon' with 'success-checkmark', width: 18 -%}</span>
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>

            {%- comment -%}
              Pregunta de seguridad (contraindicaciones): no bloquea el avance. Si la opción elegida
              está marcada como "warns", se muestra el banner de advertencia definido arriba, con la
              nota propia de esa opción, pero el test sigue su curso con normalidad.
            {%- endcomment -%}
            {%- when 'screening_question' -%}
              {%- assign step_index = step_index | plus: 1 -%}
              <div class="the-method__panel the-method__panel--question justify-items-{{ text_alignment_class }}" style="text-align: {{ text_alignment }};" data-the-method-panel="step-{{ step_index }}" tabindex="-1" role="group" aria-labelledby="the-method-q-{{ section.id }}-{{ step_index }}" {% unless step_index == 1 and just_subscribed %}hidden{% endunless %} {{ block.shopify_attributes }}>
                <h3 id="the-method-q-{{ section.id }}-{{ step_index }}" class="the-method__question">{{ block.settings.question }}</h3>

                {%- if block.settings.disclaimer != blank -%}
                  <p class="the-method__screening-note">{{ block.settings.disclaimer }}</p>
                {%- endif -%}

                <div class="the-method__options the-method__options--compact" role="radiogroup" aria-labelledby="the-method-q-{{ section.id }}-{{ step_index }}">
                  {%- for i in (1..5) -%}
                    {%- liquid
                      assign label_key = 'option_' | append: i | append: '_label'
                      assign warns_key = 'option_' | append: i | append: '_warns'
                      assign note_key = 'option_' | append: i | append: '_note'
                      assign opt_label = block.settings[label_key]
                      assign desc_key = 'option_' | append: i | append: '_description'
                      assign opt_desc = block.settings[desc_key]
                      assign opt_warns = block.settings[warns_key]
                      assign opt_note = block.settings[note_key]
                    -%}
                    {%- if opt_label != blank -%}
                      <button type="button" class="the-method__option color-scheme color-scheme--{{ section.settings.options_color_scheme.id }}" role="radio" aria-checked="false" data-the-method-option data-step="{{ step_index }}" data-key="{{ block.id }}-{{ i }}" data-warn="{{ opt_warns }}" data-warn-note="{{ opt_note | escape }}">
                        <span class="the-method__option-text">
                            <span class="the-method__option-label">{{ opt_label }}</span>
                            {%- if opt_desc != blank -%}
                              <span class="the-method__option-description">{{ opt_desc }}</span>
                            {%- endif -%}
                          </span>
                        <span class="the-method__option-check">{%- render 'icon' with 'success-checkmark', width: 14 -%}</span>
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>

          {%- endcase -%}
        {%- endfor -%}

        <div class="the-method__panel the-method__panel--analyzing" data-the-method-panel="analyzing" tabindex="-1" role="status" aria-live="polite" hidden>
          <p class="the-method__analyzing-text">{{ section.settings.analyzing_text }}</p>
          <span class="the-method__analyzing-line" aria-hidden="true"></span>
        </div>

        <div class="the-method__panel the-method__panel--result" data-the-method-panel="result" tabindex="-1" aria-live="polite" aria-atomic="true" hidden>
          {%- if section.settings.result_eyebrow != blank -%}
            {%- render 'subheading', content: section.settings.result_eyebrow -%}
          {%- endif -%}

          {%- comment -%}Answers given, as small tags: tapping one goes back to that question to change it, then straight back to the result{%- endcomment -%}
          <div class="the-method__summary" data-the-method-summary aria-label="{{ section.settings.summary_label | escape }}"></div>

          {%- for block in result_blocks -%}
            {%- liquid
              assign result_product = block.settings.product
              assign result_secondary_product = block.settings.secondary_product
              assign result_rationale = block.settings.rationale
            -%}

            <div class="the-method__result-card" data-the-method-result="{{ block.id }}" data-match-method="{{ block.settings.match_method }}" data-match-format="{{ block.settings.match_format }}" hidden {{ block.shopify_attributes }}>
              {%- if result_product != blank -%}
                <div class="the-method__result-media">
                  {%- if result_product.featured_media != blank -%}
                    {%- render 'media', media: result_product.featured_media, sizes: '(max-width: 699px) 100vw, 480px' -%}
                  {%- endif -%}
                </div>

                <div class="the-method__result-info">
                  {%- render 'heading', content: result_product.title, style: 'h3', html_tag: 'h3', instant: true -%}

                  {%- if result_rationale != blank -%}
                    <p class="the-method__rationale">{{ result_rationale }}</p>
                  {%- endif -%}

                  <p class="the-method__context-note" data-the-method-context-note aria-live="off"></p>

                  {%- render 'price-list', product: result_product, context: 'product' -%}

                  {%- if section.settings.result_cta_text != blank -%}
                    {%- render 'button', content: section.settings.result_cta_text, href: result_product.url, style: 'solid' -%}
                  {%- endif -%}

                  {%- if section.settings.show_secondary_recommendation and result_secondary_product != blank -%}
                    <div class="the-method__secondary">
                      {%- if section.settings.secondary_recommendation_heading != blank -%}
                        <p class="subheading">{{ section.settings.secondary_recommendation_heading }}</p>
                      {%- endif -%}

                      <div class="the-method__secondary-card">
                        <div class="the-method__secondary-media">
                          {%- if result_secondary_product.featured_media != blank -%}
                            {%- render 'media', media: result_secondary_product.featured_media, sizes: '96px' -%}
                          {%- endif -%}
                        </div>

                        <div class="the-method__secondary-info">
                          {%- render 'heading', content: result_secondary_product.title, style: 'h6', html_tag: 'p', instant: true -%}
                          {%- render 'price-list', product: result_secondary_product, context: 'card' -%}
                          {%- render 'button', content: 'product.general.view_details' | t, href: result_secondary_product.url, style: 'link' -%}
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}

          <div class="the-method__result-extras" data-the-method-extras data-routine-label="{{ section.settings.routine_heading | escape }}" hidden>
            {%- if section.settings.whatsapp_number != blank -%}
              <div class="the-method__whatsapp" data-the-method-whatsapp data-number="{{ section.settings.whatsapp_number | strip }}" data-message="{{ section.settings.whatsapp_message | escape }}" data-answers-label="{{ section.settings.whatsapp_answers_label | escape }}" data-result-label="{{ section.settings.whatsapp_result_label | escape }}">
                {%- render 'button', content: section.settings.whatsapp_button_text, href: '#', style: 'outline', external: true -%}
              </div>
            {%- endif -%}

            {%- if section.settings.show_result_email -%}
              <div class="the-method__email-capture" data-the-method-email data-success-text="{{ section.settings.result_email_success | escape }}" data-error-text="{{ section.settings.result_email_error | escape }}" data-subject="{{ section.settings.result_email_subject | escape }}" data-routine-label="{{ section.settings.routine_heading | escape }}" data-answers-label="{{ section.settings.whatsapp_answers_label | escape }}" data-result-label="{{ section.settings.whatsapp_result_label | escape }}">
                <label for="the-method-result-email-{{ section.id }}" class="the-method__email-capture-label">{{ section.settings.result_email_heading }}</label>
                <div class="the-method__email-capture-row">
                  <div class="the-method__email-field-end">
                    <input id="the-method-result-email-{{ section.id }}" type="email" class="input" placeholder="{{ section.settings.result_email_placeholder | escape }}" autocomplete="email" enterkeyhint="send" data-the-method-email-input>
                  </div>
                  <div data-the-method-email-submit>
                    {%- render 'button', type: 'button', content: section.settings.result_email_button, style: 'solid' -%}
                  </div>
                </div>
                <p class="the-method__email-capture-status" data-the-method-email-status role="status" hidden></p>
                <a class="the-method__email-mailto" data-the-method-email-mailto href="#" hidden>{{ section.settings.result_email_mailto_text }}</a>
              </div>
            {%- endif -%}
          </div>

          {%- if routine_blocks.size > 0 -%}
            <div class="the-method__routine" data-the-method-routine hidden>
              {%- if section.settings.routine_heading != blank -%}
                <p class="subheading">{{ section.settings.routine_heading }}</p>
              {%- endif -%}

              <ol class="the-method__routine-list">
                {%- for block in routine_blocks -%}
                  <li class="the-method__routine-step" {{ block.shopify_attributes }}>
                    {%- unless block.settings.icon == 'none' -%}
                      <span class="the-method__routine-step-icon">{%- render 'the-method-icon', icon: block.settings.icon -%}</span>
                    {%- endunless -%}
                    <span class="the-method__routine-step-body">
                      {%- if block.settings.title != blank -%}
                        <span class="the-method__routine-step-title">{{ block.settings.title }}</span>
                      {%- endif -%}
                      {%- if block.settings.description != blank -%}
                        <span class="the-method__routine-step-description">{{ block.settings.description }}</span>
                      {%- endif -%}
                      {%- if block.settings.product != blank -%}
                        {%- render 'button', content: block.settings.product.title, href: block.settings.product.url, style: 'link' -%}
                      {%- endif -%}
                    </span>
                  </li>
                {%- endfor -%}
              </ol>
            </div>
          {%- endif -%}
        </div>

      </div>
      </div>
      </div>

      {%- if section.settings.image != blank -%}
        <div class="the-method-layout__media the-method-layout__media--{{ section.settings.image_height }}" style="border-radius: {{ section.settings.the_method_border_radius }}px;">
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 100vw, 50vw', widths: '375, 550, 750, 1100, 1500' }}
        </div>
      {%- endif -%}
    </div>
  </div>
  </div>
{%- endform -%}

{% stylesheet %}
  /* All the text of the test (intro, questions, options, descriptions, progress, warning, notes, result, routine, buttons) uses the Body Text
     typography - family, size, weight, style, spacing, no capitals - and nothing is bold unless it is asked for here. Sizes come later,
     from this one rule. */
  .the-method-layout__content * {
    font-family: var(--text-font-family) !important;
    font-size: var(--text-base) !important;
    font-weight: var(--text-font-weight) !important;
    font-style: var(--text-font-style) !important;
    letter-spacing: var(--text-letter-spacing) !important;
    line-height: var(--text-line-height) !important;
    text-transform: none !important;
  }

  .the-method-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--container-gutter, 1.5rem) + 0.5rem);
  }

  /* Con imagen y el test todavía sin empezar: dos columnas iguales en desktop. Mobile siempre
     se apila. En cuanto el test arranca (--quiz-active, agregado por JS o ya en el primer
     render si el correo obligatorio hizo recargar la página directo al paso 1), la grilla
     vuelve a una sola columna y la imagen se oculta - solo se ve en la intro. */
  @media screen and (min-width: 750px) {
    .the-method-layout--has-image:not(.the-method-layout--quiz-active) {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }

  .the-method-layout--quiz-active .the-method-layout__media {
    display: none;
  }

  .the-method-layout__content {
    padding: calc(var(--container-gutter) + 0.5rem);
  }

  .the-method-layout__media {
    overflow: hidden;
    min-height: 20rem;
  }

  .the-method-layout__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* "Adaptable" (sin clase de alto fijo) estira la imagen a la altura del contenido vía
     align-items: stretch del grid. Los demás tamaños fuerzan una altura fija, igual en
     mobile y desktop para mantenerlo simple. */
  .the-method-layout__media--small {
    height: 20rem;
  }

  .the-method-layout__media--medium {
    height: 28rem;
  }

  .the-method-layout__media--large {
    height: 36rem;
  }

  .the-method {
    --the-method-gap: var(--container-gutter, 1.5rem);
    display: grid;
    gap: calc(var(--the-method-gap) * 1.5);
  }

  .the-method__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 1.5rem;
  }

  /* Back/restart reuse the theme's own circular step-control button (.circle-button) as-is —
     size, colors, hover and disabled states all come from that shared system, not from THE METHOD. */
  .the-method__back[hidden],
  .the-method__restart[hidden] {
    display: none;
  }

  /* Minimal controls: no round background behind back / restart, only the icon (same thin line as the header icons), a little more
     transparent until hovered. The restart glyph is an open arc with a small arrowhead, not a closed ball. */
  .the-method__meta .circle-button:before {
    display: none;
  }

  .the-method__meta .circle-button {
    opacity: 0.7;
  }

  @media (pointer: fine) {
    .the-method__meta .circle-button:hover {
      opacity: 1;
    }
  }

  .the-method__restart svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .the-method__restart svg path {
    stroke-width: var(--header-icon-line-width, 1.1px);
    vector-effect: non-scaling-stroke;
  }

  .the-method__progress {
    display: grid;
    gap: 0.35rem;
    justify-items: center;
  }

  .the-method__progress[hidden] {
    display: none;
  }

  .the-method__progress-text {
    margin: 0;
    color: rgb(var(--text-color) / 0.6);
  }

  .the-method__progress-track {
    display: block;
    width: 6rem;
    height: 2px;
    border-radius: 2px;
    background: rgb(var(--text-color) / 0.12);
    overflow: hidden;
  }

  .the-method__progress-fill {
    display: block;
    height: 100%;
    width: 0%;
    background: rgb(var(--text-color) / 0.6);
    transition: width 0.25s ease-in-out;
  }

  .the-method__warning {
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: var(--input-border-radius);
    background: rgb(var(--background));
    overflow: hidden;
    color: rgb(var(--text-color));
  }

  .the-method__warning[hidden] {
    display: none;
  }

  .the-method__screening-note {
    margin: 0;
    color: rgb(var(--text-color) / 0.6);
  }

  .the-method__panels {
    position: relative;
  }

  .the-method__panel {
    display: grid;
    gap: var(--the-method-gap);
    max-width: 40rem;
  }

  .the-method__panel[hidden] {
    display: none;
  }

  .the-method__panel:focus {
    outline: none;
  }

  /* The questions use the whole width of the section (the 40rem cap is for the intro text) and are aligned to the start, so the question
     and its options share the same left edge; the intro keeps the alignment chosen in the section settings. */
  .the-method__panel--question {
    max-width: none;
    justify-items: stretch;
    text-align: start !important;
  }

  .the-method__panel--result {
    max-width: 64rem;
    gap: calc(var(--the-method-gap) * 1.5);
  }

  .the-method__tagline {
    margin: 0;
    color: rgb(var(--text-color) / 0.7);
  }

  .the-method__cta {
    min-width: 12rem;
  }

  .the-method__email-field {
    width: 100%;
    max-width: 22rem;
  }

  .the-method__question {
    margin: 0;
  }

  /* Options: a single vertical stack on phones and tablets; from 1000px always two columns, like the FAQ questions, read from
     left to right (1st on the left, 2nd on the right...; with an odd number the extra one ends up alone at the bottom left). Every
     kind of question (cards, compact list, editorial cards) splits in two. */
  .the-method__options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  @media screen and (min-width: 1000px) {
    .the-method__options {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
      column-gap: 0.75rem;
    }
  }

  /* Scoped under .the-method__options (not just .the-method__option alone) so background/border
     reliably beat the theme's own global button reset (assets/theme.css:80-85, which targets
     [type="button"] and sets background-color: transparent at the same specificity) without
     needing !important. */
  .the-method__options .the-method__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    appearance: none;
    text-align: start;
    cursor: pointer;
    background: rgb(var(--background));
    color: rgb(var(--text-color));
    border: 1px solid transparent;
    border-radius: var(--input-border-radius);
    padding: var(--input-padding-block) var(--input-padding-inline);
    font: inherit;
    transition: border-color 0.2s ease, transform 0.15s ease;
  }

  .the-method__option:active {
    transform: scale(0.98);
  }

  .the-method__option:focus-visible {
    outline: 2px solid rgb(var(--text-color));
    outline-offset: 2px;
  }

  /* Selection changes only the border — background is always the same form-input color, never tinted */
  .the-method__options .the-method__option[aria-checked="true"] {
    border-color: var(--input-border-color, rgb(var(--text-color) / 0.3));
    background: rgb(var(--input-background, transparent));
  }

  .the-method__option-main {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  /* All the option icons share one minimal line style: the thickness of the header icons, in real pixels, with round ends */
  .the-method-icon :is(path, circle) {
    stroke-width: var(--header-icon-line-width, 1.1px);
    vector-effect: non-scaling-stroke;
  }

  /* Option text: the label and, under it, an optional short description (one or two lines) in a softer color */
  .the-method__option-text {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
    flex: 1;
  }

  .the-method__option-description {
    color: rgb(var(--text-color) / 0.6);
  }

  .the-method__option-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: rgb(var(--text-color));
  }

  .the-method__option-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .the-method__option-check {
    display: inline-flex;
    flex-shrink: 0;
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .the-method__option-check .icon {
    width: 1rem;
    height: 1rem;
  }

  .the-method__option[aria-checked="true"] .the-method__option-check {
    opacity: 1;
    transform: scale(1);
  }

  /* Steps tipo "lista compacta" (tipo de piel, sensibilidad, seguridad) — misma tarjeta, más liviana */
  .the-method__options--compact .the-method__option {
    padding: calc(var(--input-padding-block) * 0.85) var(--input-padding-inline);
  }

  /* Pregunta de tono de piel: esferas con brillo, usando los colores reales definidos en el bloque */
  .the-method__tone-scale {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 26rem;
    margin-inline: auto;
  }

  /* Scoped under .the-method__tone-scale (not just .the-method__tone-swatch alone) so this
     reliably beats the theme's own global button reset (assets/theme.css:80-85, which targets
     [type="button"] and sets background-color: transparent at the same specificity) without
     needing !important. */
  .the-method__tone-scale .the-method__tone-swatch {
    appearance: none;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    /* Soft highlight (top-left) + soft shadow (bottom-right) over the real tone color gives the
       glossy sphere look, without needing an image asset or JS. */
    background:
      radial-gradient(circle at 32% 26%, rgb(255 255 255 / 0.55) 0%, rgb(255 255 255 / 0) 45%),
      radial-gradient(circle at 72% 78%, rgb(0 0 0 / 0.22) 0%, rgb(0 0 0 / 0) 55%),
      var(--tone-color);
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.2s ease;
  }

  .the-method__tone-scale .the-method__tone-swatch:hover {
    transform: scale(1.08);
  }

  .the-method__tone-scale .the-method__tone-swatch:focus-visible {
    outline: 2px solid rgb(var(--text-color));
    outline-offset: 3px;
  }

  /* Selected swatch stays the same size — the ring (with a visible gap) is the only selection cue */
  .the-method__tone-scale .the-method__tone-swatch[aria-checked="true"] {
    box-shadow: 0 0 0 3px rgb(var(--background)), 0 0 0 4.5px rgb(var(--text-color) / 0.55);
  }

  /* Pregunta de formato: tarjetas editoriales más grandes (mismo sistema, otra escala) */
  .the-method__options--editorial {
    gap: 1rem;
  }

  .the-method__options--editorial .the-method__option {
    padding: 1.5rem;
  }

  .the-method__options--editorial .the-method__option-icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .the-method__result-card {
    display: grid;
    gap: 2rem;
    text-align: start;
  }

  .the-method__result-card[hidden] {
    display: none;
  }

  .the-method__result-media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--input-border-radius);
  }

  .the-method__result-info {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .the-method__rationale {
    margin: 0;
    color: rgb(var(--text-color) / 0.75);
  }

  .the-method__context-note {
    margin: 0;
    color: rgb(var(--text-color) / 0.6);
  }

  .the-method__context-note:empty {
    display: none;
  }

  .the-method__secondary {
    margin-top: 1rem;
    padding: 1.25rem;
    background: rgb(var(--input-background, transparent));
    border-radius: var(--input-border-radius);
    display: grid;
    gap: 0.75rem;
  }

  .the-method__secondary-card {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .the-method__secondary-media {
    width: 4rem;
    flex-shrink: 0;
  }

  .the-method__secondary-media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--input-border-radius);
  }

  .the-method__secondary-info {
    display: grid;
    gap: 0.25rem;
  }

  .the-method__routine[hidden] {
    display: none;
  }

  .the-method__routine-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .the-method__routine-step {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    background: rgb(var(--input-background, transparent));
    border-radius: var(--input-border-radius);
  }

  .the-method__routine-step-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: rgb(var(--text-color));
  }

  .the-method__routine-step-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .the-method__routine-step-body {
    display: grid;
    gap: 0.25rem;
  }

  .the-method__routine-step-description {
    color: rgb(var(--text-color) / 0.75);
  }

  @media screen and (min-width: 700px) {
    .the-method__result-card {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }

  /* ---- Interaction ---- */

  /* "Analyzing" beat before the result: a line of text and a thin line that slides, nothing else */
  .the-method__panel--analyzing {
    max-width: none;
    justify-items: stretch;
    text-align: start !important;
    min-height: 8rem;
    align-content: center;
  }

  .the-method__analyzing-text {
    margin: 0;
    color: rgb(var(--text-color) / 0.7);
  }

  .the-method__analyzing-line {
    display: block;
    width: 100%;
    max-width: 14rem;
    height: 2px;
    border-radius: 2px;
    background: rgb(var(--text-color) / 0.12);
    position: relative;
    overflow: hidden;
  }

  .the-method__analyzing-line:after {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 40%;
    border-radius: 2px;
    background: rgb(var(--text-color) / 0.6);
    animation: the-method-analyzing 1.1s ease-in-out infinite;
  }

  @keyframes the-method-analyzing {
    from { transform: translateX(-100%); }
    to { transform: translateX(250%); }
  }

  /* Continue button (multiple choice and skin tone): hidden until there is an answer to confirm */
  .the-method__continue .button[disabled] {
    opacity: 0.4;
    pointer-events: none;
  }

  /* Skin tone: one continuous scale (a range) painted with the tones of the block; the handle takes the tone it is on */
  .the-method__tone-slider {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    max-width: 28rem;
  }

  .the-method__tone-range {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 2.25rem;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }

  .the-method__tone-range::-webkit-slider-runnable-track {
    height: 0.75rem;
    border-radius: 999px;
    background: var(--tone-gradient);
  }

  .the-method__tone-range::-moz-range-track {
    height: 0.75rem;
    border-radius: 999px;
    background: var(--tone-gradient);
  }

  .the-method__tone-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 2rem;
    height: 2rem;
    margin-top: -0.625rem;
    border-radius: 50%;
    border: 3px solid rgb(var(--background));
    background: var(--tone-color);
    box-shadow: 0 0 0 1px rgb(var(--text-color) / 0.25);
    transition: transform 0.15s ease;
  }

  .the-method__tone-range::-moz-range-thumb {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 3px solid rgb(var(--background));
    background: var(--tone-color);
    box-shadow: 0 0 0 1px rgb(var(--text-color) / 0.25);
  }

  .the-method__tone-range:active::-webkit-slider-thumb {
    transform: scale(1.1);
  }

  .the-method__tone-range:focus-visible {
    outline: 2px solid rgb(var(--text-color));
    outline-offset: 4px;
    border-radius: 999px;
  }

  .the-method__tone-labels {
    display: flex;
    justify-content: space-between;
    color: rgb(var(--text-color) / 0.6);
  }

  /* Answers given, as small tags above the result */
  .the-method__summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .the-method__summary:empty {
    display: none;
  }

  .the-method__summary-tag {
    appearance: none;
    cursor: pointer;
    border: 0;
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    background: rgb(var(--background));
    color: rgb(var(--text-color));
    transition: opacity 0.2s ease;
  }

  @media (pointer: fine) {
    .the-method__summary-tag:hover {
      opacity: 0.7;
    }
  }

  /* Under the result: send it by WhatsApp and leave the e-mail */
  .the-method__result-extras {
    display: grid;
    gap: var(--the-method-gap);
  }

  .the-method__result-extras[hidden] {
    display: none;
  }

  .the-method__email-capture {
    display: grid;
    gap: 0.5rem;
    max-width: 32rem;
  }

  .the-method__email-capture-row {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }

  .the-method__email-field-end {
    flex: 1;
    min-width: 0;
  }

  .the-method__email-capture-status {
    margin: 0;
    color: rgb(var(--text-color) / 0.7);
  }

  .the-method__email-mailto {
    justify-self: start;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    color: rgb(var(--text-color) / 0.8);
  }

  .the-method__email-mailto[hidden] {
    display: none;
  }

  .the-method__email-capture-status[hidden] {
    display: none;
  }

  /* Routine: a thin line joins the steps, which come in one after another when the result is shown */
  .the-method__routine-list {
    position: relative;
  }

  .the-method__routine-step {
    position: relative;
    animation: the-method-step-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .the-method__routine-step:nth-child(2) { animation-delay: 0.08s; }
  .the-method__routine-step:nth-child(3) { animation-delay: 0.16s; }
  .the-method__routine-step:nth-child(4) { animation-delay: 0.24s; }
  .the-method__routine-step:nth-child(5) { animation-delay: 0.32s; }

  .the-method__routine-step:not(:last-child):after {
    content: "";
    position: absolute;
    inset-inline-start: calc(1rem + 0.75rem);
    inset-block-start: calc(100% - 0.25rem);
    width: 1px;
    height: calc(0.75rem + 0.5rem);
    background: rgb(var(--text-color) / 0.2);
  }

  @keyframes the-method-step-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* The check of a chosen option draws itself */
  .the-method__option[aria-checked="true"] .the-method__option-check path {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    animation: the-method-check 0.35s ease-out 0.05s forwards;
  }

  @keyframes the-method-check {
    to { stroke-dashoffset: 0; }
  }

  /* Smoother progress */
  .the-method__progress-fill {
    transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Change of panel with the View Transitions API (when the browser has it): the panels area morphs to its new size while the old content
     fades out and the new one comes in. Only that area is animated, not the whole page. Without support, the script falls back to its own
     animation. */
  .the-method__panels {
    view-transition-name: the-method-panels;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }

  ::view-transition-group(the-method-panels) {
    animation-duration: 0.26s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }

  ::view-transition-old(the-method-panels) {
    animation: the-method-vt-out 0.12s ease-out both;
  }

  ::view-transition-new(the-method-panels) {
    animation: the-method-vt-in 0.26s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes the-method-vt-out {
    to { opacity: 0; }
  }

  @keyframes the-method-vt-in {
    from { opacity: 0; transform: translateY(var(--the-method-travel, 8px)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .the-method__routine-step,
    .the-method__analyzing-line:after,
    .the-method__option[aria-checked="true"] .the-method__option-check path {
      animation: none;
    }

    .the-method__option[aria-checked="true"] .the-method__option-check path {
      stroke-dashoffset: 0;
    }
  }
{% endstylesheet %}

{% javascript %}
(function () {
  var COMBINE_GAP_THRESHOLD = 1;
  var OUT_DURATION = 120;
  var IN_DURATION = 240;
  var HEIGHT_DURATION = 240;
  var SELECT_DELAY = 160;
  var ANALYZING_DURATION = 1400;
  var MAX_MULTIPLE = 2;
  var STORAGE_TTL = 7 * 24 * 60 * 60 * 1000;

  var reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  function animate(el, keyframes, duration, easing, delay) {
    if (!el || !el.animate || reducedMotionQuery.matches) {
      return Promise.resolve();
    }
    try {
      return el.animate(keyframes, { duration: duration, easing: easing || 'ease', delay: delay || 0 }).finished.catch(function () {});
    } catch (e) {
      return Promise.resolve();
    }
  }

  function track(name, detail) {
    try {
      (window.dataLayer = window.dataLayer || []).push(Object.assign({ event: 'the_method_' + name }, detail || {}));
      document.dispatchEvent(new CustomEvent('the-method:' + name, { detail: detail || {} }));
    } catch (e) {}
  }

  function vibrate() {
    if (navigator.vibrate && !reducedMotionQuery.matches) {
      try { navigator.vibrate(8); } catch (e) {}
    }
  }

  function initInstance(wrapper) {
    var sectionId = wrapper.getAttribute('data-section-id');
    var storageKey = 'the-method:' + sectionId + ':v1';
    var requireEmail = wrapper.getAttribute('data-require-email') === 'true';

    var options = Array.prototype.slice.call(wrapper.querySelectorAll('[data-the-method-option]'));
    var toneRanges = Array.prototype.slice.call(wrapper.querySelectorAll('[data-the-method-tone]'));
    var startButton = wrapper.querySelector('[data-the-method-start]');
    var backButton = wrapper.querySelector('[data-the-method-back]');
    var restartButton = wrapper.querySelector('[data-the-method-restart]');
    var progressWrapper = wrapper.querySelector('[data-the-method-progress]');
    var progressCurrent = wrapper.querySelector('[data-the-method-progress-current]');
    var progressFill = wrapper.querySelector('[data-the-method-progress-fill]');
    var resultCards = wrapper.querySelectorAll('[data-the-method-result]');
    var contextNotes = wrapper.querySelectorAll('[data-the-method-context-note]');
    var warningEl = wrapper.querySelector('[data-the-method-warning]');
    var routineEl = wrapper.querySelector('[data-the-method-routine]');
    var summaryEl = wrapper.querySelector('[data-the-method-summary]');
    var extrasEl = wrapper.querySelector('[data-the-method-extras]');
    var panelsEl = wrapper.querySelector('[data-the-method-panels]');
    var layoutEl = wrapper.closest('[data-the-method-layout]');
    var formEl = wrapper.closest('form');

    var STEPS = Array.prototype.slice.call(wrapper.querySelectorAll('[data-the-method-panel]')).map(function (panel) {
      return panel.getAttribute('data-the-method-panel');
    });
    var totalFlowSteps = STEPS.filter(function (key) { return key.indexOf('step-') === 0; }).length;

    var busy = false;
    var analyzingTimer = null;

    // answers[step] = list of records (one for single choice, up to MAX_MULTIPLE for multiple choice)
    var state = {
      scores: { salicylic: 0, tca: 0 },
      format: null,
      notes: [],
      warnings: [],
      answers: {},
      editing: false
    };

    function panelFor(key) {
      return wrapper.querySelector('[data-the-method-panel="' + key + '"]');
    }

    function optionsForStep(step) {
      return options.filter(function (option) { return option.getAttribute('data-step') === String(step); });
    }

    function isMultiple(step) {
      var panel = panelFor('step-' + step);
      return !!panel && panel.hasAttribute('data-multiple');
    }

    function currentPanelKey() {
      var visible = wrapper.querySelector('[data-the-method-panel]:not([hidden])');
      return visible ? visible.getAttribute('data-the-method-panel') : STEPS[0];
    }

    function recordFromOption(option) {
      var labelEl = option.querySelector('.the-method__option-label');
      return {
        key: option.getAttribute('data-key'),
        label: labelEl ? labelEl.textContent.trim() : (option.getAttribute('aria-label') || ''),
        weightSalicylic: Number(option.dataset.weightSalicylic || 0),
        weightTca: Number(option.dataset.weightTca || 0),
        format: option.dataset.format || '',
        note: option.dataset.note || '',
        warn: option.dataset.warn === 'true',
        warnNote: option.dataset.warnNote || ''
      };
    }

    function answeredCount(step) {
      return (state.answers[step] || []).length;
    }

    function isAnswered(step) {
      return answeredCount(step) > 0;
    }

    // ---- persistence (so a visitor who leaves can come back to where they were) ----
    function saveProgress(panelKey) {
      try {
        var answers = {};
        Object.keys(state.answers).forEach(function (step) {
          answers[step] = state.answers[step].map(function (record) { return record.key; });
        });
        localStorage.setItem(storageKey, JSON.stringify({ answers: answers, panel: panelKey || currentPanelKey(), ts: Date.now() }));
      } catch (e) {}
    }

    function clearProgress() {
      try { localStorage.removeItem(storageKey); } catch (e) {}
    }

    // ---- selection state in the DOM ----
    function toneColorsFor(range) {
      return (range.parentElement.getAttribute('data-tone-colors') || '').split(',');
    }

    function paintTone(range) {
      var colors = toneColorsFor(range);
      var index = Math.min(Math.max(Number(range.value), 1), colors.length) - 1;
      if (colors[index]) {
        range.parentElement.style.setProperty('--tone-color', colors[index]);
      }
      range.setAttribute('aria-valuetext', 'Tono ' + range.value + ' de ' + colors.length);
    }

    function updateContinue(step) {
      var panel = panelFor('step-' + step);
      var wrap = panel && panel.querySelector('[data-the-method-continue]');
      if (!wrap) return;
      var button = wrap.querySelector('button, a');
      if (button) button.disabled = !isAnswered(step);
    }

    function applySelectedState(step) {
      var selectedKeys = (state.answers[step] || []).map(function (record) { return record.key; });
      optionsForStep(step).forEach(function (option) {
        option.setAttribute('aria-checked', selectedKeys.indexOf(option.getAttribute('data-key')) !== -1 ? 'true' : 'false');
      });
      toneRanges.forEach(function (range) {
        if (range.getAttribute('data-step') !== String(step)) return;
        var record = (state.answers[step] || [])[0];
        if (record) {
          range.value = record.key.split('-tone-')[1] || range.value;
        }
        paintTone(range);
      });
      updateContinue(step);
    }

    // Recomputes scores/format/notes/warnings from scratch from the answers, so going back and changing one never doubles anything.
    function recomputeFromAnswers() {
      var scores = { salicylic: 0, tca: 0 };
      var format = null;
      var notes = [];
      var warnings = [];

      Object.keys(state.answers).forEach(function (step) {
        (state.answers[step] || []).forEach(function (record) {
          scores.salicylic += record.weightSalicylic;
          scores.tca += record.weightTca;
          if (record.format && record.format !== 'auto') format = record.format;
          if (record.note) notes.push(record.note);
          if (record.warn && record.warnNote) warnings.push(record.warnNote);
        });
      });

      state.scores = scores;
      state.format = format;
      state.notes = notes;
      state.warnings = warnings;
    }

    // The banner opens and closes smoothly (height + fade) instead of popping in and pushing everything down at once.
    function updateWarningBanner() {
      if (!warningEl) return;
      var unique = state.warnings.filter(function (note, index) {
        return note && state.warnings.indexOf(note) === index;
      });

      if (unique.length === 0) {
        if (warningEl.hidden) return;
        var closedFrom = warningEl.offsetHeight;
        animate(warningEl, [
          { opacity: 1, height: closedFrom + 'px', paddingBlock: getComputedStyle(warningEl).paddingBlockStart },
          { opacity: 0, height: '0px', paddingBlock: '0px' }
        ], HEIGHT_DURATION, 'ease-in-out').then(function () {
          if (state.warnings.length === 0) {
            warningEl.hidden = true;
            warningEl.textContent = '';
          }
        });
        return;
      }

      var text = unique.join(' ');
      if (!warningEl.hidden) {
        warningEl.textContent = text;
        return;
      }

      warningEl.textContent = text;
      warningEl.hidden = false;
      var openTo = warningEl.offsetHeight;
      animate(warningEl, [
        { opacity: 0, height: '0px', paddingBlock: '0px' },
        { opacity: 1, height: openTo + 'px', paddingBlock: getComputedStyle(warningEl).paddingBlockStart }
      ], HEIGHT_DURATION, 'ease-in-out');
    }

    function resolveMethod() {
      return state.scores.tca > state.scores.salicylic ? 'tca' : 'salicylic';
    }

    function resolveFormat() {
      if (state.format) return state.format;
      return Math.abs(state.scores.salicylic - state.scores.tca) <= COMBINE_GAP_THRESHOLD ? 'combo' : 'single';
    }

    // Each result declares which method/format it answers to ("any" = wildcard); the most specific match wins.
    function scoreMatch(card, method, format) {
      var cardMethod = card.dataset.matchMethod || 'any';
      var cardFormat = card.dataset.matchFormat || 'any';
      if (cardMethod !== 'any' && cardMethod !== method) return -1;
      if (cardFormat !== 'any' && cardFormat !== format) return -1;
      var score = 0;
      if (cardMethod === method) score += 2;
      if (cardFormat === format) score += 1;
      return score;
    }

    function answersSummaryText() {
      return STEPS.filter(function (key) { return key.indexOf('step-') === 0; }).map(function (key) {
        var step = key.split('-')[1];
        return (state.answers[step] || []).map(function (record) { return record.label; }).join(' + ');
      }).filter(Boolean);
    }

    function renderSummary() {
      if (!summaryEl) return;
      summaryEl.textContent = '';
      STEPS.forEach(function (key) {
        if (key.indexOf('step-') !== 0) return;
        var step = key.split('-')[1];
        var labels = (state.answers[step] || []).map(function (record) { return record.label; }).filter(Boolean);
        if (!labels.length) return;
        var tag = document.createElement('button');
        tag.type = 'button';
        tag.className = 'the-method__summary-tag';
        tag.setAttribute('data-edit-step', key);
        tag.textContent = labels.join(' + ');
        summaryEl.appendChild(tag);
      });
    }

    // The routine shown under the result, as plain lines ("Limpieza: ...") - used by the WhatsApp message and by the e-mail
    function routineLines() {
      var lines = [];
      wrapper.querySelectorAll('.the-method__routine-step').forEach(function (step, index) {
        var title = step.querySelector('.the-method__routine-step-title');
        var description = step.querySelector('.the-method__routine-step-description');
        var text = (title ? title.textContent.trim() : '') + (description ? ': ' + description.textContent.trim() : '');
        if (text) lines.push((index + 1) + '. ' + text);
      });
      return lines;
    }

    function visibleResultCard() {
      var found = null;
      resultCards.forEach(function (card) { if (!card.hidden) found = card; });
      return found;
    }

    // The whole result as text: answers, recommended method (with its link) and the daily routine
    function resultText(labels) {
      var lines = [];
      var answerLines = answersSummaryText();
      var card = visibleResultCard();
      var title = card && card.querySelector('h3') ? card.querySelector('h3').textContent.trim() : '';
      var link = card ? card.querySelector('.the-method__result-info a') : null;
      if (answerLines.length) lines.push(labels.answers + ': ' + answerLines.join(' / '));
      if (title) lines.push(labels.result + ': ' + title + (link ? ' - ' + link.href : ''));
      var routine = routineLines();
      if (routine.length) {
        lines.push('');
        lines.push(labels.routine + ':');
        lines = lines.concat(routine);
      }
      return lines;
    }

    function prepareExtras(best) {
      if (extrasEl) extrasEl.hidden = !best;

      var whatsapp = wrapper.querySelector('[data-the-method-whatsapp]');
      if (whatsapp && best) {
        var link = whatsapp.querySelector('a');
        var lines = [whatsapp.getAttribute('data-message') || ''].concat(resultText({
          answers: whatsapp.getAttribute('data-answers-label') || '',
          result: whatsapp.getAttribute('data-result-label') || '',
          routine: extrasEl ? extrasEl.getAttribute('data-routine-label') || '' : ''
        }));
        if (link) {
          link.setAttribute('href', 'https://wa.me/' + whatsapp.getAttribute('data-number').replace(/\D/g, '') + '?text=' + encodeURIComponent(lines.filter(Boolean).join('\n')));
          link.setAttribute('rel', 'noopener');
        }
      }
    }

    function showResult() {
      recomputeFromAnswers();
      updateWarningBanner();

      var method = resolveMethod();
      var format = resolveFormat();

      var best = null;
      var bestScore = -1;
      resultCards.forEach(function (card) {
        var score = scoreMatch(card, method, format);
        if (score > bestScore) {
          bestScore = score;
          best = card;
        }
      });

      resultCards.forEach(function (card) {
        card.hidden = bestScore < 0 || card !== best;
      });

      var note = state.notes.filter(Boolean).join(' ');
      contextNotes.forEach(function (el) {
        el.textContent = note;
      });

      if (routineEl) routineEl.hidden = false;
      renderSummary();
      prepareExtras(bestScore < 0 ? null : best);
      track('result', { method: method, format: format });
    }

    function updateControls(panelKey) {
      var isIntro = panelKey === 'intro';
      var isAnalyzing = panelKey === 'analyzing';
      var isQuestion = panelKey.indexOf('step-') === 0;

      if (backButton) backButton.hidden = isIntro || isAnalyzing;
      if (restartButton) restartButton.hidden = isIntro || isAnalyzing;
      if (progressWrapper) progressWrapper.hidden = isIntro;

      // The intro image is only seen on the intro: when the test moves on, the section collapses to a single column.
      if (layoutEl) layoutEl.classList.toggle('the-method-layout--quiz-active', !isIntro);

      if (progressFill && totalFlowSteps > 0) {
        if (isQuestion) {
          var stepNumber = panelKey.split('-')[1];
          if (progressCurrent) progressCurrent.textContent = stepNumber.length < 2 ? '0' + stepNumber : stepNumber;
          progressFill.style.width = (Number(stepNumber) / totalFlowSteps) * 100 + '%';
        } else if (isAnalyzing || panelKey === 'result') {
          progressFill.style.width = '100%';
        }
      }
    }

    var supportsViewTransitions = typeof document.startViewTransition === 'function';

    function swapPanels(fromEl, toEl, panelKey) {
      if (fromEl) fromEl.hidden = true;
      updateControls(panelKey);
      toEl.hidden = false;
    }

    function finishTransition(toEl, panelKey) {
      if (typeof toEl.focus === 'function') {
        toEl.focus({ preventScroll: true });
      }
      saveProgress(panelKey);
      busy = false;

      if (panelKey === 'analyzing') {
        clearTimeout(analyzingTimer);
        analyzingTimer = setTimeout(function () {
          goTo('result', 1);
        }, reducedMotionQuery.matches ? 0 : ANALYZING_DURATION);
      }
    }

    // One change of panel. With the View Transitions API the area of the panels morphs and cross-fades by itself; otherwise the old panel fades
    // out, the controls and the layout settle, and the new one rises in while the container eases to its height. Clicks that arrive while it
    // runs are ignored (busy), so a double tap can't skip a question.
    function goTo(panelKey, direction) {
      if (busy) {
        return Promise.resolve();
      }

      direction = direction || 1;
      var travel = 8 * direction;

      var fromEl = wrapper.querySelector('[data-the-method-panel]:not([hidden])');
      var toEl = panelFor(panelKey);

      if (!toEl || toEl === fromEl) {
        return Promise.resolve();
      }

      busy = true;

      if (panelKey === 'result') {
        showResult();
      }

      if (panelKey.indexOf('step-') === 0) {
        applySelectedState(panelKey.split('-')[1]);
        track('step', { step: panelKey });
      }

      if (supportsViewTransitions && !reducedMotionQuery.matches) {
        document.documentElement.style.setProperty('--the-method-travel', travel + 'px');
        return new Promise(function (resolve) {
          var transition;
          try {
            transition = document.startViewTransition(function () {
              swapPanels(fromEl, toEl, panelKey);
            });
          } catch (e) {
            swapPanels(fromEl, toEl, panelKey);
            finishTransition(toEl, panelKey);
            resolve();
            return;
          }
          transition.finished.catch(function () {}).then(function () {
            finishTransition(toEl, panelKey);
            resolve();
          });
        });
      }

      var fromHeight = panelsEl ? panelsEl.getBoundingClientRect().height : 0;
      var chain = Promise.resolve();

      if (fromEl) {
        chain = animate(fromEl, [{ opacity: 1 }, { opacity: 0 }], OUT_DURATION, 'ease-out').then(function () {
          fromEl.hidden = true;
        });
      }

      return chain
        .then(function () {
          if (panelsEl) {
            panelsEl.style.height = fromHeight + 'px';
            panelsEl.style.overflow = 'hidden';
          }

          updateControls(panelKey);
          toEl.hidden = false;

          var heightAnimation = Promise.resolve();
          if (panelsEl) {
            heightAnimation = animate(panelsEl, [{ height: fromHeight + 'px' }, { height: panelsEl.scrollHeight + 'px' }], HEIGHT_DURATION, 'ease-in-out');
          }

          return Promise.all([
            heightAnimation,
            animate(toEl, [
              { opacity: 0, transform: 'translateY(' + travel + 'px)' },
              { opacity: 1, transform: 'translateY(0)' }
            ], IN_DURATION, 'cubic-bezier(0.22, 1, 0.36, 1)')
          ]);
        })
        .then(function () {
          if (panelsEl) {
            panelsEl.style.height = '';
            panelsEl.style.overflow = '';
          }
          finishTransition(toEl, panelKey);
        })
        .catch(function () {
          if (panelsEl) {
            panelsEl.style.height = '';
            panelsEl.style.overflow = '';
          }
          busy = false;
        });
    }

    function goToStepIndex(delta) {
      var index = STEPS.indexOf(currentPanelKey());
      var nextIndex = index + delta;
      if (nextIndex >= 0 && nextIndex < STEPS.length && STEPS[nextIndex] === 'analyzing' && delta < 0) {
        nextIndex -= 1;
      }
      if (nextIndex < 0 || nextIndex >= STEPS.length) return;
      goTo(STEPS[nextIndex], delta > 0 ? 1 : -1);
    }

    // After an answer is confirmed: next question, or, when it was edited from the result, straight back to the (recalculated) result.
    function advance() {
      if (state.editing) {
        state.editing = false;
        goTo('result', 1);
      } else {
        goToStepIndex(1);
      }
    }

    function afterAnswer(step) {
      applySelectedState(step);
      recomputeFromAnswers();
      updateWarningBanner();
      saveProgress();
      vibrate();
    }

    // ---- single and multiple choice ----
    options.forEach(function (option) {
      option.addEventListener('click', function () {
        if (busy) return;
        var step = option.getAttribute('data-step');
        var record = recordFromOption(option);
        var current = state.answers[step] || [];

        if (isMultiple(step)) {
          var exists = current.some(function (item) { return item.key === record.key; });
          if (exists) {
            current = current.filter(function (item) { return item.key !== record.key; });
          } else {
            current = current.concat(record);
            if (current.length > MAX_MULTIPLE) current = current.slice(current.length - MAX_MULTIPLE);
          }
          state.answers[step] = current;
          afterAnswer(step);
          track('answer', { step: 'step-' + step, answer: record.label });
          return;
        }

        state.answers[step] = [record];
        afterAnswer(step);
        track('answer', { step: 'step-' + step, answer: record.label });

        // A short beat so the chosen option is seen selected before the next question comes in
        if (reducedMotionQuery.matches) {
          advance();
        } else {
          busy = true;
          setTimeout(function () {
            busy = false;
            advance();
          }, SELECT_DELAY);
        }
      });

      option.addEventListener('keydown', function (event) {
        var isNext = event.key === 'ArrowRight' || event.key === 'ArrowDown';
        var isPrev = event.key === 'ArrowLeft' || event.key === 'ArrowUp';
        if (!isNext && !isPrev) return;

        event.preventDefault();
        var step = option.getAttribute('data-step');
        var stepOptions = optionsForStep(step);
        var currentPos = stepOptions.indexOf(option);
        var direction = isNext ? 1 : -1;
        var nextPos = (currentPos + direction + stepOptions.length) % stepOptions.length;
        stepOptions[nextPos].focus();
      });
    });

    // ---- skin tone scale ----
    toneRanges.forEach(function (range) {
      var step = range.getAttribute('data-step');

      function record() {
        paintTone(range);
        state.answers[step] = [{
          key: range.getAttribute('data-key-prefix') + '-tone-' + range.value,
          label: 'Tono ' + range.value,
          weightSalicylic: 0,
          weightTca: 0,
          format: '',
          note: '',
          warn: false,
          warnNote: ''
        }];
        updateContinue(step);
        saveProgress();
      }

      range.addEventListener('input', function () {
        paintTone(range);
      });
      range.addEventListener('change', function () {
        record();
        vibrate();
        track('answer', { step: 'step-' + step, answer: 'tono ' + range.value });
      });
      // Tapping the handle without moving it still confirms the tone it is on
      range.addEventListener('click', function () {
        if (!isAnswered(step)) record();
      });
      paintTone(range);
    });

    // ---- continue (multiple choice and tone) ----
    wrapper.querySelectorAll('[data-the-method-continue]').forEach(function (wrap) {
      var panel = wrap.closest('[data-the-method-panel]');
      var button = wrap.querySelector('button, a');
      if (button) button.disabled = true;
      wrap.addEventListener('click', function (event) {
        if (!panel || busy) return;
        var step = panel.getAttribute('data-the-method-panel').split('-')[1];
        if (!isAnswered(step)) return;
        event.preventDefault();
        advance();
      });
    });

    // ---- intro, back, restart ----
    if (startButton) {
      startButton.addEventListener('click', function () {
        track('start');
        goTo(STEPS[1] || 'result');
      });
    }

    if (backButton) {
      backButton.addEventListener('click', function () {
        state.editing = false;
        goToStepIndex(-1);
      });
    }

    if (restartButton) {
      restartButton.addEventListener('click', function () {
        clearTimeout(analyzingTimer);
        state.answers = {};
        state.scores = { salicylic: 0, tca: 0 };
        state.format = null;
        state.notes = [];
        state.warnings = [];
        state.editing = false;
        clearProgress();
        updateWarningBanner();
        options.forEach(function (option) {
          option.setAttribute('aria-checked', 'false');
        });
        toneRanges.forEach(function (range) {
          range.value = 3;
          paintTone(range);
        });
        wrapper.querySelectorAll('[data-the-method-continue]').forEach(function (wrap) {
          var button = wrap.querySelector('button, a');
          if (button) button.disabled = true;
        });
        track('restart');
        goTo('intro', -1);
      });
    }

    // ---- summary tags: back to one question, then straight to the result again ----
    if (summaryEl) {
      summaryEl.addEventListener('click', function (event) {
        var tag = event.target.closest('[data-edit-step]');
        if (!tag || busy) return;
        state.editing = true;
        goTo(tag.getAttribute('data-edit-step'), -1);
      });
    }

    // ---- e-mail at the end of the test (the same customer form of the section, sent without reloading the page) ----
    var emailBox = wrapper.querySelector('[data-the-method-email]');
    if (emailBox && formEl) {
      var emailInput = emailBox.querySelector('[data-the-method-email-input]');
      var emailStatus = emailBox.querySelector('[data-the-method-email-status]');
      var emailSubmit = emailBox.querySelector('[data-the-method-email-submit] button');
      var sending = false;

      function showEmailStatus(text) {
        emailStatus.textContent = text;
        emailStatus.hidden = !text;
      }

      var mailtoLink = emailBox.querySelector('[data-the-method-email-mailto]');

      function post(body) {
        return fetch(formEl.getAttribute('action') || '/contact', { method: 'POST', body: body, headers: { Accept: 'text/html' } }).then(function (response) {
          if (!response.ok) throw new Error('bad response');
        });
      }

      // Two sends, both without reloading the page: the newsletter subscription (the section's customer form) and a message to the store with
      // the e-mail, the answers, the recommended method and the daily routine, so the result and the routine can be sent back to that e-mail.
      function sendEmail() {
        if (sending) return;
        var value = (emailInput.value || '').trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
          showEmailStatus(emailBox.getAttribute('data-error-text') || '');
          emailInput.focus();
          return;
        }
        sending = true;
        if (emailSubmit) emailSubmit.setAttribute('aria-busy', 'true');

        var labels = {
          answers: emailBox.getAttribute('data-answers-label') || '',
          result: emailBox.getAttribute('data-result-label') || '',
          routine: emailBox.getAttribute('data-routine-label') || ''
        };
        var subject = emailBox.getAttribute('data-subject') || '';
        var text = resultText(labels).join('\n');

        var subscribe = new FormData(formEl);
        subscribe.set('contact[email]', value);

        var message = new FormData();
        message.set('form_type', 'contact');
        message.set('utf8', '\u2713');
        message.set('contact[email]', value);
        message.set('contact[body]', subject + '\n\n' + text);

        Promise.all([
          post(subscribe).then(function () { return true; }, function () { return false; }),
          post(message).then(function () { return true; }, function () { return false; })
        ]).then(function (results) {
          if (!results[0] && !results[1]) throw new Error('both failed');
          showEmailStatus(emailBox.getAttribute('data-success-text') || '');
          if (mailtoLink) {
            mailtoLink.setAttribute('href', 'mailto:' + encodeURIComponent(value).replace(/%40/g, '@') + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(text));
            mailtoLink.hidden = false;
          }
          emailInput.value = '';
          track('email');
        }).catch(function () {
          showEmailStatus(emailBox.getAttribute('data-error-text') || '');
        }).then(function () {
          sending = false;
          if (emailSubmit) emailSubmit.removeAttribute('aria-busy');
        });
      }

      if (emailSubmit) emailSubmit.addEventListener('click', sendEmail);
      emailInput.addEventListener('keydown', function (event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          sendEmail();
        }
      });
    }

    var whatsappLink = wrapper.querySelector('[data-the-method-whatsapp] a');
    if (whatsappLink) {
      whatsappLink.addEventListener('click', function () { track('whatsapp'); });
    }

    // ---- keyboard: 1-9 picks an option of the question in view, Enter confirms ----
    wrapper.addEventListener('keydown', function (event) {
      if (event.metaKey || event.ctrlKey || event.altKey || busy) return;
      var tag = event.target.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      var key = currentPanelKey();
      if (key.indexOf('step-') !== 0) return;
      var step = key.split('-')[1];

      if (/^[1-9]$/.test(event.key)) {
        var choice = optionsForStep(step)[Number(event.key) - 1];
        if (choice) {
          event.preventDefault();
          choice.click();
        }
      }
    });

    // ---- swipe on phones: to the right goes back, to the left moves on once the question is answered ----
    var touchStartX = 0;
    var touchStartY = 0;
    if (panelsEl) {
      panelsEl.addEventListener('touchstart', function (event) {
        var touch = event.changedTouches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      }, { passive: true });

      panelsEl.addEventListener('touchend', function (event) {
        if (busy || event.target.closest('input[type="range"]')) return;
        var touch = event.changedTouches[0];
        var dx = touch.clientX - touchStartX;
        var dy = touch.clientY - touchStartY;
        if (Math.abs(dx) < 70 || Math.abs(dy) > 40) return;
        var key = currentPanelKey();
        if (key.indexOf('step-') !== 0) return;
        var step = key.split('-')[1];

        if (dx > 0) {
          state.editing = false;
          goToStepIndex(-1);
        } else if (isAnswered(step)) {
          advance();
        }
      }, { passive: true });
    }

    // ---- restore where the visitor was (not when an e-mail is required to start, so that gate is never skipped) ----
    function restoreProgress() {
      if (requireEmail) return;
      var saved = null;
      try { saved = JSON.parse(localStorage.getItem(storageKey) || 'null'); } catch (e) {}
      if (!saved || !saved.panel || saved.panel === 'intro' || Date.now() - saved.ts > STORAGE_TTL) return;
      if (!panelFor(saved.panel)) return;

      Object.keys(saved.answers || {}).forEach(function (step) {
        var records = [];
        (saved.answers[step] || []).forEach(function (key) {
          var option = options.filter(function (item) { return item.getAttribute('data-key') === key; })[0];
          if (option) {
            records.push(recordFromOption(option));
          } else if (key.indexOf('-tone-') !== -1) {
            records.push({ key: key, label: 'Tono ' + key.split('-tone-')[1], weightSalicylic: 0, weightTca: 0, format: '', note: '', warn: false, warnNote: '' });
          }
        });
        if (records.length) state.answers[step] = records;
      });

      recomputeFromAnswers();
      Object.keys(state.answers).forEach(applySelectedState);

      var target = saved.panel === 'analyzing' ? 'result' : saved.panel;
      var fromEl = wrapper.querySelector('[data-the-method-panel]:not([hidden])');
      var toEl = panelFor(target);
      if (fromEl && fromEl !== toEl) fromEl.hidden = true;
      if (target === 'result') showResult();
      updateControls(target);
      toEl.hidden = false;
      if (state.warnings.length) updateWarningBanner();
    }

    restoreProgress();
  }

  function initAll() {
    document.querySelectorAll('[data-the-method]').forEach(function (wrapper) {
      if (wrapper.dataset.tmInitialized === 'true') return;
      wrapper.dataset.tmInitialized = 'true';
      initInstance(wrapper);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

  document.addEventListener('shopify:section:load', initAll);
})();
