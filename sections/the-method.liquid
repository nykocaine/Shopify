  /* The check of a chosen option draws itself */
  .the-method__option[aria-checked="true"] .the-method__option-check path {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    animation: the-method-check 0.35s ease-out 0.05s forwards;
  }

  @keyframes the-method-check {
    to { stroke-dashoffset: 0; }
  }

  /* Smoother progress */
  .the-method__progress-fill {
    transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Change of panel with the View Transitions API (when the browser has it): the panels area morphs to its new size while the old content
     fades out and the new one comes in. Only that area is animated, not the whole page. Without support, the script falls back to its own
     animation. */
  .the-method__panels {
    view-transition-name: the-method-panels;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  /* The old page image is not needed (only the panels area is animated): showing both at once, blended, was a brightness flash */
  ::view-transition-old(root) {
    display: none;
  }

  /* The panels area morphs to its new size; the snapshots are not stretched while it does (object-fit none, anchored at the top, clipped),
     and the old and the new content cross-fade with the same duration and curve, so the sum of both is constant - no dip, no flash. */
  ::view-transition-group(the-method-panels) {
    animation-duration: 0.26s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    overflow: clip;
  }

  ::view-transition-old(the-method-panels),
  ::view-transition-new(the-method-panels) {
    height: 100%;
    width: 100%;
    object-fit: none;
    object-position: 0 0;
    mix-blend-mode: normal;
    animation-duration: 0.26s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  ::view-transition-old(the-method-panels) {
    animation-name: the-method-vt-out;
    animation-fill-mode: both;
  }

  ::view-transition-new(the-method-panels) {
    animation-name: the-method-vt-in;
    animation-fill-mode: both;
  }

  @keyframes the-method-vt-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes the-method-vt-in {
    from { opacity: 0; transform: translateY(var(--the-method-travel, 8px)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .the-method__analyzing-line:after,
    .the-method__option[aria-checked="true"] .the-method__option-check path {
      animation: none;
    }

    .the-method__option[aria-checked="true"] .the-method__option-check path {
      stroke-dashoffset: 0;
    }
  }
