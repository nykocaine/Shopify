{%- liquid
  assign has_active_filters = false
  
  for filter in search.filters
    if filter.type == 'price_range'
      if filter.max_value.value != blank or filter.min_value.value != blank
        assign has_active_filters = true
        break
      endif
    else
      if filter.active_values.size > 0
        assign has_active_filters = true
        break
      endif
    endif
  endfor

  # icon_alignment only ever moves the icon, never the heading - the heading sits in its own grid
  # column/area sized to its own content (or, side by side with the icon, the "title" area's track
  # is "auto", always exactly as wide as the heading needs), so it can't be pushed around by
  # whatever space the icon's alignment leaves unused. icon_justify_self is the icon's own
  # justify-self (side-by-side layouts, a grid) or align-self (stacked layouts, a flex column) -
  # both accept the same start/center/end keywords, so one variable covers either case.
  assign icon_justify_self = 'center'

  case section.settings.icon_alignment
    when 'left'
      assign icon_justify_self = 'start'
    when 'right'
      assign icon_justify_self = 'end'
  endcase

  # icon_position picks which side of the title the icon sits on. Side by side (left/right), this
  # is a 2-column grid with one named area per element - the heading's area/column is always "auto"
  # (its own content width) and the icon's is always "1fr" (the rest of the row, for it to roam
  # across via icon_justify_self above), regardless of which column each lands in, since grid-area
  # ties each element to its column by name rather than by source order. Stacked (above/below) is a
  # plain flex column instead - its cross-axis alignment (align-items/align-self) is already
  # per-item independent of source order, so no grid trick is needed there.
  assign icon_display = 'grid'
  assign icon_grid_template_columns = 'auto 1fr'
  assign icon_grid_template_areas = '"heading icon"'
  assign icon_flex_direction = 'column'

  case section.settings.icon_position
    when 'left'
      assign icon_grid_template_columns = '1fr auto'
      assign icon_grid_template_areas = '"icon heading"'
    when 'above'
      assign icon_display = 'flex'
      assign icon_flex_direction = 'column-reverse'
    when 'below'
      assign icon_display = 'flex'
      assign icon_flex_direction = 'column'
  endcase
-%}

<style>
  #shopify-section-{{ section.id }} {
    --blog-post-list-grid: auto / minmax(0, 1fr);
    --blog-post-list-gap: 2.5rem;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      --blog-post-list-grid: auto / repeat(2, minmax(0, 1fr));
      --blog-post-list-gap: var(--container-gutter);
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      --blog-post-list-grid: auto / repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1400px) {
    #shopify-section-{{ section.id }} {
      --blog-post-list-grid: auto / repeat(4, minmax(0, 1fr));
    }
  }

  {%- comment -%}
  No-results / empty search: the message is centered both ways in the available space (grid + place-items) instead of
  hanging from a fixed top padding.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .container > .empty-state:not(.empty-state--sm) {
    display: grid;
    place-items: center;
    min-height: 60vh;
    text-align: center;
  }

  {%- if section.settings.floating_search -%}
    {%- comment -%}
    Floating mode: this section becomes its own rounded card, so it needs a real inner inset on all
    four sides - same calc(var(--container-gutter) + 0.5rem) formula as sections/faq.liquid and
    sections/reviews.liquid, at every breakpoint.

    The catch is that nothing here was padded to begin with: .container (theme.css) insets itself
    with margin-inline, not padding, so the card's own edges stay bare and the margin just shifts
    content inward from outside the card. Zeroing that margin and replacing it with padding-inline
    is what actually gives the card an interior - same swap faq.liquid documents on .faq__container.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .container {
      margin-inline: 0;
      padding-inline: calc(var(--container-gutter) + 0.5rem);
    }

    {%- comment -%}
    Block (vertical) padding matches the same calc(var(--container-gutter) + 0.5rem) formula as the
    inline sides - bottom exactly, top tripled (same technique as sections/faq.liquid's :first-child
    rule) so the card's content clears the search icon/heading area at the top with real breathing
    room instead of the same tight inset used everywhere else.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .section-spacing {
      padding-block-start: calc((var(--container-gutter) + 0.5rem) * 3);
      padding-block-end: calc(var(--container-gutter) + 0.5rem);
    }

    {%- comment -%}
    .empty-state's theme.css default (padding-block: 7.5rem) is a fixed, non-gutter-aware value -
    replaced here with the same top-tripled/bottom-normal formula as .section-spacing above, so both
    card states (no results vs. results) read as the same card size.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .empty-state {
      padding-block-start: calc((var(--container-gutter) + 0.5rem) * 3);
      padding-block-end: calc(var(--container-gutter) + 0.5rem);
    }

    {%- comment -%}
    The results view has no .container of its own - the toolbar and the grid carry their own
    padding-inline: var(--container-gutter) (theme.css), half a rem short of the card formula - and
    .collection's padding-block-end is a generic page rhythm value, not a card inset, so the grid
    and pagination run into the card's rounded bottom edge.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .collection__toolbar,
    #shopify-section-{{ section.id }} .collection__results {
      padding-inline: calc(var(--container-gutter) + 0.5rem);
    }

    #shopify-section-{{ section.id }} .collection {
      padding-block-end: calc(var(--container-gutter) + 0.5rem);
    }
  {%- endif -%}

  {%- comment -%}
  Result panels for blog posts / pages / products are fetched after the page loads when the search returns several
  types. While one is empty it used to collapse to nothing and then push everything down when it filled in (a visible
  jump, and a blink every time the section was re-rendered). It is now a block that keeps a minimum height until its
  content arrives.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} search-result-panel {
    display: block;
  }

  #shopify-section-{{ section.id }} .collection__resource-tab-list button[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} search-result-panel[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} search-result-panel[load-from-url]:empty {
    min-height: 50vh;
  }

  {%- comment -%}
  Filter bar layout: result-type tabs (or the count) pinned to the left, filter/sort pinned to the right. The bar is a
  space-between flex row, but its children are not always two: the mobile filter button and the (here always empty on
  mobile) desktop group are separate items, so the button ended up next to the tabs instead of at the far end. Both
  filter/sort entry points now take all the free space before them (margin-inline-start: auto), and the desktop group is
  dropped below 700px, where it holds nothing for the search page, so the mobile button is the only item on the right.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .collection__toolbar > .vertically-separated-list,
  #shopify-section-{{ section.id }} .collection__toolbar > .sm\:hidden,
  #shopify-section-{{ section.id }} .collection__toolbar > button[aria-controls="facets-drawer"] {
    margin-inline-start: auto;
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .collection__toolbar > .vertically-separated-list {
      display: none;
    }
  }

  {%- comment -%}
  Filter bar: same look and options as the collection page's toolbar (its own color scheme, optional floating and
  sticky-to-header modes), ported from sections/main-collection.liquid.
  {%- endcomment -%}
  {%- if section.settings.floating_toolbar -%}
    {%- comment -%}
    Floating mode: same calc(var(--container-gutter) + 0.5rem) formula as sections/reviews.liquid and
    sections/faq.liquid on the sides; top and bottom use three quarters of it (half from 700px up), so the toolbar reads as a compact
    padded card instead of keeping its default, non-uniform padding values (theme.css).
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .collection__toolbar {
      padding-block: calc((var(--container-gutter) + 0.5rem) * 0.75);
      padding-inline: calc(var(--container-gutter) + 0.5rem);
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .collection__toolbar {
        padding-block: calc((var(--container-gutter) + 0.5rem) / 2);
      }
    }

    {%- comment -%}
    Spacing below the toolbar and below the whole collection is a full section spacing, as outer margin
    (not padding): the gap to the product grid sits between the toolbar and the grid, and the gap to the
    footer sits outside the section's colored background, so the theme editor doesn't select either.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .collection__toolbar {
      margin-block-end: var(--section-vertical-spacing);
    }

    #shopify-section-{{ section.id }} > .color-scheme {
      margin-block-end: var(--section-vertical-spacing);
    }

    #shopify-section-{{ section.id }} .collection {
      padding-block-end: 0;
    }

    {%- comment -%}
    The toolbar already leaves a full section spacing below it (margin above), so the heading block that follows
    drops its own top padding instead of stacking a second gap on top of that one.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .collection__toolbar + .section-spacing {
      padding-block-start: 0;
    }

    {%- if section.settings.floating_search -%}
      {%- comment -%}
      Inside the floating search card the toolbar sits within the card's own inset (see the floating search block
      above), so it must not add its own side margin or it would be indented twice and stop lining up with the heading
      and the results.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .collection__toolbar {
        margin-inline: 0;
      }
    {%- endif -%}

    {%- if section.settings.sticky_toolbar -%}
      {%- comment -%}
      Sticky toolbar glued to the header. It sticks at the header's fully visible position
      (--sticky-area-height) and, when the header hides on scroll, slides up by the header's height with
      the same transform + timing as the header's own slide (sections/header.liquid), so both move on
      the compositor in lockstep. It overlaps the header's last pixel (z-index below the header's) so
      sub-pixel rounding of the header's height can never leave a visible seam between them.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .collection__toolbar {
        position: sticky;
        top: calc(var(--sticky-area-height) - 1px);
        z-index: 2;
        margin-block-start: -1px;
        padding-block-start: calc((var(--container-gutter) + 0.5rem) * 0.75 + 1px);
        will-change: transform;
        transition: transform var(--header-solid-transition, .45s cubic-bezier(.4, 0, .2, 1)), visibility var(--header-solid-transition, .45s cubic-bezier(.4, 0, .2, 1));
      }

      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .collection__toolbar {
          padding-block-start: calc((var(--container-gutter) + 0.5rem) / 2 + 1px);
        }
      }

      {%- comment -%}
      Hides together with the header: triggered by the very same state as the header's own slide
      (.header.is-hidden, see sections/header.liquid), not by a custom property on :root, so both start in
      the same style recalculation. It slides completely off-screen (its own height plus the sticky area
      above it) and, like the header, only switches to visibility: hidden once the slide ends. On mobile
      this also lets the floating filters button take over (it appears whenever the toolbar is out of view).
      {%- endcomment -%}
      :root:has(.shopify-section--header .header.is-hidden) #shopify-section-{{ section.id }} .collection__toolbar {
        transform: translateY(calc(-100% - var(--sticky-area-height, 0px)));
        visibility: hidden;
      }

    {%- endif -%}
  {%- endif -%}

  {%- comment -%}
  Entirely skipped when the icon is off - the row is then just a transparent wrapper around the
  h1, which keeps behaving exactly like a bare h1 (centered by .prose-justify-center's inherited
  text-align, nothing else involved).

  With the icon on: side by side, this is a 2-column grid - the heading's own column is always
  "auto" (sized to the heading alone), so icon_justify_self can move the icon around its "1fr"
  column without ever resizing or shifting the heading's column. Stacked, it's a flex column
  instead, whose per-item align-self (set on the icon element itself, not here) does the same job
  without touching the heading's own position either.
  {%- endcomment -%}
  {%- if section.settings.show_icon -%}
    #shopify-section-{{ section.id }} .search-heading-row {
      display: {{ icon_display }};
      {%- if icon_display == 'grid' -%}
        grid-template-columns: {{ icon_grid_template_columns }};
        grid-template-areas: {{ icon_grid_template_areas }};
        align-items: center;
      {%- else -%}
        flex-direction: {{ icon_flex_direction }};
        align-items: flex-start;
      {%- endif -%}
      gap: .5rem;
    }

    {%- comment -%}
    Trims the heading's box down to its actual glyphs (cap height to baseline), removing the
    invisible leading space a line box normally carries above/below the text - without it, that
    space pads out the row's own height and throws off align-items: center, which centers boxes,
    not visible pixels.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .search-heading-row__heading {
      grid-area: heading;
      text-box: trim-both cap alphabetic;
    }

    #shopify-section-{{ section.id }} .search-heading-row__icon {
      grid-area: icon;
      {%- if icon_display == 'grid' -%}
        justify-self: {{ icon_justify_self }};
      {%- else -%}
        align-self: {{ icon_justify_self }};
      {%- endif -%}
    }
  {%- endif -%}
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_search %} section-floating section-floating--block-end{% endif %}"{% if section.settings.floating_search %} style="border-end-start-radius: {{ section.settings.search_border_radius }}px; border-end-end-radius: {{ section.settings.search_border_radius }}px; overflow: hidden;"{% endif %}>
  {%- if search.performed == false or search.performed and search.results_count == 0 and has_active_filters == false -%}
    <div class="container">
      <div class="empty-state">
        <div class="prose prose-justify-center">
          {%- if section.settings.search_heading != blank or section.settings.show_icon -%}
            <div class="search-heading-row">
              {%- if section.settings.search_heading != blank -%}
                <h1 class="search-heading-row__heading {{ section.settings.search_heading_size }}">{{ section.settings.search_heading }}</h1>
              {%- endif -%}

              {%- if section.settings.show_icon -%}
                <div class="search-heading-row__icon">
                  {%- render 'decorative-icon',
                    icon_type: section.settings.icon_type,
                    icon_size: section.settings.icon_size,
                    icon_spin: section.settings.icon_spin,
                    icon_primary_color: section.settings.icon_primary_color,
                    icon_secondary_color: section.settings.icon_secondary_color,
                    icon_border_color: section.settings.icon_border_color
                  -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if search.performed -%}
            <p>{{ 'search.general.no_results' | t: terms: search.terms }}</p>
          {%- endif -%}

          {%- comment -%}With a query that found nothing, only the message is shown (the header search and the search drawer are the way to try again); the field stays only when no search was made at all, so the page isn't left with nothing to do{%- endcomment -%}
          {%- unless search.performed -%}
          <form class="max-w-xs md:max-w-md" action="{{ routes.search_url }}" method="get" role="search">
            <label for="search-page-input-empty" class="sr-only">{{ 'search.general.search_placeholder' | t }}</label>
            <input id="search-page-input-empty" type="search" name="q" class="search-form__input input" placeholder="{{ 'search.general.search_placeholder' | t }}" autocomplete="off" autocorrect="off">
          </form>
          {%- endunless -%}
        </div>
      </div>
    </div>
  {%- else -%}
    {%- comment -%}
    Implementation note: contrary to the predictive search, main search results (products, blog posts and pages) are mingled together, which makes it
    hard to display them in a tabbed interface. If we detect that the search is for more than one type of resources, then we actually perform multiple
    Ajax requests to fetch the results for each type of resources. This is not ideal, but it's the best we can do with the current limitations of the
    search
    {%- endcomment -%}

    <div id="collection" class="collection">
      {%- capture search_toolbar_tabs -%}
        {%- if search.types.size > 0 -%}
          <x-tabs class="collection__resource-tab-list">
            <template shadowrootmode="open">
              <slot part="tablist" role="tablist" name="tab"></slot>
            </template>

            {%- comment -%}We reverse to ensure that "products" is the first tab{%- endcomment -%}

            {%- for search_type in search.types reversed -%}
              {%- comment -%}With several result types each tab starts hidden and is revealed once its results have loaded (theme.js, SearchResultPanel), so a type with no results never flashes its tab before being removed{%- endcomment -%}
              <button slot="tab" class="link-reversed subheading" {% if search.types.size > 1 %}hidden{% endif %} aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="main-search-results-{{ search_type }}">
                {%- assign translation_key = 'search.general.' | append: search_type | append: 's' -%}
                {{- translation_key | t }}<span data-search-tab-count>{% if search.types.size == 1 %} ({{ search.results_count }}){% endif %}</span>
              </button>
            {%- endfor -%}
          </x-tabs>
        {%- endif -%}
      {%- endcapture -%}

      {%- comment -%}Same toolbar as the collection page (snippets/collection-toolbar.liquid): the result-type tabs, each with its results count, on the left, filter and sort on the right{%- endcomment -%}
      {%- comment -%}Filter/sort only make sense for products, and only when there is something to filter or sort by{%- endcomment -%}
      {%- assign search_toolbar_hide_faceting = true -%}
      {%- if search.types contains 'product' and search.filters.size > 0 or search.types contains 'product' and search.sort_options.size > 1 -%}
        {%- assign search_toolbar_hide_faceting = false -%}
      {%- endif -%}

      {%- render 'collection-toolbar', data_source: search, filter_layout: 'drawer', leading_content: search_toolbar_tabs, hide_faceting: search_toolbar_hide_faceting -%}

      {%- comment -%}The toolbar goes first so it sits right under the header (and sticks to it){%- endcomment -%}
      {%- comment -%}
      On the results view the heading (when one is set) is all that remains above the results: the result count lives
      in the toolbar's tabs, and the "keep searching" field is gone (the header search and the search drawer do that job).
      {%- endcomment -%}
      {%- if section.settings.search_heading != blank or section.settings.show_icon -%}
        <div class="container section-spacing section-spacing--tight">
          <div class="prose prose-justify-center">
            <div class="search-heading-row">
              {%- if section.settings.search_heading != blank -%}
                <h1 class="search-heading-row__heading {{ section.settings.search_heading_size }}">{{ section.settings.search_heading }}</h1>
              {%- endif -%}

              {%- if section.settings.show_icon -%}
                <div class="search-heading-row__icon">
                  {%- render 'decorative-icon',
                    icon_type: section.settings.icon_type,
                    icon_size: section.settings.icon_size,
                    icon_spin: section.settings.icon_spin,
                    icon_primary_color: section.settings.icon_primary_color,
                    icon_secondary_color: section.settings.icon_secondary_color,
                    icon_border_color: section.settings.icon_border_color
                  -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    
      {%- comment -%}If there is only one type of resources and that those are products, then we can show the results directly{%- endcomment -%}
        
      {%- if search.types.size == 1 -%}
        <search-result-panel id="main-search-results-{{ search.types.first | escape }}" data-results-count="{{ search.results_count }}">
          {%- case search.types.first -%}
            {%- when 'product' -%}
              <div class="collection__inner">
                {%- paginate search.results by section.settings.products_per_page -%}
                  {%- if search.results_count == 0 -%}
                    <div class="empty-state empty-state--sm">
                      <div class="prose prose-justify-center prose--compact">
                        <p>{{ 'collection.faceting.no_results' | t }}</p>
        
                        {%- assign button_content = 'collection.faceting.clear_filters' | t -%}
                        {%- assign search_url = routes.search_url | append: '?q=' | append: search.terms | append: '#collection' -%}
                        {%- render 'button', href: search_url, is: 'facet-link', content: button_content -%}
                      </div>
                    </div>
                  {%- else -%}
                    <div class="collection__results" style="--product-card-border-radius: {{ section.settings.product_card_border_radius }}px;">
                      {%- render 'active-facets', source: search, hash: '#collection' -%}
                      {%- render 'product-list', products: search.results, allow_highlight: false -%}
                    </div>
        
                    {%- render 'pagination', paginate: paginate, facet: true, hash: '#collection' -%}
                  {%- endif -%}
                {%- endpaginate -%}
        
                {%- render 'collection-facets-floating-button', data_source: search -%}
              </div>

            {%- when 'article' -%}
              {%- paginate search.results by 50 -%}
                <div class="container container--narrow">
                  <blog-post-list class="blog-post-list">
                    {%- for article in search.results -%}
                      {%- render 'blog-post-card', 
                        article: article, 
                        heading_size: 'h5',
                        show_category: section.settings.show_category,
                        show_date: section.settings.show_date,
                        show_reading_time: false,
                        show_excerpt: section.settings.show_excerpt,
                        position: forloop.index
                      -%}
                    {%- endfor -%}
                  </blog-post-list>
                </div>
              {%- endpaginate -%}

            {%- when 'page' -%}
              {%- paginate search.results by 50 -%}
                <div class="container container--narrow">
                  <div class="max-w-sm">
                    <ul class="unstyled-list divide-y border-t border-b">
                      {%- for page in search.results -%}
                        <li>
                          <a href="{{ page.url }}" class="predictive-search-link">
                            <span class="h7">{{- page.title -}}</span>
                            {%- render 'icon' with 'big-arrow-right', direction_aware: true -%}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>
              {%- endpaginate -%}
          {%- endcase -%}
        </search-result-panel>
      {%- else -%}
        {%- comment -%}Otherwise, we have to do different Ajax requests for each resource type{%- endcomment -%}
        {%- for type in search.types reversed -%}
          {%- assign search_url_for_type = routes.search_url | append: '?type=' | append: type | append: '&q=' | append: search.terms -%}

          <search-result-panel id="main-search-results-{{ type | escape }}" load-from-url="{{ search_url_for_type | escape }}" hidden>
          </search-result-panel>
        {%- endfor -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{%- comment -%}
-------------------------------------------------------------------------------------------------------------------------------
We render the collection drawer all the time if we show filters, as the drawer is at least always used on mobile (and optionally)
on desktop based on the settings
-------------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

{%- if section.settings.show_filters and search.filters.size > 0 -%}
  <facets-drawer class="drawer drawer--narrow drawer--facets color-scheme color-scheme--{{ settings.default_color_scheme.id }}" id="facets-drawer">
    <h2 class="h7" slot="header">{{ 'collection.faceting.filters' | t }}</h2>

    {%- render 'facets', 
      source: search,
      show_sort_by: section.settings.show_sort_by, 
      open_filters_by_default: section.settings.open_filters_by_default, 
      swatch_selector_size: section.settings.swatch_selector_size, 
      update_on_change: false,
      hash: '#collection',
      form_id: 'facets-drawer-form' 
    -%}

    <div slot="footer">
      <div class="button-group button-group--same-width w-full">
        {%- liquid
          assign reset_button = 'collection.faceting.clear_filters' | t
          render 'button', content: reset_button, style: 'outline', form: 'facets-drawer-form', type: 'reset'
        
          assign apply_button = 'collection.faceting.apply_filters' | t
          render 'button', content: apply_button, form: 'facets-drawer-form', type: 'submit'
        -%}
      </div>
    </div>
  </facets-drawer>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main_search.name",
  "class": "shopify-section--main-search",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "toolbar_color_scheme",
      "label": "Esquema de color de la barra de herramientas",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "floating_toolbar",
      "label": "Barra de herramientas flotante",
      "info": "Pega la barra de herramientas al encabezado (sin esquinas redondeadas arriba) y agrega margen abajo y a los lados, usando el espaciado entre secciones y el margen lateral global de la tienda.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sticky_toolbar",
      "label": "Barra de herramientas fija junto al encabezado",
      "info": "Se queda pegada debajo del encabezado al hacer scroll y se oculta y reaparece junto con él.",
      "default": false,
      "visible_if": "{{ section.settings.floating_toolbar }}"
    },
    {
      "type": "range",
      "id": "toolbar_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Radio de esquina",
      "default": 0,
      "visible_if": "{{ section.settings.floating_toolbar }}"
    },
    {
      "type": "checkbox",
      "id": "floating_search",
      "label": "t:sections.main_search.floating_search",
      "info": "t:sections.main_search.floating_search_info",
      "default": false
    },
    {
      "type": "range",
      "id": "search_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "t:sections.main_search.search_border_radius",
      "default": 0,
      "visible_if": "{{ section.settings.floating_search }}"
    },
    {
      "type": "range",
      "id": "product_card_border_radius",
      "min": 0,
      "max": 25,
      "step": 1,
      "unit": "px",
      "label": "Radio del borde de la tarjeta de producto",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:global.text.text"
    },
    {
      "type": "inline_richtext",
      "id": "search_heading",
      "label": "t:global.text.heading",
      "info": "t:sections.main_search.search_heading_info"
    },
    {
      "type": "select",
      "id": "search_heading_size",
      "label": "t:global.text.size",
      "options": [
        { "value": "display-xl", "label": "Display XL" },
        { "value": "display-l", "label": "Display L" },
        { "value": "display-m", "label": "Display M" },
        { "value": "h1", "label": "XX-Large" },
        { "value": "h2", "label": "X-Large" },
        { "value": "h3", "label": "Large" },
        { "value": "h4", "label": "Medium" },
        { "value": "h5", "label": "Small" },
        { "value": "h6", "label": "X-Small" },
        { "value": "h7", "label": "XX-Small" }
      ],
      "default": "h3"
    },
    {
      "type": "header",
      "content": "Decorative icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show spinning icon",
      "info": "A decorative icon shown next to the search heading.",
      "default": false
    },
    {
      "type": "select",
      "id": "icon_type",
      "label": "Icon",
      "options": [
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "lotus",
          "label": "Lotus"
        },
        {
          "value": "clover",
          "label": "Clover"
        },
        {
          "value": "smiley",
          "label": "Smiley face"
        },
        {
          "value": "cherries",
          "label": "Cherries"
        },
        {
          "value": "eight_ball",
          "label": "8-Ball"
        },
        {
          "value": "blob",
          "label": "Blob"
        },
        {
          "value": "badge",
          "label": "Badge"
        },
        {
          "value": "stamp",
          "label": "Stamp"
        },
        {
          "value": "swoosh",
          "label": "Swoosh"
        },
        {
          "value": "phone",
          "label": "Phone"
        }
      ],
      "default": "star",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 32,
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "checkbox",
      "id": "icon_spin",
      "label": "Spin icon",
      "default": true,
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "color",
      "id": "icon_primary_color",
      "label": "Primary color",
      "default": "#FF6B9D",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "color",
      "id": "icon_secondary_color",
      "label": "Secondary color",
      "default": "#FFD93D",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Border color",
      "info": "Leave blank for no border.",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Position",
      "options": [
        {
          "value": "right",
          "label": "Right of title"
        },
        {
          "value": "left",
          "label": "Left of title"
        },
        {
          "value": "above",
          "label": "Above title"
        },
        {
          "value": "below",
          "label": "Below title"
        }
      ],
      "default": "right",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "select",
      "id": "icon_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "header",
      "content": "t:sections.main_search.product_results_category"
    },
    {
      "type": "checkbox",
      "id": "show_sort_by",
      "label": "t:global.faceting.show_sort_by",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:global.faceting.products_per_page",
      "min": 8,
      "max": 50,
      "step": 1,
      "default": 24
    },
    {
      "type": "header",
      "content": "t:sections.main_search.product_filters_category"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "t:global.faceting.show_filters",
      "info": "t:global.faceting.show_filters_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filter_group_name",
      "label": "t:global.faceting.show_group_name",
      "info": "t:global.faceting.show_group_name_info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_filter_values_count",
      "label": "t:global.faceting.show_filter_values_count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_filters_by_default",
      "label": "t:global.faceting.open_filters_by_default",
      "default": false
    },
    {
      "type": "select",
      "id": "swatch_selector_size",
      "label": "t:global.faceting.swatch_selector_size",
      "options": [
        {
          "value": "sm",
          "label": "t:global.faceting.swatch_selector_size_options.small"
        },
        {
          "value": "lg",
          "label": "t:global.faceting.swatch_selector_size_options.large"
        }
      ],
      "default": "lg"
    },
    {
      "type": "header",
      "content": "t:sections.main_search.blog_post_results_category"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "t:global.blog.show_category",
      "info": "t:global.blog.show_category_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:global.blog.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:global.blog.show_excerpt",
      "default": true
    }
  ]
}
{% endschema %}
