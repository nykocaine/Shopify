{%- if section.settings.show_filters and collection.filters.size > 0 -%}
  {%- assign show_filters = true -%}
{%- else -%}
  {%- assign show_filters = false -%}
{%- endif -%}

{%- liquid
  # Height of a promo shown as a product card when no product card sits next to it to give the row its height: the
  # same ratio as the product card's image (see snippets/product-card.liquid), "natural" falls back to portrait.
  case settings.product_card_image_aspect_ratio
    when 'short', 'short_crop'
      assign promo_card_aspect_ratio = '4 / 3'
    when 'portrait', 'portrait_crop', 'natural'
      assign promo_card_aspect_ratio = '4 / 5'
    when 'tall', 'tall_crop'
      assign promo_card_aspect_ratio = '2 / 3'
    else
      assign promo_card_aspect_ratio = '1'
  endcase
-%}

<style>
  {%- if section.settings.floating_toolbar -%}
    {%- comment -%}
    Floating mode: same calc(var(--container-gutter) + 0.5rem) formula as sections/reviews.liquid and
    sections/faq.liquid on the sides; top and bottom use half of it (two fifths from 700px up), so the toolbar reads as a compact
    padded card instead of keeping its default, non-uniform padding values (theme.css).
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .collection__toolbar {
      padding-block: calc((var(--container-gutter) + 0.5rem) * 0.5);
      padding-inline: calc(var(--container-gutter) + 0.5rem);
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .collection__toolbar {
        padding-block: calc((var(--container-gutter) + 0.5rem) * 0.4);
      }
    }

    {%- comment -%}
    Spacing below the toolbar is the page's side margin (--container-gutter), so the gap between the toolbar and the product grid is the same size as the
    margins at the sides of the page; below the whole collection it is a full section spacing. Both are outer margin (not padding): the gap to the product grid
    sits between the toolbar and the grid, and the gap to the footer sits outside the section's colored background, so the theme editor doesn't select either.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .collection__toolbar {
      margin-block-end: var(--container-gutter);
    }

    #shopify-section-{{ section.id }} > .color-scheme {
      margin-block-end: var(--section-vertical-spacing);
    }

    #shopify-section-{{ section.id }} .collection {
      padding-block-end: 0;
    }

    {%- if section.settings.sticky_toolbar -%}
      {%- comment -%}
      Sticky toolbar glued to the header. It sticks at the header's fully visible position
      (--sticky-area-height) and, when the header hides on scroll, slides up by the header's height with
      the same transform + timing as the header's own slide (sections/header.liquid), so both move on
      the compositor in lockstep. It overlaps the header's last pixel (z-index below the header's) so
      sub-pixel rounding of the header's height can never leave a visible seam between them.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .collection__toolbar {
        position: sticky;
        top: calc(var(--sticky-area-height) - 1px);
        z-index: 2;
        margin-block-start: -1px;
        padding-block-start: calc((var(--container-gutter) + 0.5rem) * 0.75 + 1px);
        will-change: transform;
        transition: transform var(--header-solid-transition, .45s cubic-bezier(.4, 0, .2, 1)), visibility var(--header-solid-transition, .45s cubic-bezier(.4, 0, .2, 1));
      }

      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .collection__toolbar {
          padding-block-start: calc((var(--container-gutter) + 0.5rem) / 2 + 1px);
        }
      }

      {%- comment -%}
      Hides together with the header: triggered by the very same state as the header's own slide
      (.header.is-hidden, see sections/header.liquid), not by a custom property on :root, so both start in
      the same style recalculation. It slides completely off-screen (its own height plus the sticky area
      above it) and, like the header, only switches to visibility: hidden once the slide ends. On mobile
      this also lets the floating filters button take over (it appears whenever the toolbar is out of view).
      {%- endcomment -%}
      :root:has(.shopify-section--header .header.is-hidden) #shopify-section-{{ section.id }} .collection__toolbar {
        transform: translateY(calc(-100% - var(--sticky-area-height, 0px)));
        visibility: hidden;
      }

      {%- comment -%} The sidebar filters stick below the toolbar too (--collection-toolbar-height is set by the script at the end of the section). {%- endcomment -%}
      #shopify-section-{{ section.id }} .collection__sidebar {
        top: calc(var(--sticky-area-height) + var(--collection-toolbar-height, 0px) + 20px);
      }
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.floating_collection -%}
    {%- comment -%}
    Floating collection: the whole section becomes a rounded card that keeps only the page's side margins (theme.css
    .section-floating) and the usual spacing between sections above and below it, with no inner padding on any side: the products
    run to the card's edges and its bottom edge is the end of the grid / pagination. The toolbar keeps its own padding (it is the bar's content inset).
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .collection__results {
      padding-inline: 0;
    }

    #shopify-section-{{ section.id }} .collection {
      padding-block: 0;
    }

    #shopify-section-{{ section.id }} .container {
      margin-inline: 0;
      padding-inline: 0;
    }

    {%- comment -%} Outer spacing: a full section spacing below the card (the gap above it is the one the section above leaves). {%- endcomment -%}
    #shopify-section-{{ section.id }} > .color-scheme {
      margin-block-end: var(--section-vertical-spacing);
    }

    {%- comment -%}
    With the collection banner hidden (its "keep for SEO" setting), this card is the first thing under the header: it joins the header with square
    top corners, like the banner did, instead of rounded corners against it.
    {%- endcomment -%}
    .shopify-section--collection-banner:has(> .collection-banner--seo-only) + #shopify-section-{{ section.id }} > .color-scheme {
      border-start-start-radius: 0 !important;
      border-start-end-radius: 0 !important;
    }

    {%- comment -%}
    A floating toolbar inside the floating card must not add its own side margin (it would be indented twice) nor round its
    corners (the card already does).
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .collection__toolbar.section-floating {
      margin-inline: 0;
      border-radius: 0 !important;
    }
  {%- endif -%}

  {%- if settings.show_page_transition -%}
    {%- comment -%}
    Page transition between collections (the quick links): the theme's page transition (css-variables.liquid, @view-transition) cross-fades
    the WHOLE page, so the announcement bar, the header, the banner and the toolbar - the same on both pages - faded out and back in, and the
    new page was captured before its product photos had loaded: everything blinked. Naming these parts makes the browser keep each one in
    place as its own layer (same size and position on both pages, so nothing moves and only what really changes, like the title or the
    current link, swaps), and only the products below cross-fade. The names exist only on collection pages, so other pages keep the usual fade.
    {%- endcomment -%}
    .shopify-section--announcement-bar {
      view-transition-name: collection-announcement-bar;
    }

    .shopify-section--header {
      view-transition-name: collection-header;
    }

    .shopify-section--collection-banner {
      view-transition-name: collection-banner;
    }

    #shopify-section-{{ section.id }} .collection__toolbar {
      view-transition-name: collection-toolbar;
    }

    {%- comment -%} The bar and the header are identical on both pages: the new one is shown at once, with no fade at all. {%- endcomment -%}
    ::view-transition-old(collection-announcement-bar),
    ::view-transition-old(collection-header) {
      display: none;
    }

    ::view-transition-new(collection-announcement-bar),
    ::view-transition-new(collection-header) {
      animation: none;
    }

    ::view-transition-group(collection-announcement-bar),
    ::view-transition-group(collection-header),
    ::view-transition-group(collection-banner),
    ::view-transition-group(collection-toolbar) {
      z-index: 1;
    }
  {%- endif -%}

  {%- comment -%}
  Toolbar (snippets/collection-toolbar.liquid), same layout on every screen size, in two rows:
  1. the quick links as pills (outlined; the current page filled). Phones: one row that scrolls sideways from edge to edge of the bar.
     Tablet and desktop: centered, wrapping onto a second line if the menu is long.
  2. the sort ("Sort: Newest first", the current sort underlined) on the left; the products count and the view selector on the right.
  It is a grid, not a wrapping flex row, so the second row never breaks: the sort takes the room left (and is cut with "…" when a long sort name
  does not fit), the count and the view selector keep their own width. The controls' wrapper (.vertically-separated-list) is "display: contents",
  so its items are placed on the grid directly: whatever is shown, the sort (or filters) sits in the first column, the count in the second, the
  view selector in the last, and the rest ends flush with the right edge. "dense" lets the sort, which comes last in the page, go back to the
  start of the second row.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .collection__toolbar {
    --collection-toolbar-padding-inline: {% if section.settings.floating_toolbar or section.settings.floating_collection %}calc(var(--container-gutter) + 0.5rem){% else %}var(--container-gutter){% endif %};
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-auto-flow: row dense;
    align-items: center;
    column-gap: 0.875rem;
    row-gap: 1.25rem;
    display: grid;
  }

  #shopify-section-{{ section.id }} .collection__toolbar:not(:has(.collection__layout-selector)) {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  #shopify-section-{{ section.id }} .collection__toolbar > .vertically-separated-list {
    display: contents;
  }

  #shopify-section-{{ section.id }} .collection__toolbar .vertically-separated-list > hr {
    display: none;
  }

  #shopify-section-{{ section.id }} .collection__toolbar > :not(.collection__toolbar-links, .collection__toolbar-count, .vertically-separated-list),
  #shopify-section-{{ section.id }} .collection__toolbar .vertically-separated-list > :not(.h-stack, hr) {
    grid-column: 1;
    justify-self: start;
  }

  #shopify-section-{{ section.id }} .collection__toolbar-count {
    grid-column: 2;
    justify-self: end;
    white-space: nowrap;
    opacity: 0.8;
  }

  #shopify-section-{{ section.id }} .collection__toolbar .vertically-separated-list > .h-stack {
    grid-column: -2;
    gap: 0.625rem;
  }

  {%- comment -%}The "Filter (34)" button already shows the products count: no second count next to it.{%- endcomment -%}
  #shopify-section-{{ section.id }} .collection__toolbar:has(> button[aria-controls="facets-drawer"]) .collection__toolbar-count {
    display: none;
  }

  #shopify-section-{{ section.id }} .collection__toolbar :has(> button > .collection__sort-current),
  #shopify-section-{{ section.id }} .collection__toolbar button:has(> .collection__sort-current) {
    min-width: 0;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .collection__sort-current {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  #shopify-section-{{ section.id }} .collection__toolbar-links {
    grid-column: 1 / -1;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .collection__toolbar-links-list {
    align-items: center;
    gap: 0.625rem;
    white-space: nowrap;
    display: flex;
  }

  {%- comment -%}
  Colors from the toolbar color scheme's button colors: the links are outline buttons in the button background color, the current page
  a solid button (button background + button text color), like the theme's buttons (assets/theme.css .button).
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .collection__toolbar-links a {
    flex: none;
    color: rgb(var(--button-background-primary));
    text-decoration: none;
    {%- comment -%} Uppercase capitals need a little more than --cap-offset to sit exactly in the middle (measured with Swiss 721: 1.2x). {%- endcomment -%}
    padding: calc(0.55rem + var(--cap-offset, 0em) * 1.2) 1.15rem calc(0.55rem - var(--cap-offset, 0em) * 1.2);
    border: 1px solid rgb(var(--button-background-primary) / 0.7);
    border-radius: 999px;
    text-transform: uppercase;
    line-height: 1.2;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .collection__toolbar-links a:hover {
    border-color: rgb(var(--button-background-primary));
  }

  #shopify-section-{{ section.id }} .collection__toolbar-links a[aria-current="page"] {
    background: rgb(var(--button-background-primary));
    border-color: rgb(var(--button-background-primary));
    color: rgb(var(--button-text-primary));
  }

  {%- comment -%}View selector: rounded squares (snippets/icon.liquid), the one not in use in solid light gray{%- endcomment -%}
  #shopify-section-{{ section.id }} .collection__layout-selector svg {
    width: auto;
    height: 1.125rem;
  }

  #shopify-section-{{ section.id }} .collection__layout-selector label {
    opacity: 0.4;
  }

  #shopify-section-{{ section.id }} .collection__layout-selector :checked + label {
    opacity: 1;
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .collection__toolbar {
      --collection-toolbar-padding-inline: var(--container-gutter);
      padding-inline: var(--collection-toolbar-padding-inline);
    }

    #shopify-section-{{ section.id }} .collection__toolbar-links {
      width: calc(100% + 2 * var(--collection-toolbar-padding-inline));
      margin-inline: calc(-1 * var(--collection-toolbar-padding-inline));
    }

    #shopify-section-{{ section.id }} .collection__toolbar-links-list {
      padding-inline: var(--collection-toolbar-padding-inline);
      scroll-padding-inline: var(--collection-toolbar-padding-inline);
      scrollbar-width: none;
      overflow-x: auto;
    }

    #shopify-section-{{ section.id }} .collection__toolbar-links-list::-webkit-scrollbar {
      display: none;
    }

    {%- comment -%}
    Centered when the links fit on the screen; when they don't, the auto margins collapse to 0 and the row scrolls from its start as before
    (justify-content: center would cut off the first links in a scrolling row).
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .collection__toolbar-links a:first-child {
      margin-inline-start: auto;
    }

    #shopify-section-{{ section.id }} .collection__toolbar-links a:last-child {
      margin-inline-end: auto;
    }

    #shopify-section-{{ section.id }} .collection__layout-selector svg {
      height: 1.25rem;
    }

    {%- comment -%}
    Small phones (under 380px, eg. iPhone SE): the products count would squeeze the sort down to a letter or two, so it is left out and the sort
    keeps its full name.
    {%- endcomment -%}
    @media screen and (max-width: 379px) {
      #shopify-section-{{ section.id }} .collection__toolbar:has(.collection__sort-current) .collection__toolbar-count {
        display: none;
      }
    }
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .collection__toolbar-links-list {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem 0.875rem;
    }
  }

  #shopify-section-{{ section.id }} .product-list .product-list__promo {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .product-list .product-list__promo > * {
    flex-grow: 1;
  }

  #shopify-section-{{ section.id }} {
    --product-list-column-count: {{ section.settings.products_per_row_mobile | plus: 0 | at_most: 2 }};
  }

  {%- comment -%}
  The horizontal gap between cards is no longer set here: every product list reads it from --product-list-column-gap (css-variables.liquid), which is the shared --horizontal-gap
  (snippets/css-variables.liquid), the single place that defines it. Only the vertical gap is set here: .625rem as the base, 1rem on phones, and the same as the horizontal gap from 700px.
  Set directly on .product-list with !important because a .product-list--carousel variant reassigns the whole `grid`
  shorthand, which can drop a plain override.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .product-list {
    row-gap: 0.625rem !important;
  }

  {%- comment -%}Phones only: the stacked rows of cards sit 1rem apart, the same as the cards side by side (css-variables.liquid).{%- endcomment -%}
  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .product-list {
      row-gap: 1rem !important;
    }
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      --product-list-column-count: {{ section.settings.products_per_row_desktop | at_most: 3 }};
    }

    {%- comment -%}Tablet and desktop: the gap between rows is the same as the gap between the columns (the shared --horizontal-gap), instead of the tighter .625rem{%- endcomment -%}
    #shopify-section-{{ section.id }} .product-list {
      row-gap: var(--product-list-column-gap) !important;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      --product-list-column-count: {{ section.settings.products_per_row_desktop | at_most: 4 }};
    }
  }

  @media screen and (min-width: 1150px) {
    #shopify-section-{{ section.id }} {
      --product-list-column-count: {{ section.settings.products_per_row_desktop }};
    }
  }

  {%- comment -%}
  "Mobile as product card" (image and video block setting): on mobile only, the image promo leaves its own
  full-width row and becomes a single item inside the product grid. It keeps the grid's column width,
  gap and — through the theme's existing subgrid (`--product-card-row-count`) — the exact row span /
  height of a product card, so no arbitrary width/height is set. Desktop is untouched: every rule below
  lives inside the theme's `max-width: 699px` breakpoint.
  {%- endcomment -%}
  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card {
      grid-column: span 1;
      {%- comment -%}
      Its own height when the card has no product card beside it (eg. an image and a video blocks in the same row, which
      otherwise collapsed to almost nothing because the media is absolutely positioned and adds no height). Next to a
      product card the row is taller than this, and the promo just stretches to the row as before.
      {%- endcomment -%}
      aspect-ratio: {{ promo_card_aspect_ratio }};
      {%- comment -%} Match the product cards' radius rather than the block's own. {%- endcomment -%}
      border-radius: var(--product-card-border-radius, 0) !important;
    }

    {%- comment -%} Neutralise the full-width promo's negative-margin row hack (theme.css). {%- endcomment -%}
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card,
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card:not(:last-child) {
      margin-block-end: 0;
    }

    {%- comment -%}
    Let the media fill the card surface (the theme already does this for `min-h-full` content boxes;
    only the mobile promo rule forces it back to `relative`). This removes the empty space below the
    image and makes its height follow the card, not its own aspect ratio.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card .content-box__background-media {
      position: absolute !important;
      inset: 0;
    }

    #shopify-section-{{ section.id }} .product-list__promo--mobile-card .content-box__background-media picture,
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card .content-box__background-media img,
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card .content-box__background-media video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    {%- comment -%}
    A video is wrapped in <video-media>, which sizes itself from the video's own aspect ratio (theme.css). In a card the
    height comes from the grid row instead, so the ratio is dropped and the wrapper (and the video inside it) simply
    fills the card, cropped with object-fit: cover, exactly like an image does. Its corners follow the card's radius.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card .content-box__background-media video-media {
      aspect-ratio: auto;
      width: 100%;
      height: 100%;
      border-radius: inherit;
    }

    {%- comment -%}
    Containment, so a card-sized promo can never be wider than its grid cell or overflow it: the cell stretches over its
    full column (an aspect-ratio makes grid items stop stretching by default, so the width would otherwise come from the
    content), nothing inside may grow it past that (min-width: 0), and the text is fitted to a half-width card: tighter
    padding, wrapping, a capped heading size and a full-width button.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card {
      justify-self: stretch;
      align-self: stretch;
      width: 100%;
      /* Explicit full height of the grid area (the figure row plus the info row): Safari treats the default alignment of a
         grid item that has an aspect-ratio as "start" and would leave it at the ratio's height, only as tall as the photo. */
      height: 100%;
      min-width: 0;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .product-list__promo--mobile-card .content-box,
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card .content-box__background-media {
      min-width: 0;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .product-list__promo--mobile-card .content-box {
      --content-box-spacing: .875rem;
    }

    #shopify-section-{{ section.id }} .product-list__promo--mobile-card .prose,
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card .prose > * {
      min-width: 0;
      max-width: 100%;
      overflow-wrap: anywhere;
    }

    #shopify-section-{{ section.id }} .product-list__promo--mobile-card :is(h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6, .display-m, .display-l, .display-xl) {
      font-size: clamp(1rem, 5.5vw, 1.375rem);
      line-height: 1.15;
    }

    #shopify-section-{{ section.id }} .product-list__promo--mobile-card .button {
      max-width: 100%;
      width: 100%;
      padding-inline: .5rem;
    }
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_collection %} section-floating section-floating--block-end{% endif %}"{% if section.settings.floating_collection %} style="border-radius: {{ section.settings.collection_border_radius }}px; overflow: clip;"{% endif %}>
  {%- if collection.all_products_count == 0 -%}
    <div class="container">
      <div class="empty-state">
        <div class="prose prose-justify-center">
          <p class="h3">{{ 'collection.general.empty_collection' | t }}</p>

          {%- assign button_content = 'collection.general.continue_shopping' | t -%}
          {%- render 'button', href: routes.all_products_collection_url, size: 'xl', content: button_content -%}
        </div>
      </div>
    </div>
  {%- else -%}
    <div id="collection" class="collection">
      {%- render 'collection-toolbar' -%}

      <div class="collection__inner">
        {%- paginate collection.products by section.settings.products_per_page -%}
          {%- if show_filters and section.settings.filter_layout == 'sidebar' -%}
            <safe-sticky class="collection__sidebar">
              {%- comment -%}On desktop the sort by is shown on the right rather than the sidebar{%- endcomment -%}
              <p class="subheading">{{ 'collection.faceting.filters' | t }}</p>

              {%- render 'facets', source: collection, show_sort_by: false, open_filters_by_default: section.settings.open_filters_by_default, update_on_change: true, form_id: 'facets-sidebar-form', hash: '#collection' -%}
            </safe-sticky>
          {%- endif -%}

          {%- if collection.products_count == 0 -%}
            <div class="empty-state empty-state--sm">
              <div class="prose prose-justify-center prose--compact">
                <p>{{ 'collection.faceting.no_results' | t }}</p>

                {%- assign button_content = 'collection.faceting.clear_filters' | t -%}
                {%- assign button_link = collection.url | append: '#collection' -%}
                {%- render 'button', href: button_link, is: 'facet-link', content: button_content -%}
              </div>
            </div>
          {%- else -%}
             <div class="collection__results" style="--product-card-border-radius: {{ section.settings.product_card_border_radius }}px;">
               {%- render 'active-facets', source: collection, hash: "#collection" -%}
               {%- render 'product-list', products: collection.products, allow_highlight: true, paginate: paginate, blocks: section.blocks, output_override_attributes: true -%}
             </div>

            {%- render 'pagination', paginate: paginate, facet: true, hash: '#collection' -%}
          {%- endif -%}
        {%- endpaginate -%}

        {%- if show_filters or section.settings.show_sort_by -%}
          {%- render 'collection-facets-floating-button', data_source: collection -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{%- comment -%}
-------------------------------------------------------------------------------------------------------------------------------
We render the collection drawer all the time if we show filters, as the drawer is at least always used on mobile (and optionally)
on desktop based on the settings
-------------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

{%- if show_filters -%}
  <facets-drawer class="drawer drawer--narrow drawer--facets color-scheme color-scheme--{{ settings.default_color_scheme.id }}" id="facets-drawer">
    <h2 class="h7" slot="header">{{ 'collection.faceting.filters' | t }}</h2>

    {%- render 'facets', 
      source: collection, 
      show_sort_by: section.settings.show_sort_by, 
      open_filters_by_default: section.settings.open_filters_by_default, 
      swatch_selector_size: section.settings.swatch_selector_size, 
      update_on_change: false,
      form_id: 'facets-drawer-form',
      hash: '#collection'
    -%}

    <div slot="footer">
      <div class="button-group button-group--same-width w-full">
        {%- liquid
          assign reset_button = 'collection.faceting.clear_filters' | t
          render 'button', content: reset_button, style: 'outline', form: 'facets-drawer-form', type: 'reset'
        
          assign apply_button = 'collection.faceting.apply_filters' | t
          render 'button', content: apply_button, form: 'facets-drawer-form', type: 'submit'
        -%}
      </div>
    </div>
  </facets-drawer>
{%- endif -%}

{%- if section.settings.floating_toolbar and section.settings.sticky_toolbar -%}
  <script>
    (() => {
      const section = document.getElementById('shopify-section-{{ section.id }}');
      const toolbar = section && section.querySelector('.collection__toolbar');
      if (!toolbar || !window.ResizeObserver) return;
      new ResizeObserver(() => section.style.setProperty('--collection-toolbar-height', `${toolbar.offsetHeight}px`)).observe(toolbar);
    })();
  </script>
{%- endif -%}

