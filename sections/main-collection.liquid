{%- if section.settings.show_filters and collection.filters.size > 0 -%}
  {%- assign show_filters = true -%}
{%- else -%}
  {%- assign show_filters = false -%}
{%- endif -%}

<style>
  .product-list .product-list__promo {
    display: flex;
    flex-direction: column;
  }

  .product-list .product-list__promo > * {
    flex-grow: 1;
  }

  #shopify-section-{{ section.id }} {
    --product-list-column-count: {{ section.settings.products_per_row_mobile | times: 1 }};
  }

  {%- comment -%}
  Fixed (not viewport-scaled, not theme-wide "Product listing spacing") gap between cards, matching
  sections/featured-product-list.liquid's gap so collection grids and featured product lists look
  consistent. Set directly on .product-list (not just the --product-list-column-gap variable it reads
  from) and !important, for the same reason as featured-product-list.liquid: any current or future
  .product-list--carousel variant reassigns the whole `grid` shorthand, which can silently drop a
  plain column-gap override.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .product-list {
    --product-list-column-gap: 0.625rem;
    column-gap: 0.625rem !important;
    row-gap: 0.625rem !important;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      --product-list-column-count: {{ section.settings.products_per_row_desktop | at_most: 3 }};
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      --product-list-column-count: {{ section.settings.products_per_row_desktop | at_most: 4 }};
    }
  }

  @media screen and (min-width: 1150px) {
    #shopify-section-{{ section.id }} {
      --product-list-column-count: {{ section.settings.products_per_row_desktop }};
    }
  }

  {%- comment -%}
  "Mobile image as product card" (image block setting): on mobile only, the image promo leaves its own
  full-width row and becomes a single item inside the product grid. It keeps the grid's column width,
  gap and — through the theme's existing subgrid (`--product-card-row-count`) — the exact row span /
  height of a product card, so no arbitrary width/height is set. Desktop is untouched: every rule below
  lives inside the theme's `max-width: 699px` breakpoint.
  {%- endcomment -%}
  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card {
      grid-column: span 1;
      {%- comment -%} Match the product cards' radius rather than the block's own. {%- endcomment -%}
      border-radius: var(--product-card-border-radius, 0) !important;
    }

    {%- comment -%} Neutralise the full-width promo's negative-margin row hack (theme.css). {%- endcomment -%}
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card,
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card:not(:last-child) {
      margin-block-end: 0;
    }

    {%- comment -%}
    Let the media fill the card surface (the theme already does this for `min-h-full` content boxes;
    only the mobile promo rule forces it back to `relative`). This removes the empty space below the
    image and makes its height follow the card, not its own aspect ratio.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card .content-box__background-media {
      position: absolute !important;
      inset: 0;
    }

    #shopify-section-{{ section.id }} .product-list__promo--mobile-card .content-box__background-media picture,
    #shopify-section-{{ section.id }} .product-list__promo--mobile-card .content-box__background-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  {%- if collection.all_products_count == 0 -%}
    <div class="container">
      <div class="empty-state">
        <div class="prose prose-justify-center">
          <p class="h3">{{ 'collection.general.empty_collection' | t }}</p>

          {%- assign button_content = 'collection.general.continue_shopping' | t -%}
          {%- render 'button', href: routes.all_products_collection_url, size: 'xl', content: button_content -%}
        </div>
      </div>
    </div>
  {%- else -%}
    <div id="collection" class="collection">
      {%- render 'collection-toolbar' -%}

      <div class="collection__inner">
        {%- paginate collection.products by section.settings.products_per_page -%}
          {%- if show_filters and section.settings.filter_layout == 'sidebar' -%}
            <safe-sticky class="collection__sidebar">
              {%- comment -%}On desktop the sort by is shown on the right rather than the sidebar{%- endcomment -%}
              <p class="subheading">{{ 'collection.faceting.filters' | t }}</p>

              {%- render 'facets', source: collection, show_sort_by: false, open_filters_by_default: section.settings.open_filters_by_default, update_on_change: true, form_id: 'facets-sidebar-form', hash: '#collection' -%}
            </safe-sticky>
          {%- endif -%}

          {%- if collection.products_count == 0 -%}
            <div class="empty-state empty-state--sm">
              <div class="prose prose-justify-center prose--compact">
                <p>{{ 'collection.faceting.no_results' | t }}</p>

                {%- assign button_content = 'collection.faceting.clear_filters' | t -%}
                {%- assign button_link = collection.url | append: '#collection' -%}
                {%- render 'button', href: button_link, is: 'facet-link', content: button_content -%}
              </div>
            </div>
          {%- else -%}
             <div class="collection__results" style="--product-card-border-radius: {{ section.settings.product_card_border_radius }}px;">
               {%- render 'active-facets', source: collection, hash: "#collection" -%}
               {%- render 'product-list', products: collection.products, allow_highlight: true, paginate: paginate, blocks: section.blocks, output_override_attributes: true -%}
             </div>

            {%- render 'pagination', paginate: paginate, facet: true, hash: '#collection' -%}
          {%- endif -%}
        {%- endpaginate -%}

        {%- if show_filters or section.settings.show_sort_by -%}
          {%- render 'collection-facets-floating-button', data_source: collection -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{%- comment -%}
-------------------------------------------------------------------------------------------------------------------------------
We render the collection drawer all the time if we show filters, as the drawer is at least always used on mobile (and optionally)
on desktop based on the settings
-------------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

{%- if show_filters -%}
  <facets-drawer class="drawer drawer--narrow drawer--facets color-scheme color-scheme--{{ settings.default_color_scheme.id }}" id="facets-drawer">
    <h2 class="h7" slot="header">{{ 'collection.faceting.filters' | t }}</h2>

    {%- render 'facets', 
      source: collection, 
      show_sort_by: section.settings.show_sort_by, 
      open_filters_by_default: section.settings.open_filters_by_default, 
      swatch_selector_size: section.settings.swatch_selector_size, 
      update_on_change: false,
      form_id: 'facets-drawer-form',
      hash: '#collection'
    -%}

    <div slot="footer">
      <div class="button-group button-group--same-width w-full">
        {%- liquid
          assign reset_button = 'collection.faceting.clear_filters' | t
          render 'button', content: reset_button, style: 'outline', form: 'facets-drawer-form', type: 'reset'
        
          assign apply_button = 'collection.faceting.apply_filters' | t
          render 'button', content: apply_button, form: 'facets-drawer-form', type: 'submit'
        -%}
      </div>
    </div>
  </facets-drawer>
{%- endif -%}

