<style>
  #shopify-section-{{ section.id }} .content-box {
    min-height: {{ section.settings.mobile_height }}svh;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .content-box {
      min-height: {{ section.settings.desktop_height }}svh;
    }
  }

  #shopify-section-{{ section.id }} .empty-state {
    padding-block: var(--container-gutter);
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_not_found %} section-floating section-floating--block-end{% endif %}"{% if section.settings.floating_not_found %} style="border-end-start-radius: {{ section.settings.not_found_border_radius }}px; border-end-end-radius: {{ section.settings.not_found_border_radius }}px; overflow: hidden;"{% endif %}>
  <div class="content-box">
    <div class="empty-state">
      {%- if section.settings.heading != blank -%}
        <h1 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h1>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_not_found.name",
  "class": "shopify-section--404",
  "tag": "section",
  "settings" : [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "floating_not_found",
      "label": "t:sections.main_not_found.floating_not_found",
      "info": "t:sections.main_not_found.floating_not_found_info",
      "default": false
    },
    {
      "type": "range",
      "id": "not_found_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "t:sections.main_not_found.not_found_border_radius",
      "default": 0,
      "visible_if": "{{ section.settings.floating_not_found }}"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "t:sections.main_not_found.mobile_height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "t:sections.main_not_found.desktop_height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "t:global.text.text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:global.text.heading",
      "default": "Page not found"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:global.text.size",
      "options": [
        { "value": "display-xl", "label": "Display XL" },
        { "value": "display-l", "label": "Display L" },
        { "value": "display-m", "label": "Display M" },
        { "value": "h1", "label": "XX-Large" },
        { "value": "h2", "label": "X-Large" },
        { "value": "h3", "label": "Large" },
        { "value": "h4", "label": "Medium" },
        { "value": "h5", "label": "Small" },
        { "value": "h6", "label": "X-Small" },
        { "value": "h7", "label": "XX-Small" }
      ],
      "default": "h3"
    }
  ]
}
{% endschema %}
