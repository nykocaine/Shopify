{%- liquid
  # icon_alignment only ever moves the icon, never the heading. icon_justify_self is the icon's own
  # justify-self (side-by-side layouts, a grid) or align-self (stacked layouts, a flex column) -
  # both accept the same start/center/end keywords, so one variable covers either case.
  assign icon_justify_self = 'center'

  case section.settings.icon_alignment
    when 'left'
      assign icon_justify_self = 'start'
    when 'right'
      assign icon_justify_self = 'end'
  endcase

  # icon_position picks which side of the title the icon sits on. Side by side (left/right), this
  # is a 2-column grid with one named area per element - the heading's area/column is always "auto"
  # (its own content width) and the icon's is always "1fr" (the rest of the row, for it to roam
  # across via icon_justify_self above), regardless of which column each lands in, since grid-area
  # ties each element to its column by name rather than by source order. Stacked (above/below) is a
  # plain flex column instead - its cross-axis alignment (align-items/align-self) is already
  # per-item independent of source order, so no grid trick is needed there.
  assign icon_display = 'grid'
  assign icon_grid_template_columns = 'auto 1fr'
  assign icon_grid_template_areas = '"heading icon"'
  assign icon_flex_direction = 'column'

  case section.settings.icon_position
    when 'left'
      assign icon_grid_template_columns = '1fr auto'
      assign icon_grid_template_areas = '"icon heading"'
    when 'above'
      assign icon_display = 'flex'
      assign icon_flex_direction = 'column-reverse'
    when 'below'
      assign icon_display = 'flex'
      assign icon_flex_direction = 'column'
  endcase
-%}

<style>
  #shopify-section-{{ section.id }} .content-box {
    min-height: {{ section.settings.mobile_height }}svh;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .content-box {
      min-height: {{ section.settings.desktop_height }}svh;
    }
  }

  {%- comment -%}
  .empty-state centers its items on the cross axis via place-items: center (theme.css), but with
  the heading + button now stacked as two rows (via .v-stack, added for the button), the block axis
  is governed by align-content instead - and .v-stack sets that to "start", pinning both rows to the
  top of this tall section instead of centering them as a group. Overriding it back to "center" here
  is what actually centers the content vertically.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .empty-state {
    padding-block: calc(var(--container-gutter) + 0.5rem);
    align-content: center;
  }

  {%- comment -%}
  Entirely skipped when the icon is off - the row is then just a transparent wrapper around the h1,
  which keeps behaving exactly like a bare h1 (shrink-wrapped and centered by the outer .v-stack's
  justify-items: center, nothing else involved).

  With the icon on: justify-self: stretch makes the row fill its grid column's full width (the
  .v-stack's own column is already the full content-box width) instead of shrink-wrapping - without
  that, there'd be no room at all for the icon's "1fr" column to roam across via icon_justify_self.
  Side by side, this is then a 2-column grid - the heading's own column is always "auto" (sized to
  the heading alone), so icon_justify_self can move the icon around its "1fr" column without ever
  resizing or shifting the heading's column (which otherwise, by default, now reads as pinned to the
  start edge instead of centered - an accepted side effect of placing the icon beside it). Stacked,
  it's a flex column instead, whose per-item align-self (set on the icon element itself, not here)
  does the same job without touching the heading's own position either.
  {%- endcomment -%}
  {%- if section.settings.show_icon -%}
    #shopify-section-{{ section.id }} .not-found-heading-row {
      justify-self: stretch;
      display: {{ icon_display }};
      {%- if icon_display == 'grid' -%}
        grid-template-columns: {{ icon_grid_template_columns }};
        grid-template-areas: {{ icon_grid_template_areas }};
        align-items: center;
      {%- else -%}
        flex-direction: {{ icon_flex_direction }};
        align-items: flex-start;
      {%- endif -%}
      gap: .5rem;
    }

    {%- comment -%}
    Trims the heading's box down to its actual glyphs (cap height to baseline), removing the
    invisible leading space a line box normally carries above/below the text - without it, that
    space pads out the row's own height and throws off align-items: center, which centers boxes,
    not visible pixels.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .not-found-heading-row__heading {
      grid-area: heading;
      text-box: trim-both cap alphabetic;
    }

    #shopify-section-{{ section.id }} .not-found-heading-row__icon {
      grid-area: icon;
      {%- if icon_display == 'grid' -%}
        justify-self: {{ icon_justify_self }};
      {%- else -%}
        align-self: {{ icon_justify_self }};
      {%- endif -%}
    }
  {%- endif -%}
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_not_found %} section-floating section-floating--block-end{% endif %}"{% if section.settings.floating_not_found %} style="border-end-start-radius: {{ section.settings.not_found_border_radius }}px; border-end-end-radius: {{ section.settings.not_found_border_radius }}px; overflow: hidden;"{% endif %}>
  <div class="content-box">
    <div class="empty-state v-stack gap-6 justify-items-center">
      {%- if section.settings.heading != blank or section.settings.show_icon -%}
        <div class="not-found-heading-row">
          {%- if section.settings.heading != blank -%}
            <h1 class="not-found-heading-row__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h1>
          {%- endif -%}

          {%- if section.settings.show_icon -%}
            <div class="not-found-heading-row__icon">
              {%- render 'decorative-icon',
                icon_type: section.settings.icon_type,
                icon_size: section.settings.icon_size,
                icon_spin: section.settings.icon_spin,
                icon_primary_color: section.settings.icon_primary_color,
                icon_secondary_color: section.settings.icon_secondary_color,
                icon_border_color: section.settings.icon_border_color
              -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        {%- assign button_link = section.settings.button_link | default: routes.root_url -%}
        {%- render 'button', content: section.settings.button_text, href: button_link -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_not_found.name",
  "class": "shopify-section--404",
  "tag": "section",
  "settings" : [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "floating_not_found",
      "label": "t:sections.main_not_found.floating_not_found",
      "info": "t:sections.main_not_found.floating_not_found_info",
      "default": false
    },
    {
      "type": "range",
      "id": "not_found_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "t:sections.main_not_found.not_found_border_radius",
      "default": 0,
      "visible_if": "{{ section.settings.floating_not_found }}"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "t:sections.main_not_found.mobile_height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "t:sections.main_not_found.desktop_height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "t:global.text.text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:global.text.heading",
      "default": "Page not found"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:global.text.size",
      "options": [
        { "value": "display-xl", "label": "Display XL" },
        { "value": "display-l", "label": "Display L" },
        { "value": "display-m", "label": "Display M" },
        { "value": "h1", "label": "XX-Large" },
        { "value": "h2", "label": "X-Large" },
        { "value": "h3", "label": "Large" },
        { "value": "h4", "label": "Medium" },
        { "value": "h5", "label": "Small" },
        { "value": "h6", "label": "X-Small" },
        { "value": "h7", "label": "XX-Small" }
      ],
      "default": "h3"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:global.text.button_text",
      "default": "Back to home page"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.main_not_found.button_link",
      "info": "t:sections.main_not_found.button_link_info"
    },
    {
      "type": "header",
      "content": "Decorative icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show spinning icon",
      "info": "A decorative icon shown next to the heading.",
      "default": false
    },
    {
      "type": "select",
      "id": "icon_type",
      "label": "Icon",
      "options": [
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "lotus",
          "label": "Lotus"
        },
        {
          "value": "clover",
          "label": "Clover"
        },
        {
          "value": "smiley",
          "label": "Smiley face"
        },
        {
          "value": "cherries",
          "label": "Cherries"
        },
        {
          "value": "eight_ball",
          "label": "8-Ball"
        },
        {
          "value": "blob",
          "label": "Blob"
        },
        {
          "value": "badge",
          "label": "Badge"
        },
        {
          "value": "stamp",
          "label": "Stamp"
        },
        {
          "value": "swoosh",
          "label": "Swoosh"
        },
        {
          "value": "phone",
          "label": "Phone"
        }
      ],
      "default": "star",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 32,
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "checkbox",
      "id": "icon_spin",
      "label": "Spin icon",
      "default": true,
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "color",
      "id": "icon_primary_color",
      "label": "Primary color",
      "default": "#FF6B9D",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "color",
      "id": "icon_secondary_color",
      "label": "Secondary color",
      "default": "#FFD93D",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Border color",
      "info": "Leave blank for no border.",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Position",
      "options": [
        {
          "value": "right",
          "label": "Right of title"
        },
        {
          "value": "left",
          "label": "Left of title"
        },
        {
          "value": "above",
          "label": "Above title"
        },
        {
          "value": "below",
          "label": "Below title"
        }
      ],
      "default": "right",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "select",
      "id": "icon_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.show_icon }}"
    }
  ]
}
{% endschema %}
