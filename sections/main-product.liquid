{%- liquid
  # When floating_product is on, .product-gallery-frame (main-product.liquid, below) already clips the card
  # to product_border_radius on every breakpoint. On mobile though, .product-gallery__carousel-frame (the
  # inner div directly wrapping the carousel, in product-gallery.liquid) sits flush against that same frame
  # and clips its own content too — with a mismatched radius (0, from gallery_border_radius) that square inner
  # clip visually wins at the corners, masking the outer rounding. Matching both to the same radius instead of
  # trying to cancel the inner one keeps them clipping to the identical shape, so there's nothing to conflict.
  assign gallery_border_radius = section.settings.gallery_border_radius
  if section.settings.floating_product
    assign gallery_border_radius = section.settings.product_border_radius
  endif
-%}

<style>
  {%- comment -%}
  Collapsible text (accordion blocks) inside main-product: product-info.liquid already wraps
  consecutive accordion blocks in a shared ".accordion-group" div (its own block-grouping
  mechanism) - this just gives that existing wrapper a white card treatment, radius matched to
  the rest of the section (gallery_border_radius, computed above).
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .accordion-group {
    background: #fff;
    border-radius: {{ gallery_border_radius }}px;
    padding-inline: var(--container-gutter);
    overflow: hidden;
  }

  {%- comment -%}
  .accordion's own top/bottom hairline dividers (theme.css: box-shadow: 0 1px 0 border-color,
  0 1px 0 border-color inset) are what draw the horizontal separator lines between each accordion
  in the group - removing them here since the white card itself is enough visual separation from
  the rest of the page.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .accordion-group .accordion {
    box-shadow: none;
  }

  {%- comment -%}
  .product-info-frame (the info/details card next to the gallery) is plain display: block, with no rule
  anywhere (checked .product, .product-info-frame, .product-info, .product-info__block-list, in this file
  and theme.css) setting align-items/justify-content/place-items/text-align: center on it or its child.
  Block layout has no vertical-centering mechanism to begin with - a single child always starts at the top
  of its container's content box - so no override is needed here at all; adding display: flex only invited
  doubt about whether some flex property might secretly centre it. Left deliberately empty/absent.
  {%- endcomment -%}

  {%- if section.settings.desktop_carousel_controls == 'thumbnails_left' -%}
    {%- comment -%}
    product-gallery.liquid's "thumbnails_left" option only repositions the existing rectangular,
    underline-indicator thumbnail strip (theme.css .scroll-marker-group--thumbnails) to the left
    edge - it doesn't change its shape. This restyles it into circular, cover-cropped, borderless
    avatars faded to 50% opacity except the active one, scoped to this section only (other places
    reusing thumbnails_left, eg. quick-buy, keep the default rectangular style).

    Scoped to min-width: 1000px, matching where "desktop_carousel_controls" (and product-gallery
    .liquid's own thumbnails_left repositioning) actually applies - .scroll-marker-group--thumbnails
    is the SAME shared class mobile_controls: "thumbnails" renders with on mobile, so leaving this
    unscoped would leak this desktop-only look onto mobile too if that setting were ever also set
    to "thumbnails".

    Vertical centering: .product-gallery__controls-floating .scroll-marker-group--thumbnails
    (theme.css, @media min-width: 700px) sets position: sticky on this element, and never gets
    overridden back to absolute by product-gallery.liquid's own thumbnails_left rule - so its
    top: 50%/translateY(-50%) (meant for absolute positioning, to center the strip) has no
    centering effect under sticky (top there only sets the scroll offset it "sticks" at), leaving
    it at its normal-flow position near the top instead. Forcing position: absolute back here is
    what makes that existing top/translateY actually center it.
    {%- endcomment -%}
    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} .scroll-marker-group--thumbnails {
        --scroll-marker-group-gap: .75rem;
        position: absolute;
      }

      #shopify-section-{{ section.id }} .scroll-marker-group--thumbnails .scroll-marker {
        --scroll-marker-width: 3rem;
        --scroll-marker-height: 3rem;
        border-radius: 50%;
        opacity: .5;
        overflow: hidden;
        transition: opacity .2s;
      }

      #shopify-section-{{ section.id }} .scroll-marker-group--thumbnails .scroll-marker img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      #shopify-section-{{ section.id }} .scroll-marker-group--thumbnails .scroll-marker:after {
        content: none;
      }

      #shopify-section-{{ section.id }} .scroll-marker-group--thumbnails .scroll-marker[aria-current="true"] {
        opacity: 1;
      }
    }
  {%- endif -%}

  /* Price: inherit the Body/Text size instead of the Heading scale (.h6/.h7) that
     price-list.liquid applies by default for context: 'product'. Scoped to this section's ID
     (not ".product-info", which is also shared by featured-product.liquid and the quick-buy
     modal) so only the actual product page is affected. */
  #shopify-section-{{ section.id }} price-list sale-price {
    font-size: var(--text-base);
  }

  #shopify-section-{{ section.id }} price-list compare-at-price {
    font-size: var(--text-sm);
  }

  {%- if section.settings.allow_transparent_header and section.settings.transparent_header_use_primary_colors and product.media.size > 0 -%}
    {%- comment -%}
    When this setting is enabled, we use the transparent header, but we force the header to use the primary colors and primary logo.
    Gated on product.media.size > 0 to match the same condition this section uses below to decide whether it
    actually applies the allow-transparent-header attribute - otherwise this !important override could win
    over another section's own legitimate transparent header even though this one never triggers it.
    {%- endcomment -%}

    .header {
      --header-show-transparent-logo: 0 !important;
      --header-transparent-header-text-color: initial;
    }
  {%- endif -%}

  {%- if section.settings.allow_transparent_header == false and section.settings.add_top_spacing and section.settings.floating_product == false -%}
    #shopify-section-{{ section.id }} .product {
      padding-block-start: min(1.75rem, var(--container-gutter));
    }
  {%- endif -%}

  {%- if section.settings.allow_transparent_header == false and section.settings.floating_product == false -%}
    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} .product-gallery {
        margin-inline-start: calc(-1 * var(--container-gutter));
      }
    }
  {%- endif -%}

  {%- comment -%}
  Only split into two columns when a gallery card actually exists (product.media.size > 0) - otherwise
  .product's own single-column fallback (theme.css) applies and product-info fills the full width
  instead of being squeezed into the gallery's column with an unexplained blank gap next to it.
  {%- endcomment -%}
  {%- if product.media.size > 0 -%}
    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} {
        --product-grid: auto / minmax(0, {{ section.settings.product_media_size | divided_by: 100.0 }}fr) minmax(0, {{ 100.0 | minus: section.settings.product_media_size | divided_by: 100.0 }}fr);
        --product-column-gap: {% case section.settings.column_spacing %}{%- when 'none' -%}0px{%- when 'sm' -%}calc(var(--container-gutter) / 2){%- when 'md' -%}var(--container-gutter){%- else -%}calc(var(--container-gutter) * 1.5){%- endcase -%};
      }

      {%- comment -%}
      Editable equivalent of featured-tabs.liquid's own column_spacing: replaces the base theme.css
      rule (.product { gap: 0 } + .product-info { padding-inline-start: 3rem }, a fixed, non-editable
      gap) with an actual grid gap driven by the setting above. Scoped by section ID so it wins over
      that base rule regardless of specificity ties. The floating_product branch below still needs
      its own matching override, since its later, more specific rules would otherwise win back to a
      hardcoded 0.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .product {
        gap: var(--product-column-gap);
      }

      #shopify-section-{{ section.id }} .product-info {
        padding-inline-start: 0;
      }
    }
  {%- endif -%}

  {%- if section.settings.floating_product -%}
    {%- comment -%}
    Shared by both the mobile (product_height_mobile) and desktop (product_height_desktop) branches below:
    once .product-gallery-frame itself has a definite height (set differently by each branch - an explicit
    height on mobile, a stretched grid row on desktop), this is the one chain that passes that height down
    to the actual media and forces it to crop-and-center instead of showing its own natural aspect ratio.
    Kept in one place instead of duplicated per breakpoint so there's a single spot to fix if the gallery's
    internal markup ever changes.

    Every step needs its own explicit height: 100% - position: absolute; inset: 0 only makes the immediate
    .product-gallery definite, not everything below it, and a percentage height is meaningless against an
    ancestor that never resolved its own height explicitly. Two different engines fight back if not pinned
    with !important at every link:

    - <scroll-carousel adaptive-height> (product-gallery.liquid) sets its own inline max-height in JS
      (theme.js adaptHeight_fn), sized to the currently selected slide's natural height - meant for
      galleries without a fixed row height. max-height: none overrides that inline style.
    - <video-media>/<model-media> (media.liquid) set their own aspect-ratio custom property inline, matching
      that specific video/model's own intrinsic ratio - aspect-ratio only fills in a dimension left "auto",
      so an explicit height: 100% (a real, non-auto value) is what stops it from deriving its own height
      from that ratio instead of from the row.
    - .product-gallery__carousel's own grid row (grid-template-rows, from --product-gallery-carousel-grid)
      is "auto" by default - an unusually tall/portrait slide could still inflate that auto row via its own
      content-based sizing before align-items: stretch ever gets a say, since percentages resolve as auto
      during that computation. grid-template-rows: 100% makes the row a definite, content-independent size
      from the start, same trick as .product-gallery > .product-gallery-frame below.

    object-fit/object-position are deliberately only set on the actual img, not on video-media/model-media
    themselves: object-fit has no effect on a custom element, only on a real replaced element (img, video,
    iframe) - theme.css's own "video-media > :is(video, img)" rule already applies cover/center there
    unconditionally, it only needed video-media itself to have a real height to crop against, which the
    height: 100% override above provides.
    {%- endcomment -%}
    {%- capture product_gallery_fill_css -%}
      #shopify-section-{{ section.id }} .product-gallery-frame > .product-gallery {
        position: absolute !important;
        inset: 0 !important;
        height: 100% !important;
        grid-template-rows: 100% !important;
      }

      #shopify-section-{{ section.id }} .product-gallery__image-list {
        height: 100% !important;
        grid-template-rows: minmax(0, 1fr) auto !important;
      }

      #shopify-section-{{ section.id }} .product-gallery__image-list > *:first-child {
        height: 100% !important;
        min-height: 0 !important;
      }

      #shopify-section-{{ section.id }} .product-gallery__carousel {
        height: 100% !important;
        max-height: none !important;
        grid-template-rows: 100% !important;
        align-items: stretch !important;
      }

      #shopify-section-{{ section.id }} .product-gallery__media {
        height: 100% !important;
      }

      #shopify-section-{{ section.id }} .product-gallery__media video-media,
      #shopify-section-{{ section.id }} .product-gallery__media model-media {
        height: 100% !important;
      }

      #shopify-section-{{ section.id }} .product-gallery__media img {
        height: 100% !important;
        width: 100% !important;
        object-fit: cover !important;
        object-position: center !important;
      }
    {%- endcapture -%}

    {%- comment -%}
    Floating Product always reserves a gutter-sized gap on every side, on every viewport, and always splits
    into two independently rounded cards (gallery + info) at every breakpoint: separate stacked cards on
    mobile (spaced by the gap below), flush edge-to-edge cards on desktop (--product-grid only splits them
    into columns inside the min-width:1000px query below). The side gutters come from the .section-floating /
    .section-floating--block-end utility classes on the wrapper below (the same ones every other floating
    section in the theme uses), so here we only cancel .product's own default block spacing to avoid doubling
    up with those margins, and add a matching top gutter using the theme's global inter-section spacing token
    instead of a hardcoded value.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .product {
      gap: var(--section-vertical-spacing);
      padding-block-end: 0;
    }

    {%- comment -%}
    Skipped when the transparent header is actually going to overlay this section (same condition
    used below for the allow-transparent-header attribute): the header's CSS assumes the gallery
    sits flush at the very top (zero gap) to overlay correctly, so adding the usual top gutter here
    would leave a solid gap between the transparent header and the gallery instead.
    {%- endcomment -%}
    {%- unless section.settings.allow_transparent_header and product.media.size > 0 -%}
      {%- comment -%}
      Margin instead of padding, at half the section spacing - applied directly on the outer
      color-scheme wrapper (below), the same element section-floating--block-end already puts its
      own margin-block-end on, instead of nested inside .product. This matches how every other
      floating section in the theme carries its floating margins on that single outer element.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} > div {
        margin-block-start: calc(var(--section-vertical-spacing) / 2);
      }
    {%- endunless -%}

    {%- comment -%}
    .section-floating--block-end's own margin-block-end (shared by every floating section in the theme) uses
    --container-gutter, a different token than --section-vertical-spacing. Overriding it here, scoped to this
    section only, to twice the section spacing value instead, without touching the shared utility class used
    elsewhere.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .section-floating--block-end {
      margin-block-end: calc(var(--section-vertical-spacing) * 2);
    }

    {%- comment -%}
    Without this, the gap below doubles up: this section contributes the margin-block-end above, and the next
    section (if it uses the standard ".container.section-spacing" pattern) independently adds its own full
    padding-block-start on top of it — margin and padding never collapse with each other in CSS. The theme's
    own --section-enable-padding-collapsing mechanism (theme.css, used between two regular .section-spacing
    sections with matching backgrounds) never recognizes ".section-floating--block-end" as a "previous section
    already spacing-aware" input, so it doesn't kick in here either. Forcing it to 1 (unconditionally, not
    gated by matching background like the standard mechanism) zeroes the next section's padding-block-start,
    leaving only the margin above as the single gap — matching the constant, unconditional gap used above the
    product page.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} + .shopify-section:has(.section-spacing) {
      --section-enable-padding-collapsing: 1;
    }

    {%- comment -%}
    Both cards are fully rounded and get their own padding at every breakpoint, not just desktop, since on
    mobile they're separate stacked cards and each needs all 4 corners. overflow:hidden only goes on the
    gallery frame: it doesn't wrap product-info, which uses position:sticky and breaks under any ancestor
    with overflow other than visible. The info frame gets the same radius without overflow:hidden — safe,
    because text/buttons never touch its exact edge. Padding reuses the same tokens ".section-split__column"
    already uses for its own column padding, instead of a hardcoded value.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .product-gallery-frame,
    #shopify-section-{{ section.id }} .product-info-frame {
      border-radius: {{ section.settings.product_border_radius }}px;
    }

    #shopify-section-{{ section.id }} .product-gallery-frame {
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .product-info-frame {
      padding: var(--section-vertical-spacing) var(--container-gutter);
    }

    {%- comment -%}
    .container's own centering margin would otherwise inset both cards a second time on top of the
    .section-floating margin, leaving them inset from the floating boundary instead of touching it — on every
    viewport, not just desktop.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .container {
      margin-inline: 0;
    }

    @media screen and (max-width: 999px) {
      {%- comment -%}
      The gallery frame is now the full-bleed boundary itself (rounded + overflow:hidden), so its children no
      longer need to "escape" toward a farther-away edge — reusing the theme's own bleed/full-bleed/md:unbleed
      system (--distance-to-bleed), just pointed at 0 here so it resolves to "fill the frame exactly" instead
      of the ambient .container gutter distance.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .product-gallery-frame {
        --distance-to-bleed: 0;
      }

      {%- if section.settings.product_height_mobile > 0 -%}
        {%- comment -%}
        Mobile stacks gallery and info as two independent blocks (no shared row to stretch across, unlike the
        two-column desktop layout above) - so this only needs to pin .product-gallery-frame itself to a fixed
        height and let its content fill it, without any of the "row keeps growing" concerns product_height_desktop
        has to work around on desktop.
        {%- endcomment -%}
        #shopify-section-{{ section.id }} .product-gallery-frame {
          height: max(20rem, {{ section.settings.product_height_mobile }}vh);
          position: relative;
        }

        {{ product_gallery_fill_css }}
      {%- endif -%}
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} .product {
        gap: var(--product-column-gap, 0px);
        align-items: stretch;
      }

      #shopify-section-{{ section.id }} .product-info {
        padding-inline: 0;
      }

      {%- comment -%}
      When column_spacing is "none" the two cards sit flush against each other (no gap), so they read
      as a single composition split in two — only the OUTER corners of each card stay rounded, the
      corners that touch each other are squared off. Any other spacing leaves a visible gap between
      them, so each card reads as its own independent piece and keeps all 4 corners rounded (same
      "none vs any spacing" logic media-blocks.liquid uses for its own column_spacing). Only applies
      when the gallery card actually exists (product.media.size > 0): otherwise product-info-frame is
      the only card in the row and should keep all 4 corners rounded regardless.
      {%- endcomment -%}
      {%- if product.media.size > 0 and section.settings.column_spacing == 'none' -%}
        #shopify-section-{{ section.id }} .product-gallery-frame {
          border-start-end-radius: 0;
          border-end-end-radius: 0;
        }

        #shopify-section-{{ section.id }} .product-info-frame {
          border-start-start-radius: 0;
          border-end-start-radius: 0;
        }
      {%- endif -%}

      {%- if section.settings.product_height_desktop > 0 -%}
        {%- comment -%}
        The row is now a hard max(28rem, Nvh), not a minmax(..., auto) floor — it no longer grows past that
        when an accordion opens or more blocks get added. align-items: stretch (set above) makes both frames
        match that fixed height exactly, on every state.

        max(28rem, Nvh) instead of clamp(28rem, Nvh, 50rem): a hard rem ceiling meant most of the slider's
        range silently had zero effect, since real product content (title + price + variants + buttons +
        description) is routinely already taller than 50rem even with every accordion collapsed — only a
        genuine floor is needed here, not an upper limit.

        product-info is a <safe-sticky> custom element: nothing in the theme ever gives it an explicit display,
        so it defaults to the browser's generic "inline" for unknown elements. With a block-level child
        (.product-info__block-list) inside an inline box, the browser generates anonymous block wrappers around
        it (the "block-in-inline" quirk), which can cause its own layout quirks — display: flow-root makes it a
        real block container (and a new block formatting context, so children's margins stay contained) without
        touching the global ".product-info" rule used by the standard layout, featured-product.liquid or
        quick-buy.
        {%- endcomment -%}
        #shopify-section-{{ section.id }} .product {
          grid-template-rows: max(28rem, {{ section.settings.product_height_desktop }}vh);
          align-content: stretch;
          min-height: max(28rem, {{ section.settings.product_height_desktop }}vh);
        }

        {%- comment -%}
        .product-info's position: sticky (theme.css, min-width: 1000px) plus its <safe-sticky> JS
        (theme.js SafeSticky) are both built around sticking to the PAGE's scroll (window.scrollY) - that's
        the right behavior everywhere else product-info is used (standard layout, featured-product, quick-buy),
        where nothing between it and the viewport ever scrolls on its own. Once .product-info-frame gets
        overflow: hidden auto below, it becomes the actual nearest scrolling ancestor for that sticky child -
        but the JS still measures window.scrollY, not this frame's own scrollTop, so it computes a "top" that
        has nothing to do with this frame's real scroll position and shoves the content down from a wrong
        offset instead of leaving it at the frame's own top. position: static cancels sticky outright (and
        SafeSticky's own checkPosition_fn removes its stale inline top the moment it sees a non-sticky computed
        position), so product-info just sits in normal block flow at the top of the frame, like any other
        block child.
        {%- endcomment -%}
        #shopify-section-{{ section.id }} .product-info {
          display: flow-root;
          position: static !important;
        }

        {%- comment -%}
        A grid item's automatic minimum size otherwise defaults to its content's min-content height, which
        would force this row past its fixed size the moment product-info's content (eg. an open accordion)
        no longer fits - overflow: hidden auto is what makes the browser drop that automatic minimum to 0
        instead, so the frame actually stays pinned at the row's height and scrolls its own content internally
        rather than growing. min-height: 0 backs that up for engines that need the min-size reset spelled out
        explicitly rather than inferred from overflow alone.
        {%- endcomment -%}
        #shopify-section-{{ section.id }} .product-info-frame {
          overflow: hidden auto !important;
          min-height: 0 !important;
        }

        {%- comment -%}
        Without this, the gallery's own intrinsic size (the media's natural aspect-ratio) would count toward
        --product-grid's row-sizing above — a tall/portrait photo would inflate the row past Nvh on its own,
        defeating the fixed height entirely. Taking .product-gallery out of normal flow (absolutely
        positioned, filling .product-gallery-frame via inset: 0, done below as part of the shared chain)
        removes it from that calculation altogether. .product-gallery-frame (the actual grid item) still
        stretches to match the row via align-items: stretch (set above), and the inset: 0 child always fills
        that final, now-constant size exactly - position: relative here is what makes that inset: 0 resolve
        against this frame instead of the next positioned ancestor up the tree.
        {%- endcomment -%}
        #shopify-section-{{ section.id }} .product-gallery-frame {
          position: relative !important;
        }

        {{ product_gallery_fill_css }}
      {%- endif -%}
    }
  {%- endif -%}
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_product %} section-floating section-floating--block-end{% endif %}" {% if section.settings.allow_transparent_header and product.media.size > 0 %}allow-transparent-header{% endif %}>
  <div class="container">
    {%- capture product_form_id -%}product-form-main-{{ product.id }}-{{ section.id }}{%- endcapture -%}

    <product-rerender id="product-info-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}" allow-partial-rerender>
      <div class="product">
        {%- if product.media.size > 0 -%}
          <div class="product-gallery-frame">
            {%- render 'product-gallery',
                product: product,
                product_form_id: product_form_id,
                desktop_layout: section.settings.desktop_media_layout,
                desktop_carousel_controls: section.settings.desktop_carousel_controls,
                mobile_controls: section.settings.mobile_controls,
                enable_media_autoplay: section.settings.enable_media_autoplay,
                enable_video_looping: section.settings.enable_video_looping,
                enable_image_zoom: section.settings.enable_image_zoom,
                max_image_zoom_level: section.settings.max_image_zoom_level,
                gallery_border_radius: gallery_border_radius,
                thumbnail_border_radius: section.settings.thumbnail_border_radius
            -%}
          </div>
        {%- endif -%}

        <div class="product-info-frame{% if section.settings.floating_product %} color-scheme color-scheme--{{ section.settings.product_info_color_scheme.id }}{% endif %}">
          {%- render 'product-info',
              product: product,
              product_form_id: product_form_id,
              content_alignment: section.settings.content_alignment,
              context: 'main_product'
          -%}
        </div>
      </div>
    </product-rerender>
  </div>
</div>

{%- render 'product-sticky-add-to-cart', product: product, product_form_id: product_form_id -%}
{%- render 'product-quick-buy', product: product -%}

<script>
  // We save the product ID in local storage to be eventually used for recently viewed section
  let recentlyViewedProducts;

  try {
    recentlyViewedProducts = JSON.parse(localStorage.getItem('theme:recently-viewed-products') || '[]');

    if (!Array.isArray(recentlyViewedProducts)) {
      throw new Error('Not an array');
    }
  } catch (e) {
    // Corrupted value (invalid JSON, or not an array): reset instead of silently failing on every
    // future product view too
    recentlyViewedProducts = [];
  }

  recentlyViewedProducts = recentlyViewedProducts.filter(item => item !== {{ product.id }}); // Delete product to remove to the start
  recentlyViewedProducts.unshift({{ product.id }}); // Add at the start

  try {
    localStorage.setItem('theme:recently-viewed-products', JSON.stringify(recentlyViewedProducts));
  } catch (e) {
    // Safari in private mode does not allow setting item, we silently fail
  }
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "class": "shopify-section--main-product",
  "tag": "section",
  "settings": [
