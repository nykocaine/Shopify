{%- if section.settings.floating_gift_card -%}
  <style>
    {%- comment -%}
    Floating mode: .section-split__column already pads itself with real padding (not margin, unlike
    main-search's .container), just not with this formula - matching the main-search/faq.liquid/
    reviews.liquid treatment: inline and bottom at calc(var(--container-gutter) + 0.5rem), top
    tripled. The image column stays untouched (section-split__column--flushed forces padding: 0
    !important, so it keeps bleeding to the card's edges).
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .section-split__column.align-self-stretch {
      padding-inline: calc(var(--container-gutter) + 0.5rem);
      padding-block-start: calc((var(--container-gutter) + 0.5rem) * 3);
      padding-block-end: calc(var(--container-gutter) + 0.5rem);
    }

    {%- comment -%}
    Below 1000px theme.css stacks the two columns (.section-split only switches to its 2-column grid
    at min-width: 1000px) and gives the stacked :last-child (this content column) its own
    padding-block-start: var(--section-stack-row-gap) - a fixed theme value, not this card's gutter
    formula. The rule above already wins there on specificity (ID selector vs. theme.css's bare
    class), but restating it explicitly removes any doubt that the tripled top padding actually
    applies on mobile, not just desktop.
    {%- endcomment -%}
    @media screen and (max-width: 999px) {
      #shopify-section-{{ section.id }} .section-split__column.align-self-stretch {
        padding-block-start: calc((var(--container-gutter) + 0.5rem) * 3);
      }
    }
  </style>
{%- endif -%}

<div class="color-scheme color-scheme--{{ section.settings.content_color_scheme.id }}{% if section.settings.floating_gift_card %} section-floating section-floating--block-end{% endif %}"{% if section.settings.floating_gift_card %} style="border-end-start-radius: {{ section.settings.gift_card_border_radius }}px; border-end-end-radius: {{ section.settings.gift_card_border_radius }}px; overflow: hidden;"{% endif %}>
  <div class="section-split sm:min-h-fill">
    <div class="section-split__column section-split__column--image section-split__column--flushed">
      <div class="content-box h-full min-h-xs color-scheme color-scheme--{{ section.settings.image_color_scheme.id }}">
        {%- if section.settings.background_image != blank -%}
          <div class="content-box__background-media">
            {{- section.settings.background_image | image_url: width: section.settings.background_image.width | image_tag: sizes: '(max-width: 699px) 100vw, 50vw', widths: '200,300,400,600,800,1000,1200,1400,1600,1800,2000' -}}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="section-split__column align-self-stretch">
      <div class="gift-card">
        <div class="v-stack gap-6">
          <!-- EXPIRE BANNER -->
          {%- if gift_card.expired or gift_card.enabled == false -%}
            {%- assign banner_error = 'gift_card.issued.expired' | t -%}
            {%- render 'banner', status: 'error', content: banner_error -%}
          {%- endif -%}

          <div class="v-stack gap-4">
            <!-- REMAINING BALANCE -->
            <p class="subheading">{{ 'gift_card.issued.remaining_amount' | t }}</p>

            {% if settings.currency_code_enabled %}
              {%- assign gift_card_balance = gift_card.balance | money_with_currency -%}
              {%- assign gift_card_initial_value = gift_card.initial_value | money_with_currency -%}
            {% else %}
              {%- assign gift_card_balance = gift_card.balance | money -%}
              {%- assign gift_card_initial_value = gift_card.initial_value | money -%}
            {% endif %}

            <h1 class="h1">{{ gift_card_balance }}</h1>
            
            {%- if gift_card.balance != gift_card.initial_value -%}
              <p class="subheading">{{ 'gift_card.issued.out_of_html' | t: initial_value: gift_card_initial_value }}</p>
            {%- endif -%}
          </div>

          <!-- REDEEM INFO -->
          <p>{{ 'gift_card.issued.redeem_instructions' | t }}</p>

          <!-- ACTION BUTTONS -->
          <div class="v-stack gap-3">
            <input class="input gift-card__code" type="text" value="{{ gift_card.code | format_code }}" readonly aria-label="{{ 'gift_card.issued.code' | t }}" onclick="this.select()">

            <div class="gift-card__action-buttons">
              <copy-button class="contents" data-text="{{ gift_card.code | escape }}">
                {%- assign button_content = 'gift_card.general.copy' | t -%}
                {%- render 'button', content: button_content -%}
              </copy-button>

              {%- comment -%}
              Hand-rolled instead of render 'button' because it needs onclick="window.print()",
              which that snippet doesn't accept - but it still needs to replicate the same
              button_animation branching the snippet does internally (theme.css/button.liquid),
              rather than hardcoding the "rotation" variant regardless of what the merchant picked.
              {%- endcomment -%}
              <button type="button" class="button button--outline" style="--button-text-color: var(--button-background-primary)" onclick="window.print()">
                <button-content class="button__content" {% if settings.button_animation == 'rotation' %}rotated-text="{{ 'gift_card.general.print' | t | escape_once }}"{% elsif settings.button_animation == 'up' %}up-text="{{ 'gift_card.general.print' | t | escape_once }}"{% elsif settings.button_animation == 'glowing' %}glowing{% elsif settings.button_animation == 'marquee' %}marquee{% endif %}>
                  {{ 'gift_card.general.print' | t }}
                </button-content>
              </button>
            </div>
          </div>

          {%- if gift_card.expires_on -%}
            {%- assign expires_on = gift_card.expires_on | date: format: 'date' -%}
            <p class="subheading">{{ 'gift_card.issued.expires_on' | t: expires_on: expires_on }}</p>
          {%- endif -%}
        </div>

        {%- if gift_card.pass_url or section.settings.show_qr_code -%}
          <div class="gift-card__pass-cards">
            <!-- QR CODE AND APPLE PAY -->
            {%- if section.settings.show_qr_code -%}
              <qr-code class="gift-card__qr-code" identifier="{{ gift_card.qr_identifier }}"></qr-code>
            {%- endif -%}

            {%- if gift_card.pass_url -%}
              <a class="gift-card__apple-wallet" href="{{ gift_card.pass_url }}">
                <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="145" height="45" alt="{{ 'gift_card.issued.add_to_apple_wallet' | t }}" loading="lazy">
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_gift_card.name",
  "class": "shopify-section--main-gift-card",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "image_color_scheme",
      "label": "t:sections.main_gift_card.image_color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "color_scheme",
      "id": "content_color_scheme",
      "label": "t:sections.main_gift_card.content_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "floating_gift_card",
      "label": "t:sections.main_gift_card.floating_gift_card",
      "info": "t:sections.main_gift_card.floating_gift_card_info",
      "default": false
    },
    {
      "type": "range",
      "id": "gift_card_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "t:sections.main_gift_card.gift_card_border_radius",
      "default": 0,
      "visible_if": "{{ section.settings.floating_gift_card }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:global.image.background_image",
      "info": "t:sections.main_gift_card.background_image_size_recommendation"
    },
    {
      "type": "checkbox",
      "id": "show_qr_code",
      "label": "t:sections.main_gift_card.show_qr_code",
      "default": true
    }
  ]
}
{% endschema %}
