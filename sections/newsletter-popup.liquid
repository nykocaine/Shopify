{%- unless request.page_type == 'captcha' or section.settings.show_only_on_index and template != 'index' -%}
  {%- unless section.settings.hide_for_account_holders and customer -%}
    {%- liquid
      assign posted_successfully = false
      assign newsletter_id = 'newsletter-' | append: section.id

      capture _temporary
        form 'customer', id: newsletter_id, class: 'form'
          assign posted_successfully = form.posted_successfully?
        endform
      endcapture

      # Hide the marketing heading/text once the discount code is showing, so the "thank you + code" message isn't
      # competing with the original pitch copy.
      assign show_discount_after_success = false
      if posted_successfully and section.settings.show_discount_code and section.settings.discount_code != blank
        assign show_discount_after_success = true
      endif
    -%}

    {%- liquid
      assign has_desktop_image = false
      assign has_mobile_image = false

      if section.settings.image != blank
        assign has_desktop_image = true
      endif

      if section.settings.image_mobile != blank
        assign has_mobile_image = true
      endif

      # "Image as background": the image(s) fill the whole popup and the content sits on top of them. Desktop uses the
      # desktop image, phones the mobile one - each falls back to the other when only one is set.
      assign image_as_background = false
      assign bg_image_desktop = nil
      assign bg_image_mobile = nil

      if section.settings.image_as_background and has_desktop_image
        assign image_as_background = true
      elsif section.settings.image_as_background and has_mobile_image
        assign image_as_background = true
      endif

      if image_as_background
        assign bg_image_desktop = section.settings.image | default: section.settings.image_mobile
        assign bg_image_mobile = section.settings.image_mobile | default: section.settings.image
        assign bg_overlay_alpha = section.settings.bg_overlay_opacity | divided_by: 100.0
      endif

      assign align_mobile = section.settings.text_alignment_mobile
      assign align_desktop = section.settings.text_alignment_desktop
      assign justify_mobile = 'flex-start'
      assign justify_desktop = 'flex-start'
      assign title_start_mobile = '0px'
      assign title_start_desktop = '0px'

      if align_mobile == 'center'
        assign justify_mobile = 'center'
        assign title_start_mobile = '2rem'
      elsif align_mobile == 'right'
        assign justify_mobile = 'flex-end'
      endif

      if align_desktop == 'center'
        assign justify_desktop = 'center'
        assign title_start_desktop = '2rem'
      elsif align_desktop == 'right'
        assign justify_desktop = 'flex-end'
      endif
    -%}

    <style>
      {%- comment -%}
      The padding all around the popup is the same one the floating sections use (container gutter + 0.5rem), applied
      on the popup itself - so the image sits at that distance from the top, bottom and sides - and the gap between
      the image and the text is the same distance. The modal body keeps only a tiny padding so the inputs' focus ring
      isn't clipped by its scroll area.
      {%- endcomment -%}
      .modal--newsletter {
        --newsletter-padding: calc(var(--container-gutter) + 0.5rem);
        --newsletter-image-radius: {{ section.settings.image_border_radius }}px;
        --newsletter-align: {{ align_mobile }};
        --newsletter-justify: {{ justify_mobile }};
        --newsletter-title-start: {{ title_start_mobile }};
        --modal-body-padding-block: 0.25rem;
        --modal-body-padding-inline: 0.25rem;
      }

      .modal--newsletter::part(content) {
        padding: calc(var(--newsletter-padding) - 0.25rem);
        gap: calc(var(--newsletter-padding) - 0.5rem);
        {%- if section.settings.center_popup -%}
          place-self: center;
        {%- endif -%}
        {%- if section.settings.popup_border_radius > 0 -%}
          border-radius: {{ section.settings.popup_border_radius }}px;
          overflow: hidden;
          -webkit-mask-image: -webkit-radial-gradient(white, black);
        {%- endif -%}
      }

      {%- comment -%}
      Radius + overflow:hidden live on the wrapper (not the <img>) so the image reliably clips to the rounded corners
      in every browser. On mobile the image sits on top with its own height capped; on desktop it stretches to the
      height of the popup (cropped, never distorted) so its top and bottom margins match the sides.
      {%- endcomment -%}
      .newsletter-popup__image {
        border-radius: var(--newsletter-image-radius);
        overflow: hidden;
      }

      .newsletter-popup__image img {
        display: block;
        width: 100%;
        height: auto;
        max-height: 28svh;
        object-fit: cover;
      }

      .newsletter-popup__content {
        text-align: var(--newsletter-align);
      }

      {%- comment -%}Clears the close button on its side; centered text clears it on both sides so it stays centered.{%- endcomment -%}
      .newsletter-popup__title {
        padding-inline: var(--newsletter-title-start) 2rem;
      }

      .newsletter-popup__content .newsletter-discount__code-group {
        justify-content: var(--newsletter-justify);
      }

      {%- if has_mobile_image -%}
        @media screen and (max-width: 999px) {
          .newsletter-popup__image--desktop {
            display: none;
          }
        }
      {%- endif -%}

      {%- if image_as_background -%}
        {%- comment -%}
        Image as background: the picture covers the whole popup (cropped, never distorted), a flat overlay of the chosen
        color and strength keeps the text readable, and the content - and the close button, which inherits the color
        from the popup - is drawn on top in the chosen text color. The side-by-side image blocks are not shown. Same
        radius/clipping as above. !important because the popup's own background comes from its color scheme.
        {%- endcomment -%}
        .modal--newsletter {
          color: {{ section.settings.bg_text_color }};
        }

        .modal--newsletter::part(content) {
          background-image: linear-gradient(rgba({{ section.settings.bg_overlay_color.red }}, {{ section.settings.bg_overlay_color.green }}, {{ section.settings.bg_overlay_color.blue }}, {{ bg_overlay_alpha }}), rgba({{ section.settings.bg_overlay_color.red }}, {{ section.settings.bg_overlay_color.green }}, {{ section.settings.bg_overlay_color.blue }}, {{ bg_overlay_alpha }})), url('{{ bg_image_mobile | image_url: width: 1000 }}') !important;
          background-size: cover !important;
          background-position: center !important;
          background-repeat: no-repeat !important;
          min-height: min(26rem, 80svh);
          align-content: end;
        }

        .newsletter-popup__image {
          display: none !important;
        }

        .newsletter-popup__content,
        .newsletter-popup__content .text-subdued {
          color: inherit;
        }

        .newsletter-popup__content .text-subdued {
          opacity: .8;
        }

        @media screen and (min-width: 1000px) {
          .modal--newsletter::part(content) {
            background-image: linear-gradient(rgba({{ section.settings.bg_overlay_color.red }}, {{ section.settings.bg_overlay_color.green }}, {{ section.settings.bg_overlay_color.blue }}, {{ bg_overlay_alpha }}), rgba({{ section.settings.bg_overlay_color.red }}, {{ section.settings.bg_overlay_color.green }}, {{ section.settings.bg_overlay_color.blue }}, {{ bg_overlay_alpha }})), url('{{ bg_image_desktop | image_url: width: 1600 }}') !important;
            grid-template-columns: minmax(0, 34rem) !important;
            min-height: min(30rem, 80svh);
          }
        }
      {%- endif -%}

      @media screen and (min-width: 1000px) {
        .modal--newsletter {
          --newsletter-align: {{ align_desktop }};
          --newsletter-justify: {{ justify_desktop }};
          --newsletter-title-start: {{ title_start_desktop }};
        }

        .modal--newsletter::part(content) {
          grid-template-columns: {% if has_desktop_image %}minmax(0, 24rem) minmax(0, 26rem){% else %}minmax(0, 30rem){% endif %};
          gap: var(--newsletter-padding);
        }

        .newsletter-popup__image {
          align-self: stretch;
        }

        .newsletter-popup__image img {
          height: 100%;
          max-height: none;
        }

        .newsletter-popup__image--mobile {
          display: none;
        }
      }

      {%- comment -%}
      Mobile-only width: below 1000px .modal defaults to place-self: end stretch (a full-width bottom sheet, see
      assets/theme.css). Below 100% we switch the inline axis from "stretch" to a fixed percentage, centered
      horizontally, without touching the vertical anchor (align-self), so it still combines correctly with
      "Center popup" above.
      {%- endcomment -%}
      {%- if section.settings.mobile_popup_width < 100 -%}
        @media screen and (max-width: 999px) {
          .modal--newsletter::part(content) {
            width: {{ section.settings.mobile_popup_width }}%;
            justify-self: center;
          }
        }
      {%- endif -%}
    </style>
    <newsletter-popup class="modal modal--newsletter color-scheme color-scheme--{{ section.settings.color_scheme.id }}" {% if section.settings.show_only_once %}only-once{% endif %} apparition-delay="{{ section.settings.apparition_delay }}" {% if posted_successfully %}open{% endif %} role="dialog" aria-label="{{ 'sections.newsletter_popup.accessibility_title' | t | escape }}" handle-editor-events>
      {%- if has_desktop_image -%}
        <div class="newsletter-popup__image newsletter-popup__image--desktop" slot="image">
          {{- section.settings.image | image_url: width: section.settings.image.width | image_tag: loading: 'lazy', sizes: '(max-width: 999px) 100vw, 24rem', widths: '200,400,600,800,1000,1200' -}}
        </div>
      {%- endif -%}

      {%- if has_mobile_image -%}
        <div class="newsletter-popup__image newsletter-popup__image--mobile" slot="image">
          {{- section.settings.image_mobile | image_url: width: section.settings.image_mobile.width | image_tag: loading: 'lazy', sizes: '100vw', widths: '200,400,600,800,1000,1200' -}}
        </div>
      {%- endif -%}

      <div class="newsletter-popup__content v-stack gap-6">
        {%- unless show_discount_after_success -%}
          {%- if section.settings.title != blank -%}
            <p class="newsletter-popup__title h4">{{ section.settings.title }}</p>
          {%- endif -%}

          {%- if section.settings.content != blank -%}
            <p>{{ section.settings.content }}</p>
          {%- endif -%}
        {%- endunless -%}

        <div class="v-stack gap-4">
          {%- comment -%}
          Same component as the footer newsletter block and the password page (snippets/newsletter-form.liquid):
          merged email + submit pill, identical styles and submission logic.
          {%- endcomment -%}
          {%- render 'newsletter-form', id: section.id, value: customer.email, button_label: section.settings.button_text, remember_success_locally: true, show_discount: section.settings.show_discount_code, discount_code: section.settings.discount_code -%}

          {%- if section.settings.conditions != blank and show_discount_after_success == false -%}
            <p class="text-sm text-subdued">{{ section.settings.conditions }}</p>
          {%- endif -%}
        </div>
      </div>
    </newsletter-popup>
  {%- endunless -%}
{%- endunless -%}

{% schema %}
{
  "name": "t:sections.newsletter_popup.name",
  "class": "shopify-section--popup",
  "enabled_on": {
    "groups": ["custom.overlay"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.newsletter_popup.instructions"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "apparition_delay",
      "min": 0,
      "max": 15,
      "step": 1,
      "unit": "sec",
      "label": "t:sections.newsletter_popup.delay",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_only_on_index",
      "label": "t:sections.newsletter_popup.show_only_on_home_page",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_for_account_holders",
      "label": "t:sections.newsletter_popup.hide_for_account_holders",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_only_once",
      "label": "t:sections.newsletter_popup.show_only_once",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "center_popup",
      "label": "Center popup",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_popup_width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Ancho en móvil",
      "info": "100% mantiene el ancho completo actual.",
      "default": 100
    },
    {
      "type": "range",
      "id": "popup_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Radio de imagen",
      "default": 12
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen para escritorio",
      "info": "t:sections.newsletter_popup.image_recommendation"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen para móvil",
      "info": "Opcional. Si la dejas vacía, en móvil se usa la imagen de escritorio."
    },
    {
      "type": "checkbox",
      "id": "image_as_background",
      "label": "Usar la imagen como fondo de todo el popup",
      "info": "La imagen de escritorio y la de móvil cubren todo el contenedor, y el contenido va encima. Si solo subes una, se usa en las dos.",
      "default": false
    },
    {
      "type": "color",
      "id": "bg_overlay_color",
      "label": "Capa sobre la imagen",
      "default": "#000000",
      "visible_if": "{{ section.settings.image_as_background }}"
    },
    {
      "type": "range",
      "id": "bg_overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Intensidad de la capa",
      "info": "Oscurece (o aclara) la imagen para que el texto se lea bien.",
      "default": 30,
      "visible_if": "{{ section.settings.image_as_background }}"
    },
    {
      "type": "color",
      "id": "bg_text_color",
      "label": "Color del texto sobre la imagen",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.image_as_background }}"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment_mobile",
      "label": "Alineación del texto en móvil",
      "default": "center"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment_desktop",
      "label": "Alineación del texto en escritorio",
      "default": "left"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Signup for our newsletter"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:global.text.button_text",
      "default": "Subscribe"
    },
    {
      "type": "inline_richtext",
      "id": "content",
      "label": "t:global.text.text",
      "default": "Describe what your customers will receive when subscribing to your newsletter."
    },
    {
      "type": "inline_richtext",
      "id": "conditions",
      "label": "t:global.text.secondary_text",
      "default": "By entering your address, you confirm that you have read our privacy policy."
    },
    {
      "type": "header",
      "content": "Descuento por suscripción"
    },
    {
      "type": "checkbox",
      "id": "show_discount_code",
      "label": "Mostrar descuento después de suscribirse",
      "default": false
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Código de descuento",
      "info": "Debe ser exactamente igual a un descuento que ya hayas creado en Shopify Admin → Descuentos. El tema no puede crear ni validar descuentos, solo muestra este texto.",
      "placeholder": "WELCOME10",
      "visible_if": "{{ section.settings.show_discount_code }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter_popup.name"
    }
  ]
}
{% endschema %}
