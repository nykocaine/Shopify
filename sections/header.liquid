        color_scheme: section.settings.color_scheme
      -%}
    {%- endif -%}
    {%- endunless -%}
  </x-header>
</height-observer>

<script>
  {%- comment -%}
  Early synchronous fallback for --header-height, so sections that compensate for it (allow-transparent-header)
  don't flash unpadded before <height-observer> upgrades (its own ResizeObserver only fires once theme.js loads
  and connects it). Must measure the same element height-observer measures (<x-header> itself, via its wrapper's
  clientHeight - height-observer is display: block with no padding/border of its own, so their heights match) -
  not #shopify-section-{{ section.id }}, which is taller than <x-header> when "Floating header" is on (it alone
  carries the extra padding-block-start for the header's white gutter). Measuring the wrong one here is what
  desynced the transparent-header compensation padding from the header's actual height on floating headers.
  {%- endcomment -%}
  (function() {
    var header = document.querySelector('#shopify-section-{{ section.id }} .header');

    if (header) {
      document.documentElement.style.setProperty('--header-height', Math.round(header.clientHeight) + 'px');
    }
  })();

  {%- comment -%}
  --header-height-rest: the header's height while it is NOT solid (at rest, transparent over the first section). The transparent header has its own
  top and bottom padding (the side padding), the solid one has "Header height padding", so the header changes height when it turns solid. The
  sections that make room for the transparent header under it (theme.css: content boxes, section spacing, dynamic grid, product info) use this
  resting height instead of the live --header-height, so their content does not jump when the header turns solid as the page starts scrolling.
  Measured on load and whenever the header changes size while not solid (eg. a new breakpoint); while solid the last resting value is kept.
  {%- endcomment -%}
  (function() {
    var header = document.querySelector('#shopify-section-{{ section.id }} .header');
    if (!header) return;

    {%- comment -%}Not while the padding is animating (going back to transparent): only the final height counts, measured when the transition ends{%- endcomment -%}
    var isAnimatingPadding = function() {
      return header.getAnimations ? header.getAnimations().some(function(animation) { return /^padding/.test(animation.transitionProperty || ''); }) : false;
    };

    var update = function() {
      if (!header.classList.contains('is-solid') && !isAnimatingPadding()) {
        document.documentElement.style.setProperty('--header-height-rest', Math.round(header.getBoundingClientRect().height) + 'px');
      }
    };

    update();
    if (window.ResizeObserver) new ResizeObserver(update).observe(header);
    header.addEventListener('transitionend', function(event) {
      if (event.target === header && /^padding/.test(event.propertyName)) update();
    });
  })();

  {%- comment -%}
  Cart icon: turns into a happy face for a moment whenever a product is added (variant:add, the same event the cart drawer and the count react to),
  and the bag is filled solid while the cart has items (.has-items, set here on every cart change; the first paint comes from the snippet). After an add
  the fill waits until the face is gone, so the order is: bag, face, filled bag. Listens on the document once for the whole page (the guard keeps the
  theme editor's re-renders of this section from stacking listeners); the icons are looked up on every event, so it works on whichever copy of the header
  is on screen.
  {%- endcomment -%}
  (function() {
    if (window.cartSmileInitialized) return;
    window.cartSmileInitialized = true;

    var timer;
    var pending = false;
    var latest = null;

    function setFilled(filled) {
      document.querySelectorAll('.header__cart-icon').forEach(function(icon) { icon.classList.toggle('has-items', filled); });
    }

    document.addEventListener('cart:change', function(event) {
      var detail = event.detail || {};

      if (detail.cart) latest = detail.cart.item_count > 0;

      if (detail.baseEvent !== 'variant:add') {
        // While the face is showing, the fill waits for it to go; otherwise it follows the cart right away.
        if (!pending && latest !== null) setFilled(latest);
        return;
      }

      var icons = document.querySelectorAll('.header__cart-icon');
      if (!icons.length) return;

      icons.forEach(function(icon) { icon.classList.add('is-added'); });

      pending = true;
      clearTimeout(timer);
      timer = setTimeout(function() {
        pending = false;
        document.querySelectorAll('.header__cart-icon').forEach(function(icon) { icon.classList.remove('is-added'); });
        if (latest !== null) setFilled(latest);
      }, 2200);
    });
  })();
</script>

<script>
  (function () {
    // Drawers hanging from the header (menu, search, cart): they are placed at the header's bottom edge (--menu-offset-top), measured by their own
    // scripts when they open. But the header can move right after that - the page locks its scroll as the drawer opens, the announcement bar above
    // can show again or change height (eg. its text wrapping on another line) - and the drawer stayed at the old edge, covering the bottom of the
    // header. While a drawer is open its edge is kept in sync with the header's real bottom: on every frame of the opening (about a second), and
    // whenever the header or the announcement bar change size while it is open.
    if (window.__drawerHeaderSyncInit) return;
    window.__drawerHeaderSyncInit = true;

    var DRAWERS = 'header-menu-drawer, #search-drawer, #cart-drawer';
    var frame = null;
    var until = 0;

    function openDrawers() {
      return document.querySelectorAll('header-menu-drawer[open], #search-drawer[open], #cart-drawer[open]');
    }

    function sync() {
      var header = document.querySelector('x-header');
      var drawers = openDrawers();
      if (!header || drawers.length === 0) return false;
      var dpr = window.devicePixelRatio || 1;
      var offset = Math.max(Math.round(header.getBoundingClientRect().bottom * dpr) / dpr, 0) + 'px';
      drawers.forEach(function (drawer) {
        if (drawer.style.getPropertyValue('--menu-offset-top') !== offset) drawer.style.setProperty('--menu-offset-top', offset);
      });
      return true;
    }

    function follow(duration) {
      until = Math.max(until, performance.now() + duration);
      if (frame) return;
      var tick = function () {
        frame = null;
        if (!sync() || performance.now() > until) return;
        frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
    }

    // A drawer opening (its [open] attribute appears): follow the header for the length of the opening
    new MutationObserver(function (records) {
      for (var i = 0; i < records.length; i++) {
        var target = records[i].target;
        if (target.matches && target.matches(DRAWERS) && target.hasAttribute('open')) {
          follow(1200);
          return;
        }
      }
    }).observe(document.body, { attributes: true, attributeFilter: ['open'], subtree: true });

    // The header or the announcement bar changing size while a drawer is open
    if (window.ResizeObserver) {
      var resizeObserver = new ResizeObserver(function () {
        if (openDrawers().length) follow(300);
      });
      var watch = function () {
        document.querySelectorAll('x-header, .shopify-section--announcement-bar').forEach(function (el) { resizeObserver.observe(el); });
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', watch);
      } else {
        watch();
      }
      document.addEventListener('shopify:section:load', watch);
    }
  })();
</script>

<script>
  (function () {
    // Drawer over the transparent header (see the "A drawer opened over the transparent header" rules above). The drawers (menu, search, cart)
    // ask the header to turn solid with header:disable-transparent-header right before they start unfolding, and to turn transparent again with
    // header:allow-transparent-header once they are fully closed. Listened to on window in the capture phase, so this runs before the header
    // itself reacts: it can still tell whether the header WAS transparent, which is the only case that gets the quick paint and the lead.
    if (window.__headerDrawerPaintInit) return;
    window.__headerDrawerPaintInit = true;

    var root = document.documentElement;
    var timer = null;
    var PAINT = 0.3;

    function header() {
      return document.querySelector('x-header');
    }

    function transparentPage() {
      return !!document.querySelector('.shopify-section:first-child [allow-transparent-header]') && !document.querySelector('.shopify-section--header ~ .shopify-section-group-header-group');
    }

    function setPaint(state, duration) {
      clearTimeout(timer);
      root.setAttribute('data-header-drawer-paint', state);
      timer = setTimeout(function () { root.removeAttribute('data-header-drawer-paint'); }, duration * 1000 + 80);
    }

    window.addEventListener('header:disable-transparent-header', function () {
      var el = header();
      if (!el || el.classList.contains('is-solid') || !transparentPage()) return;
      root.setAttribute('data-header-drawer-solid', '');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      setPaint('opening', PAINT);
      // The drawer's unfold (created right after this event) waits for the paint to reach the header's bottom edge
      window.__themeUnfoldLead = PAINT;
      requestAnimationFrame(function () { window.__themeUnfoldLead = 0; });
    }, true);

    window.addEventListener('header:allow-transparent-header', function () {
      if (!root.hasAttribute('data-header-drawer-solid')) return;
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) setPaint('closing', 0.35);
      // Marks the end of the drawer-driven solid state once the header has unpainted
      setTimeout(function () { root.removeAttribute('data-header-drawer-solid'); }, 450);
    }, true);
  })();
</script>

<script>
  (function () {
    // Smooth height change between the transparent and the solid header (they have different inner paddings). Animating the padding itself
    // resized the header on every frame while the page scrolled, and on phones the logo trembled. Now the height changes in one step and the
    // content (logo, menu, icons) - which is centred in the header and so jumps by half the difference - is moved back to where it was and
    // glides to its new place with a transform animation (FLIP), which the browser runs on the same thread as the scroll: no trembling.
    if (window.__headerResizeFlipInit) return;
    window.__headerResizeFlipInit = true;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    function init() {
      var header = document.querySelector('x-header');
      if (!header || header.__flipInit) return;
      header.__flipInit = true;

      var lastHeight = header.offsetHeight;
      var wasSolid = header.classList.contains('is-solid');

      new MutationObserver(function () {
        var isSolid = header.classList.contains('is-solid');
        var height = header.offsetHeight;
        var delta = height - lastHeight;
        lastHeight = height;
        if (isSolid === wasSolid) return;
        wasSolid = isSolid;
        if (reduceMotion.matches || Math.abs(delta) < 0.5) return;

        header.querySelectorAll(':scope > .header__logo, :scope > .header__primary-nav, :scope > .header__secondary-nav').forEach(function (item) {
          item.animate(
            [{ transform: 'translateY(' + (-delta / 2) + 'px)' }, { transform: 'translateY(0)' }],
            { duration: isSolid ? 450 : 600, easing: 'cubic-bezier(.4, 0, .2, 1)' }
          );
        });
      }).observe(header, { attributes: true, attributeFilter: ['class'] });

      // Keeps the reference height right when the header changes size for other reasons (fonts, resize, editor)
      if (window.ResizeObserver) {
        new ResizeObserver(function () { lastHeight = header.offsetHeight; }).observe(header);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('shopify:section:load', function () { requestAnimationFrame(init); });
  })();
</script>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "shopify-section--header",
  "tag": "header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:sections.header.enable_sticky_header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_on_scroll",
      "label": "t:sections.header.hide_on_scroll",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "floating_header",
      "label": "t:sections.header.floating_header",
      "info": "t:sections.header.floating_header_info",
      "default": false
    },
    {
      "type": "range",
      "id": "header_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:sections.header.header_border_radius",
      "default": 0,
      "visible_if": "{{ section.settings.floating_header }}"
    },
    {
      "type": "checkbox",
      "id": "always_round_bottom_corners",
      "label": "Always round the bottom corners",
      "info": "The header keeps its bottom corners rounded at every moment, also while the page is scrolled and when the section below touches it.",
      "default": true,
      "visible_if": "{{ section.settings.floating_header }}"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "t:sections.header.mobile_layout",
      "options": [
        {
          "value": "logo_left_navigation_right",
          "label": "t:sections.header.mobile_layout_options.logo_left_navigation_right"
