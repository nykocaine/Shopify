{%- liquid
  assign open_dropdown_menu_in_sidebar = false
  assign header_logo_only = false

  if template.suffix == 'faq'
    assign header_logo_only = true
  endif

  if section.settings.show_country_selector and localization.available_countries.size > 1
    assign show_country_selector = true
  endif

  if section.settings.show_locale_selector and localization.available_languages.size > 1
    assign show_locale_selector = true
  endif

  if section.settings.desktop_dropdown_menu_style == 'sidebar' and section.settings.desktop_layout == 'logo_center_navigation_inline'
    assign open_dropdown_menu_in_sidebar = true
  endif
-%}

<style>
  :root {
    --header-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};
    --header-is-visible: 1;
    /* Line thickness (in real pixels) of the header icons: the icon stroke setting scaled by how big the header icons are drawn
       (16px phones, Desktop icon size from 700px). The control icons (arrows, zoom, close...) draw their line with exactly this, see
       .icon--control in theme.css, so they have the same thickness as the header icons everywhere. */
    --header-icon-line-width: {{ settings.icon_stroke_width }}px;
    {%- if section.settings.transparent_logo != blank %}
    /* The transparent-header logo, shared with videos (media-zoom-style.liquid draws it in their bottom-left corner). Defined here,
       on :root, because the header is the one place guaranteed to have this setting in scope on every page. */
    --video-logo: url('{{ section.settings.transparent_logo | image_url: width: 400 }}');
    {%- endif %}
    /* Softer, slightly slower timing for everything that changes when the header turns solid (background,
       text color, logo swap, the gap above it) and for its hide-on-scroll slide. theme.css uses a fixed .2s for each, which read as an abrupt
       blink when they all fire at once. */
    --header-solid-transition: .45s cubic-bezier(.4, 0, .2, 1);
    {%- if section.settings.floating_header %}
    /* Gap above the floating header: half the section vertical spacing. Defined on :root (not on the
       section) so snippets/css-variables.liquid (--sticky-area-height) and theme.css (menu overlay)
       can add it to their offsets and match where the header really sits. */
    --header-top-gap: calc(var(--section-vertical-spacing) / 2);
    /* Distance from the screen edge once the header is stuck while scrolling: half the section spacing,
       or a quarter when a sticky announcement bar sits above it (same gap as between the two at rest). */
    --header-stuck-gap: calc(var(--section-vertical-spacing) / (2 + 2 * var(--announcement-bar-is-sticky, 0)));
    {%- endif %}
  }

  {%- if section.settings.floating_header -%}
    {%- comment -%}
    When the announcement bar is on the page, the gap between it and the header is half of the usual
    half-section gap (a quarter of the section spacing).
    {%- endcomment -%}
    :root:has(.shopify-section--announcement-bar .announcement-bar-wrapper) {
      --header-top-gap: calc(var(--section-vertical-spacing) / 4);
    }

    {%- comment -%}
    Transparent header over the first section (same condition theme.css uses): at rest it keeps the gap
    above it (the margin above). While it is scrolled but still transparent, its sticky offset is 0 (see
    below), so it slides up to the very top instead of hanging at the gap; the gap comes back, as the
    sticky offset, once the header is solid. The margin never changes, so the page doesn't shift when
    the header turns solid. The transition animates that sticky offset.
    {%- endcomment -%}
    :root:has(.shopify-section:first-child [allow-transparent-header]):not(:has(.shopify-section--header ~ .shopify-section-group-header-group)) #shopify-section-{{ section.id }} {
      transition: transform var(--header-solid-transition), visibility var(--header-solid-transition), top var(--header-solid-transition), background var(--header-solid-transition);
    }
  {%- endif -%}

  @media screen and (min-width: 700px) {
    :root {
      --header-icon-line-width: {{ settings.icon_stroke_width | times: section.settings.desktop_icon_size | divided_by: 16.0 }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    {%- case section.settings.mobile_layout -%}
      {%- when 'logo_left_navigation_right' -%}
        --header-grid: "logo secondary-nav" / auto minmax(0, 1fr);
      
      {%- when 'logo_with_menu_left_navigation_right' -%}
        --header-grid: "primary-nav logo secondary-nav" / auto auto minmax(0, 1fr);

      {%- when 'logo_center_navigation_split' -%}
        --header-grid: "primary-nav logo secondary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);
    {%- endcase -%}

    --header-transparent-header-text-color: {{ section.settings.transparent_header_text_color.rgb }};
    --header-non-transparent-text-color: {{ section.settings.color_scheme.settings.text_color.rgb }};
    --header-menu-gap: {{ section.settings.menu_items_spacing }}px;
    --header-icons-gap: {{ section.settings.icons_spacing }}px;
    {%- if section.settings.floating_header -%}
      /* The gap above the floating header (--header-top-gap, see :root above) is a margin, not
         padding, so it sits outside the section and the theme editor doesn't highlight it. */
      margin-block-start: var(--header-top-gap);
      position: relative;
    {%- endif -%}
  }

  {%- comment -%}
  Same lateral bump as footer/reviews/faq - only the sides (header-padding-block is left alone,
  it's already driven by the separate "header_height_padding" setting). --header-padding-inline
  is already var(--container-gutter) at every breakpoint (no existing mobile/desktop mismatch to
  fix here), so this just gives it the same +0.5rem extra room used everywhere else.
  {%- endcomment -%}
  {%- comment -%}
  Going back to transparent (scrolling up to the top of the page) uses a longer, gentler ease-in-out than
  turning solid (scrolling down). The same timing for both made the return read as a quick blink: the
  background, text color and logo cross-fade all finish together, so it needs more time to feel smooth.
  Set on the section wrapper (via :has) instead of on .header so the wrapper's own transitions (floating
  header's top offset and the gap above it) stay in step with the header's.
  {%- endcomment -%}
  #shopify-section-{{ section.id }}:has(.header:not(.is-solid)) {
    --header-solid-transition: .75s cubic-bezier(.45, 0, .25, 1);
  }

  {%- comment -%}
  Two-step choreography instead of everything changing at once: the background fades first, and the
  content (text color, logo cross-fade) follows after a short delay. Changing everything
  together passes through an awkward mid-point where the (already light) text sits on the (still light)
  background, or the (still dark) text on the dark hero, so it reads as a flicker. With the content
  delayed, the background has mostly settled before the text/logo swap, like a polished staged reveal.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} {
    --header-content-delay: .18s;
  }

  #shopify-section-{{ section.id }} .header {
    --header-padding-inline: calc(var(--container-gutter) + 0.5rem);
    transition: background var(--header-solid-transition), color var(--header-solid-transition) var(--header-content-delay), border-color var(--header-solid-transition){% if section.settings.floating_header %}, border-bottom-left-radius var(--header-solid-transition), border-bottom-right-radius var(--header-solid-transition){% endif %};
  }

  {%- if section.settings.floating_header -%}
    {%- comment -%}
    Floating header corners: at rest (top of the page, not scrolled) the bottom corners are as round as the top ones; once
    the page is scrolled (.is-scrolled, set by theme.js from the very first pixel of scroll, so it neither waits for the
    header-scroll-tracker nor follows the solid state the menu/search/cart drawers force) they go square again, instantly. Going back to round (scrolling up to the
    top) follows --header-solid-transition, like the background.

    Flush rule, automatic and per device: when the first section starts exactly where the header ends (no gap at all) the bottom
    corners stay square (.is-flush); with any gap they are round. theme.js (Header.updateFlushState) measures the real gap
    on load, on every resize / breakpoint change and when the header or the first section change size, so the same page can
    be flush on a phone and spaced on a desktop. No per-page or per-section list.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .header--floating:not(.is-scrolled, .is-flush) {
      border-bottom-left-radius: {{ section.settings.header_border_radius }}px;
      border-bottom-right-radius: {{ section.settings.header_border_radius }}px;
    }

    {%- comment -%}Not while a drawer is open, so the drawers' own opening timing below still wins there.{%- endcomment -%}
    :root:not(:has(header-menu-drawer[open], #search-drawer[open], #cart-drawer[open])) #shopify-section-{{ section.id }} .header--floating.is-scrolled {
      transition: background var(--header-solid-transition), color var(--header-solid-transition) var(--header-content-delay), border-color var(--header-solid-transition), border-bottom-left-radius 0s, border-bottom-right-radius 0s;
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .header__logo-image {
    transition: opacity var(--header-solid-transition) var(--header-content-delay);
  }

  {%- comment -%}
  Mobile menu drawer open: the header's bottom corners round off (only there) while the drawer unfolds below it, in step
  with it. The drawer is open exactly between show() and hide() (its [open] attribute), the same instants its unfold
  animation starts, and the radius uses that animation's own timing (theme.js createUnfoldAnimationControls, from the shared MOTION values: .7s with
  the decelerating curve opening, .45s with the exit curve closing) so both move together. The radius is the header's own
  corner radius when it floats, otherwise the drawers' radius; the inline radius on a floating header needs !important
  to be overridden.
  {%- endcomment -%}
  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      --header-menu-open-radius: {% if section.settings.floating_header %}{{ section.settings.header_border_radius }}px{% else %}var(--drawer-border-radius, 0px){% endif %};
    }

    #shopify-section-{{ section.id }} .header {
      transition: background var(--header-solid-transition), color var(--header-solid-transition) var(--header-content-delay), border-color var(--header-solid-transition), border-bottom-left-radius .45s cubic-bezier(.33, 0, .2, 1), border-bottom-right-radius .45s cubic-bezier(.33, 0, .2, 1);
    }

    :root:has(header-menu-drawer[open], #search-drawer[open], #cart-drawer[open]) #shopify-section-{{ section.id }} .header {
      border-bottom-left-radius: var(--header-menu-open-radius) !important;
      border-bottom-right-radius: var(--header-menu-open-radius) !important;
      transition: background var(--header-solid-transition), color var(--header-solid-transition) var(--header-content-delay), border-color var(--header-solid-transition), border-bottom-left-radius .7s cubic-bezier(.22, 1, .36, 1), border-bottom-right-radius .7s cubic-bezier(.22, 1, .36, 1);
    }
  }

  {%- comment -%}
  Hide-on-scroll slide (the header leaving/returning on scroll direction) uses the same softer timing
  instead of theme.css's .2s. visibility is transitioned with it so the header stays visible for the
  whole slide out and only switches off at the end.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} {
    transition: transform var(--header-solid-transition), visibility var(--header-solid-transition);
  }

  {%- comment -%}
  theme.css hides the header with translateY(-100%), which only moves it up by its own height. Now that the
  gap above a floating header is a margin (outside the section), the header sits that far below the top
  of the screen, so -100% left its bottom strip visible until visibility switched off at the end of the
  slide - it looked like it paused and then snapped away. Slide it out by its height plus that gap (plus a
  sticky announcement bar's height) so it leaves the screen completely.
  {%- endcomment -%}
  #shopify-section-{{ section.id }}:has(.header.is-hidden) {
    transform: translateY(calc(-100% - var(--header-stuck-gap, 0px) - var(--announcement-bar-is-sticky, 0) * var(--announcement-bar-height, 0px)));
  }

  {%- comment -%}
  Links and the nav separator carry their own short transitions in theme.css (.2s - .3s), so their text
  color lagged behind the header's background and logo when it turned solid. Their color/background now
  follow the same timing; the underline (background-size) keeps its own.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .link,
  #shopify-section-{{ section.id }} .link-faded,
  #shopify-section-{{ section.id }} .link-faded-reverse {
    transition: color var(--header-solid-transition) var(--header-content-delay), background-size .3s ease-in-out;
  }

  {%- comment -%}Hover/focus feedback on links must stay instant, so the content delay above doesn't apply to it.{%- endcomment -%}
  #shopify-section-{{ section.id }} .link:is(:hover, :focus-visible),
  #shopify-section-{{ section.id }} .link-faded:is(:hover, :focus-visible),
  #shopify-section-{{ section.id }} .link-faded-reverse:is(:hover, :focus-visible) {
    transition-delay: 0s;
  }

  #shopify-section-{{ section.id }} .header__secondary-nav-separator {
    transition: background var(--header-solid-transition);
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- case section.settings.desktop_layout -%}
        {%- when 'logo_left_navigation_inline' -%}
          --header-grid: "logo primary-nav secondary-nav" / auto minmax(0, 1fr) auto;

        {%- when 'logo_left_navigation_center' -%}
          --header-grid: "logo primary-nav secondary-nav" / minmax(max-content, 1fr) auto minmax(max-content, 1fr);

        {%- when 'logo_left_navigation_end' -%}
          --header-grid: "logo primary-nav secondary-nav" / auto minmax(0, 1fr) auto;

        {%- else -%}
          --header-grid: "primary-nav logo secondary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);
      {%- endcase -%}
    }
  }

  {%- if section.settings.enable_sticky -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
    }

    .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }} {
      top: calc(var(--announcement-bar-is-sticky, 0) * var(--announcement-bar-height, 0px));
    }

    {%- if section.settings.floating_header -%}
      {%- comment -%}
      Once stuck, keep the same half-section gap above the header that it has at the top of the page,
      and paint that gap with the page background so content doesn't show through it while scrolling.
      {%- endcomment -%}
      #shopify-section-{{ section.id }},
      .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }} {
        top: calc(var(--header-stuck-gap) + var(--announcement-bar-is-sticky, 0) * var(--announcement-bar-height, 0px) - var(--header-bar-overlap, 0px));
      }

      :root:has(.shopify-section:first-child [allow-transparent-header]):not(:has(.shopify-section--header ~ .shopify-section-group-header-group)) #shopify-section-{{ section.id }}:has(.header:not(.is-solid)),
      :root:has(.shopify-section:first-child [allow-transparent-header]):not(:has(.shopify-section--header ~ .shopify-section-group-header-group)) .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }}:has(.header:not(.is-solid)) {
        top: calc(var(--announcement-bar-is-sticky, 0) * var(--announcement-bar-height, 0px));
      }

      #shopify-section-{{ section.id }}::before {
        content: "";
        position: absolute;
        inset-inline: 0;
        inset-block-end: 100%;
        height: var(--header-before-gap, var(--header-stuck-gap));
        background: rgb(var(--page-background));
        pointer-events: none;
        transition: background var(--header-solid-transition);
      }

      {%- comment -%}
      Transparent header over the first section (same condition theme.css uses to make the header
      transparent): while it hasn't turned solid yet, this gap stays transparent too, so no white band
      shows above it during the first scroll. It is painted once the header is solid.
      {%- endcomment -%}
      :root:has(.shopify-section:first-child [allow-transparent-header]):not(:has(.shopify-section--header ~ .shopify-section-group-header-group)) #shopify-section-{{ section.id }}:has(.header:not(.is-solid))::before {
        background: transparent;
      }
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.logo != blank -%}
    #shopify-section-{{ section.id }} {
      --header-logo-width: {{ section.settings.logo_mobile_max_width }}px;
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --header-logo-width: {{ section.settings.logo_max_width }}px;
      }
    }
  {%- endif -%}

  /* Menu links, Menu/Account/Search/Cart labels all use ".subheading" (its own
     typography, separate from headings), and the logo text (when no logo image
     is set) uses ".heading". The header should only ever inherit the Body Text
     typeface, not Heading/Subheading - override the typeface here (family,
     style, weight, letter-spacing, text-transform) on both classes so these
     header texts fully inherit the Body typography instead, without touching
     the global ".subheading"/".heading" rules used elsewhere in the theme.
     Font-size/line-height are intentionally left alone (kept from whichever of
     ".subheading"/".heading" is in play): there is no dedicated nav-sized
     "--text-font-size" scale that would replace either one's own sizing.

     The ".menu-drawer .subheading" selector (not scoped to this section's ID)
     is needed on top of the section-scoped one: <header-menu-drawer append-to-body>
     gets physically moved to be a direct child of <body> while open (see
     "shouldAppendToBody" in theme.js), which takes it out of
     "#shopify-section-{{ section.id }}" — so the Account link's text inside the
     mobile drawer would otherwise fall back to the plain Subheading look. */
  #shopify-section-{{ section.id }} .subheading,
  #shopify-section-{{ section.id }} .heading,
  .menu-drawer .subheading {
    font-family: var(--text-font-family);
    font-style: var(--text-font-style);
    font-weight: var(--text-font-weight);
    letter-spacing: var(--text-letter-spacing);
    text-transform: var(--text-transform);
  }

  /* "Show text instead of icons" hides the icon on desktop entirely (it's md:hidden), so if the
     merchant leaves Account/Search/Cart text blank, that .subheading span renders empty. Since
     ".header__secondary-nav" is a flex row with a column-gap, an empty flex item still reserves
     a gap on both sides of it, leaving a blank hole in the header. Hiding the whole <li> when its
     text span is empty removes that reserved gap. Desktop-only (min-width: 1000px), since on
     mobile the icon (not this text span) is what's shown regardless of the text setting. */
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .header__account-link:has(.subheading:empty),
    #shopify-section-{{ section.id }} .header__search-link:has(.subheading:empty),
    #shopify-section-{{ section.id }} .header__cart-link:has(.subheading:empty) {
      display: none;
    }
  }

  {%- comment -%}
  Cart icon: the bag and a happy face share one cell. When a product is added (script below sets .is-added for a moment) the bag spins and shrinks
  away while the face springs in (a little overshoot), draws its smile and blinks once; when .is-added goes away it all plays backwards, the bag
  coming back with the same spring. Both are the same icon family (same grid, stroke width and color). With reduced motion it is only a quick
  cross-fade, no spinning or scaling.
  {%- endcomment -%}
  {%- comment -%}
  A block-level grid, not inline-grid: an inline box sits on the text baseline and its line box adds the text's ascent/descent around the icon
  (the same thing the "Icons alignment" rule below avoids by making each svg a block), which made the cart icon's link taller than the others.
  As a block it is exactly as tall as the icon, like the bare svg it replaces.
  {%- endcomment -%}
  .header__cart-icon {
    display: grid;
    place-items: center;
  }

  .header__cart-icon > .icon {
    grid-area: 1 / 1;
    transform-origin: center;
    transition: transform .55s cubic-bezier(.34, 1.56, .64, 1), opacity .25s ease;
  }

  .header__cart-icon-smile {
    opacity: 0;
    transform: scale(.3) rotate(-120deg);
  }

  .header__cart-icon.is-added .header__cart-icon-bag {
    opacity: 0;
    transform: scale(.3) rotate(120deg);
  }

  .header__cart-icon.is-added .header__cart-icon-smile {
    opacity: 1;
    transform: none;
  }

  .header__cart-icon-smile .cart-smile__mouth {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset .3s ease;
  }

  .header__cart-icon.is-added .cart-smile__mouth {
    stroke-dashoffset: 0;
    transition-delay: .2s;
  }

  .header__cart-icon.is-added .cart-smile__eye {
    transform-box: fill-box;
    transform-origin: center;
    animation: header-cart-smile-blink .5s ease .9s 1;
  }

  {%- comment -%}
  While the cart has items the bag is filled solid, in the same color as its stroke (only the bag's body: the handle stays an outline). It replaces the
  small dot that used to flag a non-empty cart over the icon, so that dot is made invisible wherever the icon shows (it stays in the page for screen
  readers, which still read the count from it).
  {%- endcomment -%}
  .header__cart-icon .cart-bag__body {
    transition: fill .35s ease;
  }

  .header__cart-icon.has-items .cart-bag__body {
    fill: currentColor;
  }

  .header__cart-link:has(> a > .header__cart-icon) .header__active-dot {
    opacity: 0;
  }

  @media screen and (max-width: 999px) {
    .header__cart-link:has(> a > .md\:hidden > .header__cart-icon) .header__active-dot {
      opacity: 0;
    }
  }

  @keyframes header-cart-smile-blink {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(.1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__cart-icon > .icon {
      transition: opacity .2s ease;
    }

    .header__cart-icon-smile,
    .header__cart-icon.is-added .header__cart-icon-bag {
      transform: none;
    }

    .header__cart-icon.is-added .cart-smile__eye {
      animation: none;
    }
  }

  #shopify-section-{{ section.id }} .header__cart-count-text {
    font-family: var(--text-font-family);
    font-style: var(--text-font-style);
    font-weight: var(--text-font-weight);
  }

  {%- comment -%}
  Icons alignment. Every icon control is built the same way - a flex item (<li> or <a>/<button>) holding an <svg> -
  and the header centers each of them on the row. An inline <svg> sits on the text baseline, and its line box adds
  the text's ascent/descent around it, so the icon ends up a few px off the center of its box; as a block it is
  exactly its own height. That is the only thing needed to put all of them (menu, search, account, cart) on the same
  center line - no item gets a box layout of its own (the cart used to, and sat at a different height than the rest).
  Not touching "display" on the items themselves matters too: the md:hidden / md-max:hidden classes some of them carry
  rely on it.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .header__primary-nav svg,
  #shopify-section-{{ section.id }} .header__secondary-nav svg {
    display: block;
    flex: none;
  }

  {%- comment -%}
  Cart count as a number (when "Show cart count as a dot" is off): the icon and the count are laid out as one row,
  vertically centered on each other, with a fixed small gap, instead of a number floating at the icon's baseline. The
  count is smaller than the body text, with a line height of 1 and tabular digits so it neither lifts the row nor
  changes its width as the digits change. When the cart is empty it is simply "(0)", same as before.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .header__cart-link > a:has(> .header__cart-count-text) {
    display: flex;
    align-items: center;
    gap: .3rem;
  }

  #shopify-section-{{ section.id }} .header__cart-link > a > .header__cart-count-text {
    margin-inline-start: 0;
    font-size: .8125rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  {%- comment -%}With text instead of icons the count belongs to the label: it keeps the label's size and its small gap{%- endcomment -%}
  #shopify-section-{{ section.id }} .header__cart-link .subheading > .header__cart-count-text {
    font-size: inherit;
    line-height: inherit;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  {%- comment -%}The dot: a little bigger and ringed with the header's background so it reads clearly over the icon's edge{%- endcomment -%}
  #shopify-section-{{ section.id }} .header__active-dot {
    width: 6px;
    height: 6px;
    inset-block-start: -3px;
    inset-inline-end: -3px;
    box-shadow: 0 0 0 1.5px rgb(var(--background));
  }

  {%- if header_logo_only -%}
    /* FAQ page only: navigation/secondary-nav markup is skipped below, so the grid
       only ever has a "logo" area left. Force it to a single full-width column
       (overriding the mobile/desktop --header-grid set above) and center the logo
       within it, so centering is relative to the header's full width rather than
       whatever space happened to be left over. */
    #shopify-section-{{ section.id }} {
      --header-grid: "logo" / minmax(0, 1fr) !important;
    }

    #shopify-section-{{ section.id }} .header__logo {
      justify-self: center !important;
    }

    /* Overrides "enable_sticky" (and floating_header's position:relative) for this
       page only: the header should scroll away with the page instead of staying
       pinned to the top. */
    #shopify-section-{{ section.id }} {
      position: static !important;
    }

    #shopify-section-{{ section.id }}::before {
      display: none;
    }
  {%- endif -%}
  {%- if template.suffix == 'contact' or template.suffix == 'libro-reclamaciones' or request.page_type == 'policy' -%}
    /* Contact, complaints book and policy pages only: no announcement bar, and the header stays where it is at the top of the page
       (static) instead of following the scroll. Its top corners keep the header's radius (inline style on .header). */
    .shopify-section--announcement-bar {
      display: none !important;
    }

    #shopify-section-{{ section.id }} {
      position: static !important;
    }

    #shopify-section-{{ section.id }}::before {
      display: none;
    }
  {%- endif -%}
</style>

<height-observer variable="header">
  <x-header class="header {% if section.settings.floating_header %}header--floating{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }}" {% if section.settings.hide_on_scroll and header_logo_only == false %}hide-on-scroll{% endif %} style="padding-block: {{ section.settings.header_height_padding }}px; {% if section.settings.floating_header %}border-top-left-radius: {{ section.settings.header_border_radius }}px; border-top-right-radius: {{ section.settings.header_border_radius }}px;{% endif %}">
    {%- comment -%}
    --------------------------------------------------------------------------------------------------------------------
    LOGO AREA
    --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- capture logo_content -%}
      {%- if section.settings.logo != blank -%}
        {%- capture sizes -%}{{ section.settings.logo_max_width }}px{%- endcapture -%}
        {%- capture widths -%}{{ section.settings.logo_max_width | times: 2 | at_most: section.settings.logo.width }}, {{ section.settings.logo_max_width | times: 3 | at_most: section.settings.logo.width }}{%- endcapture -%}

        <span class="sr-only">{{ shop.name }}</span>

        {%- assign alt_text = section.settings.logo.alt | default: shop.name -%}
        {{- section.settings.logo | image_url: width: section.settings.logo.width | image_tag: sizes: sizes, widths: widths, alt: alt_text, fetchpriority: 'high', class: 'header__logo-image' -}}

        {%- if section.settings.transparent_logo -%}
          {{- section.settings.transparent_logo | image_url: width: section.settings.transparent_logo.width | image_tag: sizes: sizes, widths: widths, alt: '', class: 'header__logo-image header__logo-image--transparent' -}}
        {%- endif -%}
      {%- else -%}
        <p class="header__logo-text heading">{{ shop.name }}</p>
      {%- endif -%}
    {%- endcapture -%}

    {%- comment -%}
    The logo is never an <h1>, not even on the home page: the page's <h1> is its main content heading (layout/theme.liquid
    guarantees there is exactly one per page), so the logo link is the same plain link everywhere.
    {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="header__logo">{{ logo_content }}</a>

    {%- comment -%}
    --------------------------------------------------------------------------------------------------------------------
    PRIMARY NAVIGATION AREA
    --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- assign menu = section.settings.menu -%}
    {%- assign sidebar_menu = section.settings.sidebar_menu -%}
    {%- assign has_menu_links = false -%}
    {%- if menu.links.size > 0 or sidebar_menu.links.size > 0 -%}
      {%- assign has_menu_links = true -%}
    {%- endif -%}

    {%- if header_logo_only == false and has_menu_links -%}
      {%- liquid
        assign primary_nav_extra_classes = ''

        if open_dropdown_menu_in_sidebar
          assign primary_nav_extra_classes = primary_nav_extra_classes | append: ' header__primary-nav--open-menu-in-sidebar'
        endif

        case section.settings.mobile_layout
          when 'logo_left_navigation_right'
            assign primary_nav_extra_classes = primary_nav_extra_classes | append: ' hidden md:flex'
        endcase

        case section.settings.desktop_layout
          when 'logo_left_navigation_center'
            assign primary_nav_extra_classes = primary_nav_extra_classes | append: ' md:justify-center'

          when 'logo_left_navigation_end'
            assign primary_nav_extra_classes = primary_nav_extra_classes | append: ' md:justify-end'
        endcase
      -%}

      <nav class="header__primary-nav {{ primary_nav_extra_classes }}" aria-label="{{ 'header.general.primary_navigation' | t | escape }}">
        <button type="button" aria-controls="menu-drawer" class="tap-area {% unless section.settings.desktop_layout == 'drawer' %}md:hidden{% endunless %}">
          <span class="sr-only">{{ 'header.general.menu' | t }}</span>

          <div class="h-stack gap-3" aria-hidden="true">
            <div class="header__hamburger">
              <span></span>
              <span></span>
            </div>

            <span class="subheading md-max:hidden">{{ 'header.general.menu' | t }}</span>
          </div>
        </button>

        {%- if section.settings.mobile_layout == 'logo_center_navigation_split' -%}
          <a href="{{ routes.search_url }}" class="header__search-link tap-area md:hidden" aria-controls="search-drawer">
            <span class="sr-only">{{ 'header.general.search' | t }}</span>
            {%- render 'icon' with 'search', mobile_width: 16, width: section.settings.desktop_icon_size -%}
          </a>
        {%- endif -%}

        {%- if menu.links.size > 0 and section.settings.desktop_layout != 'drawer' -%}
          <ul class="contents unstyled-list md-max:hidden">
            {%- if open_dropdown_menu_in_sidebar -%}
              <li class="contents">
                <button type="button" aria-controls="menu-dropdown-sidebar" class="tap-area">
                  <span class="sr-only">{{ 'header.general.menu' | t }}</span>

                  <div class="header__hamburger">
                    <span></span>
                    <span></span>
                  </div>
                </button>
              </li>
            {%- endif -%}

            {%- for link in menu.links -%}
              {% liquid
                assign link_title_downcase = link.title | strip | downcase
                assign mega_menu_block = ''

                for block in section.blocks
                  assign menu_item_downcase = block.settings.menu_item | strip | downcase

                  if menu_item_downcase == link_title_downcase
                    assign mega_menu_block = block
                    break
                  endif

                endfor
              %}

              <li>
                {%- liquid
                  assign has_dropdown_menu = false
                  assign menu_id = 'header-menu-dropdown-' | append: forloop.index
                  
                  if link.levels > 0 or mega_menu_block != ''
                    assign has_dropdown_menu = true
                  endif
                -%}

                <a href="{{ link.url }}" class="block subheading link-reversed" {% if link.current %}aria-current="page"{% endif %} {% if open_dropdown_menu_in_sidebar and has_dropdown_menu %}aria-expanded="false" aria-controls="menu-dropdown-sidebar" data-link-position="{{ forloop.index }}" {% if section.settings.menu_open_trigger == 'hover' %}data-open-on-hover{% endif %}{% elsif has_dropdown_menu %}aria-expanded="false" aria-controls="{{ menu_id }}" {% if section.settings.menu_open_trigger == 'hover' %}data-open-on-hover{% endif %}{% endif %}>
                  {{- link.title -}}
                </a>

                {%- if has_dropdown_menu and open_dropdown_menu_in_sidebar == false -%}
                  {%- if mega_menu_block == '' -%}
                    <header-dropdown-menu class="header__dropdown-menu color-scheme color-scheme--{{ section.settings.color_scheme.id }}" id="{{ menu_id }}">
                      <ul class="unstyled-list">
                        {%- for sub_link in link.links -%}
                          {%- assign sub_menu_id = menu_id | append: '-' | append: forloop.index -%}

                          <li>
                            <a href="{{ sub_link.url }}" class="subheading link-faded-reverse" {% if sub_link.current %}aria-current="page"{% endif %} {% if sub_link.levels > 0 %}aria-expanded="false" aria-controls="{{ sub_menu_id }}" {% if section.settings.menu_open_trigger == 'hover' %}data-open-on-hover{% endif %}{% endif %}>
                              {{- sub_link.title -}}

                              {%- if sub_link.levels > 0 -%}
                                {%- render 'icon' with 'chevron-right', direction_aware: true -%}
                              {%- endif -%}
                            </a>

                            {%- if sub_link.levels > 0 -%}
                              <header-dropdown-menu class="header__dropdown-menu color-scheme color-scheme--{{ section.settings.color_scheme.id }}" id="{{ sub_menu_id }}">
                                <ul class="unstyled-list">
                                  {%- for sub_sub_link in sub_link.links -%}
                                    <li>
                                      <a href="{{ sub_sub_link.url }}" class="subheading link-faded-reverse" {% if sub_sub_link.current %}aria-current="page"{% endif %}>{{ sub_sub_link.title }}</a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </header-dropdown-menu>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </header-dropdown-menu>
                  {%- else -%}
                    {%- render 'mega-menu', link: link, color_scheme: section.settings.color_scheme, id: menu_id, block: mega_menu_block -%}
                  {%- endif -%}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </nav>
    {%- endif -%}

    {%- comment -%}
    --------------------------------------------------------------------------------------------------------------------
    SECONDARY NAVIGATION AREA
    --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- unless header_logo_only -%}
    <nav class="header__secondary-nav" aria-label="{{ 'header.general.secondary_navigation' | t | escape }}">
      <ul class="contents unstyled-list">
        {%- if show_country_selector or show_locale_selector -%}
          <li class="hidden md:contents">
            <div class="h-stack justify-between">
              {%- if show_country_selector or show_locale_selector -%}
                <div class="h-stack gap-5">
                  {%- liquid
                    if show_country_selector
                      render 'localization-selector', type: 'country', show_country_name: section.settings.show_country_name, show_country_flag: section.settings.show_country_flag, preferred_alignment: 'start', id_prefix: 'secondary-nav'
                    endif

                    if show_locale_selector
                      render 'localization-selector', type: 'locale', preferred_alignment: 'start', id_prefix: 'secondary-nav' 
                    endif
                  -%}
                </div>
              {%- endif -%}
            </div>

            <hr class="header__secondary-nav-separator" />
          </li>
        {%- endif -%}

        {%- comment -%}Offer a hook for apps to integrate into the header to add their own icon, for instance{%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <li>
              {%- render block -%}
            </li>
          {%- endif -%}
        {%- endfor -%}

        {%- if shop.customer_accounts_enabled -%}
          <li class="header__account-link md-max:hidden">
            {%- comment -%}
            Signed in: keep <shopify-account> (avatar + its account sheet with menu links - useful
            once there's an actual account to manage). Signed out: skip it entirely and link
            straight to the login page instead - <shopify-account>'s own signed-out click always
            opens its account sheet in place, with no attribute to make it navigate directly (see
            https://shopify.dev/docs/api/storefront-web-components/components/shopify-account).
            {%- endcomment -%}
            {%- if customer -%}
              {%- comment -%} Signed-in avatar is the component's own native rendering - no slot content to provide, same as before this change. {%- endcomment -%}
              <shopify-account menu="{{ section.settings.customer_account_menu }}"></shopify-account>
            {%- else -%}
              <a href="{{ routes.account_login_url }}" class="tap-area">
                {%- if section.settings.show_icons_text -%}
                  <span class="subheading md-max:hidden">{{ section.settings.account_text }}</span>
                  <span class="md:hidden">
                    {%- render 'icon' with 'account', mobile_width: 16, width: section.settings.desktop_icon_size -%}
                  </span>
                  <span class="sr-only">{{ section.settings.account_text }}</span>
                {%- else -%}
                  <span class="sr-only">{{ 'header.general.login' | t }}</span>
                  {%- render 'icon' with 'account', mobile_width: 16, width: section.settings.desktop_icon_size -%}
                {%- endif -%}
              </a>
            {%- endif -%}
          </li>
        {%- endif -%}

        <li class="header__news-link" hidden>
          <news-modal-button class="contents">
            <button class="tap-area" aria-controls="news-modal" aria-expanded="false">
              <span class="sr-only">{{ 'header.general.news_modal' | t }}</span>
              {%- render 'icon' with 'bell', mobile_width: 16, width: section.settings.desktop_icon_size -%}
            </button>
          </news-modal-button>
        </li>

        <li class="header__search-link {% if section.settings.mobile_layout == 'logo_center_navigation_split' %}md-max:hidden{% endif %}">
          <a href="{{ routes.search_url }}" class="block tap-area" aria-controls="search-drawer">
            {%- if section.settings.show_icons_text -%}
              <span class="subheading md-max:hidden">{{ section.settings.search_text }}</span>
               <span class="md:hidden">
                {%- render 'icon' with 'search', mobile_width: 16, width: section.settings.desktop_icon_size -%}
              </span>
              <span class="sr-only">{{ section.settings.search_text }}</span>
            {%- else -%}
              <span class="sr-only">{{ 'header.general.search' | t }}</span>
              {%- render 'icon' with 'search', mobile_width: 16, width: section.settings.desktop_icon_size -%}
            {%- endif -%}
          </a>
        </li>

        {%- if shop.customer_accounts_enabled -%}
          {%- comment -%}
          Mobile only (the desktop account link above is hidden below 1000px): the account icon sits right next to the cart.
          Same logic as the desktop one: signed in keeps <shopify-account> (avatar + account sheet), signed out links straight
          to the login page. Always the icon, never text.
          {%- endcomment -%}
          <li class="header__account-link header__account-link--mobile md:hidden">
            {%- if customer -%}
              <shopify-account menu="{{ section.settings.customer_account_menu }}"></shopify-account>
            {%- else -%}
              <a href="{{ routes.account_login_url }}" class="block tap-area">
                <span class="sr-only">{{ 'header.general.login' | t }}</span>
                {%- render 'icon' with 'account', mobile_width: 16, width: section.settings.desktop_icon_size -%}
              </a>
            {%- endif -%}
          </li>
        {%- endif -%}

        <li class="header__cart-link relative">
          <a href="{{ routes.cart_url }}" class="block tap-area" {% if settings.cart_type != 'page' and request.page_type != 'cart' %}aria-controls="cart-drawer"{% endif %} data-no-instant>
            {%- if section.settings.show_icons_text -%}
              {%- if section.settings.show_cart_count_as_dot -%}
                <span class="subheading md-max:hidden">{{ section.settings.cart_text }}</span>
                <span class="md:hidden">
                  {%- render 'header-cart-icon', mobile_width: 16, width: section.settings.desktop_icon_size -%}
                </span>
              {%- else -%}
                <span class="subheading">{{ section.settings.cart_text }} <cart-count class="header__cart-count-text">(<span>{{ cart.item_count }}</span>)</cart-count></span>
              {%- endif -%}
              <span class="sr-only">{{ section.settings.cart_text }}</span>
            {%- else -%}
              <span class="sr-only">{{ 'header.general.cart' | t }}</span>
              {%- render 'header-cart-icon', mobile_width: 16, width: section.settings.desktop_icon_size -%}
              {%- unless section.settings.show_cart_count_as_dot -%}
                <cart-count class="header__cart-count-text">(<span>{{ cart.item_count }}</span>)</cart-count>
              {%- endunless -%}
            {%- endif -%}
          </a>

          {%- if section.settings.show_cart_count_as_dot -%}
            <cart-count class="header__active-dot" {%- if cart.empty? -%}hidden{% endif %}>
              <span class="sr-only">{{ 'cart.general.item_count' | t: count: cart.item_count }}</span>
            </cart-count>
          {%- endif -%}
        </li>

        {%- if section.settings.mobile_layout == 'logo_left_navigation_right' -%}
          <li class="header__menu-link md:hidden">
            <button class="block tap-area" type="button" aria-controls="menu-drawer">
              <span class="sr-only">{{ 'header.general.menu' | t }}</span>

              <div class="h-stack gap-3" aria-hidden="true">
                <div class="header__hamburger">
                  <span></span>
                  <span></span>
                </div>
              </div>
            </button>
          </li>
        {%- endif -%}
      </ul>
    </nav>

    {%- comment -%}
    ------------------------------------------------------------------------------------------------------------------
    DRAWER MENU
    -----------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- assign primary_menu = section.settings.drawer_menu | default: section.settings.menu -%}

    {%- render 'main-menu-drawer',
      primary_menu: primary_menu,
      secondary_menu: section.settings.secondary_menu,
      show_nested_menu_indicator: section.settings.drawer_show_nested_menu_indicator,
      show_country_selector: show_country_selector,
      show_country_name: section.settings.show_country_name,
      show_country_flag: section.settings.show_country_flag,
      show_locale_selector: show_locale_selector,
      color_scheme: section.settings.color_scheme
    -%}

    {%- comment -%}
    ------------------------------------------------------------------------------------------------------------------
    SIDEBAR MENU FOR DROPDOWN ITEM

    This is a special mode that can be enabled by setting the desktop layout to "logo center, navigation inline" and
    the dropdown menu style to "sidebar". When configured like this, the dropdown menu will open in a lateral sidebar
    -----------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- if open_dropdown_menu_in_sidebar -%}
      {%- render 'main-menu-dropdown-sidebar',
        primary_menu: section.settings.menu,
        secondary_menu: section.settings.secondary_menu,
        color_scheme: section.settings.color_scheme
      -%}
    {%- endif -%}
    {%- endunless -%}
  </x-header>
</height-observer>

<script>
  {%- comment -%}
  Early synchronous fallback for --header-height, so sections that compensate for it (allow-transparent-header)
  don't flash unpadded before <height-observer> upgrades (its own ResizeObserver only fires once theme.js loads
  and connects it). Must measure the same element height-observer measures (<x-header> itself, via its wrapper's
  clientHeight - height-observer is display: block with no padding/border of its own, so their heights match) -
  not #shopify-section-{{ section.id }}, which is taller than <x-header> when "Floating header" is on (it alone
  carries the extra padding-block-start for the header's white gutter). Measuring the wrong one here is what
  desynced the transparent-header compensation padding from the header's actual height on floating headers.
  {%- endcomment -%}
  (function() {
    var header = document.querySelector('#shopify-section-{{ section.id }} .header');

    if (header) {
      document.documentElement.style.setProperty('--header-height', Math.round(header.clientHeight) + 'px');
    }
  })();

  {%- comment -%}
  Cart icon: turns into a happy face for a moment whenever a product is added (variant:add, the same event the cart drawer and the count react to),
  and the bag is filled solid while the cart has items (.has-items, set here on every cart change; the first paint comes from the snippet). After an add
  the fill waits until the face is gone, so the order is: bag, face, filled bag. Listens on the document once for the whole page (the guard keeps the
  theme editor's re-renders of this section from stacking listeners); the icons are looked up on every event, so it works on whichever copy of the header
  is on screen.
  {%- endcomment -%}
  (function() {
    if (window.cartSmileInitialized) return;
    window.cartSmileInitialized = true;

    var timer;
    var pending = false;
    var latest = null;

    function setFilled(filled) {
      document.querySelectorAll('.header__cart-icon').forEach(function(icon) { icon.classList.toggle('has-items', filled); });
    }

    document.addEventListener('cart:change', function(event) {
      var detail = event.detail || {};

      if (detail.cart) latest = detail.cart.item_count > 0;

      if (detail.baseEvent !== 'variant:add') {
        // While the face is showing, the fill waits for it to go; otherwise it follows the cart right away.
        if (!pending && latest !== null) setFilled(latest);
        return;
      }

      var icons = document.querySelectorAll('.header__cart-icon');
      if (!icons.length) return;

      icons.forEach(function(icon) { icon.classList.add('is-added'); });

      pending = true;
      clearTimeout(timer);
      timer = setTimeout(function() {
        pending = false;
        document.querySelectorAll('.header__cart-icon').forEach(function(icon) { icon.classList.remove('is-added'); });
        if (latest !== null) setFilled(latest);
      }, 2200);
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "shopify-section--header",
  "tag": "header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:sections.header.enable_sticky_header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_on_scroll",
      "label": "t:sections.header.hide_on_scroll",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "floating_header",
      "label": "t:sections.header.floating_header",
      "info": "t:sections.header.floating_header_info",
      "default": false
    },
    {
      "type": "range",
      "id": "header_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:sections.header.header_border_radius",
      "default": 0,
      "visible_if": "{{ section.settings.floating_header }}"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "t:sections.header.mobile_layout",
      "options": [
        {
          "value": "logo_left_navigation_right",
          "label": "t:sections.header.mobile_layout_options.logo_left_navigation_right"
        },
        {
          "value": "logo_with_menu_left_navigation_right",
          "label": "t:sections.header.mobile_layout_options.logo_with_menu_left_navigation_right"
        },
        {
          "value": "logo_center_navigation_split",
          "label": "t:sections.header.mobile_layout_options.logo_center_navigation_split"
        }
      ],
      "default": "logo_center_navigation_split"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "t:sections.header.desktop_layout",
      "options": [
        {
          "value": "logo_left_navigation_inline",
          "label": "t:sections.header.desktop_layout_options.logo_left_navigation_inline"
        },
        {
          "value": "logo_left_navigation_center",
          "label": "t:sections.header.desktop_layout_options.logo_left_navigation_center"
        },
        {
          "value": "logo_left_navigation_end",
          "label": "t:sections.header.desktop_layout_options.logo_left_navigation_end"
        },
        {
          "value": "logo_center_navigation_inline",
          "label": "t:sections.header.desktop_layout_options.logo_center_navigation_inline"
        },
        {
          "value": "drawer",
          "label": "t:sections.header.desktop_layout_options.drawer"
        }
      ],
      "default": "logo_left_navigation_inline"
    },
    {
      "type": "header",
      "content": "t:sections.header.logo_category"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:global.image.image",
      "info": "t:sections.header.logo_size_recommendation"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 20,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "t:global.image.width",
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_mobile_max_width",
      "min": 20,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "t:global.image.mobile_width",
      "default": 100
    },
    {
      "type": "range",
      "id": "header_height_padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Relleno del header",
      "default": 10
    },
    {
      "type": "header",
      "content": "t:sections.header.navigation_category"
    },
