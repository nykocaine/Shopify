{%- liquid
  assign text_alignment = 'start'

  # icon_alignment only ever moves the icon, never the title. icon_justify_self is the icon's own
  # justify-self (side-by-side layouts, a grid) or align-self (stacked layouts, a flex column) -
  # both accept the same start/center/end keywords, so one variable covers either case.
  assign icon_justify_self = 'start'

  case section.settings.icon_alignment
    when 'center'
      assign icon_justify_self = 'center'
    when 'right'
      assign icon_justify_self = 'end'
  endcase

  # icon_position picks which side of the title the icon sits on. Side by side (left/right), this
  # is a 2-column grid with one named area per element - the title's area/column is always "auto"
  # (its own content width) and the icon's is always "1fr" (the rest of the row, for it to roam
  # across via icon_justify_self above), regardless of which column each lands in, since grid-area
  # ties each element to its column by name rather than by source order. Stacked (above/below) is a
  # plain flex column instead - its cross-axis alignment (align-items/align-self) is already
  # per-item independent of source order, so no grid trick is needed there.
  assign icon_display = 'grid'
  assign icon_grid_template_columns = 'auto 1fr'
  assign icon_grid_template_areas = '"title icon"'
  assign icon_flex_direction = 'column'

  case section.settings.icon_position
    when 'left'
      assign icon_grid_template_columns = '1fr auto'
      assign icon_grid_template_areas = '"icon title"'
    when 'above'
      assign icon_display = 'flex'
      assign icon_flex_direction = 'column-reverse'
    when 'below'
      assign icon_display = 'flex'
      assign icon_flex_direction = 'column'
  endcase
-%}

  {%- capture section_header -%}
    <div class="v-stack justify-items-{{ text_alignment }} gap-6 sm:gap-8">
      {%- if section.settings.subheading != blank or section.settings.title != blank or section.settings.content != blank or section.settings.show_icon -%}

        <div class="prose prose-justify-{{ text_alignment }} w-full">
          {%- render 'subheading', content: section.settings.subheading -%}

          {%- if section.settings.title != blank or section.settings.show_icon -%}
            <div class="contact-heading-row">
              {%- if section.settings.title != blank -%}
                <div class="contact-heading-row__title">
                  {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_size, html_tag: 'h2' -%}
                </div>
              {%- endif -%}

              {%- if section.settings.show_icon -%}
                <div class="contact-heading-row__icon">
                  {%- render 'decorative-icon',
                    icon_type: section.settings.icon_type,
                    icon_size: section.settings.icon_size,
                    icon_spin: section.settings.icon_spin,
                    icon_primary_color: section.settings.icon_primary_color,
                    icon_secondary_color: section.settings.icon_secondary_color,
                    icon_border_color: section.settings.icon_border_color
                  -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- comment -%} Full section width (no max-w-sm cap), so the text isn't inset with what looks
          like right-hand padding. w-full on .prose overrides the v-stack's justify-items: start
          shrink-to-fit so the block fills its column. {%- endcomment -%}
          <div class="w-full">
            {{- section.settings.content -}}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_social_media -%}
        {%- render 'social-media' -%}
      {%- endif -%}
    </div>
  {%- endcapture -%}

  {%- capture section_main_content -%}

    {%- form 'contact', class: 'form' -%}
      {%- if form.posted_successfully? -%}
        {%- assign content = 'contact.form.success_message' | t -%}
        {%- render 'banner', status: 'success', content: content, text_alignment: text_alignment -%}
      {%- endif -%}

      {%- if form.errors -%}
        {%- capture content -%}{{ form.errors.translated_fields[form.errors.first] | capitalize }} {{ form.errors.messages[form.errors.first] }}{%- endcapture -%}
        {%- render 'banner', status: 'error', content: content, text_alignment: text_alignment -%}
      {%- endif -%}

      <div class="fieldset">
        <div class="fieldset-row">
          {%- assign label  = 'contact.form.name' | t -%}
          {%- render 'input', type: 'text', name: 'contact[name]', label: label, value: customer.name, required: true, autocomplete: 'name' -%}

          {%- assign label  = 'contact.form.email' | t -%}
          {%- render 'input', type: 'email', name: 'contact[email]', label: label, value: customer.email, required: true, autocomplete: 'email' -%}
        </div>

        {%- for block in section.blocks -%}
          {%- assign field_title = block.settings.title -%}

          {%- if block.type == 'product' -%}
            {%- assign field_title = 'general.on_boarding.product_title' | t -%}
          {%- elsif field_title == blank -%}
            {%- capture field_title -%}Custom field {% increment custom_field %}{%- endcapture -%}
          {%- endif -%}

          {%- capture name -%}contact[{{ field_title | escape }}]{%- endcapture -%}

          {%- liquid
            if block.type == 'text'
              if block.settings.use_long_text
                render 'input', name: name, label: block.settings.title, required: block.settings.required, multiline: 5
              else
                render 'input', type: 'text', name: name, label: block.settings.title, required: block.settings.required
              endif
            elsif block.type == 'dropdown' and block.settings.values != blank
              assign values = block.settings.values | split: ','
              render 'select', option_values: values, show_empty_value: true, name: name, label: block.settings.title, required: true
            elsif block.type == 'product' and request.page_type == 'product'
              render 'input', type: 'hidden', name: name, value: product.title
            endif
          -%}
        {%- endfor -%}

        {%- assign label = 'contact.form.message' | t -%}
        {%- render 'input', name: 'contact[body]', label: label, multiline: 5, required: true -%}
      </div>

      <div>
        {%- assign button_content = 'contact.form.submit' | t -%}
        {%- render 'button', content: button_content, type: 'submit', class: 'sm-max:w-full' -%}
      </div>
    {%- endform -%}
  {%- endcapture -%}

  <style>
    {%- comment -%}
    Same padding as sections/reviews.liquid - container-gutter + 0.5rem on all four sides, same on
    mobile and desktop - instead of the global "Section spacing" setting this section normally
    uses. Put on .section-spacing itself (not on the nested .container). Excludes
    .section-split__column--image: that column keeps its own bleed/flushed image padding, which
    isn't "section spacing" and shouldn't follow this rhythm. Top padding is tripled vs. the other
    three sides, same as sections/libro-reclamaciones.liquid.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .section-split__column:not(.section-split__column--image),
    #shopify-section-{{ section.id }} .section-spacing {
      padding: calc(var(--container-gutter) + 0.5rem);
      padding-block-start: calc((var(--container-gutter) + 0.5rem) * 3);
    }

    {%- comment -%}
    .container (nested inside .section-spacing) still carries its own margin-inline
    (--container-gutter-context) for the site-wide gutter - stacked on top of the padding above,
    that doubled up the left/right inset, most visible on the left here specifically since this
    layout is pinned to the start edge (no mx-auto - see the comment further down), not centered.
    Zeroing just the gutter part of that margin formula leaves .section-spacing's own padding as
    the only source of side space.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .section-spacing .container {
      --container-gutter-context: 0px;
    }

    {%- comment -%}
    Entirely skipped when the icon is off - the row is then just a transparent wrapper around the
    title, which keeps behaving exactly like the title did on its own.

    With the icon on: side by side, this is a 2-column grid - the title's own column is always
    "auto" (sized to the title alone), so icon_justify_self can move the icon around its "1fr"
    column without ever resizing or shifting the title's column. Stacked, it's a flex column
    instead, whose per-item align-self (set on the icon element itself, not here) does the same job
    without touching the title's own position either.

    align-items differs by layout because the cross axis means something different in each: side by
    side (grid), it's vertical, so "center" centers whichever of title/icon is shorter against the
    taller one, making the row's own height hug the taller element exactly instead of carrying extra
    space. Stacked (flex column), the cross axis is horizontal instead - that's icon_justify_self's
    job (as align-self, per item), so the row keeps flex-start there to match the title's own
    left-aligned default.
    {%- endcomment -%}
    {%- if section.settings.show_icon -%}
      #shopify-section-{{ section.id }} .contact-heading-row {
        display: {{ icon_display }};
        {%- if icon_display == 'grid' -%}
          grid-template-columns: {{ icon_grid_template_columns }};
          grid-template-areas: {{ icon_grid_template_areas }};
          align-items: center;
        {%- else -%}
          flex-direction: {{ icon_flex_direction }};
          align-items: flex-start;
        {%- endif -%}
        gap: .5rem;
      }

      #shopify-section-{{ section.id }} .contact-heading-row__title {
        grid-area: title;
      }

      {%- comment -%}
      Trims the heading's own box down to its actual glyphs (cap height to baseline), removing the
      invisible leading space a line box normally carries above/below the text. Has to land on the
      heading tag itself (the element the 'heading' snippet renders, e.g. its <h2>) rather than on
      .contact-heading-row__title above - that's just an empty wrapper div with no text/line box of
      its own, so text-box there trimmed nothing and the row kept the heading's full line-height
      leading, offsetting it from the icon's top edge and padding out the row's height beyond
      whichever element (title or icon) is actually tallest.

      margin-block-start: 0 is needed for the same two-levels-deep reason: .prose's heading spacing
      system (assets/theme.css) zeroes out a heading's top margin only when it's .prose's own direct
      child or one div-wrapper deep - here the heading sits two wrappers deep (.contact-heading-row >
      .contact-heading-row__title > the heading), past what that exemption reaches, so .prose still
      hands it a non-zero margin-block-start that nothing cancels, nudging it down inside the row.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .contact-heading-row__title > * {
        text-box: trim-both cap alphabetic;
        margin-block-start: 0;
      }

      #shopify-section-{{ section.id }} .contact-heading-row__icon {
        grid-area: icon;
        {%- if icon_display == 'grid' -%}
          justify-self: {{ icon_justify_self }};
        {%- else -%}
          align-self: {{ icon_justify_self }};
        {%- endif -%}
      }

      {%- comment -%}
      Same leftover-.prose-spacing issue as the title above, but for media: .prose hands any svg
      margin-block: var(--prose-media-spacing) (top and bottom alike) regardless of nesting depth,
      and the icon's own svg (inside snippets/decorative-icon.liquid's wrapper div) sits well past
      the one-level exemption that would normally zero it out. Halving rather than zeroing it, per
      request, instead of matching the title's full reset above.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .contact-heading-row__icon svg {
        margin-block: calc(var(--prose-media-spacing) / 2);
      }
    {%- endif -%}
  </style>

  {%- if section.settings.image != blank -%}
    <div class="section-split color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
      <div class="section-split__column section-split__column--image {% unless section.settings.add_image_spacing %}section-split__column--flushed{% endunless %}">
        {{- section.settings.image | image_url: width: section.settings.image.width | image_tag: sizes: '(max-width: 699px) 100vw, 50vw', widths: '300,400,500,600,800,1000,1200,1400,1600,1800,2000', class: 'size-full' -}}
      </div>

      <div class="section-split__column">
        <div class="section-stack">
          {{- section_header -}}
          {{- section_main_content -}}
        </div>
      </div>
    </div>
  {%- else -%}
    {%- if section.settings.layout == 'split' -%}
      <div class="section-split color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
        <div class="section-split__column">
          {{- section_header -}}
        </div>

        <div class="section-split__column">
          {{- section_main_content -}}
        </div>
      </div>
    {%- else -%}
      <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.floating_contact %} section-floating section-floating--block-end{% endif %}"{% if section.settings.floating_contact %} style="border-end-start-radius: {{ section.settings.contact_border_radius }}px; border-end-end-radius: {{ section.settings.contact_border_radius }}px; overflow: hidden;"{% endif %}>
        <div class="section-spacing">
          <div class="container">
            <div class="section-stack">
              {{- section_header -}}
              {{- section_main_content -}}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

{% schema %}
{
  "name": "t:sections.contact.name",
  "class": "shopify-section--contact",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:global.image.image",
      "info": "t:sections.contact.image_size_recommendation"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:global.layout.layout",
      "options": [
        {
          "value": "split",
          "label": "t:global.layout.layout_options.split"
        },
        {
          "value": "stacked",
          "label": "t:global.layout.layout_options.stacked"
        }
      ],
      "default": "stacked",
      "visible_if": "{{ section.settings.image == blank }}"
    },
    {
      "type": "checkbox",
      "id": "floating_contact",
      "label": "Floating Contact",
      "info": "Adds margins around the section (bottom and sides), using the store's global side margin.",
      "default": false,
      "visible_if": "{{ section.settings.image == blank and section.settings.layout == 'stacked' }}"
    },
    {
      "type": "range",
      "id": "contact_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0,
      "visible_if": "{{ section.settings.image == blank and section.settings.layout == 'stacked' and section.settings.floating_contact }}"
    },
    {
      "type": "checkbox",
      "id": "add_image_spacing",
      "label": "t:sections.contact.add_image_spacing",
      "default": false,
      "visible_if": "{{ section.settings.image != blank or section.settings.layout == 'split' }}"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading",
      "default": "Contact Us"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "We'd love to hear from you"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:global.text.heading_size",
      "options": [
        {
          "value": "display-xl",
          "label": "Display XL"
        },
        {
          "value": "display-l",
          "label": "Display L"
        },
        {
          "value": "display-m",
          "label": "Display M"
        },
        {
          "value": "h1",
          "label": "XX-Large"
        },
        {
          "value": "h2",
          "label": "X-Large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-Small"
        },
        {
          "value": "h7",
          "label": "XX-Small"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content",
      "default": "<p>If you have any questions, please fill in this contact form, and our team will reach you back as soon as possible.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_social_media",
      "label": "t:sections.contact.show_social_media",
      "info": "t:sections.contact.show_social_media_info",
      "default": true
    },
    {
      "type": "header",
      "content": "Decorative icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show spinning icon",
      "info": "A decorative icon shown next to the title.",
      "default": false
    },
    {
      "type": "select",
      "id": "icon_type",
      "label": "Icon",
      "options": [
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "lotus",
          "label": "Lotus"
        },
        {
          "value": "clover",
          "label": "Clover"
        },
        {
          "value": "smiley",
          "label": "Smiley face"
        },
        {
          "value": "cherries",
          "label": "Cherries"
        },
        {
          "value": "eight_ball",
          "label": "8-Ball"
        },
        {
          "value": "blob",
          "label": "Blob"
        },
        {
          "value": "badge",
          "label": "Badge"
        },
        {
          "value": "stamp",
          "label": "Stamp"
        },
        {
          "value": "swoosh",
          "label": "Swoosh"
        },
        {
          "value": "phone",
          "label": "Phone"
        }
      ],
      "default": "phone",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 32,
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "checkbox",
      "id": "icon_spin",
      "label": "Spin icon",
      "default": true,
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "color",
      "id": "icon_primary_color",
      "label": "Primary color",
      "default": "#FF6B9D",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "color",
      "id": "icon_secondary_color",
      "label": "Secondary color",
      "default": "#FFD93D",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Border color",
      "info": "Leave blank for no border.",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Position",
      "options": [
        {
          "value": "right",
          "label": "Right of title"
        },
        {
          "value": "left",
          "label": "Left of title"
        },
        {
          "value": "above",
          "label": "Above title"
        },
        {
          "value": "below",
          "label": "Below title"
        }
      ],
      "default": "right",
      "visible_if": "{{ section.settings.show_icon }}"
    },
    {
      "type": "select",
      "id": "icon_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.show_icon }}"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "t:sections.contact.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.contact.blocks.text.name_label",
          "default": "Custom field"
        },
        {
          "type": "checkbox",
          "id": "use_long_text",
          "label": "t:sections.contact.blocks.text.use_long_text",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "t:sections.contact.blocks.text.required",
          "default": false
        }
      ]
    },
    {
      "type": "dropdown",
      "name": "t:sections.contact.blocks.dropdown.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.contact.blocks.dropdown.name_label",
          "default": "Custom field"
        },
        {
          "type": "text",
          "id": "values",
          "label": "t:sections.contact.blocks.dropdown.values",
          "info": "t:sections.contact.blocks.dropdown.values_info",
          "default": "value 1, value 2, value 3"
        }
      ]
    },
    {
      "type": "product",
      "name": "t:sections.contact.blocks.product.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.contact.blocks.product.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact.name",
      "category": "t:global.categories.call_to_action",
      "settings": {}
    }
  ]
}
{% endschema %}
