{%- liquid
  assign has_message = false

  for block in section.blocks
    if block.settings.text != blank
      assign has_message = true
      break
    endif
  endfor
-%}

{%- if has_message -%}
  {%- unless request.page_type != 'index' and section.settings.show_on_homepage_only -%}
    <style>
      :root {
        --announcement-bar-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};
      }

      {%- if section.settings.enable_sticky -%}
        #shopify-section-{{ section.id }} {
          position: sticky;
          top: var(--announcement-bar-stuck-top, 0px);
        }

        .shopify-section--header ~ #shopify-section-{{ section.id }} {
          top: calc(var(--header-is-sticky, 0) * var(--header-is-visible, 0) * var(--header-height, 0px));
        }
      {%- endif -%}

      #shopify-section-{{ section.id }} {
        --scrolling-content-gap: 2.5rem;
      }

      {%- comment -%}
      The gap above the bar is half of the bar's own height (one text line plus its two vertical paddings, halved). It is a margin
      of the section wrapper, so it sits OUTSIDE the section: the editor's blue outline hugs the bar and no space is left inside it.
      {%- endcomment -%}
      :root {
        --announcement-bar-gap: calc((var(--text-base) * var(--text-line-height) + {{ section.settings.vertical_padding | times: 2 }}px) / 2);
      }

      #shopify-section-{{ section.id }} {
        margin-block-start: var(--announcement-bar-gap);
      }

      {%- capture joined_root -%}
        :root:has(.announcement-bar-wrapper.is-sticky-bar):has(.shopify-section--announcement-bar ~ .shopify-section--header .header--floating):not(:has(.shopify-section:first-child [allow-transparent-header]):not(:has(.shopify-section--header ~ .shopify-section-group-header-group)):has(.header:not(.is-solid)))
      {%- endcapture -%}

      {%- if section.settings.enable_sticky -%}
        {%- comment -%}
        Sticky bar: the bar and the header are one joined block, except while the header is transparent over the first section
        (same condition as header.liquid / theme.css), where they keep the spacing they have at rest. Joined: no gap between
        them, the bar keeps its top corners (its own radius) and squares the bottom ones, the header squares its top ones, and
        the bar sticks at the same distance from the screen edge that it has at the top of the page. The header's
        stuck offset and the gap it paints above itself are driven by the same variables, so the header sits flush under the bar.
        The header also tucks 1px under the bar (--header-bar-overlap): the bar's height is measured and sticky offsets round, so a flush
        join could leave a hairline (worst on phones) through which the page shows while scrolling. The corner radii are inline styles, hence !important. Only when the header floats and comes after the bar, and the bar squares its bottom corners only while the header is on screen (it can hide on scroll).
        {%- endcomment -%}
        {{ joined_root | strip }} {
          --header-top-gap: 0px;
          --header-stuck-gap: var(--announcement-bar-gap);
          --header-before-gap: 0px;
          --header-bar-overlap: 1px;
          --announcement-bar-stuck-top: var(--announcement-bar-gap);
        }

        {{ joined_root | strip }}:not(:has(.header.is-hidden)) .announcement-bar-wrapper {
          border-bottom-left-radius: 0 !important;
          border-bottom-right-radius: 0 !important;
        }

        {{ joined_root | strip }} .header--floating {
          border-top-left-radius: 0 !important;
          border-top-right-radius: 0 !important;
        }

        {%- comment -%}Paints the gap above the stuck bar with the page background, like the header does above itself.{%- endcomment -%}
        #shopify-section-{{ section.id }}::before {
          content: "";
          position: absolute;
          inset-inline: 0;
          inset-block-end: 100%;
          height: var(--announcement-bar-gap);
          background: rgb(var(--page-background));
          pointer-events: none;
        }
      {%- endif -%}

      {%- unless section.settings.full_width -%}
        {%- comment -%}
        The side gutter of the page (the .container margin) sits on the section wrapper itself, outside the section, instead of on the
        bar inside it: the editor's blue outline then spans only the bar, and the bar still respects the page's side padding.
        {%- endcomment -%}
        #shopify-section-{{ section.id }} {
          margin-inline: max(var(--container-gutter), 50% - var(--container-max-width) / 2);
        }

        #shopify-section-{{ section.id }} .announcement-bar-wrapper {
          margin-inline: 0;
        }
      {%- endunless -%}

      #shopify-section-{{ section.id }} height-observer {
        display: block;
        {%- if section.settings.enable_sticky %}
        background: rgb(var(--page-background));
        {%- endif %}
      }

      {%- if section.settings.full_width -%}
        #shopify-section-{{ section.id }} .announcement-bar {
          padding-inline: var(--container-gutter);
        }
      {%- endif -%}

      {%- if section.settings.display_mode == 'marquee' -%}
        {%- comment -%}
        Edge fade for the endless marquee, the same 2rem gradient mask as the FAQ tabs (sections/faq.liquid), on
        the scrolling text only - not on the bar's wrapper, which carries the background and the radius and would
        fade out too. The text never reaches a start or an end, so both sides always fade. In full width the text
        starts after the side padding, so the fade starts there too.
        {%- endcomment -%}
        #shopify-section-{{ section.id }} marquee-text.announcement-bar {
          --announcement-fade-inset: {% if section.settings.full_width %}var(--container-gutter){% else %}0px{% endif %};
          -webkit-mask-image: linear-gradient(to right, transparent var(--announcement-fade-inset), black calc(var(--announcement-fade-inset) + 2rem), black calc(100% - var(--announcement-fade-inset) - 2rem), transparent calc(100% - var(--announcement-fade-inset)));
          mask-image: linear-gradient(to right, transparent var(--announcement-fade-inset), black calc(var(--announcement-fade-inset) + 2rem), black calc(100% - var(--announcement-fade-inset) - 2rem), transparent calc(100% - var(--announcement-fade-inset)));
        }
      {%- endif -%}

      /* Navigation Controls: these prev/next buttons are bare .tap-area (no
         .circle-button), so they need their own explicit connection to the
         per-scheme navigation icon color. */
      #shopify-section-{{ section.id }} carousel-prev-button.tap-area,
      #shopify-section-{{ section.id }} carousel-next-button.tap-area,
      #shopify-section-{{ section.id }} carousel-prev-button .tap-area,
      #shopify-section-{{ section.id }} carousel-next-button .tap-area {
        color: var(--nav-control-icon-color, currentColor);
      }

      /* 44x44px min tap target (WCAG 2.5.5). Scoped to this section only -
         --tap-area-size is a global token shared by the header, social-media,
         product-gallery, product-card, testimonials and other carousels, so
         it isn't touched here. html has no font-size override in this theme
         (verified in assets/theme.css), so 1rem = 16px and 44px is exact. */
      #shopify-section-{{ section.id }} .tap-area {
        --tap-area-size: 44px;
      }

      {%- if section.settings.display_mode != 'marquee' -%}
        {%- comment -%}
        Same duration as the message's fade-out in AnnouncementBar (theme.js: 0.4s) - the script below sets an explicit height on this element so it can transition instead
        of jumping between however tall each message naturally is.

        grid-template-rows: 100% is the actual fix for vertical centering: theme.css's own rule leaves row
        sizing on "auto" (the default), which keeps sizing the row to the tallest stacked message
        regardless of this element's own explicit height - place-items: center (theme.css) was then
        centering each message within that still-tall auto row, not within the shorter height this script
        sets, which is what pushed a single-line message off-center. Pinning the row to 100% makes it
        track this element's own explicit height instead, so centering happens against the real visible
        height. overflow: hidden only matters for the brief instant during a transition where the row
        hasn't caught up yet.
        {%- endcomment -%}
        #shopify-section-{{ section.id }} .announcement-bar__message-list {
          grid-template-rows: 100%;
          transition: height .4s ease-in-out;
          overflow: hidden;
        }
      {%- endif -%}
    </style>

    <height-observer variable="announcement-bar">
      <div class="announcement-bar-wrapper {% if section.settings.enable_sticky %}is-sticky-bar {% endif %}{% unless section.settings.full_width %}container{% endunless %} color-scheme color-scheme--{{ section.settings.color_scheme.id }}" style="border-radius: {{ section.settings.border_radius }}px;">
        {%- if section.settings.display_mode == 'marquee' -%}
          <marquee-text speed="{{ section.settings.scrolling_speed }}" direction="{{ section.settings.scroll_direction }}" {% if section.settings.pause_on_hover %}pause-on-hover{% endif %} class="announcement-bar scrolling-content" style="padding-block: {{ section.settings.vertical_padding }}px;">
            <div class="scrolling-content__item">
              {%- for block in section.blocks -%}
                {%- if block.settings.text != blank -%}
                  <div class="scrolling-content__text prose" {{ block.shopify_attributes }}>
                    <p>{{ block.settings.text }}</p>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </marquee-text>
        {%- else -%}
          {%- assign carousel_id = 'carousel-' | append: section.id -%}

          <announcement-bar id="{{ carousel_id }}" allow-swipe cell-selector=".announcement-bar__message-list > *" {% if section.settings.autoplay %}autoplay="{{ section.settings.cycle_speed }}"{% endif %} {% if section.settings.pause_on_hover %}pause-on-hover{% endif %} class="announcement-bar" style="padding-block: {{ section.settings.vertical_padding }}px;">
            {%- if section.blocks.size > 1 and section.settings.hide_arrows == false -%}
              <carousel-prev-button aria-controls="{{ carousel_id }}">
                <button type="button" class="tap-area">
                  <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
                  {%- render 'icon' with 'arrow-left', direction_aware: true -%}
                </button>
              </carousel-prev-button>
            {%- endif -%}

            <div class="announcement-bar__message-list">
              {%- for block in section.blocks -%}
                {%- if block.settings.text != blank -%}
                  <div class="{% if forloop.first %}is-selected{% endif %} prose prose-justify-center" {{ block.shopify_attributes }}>
                    <p>{{ block.settings.text }}</p>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if section.blocks.size > 1 and section.settings.hide_arrows == false -%}
              <carousel-next-button aria-controls="{{ carousel_id }}">
                <button type="button" class="tap-area">
                  <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
                  {%- render 'icon' with 'arrow-right', direction_aware: true -%}
                </button>
              </carousel-next-button>
            {%- endif -%}
          </announcement-bar>

          {%- comment -%}
          .announcement-bar__message-list (theme.css) stacks every message in the same CSS grid area so
          the existing crossfade (EffectCarousel/AnnouncementBar in theme.js, via the vendor "animate"
          helper) can fade the outgoing/incoming message in place. That stacking is why the container was
          keeping the tallest message's height at all times: visibility: hidden (not display: none, which
          would break the crossfade) still counts toward the grid track's size, even for messages that
          aren't shown.

          Rather than touching that shared stacking/crossfade CSS or theme.js's bundled AnnouncementBar
          class, this measures the actually-selected message's own natural height and applies it directly
          as the grid's height, transitioning smoothly between values - same duration/easing the theme's
          own height animations already use (AccordionDisclosure in theme.js: duration 0.25, easeInOut).
          Only the container's height animates; the message text itself is untouched here, so the
          existing crossfade (or its absence, if the merchant switches messages instantly) still fully
          owns how the text itself appears/disappears.
          {%- endcomment -%}
          <script>
            (function () {
              var list = document.querySelector('#shopify-section-{{ section.id }} .announcement-bar__message-list');
              var carousel = document.getElementById('{{ carousel_id }}');
              if (!list || !carousel) return;

              function selectedHeight() {
                var selected = list.querySelector(':scope > .is-selected');
                return selected ? selected.offsetHeight : list.offsetHeight;
              }

              function setHeight(px, animated) {
                if (!animated) list.style.transition = 'none';
                list.style.height = px + 'px';
                if (!animated) {
                  void list.offsetHeight; // force reflow so the transition: none above actually applies
                  list.style.transition = '';
                }
              }

              // Starts from the real selected message's height instead of the grid's own
              // tallest-of-all-messages height.
              setHeight(selectedHeight(), false);

              carousel.addEventListener('carousel:change', function (event) {
                if (event.detail && event.detail.cell) {
                  setHeight(event.detail.cell.offsetHeight, true);
                }
              });

              // A message can reflow to a different number of lines when the bar's width changes, so the
              // height is recalculated then. Observing the bar itself (instead of a window 'resize'
              // listener) means nothing outlives the element when the theme editor re-renders this
              // section. Only width changes count: this script changes the height itself.
              if (window.ResizeObserver) {
                var lastWidth = carousel.offsetWidth;
                new ResizeObserver(function () {
                  if (carousel.offsetWidth === lastWidth) return;
                  lastWidth = carousel.offsetWidth;
                  setHeight(selectedHeight(), false);
                }).observe(carousel);
              }

              // The first measurement can happen before the web fonts load, which changes line heights.
              if (document.fonts && document.fonts.ready) {
                document.fonts.ready.then(function () {
                  if (list.isConnected) setHeight(selectedHeight(), false);
                });
              }
            })();
          </script>
        {%- endif -%}
      </div>
    </height-observer>
  {%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "shopify-section--announcement-bar",
  "max_blocks": 5,
  "tag": "aside",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "min": 0,
      "max": 15,
      "step": 1,
      "unit": "px",
      "label": "t:sections.announcement_bar.vertical_padding",
      "info": "t:sections.announcement_bar.vertical_padding_info",
      "default": 11
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:sections.announcement_bar.enable_sticky",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_homepage_only",
      "label": "t:sections.announcement_bar.show_on_homepage_only",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "info": "When disabled, the announcement bar uses the same side margins as the rest of the store.",
      "default": false
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.announcement_bar.display_category"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "t:sections.announcement_bar.display_mode",
      "options": [
        {
          "value": "original",
          "label": "t:sections.announcement_bar.display_mode_options.original"
        },
        {
          "value": "marquee",
          "label": "t:sections.announcement_bar.display_mode_options.marquee"
        }
      ],
      "default": "original"
    },
    {
      "type": "checkbox",
      "id": "hide_arrows",
      "label": "t:sections.announcement_bar.hide_arrows",
      "info": "If you have more than one message and auto-rotate is off, hiding the arrows leaves no visible way to see the other messages (aside from swiping on touch devices).",
      "default": false,
      "visible_if": "{{ section.settings.display_mode == 'original' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.announcement_bar.auto_rotate_between_messages",
      "default": false,
      "visible_if": "{{ section.settings.display_mode == 'original' }}"
    },
    {
      "type": "range",
      "min": 3,
      "max": 20,
      "step": 1,
      "unit": "s",
      "id": "cycle_speed",
      "label": "t:sections.announcement_bar.cycle_speed",
      "default": 5,
      "visible_if": "{{ section.settings.display_mode == 'original' and section.settings.autoplay }}"
    },
    {
      "type": "range",
      "id": "scrolling_speed",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "label": "t:sections.scrolling_content.scrolling_speed",
      "default": 0.3,
      "visible_if": "{{ section.settings.display_mode == 'marquee' }}"
    },
    {
      "type": "select",
      "id": "scroll_direction",
      "label": "t:sections.scrolling_content.scroll_direction",
      "options": [
        {
          "value": "end-to-start",
          "label": "t:sections.scrolling_content.scroll_direction_options.to_left"
        },
        {
          "value": "start-to-end",
          "label": "t:sections.scrolling_content.scroll_direction_options.to_right"
        }
      ],
      "default": "start-to-end",
      "visible_if": "{{ section.settings.display_mode == 'marquee' }}"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:sections.scrolling_content.pause_on_hover",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement_bar.blocks.message.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:sections.announcement_bar.blocks.message.text",
          "default": "Announce something here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name"
    }
  ]
}
{% endschema %}
