{%- liquid
  assign has_message = false

  for block in section.blocks
    if block.settings.text != blank
      assign has_message = true
      break
    endif
  endfor
-%}

{%- if has_message -%}
  {%- unless request.page_type != 'index' and section.settings.show_on_homepage_only -%}
    <style>
      :root {
        --announcement-bar-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};
      }

      {%- if section.settings.enable_sticky -%}
        #shopify-section-{{ section.id }} {
          position: sticky;
          top: 0;
        }

        .shopify-section--header ~ #shopify-section-{{ section.id }} {
          top: calc(var(--header-is-sticky, 0) * var(--header-is-visible, 0) * var(--header-height, 0px));
        }
      {%- endif -%}

      #shopify-section-{{ section.id }} {
        --scrolling-content-gap: 2.5rem;
        padding-block-start: calc(var(--section-vertical-spacing) / 2);
      }

      {%- if section.settings.full_width -%}
        #shopify-section-{{ section.id }} .announcement-bar {
          padding-inline: var(--container-gutter);
        }
      {%- endif -%}

      /* Navigation Controls: these prev/next buttons are bare .tap-area (no
         .circle-button), so they need their own explicit connection to the
         per-scheme navigation icon color. */
      #shopify-section-{{ section.id }} carousel-prev-button.tap-area,
      #shopify-section-{{ section.id }} carousel-next-button.tap-area,
      #shopify-section-{{ section.id }} carousel-prev-button .tap-area,
      #shopify-section-{{ section.id }} carousel-next-button .tap-area {
        color: var(--nav-control-icon-color, currentColor);
      }

      {%- if section.settings.display_mode != 'marquee' -%}
        {%- comment -%}
        Same duration/easing as the theme's own height animation (AccordionDisclosure in theme.js: 0.25s,
        easeInOut) - the script below sets an explicit height on this element so it can transition instead
        of jumping between however tall each message naturally is.

        grid-template-rows: 100% is the actual fix for vertical centering: theme.css's own rule leaves row
        sizing on "auto" (the default), which keeps sizing the row to the tallest stacked message
        regardless of this element's own explicit height - place-items: center (theme.css) was then
        centering each message within that still-tall auto row, not within the shorter height this script
        sets, which is what pushed a single-line message off-center. Pinning the row to 100% makes it
        track this element's own explicit height instead, so centering happens against the real visible
        height. overflow: hidden only matters for the brief instant during a transition where the row
        hasn't caught up yet.
        {%- endcomment -%}
        #shopify-section-{{ section.id }} .announcement-bar__message-list {
          grid-template-rows: 100%;
          transition: height .25s ease-in-out;
          overflow: hidden;
        }
      {%- endif -%}
    </style>

    <height-observer variable="announcement-bar">
      <div class="announcement-bar-wrapper {% unless section.settings.full_width %}container{% endunless %} color-scheme color-scheme--{{ section.settings.color_scheme.id }}" style="border-radius: {{ section.settings.border_radius }}px;">
        {%- if section.settings.display_mode == 'marquee' -%}
          <marquee-text speed="{{ section.settings.scrolling_speed }}" direction="{{ section.settings.scroll_direction }}" {% if section.settings.pause_on_hover %}pause-on-hover{% endif %} class="announcement-bar scrolling-content" style="padding-block: {{ section.settings.vertical_padding }}px;">
            <div class="scrolling-content__item">
              {%- for block in section.blocks -%}
                {%- if block.settings.text != blank -%}
                  <div class="scrolling-content__text prose" {{ block.shopify_attributes }}>
                    <p>{{ block.settings.text }}</p>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </marquee-text>
        {%- else -%}
          {%- assign carousel_id = 'carousel-' | append: section.id -%}

          <announcement-bar id="{{ carousel_id }}" allow-swipe cell-selector=".announcement-bar__message-list > *" {% if section.settings.autoplay %}autoplay="{{ section.settings.cycle_speed }}"{% endif %} {% if section.settings.pause_on_hover %}pause-on-hover{% endif %} class="announcement-bar" style="padding-block: {{ section.settings.vertical_padding }}px;">
            {%- if section.blocks.size > 1 and section.settings.hide_arrows == false -%}
              <carousel-prev-button aria-controls="{{ carousel_id }}">
                <button type="button" class="tap-area">
                  <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
                  {%- render 'icon' with 'arrow-left', direction_aware: true -%}
                </button>
              </carousel-prev-button>
            {%- endif -%}

            <div class="announcement-bar__message-list">
              {%- for block in section.blocks -%}
                {%- if block.settings.text != blank -%}
                  <div class="{% if forloop.first %}is-selected{% endif %} prose prose-justify-center" {{ block.shopify_attributes }}>
                    <p>{{ block.settings.text }}</p>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if section.blocks.size > 1 and section.settings.hide_arrows == false -%}
              <carousel-next-button aria-controls="{{ carousel_id }}">
                <button type="button" class="tap-area">
                  <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
                  {%- render 'icon' with 'arrow-right', direction_aware: true -%}
                </button>
              </carousel-next-button>
            {%- endif -%}
          </announcement-bar>

          {%- comment -%}
          .announcement-bar__message-list (theme.css) stacks every message in the same CSS grid area so
          the existing crossfade (EffectCarousel/AnnouncementBar in theme.js, via the vendor "animate"
          helper) can fade the outgoing/incoming message in place. That stacking is why the container was
          keeping the tallest message's height at all times: visibility: hidden (not display: none, which
          would break the crossfade) still counts toward the grid track's size, even for messages that
          aren't shown.

          Rather than touching that shared stacking/crossfade CSS or theme.js's bundled AnnouncementBar
          class, this measures the actually-selected message's own natural height and applies it directly
          as the grid's height, transitioning smoothly between values - same duration/easing the theme's
          own height animations already use (AccordionDisclosure in theme.js: duration 0.25, easeInOut).
          Only the container's height animates; the message text itself is untouched here, so the
          existing crossfade (or its absence, if the merchant switches messages instantly) still fully
          owns how the text itself appears/disappears.
          {%- endcomment -%}
          <script>
            (function () {
              var list = document.querySelector('#shopify-section-{{ section.id }} .announcement-bar__message-list');
              var carousel = document.getElementById('{{ carousel_id }}');
              if (!list) return;

              function selectedHeight() {
                var selected = list.querySelector(':scope > .is-selected');
                return selected ? selected.offsetHeight : list.offsetHeight;
              }

              function setHeight(px, animated) {
                if (!animated) list.style.transition = 'none';
                list.style.height = px + 'px';
                if (!animated) {
                  void list.offsetHeight; // force reflow so the transition: none above actually applies
                  list.style.transition = '';
                }
              }

              // Starts from the real selected message's height instead of the grid's own
              // tallest-of-all-messages height.
              setHeight(selectedHeight(), false);

              if (carousel) {
                carousel.addEventListener('carousel:change', function (event) {
                  if (event.detail && event.detail.cell) {
                    setHeight(event.detail.cell.offsetHeight, true);
                  }
                });
              }

              var resizeTimeout;
              window.addEventListener('resize', function () {
                // Debounced: the same message can reflow to a different number of lines as the viewport
                // width changes, so the height needs recalculating - but not on every single resize tick.
                clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(function () {
                  setHeight(selectedHeight(), false);
                }, 150);
              });
            })();
          </script>
        {%- endif -%}
      </div>
    </height-observer>
  {%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "shopify-section--announcement-bar",
  "max_blocks": 5,
  "tag": "aside",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "min": 0,
      "max": 15,
      "step": 1,
      "unit": "px",
      "label": "t:sections.announcement_bar.vertical_padding",
      "info": "t:sections.announcement_bar.vertical_padding_info",
      "default": 11
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:sections.announcement_bar.enable_sticky",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_homepage_only",
      "label": "t:sections.announcement_bar.show_on_homepage_only",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "info": "When disabled, the announcement bar uses the same side margins as the rest of the store.",
      "default": false
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.announcement_bar.display_category"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "t:sections.announcement_bar.display_mode",
      "options": [
        {
          "value": "original",
          "label": "t:sections.announcement_bar.display_mode_options.original"
        },
        {
          "value": "marquee",
          "label": "t:sections.announcement_bar.display_mode_options.marquee"
        }
      ],
      "default": "original"
    },
    {
      "type": "checkbox",
      "id": "hide_arrows",
      "label": "t:sections.announcement_bar.hide_arrows",
      "info": "If you have more than one message and auto-rotate is off, hiding the arrows leaves no visible way to see the other messages (aside from swiping on touch devices).",
      "default": false,
      "visible_if": "{{ section.settings.display_mode == 'original' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.announcement_bar.auto_rotate_between_messages",
      "default": false,
      "visible_if": "{{ section.settings.display_mode == 'original' }}"
    },
    {
      "type": "range",
      "min": 3,
      "max": 20,
      "step": 1,
      "unit": "s",
      "id": "cycle_speed",
      "label": "t:sections.announcement_bar.cycle_speed",
      "default": 5,
      "visible_if": "{{ section.settings.display_mode == 'original' and section.settings.autoplay }}"
    },
    {
      "type": "range",
      "id": "scrolling_speed",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "label": "t:sections.scrolling_content.scrolling_speed",
      "default": 0.3,
      "visible_if": "{{ section.settings.display_mode == 'marquee' }}"
    },
    {
      "type": "select",
      "id": "scroll_direction",
      "label": "t:sections.scrolling_content.scroll_direction",
      "options": [
        {
          "value": "end-to-start",
          "label": "t:sections.scrolling_content.scroll_direction_options.to_left"
        },
        {
          "value": "start-to-end",
          "label": "t:sections.scrolling_content.scroll_direction_options.to_right"
        }
      ],
      "default": "start-to-end",
      "visible_if": "{{ section.settings.display_mode == 'marquee' }}"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:sections.scrolling_content.pause_on_hover",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement_bar.blocks.message.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:sections.announcement_bar.blocks.message.text",
          "default": "Announce something here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name"
    }
  ]
}
{% endschema %}
