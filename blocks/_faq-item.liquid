{%- doc -%}
A single FAQ question/answer row. Reuses the shared "accordion" component (the same one used by the
"Collapsible text" block on the product page) for the open/close behavior and the +/- icon, so it does
not duplicate any of that logic.

@param {object} block - the FAQ item block
{%- enddoc -%}

{%- render 'accordion',
  title: block.settings.question,
  content: block.settings.answer,
  open: block.settings.open_by_default,
  uppercase_title: true,
  prose_content: true,
  toggle_icon: 'accordion-plus',
  block: block
-%}

{% schema %}
{
  "name": "FAQ item",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "question",
      "label": "Question",
      "default": "Question"
    },
    {
      "type": "richtext",
      "id": "answer",
      "label": "Answer",
      "default": "<p>Share the answer to this question.</p>"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "FAQ item"
    }
  ]
}
{% endschema %}
