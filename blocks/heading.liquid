{%- if block.settings.text != blank -%}
  {%- capture heading_markup -%}
    {%- render 'heading', 
      content: block.settings.text,
      html_tag: block.settings.html_tag,
      style: block.settings.heading_size,
      highlight_effect: block.settings.highlight_effect, 
      highlight_accent_color: block.settings.highlight_accent_color, 
      highlight_text_color: block.settings.highlight_text_color,
      indent: block.settings.indent,
      block: block
    -%}
  {%- endcapture -%}

  {%- if block.settings.show_icon -%}
    {%- comment -%}
    Same decorative-icon-next-to-title row as the rich text block's heading (sections/rich-text.liquid) and
    sections/contact.liquid, so it is available wherever this block is used (slideshow image and video slides,
    containers, ...). snippets/heading-with-icon.liquid holds the layout.
    {%- endcomment -%}
    {%- render 'heading-with-icon',
      title_content: heading_markup,
      show_icon: true,
      icon_margin_block: '0',
      icon_position: block.settings.icon_position,
      icon_alignment: block.settings.icon_alignment,
      icon_type: block.settings.icon_type,
      icon_size: block.settings.icon_size,
      icon_spin: block.settings.icon_spin,
      icon_primary_color: block.settings.icon_primary_color,
      icon_secondary_color: block.settings.icon_secondary_color,
      icon_border_color: block.settings.icon_border_color
    -%}
  {%- else -%}
    {{- heading_markup -}}
  {%- endif -%}
{%- endif -%}

