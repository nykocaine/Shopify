{%- comment -%}The page content is rendered first, so the head can use what its sections hand over (the reviews' structured data, see sections/reviews.liquid){%- endcomment -%}
{%- capture main_content -%}{{ content_for_layout }}{%- endcapture -%}
{%- assign reviews_ld = '' -%}
{%- if request.page_type == 'product' and main_content contains '<!--reviews-ld:' -%}
  {%- assign reviews_ld = main_content | split: '<!--reviews-ld:' | last | split: ':reviews-ld-->' | first -%}
{%- endif -%}
<!doctype html>

<html lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=5.0">

    <title>{% if page_title == blank %}{{ shop.name }}{% else %}{{ page_title }}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}{% endif %}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%}
    Pages that must not show up in search engines (the claims book, the FAQ page, the blog and its posts): this tag is what keeps
    them out of the results (a missing <h1> does not), while search engines still follow their links.
    {%- endcomment -%}
    {%- if request.page_type == 'blog' or request.page_type == 'article' -%}
      <meta name="robots" content="noindex, follow">
    {%- elsif request.page_type == 'page' and page.template_suffix == 'libro-reclamaciones' -%}
      <meta name="robots" content="noindex, follow">
    {%- elsif request.page_type == 'page' and page.template_suffix == 'faq' -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    {%- comment -%}
    Preload the fonts that are really used, so the first paint already has them. The Shopify library fonts are only preloaded when their source is
    "shopify" (otherwise they are not used at all and were downloaded for nothing), and the theme's own fonts (Swiss, Satoshi, Apercu; Pros has no file in the theme) are
    preloaded when a source uses them. Without that, the page was drawn with a fallback font first and re-measured when the real one arrived: the
    announcement bar changed height (its text took more or less room, sometimes another line) and everything below it jumped.
    {%- endcomment -%}
    {%- if settings.heading_font_source == 'shopify' -%}
      {%- unless settings.heading_font.system? -%}
        <link rel="preload" href="{{ settings.heading_font | font_url }}" as="font" type="font/woff2" crossorigin>
      {%- endunless -%}
    {%- endif -%}

    {%- if settings.text_font_source == 'shopify' -%}
      {%- unless settings.text_font.system? -%}
        <link rel="preload" href="{{ settings.text_font | font_url }}" as="font" type="font/woff2" crossorigin>
      {%- endunless -%}
    {%- endif -%}

    {%- if settings.text_font_source == 'apple' or settings.heading_font_source == 'apple' or settings.subheading_font_source == 'apple' -%}
      <link rel="preload" href="{{ 'swiss-721-regular.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
      <link rel="preload" href="{{ 'swiss-721-medium.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    {%- endif -%}

    {%- if settings.text_font_source == 'satoshi' or settings.heading_font_source == 'satoshi' or settings.subheading_font_source == 'satoshi' -%}
      <link rel="preload" href="{{ 'satoshi-variable.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    {%- endif -%}

    {%- if settings.text_font_source == 'apercu' or settings.heading_font_source == 'apercu' or settings.subheading_font_source == 'apercu' -%}
      <link rel="preload" href="{{ 'apercu-regular.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    {%- endif -%}

    {%- render 'social-meta-tags' -%}
    {%- render 'microdata-schema', reviews_ld: reviews_ld -%}
    {%- render 'css-variables' -%}
    {%- render 'js-variables' -%}

    {%- if request.page_type == 'gift_card' -%}
      <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {%- endif -%}

    <script type="importmap">
      {%- comment -%}On Safari 16.3 and lower, a polyfill is used to load importmap{%- endcomment -%}
      {
        "imports": {
          "vendor": "{{ 'vendor.min.js' | asset_url }}",
          "theme": "{{ 'theme.js' | asset_url }}",
          "photoswipe": "{{ 'photoswipe.min.js' | asset_url }}"
        }
      }
    </script>

    <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>

    {{ content_for_header }}

    {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
  </head>

  {% liquid
    assign features_class = ''

    if settings.image_hover_animation == 'zoom'
      assign features_class = features_class | append: 'features--zoom-image '
    elsif settings.image_hover_animation == 'zoom_filter'
      assign features_class = features_class | append: 'features--zoom-filter-image '
    endif

    if settings.drawer_mobile_centered
      assign features_class = features_class | append: 'drawer-mobile-centered '
    endif
  %}

  <body class="{{ features_class }}">
    {%- render 'shadow-dom-templates' -%}

    <loading-bar class="loading-bar" aria-hidden="true"></loading-bar>

    <a href="#main" allow-hash-change class="skip-to-content sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- comment -%}
    This placeholder will be filled to screen readers for any kind of announcements
    {%- endcomment -%}
    <div class="sr-only" role="status" aria-live="polite" aria-atomic="true">
      <span id="status-announcement"></span>
    </div>

    <div class="sr-only" role="alert" aria-live="assertive" aria-atomic="true">
      <span id="error-announcement"></span>
    </div>

    <span id="header-scroll-tracker" style="position: absolute; width: 1px; height: 1px; top: 0; left: 0;">
      {%- comment -%}
        This allows our theme to track when the user has scrolled a given amount of pixels (none: it sits at the very top of the page, so the header turns solid with the first pixels of scroll, with no transparent stretch in between), without relying on a global scroll listener. This helps
        to improve performance and reduce reflows.
      {%- endcomment -%}
    </span>
    
    {%- if request.page_type != 'password' -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}
    {%- endif -%}

    {%- comment -%}
    Exactly one <h1> per page (SEO and accessibility). The page's own content decides what it is (the hero heading on the home page,
    the product title, the collection title, the page title...). This is the safety net for whatever is added in the editor:
    - no <h1> in the content: a visually hidden one is added (the shop name on the home page, the page title elsewhere);
    - more than one: the first stays and the others become <h2> (same classes, so they look the same).
    {%- endcomment -%}
    {%- assign h1_parts = main_content | split: '<h1' -%}
    {%- assign needs_fallback_h1 = false -%}

    {%- if h1_parts.size == 1 -%}
      {%- assign needs_fallback_h1 = true -%}
    {%- elsif h1_parts.size > 2 -%}
      {%- capture main_content -%}
        {{- h1_parts[0] -}}<h1{{- h1_parts[1] -}}
        {%- for h1_part in h1_parts offset: 2 -%}
          <h2{{- h1_part | replace_first: '</h1>', '</h2>' -}}
        {%- endfor -%}
      {%- endcapture -%}
    {%- endif -%}

    {%- comment -%}
      Fallback h1 (visually hidden) goes before <main>, not inside it: as a child of <main> it would break the rules that count on the page's sections being the first / last child
      (the transparent header's [allow-transparent-header] first section, sections/instagram-feed.liquid's last-child).
    {%- endcomment -%}
    {%- if needs_fallback_h1 -%}
      <h1 class="sr-only">{% if request.page_type == 'index' %}{{ shop.name }}{% else %}{{ page_title | default: shop.name }}{% endif %}</h1>
    {%- endif -%}

    <main id="main" class="anchor {% if request.page_type == 'policy' %}main--policy {% endif %}{% if request.page_type == 'policy' or request.page_type == 'captcha' %}color-scheme color-scheme--{{ settings.default_color_scheme.id }}{% endif %}">
      {{ main_content }}
    </main>

    {%- if request.page_type != 'password' -%}
      {%- sections 'footer-group' -%}
    {%- endif -%}

    <x-toast class="toast">
      {% comment %}Container for notification messages; DO NOT DELETE{% endcomment %}
    </x-toast>
  </body>
</html>
