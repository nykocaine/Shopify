<!doctype html>

<html lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=5.0">

    <title>{% if page_title == blank %}{{ shop.name }}{% else %}{{ page_title }}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}{% endif %}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    {%- unless settings.heading_font.system? -%}
      <link rel="preload" href="{{ settings.heading_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- unless settings.text_font.system? -%}
      <link rel="preload" href="{{ settings.text_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- render 'social-meta-tags' -%}
    {%- render 'microdata-schema' -%}
    {%- render 'css-variables' -%}
    {%- render 'js-variables' -%}

    {%- if request.page_type == 'gift_card' -%}
      <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {%- endif -%}

    <script type="importmap">
      {%- comment -%}On Safari 16.3 and lower, a polyfill is used to load importmap{%- endcomment -%}
      {
        "imports": {
          "vendor": "{{ 'vendor.min.js' | asset_url }}",
          "theme": "{{ 'theme.js' | asset_url }}",
          "photoswipe": "{{ 'photoswipe.min.js' | asset_url }}"
        }
      }
    </script>

    <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>

    {{ content_for_header }}

    {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
  </head>

  {% liquid
    assign features_class = ''

    if settings.image_hover_animation == 'zoom'
      assign features_class = features_class | append: 'features--zoom-image '
    elsif settings.image_hover_animation == 'zoom_filter'
      assign features_class = features_class | append: 'features--zoom-filter-image '
    endif

    if settings.drawer_mobile_centered
      assign features_class = features_class | append: 'drawer-mobile-centered '
    endif
  %}

  <body class="{{ features_class }}">
    {%- render 'shadow-dom-templates' -%}

    <loading-bar class="loading-bar" aria-hidden="true"></loading-bar>

    <a href="#main" allow-hash-change class="skip-to-content sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- comment -%}
    This placeholder will be filled to screen readers for any kind of announcements
    {%- endcomment -%}
    <div class="sr-only" role="status" aria-live="polite" aria-atomic="true">
      <span id="status-announcement"></span>
    </div>

    <div class="sr-only" role="alert" aria-live="assertive" aria-atomic="true">
      <span id="error-announcement"></span>
    </div>

    <span id="header-scroll-tracker" style="position: absolute; width: 1px; height: 1px; top: 200px; left: 0;">
      {%- comment -%}
        This allows our theme to track when the user has scrolled a given amount of pixels, without relying on a global scroll listener. This helps
        to improve performance and reduce reflows.
      {%- endcomment -%}
    </span>
    
    {%- if request.page_type != 'password' -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}
    {%- endif -%}

    {%- comment -%}
    <h1> rules (SEO and accessibility), applied to the page's content here so that whatever is added in the editor follows them:
    - Home page: no heading of the content is an <h1> (they all become <h2>) and the page's one <h1> is a visually hidden one with
      the shop name.
    - Libro de reclamaciones, FAQ page and the blog (list and posts): no <h1> at all (any <h1> becomes <h2>, none is added).
    - Every other page: exactly one <h1>. Its own content decides what it is (product title, collection title, page title...); if there
      is none, a visually hidden one is added (the page title); if there are several, the first stays and the others become <h2>.
    Demoted headings keep their classes, so they look the same.
    {%- endcomment -%}
    {%- assign h1_mode = 'single' -%}

    {%- if request.page_type == 'index' -%}
      {%- assign h1_mode = 'home' -%}
    {%- elsif request.page_type == 'blog' or request.page_type == 'article' -%}
      {%- assign h1_mode = 'none' -%}
    {%- elsif request.page_type == 'page' and page.template_suffix == 'libro-reclamaciones' -%}
      {%- assign h1_mode = 'none' -%}
    {%- elsif request.page_type == 'page' and page.template_suffix == 'faq' -%}
      {%- assign h1_mode = 'none' -%}
    {%- endif -%}

    {%- capture main_content -%}{{ content_for_layout }}{%- endcapture -%}
    {%- assign h1_parts = main_content | split: '<h1' -%}
    {%- assign needs_fallback_h1 = false -%}

    {%- if h1_mode == 'home' or h1_mode == 'none' -%}
      {%- if h1_parts.size > 1 -%}
        {%- capture main_content -%}
          {{- h1_parts[0] -}}
          {%- for h1_part in h1_parts offset: 1 -%}
            <h2{{- h1_part | replace_first: '</h1>', '</h2>' -}}
          {%- endfor -%}
        {%- endcapture -%}
      {%- endif -%}

      {%- if h1_mode == 'home' -%}
        {%- assign needs_fallback_h1 = true -%}
      {%- endif -%}
    {%- elsif h1_parts.size == 1 -%}
      {%- assign needs_fallback_h1 = true -%}
    {%- elsif h1_parts.size > 2 -%}
      {%- capture main_content -%}
        {{- h1_parts[0] -}}<h1{{- h1_parts[1] -}}
        {%- for h1_part in h1_parts offset: 2 -%}
          <h2{{- h1_part | replace_first: '</h1>', '</h2>' -}}
        {%- endfor -%}
      {%- endcapture -%}
    {%- endif -%}

    <main id="main" class="anchor {% if request.page_type == 'policy' or request.page_type == 'captcha' %}color-scheme color-scheme--{{ settings.default_color_scheme.id }}{% endif %}">
      {%- if needs_fallback_h1 -%}
        <h1 class="sr-only">{% if request.page_type == 'index' %}{{ shop.name }}{% else %}{{ page_title | default: shop.name }}{% endif %}</h1>
      {%- endif -%}
      {{ main_content }}
    </main>

    {%- if request.page_type != 'password' -%}
      {%- sections 'footer-group' -%}
    {%- endif -%}

    <x-toast class="toast">
      {% comment %}Container for notification messages; DO NOT DELETE{% endcomment %}
    </x-toast>
  </body>
</html>
