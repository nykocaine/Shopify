{%- doc -%}
This component generates a review badge from the product metafields information: the numeric rating followed by one star.

@param {object} [product] - the product from which ratings are extracted
@param {boolean} [show_empty] - if set to true, the theme shows a 0.0 if there are no rating yet
@param {boolean} [show_placeholder] - if set to true, show random value (useful for the product card placeholder)
@param {string} [alignment] - can be "start", "center" or "end" (default to start)
{%- enddoc -%}

{%- liquid
  assign hide_rating = false
  assign rating_value = 0
  assign rating_count = 0
  assign rating_max = 5

  if product and product.metafields.custom.reviews_rating.value != blank
    assign rating_value = product.metafields.custom.reviews_rating.value.rating | plus: 0
    assign rating_count = product.metafields.custom.reviews_count.value | default: 0
    assign rating_max = product.metafields.custom.reviews_rating.value.scale_max | round
  elsif show_empty
    assign rating_value = 0
    assign rating_count = 0
    assign rating_max = 5
  elsif show_placeholder
    assign rating_value = 4.5
    assign rating_count = 2
    assign rating_max = 5
  else
    assign hide_rating = true
  endif
-%}

{%- unless hide_rating -%}
  {%- assign rating_display = rating_value | times: 1.0 | round: 1 -%}
  <div class="rating-badge rating-badge--single {% if alignment %}justify-{{ alignment }}{% endif %}">
    <span class="rating-badge__value subheading">{{ rating_display }}</span>

    <div
      class="rating-badge__stars"
      role="img"
      aria-label="{{ 'general.rating.info' | t: rating_value: rating_value, rating_max: rating_max }}"
    >
      {%- if rating_count == 0 -%}
        {%- render 'icon' with 'star-rating-empty' -%}
      {%- else -%}
        {%- render 'icon' with 'star-rating' -%}
      {%- endif -%}
    </div>
  </div>
{%- endunless -%}