{%- doc -%}
Renders the products shown on top of the main menu drawer panel (see snippets/main-menu-drawer.liquid): an optional row
of tabs and the product list (max 5), each product in its own rounded container, plus an optional button.

With the tabs off it lists the products picked in the block; with them on, each tab has its own title and its own
hand-picked products (a tab without title or products is skipped).

@param {object} block - the "drawer_products" block of the header section
{%- enddoc -%}

{%- liquid
  assign max_products = 5
  assign use_tabs = false

  if block.settings.show_tabs
    for i in (1..4)
      assign title_key = 'tab_' | append: i | append: '_title'
      assign products_key = 'tab_' | append: i | append: '_products'
      if block.settings[title_key] != blank and block.settings[products_key].size > 0
        assign use_tabs = true
        break
      endif
    endfor
  endif
-%}

{%- capture products_html -%}
  {%- if use_tabs -%}
    {%- assign tab_index = 0 -%}

    <div class="menu-drawer-products__tabs scroll-area" role="tablist">
      {%- for i in (1..4) -%}
        {%- assign title_key = 'tab_' | append: i | append: '_title' -%}
        {%- assign products_key = 'tab_' | append: i | append: '_products' -%}

        {%- if block.settings[title_key] != blank and block.settings[products_key].size > 0 -%}
          <button type="button" role="tab" class="menu-drawer-products__tab" data-menu-drawer-products-tab="{{ i }}" aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}">
            {{- block.settings[title_key] -}}
          </button>
          {%- assign tab_index = tab_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- assign tab_index = 0 -%}

    {%- for i in (1..4) -%}
      {%- assign title_key = 'tab_' | append: i | append: '_title' -%}
      {%- assign products_key = 'tab_' | append: i | append: '_products' -%}

      {%- if block.settings[title_key] != blank and block.settings[products_key].size > 0 -%}
        <div class="menu-drawer-products__list" role="tabpanel" data-menu-drawer-products-panel="{{ i }}" {% unless tab_index == 0 %}hidden{% endunless %}>
          {%- for product in block.settings[products_key] limit: max_products -%}
            {%- render 'menu-drawer-products-item', product: product, color_scheme: block.settings.color_scheme -%}
          {%- endfor -%}
        </div>
        {%- assign tab_index = tab_index | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- elsif block.settings.products.size > 0 -%}
    <div class="menu-drawer-products__list">
      {%- for product in block.settings.products limit: max_products -%}
        {%- render 'menu-drawer-products-item', product: product, color_scheme: block.settings.color_scheme -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- if products_html contains 'menu-drawer-products__item' -%}
  <div class="menu-drawer-products" {{ block.shopify_attributes }}>
    <div class="menu-drawer-products__body">
      {{- products_html -}}
    </div>

    {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
      <div class="menu-drawer-products__button">
        {%- render 'button', content: block.settings.button_label, href: block.settings.button_url, style: 'outline' -%}
      </div>
    {%- endif -%}
  </div>

  {%- if use_tabs -%}
    <script>
      if (!window.menuDrawerProductsTabs) {
        window.menuDrawerProductsTabs = true;

        document.addEventListener('click', (event) => {
          const tab = event.target.closest('[data-menu-drawer-products-tab]');

          if (!tab) {
            return;
          }

          const body = tab.closest('.menu-drawer-products__body');

          body.querySelectorAll('[data-menu-drawer-products-tab]').forEach((item) => {
            item.setAttribute('aria-selected', item === tab ? 'true' : 'false');
          });

          body.querySelectorAll('[data-menu-drawer-products-panel]').forEach((panel) => {
            panel.hidden = panel.dataset.menuDrawerProductsPanel !== tab.dataset.menuDrawerProductsTab;
          });
        });
      }
    </script>
  {%- endif -%}
{%- endif -%}
