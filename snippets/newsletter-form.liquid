{%- doc -%}
Renders the newsletter subscription form as a single merged pill (email input + submit button separated by a thin
vertical divider). This is the single source of truth for the newsletter form's markup, styles (.newsletter-input-group,
defined in assets/theme.css) and submission logic (Shopify customer form), used by the footer newsletter block, the
password page and the newsletter popup.

@param {string} id - a unique identifier appended to the form id (e.g. section.id), to avoid ID collisions when the
  form is rendered more than once on a page
@param {string} [value] - an optional prefilled value for the email input (e.g. customer.email)
@param {string} [button_label] - an optional override for the submit button label (defaults to "Subscribe")
@param {boolean} [remember_success_locally] - if true, sets a "theme:popup-filled" local storage flag on a
  successful submission (used by the newsletter popup so it doesn't show again)
@param {boolean} [show_discount] - if true (and discount_code is set), shows the configured discount code with a
  copy-to-clipboard button after a successful subscription
@param {string} [discount_code] - the discount code to display. This must match a discount the merchant already
  created in Shopify Admin (Discounts) - Liquid has no API to look up or generate real discount codes, so this is
  always a merchant-entered value, never invented or validated by the theme
{%- enddoc -%}

{%- assign newsletter_form_id = 'newsletter-form-' | append: id -%}

{%- form 'customer', id: newsletter_form_id, class: 'form-row' -%}
  {%- if form.posted_successfully? -%}
    {%- assign success_message = 'general.newsletter.subscribed_successfully' | t -%}
    {%- render 'banner', content: success_message, status: 'success', text_alignment: 'center' -%}

    {%- if remember_success_locally -%}
      <script>
        localStorage.setItem('theme:popup-filled', 'true');
      </script>
    {%- endif -%}

    {%- if show_discount and discount_code != blank -%}
      <div class="newsletter-discount v-stack gap-3">
        <p class="text-sm text-subdued">{{ 'general.newsletter.discount_code_label' | t }}</p>

        <div class="newsletter-discount__code-group">
          <span class="newsletter-discount__code">{{ discount_code }}</span>

          <copy-button class="contents" data-text="{{ discount_code | escape }}">
            <button type="button" class="link newsletter-discount__copy-button">
              <span class="newsletter-discount__copy-label">{{ 'general.newsletter.copy_code' | t }}</span>
              <span class="newsletter-discount__copied-label">{{ 'general.newsletter.copied_code' | t }}</span>
            </button>
          </copy-button>
        </div>
      </div>
    {%- endif -%}
  {%- else -%}
    {%- if form.errors -%}
      {%- capture error_message -%}{{ form.errors.translated_fields['email'] }} {{ form.errors.messages['email'] }}{%- endcapture -%}
      {%- render 'banner', content: error_message, status: 'error', text_alignment: 'center' -%}
    {%- endif -%}

    <input type="hidden" name="contact[tags]" value="newsletter">

    <div class="newsletter-input-group vertically-separated-list">
      {%- assign input_label = 'general.newsletter.email' | t -%}
      {%- render 'input', name: 'contact[email]', label: input_label, type: 'email', value: value, required: true, autocomplete: 'email', enterkeyhint: 'send' -%}

      <hr>

      {%- unless button_label -%}
        {%- assign button_label = 'general.newsletter.subscribe' | t -%}
      {%- endunless -%}
      {%- render 'button', type: 'submit', content: button_label, style: 'link' -%}
    </div>
  {%- endif -%}
{%- endform -%}
