{%- doc -%}
Outputs a CSS clamp() expression (in rem) that fluidly interpolates a font-size between a "mobile" value (at
700px viewport width) and a "desktop" value (at 1400px viewport width), instead of jumping between two fixed
sizes at a single breakpoint. Below 700px the size stays pinned at `mobile`; above 1400px it stays pinned at
`desktop`; in between, it scales smoothly with viewport width.

Accepts:
- mobile: font-size at the low end, in px (number)
- desktop: font-size at the high end, in px (number)
- min_px: optional floor (in px) applied to both `mobile` and `desktop` before interpolating - matches the
  theme's own 12px/11px accessibility minimums for heading/small text sizes
{%- enddoc -%}

{%- liquid
  assign min_vw = 700.0
  assign max_vw = 1400.0
  assign vw_range = max_vw | minus: min_vw
  assign floor = min_px | default: 0

  assign mobile_px = mobile | at_least: floor
  assign desktop_px = desktop | at_least: floor

  assign slope = desktop_px | minus: mobile_px | divided_by: vw_range
  assign vw_coefficient = slope | times: 100 | round: 4
  assign intercept_px = mobile_px | minus: slope | times: min_vw

  assign mobile_rem = mobile_px | divided_by: 16.0 | round: 4
  assign desktop_rem = desktop_px | divided_by: 16.0 | round: 4
  assign intercept_rem = intercept_px | divided_by: 16.0 | round: 4

  if mobile_rem > desktop_rem
    assign clamp_min = desktop_rem
    assign clamp_max = mobile_rem
  else
    assign clamp_min = mobile_rem
    assign clamp_max = desktop_rem
  endif
-%}
clamp({{ clamp_min }}rem, {{ intercept_rem }}rem + {{ vw_coefficient }}vw, {{ clamp_max }}rem)
