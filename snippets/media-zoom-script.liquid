{%- doc -%}
Behavior shared by every "zoomable media" item rendered via snippets/media-zoom-slide.liquid: the
video sound/play-pause toggle buttons (with cross-video mute sync, so only one video has sound at a
time) and the zoom-to-lightbox open/close/prev/next logic. This is the Carousel block's own script
(sections/media-blocks.liquid) generalized so it works whether the media items sit inside a real
scrolling carousel (<product-list>) or as a single static item (eg. FAQ's "Text + image/video"
block) - the carousel-only parts (pausing other slides on scroll, relocating controls next to the
progress bar) are simply skipped when no carousel_id is given.

@param {string} wrapper_id - id of the ancestor element wrapping every media item and the lightbox. Used to scope the mute/pause setup and to catch the bubbling 'lightbox:open' event dispatched by each item's zoom button.
@param {string} lightbox_id - id of the media-lightbox element (snippets/media-lightbox.liquid)
@param {string} [carousel_id] - id of the <product-list> element, when the media items sit inside a real scrolling carousel. Omit for a single static media item.
@param {string} [controls_slot_id] - id of the element the selected slide's controls should be relocated into on touch devices. Only used when relocate_controls is true.
@param {boolean} [relocate_controls] - whether to relocate controls next to the progress bar on touch devices (carousel-only, see section.settings.controls_position)
@param {boolean} [sound_on_open] - whether a video opened in the lightbox with the zoom button starts with sound on (default false). An autoplaying video is muted again when the lightbox closes.
{%- enddoc -%}

<script>
  (function() {
    var wrapper = document.getElementById('{{ wrapper_id }}');

    if (!wrapper) {
      return;
    }

    customElements.whenDefined('video-media').then(function() {
      var carousel = {% if carousel_id %}document.getElementById('{{ carousel_id }}'){% else %}null{% endif %};
      var isTouchDevice = window.matchMedia('(pointer: coarse)').matches;
      var relocateControls = {% if relocate_controls %}true{% else %}false{% endif %};
      var soundOnOpen = {% if sound_on_open %}true{% else %}false{% endif %};
      var controlsSlot = (relocateControls && isTouchDevice) ? document.getElementById('{{ controls_slot_id }}') : null;

      // The list of "cells" to pause/relocate/navigate between: a real carousel's own cells when
      // there is one, otherwise every item carrying the data-media-cell hook (media-zoom-slide.liquid,
      // as_lightbox_cell: true) directly under the wrapper.
      var cells = carousel ? carousel.cells : Array.prototype.slice.call(wrapper.querySelectorAll('[data-media-cell]'));

      // Captured once, up front, while every controls group is still in its original cell - NOT
      // re-queried via cell.querySelector() on every scheduleAdvance() call, since once a group has
      // been moved into the slot it is no longer a descendant of its cell and would silently fail to
      // be found again (leaving stale duplicates behind instead of being moved back home).
      var controlsEntries = controlsSlot ? cells.map(function(cell) {
        return {
          cell: cell,
          group: cell.querySelector('.carousel-video-controls'),
          home: cell.querySelector('.content-box__background-media')
        };
      }) : [];

      // Nothing autoplays, so this only has two jobs: pause whatever video the visitor is swiping
      // away from, and (on mobile, progress-bar layout) relocate the newly selected slide's controls
      // group into the slot next to the progress bar. Only relevant when there is an actual carousel.
      function scheduleAdvance() {
        cells.forEach(function(cell) {
          if (cell !== carousel.selectedCell) {
            // Go through the <video-media> wrapper's own pause(), not the raw <video> tag directly:
            // the wrapper tracks its own "playing" state and only the wrapper's play()/pause() keep
            // that state (and the "loaded" attribute driving its CSS) in sync.
            //
            // An autoplaying video (the Instagram feed) is left alone: it plays while it is on screen and the theme's own
            // visibility rule pauses it when it leaves, whichever cell the carousel has selected. Pausing it here stopped
            // every visible video but the selected one, and it then never started again (the poster stayed on screen).
            var otherVideoMedia = cell.querySelector('video-media');
            if (otherVideoMedia && !otherVideoMedia.hasAttribute('autoplay')) {
              otherVideoMedia.pause();
            }
          }
        });

        controlsEntries.forEach(function(entry) {
          if (!entry.group) {
            return;
          }

          if (entry.cell === carousel.selectedCell) {
            controlsSlot.appendChild(entry.group);
          } else if (entry.home) {
            entry.home.appendChild(entry.group);
          }
        });
      }

      // Tracks the mute-setter of every video under this wrapper, so that unmuting one can mute
      // every other one (only one video can have sound at a time).
      var muteSetters = [];

      Array.prototype.forEach.call(wrapper.querySelectorAll('.content-box__background-media'), function(mediaBox) {
        var video = mediaBox.querySelector('video');

        if (!video) {
          return;
        }

        var videoMedia = mediaBox.querySelector('video-media');
        // Optional: snippets/media-zoom-slide.liquid's show_pause_button: false skips rendering this
        // button entirely (eg. an autoplaying, always-looping video with no manual pause/resume).
        var pauseButton = mediaBox.querySelector('.carousel-video-pause-toggle');
        var pauseIcon = pauseButton ? pauseButton.querySelector('.carousel-video-pause-icon') : null;
        var playIcon = pauseButton ? pauseButton.querySelector('.carousel-video-play-icon') : null;
        var soundButton = mediaBox.querySelector('.carousel-video-sound-toggle');
        var poster = mediaBox.querySelector('video-media > img');

        // Resuming goes through .player.play() rather than .play() - the public play() additionally
        // requires this.offsetParent to be non-null, which is always null while is-lightbox-expanded
        // has this at position: fixed - the player proxy underneath runs the exact same one-time
        // setup and playback call without that extra guard.
        function togglePlay() {
          if (videoMedia.playing) {
            videoMedia.pause();
          } else {
            videoMedia.player.play();

            // A tap on play is a real user gesture, so autoplay-with-sound isn't blocked here - going
            // through the real button (not video.muted directly) keeps its icon and the "mute every
            // other video" behavior in sync.
            if (video.muted) {
              soundButton.click();
            }
          }
        }

        video.addEventListener('playing', function() {
          if (poster) {
            poster.classList.add('carousel-video-poster-hidden');
          }

          if (pauseIcon) {
            pauseIcon.classList.remove('hidden');
            playIcon.classList.add('hidden');
          }
        });

        video.addEventListener('pause', function() {
          if (pauseIcon) {
            pauseIcon.classList.add('hidden');
            playIcon.classList.remove('hidden');
          }
        });

        if (pauseButton) {
          pauseButton.addEventListener('click', function(event) {
            event.stopPropagation();
            togglePlay();
          });
        }

        var soundOffIcon = soundButton.querySelector('.carousel-video-sound-off-icon');
        var soundOnIcon = soundButton.querySelector('.carousel-video-sound-icon');

        function setMuted(muted) {
          video.muted = muted;
          soundOffIcon.classList.toggle('hidden', !muted);
          soundOnIcon.classList.toggle('hidden', muted);
        }

        function toggleSound() {
          var wasMuted = video.muted;

          if (wasMuted) {
            muteSetters.forEach(function(otherSetMuted) {
              if (otherSetMuted !== setMuted) {
                otherSetMuted(true);
              }
            });
          }

          setMuted(!wasMuted);
        }

        muteSetters.push(setMuted);

        soundButton.addEventListener('click', function(event) {
          event.stopPropagation();
          toggleSound();
        });

        // No tap-anywhere-on-the-video handler here on purpose: video-media itself (theme.js,
        // VideoMedia#connectedCallback) already attaches its own one-time "click starts playback"
        // listener whenever it has no autoplay attribute, which is exactly this case. Adding a second
        // click-to-play listener here fired both on the very first tap - two near-simultaneous play()
        // calls on the same <video>, which some browsers resolve by aborting the first one, so
        // playback never actually started. The dedicated pause/play button is unaffected (it's a
        // sibling of video-media, not a descendant) and already covers pause/resume on repeat taps.

        // Optional: snippets/media-zoom-slide.liquid's reveal_controls_on_tap: true starts the
        // controls group AND the zoom button hidden (see snippets/media-zoom-style.liquid's
        // .carousel-video-controls--tap-to-reveal, shared by both) and only reveals them here,
        // toggled together on tap - meant for an autoplaying video (nothing to "see the play button
        // right away" for), so nothing permanently sits on top of it. The buttons' own click
        // handlers above all call event.stopPropagation(), so clicking them doesn't also re-toggle
        // this (the zoom button is the one exception - opening the lightbox makes this row's own
        // revealed state moot either way).
        var tapToRevealControls = mediaBox.querySelectorAll('.carousel-video-controls--tap-to-reveal');

        if (tapToRevealControls.length) {
          mediaBox.addEventListener('click', function() {
            tapToRevealControls.forEach(function(el) {
              el.classList.toggle('is-controls-revealed');
            });
          });
        }
      });

      if (carousel) {
        // Only now, after every mediaBox above has its buttons queried and listeners attached, is it
        // safe to run scheduleAdvance() for the first time - running it any earlier relocated a
        // controls group out of its mediaBox before the loop above reached it.
        carousel.addEventListener('carousel:change', scheduleAdvance);
        scheduleAdvance();
      }

      // Each open-lightbox-button (rendered per item) dispatches a bubbling 'lightbox:open', caught
      // here on the wrapper. Opening only toggles a class on the item's own real <video-media>/<img>
      // (see is-lightbox-expanded in media-zoom-style.liquid) - it's never moved to a different
      // parent, which is what previously caused the browser to re-buffer playing videos.
      var lightbox = document.getElementById('{{ lightbox_id }}');
      var lightboxCloseButton = lightbox.querySelector('.media-lightbox__close');
      var lightboxPrevButton = lightbox.querySelector('.media-lightbox__prev');
      var lightboxNextButton = lightbox.querySelector('.media-lightbox__next');
      var activeCell = null;
      // Whether the video that was just expanded had sound on - carried over to whichever video
      // next/prev bring in next, since a freshly encountered item otherwise always starts muted.
      var lightboxSoundOn = false;

      function getCellMedia(cell) {
        var home = cell.querySelector('.content-box__background-media');

        return {
          home: home,
          videoMedia: home.querySelector('video-media'),
          controlsGroup: home.querySelector('.carousel-video-controls'),
          image: home.querySelector('img.image-cover')
        };
      }

      // "is-lightbox-visible" is the settled (scale: 1, opacity: 1) state - see the
      // :not(.is-lightbox-visible) rules in media-zoom-style.liquid for the "entering/exiting"
      // (scaled down, transparent) one it transitions from/to. Added to the media itself (and its
      // controls group) directly, since those live outside #{{ lightbox_id }} and so aren't reachable
      // from a class toggled on the lightbox wrapper alone.
      function setMediaVisible(media, visible) {
        if (media.videoMedia) {
          media.videoMedia.classList.toggle('is-lightbox-visible', visible);

          if (media.controlsGroup) {
            media.controlsGroup.classList.toggle('is-lightbox-visible', visible);
          }
        } else if (media.image) {
          media.image.classList.toggle('is-lightbox-visible', visible);
        }
      }

      // Fixes the expanded box's SHAPE up front (see --lightbox-ratio in media-zoom-style.liquid): the box
      // always fills the available area at that ratio, so it never depends on how many pixels happen to be
      // loaded - the thumbnail's small srcset image, a 400px poster or a not-yet-loaded video used to make
      // the box start small and jump to a bigger one later (or differ from one item to the next).
      // The ratio comes from data that is on the page from the start, most reliable first: the media's
      // real aspect ratio (video-media's --aspect-ratio), the width/height attributes of the <video> /
      // <img> (the full-size file's), then whatever is loaded. The thumbnail's own box is the last resort
      // only because a cropped thumbnail has a different shape.
      function readRatio(element, media) {
        var ratio = 0;
        var sourceElement = element;

        if (media.videoMedia) {
          ratio = parseFloat(media.videoMedia.style.getPropertyValue('--aspect-ratio'));
          sourceElement = media.videoMedia.querySelector('video');

          if (!ratio && sourceElement && sourceElement.videoWidth) {
            ratio = sourceElement.videoWidth / sourceElement.videoHeight;
          }
        }

        if (!ratio && sourceElement) {
          var attributeWidth = parseFloat(sourceElement.getAttribute('width'));
          var attributeHeight = parseFloat(sourceElement.getAttribute('height'));

          ratio = attributeWidth && attributeHeight ? attributeWidth / attributeHeight : 0;
        }

        if (!ratio && element.naturalWidth) {
          ratio = element.naturalWidth / element.naturalHeight;
        }

        if (!ratio) {
          var rect = element.getBoundingClientRect();

          ratio = rect.height ? rect.width / rect.height : 0;
        }

        return ratio;
      }

      function setLightboxSize(element, media) {
        var ratio = readRatio(element, media);

        if (ratio) {
          // Also on the controls group: on desktop it is pinned to the media box's own corner (see
          // media-zoom-style.liquid), which it can only compute from the same value.
          [element, media.controlsGroup].forEach(function(target) {
            if (target) {
              target.style.setProperty('--lightbox-ratio', ratio);
            }
          });
        }
      }

      // ---- Playback scrubber (lightbox videos only) ------------------------------------------------------
      // A thin, perfectly straight line along the bottom edge of the expanded video, from one side to the other: solid up to
      // the playhead and faint after it. A dot (that "breathes") marks the current moment. Dragging along it seeks and the
      // time shows above the dot. It is a child of the <video-media>, so it moves, zooms and slides with the video.
      var scrubberFrame = null;

      function formatTime(seconds) {
        var whole = Math.max(0, Math.floor(seconds || 0));
        var rest = whole % 60;

        return Math.floor(whole / 60) + ':' + (rest < 10 ? '0' : '') + rest;
      }

      function drawScrubber(state) {
        var width = state.root.clientWidth;
        var height = state.root.clientHeight;

        if (!width || !height || !state.video) {
          return;
        }

        if (width !== state.width || height !== state.height) {
          state.width = width;
          state.height = height;
          state.svg.setAttribute('width', width);
          state.svg.setAttribute('height', height);
          state.svg.setAttribute('viewBox', '0 0 ' + width + ' ' + height);
        }

        var duration = state.video.duration;
        var ratio = isFinite(duration) && duration > 0 ? Math.min(1, state.video.currentTime / duration) : 0;
        var lineY = (height / 2).toFixed(2);
        var positionX = ratio * width;

        state.span = width;
        state.played.setAttribute('d', 'M0 ' + lineY + 'L' + positionX.toFixed(1) + ' ' + lineY);
        state.rest.setAttribute('d', 'M' + positionX.toFixed(1) + ' ' + lineY + 'L' + width + ' ' + lineY);
        state.dot.setAttribute('cx', Math.min(width - 3, Math.max(3, positionX)).toFixed(1));
        state.dot.setAttribute('cy', lineY);

        if (state.dragging) {
          state.time.textContent = formatTime(state.video.currentTime);
          state.time.style.insetInlineStart = Math.min(width - 16, Math.max(16, positionX)) + 'px';
        }
      }

      function seekScrubber(state, event) {
        var duration = state.video.duration;

        if (!isFinite(duration) || duration <= 0) {
          return;
        }

        var rect = state.root.getBoundingClientRect();
        var ratio = (event.clientX - rect.left) / Math.max(1, rect.width);

        state.video.currentTime = Math.min(1, Math.max(0, ratio)) * duration;
      }

      function ensureScrubber(videoMedia) {
        if (videoMedia.scrubber) {
          return videoMedia.scrubber;
        }

        var video = videoMedia.querySelector('video');

        if (!video) {
          return null;
        }

        var root = document.createElement('div');

        root.className = 'lightbox-scrubber';
        root.setAttribute('aria-hidden', 'true');
        root.innerHTML = '<svg class="lightbox-scrubber__svg" focusable="false"><path class="lightbox-scrubber__rest"/><path class="lightbox-scrubber__played"/><circle class="lightbox-scrubber__dot" r="3"/></svg><span class="lightbox-scrubber__time">0:00</span>';
        videoMedia.appendChild(root);

        var state = {
          root: root,
          svg: root.firstChild,
          rest: root.querySelector('.lightbox-scrubber__rest'),
          played: root.querySelector('.lightbox-scrubber__played'),
          dot: root.querySelector('.lightbox-scrubber__dot'),
          time: root.querySelector('.lightbox-scrubber__time'),
          video: video,
          width: 0,
          height: 0,
          span: 0,
          amplitude: 1,
          phase: 0,
          dragging: false
        };

        root.addEventListener('pointerdown', function(event) {
          if (event.button > 0) {
            return;
          }

          state.dragging = true;
          root.classList.add('is-scrubbing');
          root.setPointerCapture(event.pointerId);
          seekScrubber(state, event);
          event.preventDefault();
          event.stopPropagation();
        });

        root.addEventListener('pointermove', function(event) {
          if (state.dragging) {
            seekScrubber(state, event);
          }
        });

        function stopScrubbing() {
          state.dragging = false;
          root.classList.remove('is-scrubbing');
        }

        root.addEventListener('pointerup', stopScrubbing);
        root.addEventListener('pointercancel', stopScrubbing);

        // The scrubber sits inside <video-media>, which starts playback on click: touching the scrubber
        // must only seek.
        root.addEventListener('click', function(event) {
          event.stopPropagation();
        });

        videoMedia.scrubber = state;

        return state;
      }

      function tickScrubber() {
        scrubberFrame = null;

        if (lightbox.hidden || !activeCell) {
          return;
        }

        var activeMedia = getCellMedia(activeCell);

        if (activeMedia.videoMedia && activeMedia.videoMedia.scrubber) {
          drawScrubber(activeMedia.videoMedia.scrubber);
        }

        scrubberFrame = requestAnimationFrame(tickScrubber);
      }

      function startScrubberLoop() {
        if (!scrubberFrame) {
          scrubberFrame = requestAnimationFrame(tickScrubber);
        }
      }

      function seekActiveVideoBy(seconds) {
        var activeMedia = activeCell ? getCellMedia(activeCell) : null;
        var video = activeMedia && activeMedia.videoMedia ? activeMedia.videoMedia.querySelector('video') : null;

        if (video && isFinite(video.duration)) {
          video.currentTime = Math.min(video.duration, Math.max(0, video.currentTime + seconds));
        }
      }

      // Puts one item's media in its expanded (position: fixed, centered) state without touching playback
      // or which item counts as the active one - the vertical feed needs the neighbouring item expanded
      // too, parked off screen, while it is being dragged/slid in. Safe to call twice for the same cell.
      function expandMedia(cell) {
        var media = getCellMedia(cell);
        var element = media.videoMedia || media.image;

        if (!element || element.classList.contains('is-lightbox-expanded')) {
          return media;
        }

        // The expanded media leaves the cell's flow (position: fixed): keeping the cell's box means the
        // grid doesn't collapse or shift under it, and the thumbnail's slot is still there to land back in.
        cell.style.minHeight = cell.offsetHeight + 'px';

        setLightboxSize(element, media);

        // A photo is shown far bigger than its thumbnail: let the browser pick a matching file from its
        // srcset (the thumbnail's `sizes` would keep it on the small one) and start loading it now, even
        // when it was lazy - the neighbouring photo is expanded off screen before it slides in.
        if (media.image) {
          element.dataset.lightboxSizes = element.getAttribute('sizes') || '';
          element.dataset.lightboxLoading = element.getAttribute('loading') || '';
          element.setAttribute('sizes', '100vw');
          element.setAttribute('loading', 'eager');
        }

        element.classList.add('is-lightbox-expanded');

        if (media.controlsGroup) {
          media.controlsGroup.classList.add('is-lightbox-expanded');
        }

        if (media.videoMedia) {
          var scrubber = ensureScrubber(media.videoMedia);

          if (scrubber) {
            drawScrubber(scrubber);
          }
        }

        return media;
      }

      // The reverse of expandMedia(): back to the thumbnail's own state, video paused. Also records
      // whether this video had sound on, so the next one can carry it over.
      function collapseMedia(cell) {
        var media = getCellMedia(cell);
        var element = media.videoMedia || media.image;

        if (media.videoMedia) {
          var video = media.videoMedia.querySelector('video');

          if (video) {
            lightboxSoundOn = !video.muted;
          }

          // An autoplaying video goes back to playing in its thumbnail if it is on screen: the pause is not "on purpose"
          // (even if the visitor paused it inside the lightbox), and the thumbnail is silent again, like before it was opened.
          if (media.videoMedia.hasAttribute('autoplay')) {
            var thumbnailSoundButton = media.controlsGroup ? media.controlsGroup.querySelector('.carousel-video-sound-toggle') : null;

            if (video && !video.muted && thumbnailSoundButton) {
              thumbnailSoundButton.click();
            }

            media.videoMedia.pause({ manual: false });
            media.videoMedia._manualPause = false;
            setTimeout(function() {
              if (typeof media.videoMedia._ensurePlaying === 'function') {
                media.videoMedia._ensurePlaying(3);
              }
            }, 600);
          } else {
            media.videoMedia.pause();
          }
        }

        if (element && media.image && 'lightboxSizes' in element.dataset) {
          [['sizes', element.dataset.lightboxSizes], ['loading', element.dataset.lightboxLoading]].forEach(function(pair) {
            if (pair[1]) {
              element.setAttribute(pair[0], pair[1]);
            } else {
              element.removeAttribute(pair[0]);
            }
          });

          delete element.dataset.lightboxSizes;
          delete element.dataset.lightboxLoading;
        }

        if (media.videoMedia) {
          var collapsedVideo = media.videoMedia.querySelector('video');

          if (collapsedVideo && 'lightboxLoop' in collapsedVideo.dataset) {
            collapsedVideo.loop = collapsedVideo.dataset.lightboxLoop === 'on';
            delete collapsedVideo.dataset.lightboxLoop;
          }
        }

        if (element) {
          element.classList.remove('is-lightbox-expanded', 'is-lightbox-visible');
          element.style.removeProperty('--lightbox-ratio');
          element.style.transform = '';
        }

        if (media.controlsGroup) {
          media.controlsGroup.classList.remove('is-lightbox-expanded', 'is-lightbox-visible');
          media.controlsGroup.style.removeProperty('--lightbox-ratio');
        }

        cell.style.minHeight = '';
      }

      // Plays the video of the item that is now on screen, like a feed does. soundOn is only passed
      // when moving between items (undefined = leave the sound exactly as it already is): a freshly
      // encountered video otherwise always starts muted, so the previous one's choice is carried over.
      // It loops while it is in the lightbox (a feed never stops on its own).
      function startPlayback(media, soundOn) {
        if (!media.videoMedia) {
          return;
        }

        var video = media.videoMedia.querySelector('video');
        var soundButton = media.controlsGroup ? media.controlsGroup.querySelector('.carousel-video-sound-toggle') : null;

        if (!video) {
          return;
        }

        if (!('lightboxLoop' in video.dataset)) {
          video.dataset.lightboxLoop = video.loop ? 'on' : 'off';
        }

        video.loop = true;

        if (soundButton && soundOn !== undefined && !video.muted !== soundOn) {
          soundButton.click();
        }

        media.videoMedia.player.play();

        // video-media answers a refused play() (the browser blocks autoplay WITH sound when the visitor
        // has not interacted in a way it accepts) by switching to the browser's own controls and leaving
        // the video paused. Better to keep it moving: mute it and play again, once. The sound button is
        // there to turn it back on.
        setTimeout(function() {
          var stillShown = media.videoMedia.classList.contains('is-lightbox-expanded');

          if (!stillShown || !video.paused || (activeCell && getCellMedia(activeCell).videoMedia !== media.videoMedia)) {
            return;
          }

          if (!video.muted && soundButton) {
            soundButton.click();
          }

          media.videoMedia.removeAttribute('suspended');

          if (video.controls && !media.videoMedia.hasAttribute('controls')) {
            video.controls = false;
          }

          media.videoMedia.player.play();
        }, 300);
      }

      // Starts fetching the items right before and after the active one, so they are ready when the visitor
      // moves on: photos pick their bigger file, videos buffer.
      function warmNeighbours() {
        var index = cells.indexOf(activeCell);

        [index - 1, index + 1].forEach(function(neighbourIndex) {
          var neighbour = cells[neighbourIndex];

          if (!neighbour) {
            return;
          }

          var neighbourMedia = getCellMedia(neighbour);
          var neighbourVideo = neighbourMedia.videoMedia ? neighbourMedia.videoMedia.querySelector('video') : null;

          if (neighbourVideo && neighbourVideo.preload !== 'auto') {
            neighbourVideo.preload = 'auto';
          } else if (neighbourMedia.image && neighbourMedia.image.loading === 'lazy') {
            neighbourMedia.image.loading = 'eager';
          }
        });
      }

      // Returns the resolved media object so callers can drive setMediaVisible() on it without looking
      // it up a second time.
      function expandCell(cell, soundOn) {
        var media = expandMedia(cell);

        startPlayback(media, soundOn);
        activeCell = cell;

        return media;
      }

      function collapseCell() {
        if (!activeCell) {
          return;
        }

        collapseMedia(activeCell);
        activeCell = null;
      }

      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // The open/close "zoom": the expanded media is already centered in its final state (see
      // media-zoom-style.liquid), so this only animates a transform between that final box and the box
      // of the thumbnail it came from (FLIP). A uniform scale (by width) is used so nothing stretches;
      // when the two boxes have different proportions (a cropped 4:5 thumbnail vs. the whole photo) a
      // clip-path trims the media to the thumbnail's shape at the start/end of the animation.
      // Same duration and curve as the product gallery's zoom (set in its PhotoSwipe options, assets/theme.js),
      // so every zoom in the theme moves the same way. Closing plays the keyframes backwards by swapping
      // them, not with a reversed animation: that would also reverse the curve, making the close start
      // slow and end abruptly.
      var zoomDuration = 480;
      var activeZoom = null;

      // Solves the cubic-bezier curve (0.42, 0, 0.2, 1 - same curve as the product gallery zoom) for a given progress, so the frames below
      // can be sampled by hand.
      function easeProgress(t) {
        var x1 = 0.42, y1 = 0, x2 = 0.2, y2 = 1;
        var low = 0, high = 1, mid = t;

        for (var i = 0; i < 24; i++) {
          mid = (low + high) / 2;

          var x = 3 * (1 - mid) * (1 - mid) * mid * x1 + 3 * (1 - mid) * mid * mid * x2 + mid * mid * mid;

          if (x < t) {
            low = mid;
          } else {
            high = mid;
          }
        }

        return 3 * (1 - mid) * (1 - mid) * mid * y1 + 3 * (1 - mid) * mid * mid * y2 + mid * mid * mid;
      }

      // Sampled frame by frame (instead of two keyframes) on purpose: the visible box is interpolated
      // directly between the two rects, and the corner radius is divided by the current scale at every
      // step, so the corners keep exactly the same on-screen radius for the whole zoom. With only two
      // keyframes the scale and the clip-path radius moved independently and the corners visibly
      // bulged halfway through.
      function zoomKeyframes(thumbRect, finalRect, reverse) {
        var radius = parseFloat(window.getComputedStyle(activeCell || document.body).borderRadius) || 0;
        var thumbCenterX = thumbRect.left + thumbRect.width / 2;
        var thumbCenterY = thumbRect.top + thumbRect.height / 2;
        var finalCenterX = finalRect.left + finalRect.width / 2;
        var finalCenterY = finalRect.top + finalRect.height / 2;
        var steps = 30;
        var frames = [];

        for (var i = 0; i <= steps; i++) {
          // e: 0 = at the thumbnail, 1 = at the final box
          var eased = easeProgress(i / steps);
          var e = reverse ? 1 - eased : eased;
          var visibleWidth = thumbRect.width + (finalRect.width - thumbRect.width) * e;
          var visibleHeight = thumbRect.height + (finalRect.height - thumbRect.height) * e;
          var scale = Math.max(visibleWidth / finalRect.width, visibleHeight / finalRect.height);
          var shiftX = (thumbCenterX - finalCenterX) * (1 - e);
          var shiftY = (thumbCenterY - finalCenterY) * (1 - e);
          var trimX = Math.max(0, (finalRect.width - visibleWidth / scale) / 2) / finalRect.width * 100;
          var trimY = Math.max(0, (finalRect.height - visibleHeight / scale) / 2) / finalRect.height * 100;

          frames.push({
            offset: i / steps,
            transform: 'translate(' + shiftX + 'px, ' + shiftY + 'px) scale(' + scale + ')',
            clipPath: 'inset(' + trimY + '% ' + trimX + '% ' + trimY + '% ' + trimX + '% round ' + (radius / scale) + 'px)'
          });
        }

        return frames;
      }

      function playZoom(element, thumbRect, finalRect, reverse) {
        if (activeZoom) {
          activeZoom.cancel();
        }

        var animation = element.animate(zoomKeyframes(thumbRect, finalRect, reverse), {
          duration: zoomDuration,
          easing: 'linear',
          fill: 'both'
        });

        activeZoom = animation;

        return animation;
      }

      function openLightbox(index) {
        var cell = cells[index];

        if (!cell) {
          return;
        }

        if (carousel) {
          // Detaching this for as long as the lightbox is open keeps it from pausing the expanded
          // video out from under the visitor if a carousel:change ever fired while it's up.
          carousel.removeEventListener('carousel:change', scheduleAdvance);
        }

        openedCell = cell;

        var thumbnail = getCellMedia(cell);
        var thumbnailElement = thumbnail.videoMedia || thumbnail.image;
        var thumbRect = thumbnailElement ? thumbnailElement.getBoundingClientRect() : null;

        // Removing the page scrollbar would otherwise shift the whole page sideways by its width.
        document.documentElement.style.scrollbarGutter = 'stable';
        document.documentElement.style.overflow = 'hidden';
        lightbox.hidden = false;

        // The zoom button is a tap by the visitor, so the browser lets the video start with sound (soundOnOpen)
        var media = expandCell(cell, soundOnOpen ? true : undefined);
        var expandedElement = media.videoMedia || media.image;

        updateNavButtons();
        warmNeighbours();
        startScrubberLoop();

        // The controls group jumps from its thumbnail spot to the viewport corner the moment it is
        // expanded: starting it at opacity 0 without a transition (instead of fading down from 1) keeps
        // that jump from ever being seen. The transition is handed back with the fade-in below.
        if (media.controlsGroup) {
          media.controlsGroup.style.transition = 'none';
        }

        if (!prefersReducedMotion && thumbRect && expandedElement && thumbRect.width > 0) {
          var finalRect = expandedElement.getBoundingClientRect();

          if (finalRect.width > 0 && finalRect.height > 0) {
            playZoom(expandedElement, thumbRect, finalRect, false).onfinish = function() {
              if (activeZoom && activeCell === cell) {
                activeZoom.cancel();
                activeZoom = null;
              }
            };
          }
        }

        // The backdrop and buttons fade in with a class added one frame later, so that fade is a real
        // transition from their hidden state instead of being coalesced into the first paint.
        requestAnimationFrame(function() {
          if (media.controlsGroup) {
            media.controlsGroup.style.transition = '';
          }

          lightbox.classList.add('is-lightbox-visible');
          setMediaVisible(media, true);
        });
      }

      var isClosing = false;
      var openedCell = null;

      function closeLightbox() {
        if (isClosing || isSliding || !activeCell) {
          return;
        }

        isClosing = true;

        var finalCell = activeCell;
        var media = getCellMedia(finalCell);
        var element = media.videoMedia || media.image;

        function finish() {
          if (activeZoom) {
            activeZoom.cancel();
            activeZoom = null;
          }

          collapseCell();
          lightbox.hidden = true;
          document.documentElement.style.overflow = '';
          document.documentElement.style.scrollbarGutter = '';
          isClosing = false;

          if (carousel) {
            carousel.addEventListener('carousel:change', scheduleAdvance);
            scheduleAdvance();
          }
        }

        // Catches up the carousel when the visitor navigated (next/prev) to an item that isn't on screen
        // (next/prev never move the carousel's own scroll position while it's open) BEFORE measuring
        // where the media has to land, so the target is the slot's real position on screen. Closing on
        // the item that was tapped, or on one that is already visible, never scrolls anything.
        if (carousel && finalCell !== openedCell) {
          var carouselRect = carousel.getBoundingClientRect();
          var cellRect = finalCell.getBoundingClientRect();

          if (cellRect.left < carouselRect.left - 1 || cellRect.right > carouselRect.right + 1) {
            carousel.select(cells.indexOf(finalCell), { instant: true });
          }
        }

        var finalRect = element ? element.getBoundingClientRect() : null;
        var slotRect = finalCell.getBoundingClientRect();

        lightbox.classList.remove('is-lightbox-visible');
        setMediaVisible(media, false);

        if (prefersReducedMotion || !finalRect || finalRect.width === 0 || slotRect.width === 0) {
          finish();
          return;
        }

        var animation = playZoom(element, slotRect, finalRect, true);

        animation.onfinish = finish;
        animation.oncancel = function() {
          if (isClosing) {
            finish();
          }
        };
      }

      // ---- Vertical feed (TikTok style) ---------------------------------------------------------------
      // Items are stacked one above the other, one screen apart: a swipe/drag, the wheel, the arrow keys
      // or the up/down buttons slide the current one out and the next one in. The media elements are the
      // same real ones as ever (fixed + centered, see media-zoom-style.liquid) - a slide is just a
      // transform on the outgoing and incoming ones, so nothing is moved in the DOM or re-buffered.
      // Ease-in-out and a longer duration: the previous fast-start curve (0.32, 0.72, 0, 1) over 380ms made the
      // jump between videos feel abrupt. Starting and ending gently reads as a smooth scroll instead.
      var slideEase = 'cubic-bezier(0.65, 0, 0.35, 1)';
      var slideDuration = prefersReducedMotion ? 1 : 650;
      var isSliding = false;
      var dragState = null;
      var suppressClick = false;
      var wheelLockedUntil = 0;
      var slideAnimations = [];

      function viewportHeight() {
        return window.innerHeight;
      }

      function slideElement(cell) {
        var media = getCellMedia(cell);

        return media.videoMedia || media.image;
      }

      function setSlideOffset(cell, offsetY) {
        var element = slideElement(cell);

        if (element) {
          element.style.transform = offsetY ? 'translateY(' + offsetY + 'px)' : '';
        }
      }

      // Items that are not the active one are parked a full screen away on the side they come from.
      function parkNeighbour(cell, direction) {
        expandMedia(cell);
        setSlideOffset(cell, direction * viewportHeight());
      }

      function updateNavButtons() {
        var index = cells.indexOf(activeCell);

        if (lightboxPrevButton) {
          lightboxPrevButton.disabled = index <= 0;
        }

        if (lightboxNextButton) {
          lightboxNextButton.disabled = index >= cells.length - 1;
        }
      }

      function cancelSlideAnimations() {
        slideAnimations.forEach(function(animation) {
          animation.cancel();
        });

        slideAnimations = [];
      }

      function slideTo(element, from, to, duration) {
        var animation = element.animate(
          [{ transform: 'translateY(' + from + 'px)' }, { transform: 'translateY(' + to + 'px)' }],
          { duration: duration, easing: slideEase, fill: 'both' }
        );

        slideAnimations.push(animation);

        return animation;
      }

      // Settles the feed on the next/previous item (direction: 1 = next, shown by sliding up, -1 =
      // previous), starting from wherever the finger/animation currently is (fromOffset, px).
      function commitSlide(direction, fromOffset) {
        var outgoing = activeCell;
        var incoming = cells[cells.indexOf(outgoing) + direction];

        if (!outgoing || !incoming) {
          return;
        }

        var height = viewportHeight();
        var outgoingElement = slideElement(outgoing);
        var incomingMedia = expandMedia(incoming);
        var incomingElement = incomingMedia.videoMedia || incomingMedia.image;

        isSliding = true;

        // What the outgoing item's own sound state was is read (and carried over) by collapseMedia() at
        // the end, but the new video has to start now so it is already moving as it slides in.
        var outgoingMedia = getCellMedia(outgoing);
        var outgoingVideo = outgoingMedia.videoMedia ? outgoingMedia.videoMedia.querySelector('video') : null;
        var carriedSound = outgoingVideo ? !outgoingVideo.muted : lightboxSoundOn;

        if (outgoingMedia.videoMedia) {
          outgoingMedia.videoMedia.pause(outgoingMedia.videoMedia.hasAttribute('autoplay') ? { manual: false } : undefined);
        }

        lightboxSoundOn = carriedSound;
        setMediaVisible(outgoingMedia, false);
        setMediaVisible(incomingMedia, true);
        startPlayback(incomingMedia, carriedSound);

        // Quicker when the finger already dragged most of the way.
        var remaining = Math.max(0.35, 1 - Math.abs(fromOffset) / height);
        var duration = Math.round(slideDuration * remaining);

        var incomingFrom = direction * height + fromOffset;

        setSlideOffset(outgoing, 0);
        setSlideOffset(incoming, 0);

        slideTo(outgoingElement, fromOffset, -direction * height, duration);

        var finishing = slideTo(incomingElement, incomingFrom, 0, duration);

        activeCell = incoming;
        updateNavButtons();
        warmNeighbours();

        finishing.onfinish = function() {
          cancelSlideAnimations();
          collapseMedia(outgoing);
          setSlideOffset(incoming, 0);
          isSliding = false;
        };
      }

      function springBack(direction, fromOffset) {
        var current = activeCell;
        var neighbour = cells[cells.indexOf(current) + direction];
        var height = viewportHeight();

        isSliding = true;
        setSlideOffset(current, 0);

        if (neighbour) {
          setSlideOffset(neighbour, 0);
        }

        var back = slideTo(slideElement(current), fromOffset, 0, 260);

        if (neighbour) {
          slideTo(slideElement(neighbour), direction * height + fromOffset, direction * height, 260);
        }

        back.onfinish = function() {
          cancelSlideAnimations();

          if (neighbour) {
            collapseMedia(neighbour);
          }

          isSliding = false;
        };
      }

      function showRelativeSlide(offset) {
        if (!activeCell || isSliding || isClosing) {
          return;
        }

        var target = cells[cells.indexOf(activeCell) + offset];

        if (!target) {
          return;
        }

        parkNeighbour(target, offset);

        // The parked item has to be laid out at its off-screen spot before the slide reads it.
        void slideElement(target).offsetHeight;

        commitSlide(offset, 0);
      }

      // Finger/mouse drag: the current item follows the pointer, the one it is heading to comes in right
      // behind it, and releasing either completes the slide or springs back.
      function pointerIsOnControl(event) {
        return event.target.closest && event.target.closest('button, a, .carousel-video-controls, .lightbox-scrubber, .lightbox-comments, .media-lightbox__close');
      }

      document.addEventListener('pointerdown', function(event) {
        if (lightbox.hidden || !activeCell || isSliding || isClosing || activeZoom || event.button > 0 || pointerIsOnControl(event)) {
          return;
        }

        dragState = {
          id: event.pointerId,
          startX: event.clientX,
          startY: event.clientY,
          offset: 0,
          dragging: false,
          parked: {},
          lastY: event.clientY,
          lastTime: event.timeStamp,
          velocity: 0
        };
      });

      document.addEventListener('pointermove', function(event) {
        if (!dragState || event.pointerId !== dragState.id) {
          return;
        }

        var deltaY = event.clientY - dragState.startY;

        if (!dragState.dragging) {
          if (Math.abs(deltaY) < 8 || Math.abs(deltaY) < Math.abs(event.clientX - dragState.startX)) {
            return;
          }

          dragState.dragging = true;
          suppressClick = true;
        }

        var direction = deltaY < 0 ? 1 : -1;
        var neighbour = cells[cells.indexOf(activeCell) + direction];

        // No item in that direction: the drag still follows the finger, but resists.
        var offset = neighbour ? deltaY : deltaY * 0.3;

        if (neighbour && !dragState.parked[direction]) {
          parkNeighbour(neighbour, direction);
          dragState.parked[direction] = neighbour;
        }

        dragState.offset = offset;
        dragState.direction = direction;
        dragState.hasNeighbour = !!neighbour;

        var elapsed = event.timeStamp - dragState.lastTime;

        if (elapsed > 0) {
          dragState.velocity = (event.clientY - dragState.lastY) / elapsed;
        }

        dragState.lastY = event.clientY;
        dragState.lastTime = event.timeStamp;

        setSlideOffset(activeCell, offset);

        Object.keys(dragState.parked).forEach(function(key) {
          var parkedDirection = Number(key);

          setSlideOffset(dragState.parked[key], parkedDirection * viewportHeight() + (parkedDirection === direction ? offset : 0));
        });

        event.preventDefault();
      }, { passive: false });

      function endDrag(event) {
        if (!dragState || event.pointerId !== dragState.id) {
          return;
        }

        var state = dragState;

        dragState = null;

        setTimeout(function() {
          suppressClick = false;
        }, 0);

        if (!state.dragging) {
          return;
        }

        var height = viewportHeight();
        var movedEnough = Math.abs(state.offset) > height * 0.18;
        var flicked = Math.abs(state.velocity) > 0.5 && Math.sign(state.velocity) === Math.sign(state.offset);

        // A neighbour parked for the opposite direction earlier in the same drag is no longer needed.
        Object.keys(state.parked).forEach(function(key) {
          if (Number(key) !== state.direction) {
            collapseMedia(state.parked[key]);
          }
        });

        if (state.hasNeighbour && (movedEnough || flicked)) {
          commitSlide(state.direction, state.offset);
        } else {
          springBack(state.direction, state.offset);
        }
      }

      // The browser's own image drag-and-drop would otherwise cancel the pointer drag.
      document.addEventListener('dragstart', function(event) {
        if (!lightbox.hidden) {
          event.preventDefault();
        }
      });

      document.addEventListener('pointerup', endDrag);
      document.addEventListener('pointercancel', endDrag);

      // A drag must not also count as a tap on whatever it ended over (play/pause, product link...).
      document.addEventListener('click', function(event) {
        if (suppressClick) {
          event.stopPropagation();
          event.preventDefault();
        }
      }, true);

      document.addEventListener('wheel', function(event) {
        if (lightbox.hidden || !activeCell) {
          return;
        }

        // The comments panel (Instagram feed) scrolls on its own: the wheel there is not a slide
        if (event.target.closest && event.target.closest('.lightbox-comments')) {
          return;
        }

        event.preventDefault();

        if (isSliding || isClosing || event.timeStamp < wheelLockedUntil || Math.abs(event.deltaY) < 24) {
          return;
        }

        // Trackpads keep emitting wheel events for a while after the gesture: one slide per gesture.
        wheelLockedUntil = event.timeStamp + slideDuration + 250;
        showRelativeSlide(event.deltaY > 0 ? 1 : -1);
      }, { passive: false });

      lightboxCloseButton.addEventListener('click', closeLightbox);

      if (lightboxPrevButton) {
        lightboxPrevButton.addEventListener('click', function() {
          showRelativeSlide(-1);
        });
      }

      if (lightboxNextButton) {
        lightboxNextButton.addEventListener('click', function() {
          showRelativeSlide(1);
        });
      }

      document.addEventListener('keydown', function(event) {
        if (lightbox.hidden) {
          return;
        }

        if (event.key === 'Escape') {
          closeLightbox();
        } else if (event.key === 'ArrowDown' || event.key === 'PageDown') {
          event.preventDefault();
          showRelativeSlide(1);
        } else if (event.key === 'ArrowUp' || event.key === 'PageUp') {
          event.preventDefault();
          showRelativeSlide(-1);
        } else if (event.key === 'ArrowRight') {
          seekActiveVideoBy(5);
        } else if (event.key === 'ArrowLeft') {
          seekActiveVideoBy(-5);
        }
      });

      wrapper.addEventListener('lightbox:open', function(event) {
        openLightbox(event.detail.index || 0);
      });
    });
  })();
</script>
