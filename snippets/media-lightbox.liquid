{%- doc -%}
Renders the lightbox chrome (backdrop + close button, optionally prev/next) used to zoom into a
media-zoom-slide item. The lightbox never moves the actual media element into itself - it only
toggles a class on the same video-media/img already sitting in its slide (see the
".is-lightbox-expanded" rules in snippets/media-zoom-style.liquid and the open/close logic in
snippets/media-zoom-script.liquid).

@param {string} id - id for this lightbox element
@param {boolean} [show_nav] - whether to render the prev/next buttons (only meaningful when there is more than one zoomable item to navigate between)
@param {string} [cart_variant_id] - when set, an "add to cart" button is rendered below the prev/next ones, adding this variant of the page's product (the real variant is read from the page's ?variant= at click time, this one is the fallback). The click is handled by the section that renders the lightbox.
@param {string} [cart_label] - accessible label of the cart button
{%- enddoc -%}

<div id="{{ id }}" class="contents" hidden>
  <div class="media-lightbox__backdrop"></div>

  <button type="button" class="media-lightbox__close" aria-label="{{ 'general.accessibility.close' | t }}">
    {%- render 'icon' with 'close' -%}
  </button>

  {%- if cart_variant_id != blank -%}
    <button type="button" class="media-lightbox__cart" data-variant-id="{{ cart_variant_id }}" aria-label="{{ cart_label | default: 'Add to cart' | escape }}">
      {%- render 'icon' with 'cart', class: 'icon--control' -%}
    </button>
  {%- endif -%}

  {%- if show_nav -%}
    <button type="button" class="media-lightbox__prev circle-button" aria-label="{{ 'general.accessibility.previous' | t }}">
      {%- render 'icon' with 'arrow-left' -%}
    </button>

    <button type="button" class="media-lightbox__next circle-button" aria-label="{{ 'general.accessibility.next' | t }}">
      {%- render 'icon' with 'arrow-right' -%}
    </button>
  {%- endif -%}
</div>
