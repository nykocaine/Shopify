{%- doc -%}
Renders a 5-star rating row for the Reviews section (sections/reviews.liquid).

The colour comes entirely from the `--reviews-star-color` CSS variable, which sections/reviews.liquid
sets from its own "Star color" setting - it never falls back to the text colour or the global
`product_rating_color`, so the stars stay independently configurable.

@param {number} rating - the rating value, 0-5 (fractions render a half star)
@param {string} [label] - accessible label for the whole row (falls back to the numeric rating)
{%- enddoc -%}

{%- liquid
  assign rating = rating | default: 0 | plus: 0
  assign row_label = label | default: rating
-%}

<span class="reviews-stars" role="img" aria-label="{{ row_label }}">
  {%- for i in (1..5) -%}
    {%- assign half_threshold = i | minus: 0.5 -%}
    {%- if rating >= i -%}
      {%- render 'icon' with 'star-rating', fill_color: 'var(--reviews-star-color)' -%}
    {%- elsif rating >= half_threshold -%}
      {%- render 'icon' with 'star-rating-half', fill_color: 'var(--reviews-star-color)' -%}
    {%- else -%}
      {%- render 'icon' with 'star-rating-empty', fill_color: 'var(--reviews-star-color)' -%}
    {%- endif -%}
  {%- endfor -%}
</span>
