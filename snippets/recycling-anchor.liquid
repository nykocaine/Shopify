{%- comment -%}
  Outputs the CSS custom properties that place one label of sections/recycling-panel.liquid: the dot's horizontal position and
  the vertical position (as a fraction of the illustration height), for phones (-m) and desktop (-d).
  With the built-in drawing a block can point at one of its parts (cap / bottle / box), whose centers are known for each of the two
  layouts (percentages of the drawing's viewBox); otherwise the manual position of the block is used for both layouts.
{%- endcomment -%}
{%- liquid
  assign part = block.settings.part
  assign manual_y = block.settings.position_y | divided_by: 100.0
  assign manual_x = block.settings.dot_x | append: '%'

  assign y_m = manual_y
  assign y_d = manual_y
  assign x_m = manual_x
  assign x_d = manual_x

  if built_in
    # anchors: phones (cap x,y / body y / box y), then desktop (cap x,y / body y / box x,y), all in % of the drawing
    assign pts = anchors | split: ','
    if part == 'cap'
      assign y_m = pts[1] | divided_by: 100.0
      assign y_d = pts[5] | divided_by: 100.0
      assign x_m = pts[0] | append: '%'
      assign x_d = pts[4] | append: '%'
    elsif part == 'bottle'
      assign y_m = pts[2] | divided_by: 100.0
      assign y_d = pts[6] | divided_by: 100.0
      assign x_m = pts[0] | append: '%'
      assign x_d = pts[4] | append: '%'
    elsif part == 'box'
      assign y_m = pts[3] | divided_by: 100.0
      assign y_d = pts[8] | divided_by: 100.0
      assign x_m = '50%'
      assign x_d = pts[7] | append: '%'
    endif
  endif
-%}
--y-m: {{ y_m }}; --y-d: {{ y_d }}; --dot-x-m: {{ x_m }}; --dot-x-d: {{ x_d }};
