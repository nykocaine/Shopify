{%- doc -%}
This snippet structures the micro-data using JSON-LD specification. Starting from Stretch, we are using
the structured_data built-in filter to ensure that Shopify can keep it up to date without requiring theme upgrade. If
you believe some information for products are missing, please reach Shopify support directly, as it is no longer
managed at the theme level.
{%- enddoc -%}

{%- if request.page_type == 'product' -%}
  {%- liquid
    assign product_structured_data = product | structured_data | strip
  -%}
  {%- comment -%}
  When the page has reviews turned on for Google (sections/reviews.liquid hands them over as reviews_ld), they are merged into the
  product's own data (the closing brace is replaced by the rating and the reviews) so the product stays a single item. If
  Shopify's data already carries a rating, nothing is added.
  {%- endcomment -%}
  {%- assign product_has_rating = false -%}

  {%- if product_structured_data contains 'aggregateRating' -%}
    {%- assign product_has_rating = true -%}
  {%- endif -%}

  {%- if reviews_ld != blank and product_has_rating == false -%}
    {%- assign product_structured_data_size = product_structured_data | size | minus: 1 -%}
    {%- assign product_structured_data_open = product_structured_data | slice: 0, product_structured_data_size -%}
    <script type="application/ld+json">
      {{- product_structured_data_open -}},{{- reviews_ld -}}}
    </script>
  {%- else -%}
  <script type="application/ld+json">
    {{- product_structured_data -}}
  </script>
  {%- endif -%}
{%- elsif request.page_type == 'article' -%}
  <script type="application/ld+json">
    {{- article | structured_data -}}
  </script>
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.home' | t | json }},
        "item": "{{ shop.url }}"
      }

      {%- if request.page_type == 'product' -%}
        {%- if collection -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": "{{ shop.url }}{{ collection.url }}"
          }, {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": "{{ shop.url }}{{ product.url }}"
          }
        {%- else -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }},
            "item": "{{ shop.url }}{{ product.url }}"
          }
        {%- endif -%}
      {%- elsif request.page_type == 'collection' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": "{{ shop.url }}{{ collection.url }}"
          }
      {%- elsif request.page_type == 'blog' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": "{{ shop.url }}{{ blog.url }}"
          }
      {%- elsif request.page_type == 'article' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": "{{ shop.url }}{{ blog.url }}"
          }, {
            "@type": "ListItem",
            "position": 3,
            "name": {{ article.title | json }},
            "item": "{{ shop.url }}{{ article.url }}"
          }
      {%- elsif request.page_type == 'page' -%}
        ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ page.title | json }},
            "item": "{{ shop.url }}{{ page.url }}"
          }
      {%- endif -%}
    ]
  }
</script>

{%- liquid
  assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}"

  # Same settings.social_X -> shop.brand.metafields.social_links.X fallback pattern used by
  # snippets/social-media.liquid for the visible follow icons, so a merchant only has to fill in
  # one of the two sources for it to also show up here in Organization.sameAs.
  assign social_url_list = ''
  assign social_delimiter = '|||'

  assign social_value = settings.social_facebook | default: shop.brand.metafields.social_links.facebook
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_twitter | default: shop.brand.metafields.social_links.twitter
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_instagram | default: shop.brand.metafields.social_links.instagram
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_threads | default: shop.brand.metafields.social_links.threads
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_pinterest | default: shop.brand.metafields.social_links.pinterest
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_youtube | default: shop.brand.metafields.social_links.youtube
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_tiktok | default: shop.brand.metafields.social_links.tiktok
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_vimeo | default: shop.brand.metafields.social_links.vimeo
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_linkedin | default: shop.brand.metafields.social_links.linkedin
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_snapchat | default: shop.brand.metafields.social_links.snapchat
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_whatsapp | default: shop.brand.metafields.social_links.whatsapp
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_tumblr | default: shop.brand.metafields.social_links.tumblr
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_wechat | default: shop.brand.metafields.social_links.wechat
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_reddit
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_line | default: shop.brand.metafields.social_links.line
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_spotify | default: shop.brand.metafields.social_links.spotify
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_value = settings.social_21buttons
  if social_value != blank
    assign social_url_list = social_url_list | append: social_value | append: social_delimiter
  endif

  assign social_urls = social_url_list | split: social_delimiter
-%}

<script type="application/ld+json">
[
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {{ potential_action_target | json }},
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {%- if shop.brand.logo -%}
      "logo": {{ shop.brand.logo | image_url: width: shop.brand.logo.width | prepend: "https:" | json }},
    {%- endif -%}
    {%- if shop.brand.short_description -%}
      "description": {{ shop.brand.short_description | json }},
    {%- endif -%}
    {%- if shop.brand.slogan -%}
      "slogan": {{ shop.brand.slogan | json }},
    {%- endif -%}
    {%- if social_urls.size > 0 -%}
      "sameAs": {{ social_urls | json }},
    {%- endif -%}
    "url": {{ shop.url | json }}
  }
]
</script>
{%- comment -%}
Site navigation: the main menu's links (and their sub-links) as SiteNavigationElement items, on the home page. It tells search
engines which pages are the main sections of the site (what they may show as sitelinks under the brand's result; Google decides on
its own whether to show them). It reads the "main-menu" menu, the one the header uses: edit that menu in Shopify (Contenido >
Menús) and this updates by itself. Links with no real address ("#") and external ones are skipped.
{%- endcomment -%}
{%- if request.page_type == 'index' and linklists['main-menu'].links.size > 0 -%}
  {%- liquid
    assign nav_items = ''
    assign nav_delimiter = '|||'

    for top_link in linklists['main-menu'].links
      assign nav_items = nav_items | append: top_link.title | append: '~~' | append: top_link.url | append: nav_delimiter

      for child_link in top_link.links
        assign nav_items = nav_items | append: child_link.title | append: '~~' | append: child_link.url | append: nav_delimiter
      endfor
    endfor

    assign nav_entries = nav_items | split: nav_delimiter
    assign nav_printed = 0
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Main navigation",
      "itemListElement": [
        {%- for nav_entry in nav_entries -%}
          {%- assign nav_pair = nav_entry | split: '~~' -%}
          {%- assign nav_name = nav_pair[0] -%}
          {%- assign nav_url = nav_pair[1] -%}

          {%- if nav_name != blank and nav_url != blank and nav_url != '#' -%}
            {%- assign nav_first_char = nav_url | slice: 0 -%}

            {%- if nav_first_char == '/' -%}
              {%- assign nav_printed = nav_printed | plus: 1 -%}
              {%- if nav_printed > 1 -%},{%- endif -%}
              {
                "@type": "SiteNavigationElement",
                "position": {{ nav_printed }},
                "name": {{ nav_name | json }},
                "url": {{ request.origin | append: nav_url | json }}
              }
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
