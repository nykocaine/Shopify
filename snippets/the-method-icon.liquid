{%- comment -%}
  Renders one of THE METHOD's inline option icons.
  Accepts:
  - icon: string key (dots, drop, ring, waves, unsure, circle, two-circles, overlap-circles, sun, moon, shield, spark)
{%- endcomment -%}

{%- case icon -%}
  {%- when 'dots' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <circle cx="7" cy="7" r="1.3"/>
      <circle cx="15" cy="6" r="1.6"/>
      <circle cx="17" cy="14" r="1.1"/>
      <circle cx="8" cy="15" r="1.8"/>
      <circle cx="14" cy="18" r="1"/>
    </svg>
  {%- when 'drop' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M12 3.5c3 3.8 5.5 7.4 5.5 10.3a5.5 5.5 0 1 1-11 0c0-2.9 2.5-6.5 5.5-10.3Z" stroke-linejoin="round"/>
    </svg>
  {%- when 'ring' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="12" cy="12" r="7.5"/>
      <path d="M12 4.5a7.5 7.5 0 0 1 0 15" fill="currentColor" fill-opacity="0.22" stroke="none"/>
    </svg>
  {%- when 'waves' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
      <path d="M4 8c2-1.2 4-1.2 6 0s4 1.2 6 0"/>
      <path d="M4 13.5c2-1.2 4-1.2 6 0s4 1.2 6 0"/>
      <path d="M4 19c2-1.2 4-1.2 6 0s4 1.2 6 0"/>
    </svg>
  {%- when 'unsure' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <circle cx="6" cy="12" r="1.5"/>
      <circle cx="12" cy="12" r="1.5"/>
      <circle cx="18" cy="12" r="1.5"/>
    </svg>
  {%- when 'circle' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="12" cy="12" r="7"/>
    </svg>
  {%- when 'two-circles' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="7.5" cy="12" r="4.5"/>
      <circle cx="16.5" cy="12" r="4.5"/>
    </svg>
  {%- when 'overlap-circles' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="9.5" cy="12" r="6"/>
      <circle cx="14.5" cy="12" r="6"/>
    </svg>
  {%- when 'sun' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4.5"/>
      <path d="M12 2.5v2.5M12 19v2.5M4.5 12H2M22 12h-2.5M5.8 5.8l1.8 1.8M16.4 16.4l1.8 1.8M18.2 5.8l-1.8 1.8M7.6 16.4l-1.8 1.8"/>
    </svg>
  {%- when 'moon' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/>
    </svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2.5 19.5 5.5V11c0 5.2-3.2 8.8-7.5 10.5C7.7 19.8 4.5 16.2 4.5 11V5.5Z"/>
    </svg>
  {%- when 'spark' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2c.6 3.8 2.1 6.4 5.5 7.5-3.4 1.1-4.9 3.7-5.5 7.5-.6-3.8-2.1-6.4-5.5-7.5C9.9 8.4 11.4 5.8 12 2Z"/>
    </svg>
{%- endcase -%}
