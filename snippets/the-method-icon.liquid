{%- comment -%}
  Renders one of THE METHOD's inline option icons. One minimal family: a thin line (the header icons' thickness, see the-method.liquid),
  round ends and round joins, no fills, all on the same 24 x 24 grid.
  Accepts:
  - icon: string key (dots, drop, ring, waves, unsure, circle, two-circles, overlap-circles, sun, moon, shield, spark)
{%- endcomment -%}

{%- capture the_method_icon_attributes -%}viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="the-method-icon"{%- endcapture -%}

{%- case icon -%}
  {%- when 'dots' -%}
    <svg {{ the_method_icon_attributes }}>
      <circle cx="8" cy="8.5" r="1.8"/>
      <circle cx="16" cy="7.5" r="1.3"/>
      <circle cx="14" cy="15.5" r="2.2"/>
      <circle cx="7" cy="17" r="1"/>
    </svg>
  {%- when 'drop' -%}
    <svg {{ the_method_icon_attributes }}>
      <path d="M12 3.5c3 3.6 5.5 6.9 5.5 9.8a5.5 5.5 0 0 1-11 0c0-2.9 2.5-6.2 5.5-9.8Z"/>
    </svg>
  {%- when 'ring' -%}
    <svg {{ the_method_icon_attributes }}>
      <circle cx="12" cy="12" r="7.5"/>
      <path d="M12 4.5v15"/>
    </svg>
  {%- when 'waves' -%}
    <svg {{ the_method_icon_attributes }}>
      <path d="M4 9c2-1.4 4-1.4 6 0s4 1.4 6 0 3-1 4-.5"/>
      <path d="M4 15c2-1.4 4-1.4 6 0s4 1.4 6 0 3-1 4-.5"/>
    </svg>
  {%- when 'unsure' -%}
    <svg {{ the_method_icon_attributes }}>
      <circle cx="6" cy="12" r="1.2"/>
      <circle cx="12" cy="12" r="1.2"/>
      <circle cx="18" cy="12" r="1.2"/>
    </svg>
  {%- when 'circle' -%}
    <svg {{ the_method_icon_attributes }}>
      <circle cx="12" cy="12" r="7"/>
    </svg>
  {%- when 'two-circles' -%}
    <svg {{ the_method_icon_attributes }}>
      <circle cx="7.5" cy="12" r="4.5"/>
      <circle cx="16.5" cy="12" r="4.5"/>
    </svg>
  {%- when 'overlap-circles' -%}
    <svg {{ the_method_icon_attributes }}>
      <circle cx="9.5" cy="12" r="6"/>
      <circle cx="14.5" cy="12" r="6"/>
    </svg>
  {%- when 'sun' -%}
    <svg {{ the_method_icon_attributes }}>
      <circle cx="12" cy="12" r="4"/>
      <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"/>
    </svg>
  {%- when 'moon' -%}
    <svg {{ the_method_icon_attributes }}>
      <path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10Z"/>
    </svg>
  {%- when 'shield' -%}
    <svg {{ the_method_icon_attributes }}>
      <path d="M12 3 19 6v5.5c0 4.6-3 7.8-7 9.5-4-1.7-7-4.9-7-9.5V6Z"/>
    </svg>
  {%- when 'spark' -%}
    <svg {{ the_method_icon_attributes }}>
      <path d="M12 3.5c.6 3.6 2 5.9 5.5 7.5-3.5 1.6-4.9 3.9-5.5 7.5-.6-3.6-2-5.9-5.5-7.5C10 9.4 11.4 7.1 12 3.5Z"/>
    </svg>
{%- endcase -%}
