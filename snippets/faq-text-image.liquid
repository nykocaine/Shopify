{%- doc -%}
Renders a FAQ "Text + image/video" block: optional title, rich text, and up to 3 media items (image
or video, chosen per slot - video wins over image when both are set, same as Media Blocks' Carousel).
Single column (title, then text, then media) on mobile, stacked in that order; from 700px up, when
there's at least one media item, title | text | media become three equal columns.

Every media item - whether there's one or several - renders through the exact same shared markup as
Media Blocks' Carousel: snippets/media-zoom-slide.liquid (sound/play-pause toggle, zoom-to-lightbox),
snippets/media-lightbox.liquid, snippets/media-zoom-script.liquid and snippets/media-zoom-style.liquid.
With more than one media item, they additionally scroll inside a <product-list> exactly like
sections/media-blocks.liquid's 'carousel' block cells do - see that section for the other caller of
the same snippets. Each item gets a <figcaption> below it (its own per-slide caption), outside the
media itself - the same <figure>/<figcaption> pattern as blocks/image-with-caption.liquid.

@param {object} block - the "text_image" block to render
@param {number} [faq_border_radius] - the section's own corner radius (Corner radius setting), applied to the media so it matches the section's rounded corners
{%- enddoc -%}

{%- liquid
  assign slide_count = 0

  for i in (1..3)
    assign image_key = 'image_' | append: i
    assign video_key = 'video_' | append: i

    if block.settings[image_key] != blank or block.settings[video_key] != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor

  assign has_media = false

  if slide_count > 0
    assign has_media = true
  endif

  assign is_carousel = false

  if slide_count > 1
    assign is_carousel = true
  endif

  # Same layout logic as sections/contact.liquid's own "Decorative icon" settings, just driven by
  # this block's settings instead of the section's - see contact.liquid for the full rationale.
  assign icon_justify_self = 'start'

  case block.settings.icon_alignment
    when 'center'
      assign icon_justify_self = 'center'
    when 'right'
      assign icon_justify_self = 'end'
  endcase

  assign icon_display = 'grid'
  assign icon_grid_template_columns = 'auto 1fr'
  assign icon_grid_template_areas = '"title icon"'
  assign icon_flex_direction = 'column'

  case block.settings.icon_position
    when 'left'
      assign icon_grid_template_columns = '1fr auto'
      assign icon_grid_template_areas = '"icon title"'
    when 'above'
      assign icon_display = 'flex'
      assign icon_flex_direction = 'column-reverse'
    when 'below'
      assign icon_display = 'flex'
      assign icon_flex_direction = 'column'
  endcase

  assign heading_row_id = 'faq-text-image-heading-row-' | append: block.id
-%}

{%- if block.settings.title != blank or block.settings.text != blank or block.settings.show_icon or has_media -%}
  <div class="faq__text-image {% if has_media %}faq__text-image--with-image{% endif %}" {{ block.shopify_attributes }}>
    {%- if block.settings.title != blank or block.settings.show_icon -%}
      <div class="faq__text-image-title prose">
        <div class="faq__text-image-heading-row" id="{{ heading_row_id }}">
          {%- if block.settings.title != blank -%}
            <div class="faq__text-image-heading-row__title">
              {%- render 'heading', content: block.settings.title, style: 'h5', html_tag: 'h3' -%}
            </div>
          {%- endif -%}

          {%- if block.settings.show_icon -%}
            <div class="faq__text-image-heading-row__icon">
              {%- render 'decorative-icon',
                icon_type: block.settings.icon_type,
                icon_size: block.settings.icon_size,
                icon_spin: block.settings.icon_spin,
                icon_primary_color: block.settings.icon_primary_color,
                icon_secondary_color: block.settings.icon_secondary_color,
                icon_border_color: block.settings.icon_border_color
              -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- if block.settings.show_icon -%}
        <style>
          #{{ heading_row_id }} {
            display: {{ icon_display }};
            {%- if icon_display == 'grid' -%}
              grid-template-columns: {{ icon_grid_template_columns }};
              grid-template-areas: {{ icon_grid_template_areas }};
              align-items: center;
            {%- else -%}
              flex-direction: {{ icon_flex_direction }};
              align-items: flex-start;
            {%- endif -%}
            gap: .5rem;
          }

          #{{ heading_row_id }} .faq__text-image-heading-row__title {
            grid-area: title;
          }

          {%- comment -%}
          Same two-levels-deep .prose spacing fix as contact.liquid's .contact-heading-row__title - see
          that section for the full rationale (the heading sits past .prose's own one-level exemption).
          {%- endcomment -%}
          #{{ heading_row_id }} .faq__text-image-heading-row__title > * {
            text-box: trim-both cap alphabetic;
            margin-block-start: 0;
          }

          #{{ heading_row_id }} .faq__text-image-heading-row__icon {
            grid-area: icon;
            {%- if icon_display == 'grid' -%}
              justify-self: {{ icon_justify_self }};
            {%- else -%}
              align-self: {{ icon_justify_self }};
            {%- endif -%}
          }

          #{{ heading_row_id }} .faq__text-image-heading-row__icon svg {
            margin-block: calc(var(--prose-media-spacing) / 2);
          }
        </style>
      {%- endif -%}
    {%- endif -%}

    {%- if block.settings.text != blank -%}
      <div class="faq__text-image-text prose">
        {{- block.settings.text -}}
      </div>
    {%- endif -%}

    {%- if has_media -%}
      {%- liquid
        assign media_corner_radius = faq_border_radius | default: 0 | append: 'px'
        assign media_wrapper_id = 'faq-text-image-media-' | append: block.id
        assign media_lightbox_id = 'faq-text-image-lightbox-' | append: block.id
        assign media_carousel_id = nil

        if is_carousel
          assign media_carousel_id = 'faq-text-image-carousel-' | append: block.id
        endif
      -%}

      <div class="faq__text-image-media" id="{{ media_wrapper_id }}">
        {%- if is_carousel -%}
          <div style="border-radius: {{ media_corner_radius }}; overflow: hidden;">
            <product-list id="{{ media_carousel_id }}" cell-selector=".snap-start" class="scroll-area snap-x">
              {%- liquid
                assign lightbox_slide_index = 0
              -%}
              {%- for i in (1..3) -%}
                {%- capture image_key -%}image_{{ i }}{%- endcapture -%}
                {%- capture video_key -%}video_{{ i }}{%- endcapture -%}
                {%- capture caption_key -%}caption_{{ i }}{%- endcapture -%}

                {%- assign slide_image = block.settings[image_key] -%}
                {%- assign slide_video = block.settings[video_key] -%}
                {%- assign slide_caption = block.settings[caption_key] -%}

                {%- if slide_image != blank or slide_video != blank -%}
                  <figure class="snap-start">
                    {%- render 'media-zoom-slide',
                      video: slide_video,
                      image: slide_image,
                      block_size: block.settings.block_size,
                      mobile_block_size: block.settings.mobile_block_size,
                      corner_radius: media_corner_radius,
                      lightbox_id: media_lightbox_id,
                      aria_controls_id: media_carousel_id,
                      lightbox_index: lightbox_slide_index,
                      sizes: '(max-width: 699px) 100vw, 33vw'
                    -%}

                    {%- if slide_caption != blank -%}
                      <figcaption>{{ slide_caption }}</figcaption>
                    {%- endif -%}
                  </figure>

                  {%- assign lightbox_slide_index = lightbox_slide_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </product-list>
          </div>

          {%- render 'media-lightbox', id: media_lightbox_id, show_nav: true -%}

          <progress-bar track-scroll-target="{{ media_carousel_id }}" class="progress-bar w-full"></progress-bar>
        {%- else -%}
          <figure>
            {%- render 'media-zoom-slide',
              video: block.settings.video_1,
              image: block.settings.image_1,
              block_size: block.settings.block_size,
              mobile_block_size: block.settings.mobile_block_size,
              corner_radius: media_corner_radius,
              lightbox_id: media_lightbox_id,
              lightbox_index: 0,
              as_lightbox_cell: true,
              sizes: '(max-width: 699px) 100vw, 33vw'
            -%}

            {%- if block.settings.caption_1 != blank -%}
              <figcaption>{{ block.settings.caption_1 }}</figcaption>
            {%- endif -%}
          </figure>

          {%- render 'media-lightbox', id: media_lightbox_id, show_nav: false -%}
        {%- endif -%}
      </div>

      <style>
        {%- if is_carousel -%}
          {%- comment -%}
          Same auto-flow percentage-width grid Media Blocks' Carousel uses on its own <product-list>
          (sections/media-blocks.liquid) - 85% of the wrapper on mobile (full slide, peek of the
          next), 45% from 700px up. Scoped to this block's own carousel id, same as Carousel scopes
          to its own block id.
          {%- endcomment -%}
          #{{ media_carousel_id }} {
            grid: auto / auto-flow 85%;
            gap: .75rem;
            display: grid;
          }

          @media screen and (min-width: 700px) {
            #{{ media_carousel_id }} {
              grid: auto / auto-flow 45%;
            }
          }
        {%- endif -%}

        {%- render 'media-zoom-style',
          wrapper_id: media_wrapper_id,
          lightbox_id: media_lightbox_id,
          corner_radius: media_corner_radius,
          has_multiple_slides: is_carousel
        -%}
      </style>

      {%- render 'media-zoom-script', wrapper_id: media_wrapper_id, lightbox_id: media_lightbox_id, carousel_id: media_carousel_id -%}
    {%- endif -%}
  </div>
{%- endif -%}
