{%- doc -%}
The round picture that goes with a reviewer's name, shared by the Reviews section and the Instagram Feed's zoom view so the same reviewer has the same picture
in both. Reviews carry no photo, so it is generated: a soft gradient with a person's silhouette, its colors taken from the name (same name, same picture).

Defines, once per page, window.buildReviewAvatar(name) and window.buildReviewHandle(name) (the "@user" shown with the picture), and the .review-avatar
look (size from --review-avatar-size, 1.75rem by default).
{%- enddoc -%}

<style>
  .review-avatar {
    flex: none;
    display: block;
    width: var(--review-avatar-size, 1.75rem);
    height: var(--review-avatar-size, 1.75rem);
    border-radius: 100%;
    overflow: hidden;
  }
</style>

<script>
  if (!window.buildReviewAvatar) {
    window.buildReviewAvatar = function (name) {
      var hash = 0;

      for (var index = 0; index < name.length; index += 1) {
        hash = (hash * 31 + name.charCodeAt(index)) % 360;
      }

      var avatar = document.createElement('span');

      avatar.className = 'review-avatar';
      avatar.setAttribute('aria-hidden', 'true');
      avatar.style.background = 'linear-gradient(145deg, hsl(' + hash + ', 55%, 72%), hsl(' + ((hash + 40) % 360) + ', 50%, 52%))';
      avatar.innerHTML = '<svg viewBox="0 0 32 32" width="100%" height="100%" focusable="false"><circle cx="16" cy="12.5" r="5.2" fill="#fff" fill-opacity="0.9"/><path d="M5.5 29c0-6 4.7-9.8 10.5-9.8S26.5 23 26.5 29" fill="#fff" fill-opacity="0.9"/></svg>';

      return avatar;
    };
  }
</script>

<script>
  if (!window.buildReviewHandle) {
    {%- comment -%}
    Handles look like ones people actually pick: mostly short and plain (a nickname, an initial plus the surname, the name with a letter stretched), with a
    number only now and then. Always the same handle for the same reviewer: everything is picked from a number computed from the name.
    {%- endcomment -%}
    window.buildReviewHandle = function (name) {
      var words = name.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().split(/\s+/).map(function (word) {
        return word.replace(/[^a-z0-9]+/g, '');
      }).filter(Boolean);

      if (!words.length) {
        return '';
      }

      var seed = 11;

      for (var index = 0; index < name.length; index += 1) {
        seed = (seed * 37 + name.charCodeAt(index)) % 1000003;
      }

      function pick(list, offset) {
        return list[(seed >> offset) % list.length];
      }

      var first = words[0];
      var last = words.length > 1 ? words[words.length - 1] : '';
      var nick = first.length > 5 ? first.slice(0, 4 + (seed % 2)) : first;
      var stretched = first.replace(/([aeiou])(?!.*[aeiou])/, '$1$1');
      var birth = String(88 + (seed % 15)).slice(-2);
      var small = ['x', 'z', 'k', 'j'];
      var patterns = last ? [
        first.charAt(0) + last,
        first + last.charAt(0),
        nick + '.' + last.slice(0, 3),
        last + '.' + first.charAt(0),
        first + '_' + last.charAt(0),
        first + '.' + last.charAt(0),
        nick + last.charAt(0) + pick(small, 3),
        first + '.' + last,
        stretched,
        first + birth,
        last.slice(0, 4) + '_' + first.slice(0, 3),
        first + '_' + last.slice(0, 2)
      ] : [
        first,
        stretched,
        first + '_' + first.charAt(0),
        first + '_' + pick(small, 3),
        first + '.' + pick(small, 5) + pick(small, 7),
        first + birth,
        'its' + first,
        '_' + first
      ];

      return '@' + patterns[seed % patterns.length];
    };
  }
</script>
