{%- comment -%}
  Scroll reveal: each section of <main> fades in while sliding up slightly the first time it enters the viewport.

  - Sections are only hidden once the script has run (class "sr-ready" on <html>), so without JS everything stays visible.
  - Disabled in the theme editor and for visitors who prefer reduced motion.
  - The transform exists only while the animation runs (keyframes, no fill-mode "forwards"), so afterwards the section
    has no transform and position: fixed / sticky descendants (lightboxes, sticky headers) keep working.
  - Sections on screen at load animate in one after another; the rest animate as they are scrolled into view.
{%- endcomment -%}
<style>
  @media (prefers-reduced-motion: no-preference) {
    html.sr-ready main > .shopify-section:not(.sr-in) {
      opacity: 0;
      transform: translateY(48px);
    }

    html.sr-ready main > .shopify-section.sr-in {
      animation: sr-rise 0.9s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }

    @keyframes sr-rise {
      from {
        opacity: 0;
        transform: translateY(48px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
<script>
  (function () {
    if (
      !('IntersectionObserver' in window) ||
      (window.Shopify && Shopify.designMode) ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      return;
    }

    var sections = Array.prototype.slice.call(document.querySelectorAll('main > .shopify-section'));

    if (!sections.length) {
      return;
    }

    // This script sits right after <main>, so the sections already exist: hide them at once (no flash of visible content).
    document.documentElement.classList.add('sr-ready');

    var observer = new IntersectionObserver(
      function (entries) {
        var visible = entries
          .filter(function (entry) {
            return entry.isIntersecting;
          })
          .sort(function (a, b) {
            return a.boundingClientRect.top - b.boundingClientRect.top;
          });

        // Sections that appear together (page load) come in one after another.
        visible.forEach(function (entry, index) {
          entry.target.style.animationDelay = index * 0.12 + 's';
          entry.target.classList.add('sr-in');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.05, rootMargin: '0px 0px -5% 0px' }
    );

    sections.forEach(function (section) {
      // Sections already above the viewport (e.g. restored scroll position) are shown without animating.
      if (section.getBoundingClientRect().bottom < 0) {
        section.classList.add('sr-in');
        section.style.animation = 'none';
        return;
      }

      observer.observe(section);
    });

    // Safety net: if the observer never fired at all, show everything rather than leave the page blank.
    setTimeout(function () {
      if (!document.querySelector('main > .shopify-section.sr-in')) {
        sections.forEach(function (section) {
          section.classList.add('sr-in');
        });
      }
    }, 3000);
  })();
</script>
