{%- comment -%}
  Scroll reveal, section by section: every section of the page (the ones in <main> and the footer) rises slightly
  (with a soft fade-in), the first time it enters the viewport. Sections that are on screen when
  the page loads come in one after another; the rest do as they are scrolled into view.

  - Uses the Web Animations API: nothing is left behind once an animation ends (no transform), so
    position: fixed / sticky descendants and overflowing content (shadows, dropdowns) behave normally afterwards.
  - Off only for visitors who prefer reduced motion. If anything goes wrong, content is shown.
  - Adds data-scroll-reveal="on" to <html> when it is active (handy to check it is running).
{%- endcomment -%}
<script>
  (function () {
    if (!('IntersectionObserver' in window) || !Element.prototype.animate || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    var DISTANCE = 60; // px of upward travel
    var DURATION = 1100; // ms
    var STEP = 150; // ms between sections revealed together
    var EASING = 'cubic-bezier(0.22, 0.61, 0.36, 1)';

    var sections = Array.prototype.filter.call(
      document.querySelectorAll('main > .shopify-section, .shopify-section-group-footer-group'),
      function (section) {
        return section.getClientRects().length > 0;
      }
    );

    if (!sections.length) {
      return;
    }

    document.documentElement.setAttribute('data-scroll-reveal', 'on');

    var revealedCount = 0;

    sections.forEach(function (section) {
      section.style.opacity = '0';
    });

    function reveal(section, index) {
      section.style.opacity = '';
      revealedCount += 1;

      section.animate(
        [
          { opacity: 0, transform: 'translateY(' + DISTANCE + 'px)' },
          { opacity: 1, transform: 'translateY(0)' }
        ],
        { duration: DURATION, delay: Math.min(index, 6) * STEP, easing: EASING, fill: 'backwards' }
      );
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries
          .filter(function (entry) {
            return entry.isIntersecting;
          })
          .sort(function (a, b) {
            return a.boundingClientRect.top - b.boundingClientRect.top;
          })
          .forEach(function (entry, index) {
            observer.unobserve(entry.target);
            reveal(entry.target, index);
          });
      },
      { threshold: 0.05, rootMargin: '0px 0px -5% 0px' }
    );

    sections.forEach(function (section) {
      // Already scrolled past (restored scroll position): show it without animating.
      if (section.getBoundingClientRect().bottom < 0) {
        section.style.opacity = '';
        return;
      }

      observer.observe(section);
    });

    // A fast jump (anchor link, scrollbar drag) can skip sections entirely: whatever is left above the viewport is shown as is.
    var scrollQueued = false;

    window.addEventListener(
      'scroll',
      function () {
        if (scrollQueued) {
          return;
        }

        scrollQueued = true;

        requestAnimationFrame(function () {
          scrollQueued = false;

          sections.forEach(function (section) {
            if (section.style.opacity === '0' && section.getBoundingClientRect().bottom < 0) {
              observer.unobserve(section);
              section.style.opacity = '';
            }
          });
        });
      },
      { passive: true }
    );

    // Safety net: if nothing was ever revealed, show everything instead of leaving the page blank.
    setTimeout(function () {
      if (!revealedCount) {
        sections.forEach(function (section) {
          section.style.opacity = '';
        });
      }
    }, 3000);
  })();
</script>
