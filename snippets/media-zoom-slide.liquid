{%- doc -%}
Renders a single "zoomable" media item: an image, or a video with its own sound/play-pause toggle
controls and a zoom-to-lightbox button. This is the exact media markup Media Blocks' Carousel block
uses for each slide, extracted so it can be shared with any other block that needs one static
zoomable media item (eg. FAQ's "Text + image/video" block) instead of duplicating it.

Pair with snippets/media-lightbox.liquid (the lightbox chrome) and snippets/media-zoom-script.liquid
(the behavior) and snippets/media-zoom-style.liquid (the styling) - see sections/media-blocks.liquid's
'carousel' block and snippets/faq-text-image.liquid for both callers.

@param {object} [video] - the video to render. Takes priority over image when set.
@param {object} [image] - the image to render when no video is set.
@param {string} [block_size] - desktop block size keyword (auto/sm/md/lg/fill), used as the md:min-h-* class
@param {string} [mobile_block_size] - mobile block size keyword (auto/sm/md/lg/fill), used as the min-h-* class
@param {string} [corner_radius] - CSS value for the item's border-radius (eg. "var(--media-blocks-corner-radius)" or "12px")
@param {string} [heading] - optional heading shown over the media (carousel slide caption)
@param {string} [text] - optional rich text shown under the heading
@param {boolean} [show_product_button] - whether to show the "go to product" button next to the video controls
@param {object} [product] - the product the button links to
@param {string} [product_button_type] - 'icon' or 'text'
@param {string} [product_button_text] - button text / accessible label
@param {string} [lightbox_id] - id of the media-lightbox element the zoom button should open
@param {string} [aria_controls_id] - id referenced by the zoom button's aria-controls (defaults to lightbox_id)
@param {number} [lightbox_index] - this item's index within the lightbox's media list
@param {boolean} [enable_lightbox] - whether to show the zoom-to-lightbox button (default true)
@param {boolean} [as_lightbox_cell] - adds the data-media-cell hook snippets/media-zoom-script.liquid uses to find items when there is no carousel element
@param {string} [sizes] - sizes attribute passed to the 'media' snippet
@param {string} [placeholder] - placeholder SVG name used when neither video nor image is set
{%- enddoc -%}

{%- liquid
  assign resolved_sizes = sizes | default: '85vw'
  assign resolved_placeholder = placeholder | default: 'hero-apparel-1'
  assign resolved_aria_controls_id = aria_controls_id | default: lightbox_id
-%}

<div class="content-box h-full min-h-{{ mobile_block_size }} md:min-h-{{ block_size }}" style="border-radius: {{ corner_radius }}; overflow: hidden;" {% if as_lightbox_cell %}data-media-cell{% endif %}>
  <div class="content-box__background-media {% if video != blank %}carousel-video-tap-to-play{% endif %}">
    {%- if video != blank -%}
      {%- render 'media', media: video, autoplay: false, muted: true, controls: false, show_play_button: false, playsinline: true, sizes: resolved_sizes -%}

      {%- capture control_button_style -%}
        width: var(--control-button-size, 1.75rem); height: var(--control-button-size, 1.75rem); background: var(--control-button-background-color, #000000); border: var(--control-button-border-width, 1px) solid var(--control-button-border-color, #000000); border-radius: var(--control-button-border-radius, 100%); color: var(--control-button-icon-color, #ffffff);
      {%- endcapture -%}

      {%- assign resolved_show_product_button = false -%}

      {%- if show_product_button and product != blank -%}
        {%- assign resolved_show_product_button = true -%}

        {%- capture product_button_style -%}
          height: var(--control-button-size, 1.75rem); background: var(--control-button-background-color, #000000); border: var(--control-button-border-width, 1px) solid var(--control-button-border-color, #000000); border-radius: var(--control-button-border-radius, 100%); color: var(--control-button-icon-color, #ffffff); {% if product_button_type == 'text' %}width: auto; padding-inline: 0.75rem;{% else %}width: var(--control-button-size, 1.75rem);{% endif %}
        {%- endcapture -%}
      {%- endif -%}

      <div class="h-stack gap-2 carousel-video-controls">
        {%- if resolved_show_product_button -%}
          <a href="{{ product.url }}" class="carousel-video-product-link circle-button" style="{{ product_button_style }}">
            {%- if product_button_type == 'text' -%}
              <span class="carousel-video-product-link__text">{{ product_button_text | default: product.title }}</span>
            {%- else -%}
              <span class="sr-only">{{ product_button_text | default: product.title }}</span>
              {%- render 'icon' with 'cart', width: 14 -%}
            {%- endif -%}
          </a>
        {%- endif -%}

        <button type="button" class="carousel-video-sound-toggle circle-button" style="{{ control_button_style }}">
          <span class="sr-only">{{ 'general.accessibility.toggle_autoplay' | t }}</span>
          {%- render 'icon' with 'volume-off', width: 14, class: 'carousel-video-sound-off-icon' -%}
          {%- render 'icon' with 'volume', width: 14, class: 'carousel-video-sound-icon hidden' -%}
        </button>

        <button type="button" class="carousel-video-pause-toggle circle-button" style="{{ control_button_style }}">
          <span class="sr-only">{{ 'general.accessibility.toggle_autoplay' | t }}</span>
          {%- render 'icon' with 'slideshow-pause', width: 14, class: 'carousel-video-pause-icon hidden' -%}
          {%- render 'icon' with 'slideshow-play', width: 14, class: 'carousel-video-play-icon' -%}
        </button>
      </div>
    {%- elsif image != blank -%}
      {%- render 'media' with image, sizes: resolved_sizes, class: 'image-cover' -%}
    {%- else -%}
      {{- resolved_placeholder | placeholder_svg_tag: 'size-full' -}}
    {%- endif -%}

    {%- if enable_lightbox != false and (video != blank or image != blank) -%}
      <open-lightbox-button class="block" aria-controls="{{ resolved_aria_controls_id }}" image-index="{{ lightbox_index | default: 0 }}">
        <button type="button" class="product-zoom-button">
          {%- render 'icon' with 'zoom-plus', width: 16 -%}
          <span class="product-zoom-button__label">{{ 'product.gallery.zoom' | t }}</span>
        </button>
      </open-lightbox-button>
    {%- endif -%}
  </div>

  {%- if heading != blank or text != blank -%}
    <div class="place-self-center" style="max-width: 30rem">
      <div class="prose prose-justify-center">
        {%- if heading != blank -%}
          {%- render 'heading', content: heading, style: 'h3', html_tag: 'h3' -%}
        {%- endif -%}

        {%- if text != blank -%}
          <div>{{ text }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>
