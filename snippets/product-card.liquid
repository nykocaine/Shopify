{%- doc -%}
This component is used in collection and featured collection to render a single product as a card.

A card can be highlighted (takes bigger space in listing) by creating a metafield definition with the key
"highlight_card" and namespace "custom". It must be a boolean metafield.

NOTE TO DEVELOPERS OR AGENCIES: this code is quite complex due to the extremely large number of possible combinations
that the design team wanted to achieve. There are hundreds of possible permutations, and we tried to handle them
using the least amount of code possible. We however had to do some deep nesting of div to be able to handle most of
the conditions. If you have to modify extensively this code, we would eventually recommend to first simplify the structure
based on your desired layout (and remove most of the settings associated), and then do your customizations on top of it.

@param {object} product - the product to render
@param {boolean} [reveal] - if set to true, the card will be revealed on scroll through animation
@param {number} [position] - the position of the card in the list. If specified, the theme will eagerly load the first 3 cards images
@param {object} [color_scheme] - the color scheme to use (if none is set, it defaults to the default card scheme)
@param {boolean} [allow_highlight] - if set to true, this card is allowed to be highlighted (shown bigger) if the "custom.highlight_card" metafield is set
@param {boolean} [show_badges] - show or not the badges (default to true if nothing is set)
@param {boolean} [show_rating] - show or not the rating. If nothing is set, the theme uses the default product card setting
@param {boolean} [show_vendor] - show or not the vendor. If nothing is set, the theme uses the default product card setting
@param {boolean} [show_quick_buy] - show or not the quick buy (by default the "show_quick_buy" checkbox of the section the card is in, off unless that section turns it on; it opens a modal if the product contains more than 1 choice): the cart icon over the image on touch screens, a button under the product info with a mouse
@param {boolean} [show_secondary_image] - show or not the secondary media on hover. If nothing is set, the theme uses the default product card setting
@param {boolean} [show_swatches] - show or not the swatches. The swatch type is inferred from setting, and will default to true if nothing is set
@param {boolean} [force_no_border] - if set to true, no border will be added around cards, even if the global setting ask to
@param {string} [sizes] - the value of the sizes attribute (because it depends of the context, it should be calculated outside)
@param {string} [prefix_id] - an optional prefix being used to prefix all the inputs. This is useful when we have to output multiple product card on the same page, to avoid any ID conflicts
@param {string} [quick_buy_context]
@param {object} [block]
@param {object} [section]
{%- enddoc -%}

{%- liquid
  assign color_scheme = color_scheme | default: settings.product_card_color_scheme
  assign show_badges = show_badges | default: true, allow_false: true
  assign show_rating = show_rating | default: settings.product_card_show_rating, allow_false: true
  assign show_vendor = show_vendor | default: settings.product_card_show_vendor, allow_false: true
  assign show_quick_buy = show_quick_buy | default: section.settings.show_quick_buy, allow_false: true
  assign show_secondary_image = show_secondary_image | default: settings.product_card_show_secondary_image, allow_false: true
  assign show_swatches = show_swatches | default: settings.product_card_show_color_swatches, allow_false: true

  if allow_highlight and product.metafields.custom.highlight_card.value
    assign highlight_card = true
    assign sizes = '(max-width: 699px) 100vw, 50vw'
  endif

  assign show_badges_along_info = false
  assign show_swatches_along_info = false

  if settings.product_card_info_position == 'inside'
    assign product_card_info_self_placement = 'place-self-' | append: settings.product_card_info_vertical_alignment | append: '-' | append: settings.product_card_info_horizontal_alignment | replace: 'start-start', 'start' | replace: 'end-end', 'end'

    if product_card_info_self_placement == settings.product_card_badges_placement
      assign show_badges_along_info = true
    endif

    if product_card_info_self_placement == settings.product_card_swatches_placement
      assign show_swatches_along_info = true
    endif
  endif

  assign product_card_classes = 'product-card'

  if highlight_card
    assign product_card_classes = product_card_classes | append: ' product-card--highlight'
  endif

  if settings.product_listing_spacing == 'none' and force_no_border != true
    assign product_card_classes = product_card_classes | append: ' product-card--bordered'
  endif

  if settings.product_card_info_position == 'outside'
    assign product_card_classes = product_card_classes | append: ' product-card--info-outside'
  elsif settings.product_card_info_position == 'card'
    # Single card: laid out like "outside" (image, then the info under it), but the whole card is one box with the card's color scheme and
    # radius (theme.css, .product-card--single)
    assign product_card_classes = product_card_classes | append: ' product-card--info-outside product-card--single'
  else
    assign product_card_classes = product_card_classes | append: ' product-card--info-inside'
  endif

  case settings.product_card_style
    when 'subheading'
      assign vendor_class = 'subheading text-subdued'
      assign title_class = 'subheading'

    when 'body_text'
      assign vendor_class = 'text-sm text-subdued'
      assign title_class = 'text-base'

    when 'heading'
      assign vendor_class = 'heading text-subdued'
      assign title_class = 'heading'
  endcase

  assign show_product_size_selector = false

  if settings.product_card_show_product_size_selector and product.options.size == 1
    assign size_label_list = 'general.label.size' | t | split: ','

    for size_label in size_label_list
      assign size_label_stripped = size_label | strip
      assign size_option = product.options_by_name[size_label_stripped]

      if size_option != blank
        assign show_product_size_selector = true
        break
      endif
    endfor
  endif

  if show_badges
    assign badges_alignment = settings.product_card_badges_placement | split: '-' | last

    if settings.product_card_show_badges_vertically
      assign badges_alignment = settings.product_card_badges_placement | remove: 'place-self-' | split: '-' | first
    endif
  endif

  # Reserves the figure's height with a fixed aspect-ratio so the grid row it belongs to never
  # depends on the image staying in normal flow. This is what lets the hover "expand to fill card"
  # effect (see .product-card__figure:hover in theme.css) work without collapsing/flickering when
  # this card is the only one occupying its row (eg. a lone card wrapped onto its own last row).
  # Skipped for highlighted cards, since those rely on their own taller grid-row span instead.
  # Phones can have their own image size ("Product image size (mobile)"; "same" = the desktop one). Both ratios are written as CSS variables on the
  # figure (--product-card-figure-ratio / -mobile, see .product-card__figure in theme.css), and the image gets its size / crop per breakpoint.
  assign image_ratio_desktop = settings.product_card_image_aspect_ratio
  assign image_ratio_mobile = settings.product_card_image_aspect_ratio_mobile | default: 'same'
  if image_ratio_mobile == 'same'
    assign image_ratio_mobile = image_ratio_desktop
  endif

  unless highlight_card
    case image_ratio_desktop
      when 'natural'
        assign figure_aspect_ratio = product.featured_media.aspect_ratio | default: 1
      when 'short', 'short_crop'
        assign figure_aspect_ratio = '4 / 3'
      when 'medium', 'medium_crop'
        assign figure_aspect_ratio = '8 / 7'
      when 'portrait', 'portrait_crop'
        assign figure_aspect_ratio = '4 / 5'
      when 'tall', 'tall_crop'
        assign figure_aspect_ratio = '2 / 3'
      else
        assign figure_aspect_ratio = '1'
    endcase

    case image_ratio_mobile
      when 'natural'
        assign figure_aspect_ratio_mobile = product.featured_media.aspect_ratio | default: 1
      when 'short', 'short_crop'
        assign figure_aspect_ratio_mobile = '4 / 3'
      when 'medium', 'medium_crop'
        assign figure_aspect_ratio_mobile = '8 / 7'
      when 'portrait', 'portrait_crop'
        assign figure_aspect_ratio_mobile = '4 / 5'
      when 'tall', 'tall_crop'
        assign figure_aspect_ratio_mobile = '2 / 3'
      else
        assign figure_aspect_ratio_mobile = '1'
    endcase
  endunless
-%}

<product-card class="{{ product_card_classes }} color-scheme color-scheme--{{ color_scheme.id }}" {% if reveal and settings.stagger_products %}reveal-on-scroll="true"{% endif %} handle="{{ product.handle | escape }}">
  {%- comment -%}
  --------------------------------------------------------------------------------------------------------------------
  PRODUCT MEDIA
  --------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  <div class="product-card__figure" {% if figure_aspect_ratio %}style="--product-card-figure-ratio: {{ figure_aspect_ratio }}; --product-card-figure-ratio-mobile: {{ figure_aspect_ratio_mobile }};"{% endif %}>
    {%- if show_badges and show_badges_along_info != true -%}
      {%- render 'product-badges',
        product: product,
        context: 'card',
        show_custom_badge: false,
        badge_border_radius: settings.badge_border_radius,
        show_sold_out_badge: settings.product_card_show_sold_out_badge,
        show_discount_badge: settings.product_card_show_discount,
        direction: 'column', 
        vertical_text: settings.product_card_show_badges_vertically,
        class: settings.product_card_badges_placement,
        alignment: badges_alignment
      -%}
    {%- endif -%}

    {%- comment -%}
    Optional decorative icon (eg. a seal/award) over the image: needs the "Show icon on product cards" theme
    setting AND an SVG/image uploaded in the product's "custom.card_icon" file metafield. Purely decorative
    and non-interactive, so the whole card stays one clickable link.
    {%- endcomment -%}
    {%- if settings.product_card_show_icon -%}
      {%- liquid
        assign card_icon = product.metafields.custom.card_icon.value
        assign card_icon_src = card_icon | image_url: width: 400
        if card_icon_src == blank
          assign card_icon_src = card_icon.url
        endif
      -%}
      {%- if card_icon_src != blank -%}
        <img
          src="{{ card_icon_src }}"
          alt=""
          aria-hidden="true"
          loading="lazy"
          class="product-card__icon product-card__icon--{{ settings.product_card_icon_position }}"
          style="--card-icon-size: {{ settings.product_card_icon_size }}px; --card-icon-size-mobile: {{ settings.product_card_icon_size_mobile }}px;"
        >
      {%- endif -%}
    {%- endif -%}

    {%- comment -%}
    Card badge: the text of the product's "custom.card_badge" metafield (single line text, eg. "only at soen") as a pill over the photo. Its
    position, background (can be empty), border (optional, 1px), text color and corner radius are theme settings (Product card > Card badge),
    the same for every product. The 1px border is always there (transparent when no border color is set), so the pill keeps the same size with or
    without it. Purely
    informative and non-interactive, so the whole card stays one clickable link.
    {%- endcomment -%}
    {%- liquid
      assign card_badge_text = ''
      if settings.product_card_show_meta_badge
        assign card_badge_text = product.metafields.custom.card_badge.value | strip
      endif
      assign card_enfoque_text = product.metafields.custom.enfoque.value | default: product.metafields.custom.enfoque | strip
      assign meta_badge_on_top = false
      if settings.product_card_meta_badge_position contains 'top'
        assign meta_badge_on_top = true
      endif
    -%}

    {%- capture card_badge_html -%}
      {%- if card_badge_text != blank -%}
        {%- liquid
          # No background and no border: just text. It then loses the pill's padding and sits right at the badge position (same distance from the
          # photo's edges as a pill would have), instead of keeping an invisible pill around it.
          assign meta_badge_plain = true
          if settings.product_card_meta_badge_background != blank and settings.product_card_meta_badge_background.alpha != 0
            assign meta_badge_plain = false
          endif
          if settings.product_card_meta_badge_border_color != blank and settings.product_card_meta_badge_border_color.alpha != 0
            assign meta_badge_plain = false
          endif
        -%}
        <span class="product-card__meta-badge product-card__meta-badge--{{ settings.product_card_meta_badge_position }}{% if meta_badge_plain %} product-card__meta-badge--plain{% endif %}" style="background: {% if settings.product_card_meta_badge_background != blank and settings.product_card_meta_badge_background.alpha != 0 %}{{ settings.product_card_meta_badge_background }}{% else %}transparent{% endif %}; color: {{ settings.product_card_meta_badge_text_color }}; border: 1px solid {% if settings.product_card_meta_badge_border_color != blank and settings.product_card_meta_badge_border_color.alpha != 0 %}{{ settings.product_card_meta_badge_border_color }}{% else %}transparent{% endif %}; border-radius: {{ settings.product_card_meta_badge_radius }}px;">
          {{- card_badge_text | escape -}}
        </span>
      {%- endif -%}
    {%- endcapture -%}

    {%- comment -%}
    Top line over the photo: the card badge on the left and the enfoque (custom.enfoque, eg. "Textura / Acné") on the right, on the same line,
    like the name and the price under the photo. The enfoque has the badge's text color and the plain badge's text (theme.css,
    .product-card__meta-row). A badge set to a bottom corner stays there on its own, and the enfoque is then alone at the top right.
    {%- endcomment -%}
    {%- if card_enfoque_text != blank or meta_badge_on_top and card_badge_text != blank -%}
      <div class="product-card__meta-row">
        {%- if meta_badge_on_top -%}{{ card_badge_html }}{%- endif -%}

        {%- if card_enfoque_text != blank -%}
          <span class="product-card__meta-enfoque" style="color: {{ settings.product_card_meta_badge_text_color }};">{{ card_enfoque_text | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- unless meta_badge_on_top -%}{{ card_badge_html }}{%- endunless -%}

    {%- comment -%}
    Only the image is rounded, not the whole card - .product-card__media already has overflow:
    hidden, so giving it its own radius is enough. Falls back to 0 when no radius is configured.
    {%- endcomment -%}
    <a href="{{ product.url }}" class="product-card__media" style="border-radius: var(--product-card-border-radius, 0);">
      {%- if product.media.size > 0 -%}
        {%- liquid
          assign sizes = sizes | default: '100vw'
          assign main_media_loading_strategy = nil

          if section.index > 3 or position > 3
            assign main_media_loading_strategy = 'lazy'
          endif

          if main_media_loading_strategy == 'lazy'
            assign sizes = sizes | prepend: 'auto, '
          endif
        -%}

        {%- capture main_image_classes -%}product-card__image product-card__image--primary aspect-{{ image_ratio_mobile | split: '_' | first }} sm:aspect-{{ image_ratio_desktop | split: '_' | first }}{% if image_ratio_mobile contains 'crop' %} product-card__image--crop-mobile{% endif %}{% if image_ratio_desktop contains 'crop' %} product-card__image--crop-desktop{% endif %}{%- endcapture -%}
        {{- product.featured_media | image_url: width: product.featured_media.width | image_tag: loading: main_media_loading_strategy, sizes: sizes, widths: '200,300,400,500,600,700,800,900,1000,1200,1400,1600,1800', class: main_image_classes, alt: product.featured_media.alt | default: product.title -}}

        {%- liquid
          if show_secondary_image and product.media.size > 1
            assign next_media = product.media[product.featured_media.position] | default: product.media[1]

            if next_media != blank
              echo next_media | image_url: width: next_media.width | image_tag: class: 'product-card__image product-card__image--secondary', loading: 'lazy', fetchpriority: 'low', sizes: sizes, widths: '200,300,400,500,600,700,800,900,1000,1200,1400,1600,1800', draggable: 'false', aria-hidden: true
            endif
          endif
        -%}
      {%- else -%}
        {{- 'image' | placeholder_svg_tag -}}
      {%- endif -%}
    </a>

    {%- comment -%}
    Quick buy (only when the section that shows the card turns it on: show_quick_buy). On touch screens it is the small cart icon over the corner of the image,
    as always. With a mouse it is a button under the product info instead (see "product-card__quick-buy-below" further down), never over the image.
    A product with a single variant is added straight to the cart; one with several variants opens the quick buy modal (the modal lives here, next to the icon).
    {%- endcomment -%}
    {%- if show_quick_buy and product.available -%}
      {%- liquid
        assign quick_buy_single = false

        if product.variants.size == 1 and product.selling_plan_groups.size == 0
          assign quick_buy_single = true
        endif

        capture quick_buy_id
          echo 'product-quick-buy-' | append: prefix_id | append: '-' | append: block.id | append: '-' | append: section.id | append: '-' | append: product.id
        endcapture

        if quick_buy_single
          assign button_label = 'product.general.add_to_cart_button' | t

          if settings.currency_code_enabled
            assign button_price = product.selected_or_first_available_variant.price | money_with_currency
          else
            assign button_price = product.selected_or_first_available_variant.price | money
          endif
        else
          assign button_label = 'product.general.choose_options' | t

          if settings.currency_code_enabled
            assign button_price = product.price_min | money_with_currency
          else
            assign button_price = product.price_min | money
          endif
        endif

        # The button under the info has the inside of the main product's add to cart button (snippets/buy-buttons.liquid): the label and the price are two separate
        # children (.buy-buttons__cta pins them to opposite ends), with the crossed-out compare-at price next to the price when the variant is on sale.
        if quick_buy_single and product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price
          if settings.currency_code_enabled
            assign button_compare_at_price = product.selected_or_first_available_variant.compare_at_price | money_with_currency
          else
            assign button_compare_at_price = product.selected_or_first_available_variant.compare_at_price | money
          endif

          assign button_price = button_price | append: ' <s>' | append: button_compare_at_price | append: '</s>'
        endif

        assign button_content = '<span>' | append: button_label | append: '</span><span>' | append: button_price | append: '</span>'
        assign button_class = 'buy-buttons__cta'

        assign single_card = false
        if settings.product_card_info_position == 'card'
          assign single_card = true
        endif

        assign quick_buy_desktop = section.settings.show_quick_buy_desktop | default: true, allow_false: true
        assign quick_buy_mobile = section.settings.show_quick_buy_mobile | default: true, allow_false: true

        # Single card on phones: one centered line "Buy now - price" ("Buy - price" when the button is too narrow, theme.css) (the price medium weight), like an outline "Sold out - $16.00" pill. A short label,
        # so it fits the narrow cards of two per row (the long "Agregar al Carrito" did not); several variants open the quick buy modal from the same button.
        assign button_price = button_price | replace: 'S/', 'S<span class="price-slash">/</span>'
        # The price is two blocks that never split inside (the amount, and the crossed-out compare-at price): on a narrow card the compare-at price goes to the next line as a whole
        assign button_price_parts = button_price | split: ' <s>'
        assign button_price = '<span class="pcb-amount">' | append: button_price_parts[0] | append: '</span>'
        if button_price_parts.size > 1
          assign button_price = button_price | append: ' <s class="pcb-amount">' | append: button_price_parts[1]
        endif
        assign card_button_content = '<span>Buy<span class="product-card__quick-buy-now"> now</span></span><span class="product-card__quick-buy-dash">-</span><span class="product-card__quick-buy-price">' | append: button_price | append: '</span>'
      -%}

      {%- comment -%}Single card: no cart icon over the image, the button at the bottom of the card is the quick buy on every screen{%- endcomment -%}
      {%- if quick_buy_mobile and single_card == false -%}
      <div class="product-card__quick-buy {% if settings.product_card_info_position == 'inside' and settings.product_card_info_vertical_alignment == 'end' %}product-card__quick-buy--top-mobile{% endif %} no-touch:hidden">
        {%- if quick_buy_single -%}
          <product-form>
            {%- form 'product', product -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

              <button type="submit" class="block tap-area">
                <span class="sr-only">{{ button_label }}</span>

                <button-content>
                  {%- render 'icon' with 'cart' -%}
                </button-content>
              </button>
            {%- endform -%}
          </product-form>
        {%- else -%}
          <button type="button" aria-controls="{{ quick_buy_id }}" class="block tap-area">
            <span class="sr-only">{{ button_label }}</span>

            <button-content>
              {%- render 'icon' with 'cart' -%}
            </button-content>
          </button>
        {%- endif -%}
      </div>
      {%- endif -%}

      {%- comment -%}The modal sits outside the touch-only icon wrapper above: that wrapper is not displayed with a mouse, and the button under the info opens this same modal{%- endcomment -%}
      {%- comment -%}In the single card it is opened by the phones' button at the bottom of the card (only when that button is on){%- endcomment -%}
      {%- assign render_quick_buy_modal = true -%}
      {%- if quick_buy_single or single_card and quick_buy_mobile == false -%}
        {%- assign render_quick_buy_modal = false -%}
      {%- endif -%}
      {%- if render_quick_buy_modal -%}
        <quick-buy-modal id="{{ quick_buy_id }}" product-url="{{ product.url }}" class="modal modal--quick-buy color-scheme color-scheme--{{ settings.default_color_scheme.id }}">
          {%- comment -%}The content will be dynamically filled in JS{%- endcomment -%}
        </quick-buy-modal>
      {%- endif -%}
    {%- endif -%}

    {%- if show_product_size_selector -%}
      <div class="product-card__floating-size-selector touch:hidden">
        {%- for variant in product.variants -%}
          <product-form>
            {%- form 'product', product -%}
              <input type="hidden" name="quantity" value="1">
              <input type="hidden" name="id" value="{{ variant.id }}">

              {%- assign class_list = 'floating-size-selector__button' -%}
              {%- assign disabled = false -%}

              {%- unless variant.available -%}
                {%- assign class_list = class_list | append: ' is-disabled' -%}
                {%- assign disabled = true -%}
              {%- endunless -%}

              {%- render 'button', type: 'submit', content: variant.title, size: 'sm', background: settings.default_color_scheme.settings.background, text_color: settings.default_color_scheme.settings.text_color, stretch: true, disabled: disabled, class: class_list -%}
            {%- endform -%}
          </product-form>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%}
  --------------------------------------------------------------------------------------------------------------------
  PRODUCT INFO
  --------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  {%- capture swatches -%}
    {%- if show_swatches -%}
      {%- assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ',' -%}

      {%- for color_label in color_label_list -%}
        {%- if product.options_by_name[color_label] != blank -%}
          {%- assign product_option = product.options_by_name[color_label] -%}

          <div class="product-card__swatch-list {% if settings.product_card_swatches_position == 'inside' %}{{ settings.product_card_swatches_placement }}{% endif %}">
            <fieldset class="h-stack gap-1.5 sm:gap-2">
              <legend class="sr-only">{{ product_option.name }}</legend>

              {%- capture param_name -%}swatch-{{ quick_buy_context }}-{{ prefix_id }}-{{ block.id }}-{{ section.id }}-{{ product.id }}-{{ product_option.position }}{%- endcapture -%}

              {%- liquid
                assign limit = 4

                for option_value in product_option.values limit: limit
                  render 'option-value', type: 'swatch', param_name: param_name, option_value: option_value, option_position: product_option.position, force_unselected: true, output_variant_media: true, size: 'sm', show_tight: settings.product_card_show_tight_swatches
                endfor
  
                if product_option.values.size > limit
                  assign remaining_values = product_option.values.size | minus: limit

                  if settings.product_card_show_tight_swatches
                    echo '<span class="color-swatch__view-more subheading">+' | append: remaining_values | append: '</span>'
                  else
                    echo '<span class="color-swatch__view-more subheading text-subdued">+' | append: remaining_values | append: '</span>'
                  endif
                endif
              -%}
            </fieldset>
          </div>

          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  {%- liquid
    case settings.product_card_info_horizontal_alignment
      when 'start'
        assign info_alignment_class = 'v-stack gap-2.5 justify-items-start text-start'

      when 'center'
        assign info_alignment_class = 'v-stack gap-2.5 justify-items-center text-center'

      when 'end'
        assign info_alignment_class = 'v-stack gap-2.5 justify-items-end text-end'

      when 'split'
        assign info_alignment_class = 'h-stack gap-2.5 align-end justify-between wrap'
    endcase
  -%}

  <div class="product-card__info {% if settings.product_card_info_position == 'inside' %}align-self-{{ settings.product_card_info_vertical_alignment }}{% endif %}">
    <div class="{{ info_alignment_class }}">
      <div class="{% if settings.product_card_info_horizontal_alignment == 'split' %}contents{% else %}v-stack gap-0.5{% endif %}">
        <div class="v-stack gap-2.5">
          {%- if show_badges and show_badges_along_info -%}
            {%- render 'product-badges',
              product: product,
              context: 'card',
              show_custom_badge: false,
              badge_border_radius: settings.badge_border_radius,
              show_sold_out_badge: settings.product_card_show_sold_out_badge,
              show_discount_badge: settings.product_card_show_discount,
              direction: 'column',
              vertical_text: settings.product_card_show_badges_vertically,
              class: settings.product_card_badges_placement,
              alignment: badges_alignment
            -%}
          {%- endif -%}

          <div class="v-stack gap-1">
            <div class="v-stack gap-0.5">
              {%- if show_vendor and product.vendor != blank -%}
                {%- render 'vendor' with product.vendor, class: vendor_class -%}
              {%- endif -%}

              {%- comment -%}The enfoque (custom.enfoque) is not repeated here: it sits over the photo, at the right of the card badge (.product-card__meta-row){%- endcomment -%}
              <a href="{{ product.url }}" class="product-title {{ title_class }} {% if settings.product_card_title_max_lines > 0 %}line-clamp{% else %}{% if show_vendor == false %}trim-start{% endif %}{% endif %}" {% if settings.product_card_title_max_lines > 0 %}style="--line-clamp-count: {{ settings.product_card_title_max_lines }}"{% endif %}>
                {{- product.title -}}
              </a>

              {%- if product.metafields.custom.sistema != blank -%}
                {%- comment -%} Second supporting line (single-line text metafield custom.sistema, the technology), below the title; the soft gray of .product-subtitle (70% of the text color), like on the product page {%- endcomment -%}
                <div class="product-subtitle product-subtitle-2 text-base">{{ product.metafields.custom.sistema }}</div>
              {%- endif -%}
            </div>

            {%- if show_rating and settings.product_card_info_horizontal_alignment == 'split' -%}
              {%- render 'product-rating', product: product, show_empty: settings.product_card_show_rating_if_empty -%}
            {%- endif -%}
          </div>
        </div>

        {%- if settings.product_card_info_horizontal_alignment == 'split' -%}
          {%- render 'price-list', product: product, context: 'card' -%}
        {%- else -%}
          <div class="v-stack gap-1 product-card__price-block">
            {%- render 'price-list', product: product, context: 'card' -%}

            {%- if show_rating -%}
              {%- render 'product-rating', product: product, show_empty: settings.product_card_show_rating_if_empty -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if swatches != blank and settings.product_card_swatches_position == 'outside' or show_swatches_along_info -%}
        {{- swatches -}}
      {%- endif -%}

      {%- comment -%}
      Quick buy with a mouse: an outline button under the product info, as wide as the card, in the text color of the card's own color scheme (theme.css,
      .product-card__quick-buy-below). Not shown for a product that picks its size on the image (the floating size selector takes that place).
      {%- endcomment -%}
      {%- liquid
        # Single card: no cart icon over the image; on phones only (under 700px) an outline button at the bottom of the card, as wide as the card,
        # "label - price" centered (card_button_content). Tablet and desktop: no button, the card is just the image and the info.
        assign show_quick_buy_below = false
        assign below_button_content = button_content
        assign below_button_class = button_class
        if single_card
          if quick_buy_mobile
            assign show_quick_buy_below = true
            assign quick_buy_below_class = 'product-card__quick-buy-below--card sm:hidden'
            assign below_button_content = card_button_content
            assign below_button_class = ''
          endif
        elsif quick_buy_desktop
          assign show_quick_buy_below = true
          assign quick_buy_below_class = 'touch:hidden'
        endif
      -%}

      {%- capture quick_buy_below_html -%}
      {%- if show_quick_buy and product.available and show_product_size_selector == false and show_quick_buy_below -%}
        <div class="product-card__quick-buy-below {{ quick_buy_below_class }}">
          {%- if quick_buy_single -%}
            <product-form>
              {%- form 'product', product -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

                {%- render 'button', content: below_button_content, type: 'submit', style: 'outline', stretch: true, class: below_button_class -%}
              {%- endform -%}
            </product-form>
          {%- else -%}
            {%- render 'button', content: below_button_content, aria_controls: quick_buy_id, style: 'outline', stretch: true, class: below_button_class -%}
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- endcapture -%}

      {%- comment -%}Single card: the button is a row of its own at the bottom of the card, after the info (below), not one of the info's items{%- endcomment -%}
      {%- unless single_card -%}{{ quick_buy_below_html }}{%- endunless -%}
    </div>

    {%- if single_card -%}{{ quick_buy_below_html }}{%- endif -%}
  </div>

  {%- if swatches != blank and settings.product_card_swatches_position == 'inside' and show_swatches_along_info == false -%}
    {{- swatches -}}
  {%- endif -%}
</product-card>