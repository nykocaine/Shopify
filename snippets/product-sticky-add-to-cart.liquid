{%- doc -%}
This component is used to render the sticky add to cart.

@param {object} product - the product to render
@param {string} product_form_id - the main product form
@param {object} [section] - the section is implicitly available. Here, the section is always a "product" template section, so you can access all the information from the section
{%- enddoc -%}

{%- if product.available and section.settings.show_sticky_add_to_cart -%}
  <product-sticky-add-to-cart class="product-sticky-add-to-cart" main-product-form="{{ product_form_id }}">
    <product-rerender id="product-sticky-add-to-cart-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}">
      {%- liquid
        # Same button as the main product's "Add to cart" (snippets/buy-buttons.liquid): same style and
        # colors (read from the section's own buy_buttons block), label on the left, price on the right.
        assign variant = product.selected_or_first_available_variant
        assign atc_block = section.blocks | where: 'type', 'buy_buttons' | first
        assign atc_style = atc_block.settings.atc_button_style | default: 'solid'

        if variant.available
          assign button_content = 'product.general.add_to_cart_button' | t
          assign disabled = false

          if settings.currency_code_enabled
            assign button_price = variant.price | money_with_currency
          else
            assign button_price = variant.price | money
          endif

          if variant.compare_at_price > variant.price
            if settings.currency_code_enabled
              assign button_compare_at_price = variant.compare_at_price | money_with_currency
            else
              assign button_compare_at_price = variant.compare_at_price | money
            endif

            assign button_price = button_price | append: ' <s>' | append: button_compare_at_price | append: '</s>'
          endif

          assign button_content = '<span>' | append: button_content | append: '</span><span>' | append: button_price | append: '</span>'
          assign button_class = 'buy-buttons__cta'
        else
          assign button_content = 'product.general.sold_out_button' | t
          assign disabled = true
          assign button_class = ''
        endif

        render 'button', type: 'submit', form: product_form_id, content: button_content, disabled: disabled, style: atc_style, background: atc_block.settings.atc_button_background, text_color: atc_block.settings.atc_button_text_color, border_color: atc_block.settings.atc_button_border_color, stretch: true, class: button_class
      -%}
    </product-rerender>
  </product-sticky-add-to-cart>

  {%- comment -%}
  Lifts the floating WhatsApp button (sections/vc-whatsapp-button.liquid reads --sticky-atc-offset) so it
  sits right above this bar whenever the bar is showing, and drops it back when the bar hides.
  {%- endcomment -%}
  <script>
    (function () {
      var bar = document.querySelector('product-sticky-add-to-cart');
      if (!bar || bar.dataset.offsetWatch) return;
      bar.dataset.offsetWatch = 'true';

      function update() {
        var offset = bar.classList.contains('is-visible') ? bar.offsetHeight + 10 : 0;
        document.documentElement.style.setProperty('--sticky-atc-offset', offset + 'px');
      }

      new MutationObserver(update).observe(bar, { attributes: true, attributeFilter: ['class'] });
      if (window.ResizeObserver) new ResizeObserver(update).observe(bar);
      update();
    })();
  </script>
{%- endif -%}
