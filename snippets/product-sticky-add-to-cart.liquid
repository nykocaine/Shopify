{%- doc -%}
This component is used to render the sticky add to cart.

@param {object} product - the product to render
@param {string} product_form_id - the main product form
@param {object} [section] - the section is implicitly available. Here, the section is always a "product" template section, so you can access all the information from the section
{%- enddoc -%}

{%- if product.available and section.settings.show_sticky_add_to_cart -%}
  <product-sticky-add-to-cart class="product-sticky-add-to-cart" main-product-form="{{ product_form_id }}">
    <product-rerender id="product-sticky-add-to-cart-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}">
      {%- liquid
        # Same button as the main product's "Add to cart" (snippets/buy-buttons.liquid): same style and
        # colors (read from the section's own buy_buttons block), label and price centered together.
        assign variant = product.selected_or_first_available_variant
        assign atc_block = section.blocks | where: 'type', 'buy_buttons' | first
        assign atc_style = atc_block.settings.atc_button_style | default: 'solid'

        if variant.available
          assign button_content = 'product.general.add_to_cart_button' | t
          assign disabled = false

          if settings.currency_code_enabled
            assign button_price = variant.price | money_with_currency
          else
            assign button_price = variant.price | money
          endif

          if variant.compare_at_price > variant.price
            if settings.currency_code_enabled
              assign button_compare_at_price = variant.compare_at_price | money_with_currency
            else
              assign button_compare_at_price = variant.compare_at_price | money
            endif

            assign button_price = button_price | append: ' <s>' | append: button_compare_at_price | append: '</s>'
          endif

          # Same centered "label – price" as the product page button (snippets/buy-buttons.liquid, .buy-buttons__cta--centered)
          assign button_content = '<span>' | append: button_content | append: '</span><span aria-hidden="true">–</span><span class="buy-buttons__price">' | append: button_price | append: '</span>'
          assign button_class = 'buy-buttons__cta buy-buttons__cta--centered'
        else
          assign button_content = 'product.general.sold_out_button' | t
          assign disabled = true
          assign button_class = ''
        endif

      -%}

      <div class="product-sticky-add-to-cart__inner">
        {%- unless product.has_only_default_variant -%}
          {%- comment -%}
          Variant selector, as a pill at the left of the button. It has no form of its own: choosing an option checks the matching option inputs of the main
          product's variant picker and triggers that picker's own "change" (script below), so the page, the price and this bar all update the usual way.
          Each option carries the values of its variant (one per product option, in order) in data-options.
          {%- endcomment -%}
          <div class="product-sticky-add-to-cart__variant">
            <select class="product-sticky-add-to-cart__select" aria-label="{{ product.options_with_values.first.name | escape }}">
              {%- for product_variant in product.variants -%}
                <option value="{{ product_variant.id }}" data-options="{{ product_variant.options | json | escape }}"{% if product_variant.id == variant.id %} selected{% endif %}>
                  {{- product_variant.title | escape -}}
                  {%- unless product_variant.available %} – {{ 'product.general.sold_out_button' | t }}{% endunless -%}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endunless -%}

        {%- render 'button', type: 'submit', form: product_form_id, content: button_content, disabled: disabled, style: atc_style, text_color: atc_block.settings.atc_button_text_color, stretch: true, class: button_class -%}
      </div>
    </product-rerender>
  </product-sticky-add-to-cart>

  <script>
    (function () {
      if (window.__stickyAtcVariantSelect) return;
      window.__stickyAtcVariantSelect = true;

      // Choosing a variant in the bar: check the matching options in the main variant picker (same form) and fire its own "change"
      document.addEventListener('change', function (event) {
        var select = event.target.closest && event.target.closest('.product-sticky-add-to-cart__select');
        if (!select) return;

        var bar = select.closest('product-sticky-add-to-cart');
        var form = bar && document.forms[bar.getAttribute('main-product-form')];
        var option = select.options[select.selectedIndex];
        if (!form || !option) return;

        var values;
        try { values = JSON.parse(option.getAttribute('data-options')); } catch (e) { return; }

        var inputs = Array.prototype.slice.call(form.elements);
        var lastChanged = null;

        values.forEach(function (value, index) {
          var input = inputs.find(function (item) {
            return item.matches && item.matches('input[data-option-position="' + (index + 1) + '"]') && item.value === value;
          });
          if (input && !input.checked) {
            input.checked = true;
            lastChanged = input;
          }
        });

        if (lastChanged) lastChanged.dispatchEvent(new Event('change', { bubbles: true }));
      });
    })();
  </script>

  {%- comment -%}
  Lifts the floating WhatsApp button (sections/vc-whatsapp-button.liquid reads --sticky-atc-offset) so it
  sits right above this bar whenever the bar is showing, and drops it back when the bar hides.
  {%- endcomment -%}
  <script>
    (function () {
      var bar = document.querySelector('product-sticky-add-to-cart');
      if (!bar || bar.dataset.offsetWatch) return;
      bar.dataset.offsetWatch = 'true';

      function update() {
        // Absolute bottom position for the WhatsApp button: the top of the bar (its own distance from the
        // screen's bottom edge + its height) plus a 10px gap. Removed when the bar hides, so the button
        // falls back to its normal position.
        if (bar.classList.contains('is-visible') && bar.offsetHeight > 0) {
          var bottom = parseFloat(getComputedStyle(bar).bottom) || 0;
          document.documentElement.style.setProperty('--sticky-atc-offset', (bottom + bar.offsetHeight + 10) + 'px');
        } else {
          document.documentElement.style.removeProperty('--sticky-atc-offset');
        }
      }

      new MutationObserver(update).observe(bar, { attributes: true, attributeFilter: ['class'] });
      if (window.ResizeObserver) new ResizeObserver(update).observe(bar);
      update();
    })();
  </script>
{%- endif -%}
