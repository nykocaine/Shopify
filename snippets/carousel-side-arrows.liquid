{%- doc -%}
Previous / next round buttons placed at the two sides of a carousel, vertically centered over its photos or videos.
Render it INSIDE a `.carousel-frame` wrapper (position: relative) that also contains the carousel, so the arrows are positioned
against the carousel itself and not against anything below it (captions, etc.). Look: assets/theme.css (.overlay-control),
size / blur / shape: Theme settings > Controls.

@param {string} target_id - id of the scrollable element the arrows move
@param {boolean} [show_mobile] - show the arrows on mobile
@param {boolean} [show_desktop] - show the arrows on desktop (nothing is rendered when both are off)
{%- enddoc -%}

{%- if show_mobile or show_desktop -%}
  {%- liquid
    assign visibility_class = ''
    unless show_mobile
      assign visibility_class = 'md-max:hidden'
    endunless
    unless show_desktop
      assign visibility_class = 'md:hidden'
    endunless
  -%}

  <carousel-prev-button aria-controls="{{ target_id }}" class="carousel-side-arrow carousel-side-arrow--prev {{ visibility_class }}">
    <button type="button" disabled class="overlay-control">
      <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
      {%- render 'icon' with 'arrow-left', direction_aware: true -%}
    </button>
  </carousel-prev-button>

  <carousel-next-button aria-controls="{{ target_id }}" class="carousel-side-arrow carousel-side-arrow--next {{ visibility_class }}">
    <button type="button" class="overlay-control">
      <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
      {%- render 'icon' with 'arrow-right', direction_aware: true -%}
    </button>
  </carousel-next-button>
{%- endif -%}
